---
import '../styles/global.css';
import data from '../data/topics.json';
import domains from '../data/domains.json';

const B = import.meta.env.BASE_URL.replace(/\/+$/, '') || '';
const { subjects, topics } = data;
const countFor = (id: string) => topics.filter((t) => t.subject === id).length;
const domainGroups = Object.entries(domains)
  .map(([id, label]) => ({
    label,
    items: subjects.filter((s) => (s.domain ?? '') === id).sort((a, b) => a.name.localeCompare(b.name)),
  }))
  .filter((g) => g.items.length > 0);

// Which subject is this page about? Drives the site-wide subject identity.
const pathParts = Astro.url.pathname.split('/').filter(Boolean);
const subjectAt = pathParts.indexOf('subjects');
const subjectId = subjectAt >= 0 ? pathParts[subjectAt + 1] : null;
const subject = subjects.find((s) => s.id === subjectId) ?? null;
const MOTIFS: Record<string, string> = {
  physics: 'orbit', astronomy: 'orbit', 'earth-science': 'strata', 'materials-science': 'grid',
  chemistry: 'cells', biology: 'cells', medicine: 'cells', neuroscience: 'circuit',
  'environmental-science': 'waves', agriculture: 'waves',
  math: 'grid', statistics: 'grid', 'data-science': 'grid', finance: 'grid', economics: 'grid', accounting: 'grid',
  history: 'columns', philosophy: 'columns', 'religious-studies': 'columns', literature: 'columns',
  anthropology: 'columns', sociology: 'columns', law: 'columns', 'political-science': 'columns',
  'visual-arts': 'arcs', 'art-history': 'arcs', music: 'arcs', film: 'arcs', architecture: 'arcs', design: 'arcs',
  'computer-science': 'circuit', 'artificial-intelligence': 'circuit', 'information-technology': 'circuit', engineering: 'circuit',
  geography: 'orbit', 'hospitality-tourism': 'orbit', 'international-relations': 'orbit',
  business: 'waves', marketing: 'waves', journalism: 'waves', 'media-studies': 'waves',
  education: 'waves', languages: 'waves', linguistics: 'waves', criminology: 'waves',
  'public-health': 'waves', 'sports-science': 'waves', drama: 'arcs',
};
const motif = subject ? MOTIFS[subject.id] ?? 'grid' : 'grid';

const { title = 'Interactive Atlas — learn by touching the ideas', description = 'Interactive, manipulable lessons across 49 subjects — with graphs, diagrams, charts and plain-language explanations for curious minds. No accounts, no ads — everything runs in your browser.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!DOCTYPE html>
<html lang="en" data-base={B} data-subject={subject?.id} data-motif={motif} style={subject ? `--subject:${subject.ink}` : undefined}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" id="theme-color" content="#f5f6f2" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%231b2a23'/%3E%3Ctext x='16' y='22.5' font-family='Georgia,serif' font-style='italic' font-size='17' fill='%23f5f6f2' text-anchor='middle'%3Eia%3C/text%3E%3C/svg%3E" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,400;0,500;0,600;1,400;1,500&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <script is:inline>
    // Apply the saved theme before first paint so there is no flash.
    (() => {
      const key = 'atlas-theme';
      let theme = null;
      try { theme = localStorage.getItem(key); } catch (e) { /* private mode */ }
      if (theme !== 'light' && theme !== 'dark') {
        theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      document.documentElement.dataset.theme = theme;
    })();
  </script>
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <div class="read-progress" aria-hidden="true"><i id="read-progress-bar"></i></div>
  <header class="site-header" role="banner">
    <div class="wrap">
      <a href={B + '/'} class="logo">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6 5.6 18.4"/><circle cx="12" cy="12" r="3.4" fill="var(--paper)" stroke="currentColor"/></svg>
        Interactive Atlas
      </a>
      <nav aria-label="Primary" class="nav-primary">
        <details class="subjects-menu">
          <summary>subjects</summary>
          <div class="menu-panel">
            {domainGroups.map((group) => (
              <div>
                <p class="menu-domain">{group.label}</p>
                {group.items.map((s) => (
                  <a href={`${B}/subjects/${s.id}/`}>
                    <span class="dot" style={`--dot:${s.ink}`}></span>
                    {s.name}
                    <span class="menu-count">{countFor(s.id)}</span>
                  </a>
                ))}
              </div>
            ))}
          </div>
        </details>
        <a class="nav-link" href={B + '/programs/'}>programs</a>
        <a class="nav-link" href={B + '/about/'}>about</a>
        <a class="nav-link" href={B + '/search/'}>search</a>
      </nav>
      <div class="nav-end">
        <button class="theme-toggle" type="button" aria-label="Switch to dark mode" title="Switch theme">
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"/></svg>
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2M12 19.5v2M4.4 4.4l1.4 1.4M18.2 18.2l1.4 1.4M2.5 12h2M19.5 12h2M4.4 19.6l1.4-1.4M18.2 5.8l1.4-1.4"/></svg>
        </button>
        <a class="nav-link" href="https://github.com/adineo-cmd/interactive-science" aria-label="Source on GitHub" rel="me noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.1.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.58 9.58 0 0 1 5 0c1.91-1.3 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85V21c0 .27.18.58.69.48A10 10 0 0 0 12 2z"/></svg>
        </a>
      </div>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="site-footer" role="contentinfo">
    <div class="wrap">
      <div>
        <p class="foot-brand">Interactive Atlas</p>
        <p class="foot-note">A field notebook of subjects you can poke, drag and re-derive — written so a curious ten-year-old can start, and deep enough to keep going. Everything runs in your browser.</p>
      </div>
      <div>
        <h4>Subjects</h4>
        <ul>
          {subjects.map((s) => <li><a href={`${B}/subjects/${s.id}/`}>{s.name}</a></li>)}
        </ul>
      </div>
      <div>
        <h4>Site</h4>
        <ul>
          <li><a href={B + '/programs/'}>Learning programs</a></li>
          <li><a href={B + '/about/'}>About</a></li>
          <li><a href={B + '/search/'}>Search</a></li>
          <li><a href="https://github.com/adineo-cmd/interactive-science" rel="me noopener">Source on GitHub</a></li>
        </ul>
      </div>
      <p class="colophon">
        <span>Static site — no accounts, no tracking, no cookies.</span>
        <span>Built with Astro · source on GitHub</span>
      </p>
    </div>
  </footer>
  <script type="module" src={B + '/widgets/index.js'} is:inline></script>
  <script>
    // theme toggle + persistence
    const root = document.documentElement;
    const themeBtn = document.querySelector<HTMLButtonElement>('.theme-toggle');
    const themeMeta = document.querySelector<HTMLMetaElement>('#theme-color');
    const labelFor = (t: string) => (t === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
    function syncThemeButton() {
      const theme = root.dataset.theme === 'dark' ? 'dark' : 'light';
      if (themeBtn) {
        themeBtn.setAttribute('aria-label', labelFor(theme));
        themeBtn.setAttribute('title', labelFor(theme));
        themeBtn.setAttribute('aria-pressed', String(theme === 'dark'));
      }
      if (themeMeta) themeMeta.content = theme === 'dark' ? '#0d1411' : '#f5f6f2';
    }
    themeBtn?.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('atlas-theme', next); } catch (e) { /* private mode */ }
      syncThemeButton();
      document.dispatchEvent(new CustomEvent('atlas:theme', { detail: { theme: next } }));
    });
    window.matchMedia?.('(prefers-color-scheme: dark)').addEventListener?.('change', (e) => {
      let saved = null;
      try { saved = localStorage.getItem('atlas-theme'); } catch (err) { /* private mode */ }
      if (saved) return;
      root.dataset.theme = e.matches ? 'dark' : 'light';
      syncThemeButton();
      document.dispatchEvent(new CustomEvent('atlas:theme', { detail: { theme: root.dataset.theme } }));
    });
    syncThemeButton();

    // --- lesson tools: read this lesson aloud -------------------------------
    const lesson = document.querySelector('.topic-grid article, main article');
    if (lesson && lesson.querySelector('.topic-head') && !lesson.querySelector('.lesson-tools')) {
      const tools = document.createElement('div');
      tools.className = 'lesson-tools';
      tools.innerHTML =
        '<button type="button" class="btn btn-ghost btn-small read-aloud" aria-pressed="false">' +
        '<span class="ra-icon" aria-hidden="true">&#9654;</span>' +
        '<span class="ra-label">Read aloud</span></button>' +
        '<span class="tool-hint">uses your browser voice</span>' +
        '<span class="glossary-hint">dotted words have definitions</span>';
      const head = lesson.querySelector('.topic-head');
      head?.insertAdjacentElement('afterend', tools);

      const btn = tools.querySelector('.read-aloud');
      const labelEl = btn?.querySelector('.ra-label');
      const iconEl = btn?.querySelector('.ra-icon');
      let chunks: string[] = [];
      let cursor = 0;
      let speaking = false;

      const collect = () => {
        const parts: string[] = [];
        lesson.querySelectorAll('h2, h3, p, li').forEach((node) => {
          if (node.closest('figure.widget, .lesson-tools, .quiz, nav')) return;
          const text = (node.textContent || '').replace(/\s+/g, ' ').trim();
          if (text.length > 2) parts.push(text);
        });
        return parts;
      };

      const stop = () => {
        speaking = false;
        cursor = 0;
        window.speechSynthesis?.cancel();
        btn?.setAttribute('aria-pressed', 'false');
        if (labelEl) labelEl.textContent = 'Read aloud';
        if (iconEl) iconEl.innerHTML = '&#9654;';
      };

      const next = () => {
        if (!speaking) return;
        if (cursor >= chunks.length) { stop(); return; }
        const utter = new SpeechSynthesisUtterance(chunks[cursor]);
        utter.rate = 0.98;
        utter.onend = () => { cursor += 1; next(); };
        utter.onerror = () => stop();
        window.speechSynthesis.speak(utter);
      };

      btn?.addEventListener('click', () => {
        if (!('speechSynthesis' in window)) return;
        if (speaking) { stop(); return; }
        chunks = collect();
        cursor = 0;
        speaking = true;
        btn.setAttribute('aria-pressed', 'true');
        if (labelEl) labelEl.textContent = 'Stop reading';
        if (iconEl) iconEl.innerHTML = '&#9632;';
        next();
      });
      window.addEventListener('beforeunload', () => window.speechSynthesis?.cancel());
    }

    // close the subjects dropdown when clicking elsewhere or pressing Escape
    document.addEventListener('click', (e) => {
      document.querySelectorAll('details.subjects-menu[open]').forEach((d) => {
        if (!d.contains(e.target as Node)) d.removeAttribute('open');
      });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') document.querySelectorAll('details.subjects-menu[open]').forEach((d) => d.removeAttribute('open'));
    });
  </script>
</body>
</html>

