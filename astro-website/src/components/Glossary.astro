---
// An inline word with a definition on hover or keyboard focus. Pure CSS in
// global.css (.glossary-term / .glossary-tip); no script needed.
interface Props {
  term: string;
  def: string;
}

const { term, def } = Astro.props;
---
<button type="button" class="glossary-term">{term}<span class="glossary-tip">{def}</span></button>
