---
// Instrument frame: figure + mono caption + widget mount div.
const { no, caption, widget, config = null } = Astro.props;
---
<figure class="widget">
  <figcaption><span class="fig-no">fig. {no}</span><span>{caption}</span></figcaption>
  <div class="widget-body">
    {config === null
      ? <div data-widget={widget}></div>
      : <div data-widget={widget} data-config={JSON.stringify(config)}></div>}
  </div>
</figure>
