---
import Layout from '../layouts/Layout.astro';
import SubjectIcon from './SubjectIcon.astro';
import data from '../data/topics.json';

const syllabusFiles = import.meta.glob('../data/syllabus/*.json', { eager: true });

const { subject: id, intro } = Astro.props;
const B = import.meta.env.BASE_URL.replace(/\/+$/, '') || '';
const { subjects, topics } = data;
const s = subjects.find((x) => x.id === id);
if (!s) throw new Error(`Unknown subject: ${id}`);

// learning program: official syllabus structure joined with the topic catalogue
const syllabus = syllabusFiles[`../data/syllabus/${id}.json`]?.default ?? null;
const bySlug = new Map(topics.map((t) => [t.slug, t]));
const program = syllabus
  ? syllabus.program.map((u) => ({ ...u, lessons: u.lessons.map((slug) => bySlug.get(slug)).filter(Boolean) }))
  : null;
const programLessons = program ? program.flatMap((u) => u.lessons) : [];
const programLive = programLessons.filter((t) => t.status !== 'planned').length;
// lecture numbering: units in program order are the course's numbered lectures,
// each unit's lessons are its numbered sections (Lecture N — Section N.1, N.2, …)
const lectureNo = new Map(program ? program.map((u, i) => [u, i + 1]) : []);
const sections: { name: string | null; units: NonNullable<typeof program> }[] = [];
if (program) {
  for (const u of program) {
    let sec = sections.find((x) => x.name === (u.section ?? null));
    if (!sec) { sec = { name: u.section ?? null, units: [] }; sections.push(sec); }
    sec.units.push(u);
  }
}

const LEVELS = [
  ['foundational', 'Foundational'],
  ['intermediate', 'Intermediate'],
  ['advanced', 'Advanced'],
  ['expert', 'Expert'],
];

// per-tier live/total counts for the course-contents tab bar
const tierCounts = Object.fromEntries(
  LEVELS.map(([lv]) => [
    lv,
    `${programLessons.filter((t) => t.level === lv && t.status !== 'planned').length}/${programLessons.filter((t) => t.level === lv).length}`,
  ]),
);
---
<Layout title={`${s.name} — Interactive Atlas`} description={s.tagline}>
  <div class="wrap">
    <header class="page-head">
      <p class="crumb"><a href={B + '/'}>atlas</a><span class="sep">/</span>{s.name}</p>
      <div style="display:flex; align-items:center; gap:1rem">
        <span style={`color:${s.ink}`}><SubjectIcon name={s.icon} size={38} /></span>
        <h1>{s.name}</h1>
      </div>
      <p class="lede">{intro ?? s.tagline}</p>
    </header>

    {program && (
      <section class="program" id="program" aria-label="Learning program">
        <div class="program-head">
          <div class="program-title-row">
            <h2>Course contents</h2>
            <span
              class="chip"
              id="tier-chip"
              data-all={`${programLive}/${programLessons.length}`}
              data-foundational={tierCounts.foundational}
              data-intermediate={tierCounts.intermediate}
              data-advanced={tierCounts.advanced}
              data-expert={tierCounts.expert}
            >
              {programLive}/{programLessons.length} lessons live
            </span>
          </div>
          <p class="program-src">
            {syllabus.source.board} · {syllabus.source.qualification} ·
            <a href={syllabus.source.url} target="_blank" rel="noopener">official syllabus (PDF)</a>
          </p>
          <p class="program-note">{syllabus.note}</p>
          <div class="stage-strip" aria-label="The journey through this course">
            {LEVELS.map(([lv, label], i) => {
              const n = programLessons.filter((t) => t.level === lv && t.status !== 'planned').length;
              const tot = programLessons.filter((t) => t.level === lv).length;
              return (
                <span class="stage-stop" data-tier={lv}>
                  <strong>Stage {i + 1}</strong> {label} · {n}/{tot}
                </span>
              );
            })}
          </div>
          <p class="loop-line">how each stage works: explore → learn → visualize → apply → practice → assess</p>
          <div class="tier-tabs" role="tablist" aria-label="Filter course contents by level">
            <button class="tier-tab active" type="button" role="tab" aria-selected="true" data-tier="all">
              All levels
            </button>
            {LEVELS.map(([lv, label]) => (
              <button class="tier-tab" type="button" role="tab" aria-selected="false" data-tier={lv}>
                {label}
              </button>
            ))}
          </div>
        </div>
        {sections.map((sec) => (
          <div class="program-section">
            {sec.name && <h3 class="program-sec-name">{sec.name}</h3>}
            <div class="unit-list">
              {sec.units.map((u) => {
                const ulive = u.lessons.filter((t) => t.status !== 'planned').length;
                return (
                  <div class="unit-card" style={`--row-ink:${s.ink}`}>
                    <div class="unit-head">
                      <span class="unit-no">L{String(lectureNo.get(u)).padStart(2, '0')}</span>
                      <div class="unit-blurb">
                        <p class="unit-title">Lecture {lectureNo.get(u)}: {u.title}</p>
                        <p class="unit-topics">{u.topics.join(' · ')}</p>
                      </div>
                      <span class="unit-progress">{ulive}/{u.lessons.length} live</span>
                    </div>
                    {u.lessons.length > 0 && (
                      <div class="unit-lessons index">
                        {u.lessons.map((t, j) =>
                          t.status !== 'planned' ? (
                            <a class="index-row" href={`${B}/${t.slug}/`} data-level={t.level}>
                              <span class="glyph" style="font-family:var(--f-mono); font-size:12px; color:var(--ink-3)">{lectureNo.get(u)}.{j + 1}</span>
                              <span>
                                <span class="index-name">{t.title}</span>
                                <span class="index-tag" style="display:block">{t.summary}</span>
                              </span>
                              <span class="index-meta">{t.level} · {t.minutes} min</span>
                            </a>
                          ) : (
                            <div class="index-row planned" title="Planned lesson — not yet written" data-level={t.level}>
                              <span class="glyph" style="font-family:var(--f-mono); font-size:12px; color:var(--ink-3)">··</span>
                              <span>
                                <span class="index-name" style="font-size:1.05rem">{t.title}</span>
                                <span class="index-tag" style="display:block">{t.summary}</span>
                              </span>
                              <span class="index-meta">planned</span>
                            </div>
                          )
                        )}
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          </div>
        ))}
      </section>
    )}
  </div>
</Layout>

<script>
  // Course-contents level tabs: filter lesson rows, empty lectures/sections, update the chip.
  const tabs = document.querySelectorAll<HTMLButtonElement>('.program .tier-tabs .tier-tab');
  tabs.forEach((tab) =>
    tab.addEventListener('click', () => {
      const tier = tab.dataset.tier ?? 'all';
      tabs.forEach((t) => {
        t.classList.toggle('active', t === tab);
        t.setAttribute('aria-selected', String(t === tab));
      });
      document.querySelectorAll<HTMLElement>('.unit-lessons .index-row').forEach((row) => {
        row.style.display = tier === 'all' || row.dataset.level === tier ? '' : 'none';
      });
      document.querySelectorAll<HTMLElement>('.unit-card').forEach((card) => {
        const rows = [...card.querySelectorAll<HTMLElement>('.unit-lessons .index-row')];
        card.style.display = rows.some((r) => r.style.display !== 'none') ? '' : 'none';
      });
      document.querySelectorAll<HTMLElement>('.program-section').forEach((sec) => {
        const cards = [...sec.querySelectorAll<HTMLElement>('.unit-card')];
        sec.style.display = cards.some((c) => c.style.display !== 'none') ? '' : 'none';
      });
      const chip = document.getElementById('tier-chip');
      if (chip) {
        const n = tier === 'all' ? chip.dataset.all : chip.dataset[tier];
        if (n) chip.textContent = `${n} lessons live`;
      }
    }),
  );
</script>
