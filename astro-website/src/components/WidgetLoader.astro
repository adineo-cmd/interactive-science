---
const { widgets = [] } = Astro.props;
---
{widgets.includes('plotter') && <script type="module" src="/widgets/plotter.js" data-widget="plotter"></script>}
{widgets.includes('sliderLab') && <script type="module" src="/widgets/sliderLab.js" data-widget="sliderLab"></script>}
{widgets.includes('equationStep') && <script type="module" src="/widgets/equationStep.js" data-widget="equationStep"></script>}
{widgets.includes('diagramBuilder') && <script type="module" src="/widgets/diagramBuilder.js" data-widget="diagramBuilder"></script>}
