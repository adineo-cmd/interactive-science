---
// End-of-lesson self-check. The runtime lives in public/widgets/quiz.js and
// self-mounts any [data-quiz] node, so this component only shapes the data.
interface Question {
  q: string;
  choices: string[];
  answer: number;
  why?: string;
}

interface Props {
  questions: Question[];
  label?: string;
}

const { questions, label = 'Check yourself' } = Astro.props;
---
<section class="lesson-extras" aria-label={label}>
  <h2>{label}</h2>
  <div class="quiz" data-quiz={JSON.stringify({ questions })}></div>
</section>
