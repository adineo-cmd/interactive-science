{
  "subject": "robotics",
  "source": {
    "board": "Princeton & CMU (Lynch & Park)",
    "qualification": "Modern Robotics: Mechanics, Planning, and Control",
    "document": "Canonical open textbook, chapter structure (official companion site)",
    "url": "https://hades.mech.northwestern.edu/index.php/Modern_Robotics",
    "track": "university · graduate/advanced undergraduate core"
  },
  "note": "Units follow the textbook's chapter arc — configuration space, rigid-body kinematics, then forward/inverse kinematics, dynamics, trajectory generation and motion planning.",
  "program": [
    {
      "unit": 1,
      "title": "Configuration space",
      "topics": [
        "Degrees of freedom and Grubler's formula",
        "Task and workspace",
        "Holonomic and nonholonomic constraints"
      ],
      "lessons": [
        "subjects/robotics/foundational/configuration-space"
      ]
    },
    {
      "unit": 2,
      "title": "Rigid-body motions",
      "topics": [
        "Rotation matrices and SO(3)",
        "Homogeneous transforms",
        "Exponential coordinates"
      ],
      "lessons": [
        "subjects/robotics/intermediate/rigid-body-motions"
      ]
    },
    {
      "unit": 3,
      "title": "Forward and inverse kinematics",
      "topics": [
        "Screw theory and PoE kinematics",
        "IK solutions",
        "Velocity kinematics and the Jacobian"
      ],
      "lessons": [
        "subjects/robotics/intermediate/forward-and-inverse-kinematics"
      ]
    },
    {
      "unit": 4,
      "title": "Robot dynamics",
      "topics": [
        "Lagrangian dynamics",
        "Mass matrices and Coriolis",
        "Newton–Euler formulation"
      ],
      "lessons": [
        "subjects/robotics/advanced/robot-dynamics"
      ]
    },
    {
      "unit": 5,
      "title": "Trajectory generation and motion planning",
      "topics": [
        "Time-parameterised paths",
        "Sampling-based planning: RRT, PRM",
        "Obstacle avoidance"
      ],
      "lessons": [
        "subjects/robotics/advanced/motion-planning"
      ]
    },
    {
      "unit": 6,
      "title": "Robot control",
      "topics": [
        "PID and computed-torque control",
        "Force and impedance control",
        "Hybrid position–force control"
      ],
      "lessons": [
        "subjects/robotics/advanced/robot-control"
      ]
    },
    {
      "unit": 7,
      "title": "Perception and localisation",
      "topics": [
        "Sensors: cameras, lidar, IMUs",
        "State estimation and Kalman filtering",
        "SLAM"
      ],
      "lessons": [
        "subjects/robotics/expert/perception-estimation-and-slam"
      ]
    },
    {
      "unit": 8,
      "title": "Mobile robots and manipulation frontiers",
      "topics": [
        "Wheeled kinematics and navigation",
        "Legged locomotion",
        "Learning-based robotics"
      ],
      "lessons": [
        "subjects/robotics/expert/mobile-robots-and-learning-frontiers"
      ]
    }
  ]
}
