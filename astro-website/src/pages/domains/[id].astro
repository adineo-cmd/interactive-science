---
import Layout from '../../layouts/Layout.astro';
import SubjectIcon from '../../components/SubjectIcon.astro';
import data from '../../data/topics.json';
import domains from '../../data/domains.json';

const B = import.meta.env.BASE_URL.replace(/\/+$/, '') || '';
const { subjects, topics } = data;
const live = topics.filter((t) => t.status !== 'planned');

export function getStaticPaths() {
  return Object.entries(domains).map(([id, label]) => ({ params: { id }, props: { label } }));
}

const { id } = Astro.params;
const { label } = Astro.props;

const items = subjects
  .filter((s) => (s.domain ?? '') === id)
  .sort((a, b) => a.name.localeCompare(b.name))
  .map((s) => ({ ...s, liveTotal: live.filter((t) => t.subject === s.id).length }));
---
<Layout title={`${label} — Interactive Atlas`} description={`${label} subjects on Interactive Atlas — interactive, manipulable lessons from foundational to expert.`}>
  <div class="wrap">
    <header class="page-head">
      <p class="crumb"><a href={B + '/'}>atlas</a><span class="sep">/</span>{label}</p>
      <h1>{label}</h1>
      <p class="lede">
        Every subject runs one ladder — foundational, intermediate, advanced, expert — and opens
        with its own course contents, where you can switch levels.
      </p>
    </header>

    <div class="index domain-subjects">
      {items.map((s) => (
        <a class="index-row" style={`--row-ink:${s.ink}`} href={`${B}/subjects/${s.id}/`}>
          <span class="glyph"><SubjectIcon name={s.icon} size={26} /></span>
          <span>
            <span class="index-name">{s.name}</span>
            <span class="index-tag" style="display:block">{s.tagline}</span>
          </span>
          <span class="index-meta">
            {s.liveTotal} lesson{s.liveTotal === 1 ? '' : 's'}
          </span>
        </a>
      ))}
    </div>
  </div>
</Layout>
