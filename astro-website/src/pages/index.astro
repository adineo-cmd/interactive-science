---
import Layout from '../layouts/Layout.astro';
import SubjectIcon from '../components/SubjectIcon.astro';
import data from '../data/topics.json';

const B = import.meta.env.BASE_URL.replace(/\/+$/, '') || '';
const { subjects, topics } = data;
const live = topics.filter((t) => t.status !== 'planned');
const plannedCount = topics.length - live.length;
const liveFor = (id: string) => live.filter((t) => t.subject === id).length;
const plannedFor = (id: string) => topics.filter((t) => t.subject === id && t.status === 'planned').length;

const tools = [
  { id: 'plotter', name: 'Plotter', text: 'Graph any equation. Drag to pan, scroll to zoom, read values straight off the curve.' },
  { id: 'sliderLab', name: 'Slider lab', text: 'Move the parameters and watch the model respond — projectile paths, atoms, orbits, seasons.' },
  { id: 'timeline', name: 'Timeline', text: 'Scrub through centuries (or minutes) and watch events arrive in order.' },
  { id: 'equationStep', name: 'Derivation', text: 'Equations revealed one justified step at a time, so nothing appears by magic.' },
  { id: 'diagramBuilder', name: 'Vector diagram', text: 'Grab the arrowhead and feel how components split apart.' },
];
---
<Layout>
  <section class="hero graph" aria-label="Introduction">
    <div class="wrap hero-grid">
      <div>
        <h1>Every subject, hands&#8209;on.</h1>
        <p class="lede">
          Interactive Atlas turns topics into instruments. Drag the vectors, scrub the centuries,
          move the sliders — and watch the equations answer. From physics to history, everything
          runs right here in your browser.
        </p>
        <div class="hero-ctas">
          <a class="btn" href="#subjects">Browse subjects</a>
          <a class="btn btn-ghost" href={`${B}/subjects/physics/foundational/motion-1d/`}>Try a lesson</a>
        </div>
        <div class="stat-strip">
          <div class="stat"><strong>{subjects.length}</strong><span>subjects</span></div>
          <div class="stat"><strong>{live.length}</strong><span>lessons live</span></div>
          <div class="stat"><strong>{topics.length}</strong><span>topics mapped</span></div>
          <div class="stat"><strong>5</strong><span>instruments</span></div>
          <div class="stat"><strong>0</strong><span>accounts</span></div>
        </div>
      </div>
      <figure class="instrument" style="margin:0">
        <div class="instrument-head"><span>fig. 00 — pendulum wave</span><span class="live">live</span></div>
        <canvas id="hero-canvas" aria-label="Pendulum wave simulation; move your pointer to change amplitude and tempo"></canvas>
        <div class="instrument-foot">move your pointer across it — height sets amplitude, position sets tempo</div>
      </figure>
    </div>
  </section>

  <section class="section" id="subjects" aria-label="Subjects">
    <div class="wrap">
      <div class="section-head">
        <h2>The index</h2>
        <span class="side-note">{subjects.length} subjects · one ladder each: foundational → expert</span>
      </div>
      <div class="index">
        {subjects.map((s) => (
          <a class="index-row" style={`--row-ink:${s.ink}`} href={`${B}/subjects/${s.id}/`}>
            <span class="glyph"><SubjectIcon name={s.icon} size={26} /></span>
            <span>
              <span class="index-name">{s.name}</span>
              <span class="index-tag" style="display:block">{s.tagline}</span>
            </span>
            <span class="index-meta">{plannedFor(s.id) ? `${liveFor(s.id)} live · ${plannedFor(s.id)} planned` : `${liveFor(s.id)} lesson${liveFor(s.id) === 1 ? '' : 's'}`}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="instruments" aria-label="How lessons work" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <h2>Five instruments, not one textbook</h2>
        <span class="side-note">every lesson is built from these</span>
      </div>
      <div class="tools-grid">
        {tools.map((t) => (
          <div class="tool">
            <span class="glyph">
              {t.id === 'plotter' && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M4 4v16h16"/><path d="M4 17c3.5 0 4.5-9 8-9s4.5 6 8 6"/></svg>}
              {t.id === 'sliderLab' && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/><circle cx="9" cy="7" r="2.2" fill="var(--paper-raised)"/><circle cx="15" cy="12" r="2.2" fill="var(--paper-raised)"/><circle cx="7" cy="17" r="2.2" fill="var(--paper-raised)"/></svg>}
              {t.id === 'timeline' && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M5 3v18"/><circle cx="5" cy="6" r="1.8" fill="currentColor" stroke="none"/><circle cx="5" cy="12" r="1.8" fill="currentColor" stroke="none"/><circle cx="5" cy="18" r="1.8" fill="currentColor" stroke="none"/><path d="M9 6h10M9 12h7M9 18h9"/></svg>}
              {t.id === 'equationStep' && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M4 6h10M9 12h10M4 18h10"/><circle cx="19" cy="6" r="1.6" fill="currentColor" stroke="none"/><circle cx="5" cy="12" r="1.6" fill="currentColor" stroke="none"/><circle cx="19" cy="18" r="1.6" fill="currentColor" stroke="none"/></svg>}
              {t.id === 'diagramBuilder' && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M4 20 18 6"/><path d="m18 6-5.5.8M18 6l-.8 5.5" /><circle cx="4" cy="20" r="1.8" fill="currentColor" stroke="none"/></svg>}
            </span>
            <div>
              <h3>{t.name}</h3>
              <p>{t.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-label="Privacy" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <h2>Built quiet</h2>
      </div>
      <p style="max-width:56ch; color:var(--ink-2); font-size:1.02rem">
        No accounts, no tracking, no cookies, no chat box. The whole site is static — it loads fast
        and never sends anything anywhere. <a href={`${B}/about/`}>More on how this works.</a>
      </p>
    </div>
  </section>
</Layout>

<script type="module" src={B + '/js/hero.js'} is:inline></script>
