---
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <section class="hero" aria-label="Intro">
    <h1>Interactive Science</h1>
    <p>Subject-first learning from school fundamentals to expert depth. No accounts. No ads. Manipulative graphs, interactive labs, step-by-step explanations.</p>
  </section>
  <section aria-label="Subjects">
    <h2>Browse by subject</h2>
    <div class="subject-grid">
      <a href="/subjects/physics/" class="card"><h2>Physics</h2><p>Foundational → Expert</p></a>
      <a href="/subjects/chemistry/" class="card"><h2>Chemistry</h2><p>Foundational → Expert</p></a>
      <a href="/subjects/biology/" class="card"><h2>Biology</h2><p>Foundational → Expert</p></a>
      <a href="/subjects/math/" class="card"><h2>Mathematics</h2><p>Foundational → Expert</p></a>
    </div>
  </section>
</Layout>
