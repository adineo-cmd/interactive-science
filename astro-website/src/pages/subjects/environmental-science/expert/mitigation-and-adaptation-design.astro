import Widget from '../../../../components/Widget.astro';

const mitigCfg = {
  steps: [
    { math: '1 · Mitigation vs adaptation, both mandatory', note: 'Mitigation: reduce emissions (global problem, every tonne matters equally). Adaptation: adjust to the change already locked (~0.3–0.5 °C more is inevitable). "Adapt, don\'t mitigate" fails at scale — you cannot adapt to unbounded warming. Both, funded.' },
    { math: '2 · The mitigation wedge math', note: 'Net zero = emissions minus removals = 0. The wedges: power decarbonisation (the energy lesson), electrification of transport and heat, industry (steel and cement are the hard ones — the materials lesson), agriculture and land (the agriculture lesson), methane cuts (fast lever, ~0.3 °C of near-term cooling), and efficiency (the cheapest wedge).' },
    { math: '3 · Carbon removal is now in the arithmetic', note: 'Every 1.5 °C pathway includes removals (nature-based: forests, soil — cheaper, less durable; engineered: direct air capture, enhanced weathering — durable, early-stage, currently expensive). The scale needed (~billions of tonnes/yr by 2050) is an industry that doesn\'t yet exist at size.' },
    { math: '4 · Adaptation as engineering and justice', note: 'Sea walls and managed retreat, heat-resilient crops and building codes, early-warning systems (the earthquake lesson\'s template), water storage — and the adaptation finance gap: the countries least responsible face the highest costs, the fairness problem that defines every COP negotiation (loss and damage fund, agreed 2022).' },
  ],
};
---
<TopicPage slug="subjects/environmental-science/expert/mitigation-and-adaptation-design">
  <h2>The idea</h2>
  <p>
    This lesson is the atlas\'s environmental ladder\'s synthesis: <strong>the actual design of
    the response</strong> — the wedges, the removals, the adaptation portfolio — drawing on every
    other lesson (energy, economics, materials, agriculture, justice) to answer "what would
    solving it look like?"
  </p>

  <Widget no="1" caption="both/and, the wedges, removals, adaptation and justice" widget="equationStep" config={mitigCfg} />

  <h2>Where the design stands, honestly</h2>
  <ul>
    <li><strong>The maths is unforgiving:</strong> current policies → ~2.5–3 °C; pledges delivered → ~2.1 °C; 1.5 °C requires ~45% cuts by 2030 (IEA/IPCC) — the gap is the defining fact, and every year of delay steepens the required slope (the finance lesson\'s compounding, in reverse).</li>
    <li><strong>The tools mostly exist:</strong> solar, wind, batteries, EVs, heat pumps, methane detection (the remote-sensing lesson now names leaking facilities from orbit) — the transition is now an industrial deployment problem (the engineering lesson) more than a discovery problem.</li>
    <li><strong>Success stories shape the pitch:</strong> acid rain, ozone, EVs\' cost curve — each "impossible until inevitable" (the policy lesson\'s pattern). The energy transition is running the same playbook at a hundred times the scale.</li>
    <li><strong>The honest close:</strong> the physics sets the boundary (every 10th of a degree matters — the IPCC\'s graduated risks); the engineering is ready or nearly; economics, politics and justice are the rate-limiters. That is the real state of the problem this ladder has been building toward.</li>
  </ul>
  <p class="sources"><strong>Sources:</strong> IPCC AR6 WG3 (2022); IEA Net Zero Roadmap; Project Drawdown review; UNFCCC loss-and-damage decisions (2022).</p>
</TopicPage>
