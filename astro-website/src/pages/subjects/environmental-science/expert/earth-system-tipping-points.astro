---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const tipCfg = {
  steps: [
    { math: '1 · What "tipping point" means technically', note: 'A threshold where small forcing causes self-sustaining, often irreversible change (positive feedback takes over): ice sheets collapsing, forests dieing back, circulation reorganising. Beyond the threshold, stopping the forcing doesn\'t reverse the change.' },
    { math: '2 · The named candidates', note: 'West Antarctic ice sheet (marine ice-sheet instability — may already be past its threshold); Greenland ice sheet; AMOC weakening (the ocean lesson); Amazon dieback (deforestation + drying — parts converting to savanna); permafrost carbon release; coral reefs (largely committed at ~2 °C).' },
    { math: '3 · Cascades are the real worry', note: 'Elements couple: meltwater weakens AMOC; AMOC shifts shift the monsoons (the geography lesson); a smaller Amazon stores less carbon. The 2023 "Global Tipping Points" report assesses coupling — the system-of-systems risk, not each element alone.' },
    { math: '4 · The honest uncertainty', note: 'Thresholds are imprecisely known (models disagree — the climate-modelling lesson\'s parameterisation problem), probabilities are low for this century for most elements, and irreversibility is the game-changer: low-probability catastrophic + irreversible = the risk calculus that justifies precaution (the statistics lesson\'s tail risk).' },
  ],
};

const estpLoopsBuckets = {
