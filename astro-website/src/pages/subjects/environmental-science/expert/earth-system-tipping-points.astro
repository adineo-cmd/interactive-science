    },
    {
      "label": "ice–albedo — melt exposes dark ocean, which absorbs more heat",
      "bucket": 0
    },
    {
      "label": "permafrost carbon — thaw releases CO₂ and methane, causing more thaw",
      "bucket": 0
    },
    {
      "label": "the Planck response — thermal radiation grows steeply with temperature",
      "bucket": 1
    },
    {
      "label": "cloud responses partially offsetting",
      "bucket": 1
    }
  ],
  "why": "The system's character is the race between them: for small forcings the stabilisers win; near thresholds an amplifying loop can take over and change becomes self-driving."
};

const estpElementsMatch = {
  "prompt": "Six named candidates — pair element with mechanism:",
  "pairs": [
    {
      "left": "West Antarctic ice sheet",
      "right": "marine ice-sheet instability — deepening bedrock geometry makes retreat self-sustaining"
    },
    {
      "left": "Greenland ice sheet",
      "right": "melt-elevation feedback: lower surface, warmer air, more melt"
    },
    {
      "left": "AMOC",
      "right": "freshening from meltwater weakens the sinking that drives it"
    },
    {
      "left": "Amazon dieback",
      "right": "deforestation plus drying flips rainforest to savanna"
    },
    {
      "left": "permafrost",
      "right": "gradual rather than threshold, but self-reinforcing carbon release"
    }
  ],
  "why": "Coral reefs are largely committed already — 70–90% expected lost at 1.5 °C, above 99% at 2 °C. The 2022 Science assessment (Armstrong McKay et al.) rated each element's range and confidence."
};

const estpAmazonEstimate = {
  "prompt": "Lovejoy and Nobre argued that beyond a certain share of Amazon deforestation, the basin's hydrology could pass a point of no return. Roughly what share?",
  "unit": "% deforested",
  "answer": 20,
  "factor": 1.3,
  "why": "Roughly 20–25% — the southeast, now substantially cleared and already a net carbon source in drought years, sits closest to any such line.",
  "context": "Fire is the accelerant: degraded, drier forest burns, and burned forest degrades further."
};

const estpDoomJudge = {
  "statements": [
    {
      "s": "Climate science says we are already doomed next decade.",
      "truth": false,
      "why": "Most thresholds sit above current warming (about 1.2–1.3 °C), some are being probed now — doom language and denial make the same error."
    },
    {
      "s": "'Low confidence in the exact threshold' means 'no risk'.",
      "truth": false,
      "why": "Irreversibility is what changes the calculus — this is the tail-risk logic that underwrites precaution."
    },
    {
      "s": "A 10% chance of a permanent, cascading loss is managed differently from a 10% chance of a reversible one.",
      "truth": true,
      "why": "That asymmetry is the whole point: low-probability plus irreversible is a different risk object."
    },
    {
      "s": "Mistaking uncertainty for a conclusion is the shared error of doom and denial.",
      "truth": true,
      "why": "Uncertainty about where a threshold sits is a reason to weigh the tail, not to dismiss it."
    }
  ]
};

const estpAcidOrder = {
  "prompt": "Detected, crashed, capped, recovered — put the acid-rain story in order:",
  "items": [
    "SO₂ and NOₓ oxidise in the atmosphere to sulfuric and nitric acids, deposited wet and dry",
    "Soils and lakes buffer the acid invisibly for decades",
    "The buffering saturates — pH crashes abruptly: fishless lakes, forest decline",
    "1990: the Acid Rain Program caps SO₂ with a fixed, declining, traded allowance total",
    "Emissions fall about half within a decade, far below projected cost — lakes and forests recover"
  ],
  "why": "Threshold problems are detectable, attributable and reversible with sufficient forcing reduction — the template the climate case studies against."
};

const estpCloudPlace = {
  "prompt": "The ozone hole's non-linearity turns on clouds that form only below one critical temperature. Where does it sit?",
  "labels": [
    "−90 °C",
    "−80 °C",
    "−70 °C",
    "−60 °C"
  ],
  "scale": {
    "min": -90,
    "max": -60
  },
  "answer": -78,
  "tolerance": 2,
  "why": "Below about −78 °C, polar stratospheric clouds provide surfaces that multiply chlorine's reactivity — gradual CFC growth produced an abrupt, deep hole rather than thinning."
};

const estpOzoneSpot = {
  "prompt": "A student's comparison contains one faulty line — click it:",
  "lines": [
    "The ozone hole is stratospheric chemistry: chlorine catalysis, amplified by polar clouds.",
    "Global warming is radiative physics driven mainly by CO₂.",
    "Fixing the ozone hole also fixed the greenhouse effect — same mechanism, same remedy.",
    "CFCs are potent greenhouse gases, so the phase-out helped climate too.",
    "Which is why the ozone remedy could not be copy-pasted onto carbon."
  ],
  "errorLine": 2,
  "correction": "They are separate problems: ozone depletion actually cooled the stratosphere slightly rather than warming the surface.",
  "why": "The equations, the offending gases and the remedies differ — overlapping molecules do not merge the problems."
};

const estpRecoveryPredict = {
  "q": "The Antarctic ozone layer is projected back to 1980 levels around 2066. Why is it healing?",
  "choices": [
    "The threat was imaginary — it healed on its own",
    "A legally binding, near-universal phase-out cut chlorine loads",
    "CFCs turned out to be harmless after all"
  ],
  "answer": 1,
  "why": "Chlorine peaked in the 1990s and declines because the Montreal Protocol is enforced; without it, models project a collapsed ozone layer by the 2050s — environmental successes are evidence that the response works."
