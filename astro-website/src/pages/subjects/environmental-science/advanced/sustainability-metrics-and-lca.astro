import Widget from '../../../../components/Widget.astro';

const lcaCfg = {
  steps: [
    { math: '1 · Count everything, everywhere', note: 'Life Cycle Assessment (LCA): from raw material extraction through manufacture, use and end-of-life — the full inventory of a product\'s environmental flows. Goal first: LCA answers a defined question, it isn\'t a vibe.' },
    { math: '2 · The boundaries question', note: 'Cradle-to-gate (factory exit) vs cradle-to-grave (including use and disposal) vs cradle-to-cradle (circular). Comparisons are valid only at matching boundaries — the most common source of misleading green claims.' },
    { math: '3 · Impact categories', note: 'Global warming potential (CO₂-e), acidification, eutrophication, water use, land use, toxicity — a product wins some, loses others (an EV battery: high manufacturing footprint, near-zero operating — the use-phase dominates over 15 years).' },
    { math: '4 · The classic findings', note: 'Paper vs plastic bags (plastic wins on carbon per use — unless the paper bag is reused 3+×; the answer is "it depends, precisely"), reusable vs disposable cups (break-even after ~20–100 uses), beef vs almost anything (beef loses: ~60 kg CO₂-e/kg vs chicken ~6, legumes ~1 — Poore & Nemecek, 2018, the largest food-LCA study).' },
  ],
};
---
<TopicPage slug="subjects/environmental-science/advanced/sustainability-metrics-and-lca">
  <h2>The idea</h2>
  <p>
    LCA is <strong>accounting for environmental flows</strong> — the discipline that turns
    "eco-friendly" from marketing into measurement. Its rigour lives in the boundaries, the
    inventory data, and the honest handling of trade-offs between impacts.
  </p>

  <Widget no="1" caption="the inventory, the boundaries, the categories, the classic findings" widget="equationStep" config={lcaCfg} />

  <h2>Metrics beyond products</h2>
  <ul>
    <li><strong>Footprints:</strong> carbon, water, material — aggregate LCAs scaled to a person, company or country. Scope 1–2–3 emissions accounting (direct, purchased energy, value chain) is the corporate standard; scope 3 is usually the largest and least controlled.</li>
    <li><strong>Planetary boundaries (the geochemical-cycles lesson\'s gauge panel):</strong> nine Earth-system limits — the 2023 update finds six crossed. Global, not local — a context metric, not a management one.</li>
    <li><strong>Greenwashing detection:</strong> claims without boundaries, single-attribute boasts ("CFC-free!" — everything is), offsets without additionality — the statistics lesson\'s "compared to what?" applied to marketing.</li>
    <li><strong>Where metrics genuinely drive change:</strong> disclosure regimes (mandatory climate reporting in the EU and increasingly elsewhere) moved LCA from academia into every large firm\'s compliance stack — measurement precedes management, in environmental systems as everywhere else.</li>
  </ul>
  <p class="sources"><strong>Sources:</strong> ISO 14040/14044 LCA standards; Poore & Nemecek, Science (2018); Richardson et al., Science Advances (2023); GHG Protocol.</p>
</TopicPage>
