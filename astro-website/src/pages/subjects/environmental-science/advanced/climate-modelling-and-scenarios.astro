const modelCfg = {
  steps: [
    { math: '1 · The physics core', note: 'General circulation models (GCMs) solve conservation of energy, mass and momentum on a rotating sphere — the weather-forecast lesson\'s equations, run for centuries instead of days, with the ocean, ice, land and carbon cycle coupled in.' },
    { math: '2 · Resolution vs complexity', note: 'Global models divide Earth into ~100-km cells; regional models nest down to ~10 km for local detail. Processes smaller than the grid (clouds, convection) are "parameterised" — the main source of model disagreement, and of honest uncertainty bands.' },
    { math: '3 · Scenarios, not predictions', note: ' SSPs (Shared Socioeconomic Pathways): coherent futures for population, economy, policy — from SSP1-1.9 (net zero ~2050, ~1.5 °C) to SSP5-8.5 (unrestrained emissions). The model answers "IF this, THEN that"; humans choose the IF.' },
    { math: '4 · How we know models work', note: 'Hindcasts (reproducing the 20th century), paleoclimate tests (ice ages — the lesson), volcano responses (Pinatubo\'s cooling was predicted), and ensembles (many models, spread = uncertainty). The skill is real and measured: ~0.1 °C precision on 20-year global means.' },
  ],
};

const ecsCfg = {
  title: 'Worked example: from CO₂ doubling to climate sensitivity',
  steps: [
    { math: 'radiative forcing: ΔF = 5.35·ln(C/C₀)', note: 'the logarithmic law — each doubling adds the same forcing, which is why the doubling is the natural unit.' },
    { math: 'doubling CO₂: ΔF = 5.35 × ln 2 ≈ 3.7 W/m²', note: 'a blanket with that much extra thickness, applied instantly, globally, day and night.' },
    { math: 'no-feedback response: ΔT = ΔF/λ ≈ 3.7/3.2 ≈ 1.2 °C', note: 'Stefan–Boltzmann arithmetic: warm the surface until it radiates the extra 3.7 W/m² away.' },
    { math: 'feedbacks amplify: water vapour (+), ice–albedo (+), lapse rate (−), clouds (?)', note: 'the feedback factor f ≈ 2.5–3 in the models — dominated by water vapour, dominated in uncertainty by clouds.' },
    { math: 'ECS = 1.2 × 2.5–3 ≈ 2.5–4 °C per doubling', note: 'the IPCC AR6 assessment: very likely between 2 and 5, best estimate 3. Every carbon budget and every pathway projection inherits this number.' },
  ],
};

