const bodyplanCfg = {
  steps: [
    { math: '1 · Multicellularity', note: 'Many cells, one organism — with division of labour between them. The cheapest innovation, and the most consequential.' },
    { math: '2 · Symmetry', note: 'Sponges have none. Radial symmetry (jellyfish) suits drifting; bilateral symmetry (everything from worms to us) suits directed movement.' },
    { math: '3 · Tissue layers', note: 'Diploblasts build two layers; triploblasts three — and the middle layer (mesoderm) becomes muscle, bone and blood.' },
    { math: '4 · The body cavity', note: 'A coelom — a fluid-filled body cavity — lets organs move independently, cushions them, and provides space for a gut to run its own programme.' },
