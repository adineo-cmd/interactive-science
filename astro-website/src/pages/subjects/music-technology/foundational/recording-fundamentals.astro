        {
          "label": "Open a de-clipper plugin and repair the waveform",
          "next": "repair",
          "feedback": "Editing and mixing reshape what was captured — the clipped tips were never recorded, so the repair is guessing."
        },
        {
          "label": "Re-track the vocal with more headroom before the next pass",
          "next": "retrack",
          "feedback": "Decisions made before pressing record are worth more than any correction applied after."
        }
      ]
    },
    "repair": {
      "text": "A de-clipper can guess at the missing tips, but the cause is baked in: a badly recorded source is a permanent tax. The professional move is re-tracking.",
      "choices": []
    },
    "retrack": {
      "text": "Lower the preamp gain for the next pass, leave headroom at performance level, and the take survives every future mix — capture, don't rescue.",
      "choices": []
    }
  },
  "why": "Editing, tuning and mixing only reshape what exists — a vocal clipped at the converter cannot be un-clipped, and a roomy thin guitar sound cannot lose its room."
};

const rfMicCompare = {
