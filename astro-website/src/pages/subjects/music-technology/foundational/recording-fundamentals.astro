    "text": "Far finer detail and sensitivity — the default studio vocal mic — but it needs +48 V phantom power down the cable, hears everything (bad rooms, computer fans) and overloads in front of a kick drum."
  },
  "why": "Choose for source and room, not price — the choice depends on what you record and where."
};

const rfLeverBuckets = {
  "prompt": "Three levers move the mic before EQ does. File each effect:",
  "buckets": [
    "Distance — sets the direct-to-room blend",
    "Axis — sets tone and brightness",
    "Spacing — keeps multi-miking clean"
  ],
  "items": [
    {
      "label": "2–5 cm from the lips: almost all direct sound, intimate and dry",
      "bucket": 0
    },
    {
      "label": "pulled back to 30 cm: the mic breathes with the room",
      "bucket": 0
    },
    {
      "label": "directional mics boost bass as they get closer (proximity effect)",
      "bucket": 0
    },
    {
      "label": "singing slightly off-axis tames harshness",
      "bucket": 1
