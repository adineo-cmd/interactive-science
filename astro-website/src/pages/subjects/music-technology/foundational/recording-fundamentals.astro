};

const rfAmpMatch = {
  "prompt": "One SM57, one amp, four moves. Pair position with result:",
  "pairs": [
    {
      "left": "centre of the cone",
      "right": "the tone hardens"
    },
    {
      "left": "where the cone meets the dust cap",
      "right": "bright and present — the standard move"
    },
    {
      "left": "edge of the cone",
      "right": "the tone darkens"
    },
    {
      "left": "pulled back a foot",
      "right": "the room arrives"
    }
  ],
  "why": "Move the mic through those positions while the player repeats a loop, listening for the one where the tone is right at the source — because at the source, correction is free."
};

const rfPriceJudge = {
  "statements": [
    {
      "s": "A well-placed SM57 in a good position beats a boutique condenser badly placed.",
      "truth": true,
      "why": "Placement and the room dominate price in almost every practical test."
    },
    {
      "s": "Price buys nothing at all.",
      "truth": false,
      "why": "It buys detail, consistency, lower self-noise — real, but the last few percent."
    },
    {
      "s": "The microphone is the first fifty percent; the position is the last few.",
      "truth": false,
      "why": "Inverted — the position is the first fifty; the microphone is the last few percent."
