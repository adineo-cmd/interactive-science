---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const compneuroCfg = {
  steps: [
    { math: '1 · Models as hypothesis testers', note: 'A computational model encodes a theory precisely enough to run. If it reproduces the biology, the theory survives; if not, the theory was vaguer than it felt. Modelling is how neuroscience states ideas testably.' },
    { math: '2 · Encoding and decoding', note: 'Encoding: how does a stimulus map to neural response (light → spike rate)? Decoding: how much about the stimulus can you read back from the spikes? Together they define what the nervous system represents.' },
    { math: '3 · Neural networks as brain models', note: 'Deep networks trained on vision develop representations surprisingly like visual cortex — not because they copy biology, but because the task forces similar solutions. As models of the brain they are hypotheses, currently excellent ones for vision.' },
    { math: '4 · Efficiency arguments', note: 'The brain runs on ~20 watts; training frontier AI consumes gigawatt-hours. Reverse-engineering the brain\'s learning rules (sparse coding, neuromorphic chips, event-driven computation) is both neuroscience and an engineering goldmine.' },
  ],
};

