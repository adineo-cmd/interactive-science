import Widget from '../../../../components/Widget.astro';

const synapseCfg = {
  steps: [
    { math: '1 · The electrical spike arrives', note: 'An action potential reaches the presynaptic terminal. Electrical signals can\'t cross the gap — chemistry takes over.' },
    { math: '2 · Calcium opens the vesicles', note: 'Vesicles full of neurotransmitter fuse with the membrane and release their cargo into the 20-nanometre gap (the synaptic cleft).' },
    { math: '3 · Receptors receive', note: 'Transmitter molecules dock on the next cell\'s receptors — opening ion channels (fast, milliseconds) or triggering chemical cascades (slow, seconds to minutes).' },
    { math: '4 · Cleanup determines the message length', note: 'Enzymes break the transmitter down (acetylcholinesterase) or transporters pump it back (reuptake — where SSRIs act). Interference with cleanup is how many drugs work.' },
    { math: '5 · Summation decides', note: 'One neuron receives thousands of inputs; excitatory minus inhibitory decides whether it spikes. The brain\'s computation is this vote, happening ~100 trillion times.' },
  ],
};
---
<TopicPage slug="subjects/neuroscience/intermediate/neurons-and-synapses">
  <h2>The idea</h2>
  <p>
    The synapse is <strong>where neurons actually talk</strong> — an electrochemical converter
    turning spikes into chemical messages and back. It is also the brain's adjustable part:
    synapses strengthen and weaken, which is the physical substrate of learning, and the target
    of nearly every psychiatric and neurological drug.
  </p>

  <Widget no="1" caption="the synaptic event, step by step" widget="equationStep" config={synapseCfg} />

  <h2>The cast of transmitters</h2>
  <ul>
    <li><strong>Glutamate:</strong> the main excitatory messenger — workhorse of learning and memory (its receptors, AMPA and NMDA, are the plasticity machinery).</li>
    <li><strong>GABA:</strong> the main inhibitory messenger — the brain's braking system; anxiety disorders and their drugs live in this circuitry.</li>
    <li><strong>Dopamine:</strong> reward, motivation and movement — Parkinson's disease kills dopamine cells; addictive drugs hijack the pathway (the neurotransmitter lesson expands).</li>
    <li><strong>Serotonin, acetylcholine, norepinephrine:</strong> mood, attention, arousal — the neuromodulators that set the brain's overall state rather than passing specific messages.</li>
    <li><strong>Glia deserve the credit they got late:</strong> astrocytes feed neurons and regulate synapses; oligodendrocytes build insulation (myelin). The brain is more than neurons.</li>
  </ul>
  <p class="sources"><strong>Sources:</strong> Kandel et al., Principles of Neural Science; Südhof (Nobel 2013) on vesicle machinery; Nichols, "Dopamine and Addiction".</p>
</TopicPage>
