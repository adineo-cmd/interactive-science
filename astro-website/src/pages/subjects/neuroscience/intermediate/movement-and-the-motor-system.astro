---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const motorCfg = {
  steps: [
    { math: '1 · The hierarchy of movement', note: 'Prefrontal cortex decides ("pick up the cup"); motor cortex commands; cerebellum times and smooths; basal ganglia gate the initiation; spinal cord executes. Damage anywhere gives a distinct signature.' },
    { math: '2 · The corticospinal tract', note: 'Axons from motor cortex travel down the spinal cord, crossing at the neck — which is why each hemisphere controls the opposite side. Damage: paralysis below the cut (spinal injuries) or on the opposite side (strokes).' },
    { math: '3 · Cerebellum: the error corrector', note: 'It compares intended with actual movement and corrects in real time — damage produces jerky, overshooting motion, not paralysis. It also predicts: learning to catch a ball is cerebellar model-building.' },
    { math: '4 · Basal ganglia: the gatekeeper', note: 'They select and initiate movements (and habits). Dopamine loss here = Parkinson\'s (tremor, rigidity, hesitation); excess = Huntington\'s chorea. The motor system\'s traffic lights.' },
  ],
};

const motorQuizCfg = {
  questions: [
    {
      q: 'A patient is slow to start moving, has rigid limbs and a tremor at rest, but no weakness when movement is finally under way. Which part of the hierarchy is most likely at fault?',
      choices: [
        'The corticospinal tract',
        'The cerebellum',
        'The basal ganglia',
        'The alpha motor neurons',
      ],
      answer: 2,
      why: 'Slowness of initiation, rigidity and a resting tremor with preserved strength is the basal ganglia signature — dopamine loss in Parkinson\'s disease. Corticospinal damage produces weakness; cerebellar damage produces jerky, inaccurate movement rather than hesitancy.',
    },
    {
      q: 'Why is the patellar (knee-jerk) reflex a monosynaptic arc rather than a conscious response?',
      choices: [
        'Because the brainstem relays the signal to the muscle',
        'Because the whole loop — sensory fibre, one spinal synapse, motor fibre — runs in about 50 ms, faster than any cortical route could manage',
        'Because the quadriceps has no sensory receptors',
        'Because conscious responses would be stronger',
      ],
      answer: 1,
      why: 'Ia afferents conduct at up to about 100 m/s and the single synapse adds almost nothing, so the total loop takes roughly 50 ms. Conscious perception alone takes about 200 ms of cortical processing — a reflex that "asked the brain" would arrive long after the leg buckled.',
    },
    {
      q: 'Which eye-movement system can only follow a target that is already moving, and fails completely on a stationary object?',
      choices: [
        'Saccades',
        'The vestibulo-ocular reflex',
        'Vergence',
        'Smooth pursuit',
      ],
      answer: 3,
      why: 'Smooth pursuit exists to hold the image of a moving object on the fovea; it has nothing to drive it when the target is still. Try it: stare at a fixed point and move your eyes "smoothly" — they will break into small saccades. Pursuit tracks at up to roughly 30-40 degrees per second.',
    },
    {
      q: 'A person reaches for a cup and their hand overshoots wildly to the right, then corrects in several jerky steps. Strength is normal. Where is the lesion?',
      choices: [
        'Motor cortex',
        'Cerebellum',
        'Spinal cord',
        'Neuromuscular junction',
      ],
      answer: 1,
      why: 'Dysmetria (mis-scaling of movements) with normal strength, plus the corrective "staircase" pattern, is the cerebellar signature. The cerebellum does not generate force; it calibrates movement size and timing — so its failure shows up as inaccuracy, not paralysis.',
    },
  ],
};

const mtUnitEstimate = {
  "prompt": "One alpha motor neuron plus all the fibres it innervates is a motor unit. Roughly how many fibres are in a unit of the gastrocnemius (calf) muscle?",
  "unit": "fibres",
  "answer": 1500,
  "factor": 1.6,
  "why": "About 1,000–2,000 — power over precision. The extraocular muscles that aim the eyes run units of roughly a dozen fibres each, the fine gradation eye movements need.",
  "context": "Recruitment and rate coding are the two dimensions of the numbers game."
};

const mtSensorMatch = {
  "prompt": "Muscle is a sensor organ. Pair each component with its report:",
  "pairs": [
    {
      "left": "muscle spindle — lying in parallel",
      "right": "muscle length and, above all, the velocity of stretch via fast Ia afferents"
    },
    {
      "left": "Golgi tendon organ — in series",
      "right": "tension — the force the muscle is producing"
    },
    {
      "left": "the gamma system",
      "right": "keeps the spindle taut during contraction so it stays sensitive at every length"
    },
    {
      "left": "without the gamma loop",
      "right": "shortening a muscle would silence its own sensor"
    }
  ],
  "why": "One measures position and speed, the other load — two questions, two sensors embedded in the same muscle."
};

const mtUpwardJudge = {
  "statements": [
    {
      "s": "Muscles are dumb actuators that merely receive commands.",
      "truth": false,
      "why": "About a third of the nervous system's traffic with muscle is upward — a continuous report of limb position, speed and load."
    },
    {
      "s": "Spindle and tendon afferents give the spinal cord and cortex a continuous report.",
      "truth": true,
      "why": "Position, speed and load stream upward while commands stream down."
    },
    {
      "s": "Without that upward report, people can still coordinate a reach with their eyes closed.",
      "truth": false,
      "why": "Deprived of it, people cannot coordinate a reach without watching their hands — controlling each joint by eye."
    },
    {
      "s": "Large-fibre sensory neuropathy removes the upward report.",
      "truth": true,
      "why": "It does exactly this — which is how the report's necessity was demonstrated."
    }
  ]
};

const mtReflexOrder = {
  "prompt": "The patellar reflex, from tap to kick. Rebuild the loop:",
  "items": [
    "A tap on the tendon stretches the quadriceps",
    "Spindles fire",
    "Ia afferents race to the spinal cord at up to 80–120 metres per second",
    "A single synapse excites the alpha motor neurons of the same muscle",
    "The quadriceps contracts — total loop time about 50 milliseconds"
  ],
