---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const apCfg = {
  points: [{
    points: [[0, -70], [1, -70], [1.5, -55], [2, 40], [2.5, 30], [3, -10], [3.5, -55], [4, -75], [4.5, -70], [5.5, -67], [6.5, -70]],
    label: 'membrane voltage', mode: 'line', color: '#9f1239',
  }],
  x: { min: 0, max: 7, label: 'time (ms)' },
  y: { min: -90, max: 55, label: 'voltage (mV)' },
  crossings: false,
  height: 360,
};

const nePhaseOrder = {
  "prompt": "One action potential, left to right across the curve. Rebuild the phases:",
  "items": [
    "Resting — about −70 mV, maintained by the sodium–potassium pump",
    "Threshold crossed",
    "Depolarisation — sodium floods in",
    "Repolarisation — potassium flows out",
    "Hyperpolarisation — a brief dip below rest",
    "Recovery — the original ion distribution restored"
  ],
  "why": "The spike is all-or-nothing: stronger stimuli do not produce bigger spikes, only more frequent ones — information rides in firing frequency."
};

const nePartsMatch = {
  "prompt": "One design, local specialisations. Pair each component with its job:",
  "pairs": [
    {
      "left": "dendrites",
      "right": "branching antennae collecting signals from hundreds to thousands of neurons"
    },
    {
      "left": "soma",
      "right": "sums excitation against inhibition every millisecond"
    },
    {
      "left": "axon",
      "right": "output cable — in humans sometimes a metre long, only micrometres across"
    },
    {
      "left": "synapses",
      "right": "where the spike is converted into a chemical message"
    },
    {
      "left": "microglia",
      "right": "the immune cells of the supporting cast"
    }
  ],
  "why": "Glia outnumber neurons roughly one to one, and interneurons are the overwhelming majority — the brain is mostly processing, not wiring to the periphery."
};

const neChemSpot = {
  "prompt": "A popular-science script about brain chemistry contains one faulty line — click it:",
  "lines": [
    "'Serotonin is the brain's chemical for happiness — released, it bathes the brain in good mood.'",
    "A transmitter acts on the few receptors within nanometres of its release site.",
    "It is then pumped back or destroyed within milliseconds.",
    "Chemicals act locally at specific synapses, like transistors with chemistry."
  ],
  "errorLine": 0,
  "correction": "There are no chemicals for emotions: the brain is a circuit of spiking cells, and a transmitter released at one connection acts only locally — it never bathes the brain.",
  "why": "The neuron is an electrical device made of salt water, protein and a membrane; its chemistry is point-to-point, at specific synapses."
};

const neGradientEstimate = {
  "prompt": "The sodium–potassium pump burns ATP to hold the gradients. Roughly how many times more potassium does the cell keep inside than outside?",
  "unit": "×",
  "answer": 30,
  "factor": 1.5,
  "why": "Roughly 20–40× more K⁺ inside than outside — a battery built from salt, charged by exporting 3 Na⁺ for every 2 K⁺ imported.",
  "context": "At equilibrium the potassium Nernst potential is about −90 mV; rest sits near −70 mV because a little sodium also leaks in."
};

const neThresholdPlace = {
  "prompt": "Voltage-gated sodium channels snap open past a trigger voltage. Place the marker at threshold:",
  "labels": [
    "−90 mV",
    "−70 mV",
    "−50 mV",
    "−30 mV",
    "−10 mV",
    "+10 mV",
    "+30 mV",
    "+50 mV"
  ],
  "scale": {
    "min": -90,
    "max": 50
  },
  "answer": -55,
  "tolerance": 4,
  "why": "Threshold sits near −55 mV: subthreshold inputs die out, and past it the full spike fires — binary, noise-resistant signalling like computer logic."
};

const nePumpJudge = {
  "statements": [
    {
      "s": "The sodium–potassium pump fires the spike, spending ATP on each action potential as it happens.",
      "truth": false,
      "why": "The spike is passive chemistry: channels open and ions run down gradients the pump built earlier."
    },
    {
      "s": "The pump restores concentrations over thousands of spikes.",
      "truth": true,
      "why": "Slow bookkeeping — which is why a poison blocking the pump silences a neuron only after a delay."
    },
    {
      "s": "Tetrodotoxin, of pufferfish fame, silences a neuron instantly.",
      "truth": true,
      "why": "It blocks the channels themselves, so no spike can regenerate at all."
    },
    {
      "s": "Blocking the pump and blocking the channels silence a neuron on the same timescale.",
      "truth": false,
      "why": "Channel block is instant; pump block waits for the stored gradients to run down."
    }
  ]
};

const neToxinMatch = {
  "prompt": "The peripheral junction as a pharmacology bench. Pair each agent with what it does:",
  "pairs": [
    {
      "left": "curare",
      "right": "blocks the receptors — paralysis"
    },
    {
      "left": "botulinum",
      "right": "blocks release by disabling the SNARE fusion machinery"
    },
    {
      "left": "nicotine",
      "right": "mimics acetylcholine"
    },
    {
      "left": "organophosphate nerve agents",
      "right": "block the enzyme that clears the transmitter"
    }
  ],
  "why": "One motor-neuron spike releases a flood of acetylcholine — a safety factor so large the muscle contracts every single time, and each agent attacks a different link of that chain."
};

const neLtpCloze = {
  "text": "A synapse repeatedly active exactly when the postsynaptic cell is strongly %%0%% strengthens: the %%1%% glutamate receptor is the %%2%% detector, open only when both %%3%% and voltage are present.",
  "answers": [
    [
      "depolarised",
      "depolarization",
      "depolarisation"
    ],
    [
      "NMDA"
    ],
    [
      "coincidence"
    ],
    [
      "glutamate"
    ]
  ],
  "hint": "Two of the blanks are the receptor's name and the property that made it famous."
};
---
<TopicPage slug="subjects/neuroscience/foundational/the-neuron">
  <h2>Where you are, and what you will learn</h2>
  <p>
    This is the opening lesson of Neuroscience, and it assumes no prior biology — the neuron
    is introduced as what it is: an electrical device made of salt water, protein and a
    membrane. Every idea here is built from zero, one step at a time.
  </p>
  <p>By the end you will be able to:</p>
  <ul>
    <li>name a neuron's parts and their jobs — dendrites collecting, the soma summing, the axon conducting, synapses transmitting;</li>
    <li>explain how the resting potential is built, and why a cell at rest is armed rather than idle;</li>
    <li>recount the action potential ion by ion, and say why it is all-or-nothing with a refractory period;</li>
    <li>describe how the spike travels, what myelin buys, and why multiple sclerosis and local anaesthetics have the effects they do;</li>
    <li>follow the signal across the synapse into chemistry, and outline how plasticity edits connections — the biology of learning.</li>
  </ul>
  <h2>The idea</h2>
  <p>
    The brain's signalling cell, the <strong>neuron</strong>, is an electrical device. Your brain holds
    roughly 86 billion of them, each a thin-walled bag of salty fluid whose membrane separates the
    inside from the outside — and across that membrane, the cell maintains a voltage. The resting charge
    is about <strong>−70 mV</strong> (inside negative); when incoming signals push the voltage past a
    threshold (near −55 mV), the neuron fires an <strong>action potential</strong> — a self-propagating
    spike that surges to about +40 mV and races down the cell's output fibre at up to 120 m/s. That
    spike is the only message the neuron ever sends. Everything you think, feel and remember is patterns
    of these spikes, passed between cells across synapses in a chemical code. This lesson follows the
    signal the whole way: what a neuron is, how the resting voltage is built, how the spike works ion
    by ion, how it travels, how it crosses the gap to the next cell, and how the connections themselves
    change — the biology of learning.
  </p>

  <Widget no="1" caption="one action potential, phase by phase — hover to read the voltage at each moment" widget="plotter" config={apCfg} />
  <p>
    <strong>What to notice:</strong> the trace rests flat near −70 mV, then — once threshold
    is crossed — leaps to about +40 mV in half a millisecond: one vertical cliff, not a
    gradation, before the fall back past rest and recovery.
  </p>

  <p>
    Read the curve left to right: <strong>resting</strong> (−70 mV, maintained by the sodium–potassium
    pump), <strong>threshold</strong> crossed, <strong>depolarisation</strong> as sodium floods in,
    <strong>repolarisation</strong> as potassium flows out, a brief <strong>hyperpolarisation</strong>
    dip below rest, then recovery. The spike is all-or-nothing: stronger stimuli do not produce "bigger
    spikes" but <em>more frequent ones</em>.
  </p>
  <Widget no="2" caption="rebuild the spike — phase by phase" widget="order" config={nePhaseOrder} />

  <h2>The parts and their jobs</h2>
  <p>
    Neurons share a design with local specialisations, which is why the same cell type can serve seeing,
    moving and remembering. <strong>Dendrites</strong> are the antennae — branching input surfaces that
    collect signals from hundreds to thousands of other neurons. The <strong>soma</strong> (cell body)
    houses the nucleus and, crucially, sums the inputs: a tiny integrator weighing excitation against
    inhibition every millisecond. The <strong>axon</strong> is the output cable, in humans sometimes a
    metre long (toe to spinal cord) but only micrometres across; its tip branches into terminals that
    form the <strong>synapses</strong> — where the spike is converted into a chemical message for the
    next cell. Neurons themselves come in functional classes: <strong>sensory</strong> neurons carry
    information in from the body, <strong>motor</strong> neurons carry commands out, and
    <strong>interneurons</strong> do the local processing in between — in humans, interneurons are the
    overwhelming majority, which is a way of saying the brain is mostly processing, not wiring to the
    periphery. The supporting cast matters too: <strong>glia</strong> outnumber neurons roughly one to
    one — astrocytes manage the chemical environment and blood supply, oligodendrocytes (and Schwann
    cells in the body) wrap axons in insulating myelin, and microglia are the immune cells. A
    <strong>neural network</strong> is simply neurons wired through synapses; the brain's trick is that
    both the spiking <em>and</em> the wiring are adjustable, so the network is simultaneously computing
    and being recomputed.
  </p>
  <Widget no="3" caption="pair each part with its job" widget="match" config={nePartsMatch} />
  <p><em>Common misconception:</em> the brain is not a fluid of "chemicals for emotions" — it is a
  circuit of spiking cells whose chemicals act locally, at specific synapses, like transistors with
  chemistry. A neurotransmitter released at one connection does not wash through the brain; it acts on
  the few receptors within nanometres, then is pumped back or destroyed within milliseconds.</p>
  <Widget no="4" caption="find the faulty line — a pop-science script" widget="spot-error" config={neChemSpot} />

  <h2>The resting potential: a battery built from salt</h2>
  <p>
    Why does a bag of salty water have a voltage? Because the membrane is picky and the cell does work.
    Three facts combine. First, the cell actively pumps ions: the <strong>sodium–potassium pump</strong>
    exports 3 Na<sup>+</sup> for every 2 K<sup>+</sup> it imports, burning ATP — so sodium is kept scarce
    inside, potassium abundant (roughly 20–40× more K<sup>+</sup> inside than outside). Second, the
    resting membrane leaks: K<sup>+</sup> channels are open, so potassium drifts <em>out</em> down its
    concentration gradient. Third, each departing K<sup>+</sup> carries a positive charge, leaving the
    inside increasingly negative — and that negative voltage pulls K<sup>+</sup> back. Equilibrium is
    reached where the electrical pull exactly cancels the chemical push: the potassium
    <strong>Nernst potential</strong>, about −90 mV. The resting potential sits at ~−70 mV because a
    little sodium also leaks in, dragging the voltage partway toward sodium's own equilibrium (+60 mV).
    The result is a charged capacitor waiting to discharge: a cell at rest is not idle, it is
    <em>armed</em> — a battery the spike will spend.
  </p>
  <Widget no="5" caption="call the gradient — the pump's work" widget="estimate" config={neGradientEstimate} />

  <h2>The action potential, ion by ion</h2>
  <p>
    The spike is the story of two voltage-gated channel families. <strong>Voltage-gated sodium
    channels</strong> are closed at rest but snap open when the membrane depolarises past threshold
    (~−55 mV). Their opening is self-amplifying: open channels let Na<sup>+</sup> rush in, which
    depolarises further, which opens more channels — a positive feedback loop that slams the membrane
    toward sodium's +60 mV equilibrium within half a millisecond (the plot's vertical cliff, past +40
    mV in practice). But the sodium channel has a built-in timer: it <strong>inactivates</strong> within
    about a millisecond regardless of voltage, a ball-and-chain plug that ends the inward rush. By then
    the slower <strong>voltage-gated potassium channels</strong> have opened; K<sup>+</sup> exits down
    both its gradient and the now-positive-inside voltage, restoring the negative interior —
    repolarisation, often overshooting rest into <strong>hyperpolarisation</strong> (the dip below −70
    mV) because those channels close slowly. The pump and leak channels then quietly restore the original
    ion distribution. The sequence gives the spike two decisive properties. It is
    <strong>all-or-nothing</strong>: subthreshold inputs die out, threshold inputs produce the same
    full spike — binary signalling, noise-resistant like computer logic. And it enforces a
    <strong>refractory period</strong>: for a millisecond or two after firing, the sodium channels are
    inactivated and no new spike is possible (absolute refractory), then harder to trigger (relative) —
    which sets the maximum firing rate and guarantees the spike travels one way, because the region
    behind it cannot refire.
  </p>
  <Widget no="6" caption="place the marker — the trigger point" widget="place" config={neThresholdPlace} />
  <p><em>Common misconception:</em> the sodium–potassium pump fires the spike — that ATP is spent on each action potential as it happens. The spike itself is passive chemistry: voltage-gated channels open and ions run down the gradients the pump built earlier. The pump does slow bookkeeping — restoring concentrations over thousands of spikes — which is why a poison blocking the pump silences a neuron only after a delay, while one blocking the channels (tetrodotoxin, of pufferfish fame) silences it instantly.</p>
  <Widget no="7" caption="true or false — the pump and the spike" widget="judge" config={nePumpJudge} />
  <p>
    <strong>So far:</strong> the spike is passive chemistry run on the battery the pump built
    — sodium channels self-amplify past threshold and self-cancel within a millisecond,
    slower potassium channels restore the rest — giving binary, all-or-nothing signalling
    with a refractory period that keeps the spike travelling one way.
  </p>

  <h2>Propagation: how the spike travels</h2>
  <p>
    An action potential regenerates itself as it goes. Each patch of membrane, depolarised by the
    preceding patch, crosses its own threshold and fires its own full spike — a travelling wave of
    cellular dominoes that arrives at the axon terminal exactly as strong as it left the soma. Speed
    depends on cable physics: fatter axons conduct faster (less internal resistance — the squid's giant
    axon, half a millimetre wide, is evolution's crude high-speed cable), but the elegant solution is
    <strong>myelin</strong>: fatty insulation wrapped in segments, with bare gaps (<strong>nodes of
    Ranvier</strong>) where the voltage-gated channels cluster. The spike cannot fire under the
    insulation; instead it jumps node to node — <strong>saltatory conduction</strong> — going from about
    1 m/s unmyelinated to over 100 m/s myelinated, in a cable a fraction of the diameter. This is why
    multiple sclerosis is so devastating: the immune system strips myelin, spikes leak and fade between
    nodes, and signals fail before arriving. It is also why local anaesthetics work: they block sodium
    channels, so nociceptive neurons cannot fire their spikes past the injection.
  </p>
  <p><em>Common misconception:</em> a nerve is a copper wire and the spike is electricity flowing down it from one end to the other. The axon is a leaky, resistive tube of salt water — hopeless as a long-distance conductor — so the membrane regenerates the signal as it travels: each patch fires its own full spike from its own ion battery, triggered by the patch before. Nothing physical flows the length of the fibre except a wave of channel openings; the charges move across the membrane, not along it. That design is why speed depends on diameter and insulation, and why myelin matters so much.</p>

  <h2>The synapse: chemistry in a 20-nanometre gap</h2>
  <p>
    The spike arrives at the terminal and meets a problem: the next cell is 20–40 nm away, an
    unbridgeable gap for electricity at that scale. The solution is conversion — electricity to
    chemistry and back. When the spike depolarises the terminal, <strong>voltage-gated calcium
    channels</strong> open; Ca<sup>2+</sup> floods in, and calcium is the trigger that makes
    neurotransmitter-filled vesicles dock and fuse with the membrane (the SNARE protein machinery does
    the physical fusion — the same machinery botulinum toxin disables, which is why Botox relaxes
    muscles). The transmitter diffuses across the cleft in microseconds and binds receptors on the next
    cell. The textbook case is the <strong>neuromuscular junction</strong>: one motor-neuron spike
    releases a flood of <strong>acetylcholine</strong> onto the muscle fibre, producing a depolarisation
    far above the muscle's threshold — a safety factor so large the muscle contracts every single time.
    Curare blocks those receptors (paralysis); botulinum blocks release; nicotine mimics ACh;
    organophosphate nerve agents block the enzyme that clears it. In the <strong>central nervous
    system</strong>, transmission is subtler: one spike releases a few vesicles, producing a small
    <strong>EPSP</strong> (excitatory postsynaptic potential) that decays in milliseconds — so a
    cortical neuron integrates dozens of inputs, excitatory (mostly <strong>glutamate</strong>) and
    inhibitory (mostly <strong>GABA</strong>), summing them toward or away from threshold. The
    transmitter families divide the work: <strong>acetylcholine</strong> for neuromuscular control and
    attention; <strong>biogenic amines</strong> — dopamine (reward and salience; the target of
    Parkinson's loss and cocaine's hijacking), serotonin (mood, the direct target of SSRIs), noradrenaline
    (alertness) — for modulating whole circuits; <strong>amino acids</strong> glutamate and GABA for the
    fast on/off traffic of everything else; <strong>neuropeptides</strong> (endogenous opioids among
    them) for slower, longer-lasting modulation; and even a <em>gas</em>, nitric oxide, which diffuses
    backwards through the membrane with no receptor at all.
  </p>
  <Widget no="8" caption="pair each agent with its target" widget="match" config={neToxinMatch} />
  <p>
    <strong>So far:</strong> at the synapse the spike converts from electricity to chemistry
    and back — calcium-triggered vesicle fusion, transmitter across the 20-nanometre cleft,
    receptors on the next cell — with the peripheral junction built for certainty and
    central synapses built to integrate many small inputs.
  </p>

  <h2>Plasticity: connections that change</h2>
  <p>
    The wiring is not finished at birth — it is <em>edited</em> by experience. During development,
    neurons overproduce synapses and then keep the ones that are used: <strong>synapse formation,
    survival and elimination</strong> is competition, where activity is the currency. In visual
    cortex, closing one eye early in life hands its cortical territory to the other eye permanently —
    the basis of treating childhood amblyopia as a race against the pruning window. In adolescence a
    second pruning wave refines the prefrontal cortex. The adult mechanism of learning is
    <strong>synaptic plasticity</strong>, its best-studied form <strong>long-term potentiation</strong>
    (LTP): a synapse repeatedly active <em>exactly when</em> the postsynaptic cell is strongly
    depolarised strengthens — the NMDA glutamate receptor is the coincidence detector, open only when
    both glutamate and voltage are present, letting Ca<sup>2+</sup> in to install more receptors
    downstream. "Cells that fire together, wire together" is a slogan for a molecular rule, and it is
    the current best candidate for a physical memory trace. Diseases map directly onto the machinery:
    <strong>amyotrophic lateral sclerosis</strong> kills motor neurons, <strong>Parkinson's</strong>
    destroys dopamine neurons in the substantia nigra, some epilepsy is inherited mutations in sodium
    channel genes, and myasthenia gravis is autoimmune antibodies against the muscle's own ACh
    receptors — each a lesson in which part of the signal chain was load-bearing.
  </p>
  <Widget no="9" caption="fill the blanks — the molecular rule of learning" widget="cloze" config={neLtpCloze} />

  <h2>Check yourself</h2>
  <p>Try these before moving on. Feedback follows each answer.</p>
  <ol>
    <li>Why does a neuron at rest have a voltage across its membrane at all?</li>
    <li>A stimulus depolarises the membrane only to −60 mV, short of threshold. Does the neuron fire a smaller-than-normal spike?</li>
    <li>What does myelin buy, and what happens when the immune system strips it away?</li>
  </ol>
  <p>
    <strong>Feedback:</strong> (1) The sodium–potassium pump keeps sodium scarce and
    potassium abundant inside; open potassium channels let potassium drift out, and each
    departing positive charge leaves the inside negative until the electrical pull exactly
    cancels the chemical push — about −70 mV, a charged battery waiting to discharge.
    (2) No spike occurs: signalling is all-or-nothing, so subthreshold inputs die out, and
    once threshold is crossed the full spike fires regardless of how much stronger the
    stimulus is — stronger stimuli mean more frequent spikes, not bigger ones. (3) Saltatory
    conduction: the spike jumps node to node over the insulation, going from about 1 m/s to
    over 100 m/s in a thinner cable; strip the myelin, as in multiple sclerosis, and spikes
    leak and fade between nodes, failing before they arrive.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>The neuron is an electrical device: about −70 mV at rest, threshold near −55 mV, spikes to about +40 mV at up to 120 m/s.</li>
    <li>The resting potential is built by the sodium–potassium pump plus open potassium leak channels — a battery the spike will spend.</li>
    <li>The spike is all-or-nothing; information rides in firing frequency, never in spike size.</li>
    <li>The refractory period caps firing rate and guarantees one-way travel.</li>
    <li>Myelin enables saltatory conduction — node-to-node jumps above 100 m/s; demyelination is multiple sclerosis.</li>
    <li>At the synapse, electricity converts to chemistry: calcium triggers vesicle fusion and transmitter release.</li>
    <li>Connections are edited by experience — LTP, "cells that fire together, wire together", is the best candidate for a memory trace.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    You can now follow one signal from membrane to synapse to editable connection. The
    frontier flagged above is where the discipline is heading: rate codes and spike timing
    beyond single cells, grid cells mapping space, and optogenetics turning the causal
    question "is this circuit sufficient for the behaviour?" into a laboratory routine.
  </p>

  <h2>Going deeper</h2>
  <p>
    The quantitative layer, for the committed: the modern era began with <strong>Hodgkin and Huxley
    (1952)</strong>, who used the squid giant axon and the voltage-clamp technique (hold voltage fixed,
    measure the current that must be injected — thereby measuring the channels' behaviour) to write four
    coupled equations describing conductances for Na<sup>+</sup>, K<sup>+</sup> and leak. Their model
    reproduced the spike, its threshold, refractory period and propagation speed — from channel
    kinetics measured before channels were known to exist — and earned the 1963 Nobel Prize; it is still
    the seed of every computational neuroscience simulator. The <strong>Nernst equation</strong> behind
    the equilibrium potentials is E = (RT/zF)·ln(outside/inside): 58 mV per decade of concentration at
    body temperature — memorisable, and the reason the numbers above are what they are. Beyond single
    spikes, information is carried by the <strong>rate code</strong> (a neuron firing at 100 Hz is
    "shouting") and by <strong>spike timing</strong> relative to other neurons, and populations can
    represent continuously varying quantities — direction of motion, location in space (the grid cells
    of the entorhinal cortex) — as activity bumps across many neurons. At the frontier,
    <strong>optogenetics</strong> inserts light-sensitive channels into specified neurons, letting
    researchers switch identified cells on and off in a moving animal — the tool that turned the
    causal question "is this circuit sufficient for the behaviour?" into a laboratory routine. And the
    circuit story loops back to where we began: the brain does not compute <em>despite</em> being made
    of unreliable, noisy, electrochemical cells. It computes the way it does because each cell is a
    battery, a threshold, a one-way regenerating signal and an adjustable connection — four tricks,
    86 billion times over.
  </p>
  <p class="sources"><strong>Sources:</strong> Hodgkin & Huxley, J. Physiol. (1952); Kandel, Koester, Mack & Siegelbaum, Principles of Neural Science (6th ed.); Herculano-Houzel on neuron counts (2009); Bliss & Lømo on LTP (1973). Source text: OpenStax (https://openstax.org), CC BY 4.0 — adapted for Interactive Atlas.</p>
</TopicPage>
