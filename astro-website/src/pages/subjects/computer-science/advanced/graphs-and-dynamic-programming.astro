const graphCfg = {
  steps: [
    { math: 'Graph = nodes + edges', note: 'The most general structure in computing: cities and roads, people and friendships, pages and links, tasks and dependencies. If your problem is "things connected to things", it is a graph problem.' },
    { math: 'BFS: explore in rings', note: 'Breadth-first search visits all neighbours, then neighbours-of-neighbours — using a queue. It finds the SHORTEST path in unweighted graphs: six-degrees-of-separation, chess moves, web crawlers.' },
    { math: 'DFS: dive deep, backtrack', note: 'Depth-first search follows one path to its end, then backtracks — using a stack. It detects cycles, sorts tasks topologically, and solves mazes.' },
    { math: 'Dijkstra: weighted shortest path', note: 'When edges have costs (distance, time, money), Dijkstra greedily expands the cheapest frontier — the algorithm inside every maps app.' },
    { math: 'Dynamic programming: remember your work', note: 'Many hard problems decompose into overlapping subproblems. Solve each once, store it, reuse: Fibonacci from 2ⁿ to n steps, spell-checkers, DNA alignment, and the knapsack problem.' },
