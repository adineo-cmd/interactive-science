const graphQuiz = {
  questions: [
    {
      q: "In Dijkstra's algorithm, why must every edge weight be non-negative?",
      choices: [
        "Negative weights crash the priority queue",
        "The greedy proof breaks — with negative edges, a longer path can later become cheaper after passing through them",
        "It only affects performance, not correctness",
        "Negative weights are impossible to store",
      ],
      answer: 1,
      why: "Dijkstra finalises each node as 'settled' once popped; a negative edge could still shorten that settled distance afterwards. The Bellman–Ford algorithm handles negative edges by relaxing all edges repeatedly (and detects negative cycles).",
    },
    {
      q: "Naive recursive Fibonacci(40) makes about 331 million calls. Roughly how many does memoised DP make?",
      choices: ["About 331 million — DP only saves memory", "About 79 — each subproblem computed once", "About 40,000", "It cannot be computed recursively"],
      answer: 1,
      why: "Memoisation computes each fib(k) once: 2n − 1 calls ≈ 79 for n = 40. The naive tree recomputes fib(2) on the order of fib(38) ≈ 63 million times — the exponential blow-up DP removes entirely.",
