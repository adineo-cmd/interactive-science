---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const graphCfg = {
  steps: [
    { math: 'Graph = nodes + edges', note: 'The most general structure in computing: cities and roads, people and friendships, pages and links, tasks and dependencies. If your problem is "things connected to things", it is a graph problem.' },
    { math: 'BFS: explore in rings', note: 'Breadth-first search visits all neighbours, then neighbours-of-neighbours — using a queue. It finds the SHORTEST path in unweighted graphs: six-degrees-of-separation, chess moves, web crawlers.' },
    { math: 'DFS: dive deep, backtrack', note: 'Depth-first search follows one path to its end, then backtracks — using a stack. It detects cycles, sorts tasks topologically, and solves mazes.' },
    { math: 'Dijkstra: weighted shortest path', note: 'When edges have costs (distance, time, money), Dijkstra greedily expands the cheapest frontier — the algorithm inside every maps app.' },
    { math: 'Dynamic programming: remember your work', note: 'Many hard problems decompose into overlapping subproblems. Solve each once, store it, reuse: Fibonacci from 2ⁿ to n steps, spell-checkers, DNA alignment, and the knapsack problem.' },
  ],
};

const graphQuiz = {
  questions: [
    {
      q: "In Dijkstra's algorithm, why must every edge weight be non-negative?",
      choices: [
        "Negative weights crash the priority queue",
        "The greedy proof breaks — with negative edges, a longer path can later become cheaper after passing through them",
        "It only affects performance, not correctness",
        "Negative weights are impossible to store",
      ],
      answer: 1,
      why: "Dijkstra finalises each node as 'settled' once popped; a negative edge could still shorten that settled distance afterwards. The Bellman–Ford algorithm handles negative edges by relaxing all edges repeatedly (and detects negative cycles).",
    },
    {
      q: "Naive recursive Fibonacci(40) makes about 331 million calls. Roughly how many does memoised DP make?",
      choices: ["About 331 million — DP only saves memory", "About 79 — each subproblem computed once", "About 40,000", "It cannot be computed recursively"],
      answer: 1,
      why: "Memoisation computes each fib(k) once: 2n − 1 calls ≈ 79 for n = 40. The naive tree recomputes fib(2) on the order of fib(38) ≈ 63 million times — the exponential blow-up DP removes entirely.",
    },
    {
      q: "Which representation should you choose for a social network with 1 billion nodes and average degree 200?",
      choices: [
        "Adjacency matrix — a billion-by-billion grid is standard",
        "Adjacency list — space O(V + E); the matrix would need 10¹⁸ entries, almost all zero",
        "A sorted array of all edges",
        "Representation doesn't matter",
      ],
      answer: 1,
      why: "Real graphs are sparse: the matrix costs O(V²) memory regardless of edges (10¹⁸ cells here — impossible), while the list costs O(V + E). The matrix only wins for small or genuinely dense graphs and O(1) edge lookups.",
    },
  ],
};

const gpTravSort = {
  "prompt": "File each power under the traversal that supplies it:",
  "buckets": [
    "BFS — the queue",
    "DFS — the stack"
  ],
  "items": [
    {
      "label": "explores in rings: start, then all neighbours, then neighbours-of-neighbours",
      "bucket": 0
    },
    {
      "label": "dives along one path, backtracking at dead ends",
      "bucket": 1
    },
    {
      "label": "six-degrees-of-separation and chess move calculation",
      "bucket": 0
    },
    {
      "label": "cycle detection — a back edge to a node still on the stack",
      "bucket": 1
    },
    {
      "label": "topological ordering — build systems, course prerequisites",
      "bucket": 1
    },
    {
      "label": "web crawlers and puzzle solvers",
      "bucket": 0
    }
  ],
  "why": "One data-structure choice produces two different worldviews — queue versus stack."
};

const gpLoopJudge = {
  "statements": [
    {
      "s": "BFS and DFS are the same loop with different containers, so either one finds shortest paths.",
      "truth": false,
      "why": "Only BFS exhausts distance d before d+1 — its first arrival is provably a shortest unweighted path; DFS dives and may arrive by a long route first."
    },
    {
      "s": "DFS's job is structure — cycles, topological order, connected components.",
      "truth": true,
      "why": "A back edge to a node still on the stack means a cycle; finish-time order reverses into a valid task sequence."
    },
    {
      "s": "Topological ordering is the algorithm behind build systems and course prerequisites.",
      "truth": true,
      "why": "DFS's finish-time order reversed is a valid task sequence."
    },
    {
      "s": "BFS needs a weighted graph to promise shortest paths.",
      "truth": false,
      "why": "The ring property holds in unweighted graphs — or weighted with equal weights; costs are Dijkstra's territory."
    }
  ]
};

const gpKnapsackEst = {
  "prompt": "Brute force over a knapsack with twenty items checks every subset. Roughly how many is that?",
  "unit": "subsets",
  "answer": 1048576,
  "factor": 2,
  "why": "2²⁰ ≈ a million possibilities — the DP grid replaces it with 20 × capacity entries: exponential becomes polynomial.",
  "context": "For the capacity-5 miniature, two dozen entries against sixteen possibilities."
};

const gpRegimeBranch = {
  "root": "A new problem lands on your desk. Walk the method choice.",
  "nodes": {
    "start": {
      "text": "Can a local choice be provably safe — is the cheapest edge crossing any partition always part of some optimum?",
      "choices": [
        {
          "label": "Yes — greedy it is",
          "next": "greedy",
          "feedback": "Kruskal and Prim territory: faster than DP, applicable to fewer problems — local safety holds, so no grid is needed."
        },
        {
          "label": "No — but best answers compose from best subproblems that recur",
          "next": "dp",
          "feedback": "Both ingredients hold: dynamic programming — cache each subproblem once and the exponential tree collapses to a grid."
        }
      ]
    },
    "dp": {
      "text": "DP confirmed. Top-down or bottom-up?",
      "choices": [
        {
          "label": "Top-down — keep the recursion, add a cache",
          "next": "topdown",
          "feedback": "Memoisation: only reachable subproblems are computed — better when the state space is sparse."
        },
        {
          "label": "Bottom-up — fill the grid in dependency order",
          "next": "bottomup",
          "feedback": "Tabulation: no call overhead, compiler-friendly, and the space trick becomes visible."
        }
      ]
    },
    "greedy": {
      "text": "Greedy confirmed. But test it — if local safety ever fails, the greedy answer is confidently wrong.",
      "choices": [
        {
          "label": "Local safety fails sometimes — fall back",
          "next": "fallback",
          "feedback": "That boundary — between provable local safety and the need for a grid — is the discipline."
        }
      ]
    },
    "topdown": {
      "text": "Sparse state spaces love memoisation — you pay only for states you actually visit.",
      "choices": []
    },
    "bottomup": {
      "text": "Dense, performance-critical grids love tabulation — and the previous-row trick shrinks memory to a single row.",
      "choices": []
    },
    "fallback": {
      "text": "Exact DP up to a size, approximation for provable near-answers, heuristics for good-enough — the professional spectrum.",
      "choices": []
    }
  },
  "why": "Greedy, DP or brute force — the choice is testing whether local choices are safe, not reaching for a favourite."
};

const gpMstOrder = {
  "prompt": "Kruskal at work on the miniature — put the steps in order:",
  "items": [
    "Sort the edges by weight: AB=1, AC=2, DE=2, BC=3, CD=5, BD=6",
    "Take AB (1), AC (2), DE (2)",
    "Consider BC (3) — it would cycle A-B-C: skip",
    "Take CD (5) — C joins D",
    "Tree complete at weight 10: four edges for five vertices — the n−1 shape"
  ],
  "why": "Both greedy algorithms are provably optimal — the cut property — which is exactly why these are not DP problems."
};

const gpLcsCloze = {
  "text": "LCS(\"ABCDE\", \"ACE\") = \"ACE\", length %%0%% — the shared letters in sequence, gaps allowed. If the last characters match, take %%1%% + LCS(i−1, j−1); otherwise max(LCS(i−1, j), LCS(i, j−1)). For two 5,000-letter genomes the grid holds %%2%% million cells.",
  "answers": [
    [
      "3"
    ],
    [
      "1"
    ],
    [
      "25"
    ]
  ],
  "hint": "git diff, DNA alignment, spell-check — one recurrence, three industries."
};

const gpModelMatch = {
  "prompt": "Pair each scenario with what the recipe yields:",
  "pairs": [
    {
      "left": "course catalogue",
      "right": "prerequisites as directed edges — reachability, topological sort, cycles caught by DFS"
    },
    {
      "left": "knight on a chessboard",
      "right": "squares as vertices, legal jumps as edges — fewest hops is BFS on 64 nodes"
    },
    {
      "left": "word ladder (cold → warm)",
      "right": "words as vertices, one-letter changes as edges — BFS over a 170,000-node construction"
    },
    {
      "left": "the registrar's bug",
      "right": "an impossible requirement — the cycle DFS finds"
    }
  ],
  "why": "Name the nodes, define the edges, state what shortest means — then pick BFS, DFS or Dijkstra by weight structure."
};

const gpFillSpot = {
  "prompt": "A summary of the two DP styles contains one faulty line — click it:",
  "lines": [
    "Memoisation keeps the recursive structure — write the natural recurrence, add a cache.",
    "Top-down only computes reachable subproblems — an advantage when the full grid is not needed.",
    "Tabulation fills the grid in dependency order — no call overhead.",
    "The knapsack row only needs the previous row, so iterate forwards to avoid reusing an item twice.",
    "The fill order IS the correctness argument: each cell depends only on cells already final."
  ],
  "errorLine": 3,
  "correction": "Iterate BACKWARDS, to avoid reusing an item twice — that single careful direction collapses the grid from O(n × capacity) to O(capacity) memory.",
  "why": "Choose top-down when the recurrence is intricate or the state space sparse; bottom-up when dense and performance-critical."
};
---
<TopicPage slug="subjects/computer-science/advanced/graphs-and-dynamic-programming">
  <h2>Where you are, and what you will learn</h2>
  <p>
    This is an advanced lesson in Computer Science. It assumes the foundational lesson <em>Growth
    of Functions</em> — every complexity claim below is Big-O arithmetic — and the intermediate
    lesson <em>Algorithms: Searching and Sorting</em>, whose trace-table discipline this chapter
    runs on real machinery. <em>Programming Fundamentals</em> supplies the recursion the DP
    sections rebuild.
  </p>
  <p>By the end you will be able to:</p>
  <ul>
    <li>choose a graph representation from sparsity, not habit — and say what each choice costs;</li>
    <li>trace BFS and DFS, and state which structural answers each one is for;</li>
    <li>run Dijkstra with a full trace table, and explain why non-negative weights are load-bearing;</li>
    <li>build a DP table for knapsack and LCS, naming subproblem, recurrence and fill order;</li>
    <li>decide between greedy, DP and brute force by testing whether local choices are safe.</li>
  </ul>

  <h2>The idea</h2>
  <p>
    Two tools unlock most of algorithmic computer science. <strong>Graphs</strong> model anything made of
    connected things — roads, friendships, dependencies, states — and a handful of traversal algorithms
    extract every classic answer from them. <strong>Dynamic programming (DP)</strong> tames exponential
    blow-ups by remembering subproblem answers. Both are examples of the algorithm-design unit's central
    discipline: name the problem's structure precisely, and the method of solution — and the trace table
    that proves it correct — follows.
  </p>

  <Widget no="1" caption="the graph–DP toolkit, in five sentences" widget="equationStep" config={graphCfg} />
  <p>
    <strong>What to notice:</strong> the five panels are ordered by the questions they answer —
    model, explore two ways, weigh the edges, remember your work. Watch how BFS and DFS differ
    only in their container (queue versus stack) while producing different guarantees, and how
    the final panel turns an exponential call tree into a table you can fill by hand.
  </p>

  <h2>Representing graphs — the first design decision</h2>
  <p>
    A graph G = (V, E) is nodes and edges (directed or not, weighted or not); everything downstream depends
    on the representation. The <strong>adjacency matrix</strong> is a V×V grid where entry (i, j) says
    whether i connects to j: O(1) edge lookups, but O(V²) memory — fine for 500 nodes, impossible for a
    social network's billion. The <strong>adjacency list</strong> stores, per node, its neighbours:
    O(V + E) memory, and it is what real code uses, because real graphs are <strong>sparse</strong> (E
    closer to V than to V²). The choice is not cosmetic: iterating a node's neighbours — the operation
    every traversal performs millions of times — is O(degree) on a list and O(V) on a matrix row.
  </p>

  <h2>BFS and DFS: the two traversals</h2>
  <p>
    <strong>Breadth-first search</strong> explores in rings using a <strong>queue</strong>: visit the
    start, then all its neighbours, then neighbours-of-neighbours. Because it exhausts distance d before
    d+1, the first time BFS reaches a node is via a <strong>shortest path</strong> (in unweighted graphs —
    or weighted with equal weights). That single property powers six-degrees-of-separation queries, chess
    move calculation, web crawling and puzzle solvers. <strong>Depth-first search</strong> dives along one
    path using a <strong>stack</strong> (explicitly, or the call stack via recursion), backtracking at
    dead ends. It does not find shortest paths, but it finds structure: <strong>cycle detection</strong>
    (a back edge to a node still on the stack), <strong>topological ordering</strong> (finish-time order
    reverses into a valid task sequence — the algorithm behind build systems and course prerequisites),
    and connected components. The two traversals are the same loop with a different container — queue
    versus stack — a fact worth savouring: one data-structure choice produces two different worldviews.
  </p>
  <Widget no="10" caption="file each power under the traversal that supplies it" widget="sort-buckets" config={gpTravSort} />
  <p><em>Common misconception:</em> "BFS and DFS are the same loop with different containers, so
  either one finds shortest paths." The shared loop is real — but the guarantee is not. It seems
  reasonable because both visit every node eventually. The correct picture: only BFS exhausts
  distance d before d+1, so its first arrival is provably a shortest unweighted path; DFS dives
  and can reach a node by a long route first, which is fine because its job is structure —
  cycles, topological order, components — not distance. Choosing the traversal means choosing
  which question you are answering.</p>
  <Widget no="9" caption="true or false — what each traversal guarantees" widget="judge" config={gpLoopJudge} />
  <p>
    <strong>So far:</strong> representation is a sparsity decision, and the two traversals are
    one loop with two containers — each with its own guarantee. Next, what happens when edges
    carry costs and the ring guarantee fails.
  </p>

  <h2>Dijkstra: shortest paths with a trace</h2>
  <p>
    When edges carry costs, BFS's ring guarantee fails (a cheap long route can beat an expensive short
    one), and <strong>Dijkstra's algorithm</strong> (1959) takes over: maintain a best-known distance to
    every node, repeatedly <strong>pop the unsettled node with the smallest distance</strong> from a
    priority queue, settle it, and <strong>relax</strong> its edges (if going through it shortens a
    neighbour, update the neighbour). With non-negative weights the greedy step is provably safe. Trace it
    — this is the unit's trace-table skill applied to real machinery. Graph: A→B = 4, A→C = 2, C→B = 1,
    B→D = 5, C→D = 8, D→E = 3.
  </p>
  <p>
    Start: dist(A)=0, all else ∞. Pop A (0): relax B=4, C=2. Pop C (2): relax B to
    <strong>3</strong> (2+1 beats 4 — the "longer but cheaper" route wins), D=10. Pop B (3): relax D to
    <strong>8</strong>. Pop D (8): relax E=11. Pop E: done. Answer: A to E costs 11 via C–B–D. Two
    professional notes: the decrease-key moment (B's distance improving after C) is where the priority
    queue earns its keep; and correctness <em>requires</em> non-negative weights — with a negative edge, a
    settled node could later be cheapened (Bellman–Ford handles that case by relaxing all edges V−1 times,
    and detects negative cycles, which is how arbitrage detectors work on currency graphs). Complexity
    with a binary heap: O((V + E) log V) — how a maps app routes you through millions of road segments
    in milliseconds, on graphs whose edge weights (traffic) change continuously.
  </p>
  <p><em>Common misconception:</em> "you can run Dijkstra on negative edge weights as long as you
  are careful with the priority queue." It seems reasonable because the relax step looks like it
  adapts to whatever the weights say. But the greedy proof — settling each popped node as final —
  is exactly what negative edges break: a longer route through a negative edge can cheapen an
  already-settled node after the algorithm has stopped listening. The correct picture: with
  negative weights use Bellman–Ford, which relaxes all edges V−1 times and detects negative
  cycles as a bonus — the trick arbitrage detectors run on currency graphs.</p>
  <p>
    <strong>So far:</strong> Dijkstra keeps BFS's shortest-path promise alive for weighted
    graphs, at the price of a provable greedy step. Next, the tool for problems where no greedy
    choice is safe at all — and where remembering subproblems turns exponential into polynomial.
  </p>

  <h2>Dynamic programming: the two ingredients and a full worked example</h2>
  <p>
    DP applies when a problem has <strong>optimal substructure</strong> (the best answer is composed of
    best answers to subproblems) and <strong>overlapping subproblems</strong> (the same subproblems recur).
    Naive recursion then recomputes identical work exponentially; caching it once collapses the tree to a
    table. The toy that shows the shape: naive <code>fib(40)</code> makes about 331 million calls, because
    fib(2) is recomputed tens of millions of times; <strong>memoised</strong> (store computed values) it
    makes 79. The same move underlies spell-checking (edit distance between words), DNA sequence
    alignment, and speech recognition.
  </p>
  <p>
    The full worked example is the <strong>0/1 knapsack</strong>: capacity 5; items A (weight 1, value 1),
    B (3, 4), C (4, 5), D (2, 3). Brute force checks 2⁴ = 16 subsets — and 2²⁰ ≈ 1,048,576 for twenty
    items. DP builds a table: rows = items considered so far, columns = capacity 0–5, each cell = best
    value achievable. After A: (0,1,1,1,1,1). Adding B (w3,v4): capacity 3 improves to 4, capacities 4–5
    to 4 → (0,1,1,4,4,4). Adding C (w4,v5): capacity 4 → 5, capacity 5 → max(4, best[1] + 5 = 6) = 6 →
    (0,1,1,4,5,6). Adding D (w2,v3): capacity 2 → 3; capacity 5 → max(6, best[3] + 3 = 7) = 7. Answer:
    <strong>7, achieved by B + D</strong> (weights 3+2 = 5). The table cost 4 × 6 = 24 cells instead of 16
    subsets here — and 20 × capacity instead of a million for the real case: <strong>exponential becomes
    polynomial</strong>. Whether you memoise top-down or fill the table bottom-up is style; the
    discipline — define the subproblem exactly, write the recurrence, identify the fill order — is the
    method, and it is the same discipline as the unit's trace tables and test-data design.
  </p>
  <Widget no="8" caption="call the brute-force bill for twenty items" widget="estimate" config={gpKnapsackEst} />
  <p><em>Common misconception:</em> DP means "recursion with a dictionary" and applies wherever code is
  slow. It applies exactly when both ingredients hold; greedy algorithms (like Dijkstra, or Huffman
  coding) solve the subfamily where a local choice is always safe — faster, but applicable to fewer
  problems. Knowing which regime you are in is the design skill.</p>
  <Widget no="7" caption="walk the method choice for a new problem" widget="branch" config={gpRegimeBranch} />

  <h2>Minimum spanning trees: the greedy family, worked</h2>
  <p>
    Dijkstra's cousin problem: connect all nodes at minimum total edge weight (fibre to every town,
    pipes to every house). <strong>Kruskal's algorithm</strong> sorts edges by weight and adds each that
    does not complete a cycle (union-find tracks components in near-constant amortised time);
    <strong>Prim's</strong> grows one tree from a start node, always adding the cheapest edge out of it —
    Dijkstra with distances measured in edge cost rather than path length. Worked miniature: nodes A-E,
    edges AB=1, BC=3, AC=2, CD=5, DE=2, BD=6. Kruskal takes AB (1), AC (2), DE (2), then BC (3) would
    cycle A-B-C, skip; CD (5) joins C to D: tree complete at weight 1+2+2+5 = 10, four edges for five
    nodes — the MST's defining shape (n−1 edges). The lesson within the lesson: <strong>both greedy
    algorithms are provably optimal</strong> (the cut property: the cheapest edge crossing any partition
    belongs to some MST), which is exactly why they are not "DP problems" — local safety holds, so no
    table is needed. Recognising when greedy suffices, when you need DP, and when neither works is the
    algorithm-design unit's actual deliverable.
  </p>
  <Widget no="6" caption="run Kruskal on the miniature" widget="order" config={gpMstOrder} />

  <h2>Dynamic programming, second verse: longest common subsequence</h2>
  <p>
    One more recurrence, because its family is everywhere (git diff, DNA alignment, spell-check). The
    <strong>longest common subsequence</strong> of two strings keeps the order but not contiguity:
    LCS("ABCDE", "ACE") = "ACE", length 3. The subproblem: LCS(i, j) over prefixes. The recurrence: if
    the last characters match, 1 + LCS(i−1, j−1); otherwise max(LCS(i−1, j), LCS(i, j−1)). The table
    (rows ABCDE, columns ACE) fills 6 × 4 = 24 cells where brute force would test 2⁵ = 32 subsequences
    against A's — and for two 5,000-letter genomes, 25 million table cells against an astronomically
    large subset space. Trace one corner: LCS("AB", "A") — B ≠ A, so max(LCS("A","A"), LCS("AB","")) =
    max(1, 0) = 1. Fill order (row by row) guarantees every dependency is ready — the discipline that
    makes DP mechanical. The same recurrence, run with edit costs, becomes edit distance (your
    keyboard's spelling suggestions); with scoring matrices, the Smith–Waterman algorithm biologists
    run daily; with probabilities, speech recognition's Viterbi pass. One recurrence, three industries.
  </p>
  <Widget no="5" caption="fill the blanks — the recurrence behind git diff" widget="cloze" config={gpLcsCloze} />

  <h2>From traversal to solution: the modelling skill</h2>
  <p>
    The traversals are mechanical; the expert move is <strong>seeing the graph</strong>. Worked mini-cases
    in the unit's own style. A course catalogue: courses are nodes, prerequisites are directed edges —
    "can I finish this degree?" is a reachability question, "give me a valid order" is topological sort,
    and a cycle means an impossible requirement (the registrar's bug, found by DFS). A knight on a
    chessboard: squares are nodes, legal moves are edges; "fewest moves to reach a square" is BFS on 64
    nodes — which is why it is a beginner exercise, and why the same construction scaled to every
    position-and-move pair becomes game-tree search. A word ladder (cold → cord → card → ward → warm):
    words as nodes, one-letter-changes as edges — BFS finds the shortest ladder over a 170,000-node
    graph built in seconds from a dictionary. Each case follows the same recipe: name the nodes, define
    the edges, state what "shortest" means, pick BFS/DFS/Dijkstra by weight structure. The syllabus's
    "designing and creating a solution" topic is this recipe; the algorithms are its standard methods of
    solution; and the trace tables of the unit are how you verify each by hand before the code exists.
  </p>
  <Widget no="4" caption="pair each scenario with the modelling recipe it asks for" widget="match" config={gpModelMatch} />

  <h2>DP variants: memoisation versus tabulation, decided</h2>
  <p>
    The two styles compute the same table and differ in where the recursion lives.
    <strong>Memoisation</strong> (top-down) keeps the recursive structure — write the natural recurrence,
    add a cache, and only reachable subproblems are computed (an advantage when the full table is not
    needed: for the knapsack with capacity 10,000 and 50 items, top-down may touch far fewer than the
    half-million cells). <strong>Tabulation</strong> (bottom-up) fills the table in dependency order —
    no recursion overhead, friendlier to memory limits and to the compiler's optimiser, and it makes the
    space-optimisation trick visible: the knapsack row only needs the <em>previous</em> row, so the
    table collapses from O(n × capacity) to O(capacity) memory with a single careful iteration
    direction (backwards, to avoid reusing an item twice). Choose top-down when the recurrence is
    intricate or the state space sparse; bottom-up when it is dense and performance-critical. The
    invariant that makes either trustworthy: each cell depends only on cells already final — the fill
    order <em>is</em> the correctness argument, which is why the trace-table habit from the unit's test
    data topic is, in disguise, the DP method itself.
  </p>
  <Widget no="3" caption="find the faulty line — the fill-order detail" widget="spot-error" config={gpFillSpot} />

  <h2>Check yourself</h2>
  <p>Try these before moving on. Feedback follows each answer.</p>
  <ol>
    <li>Name the two ingredients a problem needs before dynamic programming applies, and say what naive recursion does when they hold.</li>
    <li>For the knapsack worked above (capacity 5; A weight 1 value 1, B 3/4, C 4/5, D 2/3), state the optimal selection and the table cell that produced it.</li>
    <li>Why exactly does a negative edge weight break Dijkstra, and which algorithm would you switch to?</li>
  </ol>
  <p>
    <strong>Feedback:</strong> (1) Optimal substructure (best answers compose) and overlapping
    subproblems (the same ones recur); naive recursion then recomputes identical subproblems
    exponentially — fib(2) tens of millions of times at n = 40 — while caching collapses the
    tree to one entry per subproblem. (2) B + D, weights 3 + 2 = 5, value 4 + 3 = 7: the final
    cell takes max(6, best[3] + 3) = 7, i.e. the best value at capacity 3 (item B) plus item D.
    (3) Dijkstra settles each node as final when popped; a negative edge can shorten a settled
    node afterwards, so the greedy proof fails. Bellman–Ford relaxes every edge V−1 times and
    detects negative cycles — which is how arbitrage detectors work on currency graphs.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>Representation is the first design decision: adjacency lists for sparse graphs, O(V + E); matrices cost O(V²) regardless.</li>
    <li>BFS and DFS are one loop with two containers — queue gives shortest unweighted paths, stack gives structure.</li>
    <li>Dijkstra extends BFS to weighted graphs; its greedy proof demands non-negative weights.</li>
    <li>DP needs optimal substructure plus overlapping subproblems; memoise or tabulate, and the fill order is the correctness argument.</li>
    <li>Kruskal and Prim are provably greedy — knowing when local safety holds is the design skill.</li>
    <li>Modelling is the expert move: name the nodes, define the edges, state what shortest means.</li>
    <li>Exponential becomes polynomial when a table replaces a recomputed call tree.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    <em>Data Structures</em> is the direct sequel — the queues, stacks, heaps and union-find
    this chapter borrowed — and <em>Networking: How the Internet Works</em> shows shortest-path
    thinking running the routing layer for real. For the theory boundary sketched below,
    continue to the expert lesson <em>Computability and Complexity</em>.
  </p>

  <h2>Going deeper</h2>
  <p>
    <strong>The boundary of the tractable.</strong> Shortest path, MST, max flow, matching — polynomial.
    Travelling salesman, most scheduling, general SAT — <strong>NP-hard</strong>: no polynomial algorithm
    is known, and a polynomial solution to any one would solve them all (P versus NP, the field's grand
    open problem — the computability lesson's subject). The professional response is a spectrum: exact DP
    works up to a size (knapsack's pseudo-polynomial table), approximation algorithms give provable
    near-answers, and heuristics (simulated annealing, genetic algorithms) give good-enough answers with
    no guarantees — knowing when to switch from exact to heuristic is precisely the judgement this unit
    exists to build. <strong>Graph algorithms at scale</strong> fragment the classical theory: billion-edge
    graphs do not fit one machine, so distributed traversals (Pregel's "think like a vertex"), streaming
    algorithms that see each edge once, and semi-external memory layouts rebuild BFS and Dijkstra under
    new cost models. <strong>DP in modern guise</strong> underlies much of machine learning: the Viterbi
    algorithm is DP over hidden states; reinforcement learning's value iteration is DP over states; even
    transformer attention is a table of subproblem scores. The recurrence you wrote for knapsack is, in a
    precise sense, the ancestor of the techniques deciding what your feed shows you. Open questions: are
    there genuinely harder-than-NP-complete structures (the polynomial hierarchy says yes, formally); can
    shortest paths be answered faster than sorting bounds allow (the field keeps shaving log factors);
    and what new algorithmic primitives, if any, will quantum computers add to this toolkit?
  </p>

