import Widget from '../../../../components/Widget.astro';

const secCfg = {
  steps: [
    { math: '1 · Know your assets', note: 'Security starts with "what would actually hurt if stolen, altered or deleted?" — data, credentials, uptime. You cannot defend an inventory you never made.' },
    { math: '2 · Threat-model the paths', note: 'Who might attack, from where, for what gain? A threat model turns vague fear into a checklist of doors and windows.' },
    { math: '3 · Never trust input', note: 'Every value from users, networks or files is hostile until validated. Injection attacks (SQL, script) remain among the top breaches — decades after the fix was known.' },
    { math: '4 · Defence in depth', note: 'Layer controls: hashed passwords, least-privilege access, encryption in transit and at rest, backups, logging. Assume any single layer fails eventually.' },
    { math: '5 · The human layer is thickest', note: 'Phishing beats firewalls. Most major breaches begin with a click or a reused password — training and multi-factor authentication are technical controls too.' },
  ],
};

const secQuiz = {
  questions: [
    {
      q: "A login check builds SQL as \"SELECT * FROM users WHERE name='\" + input + \"' AND pass='...'. A user types ' OR '1'='1 as the name. What happens?",
      choices: [
        "The database returns a syntax error and rejects the login",
        "The query becomes always-true on the name clause — an authentication bypass: the classic SQL injection",
        "Nothing; quotes are stripped automatically",
        "Only the password check becomes weaker",
      ],
      answer: 1,
      why: "Hostile input crossed the data/code boundary and became part of the program. The structural fix is parameterised queries (the driver keeps data out of the code path) — boring, known since the 1990s, still on top-10 breach lists.",
    },
    {
      q: "A leaked database contains unsalted MD5 password hashes. Why is this catastrophic even though MD5 is 'a hash'?",
      choices: [
        "Hashes can be reversed directly with maths",
        "MD5 is fast to compute, so GPUs guess billions of candidates per second and check them — and without per-user salts, one precomputed table cracks every identical password at once",
        "The database is now readable by anyone",
        "MD5 hashes are shorter than the passwords",
      ],
      answer: 1,
      why: "Hashing is one-way but guessable: security rests on how slow checking is. Fast hashes (MD5/SHA-1) are wrong for passwords; slow, salted, memory-hard functions (bcrypt, argon2) make each guess cost milliseconds instead of nanoseconds.",
    },
    {
      q: "Which control stops a stolen password from being enough to break in?",
      choices: [
        "Longer password rules",
        "Multi-factor authentication — a second, different factor (device, biometric) the thief does not have",
        "A firewall",
        "Stronger encryption of the database",
      ],
      answer: 1,
      why: "Credentials are the most-stolen asset on the internet; MFA attacks the assumption that possession of the password equals identity. It is one of the few controls that defeats whole attack classes cheaply.",
    },
  ],
};
