import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const secCfg = {
  steps: [
    { math: '1 · Know your assets', note: 'Security starts with "what would actually hurt if stolen, altered or deleted?" — data, credentials, uptime. You cannot defend an inventory you never made.' },
    { math: '2 · Threat-model the paths', note: 'Who might attack, from where, for what gain? A threat model turns vague fear into a checklist of doors and windows.' },
    { math: '3 · Never trust input', note: 'Every value from users, networks or files is hostile until validated. Injection attacks (SQL, script) remain among the top breaches — decades after the fix was known.' },
    { math: '4 · Defence in depth', note: 'Layer controls: hashed passwords, least-privilege access, encryption in transit and at rest, backups, logging. Assume any single layer fails eventually.' },
    { math: '5 · The human layer is thickest', note: 'Phishing beats firewalls. Most major breaches begin with a click or a reused password — training and multi-factor authentication are technical controls too.' },
  ],
};
---
<TopicPage slug="subjects/computer-science/advanced/cybersecurity-threats-and-defences">
  <h2>The idea</h2>
  <p>
    Cybersecurity is <strong>asymmetric by nature</strong>: attackers need one weakness,
    defenders need every one closed, always. The discipline is therefore not a product but a
    process — inventory, threat-model, harden, monitor, rehearse, repeat. The core skill is
    thinking like an attacker about your own systems, honestly.
  </p>

  <Widget no="1" caption="the five moves of a defensible system" widget="equationStep" config={secCfg} />

  <h2>The vocabulary of attacks</h2>
  <ul>
    <li><strong>Injection & XSS:</strong> hostile data interpreted as code. Parameterised queries and output escaping close them — boring fixes, catastrophic omissions.</li>
    <li><strong>Password storage done right:</strong> never store passwords; store slow salted hashes (bcrypt/argon2). "Hashed" is not enough — MD5 falls to GPUs in seconds.</li>
    <li><strong>Crypto misuse beats crypto breaking:</strong> attackers rarely crack mathematics; they steal keys, exploit defaults, or bypass the crypto entirely. (The cryptography lesson covers the primitives.)</li>
    <li><strong>Zero-days and patching:</strong> unknown flaws exist in every system. Fast, automated patching is the highest-value security investment most organisations can make.</li>
    <li><strong>Ethical hacking:</strong> the same skills, authorised and contracted — bug bounties and penetration tests turn attackers into auditors. Authorisation is what distinguishes the profession from crime.</li>
  </ul>
  <p class="sources"><strong>Sources:</strong> OWASP Top 10; NIST Cybersecurity Framework; Verizon Data Breach Investigations Report.</p>
</TopicPage>
