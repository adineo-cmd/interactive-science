const compCfg = {
  steps: [
    { math: '1 · Lexing: characters → tokens', note: 'Split source text into words: identifiers, numbers, operators. "x = 3 + y" becomes a stream of five tokens.' },
    { math: '2 · Parsing: tokens → tree', note: 'Apply the grammar and build an abstract syntax tree. This is where "the semicolon is missing" errors are born — the parser is strict because ambiguity would be fatal.' },
    { math: '3 · Semantic analysis: does it mean anything?', note: 'Type-checking and scope resolution. The tree may parse; the compiler refuses "add a number to a date".' },
    { math: '4 · Optimisation: do less, same result', note: 'Dead-code removal, constant folding, loop unrolling — provably-equivalent rewrites. Modern compilers routinely outperform hand-tuning.' },
    { math: '5 · Code generation: tree → machine instructions', note: 'Emit assembly for the target CPU, link against libraries, produce the executable. Your idea has become voltage patterns.' },
  ],
};

const compQuizCfg = {
  questions: [
    { q: 'The compiler stage that turns the characters "rate = 0.05" into a stream of tokens is…', choices: ['parsing', 'lexing', 'semantic analysis', 'code generation'], answer: 1, why: 'Lexing (tokenising) groups characters into words — identifier, operator, number. Parsing then assembles those tokens into a tree.' },
    { q: 'The CPU is running a word processor when a key is pressed. The first thing that happens is…', choices: ['the keyboard driver prints the letter', 'the CPU saves its current state so the interrupt service routine can run and later be undone', 'the operating system shuts the program down', 'the program is moved to disk'], answer: 1, why: 'Interrupt handling is undoable: the CPU pushes its registers and program counter onto the stack, runs the ISR, then restores the state and resumes exactly where it left off.' },
    { q: 'Which translator reads the WHOLE program, reports all the errors it finds, and emits object code?', choices: ['interpreter', 'assembler', 'compiler', 'debugger'], answer: 2, why: 'A compiler translates the entire program before it runs and can list every error it met. An interpreter stops at the first error; an assembler is the one-to-one translator for assembly language.' },
    { q: 'A high-level language is usually preferred over assembly because it is…', choices: ['faster on the specific machine it was written for', 'easier to read, debug and port to other machines', 'the only kind the CPU understands', 'free of all errors'], answer: 1, why: 'High-level code is portable and far easier for humans. Assembly only wins when you need precise hardware control — and modern optimising compilers often beat hand-written assembly anyway.' },
  ],
};
