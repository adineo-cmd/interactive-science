const cryptoCfg = {
  steps: [
    { math: '1 · Symmetric: one shared key', note: 'AES encrypts and decrypts with the same secret key — fast, strong, and useless until both parties somehow share that key securely.' },
    { math: '2 · The key exchange miracle', note: 'Diffie–Hellman (1976): two strangers, talking publicly, derive a shared secret nobody else can compute — via modular exponentiation\'s one-way street. Key exchange without prior contact: the idea that created e-commerce.' },
    { math: '3 · Asymmetric: public locks, private keys', note: 'RSA: publish a lock anyone can close (encrypt with your public key); only your private key opens it. Signatures work the same way reversed.' },
    { math: '4 · Hashes — one-way fingerprints', note: 'SHA-256 scrambles any input to a fixed fingerprint. Change one letter, half the bits flip. Used for password verification, file integrity, and blockchain linking.' },
    { math: '5 · Trust chains', note: 'Certificates bind keys to identities, signed by authorities your browser pre-trusts. The padlock is not "encryption" — it is a chain of signatures ending in one you agreed to trust.' },
  ],
