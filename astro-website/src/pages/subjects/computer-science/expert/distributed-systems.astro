const distCfg = {
  steps: [
    { math: '1 · Why distribute at all', note: 'One machine has hard limits — CPU, RAM, disk, and physics. Ten machines scale linearly in capacity… and introduce every problem on the rest of this page.' },
    { math: '2 · Partitions — splitting the data', note: 'Shard users A–M to server 1, N–Z to server 2. Capacity scales; every query that crosses shards gets harder.' },
    { math: '3 · Replication — copying for survival', note: 'Keep copies on several machines. Survives crashes, serves reads faster — but now copies can disagree. This is the core tension.' },
    { math: '4 · CAP: pick two of three', note: 'Consistency (everyone sees the same data), Availability (always answer), Partition tolerance (survive network splits). During a network partition you MUST choose between consistency and availability. There is no fourth option.' },
    { math: '5 · Consensus — agreeing anyway', note: 'Paxos and Raft let machines agree on one value despite crashes and lost messages — the algorithm behind every serious distributed database. elegantly simple; Raft\'s paper is genuinely readable.' },
  ],
