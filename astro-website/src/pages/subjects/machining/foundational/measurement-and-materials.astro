const machAimPredict = {
  "q": "Tool wear moves dimensions across a production run. Where does a professional aim the first cut?",
  "choices": [
    "dead on the exact nominal number",
    "external dimensions slightly over nominal, holes slightly under — leaving room for wear and finishing",
    "at the limit that passes most parts",
    "wherever the first part happens to land"
  ],
  "answer": 1,
  "why": "Targeting the middle of the band is engineering; targeting the nominal is hope — aim so tool wear and finishing have room to work without crossing a limit."
};

const machSpeedEstimate = {
