  readouts: [
    { label: 'acceptable range', expr: 'nominal - tol', unit: 'to', },
    { label: 'upper limit', expr: 'nominal + tol', unit: 'mm' },
    { label: 'in tolerance?', expr: 'measured >= nominal - tol && measured <= nominal + tol', unit: '' },
  ],
};

const measureCfg = {
  steps: [
