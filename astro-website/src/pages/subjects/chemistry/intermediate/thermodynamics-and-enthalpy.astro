import Widget from '../../../../components/Widget.astro';

const enthalpyCfg = {
  curves: [
    { expr: '0 + 3*exp(-0.8*x)*sin(3*x)^0.5', label: 'energy profile (schematic hill)', color: '#475569', width: 1 },
    { expr: '3*exp(-0.8*x)', label: 'exothermic reaction path', color: '#d9480f', width: 2.2 },
    { expr: '1 - 2.2*exp(-0.8*x)*-1', label: 'endothermic reaction path', color: '#1d4ed8', width: 2.2 },
  ],
