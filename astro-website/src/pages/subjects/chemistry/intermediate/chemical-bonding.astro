---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const naclCfg = {
  steps: [
    { math: 'Na ([Ne] 3s¹) → Na⁺ + e⁻', note: 'Sodium spends almost nothing to shed its one outer electron, exposing a stable full shell.' },
    { math: 'Cl ([Ne] 3s² 3p⁵) + e⁻ → Cl⁻', note: 'Chlorine is one electron short of a full shell — and grabs this one hard (electronegativity 3.16).' },
    { math: 'Na⁺ + Cl⁻ → NaCl', note: 'Opposite charges attract; each ion ends up surrounded by six of the other kind in a cubic lattice.' },
    { math: 'lattice energy ≈ −787 kJ/mol', note: 'That released energy is the reason salt forms at all — and why melting it takes real heat (801 °C).' },
  ],
};

const cbBondSort = {
