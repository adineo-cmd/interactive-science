      "label": "electrons transferred outright; rigid crystals of charged ions",
      "bucket": 0
    },
    {
      "label": "a shared pair counts toward both outer shells",
      "bucket": 1
    },
    {
      "label": "outer electrons pooled into a common sea",
      "bucket": 2
    },
    {
