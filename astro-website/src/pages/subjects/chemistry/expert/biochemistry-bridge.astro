---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const biochemCfg = {
  steps: [
    { math: 'C₆H₁₂O₆ + 6O₂ → 6CO₂ + 6H₂O + ~30 ATP', note: 'Respiration — the controlled combustion running every cell. The same fire as burning sugar, minus the flame, paid out in small installments.' },
    { math: 'Glucose → 2 pyruvate (glycolysis)', note: 'Stage 1, in the cytoplasm: an ancient, oxygen-free pathway shared by nearly all life — 2 ATP banked.' },
    { math: 'Pyruvate → CO₂ in the Krebs cycle', note: 'Stage 2, in mitochondria: carbons stripped off, electrons collected on NADH/FADH₂ carriers.' },
    { math: 'Electron transport → ~28 ATP', note: 'Stage 3: the carriers drop their electrons down a chain; the energy pumps protons; the proton flood through ATP synthase — a literal molecular turbine — mints the ATP.' },
  ],
};

const bioHandleMatch = {
  "prompt": "Six handles do nearly all the work — pair each with its job:",
  "pairs": [
    {
      "left": "hydroxyl (–OH)",
      "right": "makes sugars water-soluble"
    },
    {
      "left": "carbonyl (C=O)",
      "right": "the chemistry of metabolism's middle steps"
    },
    {
      "left": "carboxyl (–COOH)",
      "right": "fatty and amino acids' acid character"
    },
    {
      "left": "amino (–NH₂)",
      "right": "enables the peptide bond"
    },
    {
      "left": "phosphate (–OPO₃²⁻)",
      "right": "energy's handle — ATP, DNA's backbone, the signalling switch"
    },
    {
      "left": "thiol (–SH)",
      "right": "cysteines weld proteins with disulfide bridges"
    }
  ],
  "why": "Each handle has its characteristic reactions, and biochemistry is those reactions selected, catalysed and sequenced — with the phosphate family as the Goldilocks currency at about 30 kJ/mol."
};

const bioFamilyBuckets = {
  "prompt": "Four families, one logic. File each fact:",
  "buckets": [
    "carbohydrates",
    "amino acids",
    "fatty acids"
  ],
  "items": [
    {
      "label": "glucose C₆H₁₂O₆, named by its aldehyde position",
      "bucket": 0
    },
    {
      "label": "D-sugars almost exclusively — handedness as a fossil choice",
      "bucket": 0
    },
    {
      "label": "twenty kinds, written Gly, Ala, Leu… so sequences become text",
      "bucket": 1
    },
    {
      "label": "an amino group, a carboxyl group and a side chain on one carbon",
      "bucket": 1
    },
    {
      "label": "palmitic acid C16:0 — the numbers are the recipe",
      "bucket": 2
    },
    {
      "label": "oleic acid C18:1 — chain length and unsaturation",
      "bucket": 2
    }
  ],
  "why": "'The protein is 153 amino acids starting Met-Gly…' is a molecular structure precise enough to synthesise — vocabulary as compression."
};

const bioGlucoseEstimate = {
  "prompt": "Burning glucose outright releases about how many kilojoules per mole as heat?",
  "unit": "kJ per mol",
  "answer": 2800,
  "factor": 1.3,
  "why": "About 2,800 kJ/mol — respiration releases the same total in installments the cell can bank, at roughly a third capture efficiency; the remainder is the heat that keeps you warm.",
  "context": "The four stages: glycolysis in the cytoplasm, the Krebs cycle and electron transport in the mitochondria."
};

const bioFuelCompare = {
  "prompt": "Fat vs sugar as fuel — drag the divider:",
  "before": {
    "label": "fat (palmitate)",
    "text": "Nine kilocalories per gram; complete oxidation yields about 106 ATP — reduced hydrocarbon chains carry more electrons per carbon. The stock for storage; membranes are its inert fabric."
  },
  "after": {
    "label": "sugar (glucose)",
    "text": "Four kilocalories per gram; roughly 30 ATP per glucose. Glycogen is only for sprint — but it mobilises fast and works without oxygen."
  },
  "why": "Muscle, brain and fuel-choice are combustion economics: gram for gram, fat stores about two and a half times more."
};

const bioSugarJudge = {
  "statements": [
    {
      "s": "Starch is α-linked glucose — digestible and spiral.",
      "truth": true,
      "why": "The glycosidic bond's stereochemistry is the toggle."
    },
    {
      "s": "Cellulose is β-linked glucose — indigestible to us, straight, and the world's most abundant organic compound.",
      "truth": true,
      "why": "Wood: cows digest it with bacterial help; termites outsource to gut symbionts."
    },
    {
      "s": "Cellulose is easily digested by humans because it is just glucose, like starch.",
      "truth": false,
      "why": "Same monomer, opposite link — the β-bond is the whole difference."
    },
    {
      "s": "Fermentation regenerates NAD⁺ so glycolysis can keep running without oxygen.",
      "truth": true,
      "why": "Yeasts end at ethanol; your muscles end one step earlier at lactate — the burn of sprint metabolising."
    }
  ]
};

const bioKrebsCloze = {
  "text": "The Krebs cycle is a rotating cast of tri- and dicarboxylic acids — %%0%% (three carboxyls), succinate, fumarate, malate, oxaloacetate. Your blood's pH is buffered within %%1%% of 7.4, outside which enzymes begin to denature.",
  "answers": [
    [
      "citrate"
    ],
    [
      "0.05"
    ]
  ],
  "hint": "The cycle's namesake is the three-carboxyl member; the buffer holds pH to a hundredth-scale tolerance."
};

const bioDnaEstimate = {
  "prompt": "Human DNA is a double helix of roughly how many base pairs, packed into each cell nucleus?",
  "unit": "base pairs",
  "answer": 3000000000,
  "factor": 1.3,
  "why": "About 3 billion — some 2 metres of it per nucleus, joined by phosphodiester links (a double condensation per bond), the four-letter alphabet as chemistry's highest-information polymer.",
  "context": "Insulin is 51 residues; haemoglobin 574 — sequence-encoded chains that fold into machines."
};

const bioEnzymeSpot = {
  "prompt": "One line of this enzyme summary is wrong. Find it.",
  "lines": [
    "Enzymes are proteins — catalysts, unchanged by the reactions they catalyse",
    "They are reused thousands of times a second until they denature",
    "They are alive, and they reproduce inside the cell",
    "What is special is their shape",
    "Denaturation is unfolding — boiled egg: chemistry intact, function gone"
  ],
  "errorLine": 2,
  "correction": "Enzymes are not alive, cannot reproduce, and obey ordinary chemistry.",
  "why": "Shape is the special thing — which is why heat or wrong pH kills an enzyme by unfolding it while leaving the amino acid sequence untouched, and why most drugs are simply enzyme grips, occupied."
};
---
<TopicPage slug="subjects/chemistry/expert/biochemistry-bridge">
  <h2>Where you are, and what you will learn</h2>
  <p>
    This lesson runs the organic chemistry you already own through living machinery, so it
    assumes the full organic sequence: "Organic chemistry: hydrocarbons" (intermediate) for the
    alkane and alkene behaviour this lesson finds inside fats, "Organic chemistry: functional
    groups" (advanced) — whose 11.x topics are exactly the ones replayed here — and "Reaction
    kinetics" (intermediate), because an enzyme is a catalyst and its mathematics is kinetics.
  </p>
  <p>By the end you will be able to:</p>
  <ul>
    <li>map each functional group to the biochemical job it does — hydroxyl, carbonyl, carboxyl, amino, phosphate, thiol;</li>
    <li>read biomolecule names as compressed structures across the four families (sugars, amino acids, fatty acids, nucleotides);</li>
    <li>run metabolism's arithmetic: combustion totals, the four-stage installment plan and the roughly one-third capture efficiency;</li>
    <li>explain why fat stores more energy than sugar and how one double bond changes a material;</li>
    <li>state what enzymes do quantitatively, and why ATP is a currency rather than a store.</li>
  </ul>

  <h2>The idea</h2>
  <p>
    Biochemistry is chemistry under life's constraints: water-based, room-temperature,
    and utterly precise. Life doesn't use exotic elements — it uses <strong>ordinary
    reactions orchestrated by enzymes</strong>, compartmentalised into pathways, and
    powered by one universal currency (ATP). The bridge from chemistry to biology is the
    realisation that a cell is a reaction network, and the network can be read — and the
    reading is done with the organic chemistry syllabus's own tools: functional groups
    identify the reactive sites of biology, the alkene-to-acid ladder maps onto fats,
    sugars and metabolism, and the polymer topic turns out to be the story of proteins
    and DNA. Every section below takes one organic chemistry topic and shows it running,
    at 37 °C, inside you.
  </p>

  <Widget no="1" caption="respiration — combustion converted into a four-stage installment plan" widget="equationStep" config={biochemCfg} />
  <p>
    <strong>What to notice:</strong> step through the four stages and watch the same fire as
    burning sugar being paid out in small, bankable installments. Step 1 shows the overall
    balance — identical reactants and products to combustion, minus the flame. Steps 2 and 3
    show where the installment plan's small steps happen (cytoplasm, then mitochondria, with
    energy collected on carriers rather than released as heat), and step 4 is the payout desk:
    the proton flood through ATP synthase, a literal molecular turbine. Compare the step 1
    total with burning glucose's ~2,800 kJ/mol and you have the whole efficiency question the
    fuels section works through.
  </p>

  <h2>Functional groups of life: the handles biochemistry grips</h2>
  <p>
    The same functional-group alphabet (11.1) organises all of biology, with a shortlist
    doing nearly all the work: hydroxyl (–OH) makes sugars water-soluble; carbonyl (C=O)
    makes aldehyde and ketone chemistry the chemistry of metabolism's middle steps;
    carboxyl (–COOH) gives fatty and amino acids their acid character; amino (–NH₂)
    enables the peptide bond; phosphate (–OPO₃²⁻) is energy's handle (ATP), DNA's
    backbone, and the switch of cell signalling; thiol (–SH) lets cysteines weld proteins
    together with disulfide bridges. Each handle has its characteristic reactions, and
    biochemistry is those reactions selected, catalysed and sequenced. The distinguishing
    trick of life is the <em>phosphate ester/anhydride</em> family: hydrolysis of ATP's
    terminal phosphate releases about 30 kJ/mol, small enough to be coupled to cellular
    work and large enough to matter — the Goldilocks currency, and the reason ATP is
    recycled kilogram by kilogram each day rather than stockpiled.
  </p>
  <Widget no="9" caption="pair each handle with the job biology grips it for" widget="match" config={bioHandleMatch} />

  <h2>Naming and classifying biomolecules: four families, one logic</h2>
  <p>
    Nomenclature (11.2) in biology compresses structure into family names. Carbohydrates:
    sugars with a carbonyl and two or more hydroxyls — glucose C₆H₁₂O₆, named by its
    aldehyde position; D- and L- prefixes record the stereocentre configuration (life
    uses D-sugars almost exclusively — handedness as a fossil choice). Amino acids: an
    amino group, a carboxyl group and a side chain on one carbon — twenty of them, named
    and abbreviated (Gly, Ala, Leu…) so sequences can be written as text. Fatty acids:
    carboxylic acids with long hydrocarbon tails, named by chain length and unsaturation
    (palmitic acid C16:0, oleic acid C18:1 — the numbers are the recipe). Nucleotides:
    sugar + base + phosphate, named A, T, G, C, U. What looks like vocabulary is
    actually compression: "the protein is 153 amino acids starting Met-Gly…" is a
    molecular structure precise enough to synthesise — and the naming systems interlock
    with the chemistry exactly as IUPAC does in industry.
  </p>
  <Widget no="8" caption="file each fact by biomolecule family" widget="sort-buckets" config={bioFamilyBuckets} />
  <p>
    <strong>So far:</strong> the handles and the names are in place — you can now read a
    biomolecule as a structure. The next four sections follow the hydrocarbon skeleton through
    metabolism: first as fuel, then as store, then as material whose every double bond matters.
  </p>

  <h2>Fuels in metabolism: combustion on the installment plan</h2>
  <p>
    The fuels topic (11.3) becomes metabolism's arithmetic. Burning glucose outright
    releases about 2,800 kJ per mole as heat; respiration releases the same total in
    installments the cell can bank — roughly 30–32 ATP per glucose, each worth about
    30 kJ/mol when hydrolysed, so the capture efficiency is around a third, with the
    remainder as heat (which is why you are warm). The widget's four stages are the
    installment plan: glycolysis (glucose to two pyruvates, cytoplasm, oxygen-free, the
    most ancient pathway in biology), the Krebs cycle (carbons stripped to CO₂ in the
    mitochondria, energy collected on NADH/FADH₂), and the electron transport chain
    (the carriers' electrons step down a potential ladder, pumping protons; the proton
    flood through ATP synthase — a literal molecular turbine — mints the ATP). Fats are
    the dense fuel: nine kilocalories per gram against sugar's four, because reduced
    hydrocarbon chains carry more electrons per carbon to donate down the chain.
    Muscle, brain and fuel-choice are combustion economics.
  </p>
  <Widget no="7" caption="call the combustion total" widget="estimate" config={bioGlucoseEstimate} />

  <h2>Alkanes in biology: the fat that fuels you</h2>
  <p>
    The alkane's inert, reduced hydrocarbon chain (11.4) is biology's energy store and
    structural material. Palmitic acid (C16:0) is sixteen carbons of essentially alkane
    ending in a carboxyl; three of them esterified to glycerol give a triglyceride —
    the fat of adipose tissue and seed oils. Energy density follows from reduction
    state: each −CH₂− carries electrons that the electron transport chain can take,
    so complete oxidation of one palmitate yields about 106 ATP against glucose's
    roughly 30 — and gram for gram, about two and a half times more — which is why
    organisms stock fat for storage
    and glycogen only for sprint. Inertness has structural value too: membrane lipids'
    hydrocarbon interiors are the water-excluding fabric of every cell (a two-molecule
    thick oil sheet, self-assembling because water hates the tails more than the tails
    hate each other), and waxes — long-chain alkanes and esters — waterproof leaves,
    feathers and beeswax comb. The school alkane's dullness is, in biology, a feature:
    it does nothing until an enzyme asks.
  </p>
  <Widget no="6" caption="drag the divider — the two fuel stores" widget="compare" config={bioFuelCompare} />

  <h2>Alkenes in biology: unsaturation, kinks and health</h2>
  <p>
    The C=C double bond (11.5) reappears in fatty acids as <strong>unsaturation</strong>,
    and it changes the material. Oleic acid's cis double bond (olive oil, C18:1) puts a
    permanent kink in the chain; kinked chains pack poorly, so unsaturated fats stay
    liquid at room temperature while saturated (stearic, C18:0, straight) pack and stay
    solid — the same dispersion-force packing logic as the alkane boiling-point trend,
    now on your kitchen shelf. Trans fats (industrial partial hydrogenation) are the
    cautionary tale: trans double bonds are nearly straight, so they pack like saturates
    (solid at room temperature — the original commercial point) but the body's enzymes
    and lipid membranes handle the geometry badly, raising cardiovascular risk — the one
    synthetic food component universally agreed harmful, banned in many countries since
    the 2010s. Unsaturation also invites oxidation: rancidity is radical attack on
    double bonds, which is why oils go off faster than butter and why vitamin E
    (a lipid-soluble radical scavenger) exists. Biology regulates its double bonds
    carefully — desaturase enzymes introduce them, hydrogenases elsewhere remove them.
  </p>
  <p>
    <strong>So far:</strong> the alkane chain turned out to be biology's battery and the C=C
    bond its packing problem. Now the hydroxyl — the most saturated handle in biochemistry —
    takes over: it builds sugars, joins them into materials, and closes the fuel loop with
    fermentation.
  </p>

  <h2>Alcohols in biology: sugars, bonds and fermentation</h2>
  <p>
    The hydroxyl handle (11.6) saturates biochemistry: glucose has five –OH groups plus
    one aldehyde, and that poly-alcohol character is why sugars are water-soluble and
    sweet (each –OH hydrogen-bonds). Two hydroxyls on adjacent carbons can join through
    an <strong>oxygen bridge</strong> — the glycosidic bond, an acetal — and the
    resulting polymer family runs biology's structure and storage: starch (α-linked
    glucose, digestible, spiral), cellulose (β-linked glucose, indigestible to us,
    straight, the world's most abundant organic compound — wood), glycogen (branched,
    liver storage). One stereochemical toggle, opposite materials: cows digest β-bonds
    with bacterial help; termites outsource to gut symbionts. Fermentation closes the
    loop: yeasts reduce pyruvate's carbonyl and regenerate NAD⁺, giving ethanol (the
    only industrial alcohol route for millennia — and still most of the world's), while
    in your muscles the oxygen-free shortcut ends one step earlier at lactate, the burn
    of sprint metabolising.
  </p>
  <Widget no="5" caption="true or false — one toggle, opposite materials" widget="judge" config={bioSugarJudge} />

  <h2>Carboxylic acids in biology: the Krebs cycle and the amino economy</h2>
  <p>
    The carboxyl group (11.7) is metabolism's bookkeeping mark. The Krebs cycle is a
    rotating cast of tricarboxylic and dicarboxylic acids — citrate (three carboxyls),
    succinate, fumarate, malate, oxaloacetate — each dehydrogenation and decarboxylation
    a standard functional-group reaction at standard biological temperature because an
    enzyme holds the substrate in its strained, reactive pose. Fatty acids are released
    and consumed as their CoA thioesters (a carboxyl chemistry variant); the amino
    acids carry –COOH and –NH₂ on the same carbon, and their condensation — peptide
    bond, water out — is exactly the amide chemistry of nylon, run by ribosomes at
    roughly 20 residues per second. Proteins are thus polycarboxylic/polyamide
    electrolytes whose side chains (acidic, basic, hydrophobic) set pH behaviour:
    haemoglobin's oxygen release is acid–base chemistry (the Bohr effect), and your
    blood's pH is buffered by the bicarbonate/carboxylate couple within 0.05 of 7.4 —
    outside which enzymes begin to denature.
  </p>
  <Widget no="4" caption="fill the blanks — the acid bookkeeping" widget="cloze" config={bioKrebsCloze} />
  <p>
    <em>Common misconception:</em> "the Krebs cycle uses oxygen, since respiration needs
    oxygen." No step of the Krebs cycle touches O₂; molecular oxygen's only job is the
    final one — accepting electrons at the end of the transport chain, keeping the
    carriers re-oxidised so the cycle can keep turning. Cut the oxygen supply and the
    cycle stalls through the coupling: NADH accumulates, NAD⁺ runs out, and the
    cycle stops for want of its coenzyme — which is why cyanide (blocking the final
    acceptor step) is lethal at the last link of the chain, not in the cycle.
  </p>
  <p>
    <strong>So far:</strong> fuels, stores and the acid bookkeeping of metabolism are all in
    place — one misconception about oxygen now corrected. The last section completes the
    bridge by treating the cell's information carriers as what they chemically are:
    condensation polymers.
  </p>

  <h2>Biological polymers: proteins and DNA as condensation products</h2>
  <p>
    The polymer topic (11.8) is where the bridge completes: life's polymers are
    condensation polymers with information. Proteins: up to twenty kinds of amino acid
    monomer in sequence-encoded chains — insulin is 51 residues (two chains, disulfide
    bridges), haemoglobin 574 — folding into machines because the sequence dictates the
    fold. DNA: nucleotide monomers joined by phosphodiester links (a double condensation
    per bond) into a double helix 3 billion base pairs long in humans; the four-letter
    alphabet is chemistry's highest-information polymer, ~2 metres of it packed into
    each cell nucleus. Both are the same three reactions the syllabus taught —
    condensation, ester/amide formation, hydrolysis in reverse — with the addition of
    template-directed synthesis. And the enzyme miracle is quantified: uncatalysed,
    many biological reactions would take centuries; enzymes cut them to milliseconds —
    speed-ups up to 10¹⁷× — by gripping substrates in precisely strained orientations.
    that grip is why life runs at 37 °C without a flame, and why most drugs are simply
    enzyme grips, occupied.
  </p>
  <Widget no="3" caption="call the magnitude — the information polymer" widget="estimate" config={bioDnaEstimate} />
  <p>
    <em>Common misconception:</em> "ATP is an energy store, like a full battery kept in
    the cell." ATP is a <em>currency</em>, not a store: the body holds only about 250 g
    of it at any instant, yet recycles that pool roughly a thousand times a day — of the
    order of its own body weight in ATP turned over daily. The true stores are fat and
    glycogen; ATP is the till, refilled continuously by respiration. This is why
    interrupting respiration (cyanide, suffocation) kills within minutes — the currency
    stops circulating even though the stores are full.
  </p>
  <p>
    <em>Common misconception:</em> "enzymes are destroyed by the reactions they catalyse,
    or are alive." Enzymes are proteins — catalysts, unchanged by the reaction, reused
    thousands of times a second until they denature. They are not alive, cannot reproduce
    and obey ordinary chemistry; what is special is their shape, and shape is why heat or
    wrong pH kills an enzyme (denaturation is unfolding) while leaving its amino acid
    sequence untouched — boiled egg: chemistry intact, function gone.
  </p>
  <Widget no="2" caption="one line of the enzyme summary is wrong" widget="spot-error" config={bioEnzymeSpot} />

  <h2>Check yourself</h2>
  <p>Try these before moving on. Feedback follows each answer.</p>
  <ol>
    <li>Why is ATP a currency rather than a store — and what are the body's true stores?</li>
    <li>Oleic acid (C18:1, cis) and stearic acid (C18:0) differ by one double bond. Predict and explain their states at room temperature, and why trans fats behave like stearic acid.</li>
    <li>Cyanide blocks the final step of the electron transport chain, yet the Krebs cycle stalls too. Explain the coupling.</li>
  </ol>
  <p>
    <strong>Feedback:</strong> (1) The body holds only about 250 g of ATP at any instant, yet
    recycles that pool roughly a thousand times a day — of the order of its own body weight in
    ATP turned over daily. A store holds energy between uses; a currency circulates and is
    refilled continuously by respiration. The true stores are fat and glycogen, which is why
    interrupting respiration kills within minutes even though the stores are full. (2) Oleic's
    cis double bond puts a permanent kink in the chain, and kinked chains pack poorly, so it
    stays liquid — olive oil. Stearic is straight, packs tightly, and is solid. Trans double
    bonds are nearly straight, so trans fats pack like saturates — solid at room temperature —
    while enzymes and membranes handle the geometry badly. (3) Oxygen's only job is accepting
    electrons at the chain's end, keeping the carriers re-oxidised. Block it and NADH
    accumulates, NAD+ runs out, and the cycle stops for want of its coenzyme — the cycle and
    the chain are coupled through the carriers, which is why cyanide is lethal at the last
    link, not in the cycle.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>A cell is a reaction network: ordinary reactions orchestrated by enzymes, compartmentalised into pathways.</li>
    <li>Functional groups are the handles biochemistry grips; the phosphate ester/anhydride family is energy's handle.</li>
    <li>Respiration is combustion on the installment plan: the same total as burning glucose, banked as roughly 30–32 ATP per molecule.</li>
    <li>Fats beat sugars for storage (about 106 ATP per palmitate; nine kilocalories per gram against four) because reduced chains carry more electrons.</li>
    <li>One cis double bond kinks a chain: liquid oils versus solid fats; trans fats pack like saturates but poison the geometry.</li>
    <li>Life's polymers are condensation polymers with information — the syllabus's own reactions plus template direction.</li>
    <li>Enzymes are catalysts, not alive: shape is the special thing, denaturation is unfolding.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    The sibling expert lesson "Polymer chemistry" expands the condensation and addition
    chemistry this lesson used on proteins and DNA into the industrial scale — nylons,
    polyesters and the plastics that dominate modern life. "Quantum chemistry", the third
    expert lesson, digs beneath the functional-group handles to the orbitals and bonding that
    make every grip and every reaction energy ledger add up.
  </p>

  <h2>Going deeper</h2>
  <p>
    <strong>Enzyme kinetics, quantified.</strong> Michaelis–Menten kinetics describes the
    enzyme's saturation curve: rate rises with substrate concentration toward a maximum
    V<sub>max</sub>, with K<sub>M</sub> (the substrate concentration giving half-maximum)
    as the enzyme's affinity readout — a number measured for thousands of enzymes and
    tabulated like bond energies. Inhibition is taxonomy: competitive inhibitors
    (statins) occupy the grip and are beaten by more substrate; non-competitive (cyanide
    at cytochrome c oxidase) jam the machinery elsewhere. Allosteric regulation —
    effectors binding far from the active site, switching the enzyme's conformation — is
    how cells integrate signals; haemoglobin's cooperative oxygen curve is the textbook
    case. The drug industry is, bluntly, an enzyme-kinetics industry: most drugs are
    inhibitors designed by the numbers this framework supplies.
  </p>
  <p>
    <strong>Metabolism as a network.</strong> The pathways are not a list but a graph —
    thousands of metabolites, enzymes and fluxes, mapped in databases (KEGG, Reactome)
    like circuit diagrams. Two design principles dominate: catabolism converges (fats,
    sugars and amino acids all drain into acetyl-CoA), and anabolism diverges from the
    same nodes — which is why intermediates like citrate and acetyl-CoA are regulatory
    hubs signalling "fed" or "fasting". Flux balance analysis (the systems-biology page's
    territory) predicts growth rates from the network's stoichiometry alone. Metabolic
    disease reads as network failure: diabetes is a signalling failure at the hub;
    phenylketonuria is one broken enzyme (phenylalanine hydroxylase) whose accumulating
    substrate poisons development — manageable by diet, discovered by urine that smelled
    of the blocked pathway.
  </p>
  <p>
    <strong>The frontier: chemistry of the unknownome.</strong> Genome sequencing tells
    us what proteins exist; biochemistry must still discover what they do, and the
    majority of enzymatic functions in any newly sequenced organism are inferred, not
    measured. Direction of travel: cryo-electron microscopy solved structures at near-atomic
    resolution (Nobel 2017) faster than X-ray crystallography ever managed; AlphaFold
    predicts folds from sequence (the bioinformatics page's centrepiece); directed
    evolution designs enzymes for reactions biology never ran (Nobel 2018, Frances
    Arnold) — synthetic chemistry at 37 °C, water as solvent. The bridge this page
    names is being widened from both banks: biology's questions answered with
    chemistry's tools, and chemistry's goals achieved with biology's catalysts.
  </p>
  <p class="sources"><strong>Sources:</strong> Lehninger, Principles of Biochemistry; Boyer, The Enzymes; Berg, Tymoczko & Stryer. Source text: OpenStax (https://openstax.org), CC BY 4.0 — adapted for Interactive Atlas.</p>
</TopicPage>
