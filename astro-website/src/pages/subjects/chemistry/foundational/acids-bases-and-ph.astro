      "label": "the fraction of molecules that actually donate a proton",
      "bucket": 0
    },
    {
      "label": "how much acid per litre",
      "bucket": 1
    },
    {
      "label": "HCl: essentially every molecule ionises in water",
      "bucket": 0
    },
    {
      "label": "a bottle of it can be very dilute",
      "bucket": 1
    },
    {
      "label": "acetic acid: only about 1 in 100 molecules donates at any moment",
      "bucket": 0
    }
