  "why": "A dilute strong acid can out-acid a concentrated weak one — and safety rules treat them differently."
};

const abNeutralSpot = {
  "prompt": "One line of this neutralisation summary is wrong. Find it.",
  "lines": [
    "Neutralisation: acid + base → salt + water",
    "Strong acid + strong base at 25 °C ends at pH 7",
    "Weak acid + strong base leaves a salt slightly alkaline — sodium ethanoate sits above 7",
    "Strong acid + weak base such as ammonia also lands slightly alkaline",
    "'Neutralised' means the acid and base have finished reacting — not that 7 was reached"
  ],
  "errorLine": 3,
  "correction": "Strong acid + weak base lands slightly acidic.",
  "why": "The endpoint's pH depends on which acid met which base — 'neutralised' means the reaction finished, not that the number 7 was reached."
};

const abOxideMatch = {
  "prompt": "What burning leaves behind — pair each oxide family with its character:",
  "pairs": [
    {
      "left": "metal oxides (Na₂O, CaO, MgO)",
      "right": "basic — react with acids; CaO + H₂O gives limewater"
    },
    {
      "left": "non-metal oxides (CO₂, SO₂, P₄O₁₀)",
      "right": "acidic — CO₂ + H₂O makes rain naturally slightly acidic"
    },
    {
      "left": "ZnO and Al₂O₃",
      "right": "amphoteric — react with both acids and bases, a handy fingerprint"
    },
    {
      "left": "CO and N₂O",
      "right": "neutral — react with neither"
    }
  ],
  "why": "The pattern is a trend: across one row of the periodic table, Na₂O → Al₂O₃ → SO₃ runs from basic to amphoteric to strongly acidic."
};

const abSaltBranch = {
  "root": "Acid + base → salt + water works for any pair — the design question is which starting materials and how to purify. Choose each route.",
  "nodes": {
    "start": {
      "text": "You want copper sulfate, a soluble salt. Which route?",
      "choices": [
        {
          "label": "Acid + insoluble base — copper oxide into warm sulfuric acid",
          "next": "soluble",
          "feedback": "Stir in black copper oxide until no more dissolves, filter off the excess, evaporate until crystals form. Done."
        },
        {
          "label": "Precipitation — mix two soluble solutions",
          "next": "wrong1",
          "feedback": "That route is for insoluble salts; copper sulfate dissolves, so nothing precipitates."
        }
      ]
    },
    "soluble": {
      "text": "Now you want barium sulfate, which will not dissolve. Which route?",
      "choices": [
        {
          "label": "Precipitation — barium chloride plus sodium sulfate",
          "next": "precip",
          "feedback": "A white precipitate forms as the ions swap partners — filter, wash, dry. Safe enough for a barium meal precisely because it will not dissolve."
        },
        {
          "label": "Acid + insoluble base",
          "next": "wrong2",
          "feedback": "The product would never come out of solution — insoluble salts need the swap trick."
        }
      ]
    },
    "precip": {
      "text": "Last: a sodium salt, from two colourless solutions with no visible endpoint. Which route?",
      "choices": [
        {
          "label": "Measured titration — trial run with phenolphthalein first",
          "next": "titrate",
          "feedback": "Find the neutralisation volume in the trial, then repeat without indicator to make the salt solution. Experimental design in one afternoon."
        },
        {
          "label": "Evaporate and hope",
          "next": "wrong3",
          "feedback": "With no endpoint you cannot know when to stop — the assay needs the burette."
        }
      ]
    },
    "titrate": {
      "text": "Route chosen by solubility: insoluble base for soluble salts, precipitation for insoluble ones, measured neutralisation for sodium and potassium salts."
    },
    "wrong1": {
      "text": "Back to the tree — solubility of the product decides."
    },
    "wrong2": {
      "text": "Back to the tree — an insoluble product needs two soluble parents."
    },
    "wrong3": {
      "text": "Back to the tree — invisible endpoints demand an indicator."
    }
