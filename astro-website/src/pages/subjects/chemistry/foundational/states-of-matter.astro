---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const phaseCfg = {
  curves: [
    { expr: '0.35*(x - 0.01)', label: 'solid–liquid boundary (melting)', color: '#1d4ed8' },
    { expr: '0.02 + 0.12*log(x/0.006)', label: 'liquid–gas boundary (boiling)', color: '#d9480f', width: 2.2 },
  ],
  x: { min: 0.006, max: 0.04, label: 'pressure (schematic)' },
  y: { min: 0, max: 1, label: 'temperature (schematic)' },
  crossings: true,
  height: 340,
};

const somClingSort = {
  "prompt": "Seven behaviours, three states — file each into the state that does it:",
  "buckets": [
    "solid",
    "liquid",
    "gas"
  ],
  "items": [
    {
      "label": "locked into an ordered lattice, only vibrating",
      "bucket": 0
    },
    {
      "label": "in contact but free to slide past each other",
      "bucket": 1
    },
    {
      "label": "flying freely through mostly empty space",
      "bucket": 2
    },
    {
      "label": "keeps its own shape without a container",
      "bucket": 0
    },
    {
      "label": "keeps a fixed volume but adopts the container's shape",
      "bucket": 1
    },
    {
      "label": "pushes on every wall with pressure",
      "bucket": 2
    },
    {
      "label": "can be squeezed into a smaller volume",
      "bucket": 2
    }
  ],
  "why": "Grip strength decides everything: locked in place, sliding in contact, or flying free — added heat walks a substance down the row."
};

const somPredMatch = {
  "prompt": "Pair each claim with the observation behind it:",
  "pairs": [
    {
      "left": "a gas is a thousand times less dense than its liquid",
      "right": "same particles, different spacing — water vapour is about 1/1,700 the density of liquid water"
    },
    {
      "left": "convection never works in solids",
      "right": "heat can only crawl by vibration there; mobile carriers are needed to carry it by travelling"
    },
    {
      "left": "air is light",
      "right": "N₂ and O₂ at 28 and 32 g/mol are chunkier than water's 18 — the molecules are few and far between, not small"
    },
    {
      "left": "a steel ball expands in a flame",
      "right": "the iron atoms stay the same size — what grows is the spacing between them"
    }
  ],
  "why": "Spacing, not particle size: one story covers density, conduction limits and expansion."
};

const somLatentEst = {
  "prompt": "One gram of water, already at 100 °C — roughly how much energy does turning it fully to vapour take?",
  "unit": "J per gram",
  "answer": 2260,
  "factor": 2,
  "why": "About 2,260 J/g, versus 334 J/g to melt ice — pulling particles fully apart breaks far more attractions than merely loosening their grip.",
  "context": "A steam burn is worse than a boiling-water burn because condensing hands this energy to skin; each gram of evaporating sweat carries it away at the same rate."
};

const somEverestPlace = {
  "prompt": "At the top of the world's highest mountain, air pressure is roughly a third of sea level. Slide the marker to water's boiling point there.",
  "labels": [
    "60 °C",
    "75 °C",
    "90 °C",
    "105 °C",
    "120 °C",
    "135 °C"
  ],
  "scale": {
    "min": 60,
    "max": 135
  },
  "answer": 71,
  "tolerance": 5,
  "why": "The answer is about 71 °C — the vapour has to match only a third of the outside push. Double the push in a pressure cooker and the boil climbs to about 121 °C: hotter water, not harder water."
};

const somSubSpot = {
  "prompt": "A summary of the phase map contains one faulty line — click it:",
  "lines": [
    "Every point of a phase diagram is one pressure–temperature pair; the region it lands in is the state taken there.",
    "The two boundary lines meet at the triple point — for water, 0.01 °C and 611 Pa — where all three phases coexist stably.",
    "That fixed reference is where the kelvin scale is defined from.",
    "Below the triple-point pressure there is no liquid, so ice must melt first and then evaporate — two steps, never one.",
    "Dry ice smokes and vanishes at atmospheric pressure because its triple point lies far above what air can supply."
  ],
  "errorLine": 3,
  "correction": "Below the triple point there is no liquid lane at all: ice goes straight to vapour — sublimation, the route Martian frost and shrinking freezer cubes take.",
  "why": "No liquid lane survives below the crossing, so the solid-to-vapour route needs no intermediate step."
};

const somCurveJudge = {
  "statements": [
    {
      "s": "While ice melts at 0 °C, the energy poured in is ungluing the lattice, not raising the temperature.",
      "truth": true,
      "why": "Latent heat: 334 J/g spent ungluing, so the thermometer stays pinned until the last cube is gone."
    },
    {
      "s": "The boil is the shortest flat step on the curve because vapour warms fastest.",
      "truth": false,
      "why": "It is the longest step — 2,260 J/g, since separating particles completely breaks far more attractions than melting does."
    },
    {
      "s": "A pure substance freezes at a single sharp temperature; a mixture slides through a range.",
      "truth": true,
      "why": "That is why a melting point is a standard identity and purity check in every chemistry lab."
    },
    {
      "s": "Water's specific heat of 4.2 J/g per °C is unusually low, so liquid water warms very quickly.",
      "truth": false,
      "why": "It is unusually HIGH — another signature property of water, which is why the liquid rise on the curve is a gentle slope."
    }
  ]
};

const somGasCloze = {
  "text": "Squeeze a gas into a smaller box and its %%0%% climbs — the same number of collisions now landing on less %%1%%. Warm it at fixed volume and the particles hit %%2%% and more often.",
  "answers": [
    [
      "pressure"
    ],
    [
      "wall"
    ],
    [
      "harder"
    ]
  ],
  "hint": "Pressure is nothing but collisions with the wall — fewer walls of space means more hits per second."
};

const somDiffTrace = {
  "prompt": "Diffusion rate plotted against particle mass at fixed temperature — which curve is right?",
  "curves": [
    {
      "expr": "6/sqrt(x)",
      "label": "curve A — falls toward big masses",
      "color": "#d9480f"
    },
    {
      "expr": "0.5*x",
      "label": "curve B — climbs with mass",
      "color": "#1f6f54"
    },
    {
      "expr": "3",
      "label": "curve C — independent of mass",
      "color": "#4455aa"
    }
  ],
  "correct": 0,
  "x": {
    "min": 1,
    "max": 36
  },
  "y": {
    "min": 0,
    "max": 7
  },
  "xlabel": "molar mass (g/mol)",
  "ylabel": "diffusion rate",
  "why": "Lighter particles move faster at the same temperature — ammonia (17 g/mol) outruns hydrogen chloride (36.5 g/mol), so the white ammonium-chloride ring sits about 1.45× nearer the slow one."
};
---
<TopicPage slug="subjects/chemistry/foundational/states-of-matter">

  <h2>Where you are, and what you will learn</h2>
  <p>
    This is a beginner lesson in Chemistry, on the foundational track. It assumes no
    prior chemistry — we start with a glass of iced water, something you have looked
    at a hundred times. Every new word is explained the moment it appears.
  </p>
  <p>By the end of this lesson you will be able to:</p>
  <ul>
    <li>describe solids, liquids and gases by what their particles are doing;</li>
    <li>explain melting, boiling and evaporation, and the energy each one needs;</li>
    <li>say why boiling point depends on pressure, from Everest to a pressure cooker;</li>
    <li>read a phase diagram — its lines, and the special point where all three states meet;</li>
    <li>explain diffusion, and what makes it faster or slower.</li>
  </ul>

  <h2>Start with a glass of iced water</h2>
  <p>
    Look at a glass of iced water on a warm day. You are seeing all three states of
    matter at once: a solid cube, a liquid, and bubbles of gas forming on its
    surface. One substance, three different arrangements. The whole lesson asks a
    single question about that glass: what decides which arrangement wins?
  </p>
  <p>
    The answer is the <strong>particle model</strong>, and it rests on one idea:
    matter is made of particles in constant motion. The state is then decided by a
    tug-of-war between two things. One is how much <strong>kinetic energy</strong>
    the particles have — energy of motion, which rises with temperature. The other
    is how strongly the particles attract each other, which depends on the
    substance and the pressure.
  </p>
  <p>
    Solid, liquid, gas — three answers to one question: how tightly do the
    particles cling to each other? Strong attraction with fixed positions gives a
    solid. Strong attraction with mobile positions gives a liquid. Barely any
    attraction gives a gas. Adding energy weakens the grip, which is how matter
    moves between states.
  </p>
  <Widget no="9" caption="file each behaviour by the state it belongs to" widget="sort-buckets" config={somClingSort} />

  <h2>The three arrangements</h2>
  <p>
    <strong>Solids</strong> hold their shape because their particles are locked
    into fixed positions — an ordered lattice — and only <em>vibrate</em> about
    those positions. Heat a solid and the vibrations grow stronger until, at the
    melting point, they break the fixed positions: the particles keep touching but
    can now slide. That is <strong>melting</strong>.
  </p>
  <p>
    <strong>Liquids</strong> therefore keep a fixed volume — the particles are
    still in contact — but take the shape of their container, because the
    arrangement is disordered and mobile. Heat further and, at the boiling point,
    particles break contact entirely: that is <strong>boiling</strong>. Quietly,
    at any temperature, particles can also escape from the surface — that is
    <strong>evaporation</strong>.
  </p>
  <p>
    <strong>Gases</strong> have particles flying freely — at room temperature,
    nitrogen molecules travel at about 500 m/s — with almost no mutual grip. That
    is why a gas expands to fill any container, why it can be squeezed smaller
    (mostly empty space separates the particles), and why it pushes on every wall
    with pressure: billions of microscopic collisions every second.
  </p>
  <p>
    The model makes testable predictions. Gases are a thousand times less dense
    than their liquids — water vapour at 100 °C is about 1/1,700 the density of
    liquid water — because the particles are the same but the spacing is not. And
    <strong>convection</strong>, where mobile particles carry heat by travelling,
    works in liquids and gases but never in solids, where heat can only crawl by
    vibration (<strong>conduction</strong>).
  </p>
  <Widget no="8" caption="pair each claim with the observation that backs it" widget="match" config={somPredMatch} />
  <p>
    <em>Common misconception:</em> "air is light because its molecules are small." The
    molecules of air are, particle for particle, chunkier than water molecules (N₂ and
    O₂ at 28 and 32 g/mol against water's 18); air is light because the particles are
    few and far between — a gas is overwhelmingly empty space. Weigh a sealed flask,
    pump the air out, weigh again: the missing mass belongs to the same-sized particles
    that were there, not to smaller ones.
  </p>
  <p>
    <em>Common misconception:</em> "the particles themselves expand when things get hot."
    They do not — a steel ball heated in a flame still contains the same-sized iron atoms.
    What expands is the <em>spacing</em>: hotter particles vibrate harder and push their
    neighbours apart. Railway gaps, bridge expansion joints and the wobbly fit of a tight jar
    lid after hot water all live on this fact.
  </p>
  <p>
    <strong>So far:</strong> one model explains all three states — particles with
    kinetic energy, held (or not held) by attraction. Solids vibrate in place,
    liquids slide in contact, gases fly free.
  </p>

  <h2>Energy goes in — but the thermometer stops</h2>
  <p>
    Here is the observation that defeats most beginners. Melt ice, and it stays
    pinned at 0 °C until the last cube is gone — even though the burner pours in
    heat the whole time. Where does the energy go?
  </p>
  <p>
    It becomes <strong>latent heat</strong> — literally "hidden heat". The energy
    is not speeding the particles up; it is pulling their attractions apart.
    Reorganising the solid lattice into a liquid costs 334 J per gram of ice.
    Boiling costs far more — about 2,260 J/g — because separating particles
    completely breaks far more attractions than merely loosening their positions.
  </p>
  <Widget no="7" caption="call the energy bill for turning water to vapour" widget="estimate" config={somLatentEst} />
  <p>
    The bookkeeping runs both ways. When steam condenses on a window, or vapour
    freezes as frost, the same energy is released. That is why a steam burn is so
    much worse than a boiling-water burn, and why sweating works so well: each
    gram of sweat evaporating carries about 2,260 J away from your skin.
  </p>

  <h2>Boiling is a pressure phenomenon</h2>
  <p>
    A liquid boils when the pressure of the vapour it can generate matches the
    pressure pressing down on it from outside. So the boiling point depends on the
    surrounding pressure: 100 °C at sea level, about 71 °C on Everest's summit
    (where the pressure is roughly a third of sea level — mountaineers cannot make
    decent tea), and about 121 °C in a pressure cooker at roughly double
    atmospheric pressure. That is exactly why pressure cookers cook faster: hotter
    water, not harder water.
  </p>
  <Widget no="6" caption="slide to the boiling point where the air is thin" widget="place" config={somEverestPlace} />
  <p>
    <em>Common misconception:</em> "steam is the white cloud you see over a kettle." The
    white cloud is not vapour — it is vapour that has already condensed into tiny
    droplets on meeting cooler air, a miniature cloud. Water vapour itself is invisible:
    look closely at a kettle spout and there is a clear gap between the metal and where
    the white begins — that gap is where the true gas is still transparent. The same
    logic makes breath invisible on a warm day and a white plume in winter.
  </p>

  <h2>A map of the states</h2>
  <Widget no="1" caption="a schematic phase map — the two boundaries meet at the triple point where all three states coexist" widget="plotter" config={phaseCfg} />
  <p>
    <strong>What to notice:</strong> hover across the map and read it as a weather forecast
    for states — each point is one pressure–temperature pair, and the region it lands in is
    the state water takes there. Trace the two boundary lines to where they meet: that
    crossing is the triple point, the only conditions under which ice, liquid water and
    vapour share a flask in stable coexistence. Notice what the map implies below that
    crossing — no liquid lane survives there, so any route from solid to gas must skip
    liquid altogether: sublimation.
  </p>
  <p>
    The widget shows the general shape of a <strong>phase diagram</strong>: a map
    whose every point is one pressure–temperature combination. The blue line marks
    where solid and liquid trade places; the orange line is where liquid and gas
    do. Where they cross is the <strong>triple point</strong> — for water, at
    0.01 °C and 611 Pa (about 0.6% of atmospheric pressure) — where all three
    phases share a flask in stable coexistence. It is the fixed reference from
    which the kelvin temperature scale is defined.
  </p>
  <p>
    Below that pressure, liquid water cannot exist at all: ice turns straight to
    vapour. That route is called <strong>sublimation</strong>, and it explains why
    Martian water skips the liquid phase (the atmosphere is thinner than the
    triple-point pressure) and why your frost-free freezer slowly shrinks ice
    cubes left in it.
  </p>
  <Widget no="5" caption="find the faulty line — the route below the triple point" widget="spot-error" config={somSubSpot} />
  <p>
    Sublimation is everyday as well as exotic. Dry ice (solid CO₂) skips the
    liquid at atmospheric pressure entirely — its triple-point pressure (518 kPa,
    about five atmospheres) is far above what the air can supply, which is why it
    smokes and vanishes instead of melting; the theatrical fog is water vapour
    condensing in the chilled air around it. Mothballs shrink by the same route,
    iodine crystals purple the air above them when warmed, and freeze-drying is
    sublimation industrialised: frozen coffee or vaccines are dried without ever
    thawing, because the ice leaves as vapour and the delicate structure never
    sags.
  </p>
  <p>
    <strong>So far:</strong> melting and boiling take energy without raising the
    temperature, boiling point moves with pressure, and the phase diagram maps
    which state wins at any pressure and temperature — with sublimation living
    below the triple point.
  </p>

  <h2>Heating curves: the bookkeeping drawn as a graph</h2>
  <p>
    The latent-heat story has a picture. Heat crushed ice steadily and plot
    temperature against time; the graph is a staircase. A rising line while ice
    warms; a <em>flat</em> line at 0 °C for the whole melt (the 334 J/g being
    spent ungluing the lattice); a steeper rising line while liquid water warms —
    water's specific heat of 4.2 J/g per °C is unusually high, another of its
    signature properties; a long flat line at 100 °C for the boil (2,260 J/g, the
    longest step); then rising vapour.
  </p>
  <Widget no="4" caption="true or false — reading the heating curve" widget="judge" config={somCurveJudge} />
  <p>
    The same curve read backwards is the cooling curve chemists use to test
    purity: a pure substance freezes at a single sharp temperature — one flat
    step — while mixtures slide through a range. That is why a melting point is a
    standard identity check in every chemistry lab.
  </p>
  <p>
    Gas behaviour closes the loop. Compress a gas and its pressure rises, because
    the same number of collisions now land on less wall. Heat it at fixed volume
    and its pressure rises, because the particles hit harder and more often. The
    warming bike pump and the sealed can bursting on a stove are the same story
    told twice — and the gas laws in the Going deeper section make it exact.
  </p>
  <Widget no="3" caption="fill the blanks — one story told twice" widget="cloze" config={somGasCloze} />

  <h2>Diffusion: the spreading you can smell</h2>
  <p>
    <strong>Diffusion</strong> is the spreading of particles from where they are
    concentrated to where they are not — and the particle model explains it with
    no exotic machinery at all. Gas and liquid particles move <em>randomly</em>.
    If more of them start on one side, random motion alone guarantees a net drift
    away from the crowded side — more particles leaving than arriving — until the
    spread is even.
  </p>
  <p>
    Open a perfume bottle at the front of a quiet room and, a minute later, the
    back row can smell it — no fan, no current, just billions of collisions
    redirecting molecules on a random walk. Drop a tea bag in hot water and watch
    the colour bleed outward on its own; drop potassium permanganate crystals into
    still water and the purple front advances for hours.
  </p>
  <p>
    Diffusion is also the transport system of life. Oxygen diffuses from your
    lungs' alveoli into the blood — a distance of about one micrometre —
    nutrients from your gut, and carbon dioxide back out. Every exchange surface
    in biology is thin precisely because diffusion only works well over short
    distances: it slows with the square of the distance, so ten times further
    takes a hundred times longer.
  </p>
  <p>
    The <strong>rate</strong> follows two clean rules. <strong>Mass:</strong>
    lighter particles move faster at the same temperature. The classic
    demonstration is the white ring of ammonium chloride that forms inside a tube
    when ammonia (17 g/mol) meets hydrogen chloride (36.5 g/mol) from opposite
    ends: the ring forms about 1.45× closer to the heavier gas, roughly the
    inverse square root of the mass ratio. <strong>Temperature:</strong> hotter
    particles move faster and collide more often, so diffusion speeds up — which
    is why sugar dissolves and spreads so much faster in hot tea, and why a fridge
    slows bacterial spread as well as bacterial growth.
  </p>
  <Widget no="2" caption="which curve tracks diffusion rate against mass?" widget="trace" config={somDiffTrace} />
  <p>
    <strong>So far:</strong> particles random-walk from crowded to uncrowded —
    through rooms, tea cups, lungs — and the walk speeds up when particles are
    lighter or hotter.
  </p>

  <h2>Check yourself</h2>
  <p>Try these before moving on. The answers are right below.</p>
  <ol>
    <li>Why can you squeeze a gas into a smaller volume, but not a solid?</li>
    <li>Steam and boiling water are both at 100 °C. Why is a steam burn worse?</li>
    <li>Why does the smell of dinner reach the next room faster from a hot kitchen than a cold one?</li>
  </ol>
  <p>
    <strong>Answers:</strong> (1) A gas is mostly empty space, so its particles
    can be pushed closer together; a solid's particles are already touching in
    fixed positions. (2) The steam condenses on skin and releases its latent
    heat — about 2,260 J per gram — on top of the burn the hot water itself
    would give. (3) Hotter particles move faster and collide more often, so
    diffusion — the random walk of food-smelling particles through the air —
    speeds up.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>One model explains all three states: particles with kinetic energy, held — or not held — by attraction.</li>
    <li>Solids vibrate in fixed positions; liquids slide in contact; gases fly free through mostly empty space.</li>
    <li>Melting and boiling spend energy pulling attractions apart, so the thermometer holds still — latent heat: 334 J/g for melting ice, about 2,260 J/g for boiling.</li>
    <li>Boiling point moves with pressure: about 71 °C on Everest, 100 °C at sea level, about 121 °C in a pressure cooker.</li>
    <li>A phase diagram maps which state wins at any pressure and temperature; the triple point is where all three coexist.</li>
    <li>Below the triple point, solids sublimate straight to vapour — dry ice, Martian ice, slowly shrinking freezer cubes.</li>
    <li>Diffusion is the random walk of particles from crowded to uncrowded, faster for lighter and hotter particles.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    The particle model is the launchpad for the rest of this Chemistry track: atomic
    structure goes inside the particles to see what they are made of, and the mole and
    stoichiometry lesson lets you count them — the same n that the ideal gas law, previewed
    in Going deeper, runs on. States of matter may be the first topic you met; particles are
    the thread through all the rest.
  </p>

  <h2>Going deeper</h2>
  <p>
    The quantitative skeleton under all of this is the <strong>kinetic theory of gases</strong>:
    pressure is nothing but molecular collisions, and working through the mechanics yields the
    ideal gas law, pV = nRT — the same n (moles) that chemists count with everywhere. The
    theory also explains <strong>Brownian motion</strong>: pollen grains jittering in
    water because they are being bombarded unevenly by invisible molecules — the 1905
    analysis (by Einstein) of exactly this jitter was among the first quantitative proofs
    that atoms exist, settling a debate then still live. Temperature itself gets a precise
    meaning here: it is proportional to the average kinetic energy of the particles, which is
    why there is a floor — absolute zero (0 K, −273.15 °C) — where that energy bottoms out
    and no cooler temperature is defined.
  </p>
  <p>
    The expert edges of the phase map: water's solid–liquid boundary leans
    <strong>backwards</strong> (left-leaning) — squeeze ice and it melts, because liquid
    water is the denser phase; ice floats. Almost every other substance leans the other way,
    and nearly everything about lakes freezing from the top, frost heave, and glaciers
    grinding rock follows from that one reversed line. At the top end of the orange boundary
    sits the <strong>critical point</strong> (for water, 374 °C and 22 MPa): beyond it the
    liquid and gas phases become indistinguishable and merge into a <strong>supercritical
    fluid</strong> — dense like a liquid, flowing like a gas — which is what decaffeinates
    coffee beans industrially. And a fourth state waits above them all: <strong>plasma</strong>,
    matter so hot that electrons are torn from their atoms — the state of stars, lightning,
    neon signs and fusion reactors, and by a wide margin the most common state of ordinary
    matter in the universe, though the rarest in daily life.
  </p>
  <p class="sources"><strong>Sources:</strong> OpenStax, Chemistry 2e (Liquids and Solids); Atkins, Physical Chemistry; Einstein, "Über die von der molekularkinetischen Theorie…" (1905). Source text: OpenStax (https://openstax.org), CC BY 4.0 — adapted for Interactive Atlas.</p>
</TopicPage>
