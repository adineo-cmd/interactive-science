---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const moleCfg = {
  params: [
    { name: 'm', label: 'mass of water (g)', min: 1, max: 100, step: 1, value: 18 },
  ],
  readouts: [
    { label: 'moles (m ÷ 18.02)', expr: 'm/18.02', unit: 'mol' },
    { label: 'molecules (moles × 6.022e23)', expr: 'm/18.02*6.022e23' },
    { label: 'hydrogen atoms (×2 per molecule)', expr: 'm/18.02*2*6.022e23' },
    { label: 'grams of hydrogen in sample', expr: 'm/18.02*2*1.008', unit: 'g' },
  ],
};

const moleSugarEstimate = {
  "prompt": "A water molecule weighs 18 atomic mass units. Roughly how many does a sugar molecule weigh?",
  "unit": "atomic mass units",
  "answer": 342,
  "factor": 1.2,
  "why": "About 342 — nineteen times heavier, so equal grams of water and sugar never contain equal numbers of molecules.",
  "context": "Equal grams hide unequal counts — which is exactly why chemists count in moles instead."
};

const moleFormulaMatch = {
  "prompt": "Formula flavours — pair each with what it actually names:",
  "pairs": [
    {
      "left": "molecular formula (glucose, C₆H₁₂O₆)",
      "right": "the whole molecule — 6 C, 12 H, 6 O"
    },
    {
      "left": "empirical formula (CH₂O)",
      "right": "only the simplest whole-number ratio"
    },
    {
      "left": "NaCl",
      "right": "the 1:1 ratio of ions in the crystal — no molecules at all"
    }
  ],
  "why": "The little numbers are subscripts, and moving one changes the substance: H₂O₂ is hydrogen peroxide, not 'double water'."
};

const moleFormulaBuckets = {
  "prompt": "Three formulas run all of stoichiometry. File each calculation:",
  "buckets": [
    "moles = mass ÷ molar mass",
    "moles = volume ÷ 24 dm³ (gas)",
    "moles = concentration × volume (solution)"
  ],
  "items": [
    {
      "label": "36.04 g of water is 2 mol",
      "bucket": 0
    },
    {
      "label": "5.85 g of NaCl is 0.1 mol",
      "bucket": 0
    },
    {
      "label": "one mole of any gas fills about 24,000 cm³ at 20 °C, 1 atm",
      "bucket": 1
    },
    {
      "label": "12 dm³ of any gas is about 0.5 mol",
      "bucket": 1
    },
    {
      "label": "250 cm³ of 0.5 mol/dm³ contains 0.125 mol",
      "bucket": 2
    },
    {
      "label": "the formula behind every titration",
      "bucket": 2
    }
  ],
  "why": "Equal volumes of gas hold equal numbers of particles (Avogadro's own hypothesis) — whatever they are made of."
};

const moleCountJudge = {
  "statements": [
    {
      "s": "A mole is a count — like a dozen, but for particles — not a weight.",
      "truth": true,
      "why": "Molar mass in g/mol is the bridge that lets the count be found from a weighing, not the definition."
    },
    {
      "s": "One mole of hydrogen gas and one mole of oxygen gas contain the same number of molecules.",
      "truth": true,
      "why": "Same count — 6.022 × 10²³ — whatever the substance."
    },
    {
      "s": "Molar mass in g/mol is the definition of the mole.",
      "truth": false,
      "why": "The definition is the count; the molar mass is what makes it weighable."
    },
    {
      "s": "One mole of hydrogen gas (2.016 g) and one mole of oxygen gas (31.998 g) are wildly different weights.",
      "truth": true,
      "why": "The whole point: equal counts, unequal masses."
    }
  ]
};

const moleChainOrder = {
  "prompt": "Every stoichiometry calculation is one chain — put it in order:",
  "items": [
    "Measure what you start with — a mass, a volume or a concentration × volume",
    "Convert what you measured to moles",
    "Follow the recipe ratio from the balanced equation",
    "Convert back to the grams (or volume) of the product — watching for the reactant that runs out first"
  ],
  "why": "The ratios of the big numbers are fixed forever, whatever amounts you start with — mole counting is molecule counting scaled up."
};

const moleWaterCloze = {
  "text": "Burning 8 g of hydrogen in unlimited oxygen: moles of H₂ = 8 ÷ 2.016 ≈ %%0%% mol; the recipe's hydrogen-to-water ratio is %%1%%, so water produced = 3.97 × 18.02 ≈ 71.5 g — the other 63.5 g came from the %%2%%.",
  "answers": [
    [
      "3.97",
      "3.97 mol"
    ],
    [
      "2 : 2",
      "2:2",
      "2 to 2"
    ],
    [
      "oxygen"
    ]
  ],
  "hint": "Divide by the molar mass first; the conservation audit names the donor of the extra mass."
};

const moleLimitSpot = {
  "prompt": "One line of this limiting-reagent summary is wrong. Find it.",
  "lines": [
    "Mix 10 mol of H₂ with 10 mol of O₂ — the recipe wants 2 : 1",
    "10 mol of H₂ needs only 5 mol of O₂ — hydrogen is the limiting reagent",
    "Oxygen is in excess, with 5 mol left over",
    "The limiting reagent is whichever reactant you have fewer moles of",
    "Divide each reactant's moles by its coefficient; the smallest quotient is the limiter"
  ],
  "errorLine": 3,
  "correction": "The limit is set by the recipe ratio, not the raw counts — 3 mol of hydrogen limits even when oxygen has fewer moles, because it consumes only 1.5 mol of oxygen.",
  "why": "Reactants are almost never mixed in exact recipe proportions — finding which one runs out first is the first move of every real calculation."
};

const moleOreEstimate = {
  "prompt": "Iron ore is Fe₂O₃ (Mr = 159.7, iron at 55.8). Roughly what percentage of the ore's mass is actually iron?",
  "unit": "% iron",
  "answer": 69.9,
  "factor": 1.15,
  "why": "About 69.9 per cent — iron contributes 2 × 55.8 = 111.7 of the 159.7. That arithmetic turns a mine's assay report into a business case.",
  "context": "Percentage composition: the loop closed between formula and mass."
};
---
<TopicPage slug="subjects/chemistry/foundational/mole-and-stoichiometry">

  <h2>Where you are, and what you will learn</h2>
  <p>
    This is a beginner lesson in Chemistry, on the foundational track. It assumes no
    prior chemistry — we start from two things you already do every day: counting
    things and weighing things. Every new word is explained the moment it appears.
  </p>
  <p>By the end of this lesson you will be able to:</p>
  <ul>
    <li>read a chemical formula and say exactly what it counts;</li>
    <li>find the relative formula mass of a substance from a table of atomic masses;</li>
    <li>convert between grams, moles, and numbers of particles;</li>
    <li>balance a simple chemical equation and read it as a recipe;</li>
    <li>predict how much product a reaction makes, and which reactant runs out first.</li>
  </ul>

  <h2>Start at the bakery</h2>
  <p>
    Imagine a baker who must count flour grain by grain, while eggs arrive by the
    tonne. That is chemistry's daily predicament. Reactions happen particle by
    particle, but laboratories weigh in grams — and no balance can count molecules.
  </p>
  <p>
    The mismatch matters because particles differ hugely in weight. A water molecule
    weighs 18 atomic mass units (a tiny unit for weighing atoms). A sugar molecule
    weighs 342 of them — nineteen times more. So equal <em>grams</em> of water and
    sugar never contain equal <em>numbers</em> of molecules.
  </p>
  <Widget no="9" caption="call the molecule's weight" widget="estimate" config={moleSugarEstimate} />
  <p>
    The fix is a counting word, like "dozen" but far bigger: the
    <strong>mole</strong>. One mole is 6.022 × 10²³ particles — a number called
    Avogadro's number. How big is that? A mole of soft drink cans spread over the
    whole Earth would layer the planet about 320 km deep. It is deliberately,
    hugely enormous, so that everyday grams of stuff contain whole numbers of
    moles.
  </p>
  <p>
    And here is the magic that makes the mole useful: one mole of any substance
    weighs, in grams, exactly the number its molecules carry in atomic mass units.
    One mole of water is 6.022 × 10²³ molecules and weighs 18.02 g. One mole of
    sodium chloride is the same count of formula units and weighs 58.44 g. The mole
    is the bridge between the invisible counting world and the weighable kitchen
    world — and every calculation in this lesson crosses it.
  </p>
  <Widget no="1" caption="the mole machine — weigh water, count its molecules, and read the atoms hiding inside" widget="sliderLab" config={moleCfg} />
  <p>
    <strong>What to notice:</strong> slide the mass of water and watch all four readouts
    move together — moles, molecules, hydrogen atoms, grams of hydrogen. Set the slider to
    18 g and everything lands on round numbers: exactly one mole, one Avogadro's number of
    molecules, two moles of hydrogen atoms hiding inside. Then double the mass and notice
    every count doubles in step, while the fraction of the mass that is hydrogen never
    budges — the recipe is fixed by the formula itself.
  </p>
  <p>
    Try the machine above. 18 g of water is one mole: 6.022 × 10²³ molecules, each
    with 3 atoms (2 H + 1 O). Mass goes in, atom counts come out, no estimate
    required: 2 moles of hydrogen atoms (12.096 g) plus 1 mole of oxygen atoms
    (15.999 g) reassembles into the 18.02 g you started with. (The number is exact
    by definition since 2019: Avogadro's constant is fixed at 6.02214076 × 10²³.)
  </p>
  <p>
    <strong>So far:</strong> particles are too small to count, so chemists count in
    moles of 6.022 × 10²³ — and one mole of a substance always weighs its formula
    mass in grams.
  </p>

  <h2>Formulae: what the letters and numbers say</h2>
  <p>
    A chemical <strong>formula</strong> is a sentence with three kinds of information
    packed in: which elements, how many of each, and how they join. H₂O says two
    hydrogen atoms and one oxygen per molecule. The little numbers are
    <em>subscripts</em>, and moving one changes the substance: H₂O₂ is hydrogen
    peroxide, not "double water".
  </p>
  <p>
    Two flavours exist. A <strong>molecular formula</strong> names a whole molecule,
    like glucose, C₆H₁₂O₆. An <strong>empirical formula</strong> gives only the
    simplest whole-number ratio — glucose's is CH₂O. Ionic compounds have no
    molecules at all: NaCl just means the 1:1 ratio of sodium to chloride ions in
    the crystal.
  </p>
  <Widget no="8" caption="pair each formula with what it names" widget="match" config={moleFormulaMatch} />
  <p>
    Formulae scale up into <strong>equations</strong>, the sentences of chemistry:
    2H₂ + O₂ → 2H₂O. Balancing an equation — equal atoms of each element on both
    sides — is not bookkeeping pedantry. It is the law of conservation of mass
    written down: atoms are neither created nor destroyed in a reaction, so an
    unbalanced equation describes an impossible event.
  </p>

  <h2>Relative masses: weighing atoms without weighing them</h2>
  <p>
    Atoms are absurdly light — a hydrogen atom is about 1.7 × 10⁻²⁴ g — so chemists
    quote <em>relative</em> masses instead. The <strong>relative atomic mass</strong>
    (A<sub>r</sub>) of an element is its average atomic mass compared with the
    carbon-12 standard, which is defined as exactly 12. Hydrogen is 1.008, carbon
    12.011, oxygen 15.999.
  </p>
  <p>
    Why "average"? Because natural carbon is a mixture of <strong>isotopes</strong>
    — atoms of the same element with slightly different masses: 98.9% carbon-12 and
    1.1% carbon-13. The average lands just above 12, at 12.011. A
    <strong>relative formula mass</strong> (M<sub>r</sub>) is simply the sum for a
    compound: for water, (2 × 1.008) + 15.999 = 18.02. These numbers are pure
    comparisons — but the mole is about to make them weighable.
  </p>
  <p>
    <strong>So far:</strong> formulas count atoms; relative masses compare them
    against carbon-12; and the mole converts those paper numbers into grams on a
    balance.
  </p>

  <h2>The mole, precisely</h2>
  <p>
    The definition is beautifully simple: one mole contains exactly 6.02214076 ×
    10²³ specified entities. Why does weighing then work? Because Avogadro's
    constant is, to ten-digit precision, the number of atomic mass units in one
    gram: 1 u × 6.022 × 10²³ ≈ 1 g. So the M<sub>r</sub> you compute on paper
    becomes the <strong>molar mass</strong> in g/mol that you can put on a balance.
    No conversion factor to memorise — the constant <em>is</em> the conversion.
  </p>
  <p>
    Three working formulas generate all of stoichiometry from here:
  </p>
  <Widget no="7" caption="file each calculation under its formula" widget="sort-buckets" config={moleFormulaBuckets} />
  <ul>
    <li><strong>moles = mass ÷ molar mass</strong> — 36.04 g of water is 2 mol; 5.85 g of NaCl is 0.1 mol.</li>
    <li><strong>moles = volume ÷ 24 dm³</strong> for any gas at room temperature and pressure — because one mole of any gas fills about 24,000 cm³ at 20 °C, 1 atm. Equal volumes of gas hold equal numbers of particles (Avogadro's own hypothesis), so 12 dm³ of any gas is about 0.5 mol, whatever it is made of.</li>
    <li><strong>moles = concentration × volume</strong> — a 0.5 mol/dm³ solution holds 0.5 mol per litre, so 250 cm³ of it contains 0.125 mol. This is the formula behind every titration.</li>
  </ul>
  <p>
    <em>Common misconception:</em> "a mole is a weight." It is a <em>count</em> — like a
    dozen, but for particles. Molar mass in g/mol is the bridge that lets the count be
    found from a weighing, not the definition itself. One mole of hydrogen gas (2.016 g) and
    one mole of oxygen gas (31.998 g) contain the same number of molecules and are wildly
    different weights — the whole point.
  </p>
  <Widget no="6" caption="true or false — count or weight" widget="judge" config={moleCountJudge} />

  <h2>Stoichiometry: reading equations as recipes</h2>
  <p>
    <strong>Stoichiometry</strong> — Greek for "element measuring" — is the arithmetic
    of reactions. It treats a balanced equation as a recipe with two interchangeable
    readings. 2H₂ + O₂ → 2H₂O says "2 molecules of hydrogen react with 1 of oxygen to
    make 2 of water", and equally "2 moles + 1 mole → 2 moles", because mole counting
    is molecule counting scaled up. The ratios of the big numbers are fixed forever,
    whatever amounts you start with.
  </p>
  <Widget no="5" caption="run the mole chain, in order" widget="order" config={moleChainOrder} />
  <p>
    Worked example, end to end: how much water is made by burning 8 g of hydrogen in
    unlimited oxygen? Moles of H₂ = 8 ÷ 2.016 ≈ 3.97 mol. The recipe's
    hydrogen-to-water ratio is 2 : 2, so water produced = 3.97 mol. Mass = 3.97 ×
    18.02 ≈ 71.5 g. Notice the mass grew from 8 g to 71.5 g — the other 63.5 g came
    from the oxygen. Conservation of mass, audited across two different substances.
  </p>
  <Widget no="4" caption="fill the blanks — the worked recipe" widget="cloze" config={moleWaterCloze} />
  <p>
    Now make it realistic: mix 10 mol of H₂ with 10 mol of O₂. The recipe wants 2 : 1,
    so 10 mol of H₂ needs only 5 mol of O₂. Hydrogen is the <strong>limiting
    reagent</strong> — the reactant that runs out first and sets the yield. Oxygen is
    in excess, with 5 mol left over. Reactants are almost never mixed in exact recipe
    proportions; finding which one runs out first is the first move of every real
    calculation, from industrial synthesis to exam papers.
  </p>
  <Widget no="3" caption="one line of the limiting-reagent summary is wrong" widget="spot-error" config={moleLimitSpot} />
  <p>
    <em>Common misconception:</em> "the limiting reagent is whichever reactant you have
    fewer moles of." The limit is set by the <em>recipe ratio</em>, not the raw counts:
    in 2H₂ + O₂ → 2H₂O, a mixture of 3 mol of hydrogen and 2 mol of oxygen has hydrogen
    limiting even though oxygen has fewer moles — the recipe wants 2 hydrogen per 1
    oxygen, so 3 mol of hydrogen consumes only 1.5 mol of oxygen and runs out first.
    Divide each reactant's moles by its coefficient; the smallest quotient is the
    limiter.
  </p>
  <p>
    Two honesty checks complete the toolkit. <strong>Percent yield</strong> compares
    what you got with what the recipe promised: 45 g of product when theory says 50 g
    is a 90% yield. Reactions rarely deliver the maximum — side reactions happen, some
    product is lost on transfer, and some reactions stop part-way.
    <strong>Empirical formula from data</strong> runs the machine in reverse: burn an
    unknown hydrocarbon, weigh the CO₂ and H₂O produced, convert each to moles of C
    and H, and reduce to the simplest whole-number ratio. This is literally how the
    first molecular formulas of the 1800s were discovered, and how unknown compounds
    are still identified today.
  </p>
  <p>
    One more application — <strong>percentage composition</strong> — closes the loop
    between formula and mass. What fraction of iron ore (Fe₂O₃, M<sub>r</sub> =
    159.7) is actually iron? Iron contributes 2 × 55.8 = 111.7 of the 159.7, so the
    ore is 69.9% iron by mass. That is the arithmetic that turns a mine's assay
    report into a business case.
  </p>
  <Widget no="2" caption="call the ore's iron fraction" widget="estimate" config={moleOreEstimate} />
  <p>
    The same arithmetic powers <strong>titration calculations</strong> end to end:
    measure the acid volume that neutralises a measured alkali, convert both to moles
    with concentration × volume, read the mole ratio off the balanced equation, and
    report the unknown concentration. Worked result: neutralising 25.0 cm³ of 0.100
    mol/dm³ NaOH took 23.6 cm³ of H₂SO₄. Moles of NaOH = 2.50 × 10⁻³; the equation
    2NaOH + H₂SO₄ → Na₂SO₄ + 2H₂O shows 2 : 1, so acid moles = 1.25 × 10⁻³;
    concentration = 1.25 × 10⁻³ ÷ 0.0236 = 0.053 mol/dm³. Every number in that chain
    came from one of the three formulas above — the mole machine running in the wet
    lab.
  </p>
  <p>
    One final worked example, run as a quick check: a laboratory diamond of 2.40 g —
    how many atoms? Moles of carbon = 2.40 ÷ 12.011 ≈ 0.2 mol; atoms = 0.2 × 6.022 ×
    10²³ ≈ 1.2 × 10²³. Mass in, count out, no estimate anywhere in the chain.
  </p>
  <p>
    <strong>So far:</strong> a balanced equation is a recipe. Convert whatever you
    measured to moles, follow the recipe ratio, and convert back — watching for the
    reactant that runs out first.
  </p>

  <h2>Check yourself</h2>
  <p>Try these before moving on. The answers are right below.</p>
  <ol>
    <li>What is the relative formula mass of CO₂? (A<sub>r</sub>: carbon 12.011, oxygen 15.999.)</li>
    <li>How many moles is 9.01 g of water — and how many molecules?</li>
    <li>A mixture contains 6 mol of hydrogen and 2 mol of oxygen. In 2H₂ + O₂ → 2H₂O, which reactant is limiting, and how much water forms?</li>
  </ol>
  <p>
    <strong>Answers:</strong> (1) 12.011 + (2 × 15.999) = 44.01. (2) Moles = 9.01 ÷
    18.02 = 0.5 mol; molecules = 0.5 × 6.022 × 10²³ ≈ 3.01 × 10²³. (3) Divide each by
    its coefficient: 6 ÷ 2 = 3 for hydrogen, 2 ÷ 1 = 2 for oxygen. The smaller
    quotient is oxygen, so oxygen is limiting, and the water made is 2 × 2 = 4 mol.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>A mole is a count — 6.022 × 10²³ particles — not a weight.</li>
    <li>One mole of any substance weighs its formula mass in grams: moles = mass ÷ molar mass.</li>
    <li>For gases at room temperature and pressure one mole fills about 24 dm³; for solutions, moles = concentration × volume.</li>
    <li>A balanced equation is a recipe with fixed ratios, true for molecules and for moles alike.</li>
    <li>The chain is always the same: convert what you measured to moles, follow the recipe ratio, convert back.</li>
    <li>The limiting reagent — smallest moles ÷ coefficient — runs out first and sets the yield.</li>
    <li>Percent yield compares what you got with what the recipe promised; reactions rarely deliver the maximum.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    The mole is the working tool for the rest of this Chemistry track: acids, bases and pH
    runs every titration on moles = concentration × volume, and atomic structure explains
    where the atomic masses you have been adding up come from. Along the track, the periodic
    table turns those same atomic masses into a map of the elements.
  </p>

  <h2>Going deeper</h2>
  <p>
    The history clarifies the logic. Avogadro proposed in 1811 that equal volumes of gas
    contain equal numbers of molecules — which immediately explained why 2 volumes of
    hydrogen combine with 1 of oxygen to give 2 of water vapour (molecules must be diatomic:
    H₂ + ½O₂ → H₂O, doubled to clear the fraction). The hypothesis was ignored for fifty
    years, partly because "molecule" and "atom" were used interchangeably; Stanislao
    Cannizzaro's 1860 campaign for it finally fixed the confusion and gave chemistry its
    first reliable atomic masses — the periodic table itself became sortable only after this
    accounting was sound. The mole thus sits at the junction of chemistry's two great
    structure stories: it made the atomic theory quantitative.
  </p>
  <p>
    <em>Common misconception:</em> "Avogadro discovered Avogadro's number." He never knew
    it. Avogadro (1811) proposed the equal-volumes hypothesis; the constant named for him
    was first estimated decades later (Josef Loschmidt's 1865 calculation from kinetic
    theory is the classic first) and pinned down by Jean Perrin's experiments around
    1908–1915 — work that also confirmed atoms exist and earned Perrin the 1926 Nobel.
    Honoured posthumously, Avogadro got a number he could not have measured.
  </p>
  <p>
    Quantitatively, two refinements matter at the expert edge. First, gas volumes: the
    24 dm³ figure holds only at ~20 °C and 1 atm; the ideal gas law pV = nRT generalises it
    to any conditions (at 0 °C it is 22.7 dm³), and real gases deviate slightly at high
    pressure — deviations from which van der Waals built corrections, and from which the
    existence of intermolecular forces was first measured. Second, the 2019 SI redefinition:
    the kilogram used to be a platinum–iridium cylinder in a Paris vault, and Avogadro's
    number was measured against it; the SI was redefined to fix the constants instead, so
    the mole is now exact by definition and the kilogram is calibrated <em>from</em> it —
    via the silicon-sphere X-ray crystal density method and the Kibble balance. Chemistry's
    humble accounting unit ended up anchoring the metric system. And titrations — the
    concentration × volume formula meeting a colour-flipping indicator — are the practical
    exam where all of this becomes wet glassware.
  </p>

  <p class="sources"><strong>Sources:</strong> OpenStax, Chemistry 2e (Stoichiometry); BIPM SI redefinition (2019); Cannizzaro, Sketch of a Course of Chemical Philosophy (1860). Source text: OpenStax (https://openstax.org), CC BY 4.0 — adapted for Interactive Atlas.</p>
</TopicPage>
