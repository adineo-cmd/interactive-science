---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const diagCfg = {
  steps: [
    { math: '1 · Verify the complaint', note: 'Drive or reproduce the fault first. "It makes a noise" is a story; a repeatable symptom is a case.' },
    { math: '2 · Read, then measure', note: 'Service information and DTCs (fault codes) point toward systems — never at a part. The scanner names suspects; tests convict them.' },
    { math: '3 · Test the circuit, not the part', note: 'Voltage drop tests, continuity, reference signals: components fail in patterns, and the wiring between them fails more often than the parts.' },
    { math: '4 · Repair the root cause', note: 'A blown fuse is a symptom. Replacing it without finding why it blew is the trade\'s definition of a comeback.' },
    { math: '5 · Verify and document', note: 'Re-test after repair, then write what was found, fixed and verified. Documentation is what turns a repair into a service history.' },
  ],
};

const sssHazardBuckets = {
  "prompt": "One room, several hazard classes — file each:",
  "buckets": [
    "Chemical / fire",
    "Mechanical",
    "Electrical"
  ],
  "items": [
    {
      "label": "fuel vapour ignites from sparks you cannot see",
      "bucket": 0
    },
    {
      "label": "brake cleaner never sprayed near a running engine or catalytic converter",
      "bucket": 0
    },
    {
      "label": "rotating belts and fans take fingers",
      "bucket": 1
    },
    {
      "label": "hot coolant scalds at opening pressure — cap released slowly, cold engine first",
      "bucket": 1
    },
    {
      "label": "compressed air above roughly 30 psi can drive debris through skin",
      "bucket": 1
    },
    {
      "label": "orange cables carry 400–800 volts demanding certified EV training",
      "bucket": 2
    },
    {
      "label": "the 12-volt system's arc potential",
      "bucket": 2
    }
  ],
  "why": "Every class of hazard has an engineered defence, and PPE is the last line, not the first."
};

const sssAirEstimate = {
  "prompt": "Tyre pressures run around 35 psi, and shop air lines run far higher. Above roughly what pressure can compressed air drive debris through skin?",
  "unit": "psi",
  "answer": 30,
  "factor": 1.3,
  "why": "About 30 psi — the reason air lines are treated as injection hazards, not splashes: debris-driven air is a medical emergency.",
  "context": "The same respect applies to hydraulics: a vehicle raised off the ground is a couple of tonnes of stored gravitational energy."
};

const sssPpeMatch = {
  "prompt": "PPE is matched to the task — pair the hazard with its defence:",
  "pairs": [
    {
      "left": "grinding, brake dust, battery acid",
      "right": "safety glasses from the first minute"
    },
    {
      "left": "a falling brake drum",
      "right": "steel-toe boots — it weighs what a bowling ball weighs"
    },
    {
      "left": "impact wrenches",
      "right": "hearing protection"
    },
    {
      "left": "oil on concrete",
      "right": "housekeeping — a shop's floor condition predicts its injury record"
    }
  ],
  "why": "Two habits summarise the whole safety module: protect yourself first, and never let time pressure talk you out of a step."
};

const sssToolSpot = {
  "prompt": "This tool-cart briefing contains one faulty line — click it:",
  "lines": [
    "Hand tools are organised by drive size and system.",
    "Torque wrenches are for anything with a specification.",
    "An uncalibrated torque wrench is a random-number generator pointed at a wheel bearing.",
    "Any size wrench works if you push hard enough — a rounded-off bolt just needs muscle.",
    "Specialty tools the manufacturer requires — like for timing chains — get used, not improvised."
  ],
  "errorLine": 3,
  "correction": "Use the right size: a rounded-off bolt is a 20-minute problem created in 2 seconds — and calibrate the torque wrench.",
  "why": "The two habits that separate professionals: the right size, always, and a calibrated torque wrench for anything with a spec."
};

const sssLiftOrder = {
  "prompt": "The liturgy that keeps tonnes off people — put it in order:",
  "items": [
    "know the vehicle's weight against the lift's rated capacity",
    "position the arms at the factory-marked lift points",
    "raise to just off the floor",
    "push the vehicle to confirm balance",
    "raise fully and engage the mechanical safety locks"
  ],
  "why": "A lift rated for 4,000 kg does not become 4,500 kg because you hope — and even a correctly placed lift can tip an unbalanced load. The checks cost ninety seconds; the failure mode is measured in tonnes."
};

const sssSecondPredict = {
  "q": "A colleague says 'I'm only going under for a second' — car still on the jack. What does the trade's record say happens?",
  "choices": [
    "almost nothing — seconds are safe while the seal is new",
    "the vehicles that fall are overwhelmingly the ones someone believed would be fine for a moment",
    "falls only happen with old, worn-out jacks"
  ],
  "answer": 1,
  "why": "Every safety rule in the lifting section is a memorial to exactly that sentence — hydraulics hold weight, they do not hold responsibility, and a seal can fail silently."
};

const sssBatteryBranch = {
  "root": "You need to disconnect a 12-volt battery to service the charging system. Hydrogen vents during charging; acid is in the cells.",
  "nodes": {
    "start": {
      "text": "What is your sequence?",
      "choices": [
        {
          "label": "Positive first, then negative",
          "next": "backwards",
          "feedback": "Backwards — and the reason is in your hand."
        },
        {
          "label": "Negative first; reconnect negative last",
          "next": "correct",
          "feedback": "The liturgy."
        },
        {
          "label": "No disconnect — just be careful around the terminals",
          "next": "careful",
          "feedback": "Careful is not a procedure."
        }
      ]
    },
    "backwards": {
      "text": "Disconnecting positive first leaves your wrench one slip away from shorting across the terminals — the arc happens with your hand on the tool.",
      "choices": []
    },
    "correct": {
      "text": "Negative first, reconnect last: no sparks near venting hydrogen, gloves and eye protection for the acid, and the wrench can never complete the circuit across the terminals.",
      "choices": []
    },
    "careful": {
      "text": "Disconnecting order exists precisely because a wrench across the terminals is an arc with your hand on it — gloves and caution do not replace the procedure.",
      "choices": []
    }
  },
  "why": "Fluids and batteries each carry a handling discipline: used oil is collected, coolant is wiped immediately, brake fluid stays sealed, refrigerants belong to certified technicians."
};

const sssRecordCloze = {
  "text": "Outbound, the technician writes the three-part record: the %%0%% (as verified), the %%1%% (the diagnosis, with the tests that proved it), and the %%2%% (the repair performed, the parts replaced, the verification run).",
  "answers": [
    [
      "concern"
    ],
    [
      "cause"
    ],
    [
      "correction"
    ]
  ],
  "hint": "What the customer brought, why it happened, and what you did about it — the diagnostic method's paperwork twin."
};
---
<TopicPage slug="subjects/automotive-technology/foundational/shop-safety-and-service-basics">
  <h2>Where you are, and what you will learn</h2>
  <p>
    This is the beginner lesson of Automotive Technology. You need zero prior knowledge —
    no tools, no engine experience, no shop. We start with the picture most people already
    have of the trade, and then correct it.
  </p>
  <Widget no="7" caption="bet first — 'just a second' under the jack" widget="predict" config={sssSecondPredict} />
  <Widget no="5" caption="find the faulty line — tool discipline" widget="spot-error" config={sssToolSpot} />
  <Widget no="3" caption="call the magnitude — the air-injection threshold" widget="estimate" config={sssAirEstimate} />
  <p>By the end of this lesson you will be able to:</p>
  <ul>
    <li>name the main hazard classes of a working shop and the defence for each;</li>
    <li>state the rules that keep a raised vehicle from ever falling on someone;</li>
    <li>find and use the manufacturer's service information, including torque specs and TSBs;</li>
    <li>read a fault code the way a professional does — as a pointer, not a verdict;</li>
    <li>write the concern–cause–correction record the industry expects.</li>
  </ul>
  <p>
    Every new term is explained the moment it appears. Take your time — one idea per
    paragraph.
  </p>

  <h2>Start with the picture in your head</h2>
  <p>
    Picture the trade's romantic image: hands, wrenches, grease. Now look at a real modern
    bay. A laptop sits on the fender, a scanner is plugged into the car, orange cables
    thread through an electric vehicle in the next stall. A modern vehicle is a network of
    sensors and computers bolted to engines and brakes — and the technician's real product
    is a <em>verified diagnosis</em> followed by a correct repair.
  </p>
  <p>
    That changes what the foundations are. Before any tear-down, the trade teaches three
    things: how to work in a shop full of stored energy without getting hurt, how to lift
    and support vehicles so gravity never gets a vote, and how to read the manufacturer's
    service information — because nobody, including the factory master technician,
    memorises a modern car.
  </p>
  <p>
    The ordering is deliberate and a little philosophical. A wrong part costs money. A
    wrong diagnosis costs money and trust. An unsupported vehicle costs a life. So the
    trade's foundation unit ranks safety above information above technique, and
    certification bodies (ASE in North America) test all three — including, notably, the
    ability to find the right service-information page quickly, which is an explicitly
    tested skill, not background decoration.
  </p>
  <p>
    Everything here also serves the trade's defining habit: <em>proof before parts</em>.
    The diagnostic method — verify the complaint, read the data, test the circuit, fix the
    root cause, verify and document — is the same discipline whether the vehicle is a 1995
    pickup or a 2026 EV, and the safety and information fundamentals are what let you apply
    it without becoming the case study.
  </p>

  <Widget no="1" caption="the diagnostic method, from complaint to comeback" widget="equationStep" config={diagCfg} />
  <p>
    <strong>What to notice:</strong> press "Walk me through it" and reveal the five moves of
    the diagnostic method in order — verify the complaint, read then measure, test the
    circuit, repair the root cause, verify and document. Notice how the steps discipline one
    another: no part gets replaced before a test convicts it, and no repair counts as finished
    until it has been re-tested and written down. That order is what separates a diagnosis
    from a guess.
  </p>

  <h2>Workshop safety and tools</h2>
  <p>
    The shop concentrates several classes of hazard into one room, and each has an
    engineered defence. <strong>Chemical and fire hazards</strong>: fuel vapour ignites
    from sparks you cannot see, so fuel-system work happens with a fire extinguisher in
    reach and battery disconnects before anything arcs. Brake cleaner and other solvents
    are flammable and must never be sprayed near a running engine, a grinder, or a
    catalytic converter's exhaust.
  </p>
  <Widget no="2" caption="file the hazard — which class owns it?" widget="sort-buckets" config={sssHazardBuckets} />
  <p>
    <strong>Mechanical hazards</strong>: rotating belts and fans take fingers. Hot coolant
    scalds at opening pressure — release the cap slowly, cold engine first. Compressed air
    above roughly 30 psi can drive debris through skin. <strong>Electrical
    hazards</strong>: besides the 12-volt system's arc potential, modern bays contain
    high-voltage orange cables carrying 400–800 volts that demand certified EV training
    before touch — no exceptions, no "just a quick look".
  </p>
  <p>
    Personal protective equipment is the last line, after the engineered ones: safety
    glasses from the first minute (grinding, brake dust, battery acid), steel-toe boots (a
    falling brake drum weighs what a bowling ball weighs), gloves matched to the task, and
    hearing protection around impact tools. Housekeeping is safety too — oil on concrete is
    a slip waiting, and a shop's floor condition predicts its injury record with
    unsettling accuracy.
  </p>
  <Widget no="4" caption="pair each hazard with its PPE" widget="match" config={sssPpeMatch} />
  <p>
    <strong>Tool discipline</strong> completes the picture. Hand tools are organised by
    drive size (6.3 mm / 10 mm square drive families) and system: wrenches and sockets for
    fasteners, torque wrenches for anything with a specification, pullers for press-fitted
    parts, and specialty tools the manufacturer requires for jobs like timing chains. The
    two habits that separate professionals: use the <em>right</em> size (a rounded-off bolt
    is a 20-minute problem created in 2 seconds), and calibrate torque wrenches — an
    uncalibrated torque wrench is a random-number generator pointed at a wheel bearing.
  </p>
  <p>
    <em>Common misconception:</em> safety rules are for beginners and slow things down. The
    opposite is measured and true — the fastest techs are the safest, because the procedures
    (stands under the vehicle, specs verified, caps cracked cold) are exactly the ones that
    prevent the ten-minute injuries that cost months.
  </p>

  <h2>Vehicle lifting and support</h2>
  <p>
    A vehicle raised off the ground is a couple of tonnes of stored gravitational energy,
    and the trade treats it that way. The foundational rules: <strong>never work under a
    vehicle supported only by a hydraulic jack</strong> — hydraulics hold weight, they do
    not hold <em>responsibility</em>; a seal can fail silently. Jack stands (or lift arms
    with their mechanical locks engaged) take the load, placed at the manufacturer's
    designated lift points: reinforced pads, pinch-weld rails or frame sections designed to
    carry it. Lift points are not decorative — a floor jack placed under a fuel tank,
    floorpan or control arm crushes something expensive or lets the vehicle slide.
  </p>
  <p>
    Two-post lifts add their own liturgy: know the vehicle's weight against the lift's
    rated capacity (a lift rated for 4,000 kg does not become 4,500 kg because you hope),
    position the arms at the factory-marked points, raise to just off the floor, push the
    vehicle to confirm balance, then raise and engage the mechanical safety locks. Even a
    correctly placed lift can tip an unbalanced load. The checks cost ninety seconds; the
    failure mode is measured in tonnes. On 4-post and scissor lifts the same logic applies
    through different hardware — rated capacity, correct spotting, locks engaged before
    anyone underneath.
  </p>
  <Widget no="6" caption="rebuild the two-post lift procedure, step by step" widget="order" config={sssLiftOrder} />
  <p>
    <em>Common misconception:</em> "I'm only going under for a second." The vehicles that fall
    are overwhelmingly the ones someone believed would be fine for a moment. Every safety rule
    in the lifting section is a memorial to exactly that sentence.
  </p>
  <p>
    <strong>So far:</strong> the shop's hazards each have an engineered defence, PPE is the
    last line, and a raised vehicle is never trusted to hydraulics alone. Next: where the
    numbers come from.
  </p>

  <h2>Service information systems</h2>
  <p>
    No technician memorises a modern car, and the trade's information literacy is a core
    skill, tested explicitly. Manufacturers publish factory service information:
    <strong>torque specifications</strong> (every critical fastener has a number, and wheel
    lugs are safety-critical), wiring diagrams, removal and installation procedures,
    relearn and calibration routines (throttle bodies, steering-angle sensors, window
    anti-pinch), and — the professional's shortcut — <strong>technical service
    bulletins</strong> (TSBs), which document known faults and validated fixes. Reading the
    TSB before the diagnosis can turn a four-hour hunt into a thirty-minute confirmation,
    because someone may have solved this complaint already.
  </p>
  <p>
    Using the system is itself a skill: OEM subscriptions or reputable aftermarket
    databases, searching by vehicle identification number (VIN) rather than model year,
    reading the <em>conditions</em> attached to a procedure (a "bulge test" for a battery,
    a specific temperature before an adjustment), and knowing that diagnostic trouble codes
    (DTCs) point toward systems, never at parts — P0420 does not mean "replace the
    catalytic converter", it means "the converter's efficiency monitor is unhappy; find out
    why". The professional habit: verify the spec before the repair and read the bulletin
    before the diagnosis.
  </p>
  <p><em>Common misconception:</em> a fault code tells you which part to replace. Codes point
  toward the <em>system</em> that noticed a problem, not at the part that caused it — a P0420
  code convicts no converter until tests do. Parts replaced on the strength of a code alone
  are where comebacks are born.</p>

  <h2>Fluids, loads and the body</h2>
  <p>
    Service basics also include the substances the trade moves daily, and each carries
    handling discipline. Engine oil and gear lube irritate skin and carry used-fluid
    carcinogens (used oil is collected, never drained to ground). Coolant is sweet-tasting
    and toxic to animals and children (spills are wiped immediately). Brake fluid eats
    paint and absorbs water from the air (kept sealed). Refrigerants are handled only by
    certified technicians with recovery equipment.
  </p>
  <p>
    Battery work has its own liturgy — hydrogen gas venting during charging means no
    sparks, acid means gloves and eye protection, and disconnecting order matters (negative
    first, reconnect last) to avoid shorting the wrench across the terminals.
  </p>
  <Widget no="8" caption="run the disconnect — battery terminal sequence" widget="branch" config={sssBatteryBranch} />
  <p>
    The human machine completes the safety picture. Technicians lift transmissions and
    wheels for a living, so the trade teaches mechanics' hygiene as seriously as torque:
    lift with legs and load close, use the transmission jack rather than the spine, keep
    hands from between moving parts and pinch points, and respect the noise exposure of
    impact wrenches with hearing protection. Two habits summarise the whole safety module:
    protect yourself first (glasses, boots, gloves for the job), and never let a time
    pressure talk you out of a step — the vehicle can be fixed tomorrow; the hand cannot.
  </p>

  <h2>The work order and the professional conversation</h2>
  <p>
    Between the customer and the repair sits the work order — and reading and writing it is
    a foundational skill, tested and graded. Inbound, the technician reads the customer's
    complaint through the service advisor's transcription ("makes a noise when turning
    left" plus the vehicle's VIN, mileage and history) and learns to ask the clarifying
    questions the complaint leaves out: which speed, which surface, cold or hot, constant
    or intermittent?
  </p>
  <p>
    Outbound, the technician writes the three-part record the industry expects: the
    <em>concern</em> (as verified), the <em>cause</em> (the diagnosis, with the tests that
    proved it), and the <em>correction</em> (the repair performed, the parts replaced, the
    verification run). That concern–cause–correction structure is the diagnostic method's
    paperwork twin, and it is what the next technician, the warranty auditor and the
    customer all read.
  </p>
  <Widget no="9" caption="fill the blanks — the work order's three parts" widget="cloze" config={sssRecordCloze} />
  <p>
    Time-keeping completes the professional layer: flat-rate labour guides estimate each
    job's hours, so a technician's productivity and the shop's estimates both live on
    published times — another reason verifying specs and following procedures exactly pays:
    the published time assumes the procedure was followed.
  </p>
  <p>
    <strong>So far:</strong> safety, lifting, information, fluids, paperwork — and one
    habit underneath all of them: proof before parts. Check yourself before the last
    section.
  </p>

  <h2>Check yourself</h2>
  <p>Try these before moving on. The answers are right below.</p>
  <ol>
    <li>Why is a hydraulic jack never enough to work under?</li>
    <li>A scanner shows code P0420. What does the code actually tell you?</li>
    <li>Before replacing a sensor, what two information steps should come first?</li>
  </ol>
  <p>
    <strong>Answers:</strong> (1) Hydraulics hold weight but not responsibility — a seal can
    fail silently, so jack stands or locked lift arms take the load at the proper lift
    points. (2) Only that the converter's efficiency monitor is unhappy — it points toward
    a system to investigate, not a part to replace. (3) Read the factory service
    information (spec, procedure, conditions) and check for a technical service bulletin —
    someone may have solved this complaint already.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>The trade's foundation ranks safety above information above technique — a wrong part costs money, a wrong diagnosis costs trust, an unsupported vehicle costs a life.</li>
    <li>Every class of shop hazard has an engineered defence, and PPE is the last line, not the first.</li>
    <li>Never work under a vehicle held only by a hydraulic jack: jack stands or locked lift arms take the load, placed at the manufacturer's lift points.</li>
    <li>Nobody memorises a modern car — find the torque spec, the procedure and any TSB in the factory service information before the repair.</li>
    <li>A fault code points toward a system, never at a part; codes nominate suspects, tests convict them.</li>
    <li>Fluids and batteries each carry a handling discipline, and every repair earns a concern-cause-correction record.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    With the fundamentals in place, the intermediate units open the systems themselves —
    engine repair, brakes, steering and suspension, and automotive electrical systems — and
    the diagnostic method from this lesson is the tool you will carry into every one. The
    trade's electrification extends the same hazard discipline to high-voltage work, which is
    why the safety rules here are taught first and never retired.
  </p>

  <h2>Going deeper</h2>
  <p>
    <strong>The modern vehicle is a computer network</strong>, and service information has
    grown to match. Dozens of electronic control units (ECUs) converse on CAN buses; a
    stiff steering feel may be a calibration, a rough idle may be a sensor's dirty
    reference voltage, and a "transmission problem" may live in an engine sensor's data.
    That is why the trade now teaches electronics alongside engines — and why scan tools
    have become oscilloscopes' cousins: the best technicians read data streams (is the
    oxygen sensor switching? is the MAF signal plausible for this airflow?) rather than
    just clearing codes.
  </p>
  <p>
    <strong>The diagnostic method earns its depth</strong> in pattern knowledge: components
    fail in characteristic ways (fuel pumps lose pressure under load, coils fail hot,
    grounds fail intermittently), and wiring between components fails more often than the
    parts — the voltage-drop test across a corroded ground is one of the trade's
    highest-yield measurements. Documentation closes the loop: what the complaint was, what
    was found, what was fixed, what was verified. That record is what turns a repair into a
    service history, protects the shop in disputes, and — in the trade's own accounting —
    is the difference between a fix and a <em>comeback</em>, the return visit that costs
    more than the original job.
  </p>
  <p>
    <strong>Electrification is rewriting the foundations</strong> in real time: high-voltage
    isolation testing, lockout/tagout of HV systems, de-powering procedures and aftermarket
    information for EVs are becoming part of general service rather than a speciality. The
    fundamentals on this page are the durable layer beneath that change — hazard ranking,
    load discipline, information literacy and proof before parts — which is precisely why
    they are taught first.
  </p>
  <p>
    <strong>Preventive maintenance is the fundamentals' most public application.</strong>
    Manufacturers publish service schedules — oil and filter at mileage or time intervals,
    brake fluid on a moisture-absorption clock, coolant on chemistry, belts and tyres on
    wear — and the technician's inspection is that schedule made physical: the multi-point
    check that catches the brake pad at 3 mm (before the rotor is scored), the tyre at the
    wear bar (before the hydroplane), the leaking strut (before the tyres feather). The
    diagnostic habit applies here too, just gentler: measure, compare to specification,
    document — because "looks OK" is not a service record. For the trade's economics,
    maintenance work is the customer relationship's heartbeat: done honestly and
    explained clearly, it is how a shop earns the trust that diagnostics later draw on.
    The service-basics unit thus ends where the career begins: safe lifts, correct specs,
    verified work, written down — every visit, every vehicle.
  </p>

  <p class="sources"><strong>Sources:</strong> ASE Education Foundation program standards; ASE A1–A9 test content; manufacturer service information systems. Source text: OpenStax (https://openstax.org), CC BY 4.0 — adapted for Interactive Atlas.</p>
</TopicPage>
