const gmLatentEstimate = {
  "prompt": "In Stable Diffusion, a 512 × 512 pixel image lives in a 64 × 64 latent. Roughly how many times fewer numbers does the latent hold?",
  "unit": "×",
  "answer": 64,
  "factor": 1.3,
  "why": "(512 ÷ 64)² = 64 — an 8 × 8 per-side compression, which is why consumer GPUs can run these models at all.",
  "context": "The geometry is queryable: interpolation passes through plausible intermediate faces, and direction arithmetic yielded 'smiling' as a vector you can add to a neutral face."
};

const gmSteerSpot = {
  "prompt": "This conditioning summary contains one faulty line — click it:",
  "lines": [
