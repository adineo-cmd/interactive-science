import Widget from '../../../../components/Widget.astro';

const tfCfg = {
  steps: [
    { math: '1 · Tokens and embeddings', note: 'Text is split into tokens (~sub-words); each token becomes a vector of numbers — an embedding where similar meanings sit close together. Language becomes geometry.' },
    { math: '2 · Attention: words consult words', note: 'The transformer\'s core (2017, "Attention Is All You Need"): every token can look at every other token and pull in what\'s relevant. "It" attends back to "the trophy" — disambiguation without reciting the sentence word by word.' },
    { math: '3 · Pretraining: predict the next token', note: 'Train on trillions of tokens of internet text with one task: guess the next token. To do it well, the model must absorb grammar, facts, style and reasoning patterns — knowledge as a side effect of prediction.' },
    { math: '4 · Fine-tuning and alignment', note: 'After pretraining, instruction fine-tuning and human-feedback training (RLHF) shape the raw predictor into an assistant that follows instructions and refuses harmful requests.' },
    { math: '5 · Scale laws made it inevitable', note: 'Loss falls predictably as model size, data and compute grow (Kaplan 2020, Chinchilla 2022). Predictable improvements at unpredictable-feeling capability jumps — the engine of the GPT series and its rivals.' },
  ],
};
---
<TopicPage slug="subjects/artificial-intelligence/advanced/transformers-and-large-language-models">
  <h2>The idea</h2>
  <p>
    Transformers are <strong>neural networks built on attention</strong> — a mechanism letting
    every token of text consult every other token. Trained to predict the next token on
    internet-scale text, they become large language models (LLMs) that write, translate, code
    and reason in ways their creators did not individually program. They are the defining AI
    system of the 2020s.
  </p>

  <Widget no="1" caption="the LLM pipeline: tokens → attention → pretraining → alignment → scale" widget="equationStep" config={tfCfg} />

  <h2>What LLMs can and can't do — honestly</h2>
  <ul>
    <li><strong>They predict tokens, and that explains the quirks:</strong> hallucination (plausible-sounding falsehoods are just good predictions), sensitivity to phrasing, and knowledge frozen at training time (unless retrieval is added).</li>
    <li><strong>Context windows are working memory:</strong> models attend within a bounded window (128K+ tokens now) — anything outside doesn't exist. Long tasks are workflows, not one prompt.</li>
    <li><strong>Emergent abilities are disputed:</strong> some skills appear only at scale; researchers debate whether they're true capability jumps or measurement artefacts. The benchmark question is active research.</li>
    <li><strong>Tool use extends them:</strong> calling search, code execution and APIs turns the model into an orchestrator — agentic systems. Reliability, cost and safety of those loops are the current engineering frontier (the alignment lesson continues the story).</li>
  </ul>
  <p class="sources"><strong>Sources:</strong> Vaswani et al., "Attention Is All You Need" (2017); Kaplan et al. (2020); Hoffmann et al., "Chinchilla" (2022); OpenAI GPT-4 technical report.</p>
</TopicPage>
