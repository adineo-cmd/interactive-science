      "bucket": 0
    },
    {
      "label": "trailing players receive better tools",
      "bucket": 1
    },
    {
      "label": "outcomes stay uncertain to the wire, quietly devaluing skill",
      "bucket": 1
    }
  ],
  "why": "Balancing these loops — often per game mode, since a tournament and a party night want opposite answers — is systems design at its most consequential, and no amount of content polish repairs a wrong loop."
};

const gdFairBranch = {
  "root": "You are balancing a four-person racing game. Two philosophies, two sessions.",
  "nodes": {
    "start": {
      "text": "Whose evening are you designing for?",
      "choices": [
        {
          "label": "The sport — the fastest racer should take every race",
          "next": "end",
          "feedback": "Fair rules, neutral outcome — and once the result is decided, three of the four people have stopped racing."
        },
        {
          "label": "The table — keep all four in contest to the last lap",
          "next": "end",
          "feedback": "Bend the outcome instead: best items to the losers, catch-up mechanics, comeback meters — a legitimate goal pure fairness would defeat."
        }
      ]
    },
    "end": {
      "text": "Fairness of the rules is different from neutrality of the outcome — the question is what each person feels, and for how long.",
