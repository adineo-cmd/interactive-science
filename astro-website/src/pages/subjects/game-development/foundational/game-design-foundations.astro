const gdPrototypeOrder = {
  "prompt": "Test the loop as cheaply as possible — sequence the ladder from cheapest to dearest:",
  "items": [
    "a deck of cards and a hallway — the loop run by hand",
    "a spreadsheet economy playtested at a lunch table",
    "grey boxes before any art",
    "an empty room with two cubes before a level",
    "the full build — art, code and engine work"
