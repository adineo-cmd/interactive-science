---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const mdaCfg = {
  steps: [
    { math: '1 · Mechanics', note: 'The rules and systems: jump height, resource costs, cooldowns. The only part the designer writes directly.' },
    { math: '2 · Dynamics', note: 'What the mechanics do when played: emergent chases, economies, betrayals. The designer shapes these indirectly.' },
    { math: '3 · Aesthetics', note: 'What the player feels: tension, mastery, camaraderie. The actual goal of the design — everything else is means.' },
    { math: '4 · Work backwards: A → D → M', note: 'Design by naming the feeling first, imagining the dynamics that create it, and only then choosing mechanics. MDA read backwards is a design method.' },
    { math: '5 · Prototype, then argue with the playtest', note: 'Paper prototypes expose the loop in minutes. Players will use your mechanics in ways you did not plan — that discovery is the work.' },
  ],
};

const loopCfg = {
  curves: [
    { expr: '100*(1 - exp(-0.7*x))', label: 'player mastery (a.u.)', color: '#0d9488', width: 2.4 },
    { expr: '12*x', label: 'challenge level', color: '#dc2626', width: 2.0 },
  ],
  x: { min: 0, max: 10, label: 'player experience (hours)' },
  y: { min: 0, max: 130, label: 'a.u.' },
  crossings: true,
  height: 330,
};

const gdNeighboursCompare = {
