};

const gdDocCloze = {
  "text": "Modern practice prefers living documents: a short concept statement, a description of the core loop, and just enough specified systems to build the next test. The document's job is not completeness but %%0%% — a team arguing about the same game. The single most useful sentence on any page is the core loop's, stated in %%1%%.",
  "answers": [
    [
