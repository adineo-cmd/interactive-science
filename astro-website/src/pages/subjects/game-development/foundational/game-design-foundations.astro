};

const gdFlowPlace = {
  "prompt": "Play stays absorbing only in one band of this scale — pin it:",
  "labels": [
    "boredom",
    "comfort",
    "the flow zone",
    "strain",
    "anxiety"
  ],
  "scale": {
    "min": 0,
    "max": 10
  },
  "answer": 5,
  "tolerance": 1,
  "why": "Where challenge slightly outruns skill, attention is demanded without anxiety; reverse the overrun and you get boredom on one side, frustration on the other."
};

const gdLoopsSort = {
  "prompt": "File each consequence under the loop that produces it:",
  "buckets": [
    "positive — amplifies a lead",
    "negative — punishes leading"
  ],
  "items": [
    {
      "label": "more income buys more income",
      "bucket": 0
