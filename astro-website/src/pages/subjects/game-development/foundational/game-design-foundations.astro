  },
  "why": "A film has conflict and outcome but no meaningful choices — it plays the same whether you watch closely or not. The sweet spot defining 'game' is a goal pursued through decisions under rules — Sid Meier's 'a series of interesting decisions'."
};

const gdCircleMatch = {
  "prompt": "Inside the agreed bubble, ordinary things carry extra meanings — pair them:",
