import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const systemsCfg = {
  steps: [
    { math: '1 · The airframe', note: 'Fuselage, wings, empennage — and the control surfaces: ailerons (roll), elevator (pitch), rudder (yaw). Three inputs, three axes.' },
    { math: '2 · Engine and propeller', note: 'Most trainers burn avgas in a four-stroke boxer engine driving a fixed-pitch prop. Throttle sets power; mixture leans for altitude.' },
    { math: '3 · The pitot-static system', note: 'Two sensors feed three instruments: the pitot tube\'s ram air drives the airspeed indicator; static vents drive altimeter and vertical speed.' },
    { math: '4 · Gyroscopic instruments', note: 'The attitude indicator and heading indicator run on spinning gyros — rigidity in space — historically engine-driven vacuum pumps.' },
    { math: '5 · The preflight inspection', note: 'Every flight starts on foot: fuel sample (water check), control freedom, tyres, surfaces. The walkaround is the pilot\'s first line of maintenance.' },
  ],
};

const asiAirframeMatch = {
