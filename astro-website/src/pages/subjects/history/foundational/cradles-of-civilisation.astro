---
import Layout from '../../../../layouts/Layout.astro';
import data from '../../../../data/topics.json';

const B = import.meta.env.BASE_URL.replace(/\/+$/, '') || '';
const { subjects, topics } = data;
const topic = topics.find((t) => t.slug === 'subjects/history/foundational/cradles-of-civilisation');
const subject = subjects.find((s) => s.id === topic.subject);
const seq = topics.filter((t) => t.status !== 'planned');
const idx = seq.indexOf(topic);
const prev = seq[(idx - 1 + seq.length) % seq.length];
const next = seq[(idx + 1) % seq.length];

const timelineCfg = {
  unit: 'year',
  events: [
    { year: -3200, title: 'Uruk — the first city', text: 'Irrigation canals in southern Mesopotamia feed a settlement of tens of thousands. Writing is invented here, to track grain and taxes.', tag: 'Mesopotamia' },
    { year: -3100, title: 'Egypt unifies', text: 'Upper and Lower Egypt join under the first pharaohs. The pyramid age follows within a few centuries.', tag: 'Egypt' },
    { year: -2600, title: 'Indus cities on a grid', text: 'Harappa and Mohenjo-daro are laid out with precise street grids and covered drains — urban planning ahead of its time.', tag: 'Indus' },
    { year: -1750, title: 'Hammurabi\u2019s code', text: 'Babylon\u2019s king inscribes 282 laws on a stone stele. Justice becomes a written, public thing.', tag: 'Mesopotamia' },
    { year: -1200, title: 'Bronze Age collapse', text: 'Drought, raids and cascading failures end palace economies across the Eastern Mediterranean within a single lifetime.', tag: 'Mediterranean' },
    { year: -550, title: 'The Achaemenid method', text: 'Cyrus\u2019 Persia runs the largest empire yet — on roads, provincial governors, and tolerated local customs.', tag: 'Mediterranean' },
    { year: -331, title: 'Alexander reaches Persepolis', text: 'The Greek and Persian worlds fuse, opening three centuries of Hellenistic exchange from Egypt to India.', tag: 'Mediterranean' },
    { year: -27, title: 'Rome becomes an empire', text: 'Augustus ends the republic. Roads, law and sea lanes knit three continents into one market.', tag: 'Mediterranean' },
    { year: 476, title: 'The west falls, the east persists', text: 'Odoacer deposes the last western emperor. The eastern half carries the Roman name for another thousand years.', tag: 'Mediterranean' },
  ],
};
---
<Layout title={`${topic.title} — ${subject.name} — Interactive Atlas`} description={topic.summary}>
  <div class="wrap">
    <div class="topic-grid">
      <aside class="topic-aside">
        <a class="back" href={`${B}/subjects/${subject.id}/`}>← all of {subject.name}</a>
        <dl>
          <dt>subject</dt><dd><span class="dot" style={`--dot:${subject.ink}; display:inline-block; margin-right:.4rem`}></span>{subject.name}</dd>
          <dt>level</dt><dd>{topic.level}</dd>
          <dt>time</dt><dd>{topic.minutes} min</dd>
          <dt>tags</dt><dd>{topic.tags.slice(0, 3).join(', ')}</dd>
        </dl>
      </aside>
      <article>
        <header class="topic-head">
          <p class="crumb"><a href={B + '/'}>atlas</a><span class="sep">/</span><a href={`${B}/subjects/${subject.id}/`}>{subject.name}</a><span class="sep">/</span>{topic.level}</p>
          <h1>{topic.title}</h1>
          <p class="lede">{topic.summary}</p>
        </header>

        <div class="topic-body">
          <h2>The idea</h2>
          <p>
            Civilisation is a chain reaction. Farming produces <strong>surplus food</strong>;
            surplus lets some people stop farming; specialists — scribes, smiths, priests,
            soldiers — build <strong>cities</strong>; cities need <strong>records, laws and
            rulers</strong>. Every cradle of civilisation, from the Nile to the Indus, runs the
            same sequence with local accents.
          </p>
          <p>
            Watch it happen. Drag the scrubber — everything to its right hasn't happened yet:
          </p>

          <figure class="widget">
            <figcaption><span class="fig-no">fig. 1</span><span>three and a half millennia, one scrubber — filter by region with the chips</span></figcaption>
            <div class="widget-body">
              <div data-widget="timeline" data-config={JSON.stringify(timelineCfg)}></div>
            </div>
          </figure>

          <h2>What to notice</h2>
          <ul>
            <li><strong>Writing starts boring.</strong> Cuneiform begins as accounting — receipts before poetry, everywhere.</li>
            <li><strong>Collapses are fast.</strong> The Bronze Age world took centuries to build and about a generation to unbuild.</li>
            <li><strong>Empires are logistics.</strong> Persia and Rome conquered less with swords than with roads, relays and tolerable tax codes.</li>
            <li><strong>Nothing fully ends.</strong> Rome "falls" in 476 CE while continuing in Constantinople; its law codes still shape ours.</li>
          </ul>

          <p>
            A timeline flattens all this, and that's the point: seeing the <em>sequence</em> is the
            first step to arguing about the <em>causes</em> — which is what the intermediate ladder
            of this subject will ask you to do.
          </p>
        </div>

        <nav class="topic-next" aria-label="Lesson navigation">
          <div><span class="tn-label">previous lesson</span><a href={`${B}/${prev.slug}/`}>{prev.title}</a></div>
          <div style="text-align:right"><span class="tn-label">next lesson</span><a href={`${B}/${next.slug}/`}>{next.title}</a></div>
        </nav>
      </article>
    </div>
  </div>
</Layout>
