const orderCfg = {
  steps: [
    { math: '1 · Identify the patient', note: 'Two identifiers, spoken by the patient, matched to the requisition. The single most safety-critical step in the whole procedure.' },
    { math: '2 · Select the vein', note: 'Median cubital vein first (median nerve away from surface), then cephalic, then basilic. Avoid the arm on the mastectomy side and IV sites.' },
    { math: '3 · Order of draw', note: 'Blood culture → light blue (citrate) → red (clot) → green (heparin) → lavender (EDTA) → grey (fluoride). Additives carry over on the needle — order prevents poisoned samples.' },
