};

const expSunnyOrder = {
  "prompt": "Assemble the exchange that melts a Sunny 16 landscape into a portrait:",
  "items": [
    "Sunny 16 baseline: bright daylight gives f/16 at 1/125 s with ISO 100 — no meter needed",
    "A portrait wants the background melted, so open to f/2.8 — four stops wider (f/16 → f/11 → f/8 → f/5.6 → f/4 → f/2.8)",
    "Pay it back on the shutter — four stops faster",
    "1/125 → 1/250 → 1/500 → 1/1000 → 1/2000 s: same bucket level, razor-thin focus and a dissolved background"
  ],
  "why": "The stop is the universal currency: give one dial four stops, pay it back on another — the exchange cashed the same light for different side effects."
};

const expDofMatch = {
  "prompt": "Depth of field answers to four levers — pair each with what it does:",
  "pairs": [
    {
      "left": "wider aperture (smaller f-number)",
      "right": "shallower focus — light cones from out-of-focus points are wider and blur faster"
    },
