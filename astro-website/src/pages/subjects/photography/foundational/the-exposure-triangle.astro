};

const expGreyJudge = {
  "statements": [
    {
      "s": "The camera's automatic exposure is an objective measurement of the scene.",
      "truth": false,
      "why": "It is an opinion with a fixed assumption — hardware is not what fails on extreme scenes; the assumption is."
    },
    {
      "s": "The meter's instruction is: make what I measure average out to middle grey.",
      "truth": true,
      "why": "Brilliant for average scenes, systematically wrong at the extremes — hence grey snow."
    },
    {
      "s": "A washed-out night shot means the camera is faulty and needs repair.",
      "truth": false,
      "why": "The fix is override, not repair — exposure compensation exists precisely because you know whether this scene should be grey."
    },
    {
      "s": "Pushing ISO to 6400 at a concert is compensating for ignorance.",
      "truth": false,
      "why": "Grain that preserves a moment beats noise-free blur of nothing — ISO is the escape dial, honoured rather than shamed."
    }
  ]
