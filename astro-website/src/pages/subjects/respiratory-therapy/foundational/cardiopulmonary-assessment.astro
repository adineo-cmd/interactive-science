const cpaExamSpot = {
  "prompt": "One line of this exam summary is wrong — click it:",
  "lines": [
    "Inspection: neck-muscle use and nostril flaring are distress signs; a barrel chest suggests hyperinflation.",
    "Palpation: tactile fremitus increases over consolidated lung, decreases over fluid.",
    "Percussion: hollow over normal lung, dull over consolidation or fluid, tympanic over pneumothorax.",
    "Crackles are the sound of narrowed airways — a harsh cousin of the wheeze.",
    "Auscultation: vesicular is normal; bronchial sounds are harsh and sit over consolidation."
  ],
  "errorLine": 3,
  "correction": "Crackles are fluid in the airways — oedema, pneumonia, fibrosis; wheezes are the narrowed-airway sound (asthma, COPD).",
  "why": "The added sounds also include the pleural friction rub — inflamed pleura grating. Dull percussion plus bronchial breath sounds plus crackles is pneumonia's signature long before the film."
};

const cpaLabsMatch = {
