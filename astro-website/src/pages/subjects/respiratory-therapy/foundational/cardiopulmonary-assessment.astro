const cpaBreathOrder = {
  "prompt": "From nose to elastic recoil — rebuild the path:",
  "items": [
    "Air enters the conducting airways — trachea, bronchi, bronchioles — warmed, humidified, filtered, exchanging no gas",
    "About 150 mL of anatomic dead space re-fills before anything fresh arrives",
    "Fresh air reaches the roughly 300 million thin-walled alveoli wrapped in capillaries",
    "Oxygen diffuses in and CO₂ diffuses out across a membrane under a micrometre thick",
    "The whole exchange completes in about a quarter of a second",
    "The diaphragm relaxes; elastic recoil pushes air back out"
  ],
  "why": "Contracting the diaphragm drops thoracic pressure so air flows in — which is why a patient whose lungs have lost elasticity (emphysema) must work to exhale."
};

const cpaVQSort = {
  "prompt": "Perfusion without ventilation, or ventilation without perfusion — file each:",
  "buckets": [
    "shunt — perfusion without ventilation",
    "dead space — ventilation without perfusion"
  ],
  "items": [
    {
      "label": "blood flowing past unventilated alveoli",
      "bucket": 0
    },
    {
      "label": "pneumonia, atelectasis",
      "bucket": 0
    },
    {
      "label": "hypoxaemia that resists oxygen",
      "bucket": 0
    },
    {
      "label": "air reaching unperfused alveoli",
      "bucket": 1
    },
    {
      "label": "pulmonary embolism",
      "bucket": 1
    },
    {
      "label": "the body's partial fix: blood steered away from poorly ventilated regions",
      "bucket": 0
    }
  ],
  "why": "That partial fix is hypoxic vasoconstriction. The gas exposes which side failed — ventilation or perfusion — which is why V/Q matching sits at the centre of the specialty."
};

const cpaCurvePlace = {
  "prompt": "On the flat top of the S-shaped oxyhaemoglobin curve, saturation stays high until arterial O₂ tension falls below roughly what?",
  "labels": [
    "0",
    "25",
    "50",
    "75",
    "100"
  ],
  "scale": {
    "min": 0,
    "max": 100
  },
  "answer": 60,
  "tolerance": 6,
  "why": "Below about 60 mmHg the curve turns steep — tissue-unloading territory. Acid, heat and CO₂ all shift the curve right (easier unloading), linking the two gases' transport."
};

const cpaHardJudge = {
  "statements": [
    {
      "s": "Breathing harder always raises PaO₂ meaningfully.",
      "truth": false,
      "why": "Oxygen uptake is perfusion-limited and haemoglobin-limited; blood bypassing the alveoli is not fixed by moving more air."
    },
    {
      "s": "Ventilation moves CO₂ fast, while oxygen uptake is limited by perfusion and haemoglobin.",
      "truth": true,
      "why": "That asymmetry is the physiology behind the trap — CO₂ responds to ventilation, oxygen does not, in shunt."
    },
    {
      "s": "A shunt patient breathing harder will raise PaO₂ only a little, at best.",
      "truth": true,
      "why": "The bypassed blood never meets fresh air — that is what makes shunt oxygen-resistant."
    },
    {
      "s": "The asymmetry is why the ABG can separately implicate the lungs (CO₂) and the metabolism (HCO₃⁻).",
