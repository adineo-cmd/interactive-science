        {
          "label": "Air — the lung has been pushed aside",
          "next": "air",
          "feedback": "Pneumothorax: air in the pleural space separates lung from chest wall — percussion tympanic, breath sounds and fremitus absent."
        },
        {
          "label": "Fluid — the space is filled",
          "next": "fluid",
          "feedback": "Large effusion (or haemothorax): dull to percussion, sounds absent, and the mediastinum can shift."
        },
        {
          "label": "The patient is anxious — nothing structural",
          "next": "anxious",
          "feedback": "Anxiety does not silence a chest. Falling pressure with absent sounds is an emergency pattern — assess, image, act."
        }
      ]
    },
    "air": {
      "text": "Tympanic percussion, absent sounds, falling pressure: tension physiology is on the table — decompression outranks everything else.",
      "choices": []
    },
    "fluid": {
      "text": "Dullness, absent sounds, decreased fremitus: the film will size it, and drainage follows the physiology, not the number alone.",
      "choices": []
    },
    "anxious": {
      "text": "The panel never supports ignoring a quiet chest — triangulate: examination, gas, imaging. Assessment is the therapy's aiming system.",
      "choices": []
