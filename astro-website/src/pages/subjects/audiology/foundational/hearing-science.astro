import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const eqCfg = {
  curves: [
    { expr: '20*log10(x/0.00002)', label: 'dB SPL re: 20 µPa', color: '#7c3aed', width: 2.2 },
  ],
  x: { min: 1, max: 100000, label: 'sound pressure (µPa, log positions)' },
  y: { min: 0, max: 140, label: 'dB SPL' },
  crossings: false,
  height: 330,
};

const hearingCfg = {
  steps: [
    { math: '1 · Sound: pressure in air', note: 'Vibrations create pressure waves. Intensity is measured in dB SPL against 20 µPa — the scale runs from a whisper (~30) to a jet (~140).' },
    { math: '2 · Outer ear: the collector', note: 'The pinna funnels sound down the canal and shapes direction cues; the canal itself resonates near 2.7 kHz, boosting speech frequencies.' },
    { math: '3 · Middle ear: the impedance match', note: 'Air is a bad match for fluid. Three tiny bones (malleus, incus, stapes) lever sound into the cochlea with about 22 dB of gain.' },
    { math: '4 · Cochlea: frequency to nerve', note: 'The basilar membrane is tonotopic — high frequencies at the base, low at the apex. Inner hair cells convert each place\'s motion into nerve spikes.' },
    { math: '5 · Beyond the ear', note: 'The auditory nerve and brainstem preserve frequency and timing maps all the way to cortex. Hearing loss is classified by where this chain breaks.' },
  ],
};

const hsDbEstimate = {
  "prompt": "A whisper sits at about 30 dB SPL; a jet engine at close range about 140 dB SPL. Roughly how many times greater is the jet's sound pressure?",
  "unit": "×",
  "answer": 10000000,
  "factor": 1.5,
  "why": "Ten million — the million-fold range between hearing threshold and pain compressed into ~110 decibels by 20·log₁₀(p / 20 µPa). +20 dB is a tenfold pressure increase; +10 dB is roughly a perceived doubling of loudness.",
  "context": "20 micropascals — roughly the pressure of a mosquito at three metres — defines 0 dB SPL: a reference level, not silence."
};

const hsChainOrder = {
  "prompt": "Each part solves a specific problem — order the links:",
  "items": [
    "outer ear — the pinna funnels and filters; the canal resonates near 2.7 kHz",
    "middle ear — three bones match air to fluid with about 22 dB of gain",
    "cochlea — the basilar membrane's tonotopic map; hair cells transduce",
    "auditory nerve and brainstem — frequency and timing maps preserved",
    "cortex — perception: loudness, pitch, picking a voice from a party"
  ],
  "why": "A physics problem, a mechanical problem, and an electrochemical problem in sequence — each stage specialised, each a place the system can break."
};

const hsEarMatch = {
  "prompt": "Three parts, three engineering fixes — pair them:",
  "pairs": [
    {
      "left": "the pinna",
      "right": "funnels sound and filters by elevation and direction — cues for 3-D localisation"
    },
    {
      "left": "the ear canal (2.5 cm tube)",
      "right": "resonates near 2.7 kHz, boosting exactly the consonant band"
    },
    {
      "left": "malleus, incus, stapes",
      "right": "a lever system bridging the air-to-fluid mismatch with ~22 dB of gain"
    },
    {
      "left": "stapedius and tensor tympani",
      "right": "stiffen the chain reflexively at loud sounds — too slow against impulsive noise"
    }
  ],
  "why": "Without the middle ear, over 99 per cent of the energy would reflect away at the air–fluid boundary — the same physics that makes a shout barely ripple a swimming pool."
};

const hsTonotopicPlace = {
  "prompt": "An 8 kHz tone's travelling wave peaks where along the basilar membrane?",
  "labels": [
    "apex — low Hz",
    "middle",
    "base — high Hz"
  ],
  "scale": {
    "min": 0,
    "max": 100
  },
  "answer": 100,
  "tolerance": 5,
  "why": "At the base: stiff and narrow there resonates high frequencies; wide and floppy at the apex for low. This tonotopic map is the single most important fact in the chapter — the audiogram's frequency axis is the cochlea's geography.",
  "context": "High-frequency losses cost consonant clarity first — noise damage writes its 4 kHz notch in the basal region."
};

const hsHairBuckets = {
  "prompt": "One row transduces; three rows amplify. File each fact:",
  "buckets": [
    "Inner hair cells",
    "Outer hair cells"
  ],
  "items": [
    {
      "label": "one row — transduce motion into nerve spikes",
      "bucket": 0
    },
    {
      "label": "bending stereocilia open ion channels",
      "bucket": 0
    },
    {
      "label": "three rows — actively amplify and sharpen the travelling wave",
      "bucket": 1
    },
    {
      "label": "make the cochlea a powered, not passive, microphone",
      "bucket": 1
    },
    {
      "label": "their faint emissions (OAEs) screen newborn hearing",
      "bucket": 1
    }
  ],
  "why": "Damage to the active amplifier distorts, compresses and smears — which is why sensorineural loss is not just 'quieter' and no simple amplification fully restores it."
};

const hsActiveJudge = {
  "statements": [
    {
      "s": "The cochlea actively edits: outer hair cells boost weak signals and compression handles an enormous dynamic range.",
      "truth": true,
      "why": "Frequency-sharp, level-dependent amplification produces ~120 dB of dynamic range despite individually limited hair cells."
    },
    {
      "s": "The ear hears the way a microphone records.",
      "truth": false,
      "why": "It is a powered analyser, not a passive one — the brain performs pattern analysis on an already-edited signal."
    },
    {
      "s": "Sensorineural loss is not just 'quieter' — it distorts, compresses and smears.",
      "truth": true,
      "why": "Damage to the active amplifier destroys the graceful compression, producing recruitment: loudness growing abnormally fast."
    },
    {
      "s": "Simple amplification fully restores what a damaged cochlea lost.",
      "truth": false,
      "why": "No hearing aid rebuilds the cochlea's level-dependent compression — which is why aggressive aid compression must be fitted carefully."
    }
  ]
};

const hsLoudnessCompare = {
  "prompt": "Equal loudness, unequal physics — drag between the two tones:",
  "before": {
    "label": "A 40 Hz tone",
    "text": "Needs far more pressure to sound equally loud — at low levels the ear is nearly deaf to deep bass."
  },
  "after": {
    "label": "A 2 kHz tone",
    "text": "Needs far less pressure for the same loudness — the canal's 2.7 kHz resonance lands right in this band."
  },
  "why": "Equal-loudness contours capture the ear's frequency-varying sensitivity — which is why equal-dB losses feel unequal across pitches, and why hearing aids are fitted per frequency band."
};

const hsAidBranch = {
  "root": "A patient has a high-frequency slope on the audiogram. You are programming the hearing aids.",
  "nodes": {
    "start": {
      "text": "How do you amplify?",
      "choices": [
        {
          "label": "Amplify everything uniformly",
          "next": "uniform",
          "feedback": "Simple — and wrong for the frequency map."
        },
        {
          "label": "Amplify only where the loss lives, per frequency band",
          "next": "perband",
          "feedback": "The standard fitting."
        },
        {
          "label": "Skip the highs — vowels carry the energy anyway",
          "next": "lows",
          "feedback": "The tempting error."
        }
      ]
    },
    "uniform": {
      "text": "Vowels (250–1,000 Hz) already arrive loudly; uniform gain overdrives healthy regions and distorts — the audiogram's slope is a per-band prescription.",
      "choices": []
    },
    "perband": {
      "text": "Amplifying only where the loss lives, leaving healthy regions alone: draw the patient's thresholds over the speech banana and the conversation becomes a picture of which sounds they are missing.",
      "choices": []
    },
    "lows": {
      "text": "Energy is not information: strip the consonants (4–8 kHz — the /s/ of 'six', the /f/ of 'five') and the vowel frames collapse together — clarity dies while loudness survives.",
      "choices": []
    }
  },
  "why": "Speech does not spread its information evenly across the frequency axis — consonants are the information-bearing workhorses, and they live where the loss is."
};
---
<TopicPage slug="subjects/audiology/foundational/hearing-science">
  <h2>Where you are, and what you will learn</h2>
  <p>
    This is the beginner lesson of Audiology. You need zero prior knowledge — no physics,
    no anatomy, no clinical jargon. We start with a hum you can feel in your own throat,
    and follow the sound all the way into the brain.
  </p>
  <p>By the end of this lesson you will be able to:</p>
  <ul>
    <li>say what sound physically is, and describe it with frequency and intensity;</li>
    <li>use the decibel scale without tripping over its logarithmic traps;</li>
    <li>walk through the ear's three parts and the specific problem each one solves;</li>
    <li>explain how the cochlea turns place of vibration into pitch, and why that fact shapes the whole clinic;</li>
    <li>say why consonants, not vowels, decide whether speech is understood.</li>
  </ul>
  <p>
    Every new term is explained the moment it appears. Take your time — one idea per
    paragraph.
  </p>

  <h2>Start with a hum</h2>
  <p>
    Hum quietly and rest your fingers on your throat. You feel a buzz. That buzz is your
    vocal folds vibrating — shaking the air around them. Now put your fingers gently in
    your ears while you hum: the buzz gets louder inside your head. You have just met the
    three characters of this lesson: a vibrating source, a medium to travel through, and an
    ear to catch it.
  </p>
  <p>
    Audiology is built on hearing science: what sound physically is, how the ear converts
    it into nerve signals, and where in that chain things fail. Hearing feels effortless —
    a conversation simply arrives — but it is the end product of a physics problem (a
    pressure wave travelling through air), a mechanical problem (channelling that wave from
    a thin gas into salt water without losing it), and an electrochemical problem
    (converting motion into nerve spikes the brain can read). Each stage is specialised,
    and each is a place where the system can break.
  </p>
  <p>
    Why does an audiologist need this physics and anatomy? Because every clinical fact is a
    map drawn over it. An audiogram — the standard chart of hearing — is not an abstract
    chart: its frequency axis is the cochlea's geography, and its thresholds measure which
    parts of that geography answer the bell. The classification of hearing loss —
    conductive, sensorineural, mixed — is literally a diagnosis of <em>which link
    broke</em>: outer or middle ear (sound never arrives properly), cochlea or nerve (sound
    arrives but is never converted), or both. Presbycusis's high-frequency slope, noise
    damage's 4 kHz notch, otosclerosis's air–bone gap — each is anatomy and physics showing
    up in a measurement.
  </p>
  <p>
    This page walks the chain in the order sound experiences it: the physics of pressure
    waves, the anatomy that captures and transduces them, and the psychoacoustics — the
    perception layer where measurements become experiences like loudness, pitch and the
    ability to pick a voice out of a party. Together they form the vocabulary every later
    clinical unit assumes.
  </p>

  <Widget no="1" caption="the auditory chain, ear to cortex" widget="equationStep" config={hearingCfg} />
  <p>
    <strong>What to notice:</strong> press "Walk me through it" and reveal the five links one
    at a time — pressure waves in air, the outer ear's collection, the middle ear's
    air-to-fluid match, the cochlea's place-to-pitch conversion, and the pathway beyond. Each
    note names the specific problem that link solves, and the sections below take the same
    chain in the same order, so the widget doubles as the lesson's map.
  </p>

  <h2>Physics of sound</h2>
  <p>
    Sound is organised vibration travelling through a medium — usually air. A vibrating
    object (a guitar string, a vocal fold) pushes and pulls the air around it, creating
    alternating zones of compression and rarefaction (squeezed air and stretched air) that
    propagate outward as a pressure wave.
  </p>
  <p>
    Two quantities describe most of what the ear does with that wave.
    <strong>Frequency</strong> is the number of compression cycles per second, measured in
    hertz (Hz), and it is heard as pitch. <strong>Intensity</strong> is the pressure
    amplitude of the wave, heard as loudness. Human hearing spans roughly 20 Hz to 20,000
    Hz — a piano keyboard's lowest note sits near 27 Hz and its top near 4,200 Hz, but
    harmonics well above speech's fundamentals carry its brightness.
  </p>
  <p>
    The intensity scale is the first numerical habit to build. Sound pressure spans a
    million-fold range between the threshold of hearing and the threshold of pain, so it is
    compressed logarithmically into decibels: dB SPL = 20·log₁₀(p / 20 µPa). Here 20
    micropascals — roughly the pressure of a mosquito at three metres — defines 0 dB SPL.
    Consequences to internalise: +6 dB is a doubling of <em>pressure</em>, +20 dB is a
    tenfold pressure increase, +10 dB is roughly a perceived doubling of
    <em>loudness</em>, and the difference between a whisper (about 30 dB SPL) and a jet
    engine at close range (about 140 dB SPL) is a factor of ten million in pressure. The
    curve below plots pressure against its decibel value — the log scale is what makes that
    range plottable at all.
  </p>
  <Widget no="3" caption="call the magnitude — whisper to jet" widget="estimate" config={hsDbEstimate} />

  <Widget no="2" caption="sound pressure converted to the decibel scale" widget="plotter" config={eqCfg} />
  <p>
    <strong>What to notice:</strong> hover along the curve: every tenfold jump in sound
    pressure adds the same 20 dB, so on this compressed axis the conversion draws a straight
    line. That straightness is the logarithm doing its work — a million-fold pressure range
    fits into about 120 dB, which is how one chart can hold a whisper and a jet engine.
  </p>

  <p>
    <em>Common misconception:</em> 0 dB means silence. Zero on a logarithmic scale means "at
    reference level", not "nothing" — and negative dB SPL is a perfectly meaningful (inaudible)
    pressure. The decibel is a ratio, never an absolute quantity by itself.
  </p>
  <p>
    <strong>So far:</strong> sound is a pressure wave, described by frequency (pitch) and
    intensity (loudness), with intensity measured in logarithmic decibels. Now: how does a
    wave in air become a thought?
  </p>

  <h2>Anatomy of the auditory system</h2>
  <p>
    The ear is conventionally taught in three parts, and each part solves a specific
    problem. The <strong>outer ear</strong> — pinna and ear canal — is a collector and a
    signal processor. The pinna's folds funnel sound and, crucially, filter it differently
    depending on elevation and direction, giving the brain cues for locating sound in three
    dimensions. The canal, a tube about 2.5 cm long, resonates near 2.7 kHz and boosts
    exactly the frequency band where speech consonants live — one reason that band matters
    so much for intelligibility.
  </p>
  <Widget no="4" caption="rebuild the chain, in the order sound experiences it" widget="order" config={hsChainOrder} />
  <p>
    The <strong>middle ear</strong> solves an impedance problem — the technical name for a
    mismatch between two materials trying to pass a vibration across. Sound in air meets
    the fluid of the inner ear, and without help over 99 per cent of the energy would
    reflect away: the same physics that makes a shout over a swimming pool barely ripple
    the water. Three tiny bones (malleus, incus, stapes — the body's smallest) form a lever
    system, and the eardrum's area concentrating onto the stapes footplate's much smaller
    area multiplies the pressure. Together these match the air-to-fluid transition with
    about 22 dB of gain. Two muscles (stapedius and tensor tympani) stiffen the chain
    reflexively at loud sounds — a dampener, though too slow against impulsive noise.
  </p>
  <Widget no="5" caption="pair each ear part with the problem it solves" widget="match" config={hsEarMatch} />
  <p>
    The <strong>inner ear</strong> is where mechanics become biology. The snail-shaped
    cochlea contains the basilar membrane, whose stiffness varies along its length: stiff
    and narrow at the base (resonating with high frequencies), wide and floppy at the apex
    (low frequencies). A sound entering the cochlea sets up a travelling wave that peaks at
    the place matching its frequency — the ear is a biological frequency analyser, and this
    <em>tonotopic</em> map is the single most important fact in the chapter.
  </p>
  <Widget no="6" caption="pin the peak on the tonotopic map" widget="place" config={hsTonotopicPlace} />
  <p>
    Resting on the membrane sits the organ of Corti with its hair cells. One row of
    <strong>inner hair cells</strong> transduces motion into nerve spikes (each bending of
    their stereocilia opens ion channels). Three rows of <strong>outer hair cells</strong>
    actively amplify and sharpen the travelling wave — the cochlea is not a passive
    microphone but a powered one. From there the auditory nerve and brainstem preserve
    frequency and timing maps all the way to the cortex.
  </p>
  <Widget no="7" caption="file the facts — inner or outer hair cells?" widget="sort-buckets" config={hsHairBuckets} />
  <p>
    <em>Common misconception:</em> the ear "hears" the way a microphone records. The cochlea
    actively edits: outer hair cells boost weak signals, compression handles an enormous
    dynamic range, and the brain performs pattern analysis on the result. This is why sensorineural
    loss is not just "quieter" — damage to the active amplifier distorts, compresses and
    smears, which no simple amplification fully restores.
  </p>
  <Widget no="8" caption="true or false — the active cochlea" widget="judge" config={hsActiveJudge} />
  <p>
    <strong>So far:</strong> a collector (outer ear), a lever that matches air to water
    (middle ear), and a powered frequency analyser (cochlea) — each link a place the chain
    can break. Next: how those mechanics become experiences.
  </p>

  <h2>Psychoacoustics: from physics to perception</h2>
  <p>
    Psychoacoustics measures the mapping between physical quantities and experiences. Three
    mappings carry most clinical weight. <strong>Loudness</strong> is not intensity: the
    ear's sensitivity varies with frequency, captured in equal-loudness contours. At low
    levels the ear is nearly deaf to deep bass — a 40 Hz tone needs far more pressure than
    a 2 kHz tone to sound equally loud. This is why hearing losses of equal dB feel unequal
    across pitches, and why hearing aids are fitted per frequency band.
  </p>
  <Widget no="9" caption="drag the divider — two tones, equal loudness" widget="compare" config={hsLoudnessCompare} />
  <p>
    <strong>Pitch</strong> follows frequency but reads the tonotopic place code and timing
    together. Damage to a cochlear region removes its pitch range, which is why
    high-frequency loss costs consonant clarity before it costs "hearing".
    <strong>Masking</strong> — one sound raising the threshold of another — is the everyday
    experience of not hearing someone talk over the dishwasher. Its clinical use is
    profound, because masking noise in the non-test ear is what makes threshold measurement
    honest.
  </p>
  <p>
    Binaural hearing adds the spatial layer. The brain localises sound using interaural
    time differences (about 0.6 ms maximum, precise for low frequencies) and level
    differences (heads shadow high frequencies), plus the pinna's spectral cues for height.
    This is why two hearing aids beat one for understanding speech in noise, and why
    unilateral loss is a real disability even with a normal other ear — the brain's
    noise-separation engine needs two inputs.
  </p>

  <h2>From sound to speech</h2>
  <p>
    Why does the frequency axis matter so much clinically? Because speech does not spread
    its information evenly across it. Vowels are low-frequency events (their energy sits
    mostly around 250–1,000 Hz) and are loud and easy to hear. Consonants — the
    information-bearing workhorses of intelligibility — live largely in the higher bands
    (the /s/ of "six", the /f/ of "five", the /θ/ of "thin" cluster around 4–8 kHz) and are
    quieter.
  </p>
  <p>
    The consequences run through audiology. A patient with a high-frequency loss hears
    that people are talking but cannot tell "fit" from "sit" from "thick", and often
    reports "everyone mumbles" — a perfect description of what a slope in the audiogram
    does to the frequency importance map. It is also why hearing aids are programmed per
    frequency band (amplifying only where the loss lives, leaving healthy regions alone),
    and why the speech banana — the overlay showing where speech's frequencies and levels
    fall on the audiogram — is one of the field's standard counselling tools. Draw the
    patient's thresholds over it and the conversation about their hearing becomes a picture
    of which sounds they are missing.
  </p>
  <Widget no="10" caption="fit the aids — three programming philosophies" widget="branch" config={hsAidBranch} />
  <p><em>Common misconception:</em> vowels must carry intelligibility because they are the loud, energetic part of speech. Energy is not information — strip the consonants and "fit", "sit" and "thick" collapse into the same vowel frame. That is exactly why a high-frequency loss can leave a patient hearing that people are talking while destroying the clarity, and why counselling starts from where speech's information lives on the audiogram rather than from loudness alone.</p>

  <h2>Check yourself</h2>
  <p>Try these before moving on. The answers are right below.</p>
  <ol>
    <li>Why would over 99 per cent of sound energy reflect away at the air–fluid boundary if the middle ear did nothing?</li>
    <li>A patient has normal hearing for vowels but confuses "fit", "sit" and "thick". What kind of loss does this suggest, and why?</li>
    <li>What does 0 dB SPL actually mean?</li>
  </ol>
  <p>
    <strong>Answers:</strong> (1) Air and fluid are badly matched for carrying vibration —
    the middle ear's lever bones and area ratio bridge the mismatch with about 22 dB of
    gain. (2) A high-frequency loss: consonants carry the intelligibility and live around
    4–8 kHz, so the ear catches the loud vowels but loses the information. (3) Sound
    pressure at the reference level of 20 micropascals — not silence; decibels are ratios
    against a reference.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>Sound is organised vibration: frequency (hertz) is heard as pitch, intensity as loudness.</li>
    <li>Decibels are logarithmic ratios against 20 micropascals — 0 dB SPL is a reference level, not silence.</li>
    <li>The outer ear collects and filters, the middle ear bridges the air-to-fluid mismatch with about 22 dB of gain, and the cochlea converts place of vibration into pitch.</li>
    <li>The tonotopic map — high frequencies at the base, low at the apex — is the single most important fact in the chapter.</li>
    <li>The cochlea is an active, powered organ: damage distorts and compresses, it does not merely quieten.</li>
    <li>Consonants carry intelligibility and live in the high frequencies, which is why a high-frequency loss reports itself as "everyone mumbles".</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    With the chain mapped link by link, the next units follow what happens when each one
    breaks — the types and causes of hearing loss — and how the clinic measures the damage in
    diagnostic audiology, along with the vestibular half of the inner ear. Every audiogram
    convention you will meet there is this lesson's anatomy and physics redrawn as a chart.
  </p>

  <h2>Going deeper</h2>
  <p>
    <strong>The active cochlea explains the clinic's signature findings.</strong> Outer hair
    cells' amplification is frequency-sharp and level-dependent — strong for quiet sounds,
    backing off for loud ones — which produces the cochlea's enormous ~120 dB dynamic range
    despite hair cells being individually limited. When outer hair cells die (noise, ageing,
    ototoxic drugs), thresholds rise and that graceful compression is lost:
    <em>recruitment</em> — loudness growing abnormally fast once sound exceeds the damaged
    threshold — is the classic perceptual consequence, and it is why aggressive hearing-aid
    compression must be fitted carefully.
  </p>
  <p>
    <strong>The 4 kHz notch is anatomy you can read.</strong> Noise-induced loss characteristically
    dips near 3–6 kHz, deepest around 4 kHz: the canal's resonance focuses energy there, and
    the basal region of the cochlea is most metabolically vulnerable. A notch with recovery at
    8 kHz is so characteristic that it identifies a noise history from the audiogram alone.
    Similarly, otoacoustic emissions — faint sounds the healthy cochlea itself emits, produced
    by the outer hair cells — give clinicians a pre-neural, cochlea-specific test used in
    newborn hearing screening: evidence that the "active ear" model is not just theory but a
    clinical instrument.
  </p>
  <p>
    <strong>Central processing extends the chain past the nerve.</strong> Brainstem responses
    (the ABR) time-lock to stimulus features within milliseconds and let clinicians estimate
    thresholds in patients who cannot respond; cortical processing handles scene analysis —
    separating sources, exploiting attention. A frontier called "hidden hearing loss" proposes
    that some patients with normal audiograms have damaged synapses between hair cells and
    nerve fibres, degrading speech-in-noise performance while sparing pure-tone thresholds —
    a reminder that the audiogram, powerful as it is, samples the chain rather than exhausting
    it. Later units add the vestibular half of the inner ear and full diagnostic audiology, but
    every test on the clinic floor stands on the anatomy and physics this lesson maps.
  </p>
  <p>
    <strong>One scale footnote that prevents endless confusion: dB SPL versus dB HL.</strong>
    This page defined dB SPL against a fixed physical reference (20 µPa); the clinical
    audiogram, however, is printed in dB <em>HL</em> (hearing level), a per-frequency scale
    whose zero has been shifted so that 0 dB HL is the <em>average normal-hearing
    threshold</em> at each frequency — absorbing the ear's own sensitivity curve so that a
    normal audiogram reads flat across the top. The two scales differ by a frequency-specific
    offset (largest in the low frequencies and around 6 kHz, where human hearing is
    especially sharp or variable). The practical rule: physical acoustics is measured in dB
    SPL, clinical results are reported in dB HL, and every calibration and counselling step
    in audiology involves knowing which scale a number belongs to — a small footnote that is
    really the whole physics-versus-clinic bridge in one table.
  </p>

  <p class="sources"><strong>Sources:</strong> ASHA/CAA accreditation standards; Pickles, <em>An Introduction to the Physiology of Hearing</em>; Musiek &amp; Baran, <em>The Auditory System</em>. Source text: OpenStax (https://openstax.org), CC BY 4.0 — adapted for Interactive Atlas.</p>
</TopicPage>
