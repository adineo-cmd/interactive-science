---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const parabCfg = {
  curves: [
    { expr: 'a*x^2 + b*x + c', label: 'y = a·x² + b·x + c', color: '#7c3aed', width: 2.4 },
    { expr: '0', label: 'y = 0', color: 'rgba(23,36,32,0.45)', width: 1.2 },
  ],
  params: [
    { name: 'a', label: 'a', min: -3, max: 3, step: 0.1, value: 1 },
    { name: 'b', label: 'b', min: -6, max: 6, step: 0.5, value: 0 },
    { name: 'c', label: 'c', min: -6, max: 6, step: 0.5, value: -3 },
  ],
  x: { min: -6, max: 6, label: 'x' },
  y: { min: -8, max: 8, label: 'y' },
  crossings: true,
  height: 380,
};

const squareCfg = {
  steps: [
    { math: 'x² + 6x − 7 = 0', note: 'A quadratic to solve. The strategy: build a perfect square on the left.' },
    { math: 'x² + 6x + 9 = 7 + 9', note: 'Add (b/2)² = 9 to both sides — half of 6, squared. Completing the square.' },
    { math: '(x + 3)² = 16', note: 'The left side is now a perfect square. This is the vertex form: a(x − h)² + k with vertex at (−3, −16).' },
    { math: 'x + 3 = ±4 → x = 1, −7', note: 'Two real roots. Check the discriminant: b² − 4ac = 36 + 28 = 64 > 0 — two roots, as promised.' },
  ],
};

const tangCfg = {
  curves: [
    { expr: 'a*x^2 + b*x + c', label: 'the parabola', color: '#7c3aed', width: 2.4 },
    { expr: '(2*a*t + b)*(x - t) + (a*t^2 + b*t + c)', label: 'tangent at x = t', color: '#b42318', width: 1.6 },
  ],
  params: [
    { name: 'a', label: 'a', min: -3, max: 3, step: 0.1, value: 1 },
    { name: 'b', label: 'b', min: -6, max: 6, step: 0.5, value: 0 },
    { name: 'c', label: 'c', min: -6, max: 6, step: 0.5, value: 0 },
    { name: 't', label: 'touch point x = t', min: -4, max: 4, step: 0.1, value: 2 },
  ],
  x: { min: -6, max: 6, label: 'x' },
  y: { min: -8, max: 8, label: 'y' },
  crossings: false,
  height: 340,
};

const quadDialMatch = {
  "prompt": "The parabola y = a·x² + b·x + c has three dials — pair each with its role:",
  "pairs": [
    {
      "left": "a",
      "right": "how fast the bowl opens — its sign decides up or down"
    },
    {
      "left": "b",
      "right": "tilts the axis of symmetry off centre"
    },
    {
      "left": "c",
      "right": "where the curve starts on the y-axis"
    }
  ],
  "why": "Slide a to exactly 0 and the parabola degenerates into a straight line — a quadratic is a linear function with one extra term, and the extra term is where all the new behaviour lives."
};

const quadToolSort = {
  "prompt": "File each claim under the solving tool it describes:",
  "buckets": [
    "factorising",
    "completing the square",
    "the formula"
  ],
  "items": [
    {
      "label": "fastest when it works — the roots leap out in one line",
      "bucket": 0
    },
    {
      "label": "always works, and yields the vertex form as a free gift",
      "bucket": 1
    },
    {
      "label": "completing the square done once, for every quadratic at once",
      "bucket": 2
    },
    {
      "label": "the right tool when the question also asks for the vertex",
      "bucket": 1
    }
  ],
  "why": "Each tool has its moment: try factorising first, check the discriminant before computing, and complete the square when the vertex is wanted."
};

const quadFactorCloze = {
  "text": "The search rule for x² + 6x − 7: look for two numbers that multiply to %%0%% and add to %%1%% — here +7 and −1 — and the roots leap out as x = 1 or x = −7.",
  "answers": [
    [
      "−7",
      "-7"
    ],
    [
      "6",
      "b"
    ]
  ],
  "hint": "The constant term, and the middle coefficient."
};

const quadSignSpot = {
  "prompt": "One of these claims about square-rooting is wrong — click it:",
  "lines": [
    "From (x + 3)² = 16, the answers are x + 3 = +4 and x + 3 = −4.",
    "Both 4 and −4 square to 16.",
    "The squaring step genuinely destroyed information.",
    "Dropping the minus sign loses no roots — the negative root is extraneous."
  ],
  "errorLine": 3,
  "correction": "Dropping the minus loses half the roots — the single most common quadratic error.",
  "why": "Both signs fed the same square, so both must be kept; the ± means two answers unless the discriminant says otherwise."
};

const quadDiscBranch = {
  "root": "For y = x² + 2x + 5, the discriminant is 4 − 20 = −16. How many real roots?",
  "nodes": {
    "start": {
      "text": "Count the crossings:",
      "choices": [
        {
          "label": "Two — every quadratic has two roots",
          "next": "two",
          "feedback": "No: a negative number has no real square root — the parabola floats entirely above the axis, with no crossings."
        },
        {
          "label": "None — the curve never touches the axis",
          "next": "none",
          "feedback": "Right — and it is information, not error: a bridge deck's load curve that never crosses zero is the discriminant keeping the bridge up."
        },
        {
          "label": "One — the vertex touches zero",
          "next": "one",
          "feedback": "One root needs the discriminant exactly 0 — the repeated root sitting at the vertex."
        }
      ]
    },
    "two": {
      "text": "Two roots need a positive discriminant — two real crossings."
    },
    "none": {
      "text": "Verify the arithmetic, then let the sign tell you the geometry."
    },
    "one": {
      "text": "y = x² − 4x + 4 = (x − 2)² is the zero-discriminant case: it kisses the axis at x = 2."
    }
  },
  "why": "The discriminant b² − 4ac counts the crossings before you compute — the arithmetic shadow of the geometry."
};

const quadVertexEst = {
  "prompt": "For y = x² − 4x + 3, the roots are 1 and 3 and the vertex lies midway between them. At what x does the vertex sit?",
  "unit": "",
  "answer": 2,
  "factor": 1.2,
  "why": "x = −b/2a = 2, where y = 4 − 8 + 3 = −1 — four facts, one smooth symmetric bowl.",
  "context": "it crosses the y-axis at c = 3 and opens up (a = 1)"
};

const quadProfitPredict = {
  "q": "Profit is P = −2x² + 120x − 1,000, with vertex at x = 30. Because a is negative, that vertex is…",
  "choices": [
    "a maximum — 800 in profit at 30 units",
    "a minimum — the worst point to sell",
    "meaningless — a cannot be negative"
  ],
  "answer": 0,
  "why": "A negative a makes a hill: the bowl opens down, so the vertex is a maximum. Calling x = 30 the 'minimum profit' would invert the entire business decision."
};

const quadTangentPlace = {
  "prompt": "For y = x², at what x is the tangent exactly horizontal?",
  "labels": [
    "−4",
    "−2",
    "0",
    "2",
    "4"
  ],
  "scale": {
    "min": -4,
    "max": 4
  },
  "answer": 0,
  "tolerance": 0.2,
  "why": "The gradient 2a·x + b is zero at the vertex — the flattest point of a parabola is a single instant, not a flat section."
};

const quadBallOrder = {
  "prompt": "Rebuild the analysis of h = 20t − 4.9t² — what comes first:",
  "items": [
    "Set h = 0: t(20 − 4.9t) = 0",
    "Read the roots: t = 0 (the throw) and t ≈ 4.08 s (the landing)",
    "Vertex at t = −b/2a ≈ 2.04 s — exactly half the flight",
    "Velocity at the top is zero — the tangent is horizontal"
  ],
  "why": "Roots are launch and landing, the vertex is the apex, the symmetry axis is mid-flight: quadratics model anything with constant acceleration."
};

const quadDivideSpot = {
  "prompt": "One of these claims about the x² = 3x trap is wrong — click it:",
  "lines": [
    "Dividing both sides by x lands on a correct half-answer: x = 3.",
    "The division silently assumes x is not zero.",
    "x = 0 is a genuine solution — the other half of the truth.",
    "Dividing by x is fine here because the equation is quadratic."
  ],
  "errorLine": 3,
  "correction": "Never divide by the thing you are solving for — factor out instead: x(x − 3) = 0 gives both answers, 0 and 3.",
  "why": "Quadratics punish shortcuts; they reward the checklist."
};
---
<TopicPage slug="subjects/math/foundational/quadratics">

  <h2>Where you are, and what you will learn</h2>
  <p>
    This lesson sits right after the one on linear functions, and it answers the question that
    lesson left open: what happens when change is not constant? You will need the earlier ideas —
    gradient as rate of change, solving equations by doing the same thing to both sides — and
    nothing more. Everything else is built here.
  </p>
  <p>By the end you will be able to:</p>
  <ul>
    <li>explain what makes a function quadratic — the squared term — and read the three numbers a, b and c as the parabola's three dials;</li>
    <li>solve quadratic equations three ways — factorising, completing the square, and the formula — and know when to reach for each;</li>
    <li>use the discriminant b² − 4ac to count the solutions before doing any work;</li>
    <li>find a parabola's vertex and axis of symmetry and sketch any quadratic from four facts;</li>
    <li>describe the gradient of a curve at a point, and explain why a parabola's gradient grows linearly;</li>
    <li>carry a quadratic through a full modelling problem — a ball thrown in the air, a profit maximised.</li>
  </ul>
  <p>
    One habit: every formula on this page will be read as a sentence about the picture before it
    is used as a computation. The picture is the meaning; the formula is the shorthand.
  </p>

  <h2>From constant change to constantly accelerating change</h2>
  <p>
    A linear function promises constant change: every step right adds the same amount. But hardly
    anything in the world changes at a constant rate. A thrown ball covers more distance each
    second it falls; a growing square garden gains more area with every metre you add to the side.
    Quadratics are the mathematics of this second kind of change: <em>constant acceleration</em> of
    the change — each step right adds more than the last, and the "more" is the same increment
    every time. That is why anything thrown, dropped, braked or orbiting traces their curve:
    gravity adds the same velocity every second, and a position that gathers speed evenly is a
    quadratic in time. The square garden is the other ancestor — area equals side length squared —
    and it is the one that named the family.
  </p>
  <p>
    The graph is a <strong>parabola</strong>: a symmetric bowl, fully described by three numbers
    in <code>y = a·x² + b·x + c</code>. Read them as dials. <code>a</code> sets how fast the bowl
    opens — its sign decides whether the bowl faces up or down. <code>b</code> tilts the axis of
    symmetry off centre. <code>c</code> is where the curve starts on the y-axis. One more thing the
    dials reveal: slide <code>a</code> to exactly 0 and the parabola degenerates into a straight
    line. A quadratic is not a different species from a linear function — it is a linear function
    with one extra term, and the extra term is where all the new behaviour lives.
  </p>
  <Widget no="13" caption="pair each dial with what it sets" widget="match" config={quadDialMatch} />

  <Widget no="1" caption="the circled points are the roots — set a = 0 and the parabola degenerates into a line" widget="plotter" config={parabCfg} />

  <p>
    <strong>What to notice:</strong> the hollow markers where the curve crosses the dashed zero
    line are the <strong>roots</strong> — the solutions of the quadratic, the x-values that make
    the expression zero. Slide <code>a</code> to 0 and the markers survive (a line still crosses
    the axis once), but the curvature is gone. Slide <code>c</code> upward until the bowl lifts
    clear of the axis: the markers vanish. That disappearance is exactly what the discriminant
    measures, and we will make it precise below.
  </p>
  <p>
    <strong>So far:</strong> a quadratic is a squared term plus a line, its picture is a symmetric
    bowl, and its roots are the crossings. Solving means finding those crossings — with three
    tools.
  </p>

  <h2>Solving quadratics: three tools for one job</h2>
  <p>
    Solving <code>ax² + bx + c = 0</code> means finding the roots, and you own three tools, each
    with its moment. <strong>Factorising</strong> is fastest when it works: x² + 6x − 7 =
    (x + 7)(x − 1), and since a product is zero only when a factor is zero, the roots leap out as
    x = 1 or x = −7. The search rule: look for two numbers that multiply to c and add to b — here
    +7 and −1 — and you are done in one line. Not every quadratic factorises over whole numbers,
    which is why the other two tools exist.
  </p>
  <Widget no="12" caption="file each claim under its tool" widget="sort-buckets" config={quadToolSort} />
  <Widget no="11" caption="fill the blanks — the factorising search rule" widget="cloze" config={quadFactorCloze} />
  <p>
    <strong>Completing the square</strong> is the honest, always-works method — turning any
    quadratic into a perfect square plus a remainder, which simultaneously solves it and reveals
    its shape:
  </p>

  <Widget no="2" caption="solving one honestly — completing the square" widget="equationStep" config={squareCfg} />

  <p>
    <strong>What to notice:</strong> step 2 adds the same thing to both sides — the balance rule
    from the equations lesson, nothing new. The magic number is (b/2)², half the middle
    coefficient, squared: exactly what the left side is missing to become a perfect square. And
    step 3 hands you a free gift — the <strong>vertex form</strong> <code>a(x − h)² + k</code>
    reads the minimum (or maximum) point straight off the page, because a squared thing is never
    negative, so the curve bottoms out exactly where the square vanishes. One method, two
    payoffs: the roots and the vertex.
  </p>
  <p>
    The third tool, the <strong>quadratic formula</strong> x = (−b ± √(b² − 4ac)) / 2a, is nothing
    more than completing the square done once, for every quadratic at once, with letters standing
    where the numbers were. It is 9th-century Baghdad's finest export: al-Khwārizmī's solving
    procedures give us both the word <em>algebra</em> (from <em>al-jabr</em>, "restoring") and,
    through the Latinised form of his name, the word <em>algorithm</em>.
  </p>
  <p><em>Common misconception:</em> after square-rooting, you must keep <em>both</em> signs.
  From (x + 3)² = 16 the answers are x + 3 = +4 <em>and</em> x + 3 = −4 — because both 4 and −4
  square to 16 — and dropping the minus loses half the roots, the single most common quadratic
  error. It feels wrong to keep two answers, but the squaring step genuinely destroyed
  information: both signs fed the same square. A related slip is quoting "the answer" (singular)
  from the formula; the ± means two answers unless the discriminant says otherwise.</p>
  <Widget no="10" caption="find the root-dropping error" widget="spot-error" config={quadSignSpot} />

  <h2>The discriminant: counting the crossings before you compute</h2>
  <p>
    The expression <code>b² − 4ac</code> under the square root is the
    <strong>discriminant</strong>, and it tells you the shape of the solution before you compute
    anything — because a negative number has no (real) square root. If b² − 4ac is greater than
    0, the curve crosses the axis twice: two real roots. If it equals 0, the curve just kisses
    the axis at one point — a <em>repeated root</em> sitting exactly at the vertex; y = x² − 4x +
    4 = (x − 2)² touches zero only at x = 2. If it is negative — y = x² + 2x + 5 has 4 − 20 =
    −16 — there are no real roots and no crossings: the parabola floats entirely above (or below)
    the axis. Take the default curve in fig. 1: b² − 4ac = 0 + 12 = 12, which is positive — two
    roots, and the two hollow markers confirm it. The discriminant is the arithmetic shadow of
    the geometry.
  </p>
  <Widget no="9" caption="the floating parabola" widget="branch" config={quadDiscBranch} />
  <p><em>Common misconception:</em> "a negative discriminant means I made a mistake." It feels
  like failure because solving is supposed to produce answers. But it is information, not error:
  no real number squares to a negative, so no real x makes the expression zero — the curve
  genuinely never touches the axis. Designers use this on purpose: a bridge deck's load curve
  that never crosses zero is the discriminant keeping the bridge up. Verify instead by checking
  the arithmetic; then let the sign tell you the geometry.</p>

  <h2>Vertex, symmetry and sketching</h2>
  <p>
    Every parabola is perfectly symmetric about a vertical line through its peak or trough, and
    that axis sits exactly midway between the roots — which gives a quick way to find it: the
    vertex has x-coordinate <code>−b / 2a</code>. Sketch y = x² − 4x + 3 by collecting four
    facts: it opens up (a = 1, positive); it crosses the y-axis at c = 3; factorising, x² − 4x +
    3 = (x − 1)(x − 3) gives roots at 1 and 3; and the vertex lies midway between them, at
    x = 2, where y = 4 − 8 + 3 = −1. Four points, one smooth symmetric bowl — a sketch any
    examiner will recognise.
  </p>
  <Widget no="8" caption="call the vertex's x" widget="estimate" config={quadVertexEst} />
  <p>
    The vertex is also where quadratics earn money. If a company's profit is P = −2x² + 120x −
    1,000 (x = units sold), the vertex sits at x = 30 — and because a is negative, the bowl opens
    <em>down</em>, so the vertex is a maximum: 800 in profit at 30 units. Every "find the best
    price" problem in a textbook is a vertex hunt in disguise.
  </p>
  <Widget no="7" caption="bet before you read on — the profit vertex" widget="predict" config={quadProfitPredict} />
  <p><em>Common misconception:</em> "the vertex is always the minimum." The bowl picture is so
  strong that the downward case gets forgotten. But the sign of a decides everything: a positive
  a makes a valley (minimum at the vertex), a negative a makes a hill (maximum). Check it every
  time before you answer — in the profit problem above, calling x = 30 the "minimum profit"
  would invert the entire business decision.</p>

  <h2>Gradients on a curve: the tangent story</h2>
  <p>
    A line has one gradient; a curve has a different one at every point, and the gradient at a
    point is the gradient of the <em>tangent</em> — the straight line that just grazes the curve
    there. For a parabola the tangents behave with perfect regularity: at the vertex the tangent
    is horizontal (gradient 0), and it steepens steadily on either side. Differentiation (unit
    E2.12) makes this exact: for y = a·x² + b·x + c the gradient is 2a·x + b — itself a
    straight-line function of x. Slide the touch-point below and watch the tangent pivot through
    horizontal exactly at the vertex, then tilt ever more steeply:
  </p>
  <Widget no="6" caption="drop the marker — where the tangent flattens" widget="place" config={quadTangentPlace} />

  <Widget no="3" caption="the tangent line — drag t along the curve and watch the gradient grow linearly" widget="plotter" config={tangCfg} />

  <p>
    <strong>What to notice:</strong> the red tangent starts steep on the left flank, flattens to
    exactly horizontal as the touch point t reaches the vertex, then steepens again —
    mirror-symmetrically — on the right. Drag t slowly past the vertex and watch the gradient pass through
    zero without pausing: the flattest point of a parabola is a single instant, not a flat
    section. Then change a and watch how the steepening rate changes with it.
  </p>
  <p>
    Worked example: for y = x², the gradient at x = 3 is 2 × 3 = 6, and the tangent there is
    y = 6(x − 3) + 9. Notice the pleasing double linearity: the quadratic's <em>gradient</em>
    grows linearly, exactly as the lesson on linear functions promised — a parabola is a
    linear-gradient machine. This is also the physics connection made precise: the gradient of a
    distance–time parabola is the <em>instantaneous</em> velocity, the number the motion lesson
    approximated with tangents drawn by hand.
  </p>
  <p>
    <strong>So far:</strong> roots, vertex and tangent gradient between them give a complete
    description of any parabola — where it crosses, where it turns, how steeply it climbs. Now we
    spend the whole inventory on one problem at once.
  </p>

  <h2>A full modelling problem: the thrown ball</h2>
  <p>
    Here is the parabola doing physics, with every tool on the page used in order. Throw a ball
    straight up at 20 m/s from ground level; gravity decelerates it by 9.8 m/s every second, and
    its height is <code>h = 20t − 4.9t²</code> — a quadratic with a = −4.9 (opens down), b = 20,
    c = 0. <em>When does it land?</em> Set h = 0 and solve: t(20 − 4.9t) = 0, giving t = 0 (the
    throw itself) or t = 20/4.9 ≈ 4.08 s. <em>How high does it go?</em> The vertex sits at
    t = −b/2a = −20/(−9.8) ≈ 2.04 s — exactly half the flight time, the symmetry of the parabola
    made physical — with height 20(2.04) − 4.9(2.04)² ≈ 20.4 m. <em>What is its velocity at the
    top?</em> Zero — and the gradient argument proves it: at the vertex the tangent is
    horizontal, which is the algebraic way of saying the ball stops rising an instant before
    falling. Notice how each property you learned as algebra reappears as physics: roots as
    launch and landing, vertex as apex, symmetry axis as the mid-flight instant, negative a as
    gravity pulling the bowl downward. Galileo's contemporaries called this curve the trajectory
    of "mixed motion" — uniform horizontal glide plus steady fall — and it took the quadratic to
    prove the mix produces exactly this shape, never a peak and never an arc of any other kind.
  </p>
  <Widget no="5" caption="rebuild the thrown-ball analysis" widget="order" config={quadBallOrder} />
  <p>
    The same recipe solves the revenue problems: profit = revenue − cost is a quadratic when
    price falls with volume (<code>P = x(100 − x) − fixed</code>), and "maximise" is always the
    vertex. One equation, two professions.
  </p>

  <h2>Choosing the tool, and the exam traps</h2>
  <p>
    A short decision tree serves every quadratic. Try <strong>factorising</strong> first (fast,
    exact); if the numbers resist, check the <strong>discriminant</strong> — negative means no
    real roots and you can stop; otherwise use the <strong>formula</strong> (always works; watch
    the signs — a negative <code>b</code> flipped inside <code>−b</code> is the classic slip) or
    <strong>complete the square</strong> if the question also asks for the vertex. When
    <code>a ≠ 1</code>, factorising gets harder: 2x² + 5x − 3 = (2x − 1)(x + 3), found by trial
    or the AC method — multiply 2 × −3 = −6, find two numbers multiplying to −6 and adding to 5
    (that is 6 and −1), then split the middle term — and the formula earns its keep.
  </p>
  <p><em>Common misconception:</em> "x² = 3x, so divide both sides by x and get x = 3." It
  follows the normal rules of algebra and lands on a correct <em>half</em>-answer: the division
  silently assumes x is not zero, and x = 0 is a genuine solution — the other half of the truth.
  Never divide by the thing you are solving for. Factor out instead: x(x − 3) = 0 gives both
  answers, 0 and 3. Quadratics punish shortcuts; they reward the checklist.</p>
  <Widget no="4" caption="find the shortcut that deletes a root" widget="spot-error" config={quadDivideSpot} />

  <h2>Check yourself</h2>
  <p>Try these before moving on. Feedback follows each answer.</p>
  <ol>
    <li>What does the sign of a tell you about the parabola's shape?</li>
    <li>Solve x² − 5x + 6 = 0 by factorising.</li>
    <li>Without solving, how many real roots does x² + x + 5 = 0 have, and how do you know?</li>
    <li>A ball's height is h = 20t − 4.9t². When is it momentarily at rest?</li>
    <li>Where is the error: "x² = 5x, divide by x, so x = 5"?</li>
  </ol>
  <p>
    <strong>Feedback:</strong> (1) Positive a opens the bowl upward (vertex is a minimum);
    negative a opens it downward (vertex is a maximum); a = 0 degenerates to a line. (2) Two
    numbers multiplying to 6 and adding to −5: −2 and −3, so (x − 2)(x − 3) = 0 and x = 2 or
    x = 3. (3) One, none — the discriminant is 1 − 20 = −19, negative, so the curve never
    reaches the axis. (4) At the vertex, t = −b/2a = 20/9.8 ≈ 2.04 s — the tangent, and the
    velocity, are zero there. (5) Dividing by x assumed x ≠ 0 and threw away the root x = 0;
    factor instead: x(x − 5) = 0 gives x = 0 or x = 5.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>A quadratic is y = a·x² + b·x + c: the squared term makes the graph a symmetric parabola; a sets the opening, b shifts the axis, c the y-intercept.</li>
    <li>Three solving tools: factorising (fast when it works), completing the square (always works, and yields the vertex form a(x − h)² + k), and the formula (completing the square, generalised).</li>
    <li>The discriminant b² − 4ac counts roots: positive means two crossings, zero one (at the vertex), negative none.</li>
    <li>Vertex at x = −b/2a, midway between the roots; a valley if a is positive, a hill if a is negative.</li>
    <li>A parabola's gradient is 2a·x + b — it grows linearly, and is zero at the vertex.</li>
    <li>Roots are launch and landing, the vertex is the apex, the symmetry axis is mid-flight: quadratics model anything with constant acceleration.</li>
    <li>Two classic traps: dropping the ± after square-rooting, and dividing by x — which deletes the root x = 0.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    The next lesson in this unit moves to sequences and series — patterns where the
    <em>differences</em> between terms do for growth what the squared term did here. Then the
    derivative lesson makes the tangent story of this page fully rigorous: 2a·x + b stops being a
    pattern you observe and becomes a rule you prove. Much later, in complex analysis, the
    negative discriminant stops being "no roots" and opens a door to a whole number system — a
    door we peek through below.
  </p>

  <h2>Going deeper</h2>
  <p>
    The parabola has a second, purely geometric definition that explains its signature in the
    built world. Choose a point (the <strong>focus</strong>) and a line (the
    <strong>directrix</strong>): the parabola is the set of all points equally distant from the
    two. From this definition comes a remarkable reflection property — any ray entering parallel
    to the axis bounces off the curve and passes through the focus, and (running the arrows
    backwards) anything placed at the focus beams out parallel. That is the entire design of
    satellite dishes and radio telescopes (collect faint signals at the focus), car headlights
    (a bulb at the focus emits a parallel beam) and solar furnaces, which melt metal with
    sunlight collected over hundreds of square metres. A worked example: a solar-cooker dish is
    16 inches across and 4 inches deep. Put the vertex at the origin and the dish's rim at the
    point (8, 4); the standard form x² = 4py then gives 8² = 4p(4), so p = 4 — the food should
    sit 4 inches above the centre of the dish, which is exactly why such designs are so
    convenient to build.
  </p>
  <p>
    The curve has been doing physics far longer than its equation has existed: Apollonius of
    Perga catalogued the conic sections around 200 BCE with pure geometry, no algebra, and
    Galileo confirmed in 1638 that projectiles fly in parabolas.
  </p>
  <p>
    The negative discriminant, meanwhile, is a doorway. "No real roots" bothered 16th-century
    algebraists until Cardano's circle (1545) started taking square roots of negative numbers
    seriously as intermediate bookkeeping that gave <em>correct final answers</em> for real
    problems. The bookkeeping hardened into the complex numbers, with i = √(−1), now as
    fundamental to physics as any real quantity — every quantum-mechanical wavefunction lives
    there. And the family keeps yielding structure: x² − x − 1 = 0 has the golden ratio
    φ ≈ 1.618 as a root; a quadratic's two roots always satisfy root₁ + root₂ = −b/a and
    root₁ × root₂ = c/a (check with x² + 6x − 7: 1 + (−7) = −6 ✓, 1 × (−7) = −7 ✓) —
    relationships you can use to check answers in seconds. Simple curve, deep roots.
  </p>

