---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const groupCfg = {
  steps: [
    { math: 'Set: hours on a clock {0, 1, …, 11}', note: 'Take addition "mod 12": 9 + 5 = 2, because 14 wraps to 2. Ordinary arithmetic, wrapped around.' },
    { math: 'Closure: a + b stays in the set', note: 'Axiom 1 — adding two clock hours never leaves the clock.' },
    { math: 'Identity: 0 changes nothing', note: 'Axiom 2 — there is an element that acts like "doing nothing".' },
    { math: 'Inverses: every a has −a', note: 'Axiom 3 — every shift can be undone. 5 + 7 = 0 (mod 12). These three (plus associativity) make it a group.' },
    { math: 'Groups everywhere: rotations, integers, symmetries', note: 'Any system with a reversible, combinable operation is a group — and its theorems apply. That universality is why "abstract" algebra isn\'t abstract at all.' },
  ],
};

const aaGroupSort = {
  "prompt": "Which of these systems are groups under the stated operation? Check closure, identity, inverses and associativity.",
  "buckets": [
    "group",
    "not a group"
  ],
  "items": [
    {
      "label": "hours on a clock, addition mod 12",
      "bucket": 0
    },
    {
      "label": "integers, addition",
      "bucket": 0
    },
    {
      "label": "natural numbers 1, 2, 3, …, addition",
      "bucket": 1
    },
    {
      "label": "non-zero reals, multiplication",
      "bucket": 0
    },
    {
      "label": "odd integers, addition",
      "bucket": 1
    },
    {
      "label": "rotations of a square, composition",
      "bucket": 0
    }
  ],
  "why": "A group needs closure, an identity, inverses and associativity. Natural numbers lack 0 and negatives; odd integers fail closure; the others satisfy all four."
};

const aaSphereEst = {
  "prompt": "On a sphere, a triangle runs from the North Pole to the equator, a quarter of the way round, and back. Its three angles are all right angles. What is the angle sum?",
  "unit": "°",
  "answer": 270,
  "factor": 1.05,
  "why": "90° + 90° + 90° = 270°. The 90° excess over 180° is proportional to the triangle's area — the foundation of spherical trigonometry.",
  "context": "on a flat plane the sum would be exactly 180°"
};

const aaEuclidCloze = {
  "text": "Euclid's Elements organises geometry as %%0%% definitions, %%1%% postulates and %%2%% propositions, each proved only from what came before.",
  "answers": [
    [
      "23"
    ],
    [
      "5"
    ],
    [
      "465"
    ]
  ],
  "hint": "The numbers are 23, 5 and 465 — the count of propositions is the surprising one."
};

const aaScaleEst = {
  "prompt": "A 1:20 architectural model is built of a 15 m × 10 m room. What area does the model cover?",
  "unit": "m²",
  "answer": 0.375,
  "factor": 1.15,
  "why": "The real area is 150 m²; areas scale as k², so the model is 150 / 20² = 150 / 400 = 0.375 m².",
  "context": "lengths scale by 20, areas by 400, volumes by 8,000"
};

const aaSymMatch = {
  "prompt": "Pair each figure with its number of symmetries (identity included):",
  "pairs": [
    {
      "left": "square",
      "right": "8 (D₄)"
    },
    {
      "left": "equilateral triangle",
      "right": "6 (D₃)"
    },
    {
      "left": "non-square rectangle",
      "right": "4"
    },
    {
      "left": "parallelogram that is not a rectangle",
      "right": "2"
    }
  ],
  "why": "Symmetries compose as a group. The non-square rectangle has two reflections and a 180° rotation plus the identity; the generic parallelogram keeps only the identity and the half-turn."
};

const aaAnglePlace = {
  "prompt": "A spherical triangle has angle sum 270°. Place that sum on the angle axis.",
  "labels": [
    "0°",
    "90°",
    "180°",
    "270°",
    "360°"
  ],
  "scale": {
    "min": 0,
    "max": 360
  },
  "answer": 270,
  "tolerance": 5,
  "why": "The sum exceeds 180° by 90° — the spherical excess, proportional to the triangle's area. A flat triangle would sit exactly at 180°."
};

const aaInscribedEst = {
  "prompt": "A chord subtends 100° at the centre of a circle. What angle does it subtend at a point on the major arc?",
  "unit": "°",
  "answer": 50,
  "factor": 1.05,
  "why": "The inscribed angle is half the central angle: 100° / 2 = 50°, and it is the same at every point of the major arc.",
  "context": "a diameter subtends 180° at the centre, so the angle in a semicircle is 90°"
};

const aaCyclicSpot = {
  "prompt": "Find the line where the cyclic-quadrilateral arithmetic goes wrong:",
  "lines": [
    "A cyclic quadrilateral has three angles 70°, 95° and 110°.",
    "Opposite angles of a cyclic quadrilateral sum to 180°.",
    "70° + 110° = 180°, so those two are opposite.",
    "The remaining angle must pair with 95°: 180° − 95° = 85°.",
    "So the fourth angle is 95°."
  ],
  "errorLine": 4,
  "correction": "The fourth angle is 85°, not 95° — the angle paired with 95° is forced to 180° − 95°.",
  "why": "Each opposite pair sums to 180°: 70° + 110° and 95° + 85°."
};

const aaGeomMatch = {
  "prompt": "Pair each geometry with what its group of transformations preserves:",
  "pairs": [
    {
      "left": "Euclidean",
      "right": "distances and angles"
    },
    {
      "left": "affine",
      "right": "collinearity and ratios along a line"
    },
    {
      "left": "projective",
      "right": "incidence only — lines meeting lines"
    }
  ],
  "why": "Klein's Erlangen programme: choose the transformation group, and the geometry is the study of its invariants."
};

const aaGaloisJudge = {
  "statements": [
    {
      "s": "The general quintic is unsolvable by radicals because its symmetry group S₅ contains A₅, a simple group with no suitable chain of subgroups.",
      "truth": true,
      "why": "Solvability by radicals corresponds to a chain of nested normal subgroups; A₅ blocks such a chain."
    },
    {
      "s": "Galois theory says a polynomial is solvable by radicals exactly when its symmetry group is abelian.",
      "truth": false,
      "why": "The group must be solvable, not necessarily abelian — abelian is sufficient but not necessary."
    },
    {
      "s": "The same theory decides which regular polygons are constructible with ruler and compasses.",
      "truth": true,
      "why": "Constructibility reduces to nested square roots, a condition on the Galois group."
    }
  ]
};
---
<TopicPage slug="subjects/math/expert/abstract-algebra">
  <h2>Where you are, and what you will learn</h2>
  <p>
    This expert lesson completes a line of ascent through the Mathematics track. From the
    advanced tier, <em>Number theory</em> gave you modular arithmetic — the "wrap-around"
    addition the clock model below formalises — and <em>Logic and proof</em> taught the
    axiomatic contract that this lesson treats as the real subject matter. From the intermediate
    tier, <em>Trigonometry</em> and <em>Circles and coordinate geometry</em> supplied the angle
    and circle facts that the later sections re-derive from symmetry. What is new here is the
    algebraic inversion: study the transformations, not the shapes.
  </p>
  <p>By the end you will be able to:</p>
  <ul>
    <li>check a system against the group axioms — closure, identity, inverses, associativity — using clock arithmetic as the worked model;</li>
    <li>explain why the parallel postulate is a clause in a contract, and what denying it buys (spherical and hyperbolic geometry);</li>
    <li>handle scaling bookkeeping: lengths as k, areas as k², volumes as k³ — the square–cube law and its consequences;</li>
    <li>re-derive the circle theorems from one isosceles-triangle engine and read them as statements of invariance;</li>
    <li>connect symmetry to physics and crystallography — Noether's theorem, the crystallographic restriction, wallpaper groups.</li>
  </ul>

  <h2>The idea</h2>
  <p>
    Abstract algebra does something that looks like madness and turns out to be profound: it
    <strong>forgets the objects and keeps the rules</strong>. Add numbers, add clock-hours,
    combine rotations, flip a Rubik's cube — all different activities, all obeying the same
    pattern of axioms. Prove a theorem once about the pattern, and it holds for every system
    that shares it. For geometry this move is decisive: the school syllabus's terms,
    similarities, symmetries and circle theorems turn out to be, in the expert view, one
    subject — the study of what stays <em>invariant</em> under a chosen family of
    transformations. That inversion (study the transformations, not the shapes) is Felix
    Klein's Erlangen programme of 1872, and it is how modern geometry, crystallography and
    particle physics all still think.
  </p>
  <Widget no="1" caption="group or not?" widget="sort-buckets" config={aaGroupSort} />

  <Widget no="2" caption="clock arithmetic — a complete group, checked axiom by axiom" widget="equationStep" config={groupCfg} />
  <p>
    <strong>What to notice:</strong> step through the panels as an axiom audit, not a
    demonstration. Each panel checks one clause — closure, identity, inverses — against the
    same twelve-hour clock, and the point is the order of operations: the axioms are verified
    <em>before</em> any theorem is claimed, exactly as Euclid's postulates precede his 465
    propositions. The final panel is the payoff — every system sharing these clauses inherits
    every theorem, which is what "abstract" was buying all along.
  </p>

  <h2>Geometrical terms as axioms: the contract underneath the pictures</h2>
  <p>
    The school definitions — point, line, angle, parallel — look innocent until you notice
    they are <em>assumptions</em>. Euclid built geometry on five postulates, and the fifth (the
    parallel postulate) resisted two thousand years of attempted proof before Lobachevsky and
    Bolyai (1820s–30s) showed why: geometries that deny it are perfectly consistent. On the
    surface of a sphere, "lines" are great circles, every pair meets, and a triangle's angles
    sum to <em>more</em> than 180° — draw one from the North Pole to the equator, a quarter of
    the way round, and back: three right angles, 270°. The expert lesson is that "geometrical
    terms" are a contract: change a clause and you get a new but equally valid world. General
    relativity is written in exactly such a non-Euclidean contract, and the fact that Euclid's
    version fits a tabletop is a physical fact, not a logical necessity.
  </p>
  <Widget no="3" caption="call the spherical angle sum" widget="estimate" config={aaSphereEst} />
  <p>
    Euclid's <em>Elements</em> deserves its own attention as the template the whole
    axiomatic method copied: 23 definitions, 5 postulates, 5 common notions, and 465
    propositions built on them in strict order — nothing used that was not first proven.
    For two millennia it was the model of certainty itself (Spinoza wrote his
    <em>Ethics</em> "in the geometrical manner"; Newton wrote the <em>Principia</em> in
    Euclid's proposition form). The algebraic lesson: a proof system is a
    <em>mechanical</em> contract, checkable by anyone who accepts the opening clauses —
    which is exactly what formal proof assistants verify today, machine-checking
    mathematics with the same clause-by-clause discipline Euclid set.
  </p>
  <Widget no="4" caption="fill the blanks — the axiomatic contract" widget="cloze" config={aaEuclidCloze} />
  <p>
    <em>Common misconception:</em> "parallel lines never meet — that's just what parallel
    means." On a sphere, any two great circles intersect (there are no parallel "lines" at
    all), and in hyperbolic geometry parallel lines diverge. "Never meet" is Euclid's fifth
    postulate — an axiom, not a truth — and the nineteenth century's discovery that you can
    consistently deny it is the moment geometry became a science of possible worlds.
  </p>
  <p><strong>So far:</strong> the "innocent" geometrical terms turned out to be clauses in a mechanical contract — and denying one clause, Euclid's fifth, opened consistent new worlds. The next section stays inside the ordinary Euclidean contract and shows how algebra turns its shapes into bookkeeping.</p>

  <h2>Similarity: scaling and the square–cube law</h2>
  <p>
    Similar figures (E4.4) differ by a scale factor k, and algebra turns the geometry into
    bookkeeping: lengths scale as k, areas as k², volumes as k³. Enlarge a cube by 2 and its
    surface area multiplies by 4 while its volume multiplies by 8 — the surface-to-volume
    ratio halves. That single line, Galileo's 1638 observation, explains why elephants need
    thick legs (weight grows as volume, bone strength as cross-sectional area), why a mouse
    loses heat faster than a whale (heat loss goes with surface), and why small insects can
    fall any distance safely. A worked check: a 1:50 architectural model of a 10 m × 8 m room
    covers 0.2 m × 0.16 m = 0.032 m² on the table — exactly 1/2,500 of the real 80 m², since
    50² = 2,500. Similarity is also a group in disguise: uniform scalings compose, have an
    identity (k = 1) and inverses (k → 1/k) — the group axioms, wearing a ruler.
  </p>
  <Widget no="5" caption="call the model's area" widget="estimate" config={aaScaleEst} />

  <h2>Symmetry: the algebraic view of shape</h2>
  <p>
    Symmetry (E4.5) becomes serious the moment you count and combine the transformations that
    preserve a figure. A square has eight symmetries — four rotations (0°, 90°, 180°, 270°)
    and four reflections — and they compose like clock arithmetic: rotate 90° three times and
    reflect, versus reflect then rotate, give different results, so the table of combinations
    is genuinely new algebra (the dihedral group D₄, order 8). The payoff is a theorem you can
    feel: crystallographic restriction — a repeating crystal lattice permits only 2-, 3-, 4-
    and 6-fold rotational symmetries, never 5 or 7 — which is why pentagonal tiles cannot
    wallpaper a bathroom floor and why quasicrystals (Shechtman, 1982, Nobel 2011) were so
    scandalous. Deeper still, Emmy Noether's 1918 theorem ties every continuous symmetry to a
    conservation law: time-translation symmetry yields conservation of energy, rotational
    symmetry conservation of angular momentum. The school's "rotational symmetry order 4" and
    the universe's "energy is conserved" are the same mathematics at different scales.
  </p>
  <Widget no="6" caption="pair each figure with its symmetry count" widget="match" config={aaSymMatch} />

  <h2>Angles: measurements that depend on the geometry</h2>
  <p>
    Angle facts (E4.6) — vertically opposite angles equal, angles on a line sum to 180°,
    triangle angles sum to 180° — are usually memorised. The expert reframing: an angle is a
    rotation, and the "sum of a triangle" is a statement about the underlying space, not about
    triangles. It is exactly 180° on a flat plane, above 180° on a sphere (that 270°
    polar triangle again: the excess, 90°, is proportional to the triangle's area — the
    foundation of spherical trigonometry, which navigators have used for centuries), and
    below 180° on a saddle-shaped hyperbolic surface. Gauss allegedly tried to measure the
    curvature of space directly by surveying a vast triangle between three mountain peaks —
    the experiment failed only because the answer, within error, was flat. Angle sums are a
    curvature detector: every survey is secretly a test of which geometry we live in.
  </p>
  <Widget no="7" caption="mark the spherical triangle's angle sum" widget="place" config={aaAnglePlace} />
  <p><strong>So far:</strong> similarity revealed itself as a group in disguise, symmetry became the algebraic view of shape, and angle sums turned into curvature detectors — each section adding a layer of invariance. The next two sections apply that lens to the circle theorems, where one proof quietly generates a whole family of results.</p>

  <h2>Circle theorems I: one proof, many theorems</h2>
  <p>
    The first family of circle theorems (E4.7) — the angle at the centre is twice the angle at
    the circumference standing on the same arc; the angle in a semicircle is 90°; angles in
    the same segment are equal — all fall out of one observation: a triangle formed from two
    radii is <strong>isosceles</strong>, so its base angles are equal. Run that once and the
    inscribed-angle theorem drops out; set the arc to a diameter and the inscribed angle is
    90° (Thales' theorem, the oldest named result in mathematics); slide the vertex along the
    same arc and nothing changes, because the central angle does not move. The group-theory
    view explains the "nothing changes": the circle's rotation group acts on inscribed angles
    transitively, so all angles subtending a fixed chord from the same arc must be equal.
    Worked check: a chord that subtends 80° at the centre is seen under exactly 40° from
    <em>every</em> point of the major arc — move the point anywhere along it and the answer
    never changes. Theorems you can re-derive in ninety seconds are theorems you never carry.
  </p>
  <Widget no="8" caption="call the inscribed angle" widget="estimate" config={aaInscribedEst} />

  <h2>Circle theorems II: tangents, cyclic quadrilaterals, and proof technique</h2>
  <p>
    The second family (E4.8) — a tangent meets the radius at right angles; opposite angles of
    a cyclic quadrilateral sum to 180°; the alternate segment theorem (the angle between
    tangent and chord equals the angle in the alternate segment) — is where school geometry
    teaches proof architecture: given, construction, steps, QED. A cyclic quadrilateral works
    because each pair of opposite angles subtends complementary arcs; concretely, if three
    angles of a cyclic quadrilateral measure 70°, 95° and 110°, the fourth is forced to be
    85° — the opposite pair 95° + 85° = 180° as promised. The alternate segment theorem is
    the one with the afterlife: it is the special case of the inscribed-angle theorem as one
    point slides onto another, and its limiting argument ("let the two points coincide") is a
    preview of every tangent construction in differential geometry. Why these theorems matter
    to an algebraist: they are all statements of <em>invariance</em> — quantities that cannot
    change because the symmetries forbid it — which is the deepest lesson geometry has for
    the rest of mathematics.
  </p>
  <Widget no="9" caption="find the arithmetic slip" widget="spot-error" config={aaCyclicSpot} />
  <p>
    <em>Common misconception:</em> "the angle in a semicircle being 90° is a separate fact to
    memorise." It is the inscribed-angle theorem with the arc chosen to be a diameter — one
    theorem, one special case. Students who memorise the seven circle theorems as seven facts
    carry seven fragments; students who see the single isosceles-triangle engine carry one.
  </p>

  <p>
    <em>Common misconception:</em> "similar shapes are the same shape, so their areas are the
    same too." Areas scale as k², volumes as k³ — a 1:10 model has 1/100 the surface and
    1/1,000 the mass. Almost every scaling blunder in science and engineering — from drug
    doses for children to why you cannot simply enlarge an ant to monster-movie size — is a
    forgotten square or cube.
  </p>
  <p>
    <em>Common misconception:</em> "symmetry means a shape has mirror lines." Formally,
    symmetry is any transformation that preserves the object: a rotation counts (a
    parallelogram has rotational symmetry of order 2 and no reflection symmetry at all), and
    so does every object's <em>identity</em> — the do-nothing transformation. That trivial
    member is what makes the symmetries a group rather than a loose collection, and it is the
    axiom-checker's first test: a "set of symmetries" without an identity is a mistake
    waiting to be found.
  </p>
  <p><strong>So far:</strong> one isosceles-triangle engine generated the first circle-theorem family, the second family taught proof architecture, and the misconceptions trimmed away the memorisation habit — seven fragments becoming one engine, scaling squares becoming cubes, symmetry becoming a group with its identity included. The remaining sections push the same machinery to its limits.</p>

  <h2>Check yourself</h2>
  <p>Try these before moving on. Feedback follows each answer.</p>
  <ol>
    <li>List the axioms the clock model satisfies, and give the identity and the inverse of 5 in mod-12 addition.</li>
    <li>An architect builds a 1:50 model of a 10 m × 8 m room. What area does the model cover, and which scaling rule produces the answer?</li>
    <li>Why is "the angle in a semicircle is 90°" not a separate fact to memorise, and what general principle does the answer illustrate?</li>
  </ol>
  <p>
    <strong>Feedback:</strong> (1) Closure (a + b stays on the clock), identity (0 changes
    nothing), inverses (every shift a is undone by −a) and associativity — together they make
    it a group. The identity is 0; the inverse of 5 is 7, since 5 + 7 = 12, which wraps to 0.
    (2) The model covers 0.2 m × 0.16 m = 0.032 m² — exactly 1/2,500 of the real 80 m², because
    areas scale as k²: with k = 50, that is 50² = 2,500. If you answered with a factor of 50,
    you applied the length rule to an area. (3) It is the inscribed-angle theorem with the arc
    chosen to be a diameter — one theorem, one special case. The general principle: quantities
    that survive a symmetry's action cannot vary along it, so the rotation group's transit
    action on the arc forces every angle subtending the same chord to agree — invariance, not
    coincidence.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>Abstract algebra forgets the objects and keeps the rules: prove once about the pattern, apply everywhere.</li>
    <li>The group axioms — closure, identity, inverses, associativity — are checked before any theorem is claimed.</li>
    <li>Geometrical terms are a contract: denying Euclid's fifth postulate yields consistent spherical and hyperbolic worlds.</li>
    <li>Scaling bookkeeping: lengths as k, areas as k², volumes as k³ — almost every scaling blunder is a forgotten square or cube.</li>
    <li>Symmetry is any structure-preserving transformation, and the full set — identity included — forms a group.</li>
    <li>One isosceles-triangle engine generates the circle theorems; invariance is the thread that ties them to Noether's theorem.</li>
    <li>Angle sums are curvature detectors, and Galois showed symmetry itself decides which equations are solvable.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    Three sibling expert lessons extend the invariance programme. <strong>Topology</strong>
    asks what survives continuous deformation — the extreme case of forgetting everything but
    structure. <strong>Linear algebra</strong> runs the same game on vector spaces and their
    transformations, and <strong>Real analysis</strong> supplies the limiting arguments the
    alternate segment theorem only previewed.
  </p>

  <h2>Going deeper</h2>
  <p>
    <strong>Groups take over geometry.</strong> Klein's insight generalises: choose a group of
    transformations, and the "geometry" is the study of what survives it. Euclidean geometry
    keeps distances; affine geometry (parallel projections) keeps collinearity and ratios
    along a line; projective geometry (perspective) keeps only incidence — which is why a
    circle and an ellipse are the same projective object, and why Renaissance perspective is
    a theorem, not a trick. Symmetry groups of patterns close over the plane in exactly 17
    wallpaper groups (proved by Fedorov, 1891; you can count them on the Alhambra's walls),
    and the classification of crystallographic groups in 3D (230 space groups) is the
    backbone of X-ray crystallography — the technique that found DNA's double helix.
  </p>
  <Widget no="10" caption="pair each geometry with its invariants" widget="match" config={aaGeomMatch} />
  <p>
    <strong>Galois: symmetry decides solvability.</strong> The deepest marriage of the two
    halves of this page is Galois theory. Each polynomial equation hides a symmetry group of
    its roots (permutations that respect the algebraic relations), and the equation is
    solvable by radicals exactly when that group has a chain of nested subgroups of the right
    kind (solvable in the technical sense). The general quintic fails because its group S₅
    contains A₅, a simple group with no such chain — impossibility as a structural fact. The
    same theory explains which regular polygons are constructible with ruler and compasses
    (n = 17 is; n = 7 is not) and why three classical problems — doubling the cube,
    trisecting an angle, squaring the circle — are impossible. Galois died in a duel in 1832,
    aged 20; his letter written the night before still organises a branch of mathematics.
  </p>
  <Widget no="11" caption="true or false — symmetry decides solvability" widget="judge" config={aaGaloisJudge} />
  <p>
    <strong>Where it leads now.</strong> Symmetry groups run modern physics at the deepest
    level: the Standard Model of particles is built on the groups U(1) × SU(2) × SU(3), and
    "particle" categories are representation-theoretic labels. Chemists read molecular
    symmetry via group theory to predict which vibrations are infrared-active. Cryptography
    leans on groups of points on elliptic curves. The school syllabus's circle theorems and
    the Large Hadron Collider's data analysis share a spine: find the transformations that
    preserve the structure, and compute what they force to be true. Geometry stopped being
    about diagrams in the 1870s; it became the mathematics of invariance, and that is the
    version every expert uses.
  </p>
  <p class="sources"><strong>Sources:</strong> Artin, Algebra; Dummit & Foote, Abstract Algebra; Judson, Abstract Algebra: Theory and Applications (open text). Source text: OpenStax (https://openstax.org), CC BY 4.0 — adapted for Interactive Atlas.</p>
</TopicPage>
