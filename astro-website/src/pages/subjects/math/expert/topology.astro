import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const eulerCfg = {
  steps: [
    { math: 'V − E + F = 2', note: 'For any polyhedron: vertices minus edges plus faces equals 2. Cube: 8 − 12 + 6 = 2. Pyramid: 5 − 8 + 5 = 2. Always.' },
    { math: 'Why? Delete faces one by one', note: 'Flatten the surface into a network on the plane — the count survives every flattening step.' },
    { math: 'Then strip triangles', note: 'Removing an outer triangle deletes 1 face, 2 edges, 1 vertex: Δ(V−E+F) = 1 − 2 + 1 = 0. The invariant never moves.' },
    { math: 'What remains: one triangle = 3 − 3 + 2 = 2', note: 'Strip everything down and the last triangle still says 2. The number was baked into the sphere all along.' },
    { math: 'Torus: V − E + F = 0', note: 'A doughnut network cannot be flattened the same way — its Euler characteristic is 0. One number classifies surfaces; that is topology.' },
  ],
};
---
<TopicPage slug="subjects/math/expert/topology">
  <h2>The idea</h2>
  <p>
    Topology studies properties that survive <strong>any stretching or bending, but not
    tearing</strong>. To a topologist a coffee mug and a doughnut are the same object — each has
    exactly one hole — and the discipline's genius is finding <em>numbers and structures that
    cannot change under deformation</em>, called invariants. Continuity itself becomes the
    central definition: a function is continuous when it doesn't tear.
  </p>

  <Widget no="1" caption="Euler's formula — an invariant hunt across any polyhedron, ending at the sphere's signature" widget="equationStep" config={eulerCfg} />

  <h2>The core structures</h2>
  <ul>
    <li><strong>Topological spaces:</strong> a set plus a declared family of "open sets". That's all a topology is — a minimalist specification of which points are near which, generalising distance itself.</li>
    <li><strong>Homeomorphism:</strong> a continuous map with continuous inverse — the official "same shape". Under it, distance, angle and size are all irrelevant; hole-count survives.</li>
    <li><strong>Compactness:</strong> the abstract form of "closed and bounded" — the property that makes continuous functions attain maxima and sequences behave. Analysis runs on it.</li>
    <li><strong>Connectedness and the fundamental group:</strong> loops on a surface, up to deformation, form a group — the doughnut's differs from the sphere's. Algebra meets topology (that bridge is its own field: algebraic topology).</li>
  </ul>

  <h2>Where it reaches</h2>
  <p>
    General relativity models spacetime as a topological manifold with geometry painted on;
    data scientists use persistent homology to find the shape of datasets; and the four-colour
    theorem — four colours suffice for any map — is a topology statement proven with 1,200 hours
    of computer checking (1976), a watershed for what a proof can be.
  </p>
  <p class="sources"><strong>Sources:</strong> Munkres, Topology; Richeson, Euler's Gem.</p>
</TopicPage>
