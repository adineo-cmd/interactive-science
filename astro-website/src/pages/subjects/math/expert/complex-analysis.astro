---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const euler2Cfg = {
  steps: [
    { math: 'e^x = 1 + x + x²/2! + x³/3! + …', note: 'The exponential\'s power series — valid for every x. The bold move of the 1700s: plug in what isn\'t real and see if the pattern still speaks.' },
    { math: 'e^{iθ} = 1 + iθ + (iθ)²/2! + …', note: 'Substitute x = iθ. Powers of i cycle: i, −1, −i, 1, i, −1…' },
    { math: '= (1 − θ²/2! + θ⁴/4! − …) + i(θ − θ³/3! + …)', note: 'Sort real and imaginary terms — and recognise the two famous series hiding inside.' },
    { math: 'e^{iθ} = cos θ + i·sin θ', note: 'Euler\'s formula. Rotation, hidden inside the exponential — which is why engineers write waves as e^{iωt}.' },
    { math: 'θ = π: e^{iπ} + 1 = 0', note: 'Five fundamental constants, one line. When mathematicians vote for the most beautiful equation, this wins.' },
  ],
};

const caCalcSort = {
  "prompt": "File each theorem under the calculus where it belongs:",
  "buckets": [
    "real calculus",
    "complex calculus"
  ],
  "items": [
    {
      "label": "differentiable once implies infinitely differentiable",
      "bucket": 1
    },
    {
      "label": "smooth but not analytic: e^(−1/x²)",
      "bucket": 0
    },
    {
      "label": "bounded entire function must be constant",
      "bucket": 1
    },
    {
      "label": "a smooth function need not equal its Taylor series",
      "bucket": 0
    },
    {
      "label": "zeros accumulating force the function to be identically zero",
      "bucket": 1
    }
  ],
  "why": "Complex differentiability is far stronger: it forces infinite smoothness and analyticity, and rigidly determines the function from local data."
};

const caModEst = {
  "prompt": "What is |2 + 3i|?",
  "unit": "",
  "answer": 3.61,
  "factor": 1.1,
  "why": "|z| = √(a² + b²) = √(4 + 9) = √13 ≈ 3.61. The modulus is Pythagoras applied to the components.",
  "context": "|3 + 4i| = 5 — the oldest Pythagorean triple"
};

const caCubeOrder = {
  "prompt": "Compute (1 + i)³ with the star rule — put the steps in order:",
  "items": [
    "Write 1 + i in polar form: modulus √2, argument 45°",
    "Cube the modulus: (√2)³ = 2√2",
    "Triple the argument: 3 × 45° = 135°",
    "So (1 + i)³ = 2√2 (cos 135° + i sin 135°)",
    "Evaluate: 2√2(−√2/2 + i√2/2) = −2 + 2i"
  ],
  "why": "In polar form powers are easy: rⁿ at angle nθ. Direct algebra gives the same answer — the star rule is a theorem, not a shortcut."
};

const caRootPlace = {
  "prompt": "The five fifth roots of unity are evenly spaced around the unit circle. Place the second one (after z = 1) on the angle axis.",
  "labels": [
    "0°",
    "90°",
    "180°",
    "270°",
    "360°"
  ],
  "scale": {
    "min": 0,
    "max": 360
  },
  "answer": 72,
  "tolerance": 1,
  "why": "360° / 5 = 72°. The roots are 1, e^(2πi/5), e^(4πi/5), e^(6πi/5), e^(8πi/5), and their real parts produce the exact cosine values."
};

const caIdentityMatch = {
  "prompt": "Pair each trigonometric identity with its complex statement:",
  "pairs": [
    {
      "left": "sin²θ + cos²θ = 1",
      "right": "|e^(iθ)|² = 1"
    },
    {
      "left": "cos 2θ = cos²θ − sin²θ",
      "right": "squaring e^(iθ) doubles the angle"
    },
    {
      "left": "De Moivre: (cos θ + i sin θ)ⁿ",
      "right": "(e^(iθ))ⁿ = e^(inθ)"
    },
    {
      "left": "angle addition",
      "right": "e^(i(α+β)) = e^(iα)e^(iβ)"
    }
  ],
  "why": "Once trigonometry is the real and imaginary parts of e^(iθ), every identity becomes exponent bookkeeping."
};

const caInterferenceBranch = {
  "root": "Two paths reach the same detector with equal amplitudes. Their relative phase is an angle. What does the detector show?",
  "nodes": {
    "start": {
      "text": "The amplitudes are complex numbers; the detector measures the squared modulus of their sum. What happens at phase 0?",
      "choices": [
        {
          "label": "They add: probability ∝ |1 + 1|² = 4",
          "next": "construct",
          "feedback": "Yes — in phase, amplitudes add and the probability quadruples."
        },
        {
          "label": "They cancel: probability 0",
          "next": "destruct",
          "feedback": "That is the phase-π case, not phase 0."
        },
        {
          "label": "Probabilities simply add: 1 + 1 = 2",
          "next": "classical",
          "feedback": "That is the classical expectation; quantum interference contradicts it."
        }
      ]
    },
    "construct": {
      "text": "Constructive interference. Now set the phase difference to π. What happens?",
      "choices": [
        {
          "label": "The amplitudes cancel: |1 − 1|² = 0",
          "next": "destruct",
          "feedback": "Yes — opposite phases cancel exactly."
        },
        {
          "label": "The probability doubles",
          "next": "double",
          "feedback": "No: with phase π the amplitudes have opposite signs."
        }
      ]
    },
    "destruct": {
      "text": "Destructive interference — the two paths can cancel completely, even though each alone would register."
    },
    "double": {
      "text": "At phase π the amplitudes are opposite: 1 + (−1) = 0, so the probability vanishes."
    },
    "classical": {
      "text": "Classical probabilities would add, but the double-slit pattern shows amplitudes interfering instead."
    }
  },
  "why": "Interference is complex addition: add amplitudes, then square the modulus. The relative phase decides whether paths reinforce or cancel."
};

const caObliqueEst = {
  "prompt": "In a triangle, a = 8, b = 5 and the included angle C = 60°. What is c?",
  "unit": "",
  "answer": 7,
  "factor": 1.05,
  "why": "c² = 64 + 25 − 2·8·5·cos 60° = 89 − 40 = 49, so c = 7. The correction term vanishes at C = 90°.",
  "context": "the cosine rule is Pythagoras plus a correction"
};

const caSineSpot = {
  "prompt": "Find the line where the sine-rule statement goes wrong:",
  "lines": [
    "In triangle ABC, a = 5, b = 7, C = 60°.",
    "Cosine rule: c² = 25 + 49 − 2·5·7·cos 60°.",
    "cos 60° = 0.5, so c² = 74 − 35 = 39.",
    "Therefore c = √39 ≈ 6.24.",
    "Sine rule: a/sin A = b/sin B = R, where R is the circumradius."
  ],
  "errorLine": 4,
  "correction": "The common ratio is 2R — the diameter of the circumcircle — not R.",
  "why": "Every side divided by the sine of its opposite angle equals the circumdiameter; the factor of 2 is the classic slip."
};

const caRigidCloze = {
  "text": "If a function is complex-differentiable once on a region, it is automatically %%0%% differentiable there and equals its Taylor series. Liouville's theorem says a %%1%% function differentiable on the whole plane must be constant.",
  "answers": [
    [
      "infinitely"
    ],
    [
      "bounded"
    ]
  ],
  "hint": "Real calculus has smooth non-analytic functions; complex calculus has none."
};

const caResidueCompare = {
  "prompt": "One loop integral, two cases — drag the divider:",
  "before": {
    "label": "no pole inside",
    "text": "Cauchy's theorem: the integral around the loop is zero — analytic means there is nothing to detect."
  },
  "after": {
    "label": "pole inside",
    "text": "The residue theorem: 2πi times the sum of enclosed residues — the integral counts the holes."
  },
  "why": "Contour integrals detect only singularities; you may deform the loop freely as long as it sweeps across no pole."
};
---
<TopicPage slug="subjects/math/expert/complex-analysis">
  <h2>Where you are, and what you will learn</h2>
  <p>
    This expert lesson is the destination of several tracks at once. From the intermediate tier,
    <em>Trigonometry</em> supplied the ratios, circles and exact values that every section here
    re-derives from complex machinery; <em>Sequences and series</em> built the power series the
    widget below substitutes into; and <em>The derivative</em> defined the differentiability
    whose complex version is so much stronger. From the advanced tier, <em>Integration</em>
    prepared the contour integrals that residues will settle in one line. What is new here is
    the plane: inputs and outputs that are themselves two-dimensional.
  </p>
  <p>By the end you will be able to:</p>
  <ul>
    <li>derive Euler's formula from the exponential's power series and explain what it reveals about rotation;</li>
    <li>use the polar form's star rule — multiply moduli, add angles — to compute products and powers exactly;</li>
    <li>read exact trigonometric values as roots of unity, solutions of zⁿ = 1 spaced around the unit circle;</li>
    <li>explain why complex exponentials are the natural alphabet of oscillation (Fourier analysis, quantum mechanics);</li>
    <li>describe conformal maps and the rigidity theorems that make analytic functions the most predictable objects in mathematics.</li>
  </ul>

  <h2>The idea</h2>
  <p>
    Complex analysis is calculus on functions whose inputs and outputs live in the plane of
    a + bi. Its miracle: demanding that a function be differentiable in the <em>complex</em>
    sense is so restrictive that everything becomes rigid and beautiful. Complex-differentiable
    functions are infinitely smooth, determined by their values on any tiny patch, and obey
    integral formulas that feel like magic until the rigidity sinks in. And the whole subject
    is secretly trigonometry grown up: the unit circle, the exact values, the sine and cosine
    of the school syllabus are the local shadows of one complex function, e to the iθ. Every
    section below takes a trigonometry topic and shows the complex machinery underneath it.
  </p>
  <Widget no="1" caption="real or complex calculus?" widget="sort-buckets" config={caCalcSort} />

  <Widget no="2" caption="Euler's formula, derived honestly — the series substitution that married exponentials to rotation" widget="equationStep" config={euler2Cfg} />
  <p>
    <strong>What to notice:</strong> the five panels are one argument, line by line, and no step
    is a trick. Panel 1 states the exponential's power series; panel 2 substitutes an imaginary
    input, licensed only because the series still makes sense there; panel 3 sorts real from
    imaginary terms — watch the two familiar series surface out of the sorting; panel 4 names
    the result, rotation hiding inside the exponential; panel 5 is the same line evaluated at a
    special angle, where five constants meet in one equation. Nothing was assumed except the
    series itself.
  </p>

  <h2>Pythagoras and the unit circle: where complex numbers live</h2>
  <p>
    Pythagoras' theorem (E6.1) is the metric of the plane: a distance is √(x² + y²). Complex
    numbers adopt it as their definition of size — the modulus |z| = √(a² + b²) — and the
    unit circle |z| = 1 becomes the home of all of trigonometry. The theorem's algebraic face
    is older and stranger than the geometric one: a Pythagorean triple (3, 4, 5) is a rational
    point on the unit circle, and every triple comes from the parametrisation (1 − t², 2t,
    1 + t²): take t = ½ and you get (3/4, 1, 5/4), which scales by 4 to the 3-4-5. The same circle, read over the
    complex numbers, is where rotation lives: multiplying by a unit-complex number is exactly
    a rotation, since moduli multiply (1 × 1 = 1) and arguments add. Even Fermat's Last
    Theorem — no whole-number solutions to xⁿ + yⁿ = zⁿ for n above 2 — is the statement that
    the Pythagorean circle has no higher-dimensional cousins, a claim proved only in 1995
    (Wiles) by methods that run straight through complex analysis.
  </p>
  <Widget no="3" caption="call the modulus" widget="estimate" config={caModEst} />
  <p><strong>So far:</strong> the unit circle is both Pythagoras' metric and the home of rotation — multiplying by a unit-complex number turns out to be rotating, because moduli multiply and arguments add. The next section cashes that in: the triangle definitions of sine and cosine grow into polar coordinates that work for every angle.</p>

  <h2>Right-angled triangles: SOH-CAH-TOA becomes polar coordinates</h2>
  <p>
    Right-triangle trigonometry (E6.2) defines sine and cosine as ratios — opposite over
    hypotenuse — valid only inside the triangle. The unit circle liberates them: sine and
    cosine become coordinates of a point at angle θ, defined for every real θ, negative
    angles included. Complex analysis completes the liberation: any complex number is
    z = r(cos θ + i sin θ), its <strong>polar form</strong>, which Euler's formula compresses
    to z = re^(iθ). Multiplication becomes the star rule: <em>multiply moduli, add angles</em>.
    Two quick checks: (1 + i) × (1 − i) has moduli √2 each and arguments +45° and −45°, so
    the product has modulus 2 and argument 0 — it equals 2, exactly as the algebra says.
    Square (1 + i) and you get modulus 2, angle 90° — which is 2i, again exact. The school
    rules for surds and the geometry of rotating arrows are one subject; the polar form is
    the dictionary, and it is why engineers write every oscillation as a rotating complex
    exponential rather than a pair of sines.
  </p>
  <Widget no="4" caption="cube a complex number with the star rule" widget="order" config={caCubeOrder} />

  <h2>Exact values: roots of unity and the golden ratio</h2>
  <p>
    Exact trigonometric values (E6.3) — sin 30° = ½, cos 45° = √2/2, cos 36° = (1 + √5)/4 —
    look like isolated trophies. They are solutions of polynomial equations, and complex
    analysis explains which angles get exact forms. The equation zⁿ = 1 has exactly n complex
    solutions, the <strong>roots of unity</strong>, evenly spaced around the unit circle at
    angles 360°/n; their real parts are exact cosines, and solving the polynomial (for n = 5,
    a quartic) produces the golden ratio inside cos 36° — the pentagram's secret, algebraised.
    The pattern even predicts its own limits: which regular polygons can be constructed with
    ruler and compasses is exactly the question "when is the n-th cyclotomic polynomial
    solvable by nested square roots?", and Gauss answered it at 19 (1796), discovering the
    constructibility of the 17-gon. The exact-value table is the visible tip of a theory about
    when radicals can reach rotation — and complex numbers are the reach.
  </p>
  <Widget no="5" caption="mark the second fifth root of unity" widget="place" config={caRootPlace} />
  <p><strong>So far:</strong> polar coordinates turned triangle ratios into coordinates of rotation, and the exact values revealed themselves as roots of unity — algebra's answer to which angles keep exact forms. The next section compresses everything onto a single line and lets it pay out through Fourier analysis and quantum mechanics.</p>

  <h2>Trigonometric functions: one exponential, many waves</h2>
  <p>
    The trigonometric functions (E6.4) — graphs, periods, identities — condense to a single
    line: e^(iθ) = cos θ + i sin θ. Every identity becomes bookkeeping. Add angles: multiply
    exponentials. The Pythagorean identity sin²θ + cos²θ = 1 is |e^(iθ)|² = 1. De Moivre's
    theorem (cos θ + i sin θ)ⁿ = cos nθ + i sin nθ is literally the power rule (e^(iθ))ⁿ =
    e^(inθ). And the expert payoff is Fourier analysis: any reasonable signal — a violin's
    sound, a JPEG's pixels, a radio broadcast — decomposes into a sum of pure exponentials,
    because they are the eigenfunctions of time-translation: shift a pure tone and you merely
    multiply it by a constant. MP3 and JPEG compression, radio tuning and the solving of the
    heat and wave equations are all the statement "complex
    exponentials are the natural alphabet of oscillation", which is Euler's formula writ
    large. The trig functions stop being ratios in triangles and become the coordinate
    system of frequency.
  </p>
  <Widget no="6" caption="pair each identity with its complex statement" widget="match" config={caIdentityMatch} />
  <p>
    Quantum mechanics is the deepest customer. States are vectors with complex
    components, observables are operators, and time evolution is multiplication by
    e^(−iEt/ħ) — the same exponential, with energy inside the argument. Interference,
    the subject's heart, is complex addition: two paths to the same outcome add their
    amplitudes, and the relative phase (an angle, exactly as in polar form) decides
    whether they reinforce or cancel — the double-slit experiment's pattern is
    literally the modulus-squared of a complex sum. Schrödinger chose complex
    amplitudes not for elegance but because they are the minimal algebra in which
    oscillation and rotation can be expressed; complex analysis is the calculus of
    that choice, and the path-integral formulation of quantum field theory — summing
    e^(iS/ħ) over histories — runs on the same one-liner.
  </p>
  <Widget no="7" caption="trace the interference" widget="branch" config={caInterferenceBranch} />
  <p>
    <em>Common misconception:</em> "sin and cos are about triangles." By the end of this page
    they are characters in the complex exponential — defined for complex arguments too
    (sin z grows exponentially in the imaginary direction, which surprises everyone the first
    time). The triangle definitions are the special case θ real; treating them as the
    definition is what makes identities hard and Fourier theory impossible.
  </p>

  <h2>Non-right-angled triangles: the oblique geometry of the plane</h2>
  <p>
    Non-right triangles (E6.5) need the two oblique rules. The cosine rule, c² = a² + b² −
    2ab cos C, is Pythagoras with a correction term that vanishes exactly when C = 90° —
    the school theorem as a special case, not a separate fact. Worked: a = 5, b = 7, C = 60°
    gives c² = 25 + 49 − 70 × 0.5 = 39, so c = √39 ≈ 6.24. The sine rule, a/sin A = b/sin B,
    hides a deeper constant: every ratio equals 2R, the <em>diameter of the circumcircle</em> —
    the triangle is always inscribed in exactly one circle, and the sine rule is its
    equation. Complex analysis generalises both at a stroke: the complex plane's distance is
    Pythagoras, and the functions that respect it are the <strong>conformal maps</strong> —
    analytic functions preserve angles locally, bending triangles into other triangles with
    angles preserved (sides not). That is the subject's engineering face: flow around an
    aerofoil is solved by conformally mapping the aerofoil to a circle where the flow is
    easy (Joukowski, 1910), and cartographers map the sphere to the plane the same way —
    Mercator's projection is conformal, which is why compass bearings are straight lines on
    it.
  </p>
  <Widget no="8" caption="call the third side" widget="estimate" config={caObliqueEst} />
  <Widget no="9" caption="find the factor-of-two slip" widget="spot-error" config={caSineSpot} />
  <p>
    <em>Common misconception:</em> "complex numbers are a bookkeeping trick with no
    geometric meaning; the 'real' mathematics is the real numbers." The plane of complex
    numbers is arguably <em>more</em> geometric than the real line: rotation — which the real
    line cannot even express — is multiplication there. Trigonometry, waves and rotations
    become algebra; the "imaginary" axis is the direction of a quarter-turn, and the name is
    a historical apology, not a description.
  </p>

  <p>
    <em>Common misconception:</em> "e^(iπ) + 1 = 0 is a numerical coincidence — a cute
    pattern in the digits." It is a theorem with a mechanism: the exponential is defined by
    its power series, the series evaluated at iπ splits into the cosine series at π and the
    sine series at π, giving −1 + 0. The five constants meet because rotation (π) and growth
    (e) are two views of one function — the widget above runs the argument line by line.
    Calling it a coincidence is like calling the Pythagorean theorem a coincidence of the
    3-4-5 triangle.
  </p>
  <p><strong>So far:</strong> one exponential carried the identities, the waves and the quantum formalism; conformal maps extended Pythagoras and the oblique rules into the plane's geometry of flow and projection; and both misconceptions dissolved — triangles are a special case, and the imaginary axis is a quarter-turn with a bad name. What remains is the subject's engine room: rigidity theorems, residues and the zeta function.</p>

  <h2>Check yourself</h2>
  <p>Try these before moving on. Feedback follows each answer.</p>
  <ol>
    <li>Write Euler's formula and state, in one sentence, what it reveals about the exponential function.</li>
    <li>Compute (1 + i)² using the star rule — multiply moduli, add angles — and confirm the result by direct algebra.</li>
    <li>Why is e^(iπ) + 1 = 0 a theorem with a mechanism rather than a numerical coincidence?</li>
  </ol>
  <p>
    <strong>Feedback:</strong> (1) e^(iθ) = cos θ + i sin θ: the exponential function, fed an
    imaginary input, traces the unit circle — rotation was hiding inside growth all along.
    (2) The modulus of 1 + i is √2 and its argument is 45°, so the square has modulus 2 and
    argument 90° — which is 2i. Direct algebra agrees: (1 + i)² = 1 + 2i + i² = 2i. If you got
    −1 or 2, check which terms survived the i² step. (3) The exponential is defined by its
    power series, and the series evaluated at iπ splits into the cosine series at π and the
    sine series at π, giving −1 + 0. The five constants meet because rotation and growth are
    two views of one function — the widget's five panels run exactly this argument, line by
    line.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>Complex differentiability is so restrictive that analytic functions become rigid: infinitely smooth, determined by any tiny patch.</li>
    <li>Euler's formula e^(iθ) = cos θ + i sin θ marries growth to rotation — one line, five constants at the special angle.</li>
    <li>Polar form makes multiplication the star rule: multiply moduli, add angles; identities become bookkeeping.</li>
    <li>Exact values are roots of unity — solutions of zⁿ = 1 — and constructibility is a question about nested square roots (Gauss and the 17-gon).</li>
    <li>Complex exponentials are the natural alphabet of oscillation: Fourier analysis, MP3 and JPEG compression, and quantum mechanics all run on them.</li>
    <li>Conformal maps preserve angles locally — aerofoil flow and Mercator's projection are the engineering face.</li>
    <li>Liouville, the identity theorem and residues turn integration into hole-counting — the standard toolkit of theoretical physics.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    Three sibling expert lessons continue the story. <strong>Real analysis</strong> supplies the
    careful real-variable foundations this lesson kept contrasting rigidity against;
    <strong>Abstract algebra</strong> owns the roots of unity and the constructibility questions
    in their full generality; and <strong>Topology</strong> formalises the "holes" that residue
    integration counts — the same loops, promoted to a subject of their own.
  </p>

  <h2>Going deeper</h2>
  <p>
    <strong>Rigidity, quantified.</strong> Theorems that shock real-variable intuition:
    if a function is complex-differentiable once on a region, it is automatically infinitely
    differentiable there and equals its Taylor series (real calculus has smooth
    non-analytic functions, like e^(−1/x²); complex calculus has none). Liouville's theorem:
    a bounded function differentiable on the whole plane must be constant — so e^(iz) must
    blow up somewhere, and it does, along the imaginary axis. The identity theorem: zeros
    cannot hide — accumulate at any point and the function is identically zero, which is why
    one table of values pins down a whole analytic function. The maximum modulus principle:
    |f| cannot peak in the interior unless f is constant. Each is a quantitative version of
    one idea — complex differentiability is impossibly strong a condition — and together they
    make analytic functions the most predictable objects in mathematics.
  </p>
  <Widget no="10" caption="fill the blanks — rigidity" widget="cloze" config={caRigidCloze} />
  <p>
    <strong>Residues: integration as contouring.</strong> Cauchy's theorem says the integral
    of an analytic function around any closed loop is zero — so integrals detect only the
    <em>holes</em>, the points where a function blows up. Each such point carries a residue
    (the coefficient of 1/(z − z₀) in its expansion), and the residue theorem computes a loop
    integral as 2πi times the enclosed residues. This is not exotic: the Fourier transform of
    a decaying signal, the integrals behind dispersion relations in particle physics, and the
    classic ∫ (from minus infinity to infinity) of 1/(1 + x²) dx = π all fall to a one-line
    residue count. Real integrals that resist every real-variable technique surrender to
    contour deformation in the complex plane — the standard working method of theoretical
    physics.
  </p>
  <Widget no="11" caption="one loop integral, two cases — drag the divider" widget="compare" config={caResidueCompare} />
  <p>
    <strong>The Riemann hypothesis.</strong> The subject's deepest open problem lives here.
    The Riemann zeta function ζ(s) = 1 + 1/2ˢ + 1/3ˢ + … extends (analytically — this is
    where that word earns its keep) to the whole complex plane except s = 1, and its zeros
    organise the primes: Riemann (1859) showed the prime-counting function is governed by
    the zeros' positions. The hypothesis — all the non-trivial zeros lie exactly on the line
    Re(s) = 1/2 — would give the sharpest possible error bound on how evenly primes are
    distributed. It is one of the Clay Millennium Problems, verified numerically to
    astronomical heights and proved for nothing close to all cases; its resolution will run
    through the rigidity machinery this page introduced, which is why every serious
    complex-analysis course ends by pointing at it.
  </p>
  <p class="sources"><strong>Sources:</strong> Needham, Visual Complex Analysis; Ahlfors, Complex Analysis. Source text: OpenStax (https://openstax.org), CC BY 4.0 — adapted for Interactive Atlas.</p>
</TopicPage>
