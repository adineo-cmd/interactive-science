---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const seqCfg = {
  curves: [
    { expr: '2 + 3*x', label: 'arithmetic: 2 + 3n', color: '#7c3aed' },
    { expr: '2*1.4^x', label: 'geometric: 2 × 1.4ⁿ', color: '#b42318' },
  ],
  x: { min: 0, max: 10, label: 'n (term number)' },
  y: { min: 0, max: 40 },
  crossings: false,
  height: 330,
};

const gaussCfg = {
  steps: [
    { math: 'S = 1 + 2 + 3 + … + 100', note: 'Gauss, age 9, is asked to add the first hundred numbers. Brute force works; insight is faster.' },
    { math: 'S = 100 + 99 + … + 1', note: 'Write the same sum backwards underneath.' },
    { math: '2S = 101 × 100', note: 'Add vertically: every column pairs to 101, and there are 100 columns.' },
    { math: 'S = 100 × 101 / 2 = 5050', note: 'The pairing trick generalises: 1 + 2 + … + n = n(n + 1)/2 — a formula earned in three lines.' },
  ],
};

const seqFamCompare = {
  "prompt": "Two families of growth — drag the divider:",
  "before": {
    "label": "arithmetic",
    "text": "adds a fixed amount each step — steady, linear, predictable (savings with a flat bonus)"
  },
  "after": {
    "label": "geometric",
    "text": "multiplies by a fixed factor — slow at first, then unstoppable (compound interest)"
  },
  "why": "Every 'exponential surprise' — in finance, epidemics, technology adoption — is this picture: the compounding curve hides below the line, then pulls away without limit."
};

const seq100Est = {
  "prompt": "The sequence 5, 8, 11, 14, … has nth term 3n + 2. Roughly what is the 100th term?",
  "unit": "",
  "answer": 302,
  "factor": 1.1,
  "why": "3 × 100 + 2 = 302 — the position-to-term rule answers 'what is the 100th term?' in one line, no walking required.",
  "context": "the first term, plus (n − 1) steps of size d"
};

const seqMemberBranch = {
  "root": "Is 100 a term of 5, 8, 11, 14, …? Solving 3n + 2 = 100 gives n = 32⅔. What is the verdict?",
  "nodes": {
    "start": {
      "text": "Pick the honest answer:",
      "choices": [
        {
          "label": "Yes — n exists, so it is a term",
          "next": "no",
          "feedback": "No: n must be a whole number — 32⅔ is not a position in the sequence."
        },
        {
          "label": "No — n is not a whole number, so 100 is not a term",
          "next": "right",
          "feedback": "Right — the nth term is also a membership test: only whole-number n count."
        },
        {
          "label": "Yes — round n up to 33",
          "next": "round",
          "feedback": "Rounding is illegal here: term 33 is 101, not 100."
        }
      ]
    },
    "no": {
      "text": "A position number cannot be two-thirds of anything."
    },
    "right": {
      "text": "'Which term equals 50?' — the term-to-term rule cannot say; the nth term answers in one line."
    },
    "round": {
      "text": "The sequence steps 5, 8, 11, … never lands on 100."
    }
  },
  "why": "The nth term answers 'where is any term?' directly — and membership too."
};

const seqQuadCloze = {
  "text": "The sequence 2, 3, 6, 11, 18 has differences 1, 3, 5, 7 — a second difference constant at %%0%%. That constant second difference certifies a quadratic nth term with a equal to %%1%% the second difference.",
  "answers": [
    [
      "2",
      "two"
    ],
    [
      "half",
      "½",
      "0.5"
    ]
  ],
  "hint": "The gap between the gaps, and what fraction of it becomes the leading coefficient."
};

const seqClassicMatch = {
  "prompt": "Pair each classic sequence with its description:",
  "pairs": [
    {
      "left": "triangular numbers 1, 3, 6, 10",
      "right": "dots stacked in triangles; nth term n(n+1)/2"
    },
    {
      "left": "Fibonacci 1, 1, 2, 3, 5, 8",
      "right": "each term the sum of the previous two"
    },
    {
      "left": "the golden ratio φ",
      "right": "the limit of Fibonacci's consecutive-term ratio, 1.618…"
    }
  ],
  "why": "Fibonacci models genuinely recursive processes — rabbit populations, branching plants, spiral shells."
};

const seqBacteriaEst = {
  "prompt": "500 bacteria double every 20 minutes. Roughly how many after 2 hours?",
  "unit": "",
  "answer": 32000,
  "factor": 1.2,
  "why": "Six doublings: 500 × 2⁶ = 32,000 — the exponent counts the steps taken, not the term number.",
  "context": "the same rule runs depreciation in reverse: 20,000 × 0.85ⁿ"
};

const seqChessSpot = {
  "prompt": "One of these claims about the chessboard rice is wrong — click it:",
  "lines": [
    "Total = (2⁶⁴ − 1)/(2 − 1) = 2⁶⁴ − 1 ≈ 1.8 × 10¹⁹ grains.",
    "About 1.2 trillion tonnes of rice.",
    "More than two thousand times the modern annual world harvest.",
    "Each term of a doubling sequence is less than the sum of all its predecessors."
  ],
  "errorLine": 3,
  "correction": "Each term of a geometric sequence with ratio above 1 exceeds the sum of all its predecessors — the 64th square holds more than squares 1 through 63 combined.",
  "why": "Most of any doubling's total arrives in its final steps — the mathematical shape of the word 'suddenly'."
};

const seqGaussOrder = {
  "prompt": "Rebuild Gauss's three moves — what comes first:",
  "items": [
    "Write the sum 1 + 2 + … + 100 forwards",
    "Write it backwards underneath",
    "Add the columns — every pair sums to 101",
    "Halve: 100 × 101 ÷ 2 = 5,050"
  ],
  "why": "Nothing here is special to 100: the same three lines give the general formula n(n + 1)/2 that the triangular numbers were quietly using all along."
};

const seqSteadyEst = {
  "prompt": "A patient takes 200 mg of a drug daily; the body clears 60% each day (r = 0.4). Roughly what steady-state level does the amount on board approach?",
  "unit": "mg",
  "answer": 333,
  "factor": 1.2,
  "why": "a/(1 − r) = 200/0.6 ≈ 333 mg — infinitely many doses, finite accumulation, which is why dosing schedules are designed the way they are.",
  "context": "the first dose sometimes starts with a 'loading' amount"
};

const seqHarmJudge = {
  "statement": "If a series' terms tend to zero, the series must sum to something finite.",
  "answer": false,
  "why": "Terms tending to zero is necessary but not sufficient — the harmonic series 1 + ½ + ⅓ + … diverges, passing 10 only after about 12,000 terms."
};
---
<TopicPage slug="subjects/math/intermediate/sequences-and-series">

  <h2>Where you are, and what you will learn</h2>
  <p>
    This is an intermediate Mathematics lesson. It assumes the foundational Linear Functions
    lesson (arithmetic sequences are those straight lines met term by term), Quadratics
    (quadratic sequences will hand the parabola logic back to you), and Ratios, Percentages
    and Proportion (multiplicative change is what geometric sequences formalise). If you can
    substitute into a formula and solve a simple equation, you are ready.
  </p>
  <p>By the end you will be able to:</p>
  <ul>
    <li>find the nth term of arithmetic, geometric and quadratic sequences, and use it to test membership;</li>
    <li>sum an arithmetic series with the pairing trick, and a geometric series with shift-and-subtract;</li>
    <li>decide when an infinite geometric series converges, and compute its sum;</li>
    <li>translate growth and decay problems — bacteria, depreciation, drug accumulation — into sequence terms;</li>
    <li>recognise the triangular numbers, the Fibonacci sequence and the harmonic series on sight.</li>
  </ul>

  <h2>The idea</h2>
  <p>
    A sequence is a list with a rule; a <strong>series</strong> is what happens when you add the
    list up. The rule is the whole subject: describe term 1, term 2, term 3 — and the right
    description lets you leap straight to term 1,000,000 without computing anything in between.
    Two families dominate everything. <strong>Arithmetic sequences</strong> add a fixed amount
    each step — steady, linear, predictable. <strong>Geometric sequences</strong> multiply by a
    fixed factor — slow at first, then unstoppable. The difference between them is the
    difference between savings with a flat bonus and savings with compound interest: the plot
    below is that comparison, drawn to scale.
  </p>
  <Widget no="12" caption="arithmetic versus geometric — drag the divider" widget="compare" config={seqFamCompare} />

  <Widget no="1" caption="linear vs multiplicative growth — the geometric curve is barely visible until suddenly it isn't" widget="plotter" config={seqCfg} />
  <p>
    <strong>What to notice:</strong> both curves start together, and for the first few terms
    the red geometric curve (multiplying by 1.4 each step) stays under the purple line (adding
    3 each step). Follow the axes right instead: the compounding curve crosses over and then
    pulls away without limit, while the line keeps growing by the same 3 forever. Where that
    crossover lands is the whole content of the phrase "exponential surprise".
  </p>

  <p>
    The arithmetic line (purple) overtakes early and looks comfortable. The geometric curve
    (red) hides below it for years, then doubles past it. Every "exponential surprise" — in
    finance, epidemics, technology adoption — is this picture, and the formulas in this chapter
    are its exact bookkeeping.
  </p>

  <h2>Naming the terms: the nth term</h2>
  <p>
    Sequences can be described two ways. A <strong>term-to-term rule</strong> says how to get
    the next term from the current one ("add 3") — easy to continue, terrible for jumping ahead.
    A <strong>position-to-term rule</strong> (the <em>nth term</em>) gives each term from its
    position number n directly — the tool that lets you answer "what is the 100th term?" in one
    line. For an arithmetic sequence with first term a and common difference d, the nth term is
    <strong>a + (n − 1)d</strong>: the first term, plus (n − 1) steps of size d. Worked example:
    the sequence 5, 8, 11, 14, … has a = 5, d = 3, so nth term = 3n + 2; the 100th term is
    302. The nth term is also a test for membership: is 100 in the sequence? Solve 3n + 2 =
    100 → n = 32⅔, not a whole number, so no. (For a decreasing sequence d is negative:
    100, 93, 86, … has nth term 107 − 7n, which also answers the practical question "when does
    it go negative?" — at n = 16.)
  </p>
  <Widget no="11" caption="call the 100th term" widget="estimate" config={seq100Est} />
  <Widget no="10" caption="the membership test" widget="branch" config={seqMemberBranch} />
  <p>
    <strong>Quadratic sequences</strong> arise when the <em>differences</em> change by a fixed
    amount: 2, 3, 6, 11, 18, … has differences 1, 3, 5, 7 (second difference constant 2). The
    constant second difference certifies a quadratic nth term of the form an² + bn + c, with
    a = half the second difference. Here: a = 1, and fitting gives n² − 2n + 2. Check: n = 4
    gives 16 − 8 + 2 = 6. ✓
  </p>
  <Widget no="9" caption="fill the blanks — the quadratic sequence's certificate" widget="cloze" config={seqQuadCloze} />
  <p><em>Common misconception:</em> the "add 3 each time" rule and the "3n + 2" formula are
  interchangeable. They answer different questions: the term-to-term rule tells you how to walk
  to the next term; the nth term tells you where any term <em>is</em>. Confusing them produces
  the classic wrong answer to "which term equals 50?" — the term-to-term rule cannot say, and
  "add 3 until you pass it" is not mathematics. Finding the nth term from a table (compare the
  sequence with the multiples of the common difference, then adjust the constant) is a
  five-second skill worth drilling until it is automatic.</p>
  <p>
    Two classics deserve their names. The <strong>triangular numbers</strong> 1, 3, 6, 10, 15
    (dots stacked in triangles; nth term n(n+1)/2) reappear below as the sums of the naturals.
    The <strong>Fibonacci sequence</strong> 1, 1, 2, 3, 5, 8, 13 is <em>recursive</em> — each
    term is the sum of the previous two — and models genuinely recursive processes: rabbit
    populations (Fibonacci's original 1202 puzzle), branching plants, spiral shells. Its
    consecutive-term ratio 1.618… (the golden ratio φ) is the limit the sequence is forever
    approaching.
  </p>
  <Widget no="8" caption="pair each classic with its story" widget="match" config={seqClassicMatch} />

  <p>
    <strong>Geometric sequences</strong> have an nth term too, and indexing is where care is
    needed: starting from a and multiplying by r, after (n − 1) steps you are at
    <strong>a·rⁿ⁻¹</strong> — the exponent counts the steps taken, not the term number. Worked
    example: 500 bacteria double every 20 minutes. After 2 hours, six doublings have happened:
    500 × 2⁶ = 32,000. The same rule runs depreciation in reverse: a £20,000 car losing 15% of
    its value per year is worth 20,000 × 0.85ⁿ after n years — £10,047 after 5, and under
    £10,000 from year 5 onward (solve 0.85ⁿ = 0.5 and n ≈ 4.3, then round <em>up</em> to a whole
    year). Sequences are how "3% a year" becomes a decision.
  </p>
  <Widget no="7" caption="call the colony after 2 hours" widget="estimate" config={seqBacteriaEst} />
  <p><em>Common misconception:</em> a doubling process spreads its growth evenly, so the last chessboard square holds only a little more rice than the one before. Each term of a geometric sequence with ratio above 1 actually exceeds the sum of all its predecessors: the 64th square holds 2⁶³ grains, more than squares 1 through 63 combined. Most of any doubling's total arrives in its final steps — the mathematical shape of the word "suddenly".</p>
  <p>
    <strong>So far:</strong> nth-term rules for arithmetic, quadratic and geometric sequences
    now let you land on any term directly — and answer membership questions the term-to-term
    rule cannot. The next question costs more: what do the first n terms add up to?
  </p>

  <h2>Series I: the pairing trick</h2>
  <p>
    A series asks for a <em>partial sum</em>: add the first n terms. Brute force works and is
    boring; structure works and is beautiful. The archetype is the story of Gauss, asked as a
    schoolboy to add 1 through 100:
  </p>
  <Widget no="6" caption="rebuild Gauss's pairing trick" widget="order" config={seqGaussOrder} />

  <Widget no="2" caption="Gauss's pairing trick — the sum of 1 to 100 in three moves" widget="equationStep" config={gaussCfg} />
  <p>
    <strong>What to notice:</strong> the three moves — write the sum backwards underneath, add
    the columns, halve — are the entire proof, and every column pairing to the same 101 is the
    reason it works. Nothing here is special to 100: replace the last term and the same three
    lines give the general formula n(n + 1)/2 that the triangular numbers were quietly using
    all along.
  </p>

  <p>
    The general recipe is the same: write the sum forwards and backwards, add, halve. For any
    arithmetic series, <strong>S = n × (first + last)/2</strong> — the average of the first and
    last terms, times how many there are. Worked example: a theatre has 18 rows with 24 seats in
    the front row and each row two more than the row in front. Last row: 24 + 17 × 2 = 58.
    Total seats = 18 × (24 + 58)/2 = 18 × 41 = <strong>738</strong>. Three numbers, no addition
    chain.
  </p>
  <p>
    <strong>So far:</strong> pairing the sum forwards against backwards turns any arithmetic
    series into the average of first and last terms, times the count — Gauss's trick,
    generalised. Geometric series refuse that pairing, so the next section needs a different
    piece of structure.
  </p>

  <h2>Series II: geometric sums and the doubling trap</h2>
  <p>
    Geometric series (a + ar + ar² + …) can't be paired the same way, but they yield to a
    shift-and-subtract: multiply the whole sum by r, subtract, and everything cancels except
    the ends, giving <strong>S = a(rⁿ − 1)/(r − 1)</strong> for r ≠ 1. Worked example, the
    chessboard legend: one grain on square 1, doubling each square to 64. Total =
    (2⁶⁴ − 1)/(2 − 1) = 2⁶⁴ − 1 ≈ 1.8 × 10¹⁹ grains — about 1.2 trillion tonnes of rice,
    more than two thousand times the modern annual world harvest. The vizier who "asked for so
    little" was doing exponential arithmetic with the palace's future.
  </p>
  <Widget no="5" caption="find the doubling error" widget="spot-error" config={seqChessSpot} />
  <p>
    The same formula, run forward, is the mathematics of <strong>compound interest</strong> and
    <strong>debt</strong>. £1,000 at 20% annual interest becomes 1000 × 1.2ⁿ: after 10 years
    £6,192, after 25 years £95,396. The geometric series with r above 1 has no finite sum, and
    no finite patience — which is the mathematical voice behind every minimum-payment warning on
    a credit card statement.
  </p>
  <p>
    <strong>So far:</strong> shift-and-subtract sums the geometric series, and the same formula
    run forward is the arithmetic of compound interest and debt — growth with no finite sum.
    The last twist: what happens when the ratio shrinks instead of grows.
  </p>

  <h2>Series III: when infinity adds up to something finite</h2>
  <p>
    Here is the strangest and most useful fact in the chapter. Halve something repeatedly:
    ½ + ¼ + ⅛ + … Each term is smaller than the last, and the running total creeps toward a
    limit: <strong>S = a/(1 − r)</strong> whenever |r| is under 1. With a = ½, r = ½: the sum
    is exactly 1 — a whole pizza eaten in infinitely many bites. This single formula dissolves
    <strong>Zeno's paradox</strong> (Achilles "never" catches the tortoise because the gap
    halves forever — but 1 + ½ + ¼ + … = 1, so the infinitely many steps take finite time), and
    it converts <strong>recurring decimals</strong> into fractions mechanically: 0.727272… =
    72/100 + 72/100² + … = (72/100)/(1 − 1/100) = 72/99 = 8/11.
  </p>
  <p>
    The convergence formula also runs medicine. A patient takes 200 mg of a drug each day, and
    each day the body clears 60% (so 40% survives, r = 0.4). The amount "on board" just after
    the nth dose is a geometric sum approaching the <strong>steady state</strong> a/(1 − r) =
    200/0.6 ≈ 333 mg. Infinitely many doses, finite accumulation — this is why dosing
    schedules are designed the way they are, and why the first dose sometimes starts with a
    "loading" amount.
  </p>
  <Widget no="4" caption="call the steady state" widget="estimate" config={seqSteadyEst} />
  <p><em>Common misconception:</em> "adding infinitely many numbers must give infinity." It
  depends entirely on whether the terms shrink fast enough — which is exactly what |r| under 1
  certifies. The reverse error is subtler and more famous: a <em>harmonic</em> series' terms
  1 + ½ + ⅓ + ¼ + … shrink to zero yet the sum diverges (it passes 10 only after about
  12,000 terms). Terms tending to zero is <strong>necessary but not sufficient</strong> for a
  finite sum — a distinction that shapes all of higher analysis.</p>
  <Widget no="3" caption="true or false — the harmonic trap" widget="judge" config={seqHarmJudge} />

  <h2>Check yourself</h2>
  <p>Try these before moving on. Feedback follows each answer.</p>
  <ol>
    <li>Is 164 a term of the sequence 4, 7, 10, 13, …? Answer with the nth term, not by counting.</li>
    <li>A theatre's rows run 20, 23, 26, … seats for 15 rows. How many seats in total?</li>
    <li>A painkiller leaves 30% of its blood concentration after each day, and a 100 mg dose is taken daily. What steady-state level does the body approach?</li>
  </ol>
  <p>
    <strong>Feedback:</strong> (1) The nth term is 3n + 1; solving 3n + 1 = 164 gives n =
    54.33, not a whole number, so no. (2) Last row: 20 + 14 × 3 = 62; total = 15 × (20 + 62)/2
    = 15 × 41 = 615. (3) A geometric accumulation with ratio 0.3 approaches a/(1 − r) =
    100/0.7, about 143 mg — the same steady-state logic as the dosing example, and the reason
    loading doses exist.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>A sequence is a list with a rule; the nth term answers "where is any term?" directly — and membership too.</li>
    <li>Arithmetic sequences add a fixed step, with nth term a + (n − 1)d; geometric ones multiply, with nth term a·r^(n−1) — the exponent counts steps.</li>
    <li>A constant second difference certifies a quadratic nth term, with a equal to half that difference.</li>
    <li>Pairing sums arithmetic series: S = n × (first + last)/2 — Gauss's trick, generalised.</li>
    <li>Shift-and-subtract sums geometric series; with ratio above 1, the growth outruns any finite budget.</li>
    <li>An infinite geometric series converges to a/(1 − r) when |r| is under 1 — Zeno, recurring decimals and drug steady states in one formula.</li>
    <li>Terms tending to zero is necessary but not sufficient: the harmonic series diverges.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    The sibling Exponentials and Logarithms lesson makes the geometric curve continuous, and
    the Derivative lesson opens the calculus this chapter's sums are edging toward — area under
    a curve as the limit of exactly such sums. Counting and Combinatorics picks up the other
    discrete thread.
  </p>

  <h2>Going deeper</h2>
  <p>
    <strong>A sequence is a function in disguise.</strong> Plot aₙ against n — as the widget at
    the top of this page does — and the sequence becomes a graph: arithmetic sequences are
    straight lines (gradient = common difference), geometric ones are exponential curves, the
    Fibonacci sequence curves like φⁿ. This is the syllabus's "graphs of functions" strand seen
    from a new angle: a sequence is a function whose domain is the whole numbers, and every
    graph-reading skill (intercepts, growth rates, asymptotes) transfers. The continuity between
    discrete and continuous — sum over steps versus area under curve — is exactly the seam that
    integral calculus stitches.
  </p>
  <p>
    <strong>Sigma notation, briefly.</strong> Σ is series-writing shorthand: Σ 3n+2 from n=1 to
    100 means "add up 3n + 2 for each n from 1 to 100" — the 5, 8, 11 sequence's sum, computable
    as 100 × (5 + 302)/2 = 15,350. Sigma is a container, not a new idea; fluency in reading it
    is what the advanced tier builds on.
  </p>
  <p>
    <strong>Alternating series and the power of the minus sign.</strong> Take r negative: 1 − ½
    + ¼ − ⅛ + … = 1/(1 − (−½)) = ⅔. The sum converges faster than the all-positive version and
    oscillates on the way — overshooting, undershooting, closing in. This is the mechanism
    behind Fourier series (any periodic signal as a sum of alternating waves) and behind
    numerical methods that "bracket" an answer. Convergence with signs is gentler than
    convergence without them — a fact with an entire calculus chapter attached.
  </p>
  <p>
    <strong>Fractals: geometry by infinite series.</strong> The Koch snowflake starts as a
    triangle; replace the middle third of every edge with a bulge, forever. The perimeter is a
    geometric series with ratio 4/3 — it <strong>diverges</strong>: the boundary is infinitely
    long. The area is a geometric series with ratio 4/9 — it <strong>converges</strong> to
    exactly 8/5 of the original triangle. So the snowflake encloses a finite area with an
    infinite edge: a shape with fractional dimension (log 4/log 3 ≈ 1.26). Zeno's paradox,
    rebuilt as coastlines and computer graphics.
  </p>
  <p>
    <strong>Sums of powers, and where it all goes.</strong> The pairing trick generalises to a
    family of formulas: Σn = n(n+1)/2, Σn² = n(n+1)(2n+1)/6, Σn³ = (n(n+1)/2)² — note that last
    one: the sum of the first n cubes is the <em>square</em> of the nth triangular number, a
    pattern nobody would guess and everybody can verify (1 + 8 + 27 = 36 = 6²). These formulas
    are the computational bedrock of integral calculus: the area under a curve is defined as the
    limit of exactly such sums. The sequence-to-series story doesn't end here; it becomes
    analysis — and the advanced and expert tiers pick up precisely where the harmonic series
    leaves off, at the border between "terms die out" and "the sum settles".
  </p>
  <p class="sources"><strong>Sources:</strong> OpenStax, Algebra and Trigonometry (ch. 9, Sequences and Series); Stewart, Precalculus; Havil, Nonplussed! (harmonic series, Koch snowflake); standard treatments of Zeno's paradoxes. Source text: OpenStax (https://openstax.org), CC BY 4.0 — adapted for Interactive Atlas.</p>
</TopicPage>
