---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const modalCfg = {
  steps: [
    { math: '1 · Necessity vs possibility', note: 'Necessary: true in all possible worlds (2+2=4). Possible: true in at least one (you could have been a chef). Contingent: true here, false elsewhere (the Eiffel Tower\'s location).' },
    { math: '2 · Possible worlds as a tool', note: 'Kripke semantics (1959, at age 19): model necessity/possibility with "accessibility" between worlds. Rigorous mathematics replaced vagueness — modal logic became a working instrument.' },
    { math: '3 · What it unlocked', note: 'Deontic logic (obligation/permission in law), temporal logic (always/eventually — used in program verification), epistemic logic (knowledge/belief), and counterfactual reasoning (Stalnaker/Lewis semantics for "if...had been").' },
    { math: '4 · Real applications in computing', note: 'Modal logic verifies hardware and protocols: "from every reachable state, the system never deadlocks" is a modal claim, checked exhaustively (model checking — Clarke, Emerson, Sifakis, Nobel-adjacent Turing Award 2007).' },
  ],
};

const modalQuiz = {
  questions: [
    {
      q: "Using the duality of box and diamond, ◇¬p is equivalent to which formula?",
      choices: ["□p", "¬□p", "¬□¬p", "□¬p"],
      answer: 1,
      why: "◇¬p says p fails somewhere, which is exactly the negation of □p (p holds everywhere). The full pair: □p = ¬◇¬p and ◇p = ¬□¬p — necessity and possibility are two readings of one relation.",
    },
    {
      q: "Which frame condition makes the axiom □p → p valid?",
      choices: [
        "Transitivity (if w sees v and v sees u, then w sees u)",
        "Reflexivity (every world sees itself)",
        "Symmetry (access runs both ways)",
        "None — it is valid on every frame",
      ],
      answer: 1,
      why: "On a reflexive frame the actual world sees itself, so anything necessary at w must be true at w. That axiom is T, and the correspondence between axioms and frame conditions is the theorem that made modal logic a working science.",
    },
    {
      q: "What does Plantinga's free will defence actually claim to establish about God and evil?",
      choices: [
        "That every evil has a compensating good",
        "That the existence of God is probable given evil",
        "That the set {God exists, evil exists} is logically consistent — defeating the logical problem",
        "That evil does not really exist",
      ],
      answer: 2,
      why: "A defence needs only possibility, not probability. If a world with God and free creatures who do wrong is coherent, the atheist's charge of formal contradiction fails — a much weaker but sufficient result, argued with explicit possible-worlds machinery.",
    },
  ],
};

const modalStatusSort = {
  "prompt": "Worlds, not confidence — file each claim by its modal status:",
  "buckets": [
    "necessary — true in all possible worlds",
    "contingent — true here, false elsewhere",
    "impossible — true in no world"
  ],
  "items": [
    {
      "label": "2 + 2 = 4",
      "bucket": 0
    },
    {
      "label": "\"water is H₂O\" — discovered by chemistry, yet fixed across every world with water",
      "bucket": 0
    },
    {
      "label": "\"there are nine planets\"",
      "bucket": 1
    },
    {
      "label": "the Eiffel Tower standing in Paris",
      "bucket": 1
    },
    {
      "label": "a square circle",
      "bucket": 2
    }
  ],
  "why": "Modal status is a fact about how a claim sits across possible worlds, not about how confident anyone is in it — the two \"could it have been otherwise?\" questions look grammatically identical but differ totally in answer."
};

const modalEpistemicSpot = {
  "prompt": "One line of this student's gloss on modal status is wrong — click it:",
  "lines": [
    "\"Necessary\" means very well established; \"possible\" means not yet ruled out.",
    "Everyday speech uses \"must\" and \"might\" for confidence, not for worlds.",
    "\"There are nine planets\" was once as certain as arithmetic — and still necessary.",
    "\"Water is H₂O\" was a chemical discovery, yet once true it is necessary.",
    "Modal status is about how a claim sits across possible worlds, not about confidence."
  ],
  "errorLine": 2,
  "correction": "It was once as certain as arithmetic — and turned out contingent through and through. Certainty is no guide to modal status; only worlds decide it.",
  "why": "Both swaps trade a claim about worlds for one about our evidence — the classic beginner error this section dismantles."
};

const modalAxiomMatch = {
  "prompt": "Each axiom of modal logic is equivalent to a condition on accessibility — pair them:",
  "pairs": [
    {
      "left": "T (□p → p)",
      "right": "reflexive frames — each world counts as accessible from itself"
    },
    {
      "left": "4 (□p → □□p)",
      "right": "transitive frames — accessibility carries through"
    },
    {
      "left": "5 (◇p → □◇p)",
      "right": "Euclidean frames"
    },
    {
      "left": "D (the deontic reading)",
      "right": "obligation implies permission — instead of T"
    }
  ],
  "why": "The correspondence between axioms and frame conditions made modal logic a working science: S4 is T + 4, and S5 — necessity absolute across all worlds — is T + 4 + 5."
};

const modalWorldsCompare = {
  "prompt": "Drag the divider between the two readings of possible worlds:",
  "before": {
    "label": "Tools, not planets",
    "text": "Abstract representations of complete ways things could have been — devices for tracking consequence. Nobody must believe other worlds exist; the semantics is an exact instrument."
  },
  "after": {
    "label": "Lewis's modal realism",
    "text": "David Lewis's audacious claim: the worlds really exist — concrete, spatiotemporally isolated from ours. Whether they exist or are mere devices is a separate metaphysical dispute; the logic runs identically either way."
  },
  "why": "Not distant planets or parallel universes a physicist might discover — actualism versus modal realism is a dispute the logic itself never settles."
};

const modalOntoBranch = {
  "root": "The modern ontological argument is valid. Everything collapses onto one premise — walk the wager.",
  "nodes": {
    "start": {
      "text": "Premise (1): possibly, a maximally great being exists. Your call?",
      "choices": [
        {
          "label": "Affirm the possibility",
          "next": "theist"
        },
        {
          "label": "Deny it — maximality is incoherent, like a square circle",
          "next": "atheist"
        }
      ]
    },
    "theist": {
      "text": "Then (2) maximal greatness, if instantiated in any world, is instantiated in every world — these properties do not depend on luck — so (3) the being exists in the actual world.",
      "choices": [
        {
          "label": "See the atheist's exit",
          "next": "atheist"
        }
      ]
    },
    "atheist": {
      "text": "The atheist denies the possibility — not that the argument is invalid, nor even that theism is contradictory, but that maximality itself cannot be instantiated. The wager is now explicit: the argument is exactly as strong as premise (1).",
      "choices": []
    }
  },
  "why": "Modal logic transformed a squabble about \"conceiving\" into a single, clearly stated wager — atheists deny the possibility, theists affirm it, and everyone can see it."
};

const modalKalamOrder = {
  "prompt": "Rebuild the Kalām argument, then the objection it must face:",
  "items": [
    "Whatever begins to exist has a cause",
    "The universe began to exist",
    "So the universe has a cause",
    "Hume and Russell press back: why not the universe as a whole necessary?"
  ],
  "why": "If sound, the cosmological family establishes a necessary being — and then all the work moves to identifying it with the personal God of theism. Aquinas conceded the argument gives no acquaintance with God's nature."
};

const modalEvilSort = {
  "prompt": "File each move in the design-and-evil dialectic:",
  "buckets": [
    "arguments for theism",
    "challenges to theism",
    "replies on theism's behalf"
  ],
  "items": [
    {
      "label": "Paley's watch — intricate spatial order implies a designer",
      "bucket": 0
    },
    {
      "label": "Swinburne's Bayesian case from temporal order — the laws themselves",
      "bucket": 0
    },
    {
      "label": "Mackie's inconsistent triad — God and evil cannot coexist",
      "bucket": 1
    },
    {
      "label": "Rowe's fawn burning slowly in a forest fire no one ever sees",
      "bucket": 1
    },
    {
      "label": "Plantinga's free will defence — transworld depravity keeps the world possible",
      "bucket": 2
    },
    {
      "label": "Hick's soul-making theodicy — evil as the price of the vale",
      "bucket": 2
    }
  ],
  "why": "Since consistency suffices to defeat the logical problem, most philosophers concede that round to the theist and fight on evidential ground — where Hick's soul-making reply carries a probabilistic burden."
};

const modalDefenceJudge = {
  "statements": [
    {
      "s": "Plantinga's free will defence proves that free will explains evil.",
      "truth": false,
      "why": "It claims neither that nor that God remains probable despite evil — a defence needs only possibility."
    },
    {
      "s": "Logical consistency alone defeats the logical problem of evil.",
      "truth": true,
      "why": "If a world with significantly free creatures, some of whom choose wrongly in some circumstances, is possible, the inconsistent triad fails."
    },
    {
      "s": "The defence also answers Rowe's evidential problem — the fawn, the quantity of suffering.",
      "truth": false,
      "why": "The evidential problem is untouched by it; there Hick's soul-making theodicy carries a different, probabilistic burden."
    },
    {
      "s": "Most philosophers now concede the logical round to the theist.",
      "truth": true,
      "why": "Consistency suffices against the logical problem — so the fight moves to evidential ground."
    }
  ]
};
---
<TopicPage slug="subjects/philosophy/advanced/modal-logic">

  <h2>Where you are, and what you will learn</h2>
  <p>
    This lesson is the formal capstone of the tier. It assumes the tools of the foundational <em>Logic: The Shape
    of an Argument</em> — validity, soundness, quantifiers — and the questions opened by <em>Metaphysics: What Is
    Real?</em> and <em>Epistemology: What Can We Know?</em>, because possibility, necessity and what we can know of
    them sit exactly where those subjects meet.
  </p>
  <p>By the end you will be able to:</p>
  <ul>
    <li>classify statements as necessary, contingent or impossible, and express possibility with box, diamond and negation;</li>
    <li>translate between modal formulas using the duality □p = ¬◇¬p;</li>
    <li>explain Kripke semantics — worlds, accessibility — and the correspondence between axioms (T, 4, 5) and frame conditions;</li>
    <li>recast the ontological, cosmological and design arguments, and the problem of evil, as modal claims;</li>
    <li>say precisely what Plantinga's free will defence does and does not claim.</li>
  </ul>

  <h2>The idea</h2>
  <p>
    Every argument you have studied so far was extensional — true or false, full stop. But the most important
    things we say are <strong>modal</strong>: what <em>must</em> be, what <em>could have been</em>, what is
    <em>bound to happen</em>, what is <em>permissible</em>. Modal logic gives these notions a formal grammar,
    and Kripke's semantics (1959) gave it a rigorous model. It is the natural capstone of this tier because it
    is also the arena where the classical arguments for God's existence — the syllabus's ontological,
    cosmological and design arguments, and the problem of evil — are stated at full strength: they are, at
    bottom, claims about what is possible and what is necessary, and modal logic lets us say <em>exactly</em>
    what each one commits us to.
  </p>

  <Widget no="1" caption="the machinery and where it actually runs" widget="equationStep" config={modalCfg} />
  <p>
    <strong>What to notice:</strong> the cards run from vocabulary to semantics to payoff to silicon. Watch
    how "possible" tightens as you read: it never means "I do not know yet" — it means true in at least one
    complete alternative world. That discipline lets the same grammar run law, time, knowledge and chip
    verification.
  </p>
  <p>
    <strong>So far:</strong> modal notions are everywhere, and informal handling breeds confusion. The next
    section gives them a notation and the first skill — classifying claims by modal status.
  </p>

  <h2>Boxes and diamonds: the modal language</h2>
  <p>
    Take ordinary propositional logic and add one operator. <strong>□p</strong> ("box p") reads: p is
    necessary — true in all possible worlds. <strong>◇p</strong> ("diamond p") reads: p is possible — true in
    at least one. They are duals, defined in terms of each other: □p is equivalent to ¬◇¬p (p could not have
    failed), and ◇p to ¬□¬p. A <strong>contingent</strong> truth is one that is true here while ◇¬p also
    holds — the Eiffel Tower stands in Paris, but it could have stood in Brussels: both facts obtain in
    different possible worlds, so its location is a contingent matter. Classifying
    statements this way is the first real skill: 2 + 2 = 4 is necessary (and knowable a priori); "water is H₂O"
  is necessary (true in every world with water) yet known a posteriori — Kripke's celebrated
    <strong>necessary a posteriori</strong>; "there are nine planets" turned out contingent through and through.
    The modal status of a claim is a metaphysical question the surface grammar hides: "could water not have
    been H₂O?" and "could the Eiffel Tower have been in Brussels?" look grammatically identical but differ
    totally in answer.
  </p>
  <Widget no="3" caption="file each claim by modal status" widget="sort-buckets" config={modalStatusSort} />
  <p><em>Common misconception:</em> "necessary means very well established, and possible means not yet ruled
  out." Both swap a modal notion for an epistemic one — a claim about worlds for one about our evidence; everyday
  speech uses "must" and "might" for confidence. But "there are
  nine planets" was once as certain as arithmetic, yet it turned out contingent through and through; "water is
  H₂O" was a chemical discovery, yet once true it is necessary. The correct picture: modal status is a fact
  about how a claim sits across possible worlds, not about how confident anyone is in it.</p>
  <Widget no="4" caption="find the faulty line — confidence is not modality" widget="spot-error" config={modalEpistemicSpot} />
  <p>
    <strong>So far:</strong> box and diamond give necessity and possibility a working notation, and contingency a
    precise meaning. What the notation lacks is a model — what worlds are and how they relate — and that is
    exactly Kripke's contribution.
  </p>

  <h2>Kripke semantics: worlds with windows</h2>
  <p>
    Kripke's formalisation treats a possibility as a <strong>world</strong> — a complete way things might have
    gone — related to other worlds by an <strong>accessibility relation</strong>: world w can "see" world v when
    v is a genuine live alternative from w's standpoint. Then □p is true at w exactly when p is true at every
    world w sees, and ◇p when p holds at some world w sees. The payoff is a correspondence theory of rare
    elegance: <strong>each axiom of modal logic is equivalent to a condition on accessibility</strong>. The
    minimal system K accepts whatever follows. Add T (□p → p: "what is necessary is true") and validity holds
    precisely on <strong>reflexive</strong> frames — every world sees itself. Add 4 (□p → □□p) and frames must
    be <strong>transitive</strong>; S4 = T + 4. Add 5 (◇p → □◇p) and frames must be <strong>Euclidean</strong>;
    S5 — the system where necessity is absolute across all worlds — is T + 4 + 5. This is why "possible worlds"
    are a tool and not a fantasy: nobody must believe other worlds exist; the semantics is an exact instrument
    for tracking consequence.
  </p>
  <Widget no="5" caption="pair each axiom with its frame condition" widget="match" config={modalAxiomMatch} />
  <p><em>Common misconception:</em> possible worlds are not distant planets or parallel universes that
  physicists might discover. They are points in a formal space of alternatives — abstract representations of
  complete ways things could have been. Whether they <em>really exist</em> (David Lewis's audacious modal
  realism) or are mere devices (actualism) is a separate metaphysical dispute; the logic runs identically
  either way.</p>
  <Widget no="6" caption="drag the divider — two readings of possible worlds" widget="compare" config={modalWorldsCompare} />
  <p>
    The same machinery, reinterpreted, becomes other logics: read □ as <strong>obligation</strong> and you get
    deontic logic for law (with axiom D — obligation implies permission — instead of T); read it as
    <strong>always</strong> and you get temporal logic ("eventually the program halts"); as <strong>an agent
    knows</strong> and you get epistemic logic; as <strong>provable</strong> and you brush against Gödel. This
    reinterpretability is modal logic's superpower: one mathematics, many modalities.
  </p>

  <h2>The ontological argument: necessity on paper</h2>
  <p>
    Anselm (Proslogion, 1078) argued: God is "that than which nothing greater can be conceived"; such a being
    exists in the understanding even for the fool who denies God; but existing in reality is greater than
    existing merely in the understanding; therefore God exists in reality — else we could conceive of something
    greater. Gaunilo's reply turned the structure against itself: a "perfect island" existing in thought must
    therefore exist — an evidently absurd parallel (Anselm's reply: the argument is special to the maximal
    being). Kant's deeper objection: <strong>existence is not a real predicate</strong> — adding "and it
    exists" adds no property to a concept, so "greater" cannot turn on it. The modern modal versions take this
    seriously by building on <em>necessary</em> existence instead. Norman Malcolm (1960) argued that a
    maximally great being's existence would be necessary, and that necessary existence cannot be ruled
    impossible — hence, if possible, actual. Plantinga (1974) makes the machinery explicit: a maximally great
    being is one that is omnipotent, omniscient and morally perfect in <em>every</em> possible world;
    (1) possibly, a maximally great being exists; (2) maximal greatness, if instantiated in any world, is
    instantiated in every world (these properties do not depend on luck); so (3) it exists in the actual world.
    The logic is valid — the entire question collapses onto premise (1). Notice what modal logic has done: it
    has transformed a squabble about "conceiving" into a single, clearly stated wager — is a maximally great
    being <em>possible</em>? Atheists deny the possibility (perhaps maximality is incoherent, like a square
    circle); theists affirm it. The argument is now exactly as strong as that premise, and everyone can see it.
  </p>
  <Widget no="7" caption="walk the wager — is a maximally great being possible?" widget="branch" config={modalOntoBranch} />

  <h2>Cosmological arguments: contingency is the engine</h2>
  <p>
    The modal grammar also organises the cosmological family. The <strong>Kalām argument</strong> (al-Ghazālī;
    revived by William Lane Craig): whatever begins to exist has a cause; the universe began to exist;
    therefore the universe has a cause — a temporal argument about beginnings, supported by philosophical
    claims against actual infinities and by Big Bang cosmology. Aquinas's first three Ways argue from motion,
    efficient causation and — most modally interesting — <strong>contingency</strong>: things that might not
    have existed exist now; a chain of dependent things cannot explain its own holding; so something
    <em>necessary</em> must ground the whole. Leibniz sharpens this with the <strong>principle of sufficient
    reason</strong>: even an eternal series of contingent beings lacks an explanation for why there is anything
    at all — the difference between explaining each member of the chain and explaining the chain. The modal
    verdict: these arguments, if sound, establish a <strong>necessary being</strong> — and then all the work
    moves to identifying the necessary being with the personal God of theism, which Hume and Russell pressed
    hard ("why not the universe as a whole necessary?"). Aquinas himself conceded the argument gives no
    acquaintance with God's nature — an honesty worth copying.
  </p>
  <Widget no="8" caption="rebuild the Kalām argument — and its counter" widget="order" config={modalKalamOrder} />

  <h2>Design arguments and the problem of evil</h2>
  <p>
    Paley's watch (1802) is an argument from <strong>spatial order</strong>: intricate functional arrangement
    implies a designer, as watch parts do. Hume's <em>Dialogues</em> (1779) had already deployed the
    devastating analogy objection: the universe resembles less a machine than an organism, and any inference
    from an effect to a cause licenses only a cause as grand as the effect — one universe, made once, by
    possibly many imperfect designers. Darwin then supplied a non-designing mechanism for biological order.
    Swinburne's version retreats to <strong>temporal order</strong> — the laws themselves — and argues
    probabilistically (Bayesian): theism is a simpler, hence more probable, explanation of lawlike order than
    brute fact; the argument is explicitly a cumulative probability case, not a proof. The
    <strong>problem of evil</strong> runs the other way. Logical form (Mackie, 1955): God (omnipotent,
    omniscient, wholly good) and evil cannot coexist — an <em>inconsistent triad</em>. Evidential form (Rowe,
    1979): a fawn burning slowly in a forest fire no one ever sees is pointless evil that an all-good,
    all-powerful being would prevent — so theism is <em>improbable</em>. The responses are themselves modal.
    Plantinga's <strong>free will defence</strong> (1974) does not need to prove that free will explains evil,
    only that a world with significantly free creatures, some of whom always choose wrongly in some
    circumstances, is <em>possible</em> — his "transworld depravity" manoeuvre shows God may be unable to
    actualise a world of free creatures who never sin without either overriding freedom or creating different
    people. Since consistency suffices to defeat the <em>logical</em> problem, most philosophers now concede
    that round to the theist and fight on evidential ground. Hick's <strong>soul-making theodicy</strong>
    (1966, after Irenaeus) accepts the evidential problem and reframes it: a world of "epistemic distance" —
    where God is not overwhelmingly evident and real hardship exists — is the only environment in which
    genuinely free moral character can develop; evil is the price of a <em>vale of soul-making</em> rather
    than a defect. Critics reply that the quantity and distribution of suffering (cancer in toddlers) exceeds
    any plausible pedagogical need.
  </p>
  <Widget no="9" caption="file each move in the design-and-evil dialectic" widget="sort-buckets" config={modalEvilSort} />
  <p><em>Common misconception:</em> "Plantinga's free will defence proves that free will explains evil, or that
  God remains probable despite it." It claims neither. A defence needs only logical consistency: if a world with
  significantly free creatures, some of whom choose wrongly in some circumstances, is possible, the
  inconsistent triad fails and the <em>logical</em> problem of evil is defeated. Why it seems reasonable:
  "defence" sounds like an explanation of the data. The correct picture: consistency suffices against the logical
  problem — which is why most philosophers concede that round — while the evidential problem
  (Rowe's fawn, the quantity of suffering) is untouched by it, and there Hick's soul-making theodicy carries a
  different, probabilistic burden.</p>
  <Widget no="10" caption="true or false — what a defence must prove" widget="judge" config={modalDefenceJudge} />

  <h2>Check yourself</h2>
  <p>Try these before moving on. Feedback follows each answer.</p>
  <ol>
    <li>Using only box, diamond and negation, rewrite ◇p without the diamond and □p without the box. What is
    this two-way translatability called?</li>
    <li>Classify by modal status: "2 + 2 = 4"; "the Eiffel Tower stands in Paris"; "water is H₂O". Which of the
    three is known a posteriori yet necessary?</li>
    <li>The modal ontological argument is valid. Why does that not settle God's existence — and what does
    everything turn on?</li>
  </ol>
  <p>
    <strong>Feedback:</strong> (1) ◇p is ¬□¬p and □p is ¬◇¬p: each operator is definable through the other with a
    double negation — the duality. (2) The first is necessary and a priori; the second contingent; the third is
    Kripke's necessary a posteriori — true in every possible world with water, yet discovered by chemistry.
    (3) Validity only guarantees the conclusion if the premises are true, and the modern versions compress the
    whole dispute into one premise — possibly, a maximally great being exists. The atheist denies that
    possibility (perhaps maximality is incoherent, like a square circle); the theist affirms it — modal logic
    makes the wager explicit, not won.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>□p: true in all possible worlds; ◇p: true in at least one; the two are duals (□p = ¬◇¬p, ◇p = ¬□¬p).</li>
    <li>Modal status — necessary, contingent, impossible — is about worlds, not certainty.</li>
    <li>Kripke semantics: worlds plus accessibility, with each axiom (T, 4, 5) matching a frame condition (reflexive, transitive, Euclidean).</li>
    <li>One mathematics, many modalities: obligation, time, knowledge and provability reuse the same machinery, down to model checking of hardware.</li>
    <li>The modern ontological argument is valid; everything collapses onto "possibly, a maximally great being exists".</li>
    <li>Contingency powers the cosmological family; possibility alone powers the free will defence, so the logical problem of evil fails and the fight moves to evidential ground.</li>
    <li>Possible worlds are tools — points in a space of alternatives, not planets.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    <em>Language &amp; Meaning</em> supplies the other half of the machinery used here: Kripke's names and the
    necessary a posteriori grow out of that lesson's sense-and-reference work. <em>Phenomenology &amp;
    Existentialism</em> then brackets the formal method and asks what the worlds-and-propositions
    picture leaves out: the first-person situation of the one doing the supposing.
  </p>

  <h2>Going deeper</h2>
  <p>
    <strong>Quantified modal logic opens the deep waters.</strong> "Necessarily, the morning star is the
    morning star" is true; "necessarily, the morning star is the evening star" — well, de dicto it is false
    (the descriptions could pick out different things), de re it is true (the planet Venus could not have been
    a different object). This <strong>de re / de dicto</strong> ambiguity infects every modal argument, and
    Quine famously doubted that "necessity" attaches to objects at all. The <strong>Barcan formula</strong>
    (◇∃x Fx → ∃x ◇Fx) governs whether worlds may contain objects absent from ours — a technical principle
    with consequences for whether essences and possibilia are taken seriously. Gödel sketched a modal
    ontological argument formalising Leibniz's "positive properties"; in 2013–14 Christoph Benzmüller and Bruno
    Woltzenlogel Paleo ran it through automated theorem provers, confirming the modern version is valid while
    exposing an inconsistency in a close variant — logic engines auditing theology, a genuinely new kind of
    scholarly event.
  </p>
  <p>
    <strong>The computing branch is not an analogy.</strong> "From every reachable state, the system never
    deadlocks" is a modal claim — a box over all accessible states — and model checking (Clarke, Emerson,
    Sifakis; 2007 Turing Award) decides such claims exhaustively over a system's state space, using temporal
    modal logics (CTL, LTL) to verify chips and protocols whose state spaces exceed the atom count of the
    universe. <strong>The open questions</strong> are as live as philosophy gets: what, if anything, grounds
    metaphysical necessity (is "water is H₂O" necessary because of the world, or because of how the word
    "water" works — Kripke and Putnam versus the descriptivists' heirs)? Does the success of S5 suggest
    necessity is absolute, or does epistemic logic's need for non-Euclidean knowledge frames show different
    modalities need different mathematics? And can probabilistic modal logics tame arguments — design, evil —
    that are irreducibly matters of degree? The lesson of the century is that these are no longer questions of
    eloquence. They have an exact grammar, and you can now read them in it.
  </p>

