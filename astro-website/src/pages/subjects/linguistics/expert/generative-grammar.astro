---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const genCfg = {
  steps: [
    { math: '1 · Syntactic Structures (1957)', note: 'Chomsky showed English grammar could be captured by FORMAL rules generating exactly the right sentences — and demonstrated that finite state machines (the era\'s model) couldn\'t do it. Linguistics and computer science changed course together.' },
    { math: '2 · Universal grammar', note: 'The claim: children acquire language via built-in principles common to all languages (UG) — the poverty-of-stimulus argument\'s theoretical home. Parameters (head-first vs head-final, pro-drop) vary between languages like settings.' },
    { math: '3 · Principles and parameters', note: 'The 1980s programme: one universal rule system, with a handful of switches set by exposure. Explained rapid acquisition — and predicted typological clusters (the linguistics lesson on typology connects).' },
    { math: '4 · Minimalism (1995→)', note: 'Chomsky\'s latest: grammar is maximally economical — only what interface systems (sound, meaning) force. Merge (combine two things recursively) as the single core operation. Elegant; whether it succeeds is the field\'s live argument.' },
  ],
};

const ggConstitMatch = {
  "prompt": "The groupings are real — pair each diagnostic with what it shows:",
  "pairs": [
    {
      "left": "substitution — 'the old man' → 'he'",
      "right": "the string behaves as one unit: a constituent"
    },
    {
      "left": "movement — 'Which book did you read?'",
      "right": "questions lift a whole phrase"
    },
    {
      "left": "fragment answers — 'Which book? — That one.'",
      "right": "the group survives on its own"
    },
    {
      "left": "recursion — 'the rat the cat the dog chased killed ate the malt'",
      "right": "a finite rule set producing infinite sentences"
    }
  ],
  "why": "Phrase structure rules generate the groupings and recursion makes the system unbounded — Syntactic Structures' (1957) central demonstration."
};

const ggHeadCompare = {
  "prompt": "X-bar gives every phrase the same architecture — drag the divider:",
  "before": {
    "label": "English — heads first",
    "text": "The verb precedes its object: eat apples. 'Eats apples', 'fond of apples' and 'in the garden' are structurally parallel."
  },
  "after": {
    "label": "Japanese — heads last",
    "text": "ringo-o taberu — 'apple-eat'. The same skeleton, mirrored: a parametric setting, not a structural difference."
  },
  "why": "One architecture for noun, verb, adjective and preposition phrases — the 1970s generalisation, and the source of typology."
};

const ggProdropBuckets = {
  "prompt": "One setting, many consequences — file each observation:",
  "buckets": [
    "pro-drop ON — the subject may be silent",
    "pro-drop OFF — an overt subject is demanded",
    "evidence the options were available all along"
  ],
  "items": [
    {
      "label": "hablo — 'I speak' with no pronoun at all",
      "bucket": 0
    },
    {
      "label": "*'speak' as a full English clause — impossible",
      "bucket": 1
    },
    {
      "label": "rich verb agreement arrives with the setting",
      "bucket": 0
    },
    {
      "label": "free subject positioning arrives with the setting",
      "bucket": 0
    },
    {
      "label": "a bilingual French–Italian child keeps the two settings distinct from the earliest multiword speech",
      "bucket": 2
    }
  ],
  "why": "Languages vary in correlated bundles, as if switches rather than dials — and children set parameters fast and rarely revisit."
};

const ggIslandsSpot = {
  "prompt": "One line of this derivation summary breaks the constraints — click it:",
  "lines": [
    "Deep structure: every phrase sits in its base-generated position.",
    "wh-movement displaces a questioned phrase: 'What did she see?' — leaving a trace.",
    "do-support inserts the otherwise illegal auxiliary: 'Does she like it?'",
    "A question may lift any phrase out of a relative clause — movement is unconstrained.",
    "Crain and Nakayama (1987): children front the main-clause auxiliary without the linear-rule error."
  ],
  "errorLine": 3,
  "correction": "Islands block extraction: 'What did she see the report that criticised?' is impossible.",
  "why": "The constraints' specificity is the argument's workhorse: children never hear enough data to learn which infinite set of sentences is impossible, yet every speaker knows."
};

const ggHierarchyOrder = {
  "prompt": "From weakest to strongest — order the machines natural language pushes through:",
  "items": [
    "Finite-state machines: provably cannot handle English's centre-embedding",
    "Context-free grammars: handle much of it",
    "Mildly context-sensitive: Swiss German's cross-serial dependencies (Shieber, 1985) force the step up"
  ],
  "why": "Each step up the strength ladder buys exactly the embedding natural language demands — the precision parsing algorithms implement."
};

const ggCaseJudge = {
  "statements": [
    {
      "s": "In German 'Den Mann beißt der Hund', the accusative den tells you the man is the one being bitten whatever the position.",
      "truth": true,
      "why": "Rich case stamps each noun phrase with its structural role — nominative subject, accusative object, dative recipient."
    },
    {
      "s": "English lost most case marking, and the pronouns resist the loss.",
      "truth": true,
      "why": "*'him saw she' fails precisely because pronouns still compute case."
    },
    {
      "s": "The who/whom distinction is collapsing exactly where case no longer computes.",
      "truth": true,
      "why": "The residue shows where syntax still demands the marking."
    },
    {
      "s": "Position is the deep structure; case merely decorates it.",
      "truth": false,
      "why": "Case-rich languages prove the grammatical roles are real independently of position."
    }
  ]
};

const ggFregeCloze = {
  "text": "Frege's 1892 distinction: %%0%% is the thing itself; %%1%% is the mode of presentation — which is why 'the morning star' and 'the evening star' share one and not the other.",
  "answers": [
    [
      "reference",
      "referent"
    ],
    [
      "sense",
      "Sinn"
    ]
  ],
  "hint": "One is what the expression points at; the other is how it presents it.",
  "why": "Semantics' generative engine is compositionality — compute the whole from the parts — and Montague's lambda calculus turns that into truth conditions."
};

const ggImplicatureBranch = {
  "root": "Grice's maxims at work — one report, one inference, one courtroom distinction.",
  "nodes": {
    "start": {
      "text": "You told the examiner: 'Some students passed.' In fact every single one did. What did you assert?",
      "choices": [
        {
          "label": "'Not all passed' — as part of what I said",
          "next": "entail",
          "feedback": "Entailments cannot be cancelled without contradiction. Try cancelling this one."
        },
        {
          "label": "Only 'some passed' — the rest rides as an inference",
          "next": "cancel",
          "feedback": "Test by cancellation: 'Some — indeed all — of the students passed' stands without contradiction."
        }
      ]
    },
    "entail": {
      "text": "The cancellation succeeds, so 'not all' was never entailed. It was an implicature — generated by the maxim 'be informative', cancelable, not asserted.",
      "choices": [
        {
          "label": "So where does the distinction earn its keep?",
          "next": "legal"
        }
      ]
    },
    "cancel": {
      "text": "The inference 'not all' came from Grice's maxim of informativeness — implied, not stated.",
      "choices": [
        {
          "label": "Where does the distinction do real work?",
          "next": "legal"
        }
      ]
    },
    "legal": {
      "text": "Misleading by implicature versus lying by entailment — real legal and ethical work, made principled by the framework rather than intuition alone. Austin's speech acts extend it: utterances do things — promising, naming — beyond stating.",
      "choices": []
    }
  },
  "why": "Implicatures differ from entailments precisely in being cancelable — the inference is real, but it was never part of what was said."
};
---
<TopicPage slug="subjects/linguistics/expert/generative-grammar">
  <h2>Where you are, and what you will learn</h2>
  <p>
    This is the theoretical summit of the Linguistics track. How language works introduced the
    object; Syntax trees and rules taught you constituent structure; Morphology and Phonology
    gave you the word- and sound-systems; Semantics and pragmatics introduced meaning; and
    Psycholinguistics and acquisition supplied the child's-eye evidence. Generative grammar
    binds all of it into one claim — language as a formal computational system with built-in
    structure — and then defends that claim.
  </p>
  <p>By the end you will be able to:</p>
  <ul>
    <li>show that sentences have hierarchical constituent structure, using the substitution, movement and fragment tests;</li>
    <li>explain how parameters (head directionality, pro-drop) generate typological clusters rather than unstructured variety;</li>
    <li>deploy the acquisition evidence — universal stages, overregularisation, the wug test — in the poverty-of-stimulus argument, and state its strongest counter-case;</li>
    <li>use binding theory and case morphology as evidence that grammatical roles are real independently of word order;</li>
    <li>explain compositionality, ambiguity and implicature at the syntax–semantics interface, and connect the programme to the LLM frontier.</li>
  </ul>

  <h2>The idea</h2>
  <p>
    Generative grammar is <strong>Chomsky's programme: language as a formal computational system
    with built-in structure</strong> — the most influential, productive and controversial theory
    linguistics has produced. It formalised syntax as an object of rigorous study, launched the
    cognitive revolution, and set the terms every rival theory still answers. The unit's two
    topics give the chapter its shape: first the syntactic machinery itself (what the theory
    claims grammar is made of, and the arguments for innate structure), then the handover from
    syntax to semantics — where sentence structure meets sentence meaning, and where the
    programme's frontier now lies.
  </p>

  <Widget no="1" caption="from Syntactic Structures to Minimalism — six decades of the programme" widget="equationStep" config={genCfg} />
  <p>
    <strong>What to notice:</strong> the panel is the programme's intellectual biography, and
    each step answers the previous one's failure. Step 1 is the founding demonstration —
    formal rules generating exactly the right sentences, and the finite-state model that
    provably could not; step 2 draws the innateness conclusion (universal grammar) from
    acquisition's empirical floor; step 3 operationalises it as principles plus parameters;
    and step 4 strips the machinery down to a single operation, Merge, and asks whether
    economy itself can do the work. Notice what stays constant across all the revisions:
    formal rules, derivations and tests against judgements — the method, not the machinery,
    is the theory.
  </p>

  <p><strong>So far:</strong> the programme's claim is that language is a formal system with built-in structure. The first section builds the machinery itself — constituents, X-bar, parameters, movement — and assembles the arguments that this structure could not have been learned from input alone.</p>

  <h2>What syntax is made of: the machinery of lectures 11–16</h2>
  <p>
    <strong>Sentences have hierarchical structure, not word order.</strong> The foundational
    observation: words group into constituents, and the groupings are real. Tests make them
    visible: substitution ("the old man" → "he"), movement (questions lift a whole phrase:
    "Which book did you read?"), fragment answers ("Which book? — That one."). Phrase structure
    rules generate the groupings, and recursion makes the system unbounded: "the rat the cat
    the dog chased killed ate the malt" is grammatical however deep the embedding — a finite
    rule set producing infinite sentences, which was <em>Syntactic Structures</em>' (1957)
    central demonstration.
  </p>
  <Widget no="2" caption="pair each test with what it proves" widget="match" config={ggConstitMatch} />
  <p>
    <strong>X-bar: one skeleton for all phrases.</strong> The 1970s generalisation: every
    phrase (noun, verb, adjective, preposition) has the same architecture — a head, its
    complements, a specifier — so "eats apples" and "fond of apples" and "in the garden" are
    structurally parallel. Economy of machinery, and the source of typology: languages differ
    in head directionality (English heads first: <em>eat apples</em>; Japanese heads last:
    <em>ringo-o taberu</em> — "apple-eat"), a parametric difference, not a structural one.
  </p>
  <Widget no="3" caption="drag the divider — one skeleton, two mirrorings" widget="compare" config={ggHeadCompare} />
  <p>
    <strong>Parameters in action.</strong> The best-known setting is pro-drop: Spanish and
    Italian license null subjects (<em>hablo</em> — "I speak" with no pronoun), while English
    demands one (*"speak" as a full clause is impossible). The parameter has documented
    knock-on effects — rich verb agreement, free subject positioning — that cluster
    cross-linguistically, which is the theory's strongest suit: languages vary, but in
    correlated bundles, as if switches rather than dials. Acquisition work adds the
    striking detail: children set parameters fast and rarely revisit — a bilingual
    French–Italian child keeps the two settings distinct from the earliest multiword
    speech, evidence that the options (not just the settings) were already available.
  </p>
  <Widget no="4" caption="file each trait under the switch it follows" widget="sort-buckets" config={ggProdropBuckets} />
  <p>
    <strong>Acquisition as evidence.</strong> Children pass through measurable, universal
    stages: two-word telegraphese, then the functors arrive in a fixed order, and errors are
    systematic rather than random — overregularisation ("goed", "foots") shows the child
    applying a rule <em>against</em> the evidence of the irregulars they previously produced
    correctly, the U-shaped learning curve (correct → wrong → correct). Berko's 1958 "wug
    test" clinched productivity: children pluralise a nonsense word ("wug → wugs") they have
    never heard, so they possess the rule, not a memory list. All of this happens on limited,
    noisy input, with no corrections that reliably work ("I goed" corrected gets repeated) —
    the acquisition package is the poverty-of-stimulus argument's empirical floor.
  </p>
  <p>
    <strong>Movement and the invisible machinery.</strong> Transformations relate the deep
    structure to the surface: wh-movement displaces a questioned phrase ("What did she
    see?"), leaving a trace; do-support inserts the otherwise illegal auxiliary ("Does she
    like it?"); passive derives one structure from another. The rules obey constraints —
    islands ("What did she see the report that criticised?" is impossible) — and the
    constraints' specificity is the poverty-of-stimulus argument's workhorse: children never
    hear enough data to learn which infinite set of sentences is impossible, yet every
    speaker knows. Crain and Nakayama's 1987 experiment (children form the auxiliary-fronting
    question "Is the man who is tall happy?" without the linear-rule error) remains the
    classic empirical support. The counter-case: Pullum and Scholz's challenge that the data
    may suffice after all, and usage-based models (construction grammar, emergentism) that
    claim general learning mechanisms do the work.
  </p>
  <Widget no="5" caption="find the line the movement rules forbid" widget="spot-error" config={ggIslandsSpot} />
  <p>
    <strong>The formal hierarchy.</strong> Chomsky's hierarchy of automata measures the theory
    exactly: finite-state machines cannot handle English's centre-embedding, context-free
    grammars handle much of it, and cross-serial dependencies in Swiss German (Shieber's 1985
    demonstration) push natural language toward mildly context-sensitive power — the precise
    formal strength that parsing algorithms implement. Binding theory completes the
    architecture: reflexives must be local ("John shaves himself", not *him), pronouns must
    not be (John thinks he is clever — fine), names cannot be co-referential with a local
    binder — three principles, knife-edge contrastive, all acquired by age three.
  </p>
  <Widget no="6" caption="rank the machines by the strength language needs" widget="order" config={ggHierarchyOrder} />
  <p>
    <strong>Case: morphology doing syntax's work.</strong> The machinery becomes visible in
    morphology. Languages with rich case marking (German, Russian, Finnish, Latin) stamp each
    noun phrase with its structural role — nominative subject, accusative object, dative
    recipient — so word order can go free: German "Den Mann beißt der Hund" fronts the object,
    and the accusative <em>den</em> tells you the man is the one being bitten whatever the
    order. English lost most of the system, and the residue shows exactly where syntax still
    demands it: pronouns resist the loss (*"him saw she"), the who/whom distinction is
    collapsing precisely in the positions case no longer computes, and genitive marking
    stubbornly survives. The cross-linguistic lesson: surface word order is a strategy, not the
    deep structure — case-rich languages prove the grammatical roles are real independently of
    position, which is what the theory's underlying structures claim.
  </p>
  <Widget no="7" caption="true or false — case doing syntax's work" widget="judge" config={ggCaseJudge} />
  <p>
    <em>Common misconception:</em> "generative grammar studies the prescriptive rules you were
    taught — don't split infinitives, never end with a preposition." It studies the opposite:
    the tacit knowledge every speaker has and no school teaches — why "Colorless green ideas
    sleep furiously" is nonsense yet grammatical while "Furiously sleep ideas green colorless"
    is not even grammatical. Prescription is etiquette; this is the science of what you know
    when you know a language.
  </p>
  <p>
    <em>Common misconception:</em> "universal grammar means children are born knowing words —
    or speaking full sentences." It claims no such thing: UG is (on its strongest reading) a
    schema of possible human grammars — the principles and the switch settings — plus the
    procedures for acquiring them. Vocabulary, culture-specific meanings and every actual
    sentence are learned; what the theory reserves for the genome is the architecture and its
    option space. Confusing the blueprint with the building is how the claim gets mocked into
    straw.
  </p>

  <p><strong>So far:</strong> the syntax engine is assembled — and its output would be pointless unless structure connects to meaning. The next section crosses that interface: compositionality, ambiguity and implicature, and the frontier where the theory meets machine learning.</p>

  <h2>Finishing syntax, starting semantics: where structure meets meaning</h2>
  <p>
    <strong>Compositionality.</strong> Frege's principle — the meaning of a whole is a function
    of the meanings of its parts and how they are combined — is semantics' generative engine:
    speakers understand never-before-heard sentences because they compute them. The machinery
    became formal in Montague's hands (1970s: "English as a formal language", intensional
    logic, model-theoretic semantics): lambda calculus translates syntax into truth
    conditions, so a sentence's meaning is what the world must be like for it to be true.
    Frege's own distinction (1892) — sense (mode of presentation) versus reference (the thing
    itself) — still organises the philosophy of language: "the morning star" and "the evening
    star" refer identically and mean differently.
  </p>
  <Widget no="8" caption="fill the two halves of Frege's split" widget="cloze" config={ggFregeCloze} />
  <p>
    <strong>The interface phenomena.</strong> Ambiguity is where syntax hands meaning its
    puzzles: "I saw the man with the telescope" has two structures (instrument or
    companion) — same words, different trees; "Every man loves a woman" has two quantifier
    scopes; binding ambiguities ("every boy's mother loves him") show scope and binding
    interacting. Thematic roles (agent, patient, goal) supply the handover vocabulary:
    argument structure links the verb's syntax to who does what to whom. Beyond truth
    conditions, semantics meets pragmatics: Grice's maxims (be informative, truthful,
    relevant, clear) generate implicatures — "some students passed" implies (without
    entailing) "not all passed" — and Austin's speech acts show utterances doing things
    (promising, naming) beyond stating.
  </p>
  <p>
    <em>Common misconception:</em> "if I say 'some students passed' and it turns out all of
    them passed, I lied." No — the inference "not all" is an implicature, not part of what was
    said: it is cancelable without contradiction ("some — indeed all — of the students
    passed"), which is precisely how implicatures differ from entailments. The distinction does
    real legal and ethical work (misleading by implicature versus lying by entailment), and it
    is Grice's framework — not intuition alone — that makes the difference principled.
  </p>
  <Widget no="9" caption="asserted or merely implied? walk the distinction" widget="branch" config={ggImplicatureBranch} />
  <p>
    <strong>The current frontier.</strong> The semantics-syntax handover is where generative
    grammar meets the LLM era. Large models acquire syntactic sensitivity from raw text —
    subject–verb agreement across long dependencies (Linzen and colleagues' 2016 probing
    paradigm), hierarchical structure detectable in activations — which both camps claim:
    generativists note the models still fail on systematic compositional generalisation;
    usage-based researchers note the models learned without built-in grammar, as their theory
    predicts. Meanwhile formal semantics is the rare Chomskyan inheritance AI genuinely uses —
    lambda calculus underlies every typed meaning representation — and the open question
    (does prediction scale to composition?) is now an empirical industry.
  </p>
  <p>
    <em>Common misconception:</em> "the poverty-of-stimulus argument settled the innateness
    debate decades ago." It is the strongest argument <em>on one side</em>, and its
    quantitative premises (what children actually hear, what could be learned from it) are
    exactly what usage-based researchers contest with corpus studies of child-directed speech.
    The honest state: structure-sensitivity is fact; its explanation is the live argument.
  </p>

  <h2>Check yourself</h2>
  <p>Try these before moving on. Feedback follows each answer.</p>
  <ol>
    <li>State the poverty-of-stimulus argument's core claim, and name the classic experimental result used to support it.</li>
    <li>A child says "I goed to school". What does the U-shaped learning curve predict about that child's earlier and later productions of the same verb, and why does this error support rule-based knowledge rather than memorisation?</li>
    <li>Binding theory's three principles are knife-edge contrastive — reflexives must be local, pronouns must not be, names cannot be locally co-referential — and all are acquired by age three. Why does that contrast count as poverty-of-stimulus evidence?</li>
  </ol>
  <p>
    <strong>Feedback:</strong> (1) Children acquire a correct, highly constrained grammar on
    limited, noisy input, with no corrections that reliably work — the input underdetermines
    what every speaker knows. The classic experimental support is Crain and Nakayama's 1987
    study: children formed "Is the man who is tall happy?" without the linear-rule error of
    moving the wrong "is" out of the relative clause. (2) The curve runs correct → wrong →
    correct: the child first produced "went" correctly, then overregularises ("goed"), then
    recovers. The error is evidence of a productive rule applied <em>against</em> the evidence
    of irregulars the child previously got right — a rule system, not a memory list; Berko's
    1958 wug test makes the same point with words the child has never heard. (3) Because the
    principles are specific in exactly the way input cannot teach: children never hear enough
    data to learn which infinite set of sentences is impossible — no reliable negative
    evidence — yet every speaker draws the distinctions on knife edges by age three. The
    constraints' specificity, not language talent generally, is the argument's workhorse —
    and Pullum and Scholz's challenge is that the quantitative premises may be wrong, which
    keeps the debate empirical.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>Generative grammar treats language as a formal computational system: a finite rule set producing unbounded output through recursion.</li>
    <li>Constituent structure is real and testable — substitution, movement, fragments — and X-bar gives every phrase the same skeleton.</li>
    <li>Parameters (head directionality, pro-drop) explain typology as correlated bundles: switches, not dials.</li>
    <li>The acquisition package — universal stages, overregularisation, the wug test, fast parameter-setting — is the poverty-of-stimulus argument's empirical floor.</li>
    <li>Movement obeys islands; binding theory's three principles arrive by age three; case morphology shows grammatical roles are real independently of word order.</li>
    <li>Compositionality (Frege, formalised by Montague) connects structure to truth conditions; ambiguity, implicature and speech acts live at the interface.</li>
    <li>The frontier is empirical: usage-based alternatives contest the stimulus argument, and LLM probing makes the innateness question testable at scale.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    The other expert lesson in Linguistics, Computational linguistics, is this programme's
    industrial descendant — parsing, probing and the structural evidence of the LLM era. To
    revisit the foundations the formalism builds on, return to Syntax trees and rules and
    Semantics and pragmatics; for the acquisition side of the evidence portfolio, continue
    with the advanced lesson Psycholinguistics and acquisition.
  </p>

  <h2>Going deeper</h2>
  <p>
    <strong>Six decades, four theories.</strong> The programme's internal history is a series
    of honest self-revisions: <em>Syntactic Structures</em> (1957) — rules and transformations;
    the "Standard Theory" of <em>Aspects</em> (1965) — deep structure feeding both syntax and
    semantics; Government and Binding (1981) — a modular system of principles (binding, case,
    bounding) replacing construction-specific rules; Minimalism (1995–) — economy and Merge.
    Each revision <em>reduced</em> the machinery while extending empirical coverage, which is
    the normal-science signature: the theory's worst enemy was never its critics, it was its
    own baroque intermediate stages. The methodological constant: formalise, derive, test
    against judgements, revise.
  </p>
  <p>
    <strong>What would count as disconfirmation?</strong> A serious test needs the
    alternatives to make competing predictions. Usage-based models predict that
    construction frequency drives acquisition order; generative theory predicts
    structure-driven stages independent of input frequency (and some findings favour each).
    Cross-linguistic sampling is the other arena: a genuine universal counterexample (a
    language without recursion was claimed for Pirahã, contested fiercely) would force
    revision of any principle-level claim. The field's health shows in exactly this: its
    central claims are falsifiable, and have been sharpened under fire.
  </p>
  <p>
    <strong>Minimalism.</strong> The current phase (from 1995) is radical economy: grammar
    contains only what the interfaces (sound, meaning) force, with <em>Merge</em> — combine
    two items into one, recursively — as the sole structure-building operation, and displacement
    derived from interface requirements rather than rule gadgets. The attractions (fewer
    primitives, closer to evolutionary plausibility) and the objections (empirical coverage
    debates, whether economy principles are testable) define the field's internal argument.
    The strongest claim — Merge as the single species-unique cognitive innovation, possibly
    exapted from other domains — is Chomsky's own, and remains exactly as speculative as it
    sounds.
  </p>
  <p>
    <strong>The evidence portfolio.</strong> Innate-structure claims rest on convergence:
    acquisition speed and uniformity (children pass the same stages on wildly different
    schedules and inputs), creole genesis (children of pidgin speakers regularise the grammar
    their parents never fixed), modality independence (sign languages acquire identically with
    no spoken input — the strongest single fact in the portfolio), and neurodiversity probes
    (specific language impairment dissociating grammar from general cognition). Each has
    proposed alternative explanations; none has removed all of them — which is why the
    debate is empirical, not rhetorical.
  </p>
  <p>
    <strong>Open questions.</strong> What, exactly, is the innate endowment — a rich Universal
    Grammar, a small bootstrap (Merge plus efficient computation), or general-purpose
    priors? Can minimalism's derivations be given processing reality (the parser as the
    theory's test bench)? And will formal semantics and LLM training converge on a single
    theory of compositional meaning? Each is funded, argued and unresolved — the programme is
    sixty years old and, unusually, its frontier is younger than ever.
  </p>

  <p class="sources"><strong>Sources:</strong> Chomsky, Syntactic Structures (1957) and Aspects (1965); Minimalist Program (1995); Pullum & Scholz on the poverty-of-stimulus debate. Source text: OpenStax (https://openstax.org), CC BY 4.0 — adapted for Interactive Atlas.</p>
</TopicPage>
