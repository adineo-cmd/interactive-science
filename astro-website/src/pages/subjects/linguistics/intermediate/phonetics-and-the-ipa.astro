import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const phonCfg = {
  steps: [
    { math: '1 · The IPA: one symbol per sound', note: 'The International Phonetic Alphabet (1888) gives every human speech sound a unique symbol — [ðɪs] is readable in any language. ~44 phonemes in English map onto 26 letters by elaborate convention (and chaos).' },
    { math: '2 · Where sounds are made', note: 'Place (lips, teeth, alveolar ridge, palate, velum, glottis) × manner (stop, fricative, nasal, approximant) × voicing. "p" = voiceless bilabial stop. The chart is a map of the mouth.' },
    { math: '3 · The English spelling chaos explained', note: '26 letters for ~44 phonemes — 5 vowel letters for 12+ vowel sounds. "ough" has 6+ pronunciations (through, though, tough, cough, bough, thought). History happened: the Great Vowel Shift (~1400–1700) moved all the long vowels while spelling froze.' },
    { math: '4 · Sounds beyond English', note: 'Clicks (Xhosa, Khoisan), ejectives, retroflexes, tones (Chinese, Vietnamese), implosives — the IPA notates ~all of them. Each human language selects ~20–40 of the possible sounds, and never the same set.' },
  ],
};
---
<TopicPage slug="subjects/linguistics/intermediate/phonetics-and-the-ipa">
  <h2>The idea</h2>
  <p>
    Phonetics is <strong>the physics and physiology of speech</strong>: how sounds are produced by
    the vocal tract, their acoustic properties, and how they're heard. The International Phonetic
    Alphabet notates every human sound with one symbol — the tool that makes pronunciation
    teachable and sound change measurable.
  </p>

  <Widget no="1" caption="the IPA, the mouth-map, the spelling chaos, and the sounds beyond English" widget="equationStep" config={phonCfg} />

  <h2>Acoustic phonetics in one breath</h2>
  <ul>
    <li><strong>Vowels are resonance shapes:</strong> the tongue position shapes the vocal tract's resonances (formants F1, F2) — vowels are two-dimensional on a formant chart, which is why vowel charts are shaped like mouths.</li>
    <li><strong>Consonants are events:</strong> closures, frictions and releases — spectrograms show them as bursts and gaps, machine-readable (the basis of speech recognition).</li>
    <li><strong>Suprasegmentals:</strong> pitch, stress, length — the music layer that distinguishes Mandarin's four tones and every language's question statements. Tone languages are ~40–50% of the world's languages.</li>
    <li><strong>Applied everywhere:</strong> speech therapy, language teaching, accent training, voice synthesis — all phonetics in production (the computational-linguistics lesson shows the AI version).</li>
  </ul>
  <p class="sources"><strong>Sources:</strong> International Phonetic Association handbook; Ladefoged & Johnson, A Course in Phonetics; Crystal, The Cambridge Encyclopedia of Language.</p>
</TopicPage>
