import Widget from '../../../../components/Widget.astro';

const histCfg = {
  steps: [
    { math: '1 · Grimm\'s law: the first rule of history', note: 'Jakob Grimm (1822) showed Latin p → English f (pater/father, pes/foot) is SYSTEMATIC — a sound shift, not accidents. Regular correspondences prove common descent and let linguists reconstruct dead ancestor languages.' },
    { math: '2 · Reconstruction: Indo-European', note: 'Comparing cognates across Sanskrit, Greek, Latin, Gothic, Lithuanian etc., linguists reconstructed Proto-Indo-European (~4500–2500 BCE) — a language never written down, now known to a few thousand words. The Comparative Method: rigorous, testable, spectacularly successful.' },
    { math: '3 · Sound change is regular', note: 'Every word with the same sound in the same environment shifts together — the Neogrammarian hypothesis. Exceptions turn out to be analogy, borrowing, or another rule. Regularity is what makes family trees possible.' },
    { math: '4 · Types of change', note: 'Sound change (Grimm), analogy (over-regularising: "holp" → "helped"), borrowing (new words from contact), semantic drift ("silly" once meant blessed). Languages never stop moving — the change is happening to English right now.' },
  ],
};
---
<TopicPage slug="subjects/linguistics/advanced/historical-linguistics">
  <h2>The idea</h2>
  <p>
    Historical linguistics reconstructs <strong>languages nobody ever recorded</strong> — by
    comparing their descendants' vocabulary with mathematical regularity. The comparative
    method built the Indo-European family tree (and families for every continent), dated
    migrations archaeology couldn't, and proved language change is rule-governed, not random.
  </p>

  <Widget no="1" caption="Grimm's law, the comparative method, regularity, and the types of change" widget="equationStep" config={histCfg} />

  <h2>The method's triumphs and limits</h2>
  <ul>
    <li><strong>Time depth limit:</strong> the method reaches ~10,000 years before signals blur beyond reconstruction. Proposals beyond (Nostratic, Altaic) remain unproven — the data runs out.</li>
    <li><strong>Language families of the world:</strong> Indo-European (~46% of humans), Sino-Tibetan, Niger-Congo, Afroasiatic, Austronesian (Madagascar to Easter Island — the widest pre-modern spread, proven by reconstruction matching archaeology).</li>
    <li><strong>Family trees meet DNA:</strong> genetic studies of ancient human remains now independently test linguistic migration hypotheses — the two data streams mostly agree, and where they disagree, both get re-examined.</li>
    <li><strong>Why regularity matters beyond linguistics:</strong> the comparative method is a general epistemic tool — systematic correspondences across systems imply common descent, in languages, genomes and, in its own way, in the philosophy-of-science lesson's reasoning about evidence.</li>
  </ul>
  <p class="sources"><strong>Sources:</strong> Grimm, Deutsche Grammatik (1822); Campbell, Historical Linguistics; Anthony, The Horse, the Wheel, and Language.</p>
</TopicPage>
