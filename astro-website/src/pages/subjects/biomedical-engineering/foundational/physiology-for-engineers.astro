  "why": "Once the mapping holds, a heart valve is fluid dynamics, a dialyser is a filter with honest specifications, and a neural interface is a controls problem."
};

const pfePumpOrder = {
  "prompt": "The sodium–potassium pump, stroke by stroke — put it in order:",
  "items": [
    "The pump spends ATP",
    "Three sodium ions are pushed out of the cell",
    "Two potassium ions are pulled in",
    "Sodium concentrates outside (about 145 mM), potassium inside (about 140)",
    "The standing differences amount to a charged battery"
  ],
  "why": "Separated charge is voltage — the battery that every nerve spends in all-or-none pulses."
};

const pfeRestingPlace = {
  "prompt": "Potassium's gradient alone is worth about −90 mV. Where does the cell's true resting voltage land? Place the marker:",
  "labels": [
    "−100",
    "−75",
    "−50",
    "−25",
    "0"
  ],
  "scale": {
    "min": -100,
    "max": 0
  },
  "answer": -70,
  "tolerance": 6,
  "why": "Near −70 mV: mostly potassium's −90, nudged toward zero by a small sodium leak running the other way."
};

const pfeSpikeCloze = {
  "text": "A stimulus that pushes the voltage up past %%0%% millivolts trips special sodium channels, which snap open in an all-or-none cascade: the voltage spikes to roughly %%1%% millivolts within a millisecond, then %%2%% channels restore the rest.",
  "answers": [
    [
      "−55",
      "-55"
    ],
    [
      "+30",
      "30"
    ],
    [
      "potassium"
    ]
  ],
  "hint": "Threshold sits between the resting −70 and the peak; the peak is positive."
};

const pfeWireJudge = {
  "statements": [
    {
      "s": "Charge streams down a nerve fibre the way it streams down a copper wire.",
      "truth": false,
      "why": "Nothing streams down the fibre — the signal is a travelling wave of flips across the membrane."
    },
    {
      "s": "At each point along the nerve, charge flips across the membrane and triggers the next point.",
      "truth": true,
      "why": "The travelling wave of flips is why the fibre is said to be rebuilt at every step."
    },
    {
      "s": "Nerve conduction speed depends on insulation (myelin) rather than on the fibre's 'conductivity'.",
      "truth": true,
      "why": "Myelinated fibres leap the pulse between gaps at up to about 120 metres per second."
    },
    {
      "s": "A damaged nerve segment merely dims the signal, the way a damaged wire does.",
      "truth": false,
      "why": "A damaged segment can silence what a damaged wire merely dims — the pulse is all-or-none."
    }
  ]
};

const pfeTransduceSpot = {
  "prompt": "One line of this receptor walkthrough is wrong. Find it.",
  "lines": [
    "A signalling molecule is released — a neurotransmitter between neurons, a hormone in the blood",
    "It binds a receptor shaped for it, like a key for one lock",
    "The receptor transduces — it converts the chemical message into another form",
    "The receptor digests the signalling molecule to extract its energy",
    "This is where drugs act, where diseases hide, and where biosensors intervene"
  ],
  "errorLine": 3,
  "correction": "The receptor passes the message on — opening an ion channel or triggering a cascade inside the cell; it never consumes the messenger for energy.",
  "why": "Transduction converts, it does not digest: chemical message into electrical (an opened channel) or into a chemical cascade inside the cell."
};

const pfeCascadeTrace = {
  "prompt": "A cascade where each stage activates many copies of the next enzyme: which curve shows the signal's size, stage by stage?",
  "curves": [
    {
      "expr": "2^x",
      "color": "#1d4ed8",
      "label": "A: multiplicative"
    },
    {
      "expr": "x^2",
      "color": "#b42318",
      "label": "B: quadratic"
    },
    {
      "expr": "2*x",
      "color": "#0f766e",
      "label": "C: steady addition"
    }
  ],
  "correct": 0,
  "x": {
    "min": 0,
    "max": 10
  },
  "y": {
    "min": 0,
    "max": 1100
  },
