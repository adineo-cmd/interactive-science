  "unit": "L per day",
  "answer": 180,
  "factor": 1.6,
  "why": "About 180 litres filtered daily — all but roughly 1.5 litres reclaimed, so a litre and a half leaves as urine.",
  "context": "A bathtub's worth processed every day, cycled out of roughly five litres of blood."
};

const pfeMachineMatch = {
