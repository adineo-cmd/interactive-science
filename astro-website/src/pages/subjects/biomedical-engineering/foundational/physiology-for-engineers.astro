const cvCfg = {
  steps: [
    { math: '1 · A pump with four chambers', note: 'The heart moves ~5 litres per minute at rest through two circuits: lungs (pulmonary) and body (systemic).' },
    { math: '2 · Pressure is the driving head', note: 'Arterial pressure ~120/80 mmHg falls to near-zero by the veins — exactly the gradient fluid mechanics predicts a network needs.' },
    { math: '3 · Vessels are compliance elements', note: 'Arteries stretch and store energy in systole, releasing it in diastole: a hydraulic capacitor smoothing the pulse.' },
    { math: '4 · Flow follows Ohm\'s law too', note: 'Flow = ΔP / resistance, and resistance ∝ 1/r⁴ (Poiseuille). Halving an arteriole\'s radius cuts flow sixteen-fold — that is how the body throttles.' },
    { math: '5 · Regulation closes the loop', note: 'Baroreceptors sense pressure; the nervous system adjusts heart rate and vessel tone. A feedback controller with a heartbeat.' },
  ],
};

const poiseuilleCfg = {
  curves: [
    { expr: '100*x^4', label: 'flow relative to resting', color: '#0f766e', width: 2.4 },
  ],
  x: { min: 0.4, max: 1.4, label: 'arteriole radius as a multiple of resting' },
  y: { min: 0, max: 400, label: 'flow as % of resting' },
  crossings: false,
  height: 320,
};

const pfeKidneyEstimate = {
