import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const dxCfg = {
  steps: [
    { math: '1 · History first: 80% of diagnosis', note: 'Most diagnoses come from the patient\'s story — the history of symptoms, timing, context. Tests confirm suspicions far more often than they generate them.' },
    { math: '2 · Build a differential', note: 'A ranked list of possible explanations for the findings. Chest pain: heart, lung, muscle, reflux, panic — ordered by likelihood and by danger ("can\'t miss" diagnoses rank up even when rare).' },
    { math: '3 · Test to discriminate, not to fish', note: 'Each test should shift probability between the top hypotheses. Interpreting results requires Bayes: the same test means different things depending on how likely the disease was beforehand (prevalence). The statistics ladder\'s Bayesian lesson is clinical arithmetic.' },
    { math: '4 · Guard against anchor bias', note: 'Early impressions dominate: once "heartburn" anchors, disconfirming evidence gets discounted. Checklists and second opinions are bias-countermeasures, not bureaucracy.' },
  ],
};

const dtHistoryEstimate = {
  "prompt": "Classic clinical-teaching estimates put one stage alone at most of the diagnosis. Roughly what share belongs to the history?",
  "unit": "% of diagnosis",
  "answer": 80,
  "factor": 1.3,
  "why": "About 80%, with examination and tests splitting most of the rest. Symptom timing is often the discriminator: thunderclap onset points to haemorrhage, hours of gradual build to inflammation, exertion-then-rest cycling to a flow problem."
};

const dtCantMissBranch = {
  "root": "Chest-pain triage: the differential ranks candidates by two criteria at once — likelihood and danger.",
  "nodes": {
    "start": {
      "text": "One candidate is reflux (very common). Another is aortic dissection — perhaps 1–2 presentations per thousand, lethal within hours, with a different emergency treatment. How do you rank dissection?",
      "choices": [
        {
          "label": "Promote it up the ranking despite the rarity",
          "next": "promote",
          "feedback": "The profession's distinctive twist: danger ranks up rarity."
        },
        {
          "label": "Leave it low — far too rare to consider first",
          "next": "low",
          "feedback": "Likelihood alone is only half the ranking rule."
        }
      ]
    },
    "promote": {
      "text": "A \"can't-miss\" diagnosis is promoted deliberately: missing dissection costs hours, while the common candidate usually announces itself in the history. That is why the ranking is ordered by likelihood and danger together.",
      "choices": [
        {
          "label": "Now: how to test",
          "next": "fish"
        }
      ]
    },
    "low": {
      "text": "Ranked on likelihood alone, dissection hides — and the trade-off is written in hours. Can't-miss diagnoses rank up even when rare; that is what the second criterion is for.",
      "choices": [
        {
          "label": "Now: how to test",
          "next": "fish"
        }
      ]
    },
    "fish": {
      "text": "Testing follows the same discipline: each test is chosen because it can discriminate between the top candidates. A test that will not change management is not worth its own risks and costs — no scattershot panels.",
      "choices": []
    }
  },
  "why": "Ranked by likelihood and danger; tested to discriminate, not to fish — that principle is what separates a targeted workup from a scattershot panel."
};

const dtLocaliseMatch = {
  "prompt": "The neurological exam as localisation instrument — pair each pattern with its reading:",
  "pairs": [
    {
      "left": "weakness with brisk reflexes and an upgoing plantar response (Babinski)",
      "right": "upper motor neuron lesion — brain or spinal cord, upstream of the anterior horn cell"
    },
    {
      "left": "weakness with wasting, flaccidity and lost reflexes",
      "right": "lower motor neuron lesion — anterior horn, root, plexus or peripheral nerve"
    },
    {
      "left": "right face and right arm weak together, right leg spared",
      "right": "left cerebral hemisphere's cortex — in the cord, leg and arm tracts run together"
    },
    {
      "left": "orthostatic blood-pressure drop; heart rate fails to rise on standing",
      "right": "the autonomic exam's own signatures"
    }
  ],
  "why": "Each pathway runs a known route, so a pattern of deficits localises the lesion before any scan — and re-examining an hour later shows whether a stroke is extending."
};

const dtBayesEstimate = {
  "prompt": "Screen 10,000 women: prevalence 1%, sensitivity 85%, specificity 90% (so 990 false positives among the 9,900 disease-free). Of the ~1,075 positive results, roughly how many are true positives?",
  "unit": "true positives",
  "answer": 85,
  "factor": 1.6,
  "why": "85 of ~1,075 positives — a positive predictive value of about 8%. Nine of ten flagged women do not have cancer. Run the identical test where prevalence is 10% and the PPV lifts to about 43%: the test did not change, the population did.",
  "context": "Sensitivity and specificity belong to the test; predictive value belongs to the test plus the population."
};

const dtSnOutBuckets = {
  "prompt": "Two working rules govern test direction — file each fact:",
  "buckets": [
    "sensitive — a negative rules OUT",
    "specific — a positive rules IN"
  ],
  "items": [
    {
      "label": "a highly sensitive test comes back negative — disease effectively excluded",
      "bucket": 0
    },
    {
      "label": "SnNout",
      "bucket": 0
    },
    {
      "label": "D-dimer: extremely sensitive, poorly specific — the rule-out gate for clots",
      "bucket": 0
    },
    {
      "label": "a negative D-dimer in a low-risk patient ends the workup",
      "bucket": 0
    },
    {
      "label": "a highly specific test comes back positive — disease effectively confirmed",
      "bucket": 1
    },
    {
      "label": "SpPin",
      "bucket": 1
    }
  ],
  "why": "A positive D-dimer barely raises the odds and must be followed by specific imaging — likelihood ratios (LR+ = sensitivity / (1 − specificity)) shift the odds multiplicatively and let imperfect tests chain."
};

const dtOccamSpot = {
  "prompt": "A case discussion — one line reaches for the wrong rule of thumb. Click it:",
  "lines": [
    "Fast pattern recognition is legitimate expertise for routine presentations.",
    "The referral note's phrase fixed attention, and later evidence was read through it — anchoring.",
    "The process stopped at the first plausible diagnosis — the most common cognitive error in studies of diagnostic failure.",
    "The patient is elderly and complex, so Occam's razor demands a single unifying diagnosis.",
    "With an unstable patient, resuscitation precedes diagnosis — \"sick or not sick\" comes first."
  ],
  "errorLine": 3,
  "correction": "Hickam's dictum governs the elderly and the complex — patients can have as many diseases as they please. Occam's razor (seek one unifying diagnosis) is the counterweight for young patients with one coherent story.",
  "why": "The rules of thumb are scoped counterweights, each aimed at a known shortcut of the fast system."
};

const dtGuardrailJudge = {
  "statements": [
    {
      "s": "Diagnostic error is a rare curiosity, confined to unusual diseases.",
      "truth": false,
      "why": "A 2023 Johns Hopkins analysis estimated ~795,000 Americans die or suffer permanent disability from diagnostic error yearly; earlier outpatient work put it near one adult in twenty per year."
    },
    {
      "s": "Vascular events, infections and cancers account for about three-quarters of serious diagnostic harm.",
      "truth": true,
      "why": "Stroke, sepsis, pneumonia, venous thromboembolism and lung cancer top the list."
    },
    {
      "s": "Checklists and structured templates work by making clinicians smarter.",
      "truth": false,
      "why": "They make the fast system slow down at the known failure points — forcing the can't-miss items into view when the anchor says otherwise."
    },
    {
      "s": "Explicit pre-test probability scoring (Wells score, CHADS₂) makes the Bayesian step visible.",
      "truth": true,
      "why": "Alongside decision-support systems that compute the likelihood ratios clinicians skip."
    }
  ]
};

const dtExpertCloze = {
  "text": "Experts store diagnosis as organised %%0%% — classic presentation, risk factors, course, complications — so pattern recognition is fast script-matching. Chained tests are not %%1%%: proper analysis works in odds and %%2%% throughout. AI classifiers trained on enriched prevalence over-predict in the wild, so emerging best practice uses them as a %%3%% reader, not a first opinion.",
  "answers": [
    [
      "narratives",
      "scripts"
    ],
    [
      "independent"
    ],
    [
      "likelihood ratios"
    ],
    [
      "second"
    ]
  ],
  "hint": "The first blank is what novices lack; the third is the multiplicative quantity; the last is a reading role."
};
---
<TopicPage slug="subjects/medicine/intermediate/how-doctors-think">

  <h2>Where you are, and what you will learn</h2>
  <p>
    This is an intermediate lesson in Medicine. It assumes the foundational lesson "The
    Heart and Circulation" and the body-systems material before it: you should know what
    organs and organ systems are and roughly what they do, because diagnosis is the
    inference engine that runs on top of that anatomy. No statistics background is needed;
    the arithmetic used here is built up inside the lesson.
  </p>
  <p>By the end you will be able to:</p>
  <ul>
    <li>run the diagnostic loop: take a history, build a differential, and choose tests that discriminate;</li>
    <li>explain why "can't-miss" diagnoses rank up even when they are rare;</li>
    <li>define sensitivity, specificity and positive predictive value, and show why prevalence changes what a positive result means;</li>
    <li>use the localisation logic of the physical exam, especially the neurological model;</li>
    <li>name the common cognitive biases in diagnosis and the guardrails that blunt them.</li>
  </ul>

  <h2>The idea</h2>
  <p>
    You already know the body's systems from the previous lessons. This lesson is about the inference
    engine that runs on top of them: how a clinician goes from "this person feels unwell" to "this is
    what is wrong, and here is what to do." Diagnosis is <strong>applied probability under uncertainty
    with high stakes</strong> — reasoning from symptoms to causes with incomplete information, a time
    limit, and no option to decline the question. That framing matters more than it sounds: it means
    diagnosis is never a lookup table. Symptoms are ambiguous (chest pain can come from heart, lung,
    oesophagus, muscle or anxiety), tests are imperfect (every one has false positives and false
    negatives), and the clinician's own mind is an imperfect instrument too. Jerome Groopman's
    <em>How Doctors Think</em> catalogued the cognitive traps; the evidence-based medicine movement
    built the statistical countermeasures; patient-safety researchers measured how often the process
    fails. This chapter assembles the whole toolkit: the diagnostic loop, the physical exam as
    localisation device, the Bayesian arithmetic of test interpretation, the heuristics that speed
    clinicians up and occasionally derail them, and the guardrails that keep the errors down.
  </p>

  <Widget no="1" caption="the diagnostic loop, and the biases that bend it" widget="equationStep" config={dxCfg} />
  <p>
    <strong>What to notice:</strong> step through the four panels in order and watch what
    each stage contributes. The history carries most of the weight before any test is
    ordered; the differential is a ranked list, not a free-association exercise; each test
    exists to shift probability between the top candidates; and the last panel is a
    warning label on the whole machine.
  </p>
  <p>
    <strong>So far:</strong> diagnosis is applied probability under uncertainty, and the
    loop that manages that uncertainty starts with the patient's story. The next two
    sections walk the loop's stages in order.
  </p>

  <h2>The diagnostic loop: history, exam, differential</h2>
  <p>
    The method runs as a loop, and its first stage does the heaviest lifting. The <strong>history</strong>
    — the patient's story of what happened, when, in what order, with what associated features —
    establishes the diagnosis in the large majority of cases; classic clinical-teaching estimates put
    history alone at about 80% of the diagnosis, with examination and tests splitting most of the rest.
    The reason is information density: a story of crushing central chest pain radiating to the left arm,
    sweating and nausea over twenty minutes in a 62-year-old smoker carries more diagnostic bits than
    any single test. Symptom <em>timing</em> is often the discriminator: sudden maximal onset ("thunderclap")
    points to haemorrhage; hours of gradual build point to inflammation; pain that recurs with exertion
    and eases with rest points to a flow problem. The history also frames the patient: age, sex, smoking,
    travel, medications, family history — each a probability lever before any test is ordered.
  </p>
  <Widget no="2" caption="call the history's share of the diagnosis" widget="estimate" config={dtHistoryEstimate} />
  <p>
    From the findings the clinician constructs the <strong>differential diagnosis</strong>: a ranked
    list of candidate explanations, ordered by two criteria at once — <em>likelihood</em> (what is
    common and fits) and <em>danger</em> (what would kill or disable this patient quickly if missed).
    The second criterion is the profession's distinctive twist. Aortic dissection causes perhaps 1–2
    chest-pain presentations per thousand, but it is lethal within hours and has a different emergency
    treatment, so it is deliberately promoted up the ranking even though it is rare: the trade-off is
    written as "can't-miss diagnoses." The differential then drives testing in a specific way — each
    test is chosen because it can <em>discriminate</em> between the top candidates, not to "fish" the
    whole body. That principle is what separates a targeted workup from a scattershot panel: a test
    that will not change what you do is not worth its own risks and costs, a rule stated bluntly in the
    maxim "don't order a test unless the result could change your management."
  </p>
  <Widget no="3" caption="walk the differential's two-criteria ranking" widget="branch" config={dtCantMissBranch} />
  <p><em>Common misconception:</em> "the tests are what make the diagnosis." Classic
  teaching estimates run the other way: the history alone carries about 80% of the
  diagnosis, and tests are chosen to discriminate between candidates the story has
  already narrowed down. Fishing the whole body with a scattershot panel generates false
  positives faster than it finds disease.</p>

  <h2>The exam as localisation: the neurological model</h2>
  <p>
    The physical examination is often dismissed as pre-imaging ritual, but it is a rapid, cheap
    localisation instrument, and the neurological exam shows the logic in its purest form — which is
    why the anatomy-and-physiology sequence pairs this material with the nervous-system chapters. The
    exam's sections map onto anatomical systems: mental status samples cortex, cranial nerves sample
    the brainstem and their tracts, motor testing samples the corticospinal pathway and peripheral
    nerves, reflexes sample the spinal reflex arc, sensory testing samples the ascending tracts and
    nerves, and coordination samples cerebellum. Because each pathway runs a known route, a pattern of
    deficits <em>localises</em> the lesion before any scan. Worked logic: weakness with brisk reflexes
    and an upgoing plantar response (Babinski sign) indicates an <strong>upper motor neuron</strong>
    lesion — the brain or spinal cord, upstream of the anterior horn cell; weakness with wasting,
    flaccidity and lost reflexes indicates a <strong>lower motor neuron</strong> lesion — the anterior
    horn, root, plexus or peripheral nerve. Add that the patient's right face and right arm are weak
    together but the right leg is spared, and the lesion localises to the left cerebral hemisphere's
    cortex, not the spinal cord (where leg and arm tracts run together). The autonomic exam contributes
    its own signatures — orthostatic blood-pressure drop, heart-rate that fails to rise on standing —
    and the whole protocol doubles as a serial instrument: re-examining an hour later tells you whether
    a stroke is extending or a patient is improving, information no one-off scan provides.
  </p>
  <Widget no="4" caption="pair each exam pattern with its localisation" widget="match" config={dtLocaliseMatch} />
  <p><em>Common misconception:</em> "the physical exam is obsolete now that scanners
  exist." Scans answer a question only after someone decides to ask it; the exam is
  cheaper, faster, repeatable at the bedside, and it localises deficits the scan will
  then confirm. The two instruments work in sequence, not in competition.</p>
  <p>
    <strong>So far:</strong> the exam is a rapid localisation instrument: because each
    pathway runs a known route, a pattern of deficits points to a place before any scan.
    Next comes the arithmetic that turns a test result into an updated probability.
  </p>

  <h2>Tests as probability machines</h2>
  <p>
    Every diagnostic test is defined by two numbers measured against a known gold standard.
    <strong>Sensitivity</strong> is the share of diseased patients who test positive;
    <strong>specificity</strong> is the share of disease-free patients who test negative. But notice
    what the clinician actually needs is the reverse direction: given a positive test, what is the
    probability of disease? That quantity — the <strong>positive predictive value</strong> — depends
    not only on the test but on how common the disease was <em>before</em> testing: the
    <strong>pre-test probability</strong>, set by prevalence in the population and refined by the
    history. Bayes' theorem is the bookkeeping, and it is worth doing once by hand. Take mammography:
    sensitivity roughly 85%, specificity roughly 90%, and in a screening setting of 50-year-olds the
    underlying breast-cancer prevalence over the screening interval is near 1%. Screen 10,000 women:
    about 100 have cancer, and the test catches 85 of them. About 9,900 do not, and its 10% false-positive
    rate flags 990 of them. So of 1,075 positive results, only 85 are true — a positive predictive
    value of <strong>about 8%</strong>. Nine of ten flagged women do not have cancer. Run the same test
    in a high-risk clinic where prevalence is 10%, and the arithmetic lifts the PPV to about 43% — the
    identical test, three meanings, depending entirely on who is being tested.
  </p>
  <Widget no="5" caption="do the mammography arithmetic by hand" widget="estimate" config={dtBayesEstimate} />
  <p>
    Two working rules fall out of this. A highly <strong>sensitive</strong> test that comes back
    negative effectively rules the disease out (its false-negative rate is tiny) — "SnNout." A highly
    <strong>specific</strong> test that comes back positive effectively rules it in — "SpPin." That is
    why emergency medicine uses D-dimer (extremely sensitive, poorly specific) as a
    <em>rule-out</em> gate for clots: a negative D-dimer in a low-risk patient ends the workup, while a
    positive one barely raises the odds and must be followed by specific imaging. Formal versions of
    this reasoning use <strong>likelihood ratios</strong> — LR+ equals sensitivity over (1 − specificity)
    — which shift the odds from pre-test to post-test multiplicatively and let clinicians chain
    imperfect tests into a precise estimate.
  </p>
  <Widget no="6" caption="file each rule under the right test property" widget="sort-buckets" config={dtSnOutBuckets} />
  <p><em>Common misconception:</em> a "99% accurate" test does not mean 99% of positives are correct.
  Accuracy conflates the two error types; what the positive result means is dominated by prevalence.
  This is the base-rate fallacy, and it misleads patients and clinicians alike — a positive result for
  a rare disease from a good test is still more likely than not to be a false positive.</p>

  <h2>The mind of the diagnostician: heuristics and bias</h2>
  <p>
    Clinicians cannot run full Bayesian bookkeeping on every case, so cognition runs on
    <strong>dual-process</strong> lines (Croskerry's adaptation of the psychology): fast
    <em>pattern recognition</em> — "this rash looks exactly like shingles" — handles routine cases in
    seconds, while slow <em>systematic reasoning</em> handles atypical ones. The fast mode is genuinely
    expert (it is why experienced clinicians are usually right) but it is also where the documented
    biases live. <strong>Anchoring</strong>: the first impression — often the referral note's phrase —
    fixes attention, and later evidence is read through it. <strong>Premature closure</strong>: the
    process stops at the first plausible diagnosis, the single most common cognitive error in studies
    of diagnostic failure. <strong>Availability</strong>: the diagnosis seen last week, or the terrifying
    one from training, gets overweighted. <strong>Framing</strong>: "chest pain, probably musculoskeletal"
    from the triage note biases everyone downstream. The classical rules of thumb —
    <strong>Occam's razor</strong> (seek one unifying diagnosis) and <strong>Hickam's dictum</strong>
    ("patients can have as many diseases as they damn well please") — are the conscious counterweights:
    Occam for young patients with one coherent story, Hickam for the elderly and the complex. Another
    legitimate shortcut is <strong>"sick or not sick"</strong>: with an unstable patient, resuscitation
    precedes diagnosis, because hypoxia and shock kill on a faster clock than differential diagnosis.
  </p>
  <Widget no="7" caption="one line of the case reasoning reaches for the wrong rule" widget="spot-error" config={dtOccamSpot} />

  <h2>Guardrails: making error rare</h2>
  <p>
    Diagnostic error is not a rare curiosity. A major 2023 Johns Hopkins analysis estimated that
    roughly <strong>795,000 Americans</strong> die or suffer permanent disability from diagnostic error
    each year — about 371,000 deaths and 424,000 permanent disabilities — and that just three
    categories (vascular events, infections, cancers) account for about three-quarters of the serious
    harm, with stroke, sepsis, pneumonia, venous thromboembolism and lung cancer topping the list.
    Earlier outpatient studies estimated roughly one adult in twenty experiences a diagnostic error per
    year. The countermeasures are organisational versions of de-biasing: <strong>checklists and
    structured templates</strong> (forcing the can't-miss items to be considered even when the anchor
    says otherwise), <strong>diagnostic time-outs</strong> ("if this patient turned out to have
    dissection, what would I have missed?"), <strong>gut-check second opinions</strong>, explicit
    <strong>pre-test probability scoring</strong> (Wells score for clots, CHADS<sub>2</sub> for stroke
    risk) that makes the Bayesian step visible, and <strong>decision-support systems</strong> that
    compute likelihood ratios clinicians skip. The pattern across all of them is the same: they do not
    make clinicians smarter; they make the smart fast system slow down at the known failure points.
  </p>
  <Widget no="8" caption="true or false — the guardrails, audited" widget="judge" config={dtGuardrailJudge} />

  <h2>Check yourself</h2>
  <p>Try these before moving on. Feedback follows each answer.</p>
  <ol>
    <li>Why does the history contribute more to diagnosis than any single test?</li>
    <li>A test with 99% "accuracy" screens for a disease with 1% prevalence. Roughly what share of positive results are false, and why?</li>
    <li>Name one cognitive bias in diagnosis and one organisational countermeasure aimed at it.</li>
  </ol>
  <p>
    <strong>Feedback:</strong> (1) Information density: the story carries symptom timing,
    context and risk factors at once, and classic teaching estimates put the history alone
    at about 80% of the diagnosis. (2) Most of them: in the mammography arithmetic of the
    lesson, only about 85 of roughly 1,075 positives per 10,000 women screened are true,
    because the disease is rare to begin with — the base-rate fallacy. (3) Anchoring,
    premature closure, availability or framing are the biases; checklists, diagnostic
    time-outs, second opinions and pre-test probability scoring are the countermeasures.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>Diagnosis is applied probability under uncertainty with high stakes — never a lookup table.</li>
    <li>The diagnostic loop runs history first (about 80%), then exam, then discriminating tests.</li>
    <li>The differential ranks candidates by likelihood and by danger; can't-miss diagnoses rank up even when rare.</li>
    <li>The neurological exam localises lesions from patterns of deficits, before any scan.</li>
    <li>Sensitivity and specificity belong to the test; predictive value belongs to the test plus the population.</li>
    <li>A highly sensitive negative rules out; a highly specific positive rules in.</li>
    <li>Anchoring, premature closure, availability and framing are the mind's known failure points; structured guardrails slow the fast system there.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    The intermediate Medicine shelf continues the inference story at population scale in
    "Public Health &amp; Epidemiology", which reuses the same Bayes arithmetic for
    screening decisions; "Pharmacology Basics" picks up what happens after a diagnosis is
    made, and "Infection &amp; Antibiotics" works through the infections that dominate the
    can't-miss list.
  </p>

  <h2>Going deeper</h2>
  <p>
    Several refinements belong in the expert layer. <strong>Illness scripts</strong>: cognitive studies
    suggest experts store diagnosis as organised narratives — classic presentation, risk factors,
    course, complications — so pattern recognition is really fast script-matching; novices who lack
    scripts must reason feature-by-feature, which is slower and more error-prone, and medical education
    is largely script installation. <strong>Base-rate dependence of screening policy</strong>: the
    Bayes arithmetic explains real controversies — why population screening for rare cancers produces
    floods of false positives and overdiagnosis, and why guidelines now argue over <em>whom</em> to
    screen rather than only <em>which test</em> to use; raising pre-test probability (risk-stratified
    screening) is mathematically equivalent to improving the test. <strong>Sequential testing</strong>:
    chained tests are not independent — the probability that a chest CT is positive given an already
    positive X-ray is conditional, and naive multiplication of "accuracies" underestimates both errors
    and confidence; proper analysis works in odds and likelihood ratios throughout.
    <strong>AI decision support</strong>: machine-learning classifiers promise pattern recognition at
    scale, but they inherit base-rate fragility (trained on enriched prevalence, they over-predict in
    the wild), they anchor users too (automation bias), and their failure modes are opaque — so the
    emerging best practice uses them as a second reader, not a first opinion. And finally the
    honest summary the numbers force: diagnosis will never be deterministic, because the mapping from
    symptoms to disease is inherently many-to-many. The professional skill is not certainty but
    <em>calibrated</em> uncertainty — knowing, on the evidence so far, that the top hypothesis carries
    40% of the mass, that two can't-miss alternatives have been excluded, and that the next single test
    will move the leading hypothesis most. That is what "thinking like a doctor" means when you take
    the poetry out: arithmetic, humility, and a checklist for the mind's well-known shortcuts.
  </p>
  <Widget no="9" caption="fill the expert layer's four refinements" widget="cloze" config={dtExpertCloze} />
  <p class="sources"><strong>Sources:</strong> Groopman, How Doctors Think (2007); Newman-Toker et al., BMJ Quality &amp; Safety (2023); Singh et al., BMJ Open (2014); Croskerry, dual-process diagnostic reasoning; BMJ Best Practice methodology. Source text: OpenStax (https://openstax.org), CC BY 4.0 — adapted for Interactive Atlas.</p>
</TopicPage>
