import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const cancerCfg = {
  steps: [
    { math: '1 · Cancer = uncontrolled evolution', note: 'A cell accumulates mutations that let it ignore growth signals, evade death, divide endlessly. Tumours evolve INSIDE patients — treatment applies selection pressure, and resistant clones survive it.' },
    { math: '2 · Hallmarks of cancer', note: 'Hanahan & Weinberg\'s list (2000, updated 2022): self-sufficiency in growth, ignoring anti-growth signals, evading death, replicating forever, inducing blood supply, invading tissue, dodging immunity, hijacking metabolism.' },
    { math: '3 · Treatment logic by mechanism', note: 'Surgery (cut it out), radiotherapy (localised DNA damage), chemotherapy (hits dividing cells), targeted therapy (blocks the specific mutated pathway), immunotherapy (unmasks the tumour to immune T cells). Modern oncology matches mechanism to mutation.' },
    { math: '4 · Screening and early detection', note: 'Stage 1 survival >> stage 4 survival for most cancers — early detection is the strongest lever. But screening finds slow cancers too (overdiagnosis), which is why guidelines are risk- and age-based, not universal.' },
  ],
};
---
<TopicPage slug="subjects/medicine/advanced/cancer-biology-and-oncology">
  <h2>The idea</h2>
  <p>
    Cancer is <strong>your own cells breaking the rules in their own DNA</strong> — mutations in
    growth genes, tumour suppressors and repair machinery, accumulated over decades. That
    framing (somatic evolution) explains everything: why it resists single drugs (resistant
    clones exist), why risk rises with age (time for mutations), and why the newest treatments
    work by re-engaging the immune system rather than poisoning dividing cells.
  </p>

  <Widget no="1" caption="the hallmarks, the treatments matched to mechanisms, and the screening logic" widget="equationStep" config={cancerCfg} />

  <h2>Where oncology is winning</h2>
  <ul>
    <li><strong>Targeted therapy:</strong> drugs matched to specific mutations — imatinib for chronic myeloid leukaemia turned a fatal disease into a daily pill (99% 5-year survival). Genotyping tumours before treating is now standard.</li>
    <li><strong>Immunotherapy (checkpoint inhibitors, Nobel 2018):</strong> cancers hide from T cells by activating "off switches" (PD-1); blocking the switch unleashes durable responses in melanoma, lung and kidney cancers — some patients disease-free for a decade.</li>
    <li><strong>CAR-T cells:</strong> a patient's own T cells reprogrammed to attack their leukaemia — living drugs, complete remissions in otherwise hopeless cases (approved 2017→).</li>
    <li><strong>The honest ledger:</strong> survival has risen for decades (US: ~50% → ~70% five-year since the 1970s), unevenly across cancer types. Smoking cessation prevented more cancers than any therapy cured — the prevention point, again.</li>
  </ul>
  <p class="sources"><strong>Sources:</strong> Hanahan & Weinberg, Cell (2000/2022); Nobel 2018 (Allison & Honjo); SEER Cancer Statistics; Imatinib trial history (Druker).</p>
</TopicPage>
