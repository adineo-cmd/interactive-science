  steps: [
    { math: '1 · Phase I: safety (~20–100 people)', note: 'First human exposure — healthy volunteers, escalating doses, watching for toxicity. Only ~70% pass. The dose for later phases is chosen here.' },
    { math: '2 · Phase II: does it work? (~100–500)', note: 'First efficacy signal in patients — response rates, dosing confirmation. ~33% pass. The attrition cliff: most drugs die here.' },
    { math: '3 · Phase III: does it beat the standard? (1,000–5,000+)', note: 'Randomised, controlled, often blinded, multi-site. The comparison against current care — the trial that decides approval. ~25–30% pass.' },
