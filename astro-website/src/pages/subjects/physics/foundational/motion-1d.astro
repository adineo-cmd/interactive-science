---
import Layout from '../../../../layouts/Layout.astro';
import WidgetLoader from '../../../../components/WidgetLoader.astro';
---
<Layout>
  <article class="topic-page">
    <span class="level-badge">Foundational</span>
    <h1>Motion in One Dimension</h1>
    <p>Along a straight line: position, velocity, acceleration.</p>

    <section>
      <h2>Concept</h2>
      <p>When acceleration <code>a</code> is constant, velocity changes linearly: <code>v = u + a t</code>.</p>
    </section>

    <section>
      <h2>Interactive plotter</h2>
      <div class="widget" id="plotter-widget">
        <WidgetLoader widgets={['plotter']} />
      </div>
    </section>

    <section>
      <h2>Slider lab — initial velocity</h2>
      <div class="widget" id="slider-widget">
        <WidgetLoader widgets={['sliderLab']} />
      </div>
    </section>

    <section>
      <h2>Step-by-step derivation</h2>
      <div class="widget" id="step-widget">
        <WidgetLoader widgets={['equationStep']} />
      </div>
    </section>
  </article>
</Layout>
