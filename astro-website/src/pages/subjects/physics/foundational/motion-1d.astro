---
import Layout from '../../../../layouts/Layout.astro';
import data from '../../../../data/topics.json';
import Quiz from '../../../../components/Quiz.astro';
import Glossary from '../../../../components/Glossary.astro';
import kidData from '../../../../data/kid-summaries.json';

const B = import.meta.env.BASE_URL.replace(/\/+$/, '') || '';
const { subjects, topics } = data;
const topic = topics.find((t) => t.slug === 'subjects/physics/foundational/motion-1d');
const kidSummary = kidData[topic.slug] ?? null;
const subject = subjects.find((s) => s.id === topic.subject);
const seq = topics.filter((t) => t.status !== 'planned');
const idx = seq.indexOf(topic);
const prev = seq[(idx - 1 + seq.length) % seq.length];
const next = seq[(idx + 1) % seq.length];

const plotCfg = {
  curves: [
    { expr: 'u*x + 0.5*a*x^2', label: 'position s(t)', color: '#1d4ed8' },
    { expr: 'u + a*x', label: 'velocity v(t)', color: '#b42318' },
  ],
  params: [
    { name: 'u', label: 'initial speed u', min: 0, max: 20, step: 1, value: 4, unit: 'm/s' },
    { name: 'a', label: 'acceleration a', min: -4, max: 4, step: 0.5, value: 2, unit: 'm/s²' },
  ],
  x: { min: 0, max: 6, label: 't (s)' },
  crossings: false,
  height: 360,
};

const labCfg = {
  params: [
    { name: 'u', label: 'initial speed u', min: 0, max: 20, step: 1, value: 10, unit: 'm/s' },
    { name: 'a', label: 'acceleration a', min: -5, max: 5, step: 0.5, value: 2, unit: 'm/s²' },
    { name: 't', label: 'elapsed time t', min: 0, max: 6, step: 0.1, value: 2, unit: 's' },
  ],
  readouts: [
    { label: 'velocity now', expr: 'u + a*t', unit: 'm/s' },
    { label: 'distance covered', expr: 'u*t + 0.5*a*t^2', unit: 'm' },
    { label: 'stops turning at t = u/|a|', expr: 'u/abs(a)', unit: 's' },
  ],
};

const stepsCfg = {
  steps: [
    { math: 'a = (v − u) / t', note: 'Acceleration is the rate velocity changes: change in velocity, per unit time.' },
    { math: 'a·t = v − u', note: 'Multiply both sides by t.' },
    { math: 'v = u + a·t', note: 'The first equation of motion — velocity grows (or shrinks) linearly.' },
    { math: 'v̄ = (u + v) / 2', note: 'With constant a the velocity changes evenly, so its average sits midway.' },
    { math: 's = v̄·t = ½(u + v)·t', note: 'Distance is average velocity times time.' },
    { math: 's = u·t + ½a·t²', note: 'Substitute v = u + a·t. The second equation of motion.' },
  ],
};

const checkCfg = {
  questions: [
    {
      q: 'A car cruises at a steady 60 km/h on a straight road. What is its acceleration?',
      choices: ['Zero', '6 m/s²', 'It depends on the mass', '9.8 m/s²'],
      answer: 0,
      why: 'Acceleration is how fast velocity changes. Steady velocity means no change.',
    },
    {
      q: 'You drop a ball and it speeds up as it falls. Which quantity is growing?',
      choices: [
        'Velocity, and therefore distance covered per second',
        'Acceleration, which keeps doubling',
        'The mass of the ball',
        'Only the time on the stopwatch',
      ],
      answer: 0,
      why: 'Near the ground acceleration stays roughly constant at 9.8 m/s²; velocity is what climbs.',
    },
    {
      q: 'On a velocity-time graph, what does the area under the line represent?',
      choices: ['Distance travelled', 'Acceleration', 'Mass', 'Force'],
      answer: 0,
      why: 'Velocity multiplied by time is distance — the area is exactly that product.',
    },
  ],
};

const vecCfg = { type: 'vector', unit: 'm/s', x: { min: -10, max: 10 }, y: { min: -10, max: 10 }, start: [6, 4] };
---
<Layout title={`${topic.title} — ${subject.name} — Interactive Atlas`} description={topic.summary}>
  <div class="wrap">
    <div class="topic-grid">
      <aside class="topic-aside">
        <a class="back" href={`${B}/subjects/${subject.id}/`}>← all of {subject.name}</a>
        <dl>
          <dt>subject</dt><dd><span class="dot" style={`--dot:${subject.ink}; display:inline-block; margin-right:.4rem`}></span>{subject.name}</dd>
          <dt>level</dt><dd>{topic.level}</dd>
          <dt>time</dt><dd>{topic.minutes} min</dd>
          <dt>tags</dt><dd>{topic.tags.slice(0, 3).join(', ')}</dd>
        </dl>
      </aside>
      <article>
        <header class="topic-head">
          <p class="crumb"><a href={B + '/'}>atlas</a><span class="sep">/</span><a href={`${B}/subjects/${subject.id}/`}>{subject.name}</a><span class="sep">/</span>{topic.level}</p>
          <h1>{topic.title}</h1>
          <p class="lede">{topic.summary}</p>
        </header>

        {kidSummary && (
          <aside class="kid-note" aria-label="Summary for young readers">
            <p><strong>For young explorers:</strong> {kidSummary}</p>
          </aside>
        )}
        <div class="topic-body">
          <h2>The idea</h2>
          <p>
            Every journey — a walk to school, a train ride, a thrown ball — is a story that physics
            tells with just three numbers. <strong>Position</strong> <code>s</code> says where you
            are along the line. <strong>Velocity</strong> <code>v</code> says how fast that position
            is changing, and in which direction. <Glossary term="acceleration" def="The rate at which velocity changes, measured in metres per second squared. A constant acceleration means velocity grows by the same amount every second." />
            <code>a</code> says how fast the <em>velocity</em> is changing. That is the whole
            vocabulary: position, rate of change of position, rate of change of rate of change.
          </p>
          <p>
            The everyday versions are familiar. Your car's odometer tracks position, the
            speedometer shows velocity, and the shove you feel when the driver stamps on the
            accelerator is acceleration announcing itself. What is less familiar is how tightly
            these three are linked. If acceleration is <em>constant</em> — as it very nearly is for
            a coasting bicycle, a braking car or a falling stone — then two short equations pin
            down the entire motion, past and future. In the graph below, the blue curve is position
            and the red one velocity: drag the initial speed <code>u</code> and the acceleration
            <code>a</code> and watch how a straight-line velocity curve bends the position curve
            into a parabola.
          </p>
          <p>
            Why does this matter? Because one-dimensional motion is the atom of mechanics. Braking
            distances on wet roads, the runway length a airliner needs, the depth of a well you
            drop a stone into, the safety-crumple zones engineered into a car body — all of them
            are the two equations below, applied with care. Master this page and every harder
            problem, from projectiles to orbits, is assembled from these same parts.
          </p>

          <figure class="widget">
            <figcaption><span class="fig-no">fig. 1</span><span>position and velocity against time — drag the sliders and the curves follow</span></figcaption>
            <div class="widget-body">
              <div data-widget="plotter" data-config={JSON.stringify(plotCfg)}></div>
            </div>
          </figure>

          <figure class="widget">
            <figcaption><span class="fig-no">fig. 2</span><span>the two equations, evaluated live</span></figcaption>
            <div class="widget-body">
              <div data-widget="sliderLab" data-config={JSON.stringify(labCfg)}></div>
            </div>
          </figure>

          <h2>Measuring motion: quantities, units and instruments</h2>
          <p>
            Physics begins with measurement, and motion rests on exactly two base quantities:
            <strong>length</strong>, measured in metres (m), and <strong>time</strong>, measured in
            seconds (s). Every other quantity on this page is built from them. Speed is metres per
            second (m/s); acceleration is metres per second <em>per</em> second, written m/s² —
            meaning "each second, the velocity changes by this many m/s". Prefixes keep the numbers
            manageable: 1 km = 1,000 m, 1 cm = 0.01 m, 1 mm = 0.001 m. A motorway journey of
            120 km at a steady 30 m/s is easier to handle once you convert everything to metres and
            seconds.
          </p>
          <p>
            Motion also forces a distinction you will use for the rest of physics: between
            <strong>scalars</strong> (size only) and <strong>vectors</strong> (size and direction).
            <em>Distance</em> is a scalar — walk 3 m east then 4 m north and you have travelled
            7 m. <em>Displacement</em> is a vector — the straight arrow from start to finish, which
            is only 5 m long (a 3-4-5 triangle) and points north-east. Speed is the scalar partner
            of velocity in the same way. Instruments, too, differ in what they can resolve: a
            metre rule is trustworthy to about 1 mm, <Glossary term="vernier calipers" def="A sliding measuring instrument whose auxiliary scale lets you read lengths to 0.1 mm." />
            read to 0.1 mm, and a micrometer screw gauge to 0.01 mm — enough to measure the
            diameter of a human hair or a wire.
          </p>
          <p>
            Time is the sneakier quantity. Your own reaction time is around 0.2 s, which is hopeless
            for anything fast, so laboratories use <Glossary term="light gates" def="An electronic sensor that records the moment a moving object interrupts a beam of light, timing intervals to the nearest millisecond." />:
            a trolley carries a card that interrupts a light beam, and the timer logs the interval
            to the millisecond. If the card is 5.0 cm long and the beam is blocked for 0.025 s, the
            trolley's speed <em>at that point</em> is 0.050 ÷ 0.025 = 2.0 m/s — an
            <em>instantaneous</em> speed, not an average. For a pendulum, you time
            <em>many</em> swings (say 20) and divide, so that reaction-time error is spread thin.
          </p>
          <p><em>Common misconception:</em> distance and displacement are not synonyms. A runner
          completing one lap of a 400 m track has travelled 400 m but has zero displacement — she
          finishes exactly where she started. Exams love this difference.</p>

          <h2>Speed and distance–time graphs</h2>
          <p>
            <strong>Average speed</strong> is total distance divided by total time, and it is the
            number your car's trip computer reports. A cyclist who covers 300 m in 40 s averages
            300 ÷ 40 = 7.5 m/s. To convert between units, remember 1 km/h is 1,000 m spread over
            3,600 s, so 1 km/h = 1/3.6 m/s ≈ 0.28 m/s; dividing by 3.6 converts km/h to m/s, and a
            car at 90 km/h is doing 25 m/s. <strong>Instantaneous speed</strong> is what the
            speedometer needle reads: the speed at one instant, not averaged over the trip.
          </p>
          <p>
            A <strong>distance–time graph</strong> compresses the whole journey into one picture,
            and its ruling idea is that <em>the gradient (steepness) is the speed</em>. A straight
            sloping line means steady speed; a horizontal line means the object is at rest; a
            steepening curve means the object is speeding up; a flattening curve means it is slowing
            down. If a delivery van's graph rises 600 m over 5 minutes (300 s), its speed is
            600 ÷ 300 = 2 m/s — you simply read the rise and run off the axes. To find the speed at
            a single instant on a curve, draw a tangent to the curve at that point and take the
            tangent's gradient.
          </p>

          <h2>Acceleration and velocity–time graphs</h2>
          <p>
            <strong>Acceleration</strong> is the change in velocity divided by the time taken for
            that change: <code>a = (v − u) / t</code>, where <code>u</code> is the starting
            velocity and <code>v</code> the finishing one. A car that goes from rest to 24 m/s in
            8 s accelerates at (24 − 0) ÷ 8 = 3 m/s² — every second, it gains another 3 m/s of
            velocity. A negative answer means the velocity along your chosen direction is
            decreasing: the car is braking. There is no separate physics for "deceleration"; it is
            just acceleration with a minus sign.
          </p>
          <p>
            The <strong>velocity–time graph</strong> is the most information-dense chart in
            elementary mechanics, because two different readings hide in it. The
            <em>gradient</em> is the acceleration; the <em>area under the line</em> is the distance
            travelled. Take the car above: its v–t line climbs from 0 to 24 m/s in 8 s, forming a
            triangle. The area is ½ × base × height = ½ × 8 × 24 = 96 m — so the car covered 96 m
            while reaching 24 m/s. You can check that with average velocity: the velocity climbs
            evenly from 0 to 24 m/s, so its average is 12 m/s, and 12 m/s × 8 s = 96 m. Two routes,
            one answer: that consistency is what makes graphs trustworthy.
          </p>
          <p><em>Common misconception:</em> "acceleration" does not mean "speeding up" — it means
          <em>changing velocity</em>. A braking car accelerates (backwards). A car rounding a bend
          at a perfectly steady 60 km/h is accelerating too, because its direction of travel is
          changing. And a car cruising at a steady 60 km/h on a straight road has
          <strong>zero</strong> acceleration, however fast it is going. Constant speed and constant
          acceleration are completely different claims.</p>

          <h2>Where the equations come from</h2>
          <p>
            Nothing below is memorised blindly — both equations fall straight out of the definition
            of acceleration, in six honest steps. The trick that produces the second equation is
            the average velocity: because velocity changes <em>evenly</em> under constant
            acceleration, its average over the trip sits exactly midway between <code>u</code> and
            <code>v</code>.
          </p>

          <figure class="widget">
            <figcaption><span class="fig-no">fig. 3</span><span>two equations, six honest steps</span></figcaption>
            <div class="widget-body">
              <div data-widget="equationStep" data-config={JSON.stringify(stepsCfg)}></div>
            </div>
          </figure>

          <p>
            A third equation follows by eliminating <code>t</code> between the two: <code>v² = u²
            + 2·a·s</code>. It is the one to reach for when a question never mentions time. Braking
            example: a car doing 20 m/s brakes at −5 m/s². How far before it stops? With
            <code>v = 0</code>: 0 = 20² + 2·(−5)·s, so s = 400 ÷ 10 = 40 m — about eight car
            lengths, and the reason "double your speed, quadruple your stopping distance" is a rule
            of thumb worth respecting: stopping distance grows with the <em>square</em> of speed.
          </p>

          <h2>Free fall: gravity as an acceleration</h2>
          <p>
            Drop anything near the Earth's surface and, if air resistance is small, it gains
            downward velocity at the same rate as anything else: <strong>g ≈ 9.8 m/s²</strong>,
            regardless of its mass. This was Galileo's great insight — the story of him dropping
            cannonballs from the Leaning Tower of Pisa is probably legend, but his experiments
            rolling balls down gently sloped ramps (which slowed the motion enough to time with the
            clocks of his day) showed it convincingly. Apollo 15 commander David Scott settled the
            matter dramatically in 1971 by letting a hammer and a falcon feather fall together on
            the airless Moon; both hit the dust at once. The everyday counter-evidence — paper
            fluttering, feathers drifting — is air resistance interfering, not a law of nature.
          </p>
          <p>
            Free fall is just the equations of motion with <code>a = g</code> and, if you drop from
            rest, <code>u = 0</code>: velocity after time t is <code>v = g·t</code>, and distance
            fallen is <code>s = ½·g·t²</code>. Drop a stone down a 45 m well: 45 = ½ × 9.8 × t²,
            so t² = 90 ÷ 9.8 ≈ 9.2, giving t ≈ 3.0 s, and it arrives at about 9.8 × 3.0 ≈ 29 m/s
            — around 105 km/h. Notice how the square works against you: after 6 s the same stone
            would have fallen 176 m, four times as far, because fallen distance grows with the
            square of the time.
          </p>
          <p><em>Common misconception:</em> heavier things do <em>not</em> fall faster. Gravity
          pulls twice as hard on a 2 kg stone as on a 1 kg one, but the 2 kg stone has twice the
          inertia to move, and the two effects cancel exactly. What differs in real life is air
          resistance relative to weight — a crumpled ball of paper falls faster than a flat sheet
          of the same mass.</p>

          <h2>Vectors, previewed</h2>
          <p>
            Straight-line motion keeps every arrow pointing along one line, so direction can hide
            inside a plus or minus sign. The moment motion turns a corner, velocity must be treated
            as what it truly is: a vector — an arrow with size <em>and</em> direction. Any such
            arrow can be split into components along the x- and y-axes, and those components behave
            independently. Drag the arrowhead below and watch the readouts: the magnitude comes from
            Pythagoras' theorem, √(vx² + vy²), and the components change even when the length does
            not.
          </p>

          <figure class="widget">
            <figcaption><span class="fig-no">fig. 4</span><span>one arrow, two components — drag the head</span></figcaption>
            <div class="widget-body">
              <div data-widget="diagramBuilder" data-config={JSON.stringify(vecCfg)}></div>
            </div>
          </figure>

          <p>
            This is the doorway to two-dimensional motion. A projectile's horizontal velocity
            carries on unchanged (nothing pushes it sideways) while gravity steadily changes its
            vertical velocity — two one-dimensional problems running side by side, sharing only a
            stopwatch. That decomposition idea will carry you through projectiles, river-crossings
            and eventually orbits.
          </p>

          <h2>Going deeper</h2>
          <p>
            The average-versus-instantaneous distinction conceals one of the most productive ideas
            in mathematics. Instantaneous speed is "distance covered over an interval that shrinks
            to nothing" — a limit. Making that idea precise is the founding move of calculus:
            velocity is the <em>derivative</em> of position with respect to time, acceleration is
            the derivative of velocity, and the area under a velocity–time curve is the
            <em>integral</em> of velocity. The equations of motion on this page are simply what you
            get when you integrate a constant acceleration twice; when acceleration varies, you
            need the full machinery.
          </p>
          <p>
            And acceleration usually <em>does</em> vary. Air resistance grows with speed (roughly
            with its square), so a falling object is progressively checked: a skydiver spread-eagle
            typically tops out near 55 m/s — <strong>terminal velocity</strong> — where drag
            balances weight, and a streamlined head-down diver can exceed 90 m/s. A car's
            acceleration fades as speed rises for the same reason: power is finite, and drag
            devours it. Real velocity–time graphs curve, and reading curved graphs by tangents —
            as you practised above — is the honest skill.
          </p>
          <p>
            Measurement, finally, has gone digital. Police radar guns and tennis line-calls read
            speed from the Doppler shift of reflected waves; GPS receivers infer your velocity from
            how the timing of satellite signals drifts; the chip in your phone that rotates the
            screen when you turn it is a tiny accelerometer measuring <code>a</code> directly,
            thousands of times a second. Crash investigators reconstruct braking from skid marks
            using exactly <code>v² = u² + 2·a·s</code>. One caveat keeps physicists humble: Newton's
            equations are superb up to everyday speeds, but Einstein's special relativity shows no
            object can be measured moving faster than light, c ≈ 3 × 10⁸ m/s, and GPS satellites
            actually need relativistic corrections (about 38 microseconds per day) or the system
            would drift by kilometres. For everything you will meet on this page, though, the two
            equations and a good graph remain the complete story.
          </p>

          <p class="sources"><strong>Sources:</strong> Cambridge IGCSE Physics 0625 syllabus (2026–2028), sections 1.1–1.2; OpenStax, <em>College Physics</em>, chapters 2–3; NASA, Apollo 15 mission report (1971).</p>

          <Quiz questions={checkCfg.questions} />
        </div>

        <nav class="topic-next" aria-label="Lesson navigation">
          <div><span class="tn-label">previous lesson</span><a href={`${B}/${prev.slug}/`}>{prev.title}</a></div>
          <div style="text-align:right"><span class="tn-label">next lesson</span><a href={`${B}/${next.slug}/`}>{next.title}</a></div>
        </nav>
      </article>
    </div>
  </div>
</Layout>
