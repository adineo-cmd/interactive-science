const faradayCfg = {
  steps: [
    { math: '1 · Flux Φ = B × area', note: 'Magnetic flux counts field lines through a loop. Same field, bigger loop — more flux. Stronger magnet — more flux.' },
    { math: '2 · Change the flux → EMF appears', note: 'Faraday (1831): only CHANGING flux induces voltage. A still magnet in a still coil does nothing, however strong.' },
    { math: 'EMF = −N · ΔΦ/Δt', note: 'Faster change or more turns (N) means more voltage. The minus sign is Lenz\'s law.' },
    { math: '3 · Lenz\'s law: the induced current opposes the change', note: 'Push a magnet toward a coil and the coil pushes back; pull it away and the coil tugs it back. Energy conservation wearing a magnetic costume — otherwise you\'d get free energy.' },
    { math: '4 · Consequence: generators', note: 'Spin a coil in a field and flux swings sinusoidally — mains electricity is Faraday\'s law rotating at 50 or 60 Hz.' },
  ],
};
