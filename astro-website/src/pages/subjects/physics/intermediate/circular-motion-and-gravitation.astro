import Widget from '../../../../components/Widget.astro';

const orbitCfg = {
  params: [
    { name: 'r', label: 'orbital radius r', min: 6600, max: 50000, step: 100, value: 6800, unit: 'km' },
  ],
  readouts: [
    { label: 'orbital speed √(GM/r)', expr: 'sqrt(398600/r)', unit: 'km/s' },
    { label: 'orbital period 2πr/v', expr: '2*3.1416*r/sqrt(398600/r)/60', unit: 'min' },
    { label: 'needed centripetal a = v²/r', expr: '398600/(r*r)', unit: 'km/s²' },
  ],
};

const cmCornerCloze = {
  "text": "Double the cornering speed and the required grip multiplies by %%0%%, because both the momentum to bend and the rate of bending grow. On a wet road (μ ≈ 0.4) the 50 m corner's limit falls to about %%1%% km/h — whatever the sign says.",
  "answers": [
    [
      "four",
      "4",
      "4x",
      "x4"
    ],
    [
      "50",
      "fifty"
    ]
  ],
  "hint": "F = mv²/r hides a square; √(0.4 × 9.8 × 50) hides a square root."
};

const cmBucketPredict = {
  "q": "A child whirls a bucket of water overhead without spilling a drop. At the top of the swing, what keeps the water pressed in the bucket?",
  "choices": [
    "Centrifugal force pushing the water outward against the bucket's base",
    "The bucket's base pushing inward on the water — the only real force there is",
    "The water's stickiness to the bucket outweighing gravity at the top"
  ],
  "answer": 1,
  "why": "There is no outward push to draw on: every real force points the way the surface actually pushes. The bucket's base supplies the inward centripetal force — and the whirl must be quick enough that at the top the required v²/r is at least g."
};

const cmMoonEstimate = {
  "prompt": "The Moon is about 60 Earth-radii away. Roughly how strong is Earth's gravitational grip up there, in m/s²?",
  "unit": "m/s²",
  "answer": 0.0027,
  "factor": 2,
  "why": "9.8 / 60² ≈ 0.0027 m/s² — and the Moon's measured centripetal acceleration (v²/r from its 27.3-day period) matches it exactly. The falling Moon IS the falling apple.",
  "context": "About 0.03% of what you feel standing up — inverse-square is a brutal discount."
};

const cmPeriodsMatch = {
  "prompt": "One T²/r³ curve covers them all — match each resident of orbit to its period:",
  "pairs": [
    {
      "left": "the ISS (6,780 km radius)",
      "right": "92 minutes"
    },
    {
      "left": "Hubble (6,900 km)",
      "right": "95 minutes"
    },
    {
      "left": "GPS satellites (about 20,200 km)",
      "right": "half a day"
    },
    {
      "left": "the geostationary ring (42,164 km)",
      "right": "one sidereal day"
    },
    {
      "left": "the Moon (384,000 km)",
      "right": "27.3 days"
    }
  ],
  "why": "Slide outward and the demanded speed falls as 1/√r while the circle lengthens — the period grows as r^(3/2), Kepler's third law explained by Newton's inverse square."
};

const cmSpeedPlace = {
  "prompt": "You are moving around the Sun right now. Place Earth's orbital speed on the scale (km/s):",
  "labels": [
    "0",
    "15",
    "30",
    "45",
    "60"
  ],
  "scale": {
    "min": 0,
    "max": 60
  },
  "answer": 30,
  "tolerance": 3,
  "why": "Earth orbits at about 30 km/s — sustained by nothing but your own inertia while the Sun's grip curves you around. Mercury runs 47 km/s; Neptune, thirty times farther out, ambles at 5.4.",
  "context": "The speed ladder is v = √(GM/r) — closer means faster, no exceptions."
};

const cmStarBuckets = {
  "prompt": "Sort each fate into the right ending:",
  "buckets": [
    "White dwarf",
    "Supernova",
    "Black hole"
  ],
  "items": [
    {
      "label": "the Sun's own retirement, after swelling into a red giant",
      "bucket": 0
    },
    {
      "label": "an Earth-sized ember left behind by puffed-off outer layers",
      "bucket": 0
    },
    {
      "label": "the explosive death of a star that burned hot and fast",
      "bucket": 1
    },
    {
      "label": "leaves a neutron star behind — a sugar-cube outweighing a mountain",
      "bucket": 1
    },
    {
      "label": "the forges where calcium and iron were made",
      "bucket": 1
    },
    {
      "label": "gravity's endgame, past a mass limit",
      "bucket": 2
    }
  ],
  "why": "Low-mass stars retire quietly as white dwarfs; massive ones die young in supernovae — forging the heavy elements and leaving neutron stars — and the most massive collapse past rescue into black holes."
};

const cmSunCompare = {
  "prompt": "Drag the divider between the Sun's two acts:",
  "before": {
    "label": "Now — main sequence",
    "text": "The core, squeezed to about 15 million kelvin, fuses hydrogen into helium: 4 million tonnes of mass become energy every second, holding the star inflated against its own gravity for roughly 10 billion years."
  },
  "after": {
    "label": "Later — red giant, then white dwarf",
    "text": "The fuel runs out and the balance tips: the Sun swells into a red giant, puffs off its outer layers as a nebula, and retires as a white dwarf — an Earth-sized ember."
  },
  "why": "A stellar life is fusion against gravity; when the hydrogen runs out, the same two forces stage the ending."
};
---
<TopicPage slug="subjects/physics/intermediate/circular-motion-and-gravitation">

  <h2>Where you are, and what you will learn</h2>
  <p>
    This is an intermediate physics lesson. It assumes the foundational sequence,
    especially <em>Newton's Three Laws</em> (force, acceleration, free-body diagrams)
    and <em>Motion in One Dimension</em> (velocity as speed <em>and</em> direction),
    with <em>Energy and Its Conservation</em> in reserve for orbital energy. If those
    are shaky, repair them first — everything here is Newton's second law pointed at a
    circle, and then at the sky.
  </p>
  <p>By the end you will be able to:</p>
  <ul>
    <li>explain why uniform circular motion is acceleration, and compute a = v²/r;</li>
    <li>identify the real force supplying the centripetal force in any given situation;</li>
    <li>apply Newton's law of universal gravitation, including its inverse-square behaviour;</li>
    <li>derive orbit speed and period from gravity acting as centripetal force, and state Kepler's third law;</li>
    <li>explain weightlessness as free fall, and gravity's role in stars, galaxies and the dark-matter problem.</li>
  </ul>

  <h2>The idea</h2>
  <p>
    Move in a circle and you are <strong>always accelerating</strong> — not because your speed
    changes, but because your direction does. Velocity is speed <em>and</em> direction, so a
    changing direction is a changing velocity, and a changing velocity is an acceleration. It
    points at the centre, with size a = v²/r: something must supply it (a string, friction, a
    seat, gravity), or you exit on a tangent. That single piece of bookkeeping explains car
    cornering, spin cycles and artificial gravity. Paired with Newton's law of universal
    gravitation — one inverse-square law for apples, moons and galaxies — it becomes the
    engine of the cosmos: <strong>an orbit is free-fall that keeps missing</strong>, gravity
    bending your path exactly as fast as you travel forward. This chapter builds both halves
    and then points them at the Solar System and the stars.
  </p>

  <Widget no="1" caption="Earth-orbit calculator — drag the altitude and watch speed drop while period balloons" widget="sliderLab" config={orbitCfg} />
  <p>
    <strong>What to notice:</strong> drag the orbital radius outward and watch the two
    readouts respond in opposite directions — the demanded speed falls while the period
    balloons far faster (the r^(3/2) cubic, Kepler's third law, is hiding in the
    slider). Watch the centripetal-acceleration readout shrink as you go out: gravity
    weakens with distance, and the orbit must slow to match it. Find the radius where
    the period reads about 1,440 minutes and you have located the geostationary ring.
  </p>

  <p>
    At 200 km altitude (r ≈ 6,600 km from Earth's centre) the speed is 7.8 km/s and the trip
    takes 90 minutes — the space station's life. Slide out to geostationary distance (r ≈
    42,000 km) and the required speed falls to 3.1 km/s, with a period of exactly one
    sidereal day: the satellite hangs over one spot, which is how every TV dish aims at a
    fixed point in the sky. The readouts use GM⊕ = 398,600 km³/s².
  </p>

  <h2>Circular motion: the v²/r tax on turning</h2>
  <p>
    Go round a circle of radius r at constant speed v and your acceleration is
    <strong>a = v²/r</strong>, directed to the centre; the accompanying force (F = mv²/r) is
    called <strong>centripetal</strong> — "centre-seeking". It is not a new force, just the
    job description: whatever force is available (tension, friction, gravity) must amount to
    mv²/r, or the object leaves the circle. Worked example: a 1,000 kg car takes a 50 m-radius
    corner at 20 m/s. Required: mv²/r = 1,000 × 400/50 = 8,000 N of sideways grip — a
    friction coefficient of at least a/g = 8/9.8 ≈ 0.8, tyre rubber's dry-weather best. On a
    wet road (μ ≈ 0.4) the maximum cornering speed is √(μgr) = √(0.4 × 9.8 × 50) = 14 m/s —
    about 50 km/h, whatever the sign says. Notice the quadratic cruelty: <strong>double the
    speed and you need four times the force</strong>, because both the momentum to bend and
    the rate of bending grow. The same arithmetic sets a washing machine's spin speed (water
    leaves the clothes where the drum's holes offer no centripetal force), a runner's lean
    into the bend, and a blood cell's load in a centrifuge.
  </p>
  <Widget no="2" caption="fill the blanks — the quadratic cruelty of cornering" widget="cloze" config={cmCornerCloze} />
  <p><em>Common misconception:</em> centrifugal force, pushing you <em>outward</em> in a
  turning car. Nothing does: in the car's frame (which is accelerating) Newton's laws need a
  fiction to keep working, and that fiction is "centrifugal force". In the road's frame the
  physics is clean — the car door pushes you <em>inward</em>, forcing you to share the car's
  turn. Outward-flung water in a spin cycle is simply water continuing in a straight line
  (tangentially) once the drum stops supplying a centre-seeking force. If you ever catch
  yourself drawing an outward arrow in a free-body diagram, stop: every real force points the
  way the surface or field actually pushes.</p>
  <Widget no="3" caption="bet first — what holds the water in the overhead bucket?" widget="predict" config={cmBucketPredict} />
  <p>
    <strong>So far:</strong> turning is acceleration, and something real — a string, a
    tyre, a seat, a floor — must always supply it. On the cosmic scale the supplier is
    gravity, and the next section gives that force its universal form.
  </p>

  <h2>Gravity: the universal inverse square</h2>
  <p>
    Newton's synthesis: every pair of masses attracts with <strong>F = Gm₁m₂/r²</strong>,
    where G = 6.674 × 10⁻¹¹ N·m²/kg² is small enough that gravity only rules at astronomical
    scales. The law's structure does the heavy lifting: <em>inverse square</em> means double
    the distance, quarter the pull. Newton's own validation is the best worked example in the
    history of physics: the Moon is about 60 Earth-radii away, so Earth's grip there should be
    9.8/60² ≈ 0.0027 m/s². The Moon's actual centripetal acceleration — v²/r from its
    measured period (27.3 days) and distance (384,000 km) — is 0.0027 m/s². The falling Moon
    <em>is</em> the falling apple, 3,600 times weaker and sixty times farther. One law, both
    events — and every planet, tide and galaxy since.
  </p>
  <Widget no="4" caption="call the magnitude — how hard does Earth pull the Moon?" widget="estimate" config={cmMoonEstimate} />
  <p>
    A companion relation comes free: the gravitational <strong>field strength</strong> at
    distance r from mass M is g = GM/r². At the International Space Station's 400 km
    altitude, g ≈ 8.7 m/s² — <strong>89% of surface gravity</strong>. Astronauts float not
    because gravity is absent but because they and their ship fall together at the same
    rate; nothing pushes floor-against-body, and that push is the sensation we call weight.
    Weightlessness is free fall, not the absence of gravity — the same state a rollercoaster
    drop and NASA's "vomit comet" aircraft reproduce for minutes at a time.
  </p>
  <p><em>Common misconception:</em> "astronauts float because there is no gravity in
  space." At the station's altitude gravity still pulls at 89% of surface strength —
  strong enough to level a city if delivered as an impact. The astronauts float because
  they and their ship fall together around Earth: with nothing pushing
  floor-against-body, the sensation we call weight never gets built.</p>
  <p>
    <strong>So far:</strong> one inverse-square law covers the apple and the Moon alike,
    and field strength falls off with the square of distance. Now point it sideways: set
    gravity to work as the centripetal force, and the orbits algebra themselves into
    place.
  </p>

  <h2>Orbits: the algebra of staying aloft</h2>
  <p>
    For a circular orbit, gravity <em>is</em> the centripetal force: GMm/r² = mv²/r. The
    satellite's mass cancels — <strong>orbit speed depends only on the central mass and the
    radius</strong>: v = √(GM/r). This is why a spacewalking astronaut orbits alongside the
    station rather than dropping behind: a 100 kg satellite and a 10,000 kg one at the same
    radius have identical orbits. The widget's readouts are this equation and its period
    cousin T = 2πr/v. Slide out and two effects compound: the demanded speed falls as 1/√r
    <em>and</em> the circle is longer — so the period grows as r^(3/2). That cubic is
    <strong>Kepler's third law</strong>, which Kepler found empirically in 1619 and Newton's
    law explains: the Moon (384,000 km, 27.3 days), the ISS (6,780 km, 92 minutes) and the
    Hubble telescope (6,900 km, 95 minutes) all sit on the same T²/r³ curve.
  </p>
  <Widget no="5" caption="pair each orbit with its period" widget="match" config={cmPeriodsMatch} />
  <p><em>Common misconception:</em> "heavier satellites must orbit faster, since gravity
  pulls them harder." Gravity does pull a heavier satellite harder — and its inertia is
  greater by exactly the same factor, so the two cancel: orbit speed depends only on the
  central mass and the radius. That is why a spacewalking astronaut and a 10,000 kg
  station at the same radius share one orbit.</p>
  <p>
    The <strong>geostationary</strong> case falls out of the slider: find the radius where
    T = 24 hours and you get 42,164 km — the unique altitude where a satellite matches
    Earth's spin, the most valuable real estate in orbit (communications, weather, direct
    broadcast). Low orbits trade period for detail and latency: Earth-observation satellites
    see more at 500–800 km but race through 16 sunrises a day. Between them lies the
    engineering of everything from GPS (about 20,200 km, half-day periods) to Starlink
    shells (550 km, ~95-minute laps).
  </p>

  <h2>The Solar System as a lab bench</h2>
  <p>
    The same law organises the whole neighbourhood. Earth spins once per day (which defines
    the day) and orbits the Sun once per year at about <strong>30 km/s</strong> — you are
    moving that fast right now, tangentially, sustained by nothing but your own inertia while
    the Sun's grip curves you around. The planets are a speed ladder straight from
    v = √(GM/r): Mercury, closest, runs at 47 km/s; Earth at 30; Neptune, thirty times
    farther out, ambles at 5.4 km/s. Kepler's laws compress all of it: orbits are ellipses
    with the Sun at one focus; a planet sweeps equal areas in equal times (fast at its
    closest, slow at its farthest — Earth moves fastest in early January); and T² ∝ r³ across
    the board. Newton's inverse square turned Kepler's three empirical rules into corollaries
    — the moment physics and astronomy became the same subject.
  </p>
  <Widget no="6" caption="place your own orbital speed on the scale" widget="place" config={cmSpeedPlace} />

  <h2>Stars and the universe</h2>
  <p>
    Gravity organises more than orbits; it runs stellar lives. The <strong>Sun</strong> is a
    main-sequence star: its core, squeezed to about 15 million kelvin by the weight of the
    layers above, fuses hydrogen into helium, converting about 4 million tonnes of mass to
    energy every second (E = mc²) and holding the star inflated against its own gravity for
    roughly 10 billion years. When the fuel runs out, the balance tips: the Sun will swell
    into a <strong>red giant</strong>, puff off its outer layers as a nebula, and retire as a
    <strong>white dwarf</strong> — an Earth-sized ember. More massive stars, having burned
    hotter and faster, die young and violently in <strong>supernovae</strong>, leaving neutron
    stars (a sugar-cube of which outweighs a mountain range) or, past a mass limit,
    <strong>black holes</strong> — gravity's endgame, where the inverse-square law's
    consequences outrun every escape. The elements heavier than helium, notably, were forged
    in such stars and their explosions: the calcium in your bones is stellar shrapnel.
  </p>
  <Widget no="7" caption="file the stellar endings — how does each star retire?" widget="sort-buckets" config={cmStarBuckets} />
  <p>
    At the largest scale, gravity's structure shows up as motion. Galaxies rotate — and the
    outer stars orbit <em>too fast</em>: the visible mass cannot supply their centripetal
    force, a mismatch that has, since Vera Rubin's 1970s rotation curves, forced the
    hypothesis of invisible <strong>dark matter</strong> (about five-sixths of all matter) or
    a revision of gravity itself. Meanwhile the universe as a whole is expanding: light from
    distant galaxies arrives stretched toward the red (a Doppler shift, as the Waves chapter
    explains), Hubble discovered the stretch grows with distance, and the 1965 discovery of
    the cosmic microwave background — the cooled afterglow of a hot dense beginning — fixed
    the modern picture: an expanding, cooling universe 13.8 billion years old, whose large
    structure gravity has been sculpting ever since.
  </p>
  <Widget no="8" caption="slide the divider — the Sun today vs the Sun after the fuel runs out" widget="compare" config={cmSunCompare} />

  <h2>Check yourself</h2>
  <p>Try these before moving on. Feedback follows each answer.</p>
  <ol>
    <li>A 1,000 kg car takes a 25 m-radius corner at 10 m/s. What centripetal acceleration — and what force — does the turn require?</li>
    <li>Why do astronauts float inside the International Space Station even though gravity there is about 89% of surface gravity?</li>
    <li>The Moon sits about 60 Earth-radii away. Roughly how strong is Earth's pull there compared with the surface — and how did Newton turn that into a proof?</li>
  </ol>
  <p>
    <strong>Feedback:</strong> (1) a = v²/r = 100/25 = 4 m/s², so F = mv²/r = 4,000 N of
    sideways grip; note how the smaller, slower corner needs less than half the force of
    the lesson's 50 m example at 20 m/s. (2) Not because gravity is absent — because the
    station and everything in it fall together around Earth: nothing pushes
    floor-against-body, and that push is the sensation of weight. (3) By the inverse
    square, 1/60² = 1/3,600 of surface gravity, about 0.0027 m/s²; Newton computed the
    Moon's actual centripetal acceleration from its measured period and distance and got
    the same number — one law for apple and Moon.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>Uniform circular motion is acceleration: velocity changes direction, so a = v²/r points at the centre.</li>
    <li>Centripetal force is a job description, not a new force — tension, friction, a seat or gravity must amount to mv²/r.</li>
    <li>The v²/r tax is quadratic: double the speed and you need four times the force.</li>
    <li>Gravitation is F = Gm₁m₂/r² — inverse square: double the distance, quarter the pull; field strength is g = GM/r².</li>
    <li>An orbit is free-fall that keeps missing: gravity is the centripetal force, so v = √(GM/r) and the satellite's own mass cancels.</li>
    <li>Period grows as r^(3/2) — Kepler's third law — and geostationary altitude is the unique radius with a one-day period.</li>
    <li>Weightlessness is free fall, not absent gravity; gravity also runs stellar lives and exposes dark matter through too-fast galaxy rotation.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    <em>Projectile &amp; 2D Motion</em> works the same curved-path bookkeeping near the
    ground; <em>Momentum &amp; Collisions</em> adds the conserved quantity that makes
    orbital docking arithmetic; and when distant galaxies arrive redshifted, it is
    <em>Waves and Sound</em> that explains the Doppler shift quoted in this chapter.
  </p>

  <h2>Going deeper</h2>
  <p>
    <strong>Tides: gravity's differential at work.</strong> The Moon does not raise the
    oceans by "pulling them up" — it pulls <em>everything</em>, but harder on the near side
    than the far side (the inverse square again). The <em>differences</em> stretch Earth into
    two bulges, one facing the Moon and one opposite it, and as Earth spins daily beneath
    them most coasts get two high tides. The Sun contributes about 46% of the Moon's tidal
    pull: aligned at new and full moon the effects add (spring tides), at quarter moons they
    partially cancel (neap tides). Tidal friction, over deep time, has slowed Earth's spin
    (days lengthen by about 2 ms per century) and pushed the Moon outward (3.8 cm per year,
    measured by laser ranging to reflectors the Apollo missions left).
  </p>
  <p>
    <strong>Artificial gravity and the spinning problem.</strong> A rotating station supplies
    centripetal force through its floor, mimicking weight: for comfortable a = 9.8 m/s², the
    product ω²r must equal 9.8. Small radius forces fast spin — a 10 m-radius ring needs a
    full turn per 3 seconds, enough to make half the crew sick; a comfortable 1-rpm habitat
    needs r ≈ 900 m. This scale problem is why every film's small spinning station is
    physically unfair and why rotating habitats, if built, will be enormous.
  </p>
  <p>
    <strong>Ellipses, not just circles.</strong> Circular orbits are the tidy special case;
    real orbits are ellipses, and the character of an orbit is graded by its eccentricity —
    Earth's is a nearly circular 0.017, Halley's comet a stretched 0.967 that swings inside
    Mercury's orbit and back beyond Neptune. The orbital energy (kinetic + gravitational
    potential) is conserved along the path, which is why a comet's speed near the Sun
    (kinetic-rich) far exceeds its speed out at the fringes (potential-rich) — Kepler's equal
    areas is energy bookkeeping wearing geometry. And "escape velocity" — 11.2 km/s from
    Earth — is the speed at which kinetic energy exactly pays off the gravitational potential
    to infinity: not a thrust requirement, an energy budget.
  </p>
  <p>
    <strong>Open questions at the frontier.</strong> Dark matter is the standing anomaly: the
    rotation curves, gravitational lensing and the cosmic web all demand more mass than we
    can see, and candidates (weakly interacting particles, primordial black holes) remain
    undetected after forty years of searching. Dark energy — the observation, since 1998,
    that the expansion is <em>accelerating</em> — is stranger still, making up about 68% of
    the universe's budget with no agreed mechanism. And gravitational waves (first detected
    2015, from two colliding black holes a billion light-years away) have opened gravity as a
    observational science: ripples in spacetime itself, measured as a length change of one
    part in 10²¹. The chapter's inverse-square law, complete since 1687, is still generating
    discoveries — which is what a deep physical law looks like: old equations, new universe.
  </p>
  <p class="sources"><strong>Sources:</strong> Newton, Principia (1687); OpenStax, College Physics (ch. 6, Uniform Circular Motion and Gravitation); NASA/JPL Solar System fact sheets; Rubin & Ford (1970) galaxy rotation curves; LIGO Scientific Collaboration first-detection summary (2016). Source text: OpenStax (https://openstax.org), CC BY 4.0 — adapted for Interactive Atlas.</p>
</TopicPage>
