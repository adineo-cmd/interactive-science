const boltzCfg = {
  curves: [
    { expr: 'exp(-x/t)', label: 'occupation probability', color: '#b42318', width: 2.2 },
    { expr: 'exp(-x/0.5)', label: 'at half the temperature', color: 'rgba(23,36,32,0.45)', width: 1.3 },
  ],
