  y: { min: -3, max: 4, label: 'electron energy (eV)' },
  crossings: true,
  height: 350,
};

const uncCfg = {
  title: 'Worked example: uncertainty sets the size of the atom',
  steps: [
    { math: 'Δx ≈ 0.1 nm (an electron squeezed to atomic size)', note: 'if the atom held the electron tighter, this width would shrink.' },
    { math: 'Δp ≥ ħ / 2Δx ≈ 5 × 10⁻²⁵ kg·m/s', note: 'confinement forces momentum spread — there is no way around it.' },
    { math: 'KE ≈ (Δp)²/2m ≈ 1.5 × 10⁻¹⁹ J ≈ 1 eV', note: 'squeezing means moving: confinement energy of order the electron-volt scale.' },
    { math: 'squeeze to 0.01 nm → KE ≈ 100 eV', note: 'ten times tighter costs a hundred times more energy — the 1/L² blow-up.' },
    { math: '∴ atoms are ~0.1 nm', note: 'atoms balance confinement energy against electrostatic attraction. The uncertainty principle fixes the size of everything you have ever touched.' },
  ],
};

const qfSeamsOrder = {
  "prompt": "Assemble the story of the first crack, in order:",
  "items": [
    "Classical electromagnetism predicts any warm object radiates infinite energy at short wavelengths — the ultraviolet catastrophe: every oven a death ray",
