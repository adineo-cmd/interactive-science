---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const maxwellCfg = {
  steps: [
    { math: '1 · Gauss (electric): charge makes field', note: 'Electric field lines begin and end on charges. The field poking out of any closed box counts the charge inside. Positive sources, negative sinks.' },
    { math: '2 · Gauss (magnetic): no magnetic charge', note: 'Field lines through any closed box net to zero — magnetic field lines always close on themselves. There are no isolated north poles.' },
    { math: '3 · Faraday: changing B makes E', note: 'A time-varying magnetic field curls an electric field around itself — the generator equation.' },
    { math: '4 · Ampère–Maxwell: currents and changing E make B', note: 'Maxwell\'s addition (a changing electric field also curls a magnetic field) closed the loop: each field can regenerate the other.' },
    { math: '5 · The wave falls out', note: 'Self-regenerating E and B waves travel at 1/√(μ₀ε₀) = 3 × 10⁸ m/s — the measured speed of light. "Light is an electromagnetic disturbance." Maxwell, 1865.' },
  ],
};

const emSolenoidEst = {
  "prompt": "A solenoid of 500 turns over 10 cm (n = 5,000 per metre) carries 2 A. What is the field B inside (B = μ₀nI, μ₀ = 4π × 10⁻⁷)?",
  "unit": "tesla",
  "answer": 0.0126,
  "factor": 2,
  "why": "B = μ₀nI ≈ 0.0126 T — some 250 times Earth's ~50 μT, from a coil you could hold.",
  "context": "Earth's surface field is about 50 μT; the solenoid multiplies it 250-fold with a car battery's worth of current."
};

const emPoleSpot = {
  "prompt": "One line of this student's magnet notes is wrong — click it:",
  "lines": [
    "A compass needle's north tip is attracted toward the Arctic.",
    "Unlike poles attract, so the pole up there must be a magnetic south pole.",
    "Cutting a bar magnet in two isolates a monopole — a single free north pole.",
    "Physicists often call the Arctic one the 'north magnetic pole' purely by location, which keeps the confusion alive.",
    "Outside the Earth the field lines run south, closing the loop through the planet's core, where the dynamo lives."
  ],
  "errorLine": 2,
  "correction": "You get two weaker dipoles: magnetic field lines always close on themselves, with no free ends — that everyday observation is half of Maxwell's magnetic Gauss law.",
  "why": "There are no isolated poles — the net flux through any closed surface is zero."
};

const emKwhCloze = {
  "text": "One kilowatt-hour is %%0%% joules — so a 2 kW heater run for 3 hours consumes %%1%% kWh. A 10 W LED left on all year burns 87.6 kWh where a 60 W incandescent burned 526 kWh — a factor-of-six saving hiding in P = VI.",
  "answers": [
    [
      "3.6 million",
      "3,600,000",
      "3600000",
      "3.6e6"
    ],
    [
      "6"
    ]
  ],
  "hint": "A thousand watts for an hour, in joules; then the heater's arithmetic."
};

const emCurrentSort = {
  "prompt": "Around a series loop — file each quantity:",
  "buckets": [
    "the same everywhere in the loop",
    "falls across the components"
  ],
  "items": [
    {
      "label": "the current leaving the battery",
      "bucket": 0
    },
    {
      "label": "the current returning to the battery",
      "bucket": 0
    },
    {
      "label": "the flow rate of charge",
      "bucket": 0
    },
    {
      "label": "the energy per charge (the voltage)",
      "bucket": 1
    },
    {
      "label": "the voltage across each component",
      "bucket": 1
    }
  ],
  "why": "Charge is conserved: the current leaving equals the current returning, always. Every 'parallel resistors share current equally' error starts here."
};

const emBatteryBranch = {
  "root": "A 12 V battery with 0.05 Ω internal resistance drives a 1.95 Ω load. Walk the calculation.",
  "nodes": {
    "start": {
      "text": "First: what total resistance does the loop current see?",
      "choices": [
        {
          "label": "1.95 Ω — the internal resistance is negligible",
          "next": "ideal"
        },
        {
          "label": "2.0 Ω — internal resistance in series with the load",
          "next": "real"
        }
      ]
    },
    "ideal": {
      "text": "Kirchhoff's voltage law still holds — but this prediction ignores where 0.3 V of the loop's drop actually lands: inside the battery itself.",
      "choices": [
        {
          "label": "Do it properly",
          "next": "real"
        }
      ]
    },
    "real": {
      "text": "I = 12/2.0 = 6 A, and the terminal voltage sags to 12 − 6 × 0.05 = 11.7 V — the missing 0.3 V heats the battery itself. That single calculation is why car batteries are specified by cold-cranking current and why jump leads are thick copper.",
      "choices": []
    }
  },
  "why": "'Ideal' is the first word of every circuit theory exam question — real batteries add the productive wrinkle of internal resistance."
};

const emSafetyMatch = {
  "prompt": "Every rule is physics, not bureaucracy — pair each device with its theorem:",
  "pairs": [
    {
      "left": "the RCD (trips at 30 mA in ~30 ms)",
      "right": "compares live and neutral currents — which Kirchhoff's law says must be equal — and breaks the instant they differ"
    },
    {
      "left": "the fuse / circuit breaker",
      "right": "encodes I²R heating: twice the rated current makes four times the heat, and the fuse melts first by design"
    },
    {
      "left": "the earth wire",
      "right": "a low-resistance alternative path that keeps a fault's chassis near earth potential — the fault trips the breaker instead of waiting for a hand"
    },
    {
      "left": "30 mA of AC across the chest",
      "right": "roughly the threshold for ventricular fibrillation — the number the whole design revolves around"
    }
  ],
  "why": "Each device is a conservation law pointed at danger — a theorem applied before breakfast."
};

const emMachineOrder = {
  "prompt": "From discovery to grid — put the chain in order:",
  "items": [
    "Faraday, 1831: a changing magnetic field induces a voltage — no change, no voltage, however strong the magnet",
    "The generator: a coil rotated in a field sees continuously changing flux — alternating voltage, spun by steam, water or wind",
    "The motor: the mirror image — a current-carrying wire in a field feels F = BIL, which turns the axle",
    "The transformer: AC in the primary makes a changing flux in the iron core; Vs/Vp = Ns/Np",
    "The grid: transmit at high voltage and low current — losses are I²R, so raising voltage 100-fold cuts losses 10,000-fold"
  ],
  "why": "The world's electricity is one loop, spun by steam, water or wind — and the grid's whole trick is the transformer's inversion: voltage up, current down."
};

const emDcPredict = {
  "q": "You feed steady DC to a transformer's primary (after the switch-on blip). What does the secondary deliver?",
  "choices": [
    "A steady DC voltage, scaled by the turns ratio",
    "Nothing — no changing flux, no induced voltage beyond the switch-on blip",
    "An inverted DC voltage of the same size",
    "The correct ratio, but at half the power"
  ],
  "answer": 1,
  "why": "A transformer needs a changing flux — and with no load on the secondary, almost no current flows in the primary: 'transformers are lazy until loaded' is Faraday's law, not a defect."
};
---
<TopicPage slug="subjects/physics/expert/electrodynamics-maxwell">
  <h2>Where you are, and what you will learn</h2>
  <p>
    This expert lesson closes the spiral that Electrostatics, Magnetism and Induction and
    Circuits and Ohms Law each opened from their own side, and it assumes the wave picture
    from Waves and Sound. Those intermediate lessons gave you the pieces — charges, currents,
    induced voltages, oscillations; here the pieces become one field theory, and the theory
    turns out to describe light itself.
  </p>
  <p>By the end you will be able to:</p>
  <ul>
    <li>state all four Maxwell equations in words and say which experimental fact each one encodes;</li>
    <li>do the electrical bookkeeping — charge, current, voltage, resistance, power — and spot the consistency checks;</li>
    <li>apply Kirchhoff's two conservation laws to series, parallel and real-battery circuits;</li>
    <li>derive the safety rules (RCDs, fuses, earth wires) from physics rather than regulation;</li>
    <li>explain how the displacement-current addition turns induction into self-sustaining electromagnetic waves at the speed of light.</li>
  </ul>

  <h2>The idea</h2>
  <p>
    Maxwell's four equations are the complete classical theory of electricity, magnetism and
    light — the first great unification in physics. But they are also the destination of a
    school syllabus (magnetism, electrical quantities, circuits, safety, electromagnetic
    effects) that can look like five unrelated topics. The expert view reorganises all five
    as chapters of one story: charges make fields, moving charges make magnetic fields,
    changing magnetic fields regenerate electric ones, and the regeneration closes into
    self-sustaining waves — light. The syllabus was never a list; it was the first half of a
    spiral, and Maxwell's 1865 paper is where the spiral closes.
  </p>

  <Widget no="1" caption="the four laws and what each one says — the chain ends with light itself" widget="equationStep" config={maxwellCfg} />
  <p>
    <strong>What to notice:</strong> the widget steps through the four laws in the order the
    physics actually stacks — charge makes field, no magnetic charge, changing B curls E,
    and Maxwell's addition lets changing E curl B back. Steps one to three are experiments
    you have already met; step four is Maxwell's contribution, and step five is the
    consequence nobody expected: the loop of self-regenerating fields propagates at exactly
    the measured speed of light.
  </p>

  <h2>Magnetism: fields before forces</h2>
  <p>
    Magnetism (4.1) starts phenomenologically: lodestones attract iron, compasses point
    north, like poles repel. The expert upgrade is the <em>field</em> picture — every magnet
    fills space with a magnetic field B, drawn as lines that always close on themselves (they
    exit a north pole, loop round, enter a south pole, and continue <em>through</em> the
    magnet; there are no free ends). Cutting a bar magnet in two never isolates a monopole —
    you get two weaker dipoles — and that everyday observation is half of one of Maxwell's
    equations (the magnetic Gauss law: the net flux through any closed surface is zero).
    Electromagnets make the phenomenon quantitative: a solenoid's field inside is
    B = μ₀nI, with n turns per metre — so a coil of 500 turns over 10 cm (n = 5,000 per
    metre) carrying 2 A gives B = 4π × 10⁻⁷ × 5,000 × 2 ≈ 0.0126 T, some 250 times Earth's
    ~50 μT. Ferromagnetism itself is quantum (aligned electron spins in domains — the
    solid-state lesson's territory), but the field description needs none of that: it is the
    first statement that influences live in the space between objects, not in the objects.
  </p>
  <Widget no="2" caption="guess the magnitude — field inside a solenoid" widget="estimate" config={emSolenoidEst} />
  <p>
    <em>Common misconception:</em> "Earth's geographic North Pole is a magnetic north pole."
    It is the opposite: a compass needle's north tip is attracted toward the Arctic, and
    unlike poles attract — so the pole up there must be a magnetic <em>south</em> pole
    (physicists often call it the "north magnetic pole" purely by location, which keeps the
    confusion alive). The same convention-fuss explains why field lines are drawn exiting
    the geographic north: outside the Earth they run south, closing the loop through the
    planet's core, where the dynamo that generates them lives.
  </p>
  <Widget no="3" caption="find the faulty line in this student's magnet notes" widget="spot-error" config={emPoleSpot} />
  <p>
    <strong>So far:</strong> the field picture — influences living in the space between
    objects, lines that never end — is the conceptual breakthrough everything else builds on.
    Next comes the quantitative dictionary that lets the fields be counted and billed.
  </p>

  <h2>Electrical quantities: the bookkeeping of charge</h2>
  <p>
    The electrical quantities (4.2) form a dictionary worth memorising once, properly.
    Charge Q in coulombs; current I = Q/t in amperes (a coulomb per second — about
    6.24 × 10¹⁸ electrons); potential difference V = W/Q in volts (joules per coulomb); and
    resistance R = V/I in ohms, the friction the conductor offers. Power is the product:
    P = VI. One worked example anchors them all: a 60 W lamp on a 230 V supply draws
    I = P/V = 60/230 ≈ 0.26 A and runs at R = V²/P = 52,900/60 ≈ 880 Ω. Notice the two
    routes to the resistance agree — that consistency is what makes the definitions real
    rather than nominal. The deeper point hiding in the dictionary: voltage is <em>energy per
    charge</em>, not a substance, which is why a bird on a 100,000 V line is fine (no
    potential difference across its feet) and why "high voltage" alone never hurt anyone —
    it is energy delivered through a resistance that matters, the arithmetic behind the
    safety topic below.
  </p>
  <p>
    The energy bookkeeping makes the dictionary practical. One kilowatt-hour is 1,000 W
    for an hour — 3.6 million joules — so a 2 kW heater run for 3 hours consumes 6 kWh;
    a 10 W LED left on all year (24 × 365 × 10 Wh = 87.6 kWh) costs a fraction of that
    and replaces a 60 W incandescent burning 526 kWh — a factor-of-six saving hiding
    in P = VI. At the household's supply voltage the current ratio is equally stark:
    the LED draws 0.04 A where the filament drew 0.26 A, which is why wiring, fuses
    and connectors are sized for the load's current, and why the LED revolution was,
    electrically, a current-reduction revolution.
  </p>
  <Widget no="4" caption="fill the blanks — the household energy ledger" widget="cloze" config={emKwhCloze} />
  <p>
    <em>Common misconception:</em> "current is used up as it goes round a circuit, so less
    comes back to the battery." Charge is conserved: the current leaving the battery equals
    the current returning it, in every series loop, always. What falls on the way round is
    the <em>energy</em> per charge (the voltage drops across each component); the flow rate
    itself is the same everywhere in a series circuit. Every mis-wired "parallel resistors
    share current equally" error starts here.
  </p>
  <Widget no="5" caption="file each quantity — same everywhere, or drops en route" widget="sort-buckets" config={emCurrentSort} />

  <h2>Circuits: Kirchhoff's two laws do everything</h2>
  <p>
    Circuit analysis (4.3) — series and parallel networks, component behaviour — reduces to
    two conservation statements. Kirchhoff's current law: charge in equals charge out at any
    junction (conservation of charge). His voltage law: the potential gains around any loop
    equal the drops (conservation of energy). From these, everything follows. Two 6 Ω
    resistors in series give 12 Ω (same current, voltages add); in parallel they give
    3 Ω (same voltage, currents add — and the pair always conducts better than either alone,
    which is why the parallel formula R = R₁R₂/(R₁R₂ rule of thumb) gives less than the
    smaller resistor). Real batteries complicate the picture productively: a 12 V battery
    with 0.05 Ω internal resistance driving a 1.95 Ω load pushes I = 12/2.0 = 6 A, but the
    terminal voltage sags to 12 − 6 × 0.05 = 11.7 V — the missing 0.3 V heats the battery
    itself. That single calculation is why car batteries are specified by cold-cranking
    current, why jump leads are thick copper, and why "ideal" is the first word of every
    circuit theory exam question.
  </p>
  <Widget no="6" caption="walk the real-battery sag" widget="branch" config={emBatteryBranch} />
  <p>
    <strong>So far:</strong> Kirchhoff's two laws reduce every circuit network to conservation
    of charge and conservation of energy — and real batteries add the productive wrinkle of
    internal resistance. The same two laws, pointed at danger, are exactly what makes the
    safety devices of the next section possible.
  </p>

  <h2>Electrical safety: the rules are physics, not bureaucracy</h2>
  <p>
    Electrical safety (4.4) is the syllabus topic that keeps people alive, and every rule in
    it is a Maxwell-equation consequence. Mains at 230 V rms across the human body —
    resistance of the order of 1,000 Ω when skin is wet, tens of thousands when dry — drives
    currents well into the dangerous range: roughly 30 mA of alternating current across the
    chest can trigger ventricular fibrillation. That number is why residual current devices
    (RCDs) trip at 30 mA and in around 30 ms: they compare the current in the live and
    neutral wires (which Kirchhoff's law says must be equal) and break the circuit the
    instant the difference — current leaking to earth, perhaps through a person — appears.
    Fuses and miniature circuit breakers encode I²R heating: a wire carrying twice its rated
    current generates four times the heat, and the fuse melts first by design. The earth
    wire is a low-resistance alternative path that keeps a fault's chassis at (approximately)
    earth potential, so the fault becomes a huge current that trips the breaker instead of a
    live casing that waits for a hand. Each device is a theorem applied before breakfast.
  </p>
  <Widget no="7" caption="pair each safety device with its physics" widget="match" config={emSafetyMatch} />

  <h2>Electromagnetic effects: induction and the machines it built</h2>
  <p>
    Electromagnetic effects (4.5) begin with Faraday's 1831 discovery: a <em>changing</em>
    magnetic field induces a voltage — no change, no voltage, however strong the magnet.
    Every machine in the syllabus is an application. The generator: a coil rotated in a field
    experiences a continuously changing flux, producing alternating voltage — the world's
    electricity is this loop, spun by steam, water or wind. The motor is the mirror image: a
    current-carrying wire in a field feels the force F = BIL, which turns the axle. The
    transformer is the elegant one: AC in the primary coil makes a changing flux in the iron
    core, which induces a secondary voltage in the ratio Vs/Vp = Ns/Np. Worked: stepping
    230 V down to 11.5 V needs Ns/Np = 1/20 — 1,000 primary turns, 50 secondary — and
    (ideally) power is conserved, so current steps <em>up</em> twenty-fold. That inversion is
    the grid's whole trick: transmit at high voltage and low current, because transmission
    losses are I²R — raising voltage 100-fold cuts current 100-fold and losses 10,000-fold.
    Laminated cores defeat eddy currents (circulating induction currents that would cook the
    iron), which is why transformer cores look like sliced bread.
  </p>
  <Widget no="8" caption="assemble the machines induction built" widget="order" config={emMachineOrder} />
  <p>
    <em>Common misconception:</em> "a transformer changes DC too, or works without a load."
    A transformer needs a <em>changing</em> flux — steady DC in the primary induces nothing
    in the secondary beyond a blip at switch-on. And with no load on the secondary, almost no
    current flows in the primary: the induced secondary voltage would oppose the primary's
    flux, and only when the secondary delivers current does the primary draw matching power.
    "Transformers are lazy until loaded" is Faraday's law, not a defect.
  </p>
  <Widget no="9" caption="bet before you read on — DC into the primary" widget="predict" config={emDcPredict} />

  <h2>Check yourself</h2>
  <p>Try these before moving on. Feedback follows each answer.</p>
  <ol>
    <li>State the two Gauss laws in words, and identify the experimental fact each one encodes.</li>
    <li>Transmission losses are I²R. Using the transformer relation Vs/Vp = Ns/Np, show why stepping the voltage up 100-fold cuts transmission losses 10,000-fold.</li>
    <li>Why did Maxwell's displacement-current addition matter so much more than a patch to a broken law? Connect it to the existence of light.</li>
  </ol>
  <p>
    <strong>Feedback:</strong> (1) Electric Gauss: field lines begin and end on charges, so
    the flux out of any closed box counts the charge inside. Magnetic Gauss: the net flux
    through any closed box is zero — magnetic field lines always close on themselves,
    because there are no isolated poles. (2) Power in the lines is I²R; a transformer raises
    voltage 100-fold, so the same power travels at 1/100 of the current — and current
    squared in the loss formula means losses fall by 100² = 10,000. The grid's whole trick
    is that one ratio. (3) Without it, the equations had no self-sustaining loop: E could be
    curled by currents but B could only be curled by currents too. With a changing E acting
    as a current, E regenerates B regenerates E — and the equations then admit wave solutions
    travelling at 1/√(μ₀ε₀), which equals the measured speed of light. The addition was made
    for consistency and paid for with light.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>Maxwell's four equations are the complete classical theory of electricity, magnetism and light — physics's first great unification.</li>
    <li>Fields live in the space between objects: field lines that begin on charge, or close on themselves, replaced action at a distance.</li>
    <li>Charge, current, voltage, resistance and power form a dictionary whose two routes must agree.</li>
    <li>Kirchhoff's laws are conservation of charge and energy applied to circuits; safety devices are those laws pointed at danger.</li>
    <li>Faraday's law built the machines — generators, motors, transformers — and the grid transmits high-voltage because losses are I²R.</li>
    <li>The displacement-current addition closed the loop: self-regenerating waves at 1/√(μ₀ε₀) = 3 × 10⁸ m/s — light.</li>
    <li>The theory's one known violation class (quantised light) is where quantum mechanics began.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    Among this subject's expert lessons, Quantum Field Theory takes the next step this
    lesson's final sections anticipated — the photon as the quantum of Maxwell's field — and General
    Relativity shows what another field theory of a different "medium" (spacetime itself)
    looks like. Solid State Physics is where the ferromagnetism you met in the first section
    gets its quantum explanation.
  </p>

  <h2>Going deeper</h2>
  <p>
    <strong>The synthesis, line by line.</strong> Maxwell's four equations in modern vector
    language: ∇·E = ρ/ε₀ (charge is the source of electric field); ∇·B = 0 (no magnetic
    charge); ∇×E = −∂B/∂t (changing B curls E — Faraday); ∇×B = μ₀J + μ₀ε₀ ∂E/∂t (currents
    and changing E curl B — Ampère plus Maxwell's displacement current). The addition was
    pure consistency: Ampère's law as known failed for a charging capacitor, where no
    current crosses the gap yet a magnetic field circles it. Maxwell's fix — a changing
    electric field acts like a current — closed the loop: E regenerates B regenerates E, and
    the equations then have wave solutions travelling at 1/√(μ₀ε₀) = 1/√(4π × 10⁻⁷ ×
    8.854 × 10⁻¹²) ≈ 2.998 × 10⁸ m/s. The measured speed of light was already known to that
    accuracy. As Maxwell wrote in 1865: light is an electromagnetic disturbance. Hertz
    confirmed radio waves in 1887; Marconi's transatlantic signal followed within a decade.
  </p>
  <p>
    <strong>Fields as the new ontology.</strong> The conceptual revolution outran the
    equations: after Maxwell, the primary physical objects are fields — continuous,
    energy-carrying, propagating at finite speed — and charges are their sources and
    sinks. "Action at a distance" died; every later fundamental theory is written in its
    language. General relativity is a field theory of geometry; the Standard Model is a
    field theory whose quanta are particles; even the gravitational waves LIGO detected are
    field ripples of spacetime itself. The symmetry structure of Maxwell's equations (gauge
    invariance, under the group U(1)) became the template for all modern forces — the
    photon is what the U(1) gauge symmetry demands. A physics undergraduate meets
    electrodynamics twice: once as the subject, once as the proof that unification pays.
  </p>
  <p>
    <strong>Where the classical theory cracks.</strong> Maxwell's equations are exact about
    fields and silent about how light interacts with matter in quanta: the black-body
    spectrum (classical theory predicts infinite energy — the ultraviolet catastrophe) and
    the photoelectric effect (light energy arrives in lumps of hf) both break it, and the
    fixes are quantum mechanics and then quantum electrodynamics, where the photon —
    Maxwell's waves, counted — becomes the field quantum. Yet classical electrodynamics is
    not a limiting case that stopped being useful: antenna design, waveguides, plasma
    physics, magnetic confinement fusion and the classical parts of every radio telescope
    run on these four lines. The expert's honest position: the equations are the most
    complete successful theory in classical physics, with exactly one known violation class
    — and that violation, quantised light, built the century that followed.
  </p>
  <p class="sources"><strong>Sources:</strong> Maxwell, "A Dynamical Theory of the Electromagnetic Field" (1865); Hertz (1887); Feynman Lectures Vol. II. Source text: OpenStax (https://openstax.org), CC BY 4.0 — adapted for Interactive Atlas.</p>
</TopicPage>
