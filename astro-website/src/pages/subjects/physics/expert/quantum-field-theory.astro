  "prompt": "Carbon-14 (half-life 5,730 years) dates organic remains. A sample retains 25% of the atmospheric proportion — place the marker at its age in half-lives:",
  "labels": [
    "0",
    "1",
    "2",
    "3",
    "4",
    "5"
  ],
  "scale": {
    "min": 0,
    "max": 5
  },
  "answer": 2,
  "tolerance": 0.3,
  "why": "Half remains after one half-life, a quarter after two — ≈ 11,460 years; 12.5% gives ≈ 17,190. λ ≈ 1.21 × 10⁻⁴ per year, so a single atom has about a one-in-8,000 chance of decaying in any given year."
};

const qftWasteSpot = {
  "prompt": "One line of this student's waste-handling note is wrong — click it:",
  "lines": [
