const qftDoseCloze = {
  "text": "Activity (in %%0%%) counts decays per second; absorbed dose (in %%1%%) counts energy deposited per kilogram; effective dose (in %%2%%) weights by biological damage — a gray of alpha inside the body is roughly twenty times more damaging than a gray of gamma.",
  "answers": [
    [
      "becquerels",
      "becquerel",
      "Bq"
