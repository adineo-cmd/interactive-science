    "A quarter is not zero — 'ten half-lives' (about 1/1,000 left) is the usual waste-handling benchmark for long-lived isotopes.",
    "After two half-lives the danger has dropped 75%, so the material is now safe.",
    "Exponential decay means 'smaller, fast at first, then slower forever' — never a clean endpoint.",
    "Some isotopes need centuries of handling before they are genuinely negligible."
  ],
  "errorLine": 2,
  "correction": "A quarter of the activity remains — 'safe after two half-lives' is exactly wrong, and the reverse panic is equally wrong: exponential decay never offers a clean endpoint.",
  "why": "Smaller, fast at first, then slower forever — the ensemble law is perfect while each individual decay stays quantum-random."
};

const qftDetectorMatch = {
  "prompt": "How the invisible becomes a number — pair each detector with its trade:",
  "pairs": [
    {
      "left": "the Geiger–Müller tube",
      "right": "an avalanche counted pulse by pulse — energy-blind but dead-reliable"
    },
