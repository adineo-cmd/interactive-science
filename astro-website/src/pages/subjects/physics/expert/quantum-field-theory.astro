const smCfg = {
  steps: [
    { math: '1 · Fields are the fundamental actors', note: 'Quantum field theory starts differently from particle physics: the universe is filled with quantum FIELDS — electron field, photon field, quark fields — one per particle type, everywhere.' },
    { math: '2 · Particles are field quanta', note: 'A particle is an excitation of its field, like a wave packet on a drum skin. Two electrons are two ripples of the one electron field — which is why all electrons are identical.' },
    { math: '3 · Forces are field talk', note: 'Interactions are exchanges of field quanta: photons carry electromagnetism, gluons the strong force, W/Z the weak. "Pushing" is really continuous photon-shoving.' },
    { math: '4 · Virtual particles do the accounting', note: 'Internal calculations use "virtual" quanta that borrow energy briefly (within the uncertainty budget). They are bookkeeping devices — but the forces they describe are real, measured, and match to 12 decimal places for the electron\'s magnetism.' },
    { math: '5 · The Standard Model', note: 'The inventory: 6 quarks, 6 leptons, 4 force-carriers, 1 Higgs. No proton decay seen, no fourth generation — the most tested theory ever written.' },
