const shotCfg = {
  steps: [
    { math: '1 · The size ladder', note: 'Extreme wide (geography, insignificance) → wide (environment) → medium (social distance — conversations) → close-up (emotion) → extreme close-up (a detail as protagonist). Each size is a claim about what matters right now.' },
    { math: '2 · Angle and height', note: 'High angle looks down (diminishes), low angle looks up (empowers), eye level is neutral honesty, Dutch tilt is unease. The camera\'s position is an opinion — the grammar lesson\'s establishing principle in shot form.' },
    { math: '3 · Lens grammar', note: 'Wide lenses (exaggerate depth, distort faces up close — comedy or unease), long lenses (compress space, isolate subjects — surveillance intimacy), the 50 mm "normal" (neither). The Kuleshov lesson\'s cutting plus the lens\'s spatial argument make meaning.' },
    { math: '4 · Movement speaks', note: 'Static = stability, observation; handheld = immediacy, documentary honesty; dolly-in = realisation; tracking = journey; crane = transcendence. Movement must have a reason — a drifting camera is a narrator who forgot the sentence.' },
  ],
};

const shotQuizCfg = {
  questions: [
    {
      q: 'A conversation is shot over two characters\' shoulders, cutting between them, eyelines matched. The convention being used is:',
      choices: [
        'The Kuleshov effect',
        'Shot/reverse-shot — fragments that the audience assembles into one coherent space, because screen direction and eyelines stay consistent',
        'A montage sequence',
        'Mise-en-scène',
      ],
      answer: 1,
      why: 'Neither shot contains the whole conversation; the viewer constructs it. Consistent eyelines and screen direction make the fragments read as one room — and withholding one side of the pattern (the unseen interviewer, the monster in the shadows) is exactly how cinema spends that coherence as suspense.',
    },
    {
      q: 'In Vertigo (1958) and Jaws (1975), a shot tracks back while zooming in (or the reverse). The effect — background swelling while the subject stays put — communicates:',
      choices: [
        'A lens malfunction',
        'Subjective shock or realisation — the spatial relationship between viewer and world collapses (the "dolly zoom", invented for Vertigo)',
        'Slow motion',
        'A change of film stock',
      ],
      answer: 1,
      why: 'Dolly and zoom move the camera in opposite perceptual directions: dollying changes perspective, zooming changes magnification. Counter-running them holds the subject\'s size while warping depth itself — the image literally contradicts itself, which the audience feels as vertigo. Craft as phenomenology, in one shot.',
    },
    {
      q: 'You must cut from a wide shot of a room to a medium of the same character without a jarring "jump". The standard protection is:',
      choices: [
        'Change the lens only',
        'Vary the shot by at least 30° in angle and clearly in size (the 30° rule) — near-identical framings read as a stutter, as if one frame were missing',
        'Add a wipe',
        'Shoot the medium first',
      ],
      answer: 1,
      why: 'Two shots of the same subject from nearly the same position look like a mechanical error rather than a cut (the jump cut — legal when deliberately clumsy, as in Breathless). Angle the second shot meaningfully and the edit reads as grammar instead of a glitch.',
    },
    {
      q: 'A film chooses a nearly square frame (The Lighthouse, 2019) over widescreen. The frame shape is:',
      choices: [
        'A budget constraint',
        'A tonal argument — the box confines the two wickies together, pressing them into shared madness, exactly as 70mm widescreen once released Lawrence into his landscape',
        'A tribute to television',
        'Random',
      ],
      answer: 1,
      why: 'Aspect ratio is mise-en-scène\'s outermost wall. Eggers\' 1.19:1 box squeezes two men into co-dependent claustrophobia; Lean\'s 70mm panorama made a desert a character. Same camera either way — the frame\'s proportions are where the film\'s argument about space begins.',
    },
  ],
};

