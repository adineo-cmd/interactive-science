---
import Layout from '../../../../layouts/Layout.astro';
import data from '../../../../data/topics.json';
import Glossary from '../../../../components/Glossary.astro';

const B = import.meta.env.BASE_URL.replace(/\/+$/, '') || '';
const { subjects, topics } = data;
const topic = topics.find((t) => t.slug === 'subjects/biology/foundational/cell-structure');
const subject = subjects.find((s) => s.id === topic.subject);
const seq = topics.filter((t) => t.status !== 'planned');
const idx = seq.indexOf(topic);
const prev = seq[(idx - 1 + seq.length) % seq.length];
const next = seq[(idx + 1) % seq.length];

// The organelle map: one box per part, clickable, with the job each one does.
const cellCfg = {
  height: 300,
  nodes: [
    { id: 'nucleus', label: 'nucleus', sub: 'blueprints', num: '01', x: 26, y: 34, w: 158, h: 58 },
    { id: 'ribosomes', label: 'ribosomes', sub: 'protein builders', num: '02', x: 26, y: 206, w: 158, h: 58 },
    { id: 'membrane', label: 'membrane', sub: 'the gate', num: '03', x: 282, y: 120, w: 172, h: 62, center: true },
    { id: 'mitochondria', label: 'mitochondria', sub: 'power plant', num: '04', x: 540, y: 34, w: 158, h: 58 },
    { id: 'chloroplast', label: 'chloroplast', sub: 'plants only', num: '05', x: 540, y: 206, w: 158, h: 58 },
  ],
  edges: [
    { from: 'membrane', to: 'nucleus' },
    { from: 'membrane', to: 'chloroplast' },
    { from: 'nucleus', to: 'ribosomes' },
    { from: 'mitochondria', to: 'ribosomes', dashed: true },
  ],
  details: {
    membrane: {
      title: 'Cell membrane',
      text: 'A thin double layer of fat that decides what gets in and out. Small uncharged things wander through; everything else needs a door or a pump.',
    },
    nucleus: {
      title: 'Nucleus',
      text: 'Holds the DNA — the full set of instructions. It protects the blueprints and ships copies out when a protein is needed.',
    },
    ribosomes: {
      title: 'Ribosomes',
      text: 'The builders. They read the copies and string amino acids together in the order written.',
    },
    mitochondria: {
      title: 'Mitochondria',
      text: 'Take fuel and oxygen and turn them into ATP, the currency every other part spends. The dashed line is that supply.',
    },
    chloroplast: {
      title: 'Chloroplast',
      text: 'Plant cells only. Captures light and builds sugar out of air and water — the fuel arrives already made.',
    },
  },
  detailHint: 'Click a part to read what it does.',
  key: 'Dashed line: energy supply, not a physical connection.',
};

const mitosisCfg = {
  unit: 'step',
  events: [
    { year: 1, title: 'Interphase', text: 'Not resting: the cell grows, powers itself, and quietly copies every chromosome.' },
    { year: 2, title: 'Prophase', text: 'DNA coils into visible chromosomes. The nuclear envelope dissolves; spindle fibres assemble.' },
    { year: 3, title: 'Metaphase', text: 'Chromosomes line up along the cell\u2019s equator, each gripped by the spindle.' },
    { year: 4, title: 'Anaphase', text: 'The spindle pulls: sister chromatids separate and march to opposite poles.' },
    { year: 5, title: 'Telophase', text: 'A new nuclear envelope closes around each complete set at both ends.' },
    { year: 6, title: 'Cytokinesis', text: 'The membrane pinches through the middle. Two cells, each with the full instruction set.' },
  ],
};

const synthesisCfg = {
  steps: [
    { math: 'DNA unzips at the gene', note: 'Hydrogen bonds between base pairs break; the helix opens like a zip.' },
    { math: 'A → mRNA copy (transcription)', note: 'Complementary RNA bases are strung together — the message leaves the nucleus.' },
    { math: 'mRNA meets a ribosome', note: 'The ribosome clamps on and reads the message three bases at a time.' },
    { math: 'codon → amino acid (translation)', note: 'tRNAs bring matching amino acids; the chain grows in the order the DNA spelled out.' },
    { math: 'chain folds → working protein', note: 'Shape is function: the folded protein is an enzyme, a motor, or a brick.' },
  ],
};
---
<Layout title={`${topic.title} — ${subject.name} — Interactive Atlas`} description={topic.summary}>
  <div class="wrap">
    <div class="topic-grid">
      <aside class="topic-aside">
        <a class="back" href={`${B}/subjects/${subject.id}/`}>← all of {subject.name}</a>
        <dl>
          <dt>subject</dt><dd><span class="dot" style={`--dot:${subject.ink}; display:inline-block; margin-right:.4rem`}></span>{subject.name}</dd>
          <dt>level</dt><dd>{topic.level}</dd>
          <dt>time</dt><dd>{topic.minutes} min</dd>
          <dt>tags</dt><dd>{topic.tags.slice(0, 3).join(', ')}</dd>
        </dl>
      </aside>
      <article>
        <header class="topic-head">
          <p class="crumb"><a href={B + '/'}>atlas</a><span class="sep">/</span><a href={`${B}/subjects/${subject.id}/`}>{subject.name}</a><span class="sep">/</span>{topic.level}</p>
          <h1>{topic.title}</h1>
          <p class="lede">{topic.summary}</p>
        </header>

        <div class="topic-body">
          <h2>The idea</h2>
          <p>
            A cell is a factory in a bag of water. The <strong>membrane</strong> decides what
            enters and leaves; the <strong>nucleus</strong> keeps the blueprints (DNA);
            <strong>mitochondria</strong> burn fuel into
            <Glossary term="ATP" def="Adenosine triphosphate: a small molecule that carries usable energy between reactions. Cells spend it the way a factory spends money." />; <strong>ribosomes</strong> read those
            blueprints and build proteins. Plant cells bolt on three extras — a rigid
            <strong>cell wall</strong>, green <strong>chloroplasts</strong>, and a water-filled
            <strong>vacuole</strong> for pressure.
          </p>
          <figure class="widget">
            <figcaption><span class="fig-no">fig. 1</span><span>the parts and their jobs — click any box</span></figcaption>
            <div class="widget-body">
              <div data-widget="diagram" data-config={JSON.stringify(cellCfg)}></div>
            </div>
          </figure>

          <p>
            The most dramatic thing a cell does is copy itself. Scrub through mitosis below —
            drag the marker and the phases that haven't happened yet fade out:
          </p>

          <figure class="widget">
            <figcaption><span class="fig-no">fig. 2</span><span>mitosis, one scrubable loop — from copy-out to pinch-off</span></figcaption>
            <div class="widget-body">
              <div data-widget="timeline" data-config={JSON.stringify(mitosisCfg)}></div>
            </div>
          </figure>

          <h2>How blueprints become machines</h2>
          <p>Every protein in that factory is built the same way, in five steps:</p>

          <figure class="widget">
            <figcaption><span class="fig-no">fig. 3</span><span>from DNA to working protein</span></figcaption>
            <div class="widget-body">
              <div data-widget="equationStep" data-config={JSON.stringify(synthesisCfg)}></div>
            </div>
          </figure>
        </div>

        <nav class="topic-next" aria-label="Lesson navigation">
          <div><span class="tn-label">previous lesson</span><a href={`${B}/${prev.slug}/`}>{prev.title}</a></div>
          <div style="text-align:right"><span class="tn-label">next lesson</span><a href={`${B}/${next.slug}/`}>{next.title}</a></div>
        </nav>
      </article>
    </div>
  </div>
</Layout>
