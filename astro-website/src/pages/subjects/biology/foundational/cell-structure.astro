---
import Layout from '../../../../layouts/Layout.astro';
import WidgetLoader from '../../../../components/WidgetLoader.astro';
---
<Layout>
  <article class="topic-page">
    <span class="level-badge">Foundational</span>
    <h1>Cell Structure</h1>
    <p>The cell is the unit of life. Click organelles to isolate them.</p>

    <section>
      <h2>Concept</h2>
      <p>Animal cells share core parts: membrane, cytoplasm, nucleus (DNA store), mitochondria (energy), ribosomes (protein builders). Plant cells add a wall, chloroplasts, and a large vacuole.</p>
    </section>

    <section>
      <h2>Interactive diagram — animal cell</h2>
      <div class="widget" id="cell-widget">
        <svg width="340" height="240" viewBox="0 0 340 240" role="img" aria-label="Animal cell">
          <ellipse id="membrane" cx="170" cy="120" rx="150" ry="100" fill="none" stroke="#333" stroke-width="2" style="cursor:pointer" />
          <circle id="nucleus" cx="170" cy="120" r="34" fill="#d4603e" opacity="1" style="cursor:pointer" />
          <text x="170" y="124" font-size="11" text-anchor="middle" fill="#fff">DNA</text>
          <ellipse id="mito1" cx="90" cy="80" rx="26" ry="13" fill="none" stroke="#333" stroke-width="1.5" style="cursor:pointer" />
          <ellipse id="mito2" cx="255" cy="160" rx="26" ry="13" fill="none" stroke="#333" stroke-width="1.5" style="cursor:pointer" />
          <rect id="ribo" x="230" y="60" width="40" height="16" fill="none" stroke="#333" stroke-width="1.5" style="cursor:pointer" />
          <text x="250" y="52" font-size="10" text-anchor="middle">ribosomes</text>
          <text x="90" y="62" font-size="10" text-anchor="middle">mitochondria</text>
        </svg>
        <p>Click any part to dim / restore it.</p>
        <WidgetLoader widgets={['diagramBuilder']} />
        <script type="module">
          document.querySelectorAll('#cell-widget svg [id]').forEach((n) => {
            n.addEventListener('click', () => {
              n.style.opacity = n.style.opacity === '0.25' ? '1' : '0.25';
            });
          });
        </script>
      </div>
    </section>

    <section>
      <h2>Step-by-step — how a protein gets made</h2>
      <div class="widget" id="protein-widget">
        <WidgetLoader widgets={['equationStep']} />
      </div>
    </section>
  </article>
</Layout>
