---
import Layout from '../../../../layouts/Layout.astro';
import data from '../../../../data/topics.json';
import Glossary from '../../../../components/Glossary.astro';
import kidData from '../../../../data/kid-summaries.json';

const B = import.meta.env.BASE_URL.replace(/\/+$/, '') || '';
const { subjects, topics } = data;
const topic = topics.find((t) => t.slug === 'subjects/biology/foundational/cell-structure');
const kidSummary = kidData[topic.slug] ?? null;
const subject = subjects.find((s) => s.id === topic.subject);
const seq = topics.filter((t) => t.status !== 'planned');
const idx = seq.indexOf(topic);
const prev = seq[(idx - 1 + seq.length) % seq.length];
const next = seq[(idx + 1) % seq.length];

// The organelle map: one box per part, clickable, with the job each one does.
const cellCfg = {
  height: 300,
  nodes: [
    { id: 'nucleus', label: 'nucleus', sub: 'blueprints', num: '01', x: 26, y: 34, w: 158, h: 58 },
    { id: 'ribosomes', label: 'ribosomes', sub: 'protein builders', num: '02', x: 26, y: 206, w: 158, h: 58 },
    { id: 'membrane', label: 'membrane', sub: 'the gate', num: '03', x: 282, y: 120, w: 172, h: 62, center: true },
    { id: 'mitochondria', label: 'mitochondria', sub: 'power plant', num: '04', x: 540, y: 34, w: 158, h: 58 },
    { id: 'chloroplast', label: 'chloroplast', sub: 'plants only', num: '05', x: 540, y: 206, w: 158, h: 58 },
  ],
  edges: [
    { from: 'membrane', to: 'nucleus' },
    { from: 'membrane', to: 'chloroplast' },
    { from: 'nucleus', to: 'ribosomes' },
    { from: 'mitochondria', to: 'ribosomes', dashed: true },
  ],
  details: {
    membrane: {
      title: 'Cell membrane',
      text: 'A thin double layer of fat that decides what gets in and out. Small uncharged things wander through; everything else needs a door or a pump.',
    },
    nucleus: {
      title: 'Nucleus',
      text: 'Holds the DNA — the full set of instructions. It protects the blueprints and ships copies out when a protein is needed.',
    },
    ribosomes: {
      title: 'Ribosomes',
      text: 'The builders. They read the copies and string amino acids together in the order written.',
    },
    mitochondria: {
      title: 'Mitochondria',
      text: 'Take fuel and oxygen and turn them into ATP, the currency every other part spends. The dashed line is that supply.',
    },
    chloroplast: {
      title: 'Chloroplast',
      text: 'Plant cells only. Captures light and builds sugar out of air and water — the fuel arrives already made.',
    },
  },
  detailHint: 'Click a part to read what it does.',
  key: 'Dashed line: energy supply, not a physical connection.',
};

const mitosisCfg = {
  unit: 'step',
  events: [
    { year: 1, title: 'Interphase', text: 'Not resting: the cell grows, powers itself, and quietly copies every chromosome.' },
    { year: 2, title: 'Prophase', text: 'DNA coils into visible chromosomes. The nuclear envelope dissolves; spindle fibres assemble.' },
    { year: 3, title: 'Metaphase', text: 'Chromosomes line up along the cell\u2019s equator, each gripped by the spindle.' },
    { year: 4, title: 'Anaphase', text: 'The spindle pulls: sister chromatids separate and march to opposite poles.' },
    { year: 5, title: 'Telophase', text: 'A new nuclear envelope closes around each complete set at both ends.' },
    { year: 6, title: 'Cytokinesis', text: 'The membrane pinches through the middle. Two cells, each with the full instruction set.' },
  ],
};

const synthesisCfg = {
  steps: [
    { math: 'DNA unzips at the gene', note: 'Hydrogen bonds between base pairs break; the helix opens like a zip.' },
    { math: 'A → mRNA copy (transcription)', note: 'Complementary RNA bases are strung together — the message leaves the nucleus.' },
    { math: 'mRNA meets a ribosome', note: 'The ribosome clamps on and reads the message three bases at a time.' },
    { math: 'codon → amino acid (translation)', note: 'tRNAs bring matching amino acids; the chain grows in the order the DNA spelled out.' },
    { math: 'chain folds → working protein', note: 'Shape is function: the folded protein is an enzyme, a motor, or a brick.' },
  ],
};
---
<Layout title={`${topic.title} — ${subject.name} — Interactive Atlas`} description={topic.summary}>
  <div class="wrap">
    <div class="topic-grid">
      <aside class="topic-aside">
        <a class="back" href={`${B}/subjects/${subject.id}/`}>← all of {subject.name}</a>
        <dl>
          <dt>subject</dt><dd><span class="dot" style={`--dot:${subject.ink}; display:inline-block; margin-right:.4rem`}></span>{subject.name}</dd>
          <dt>level</dt><dd>{topic.level}</dd>
          <dt>time</dt><dd>{topic.minutes} min</dd>
          <dt>tags</dt><dd>{topic.tags.slice(0, 3).join(', ')}</dd>
        </dl>
      </aside>
      <article>
        <header class="topic-head">
          <p class="crumb"><a href={B + '/'}>atlas</a><span class="sep">/</span><a href={`${B}/subjects/${subject.id}/`}>{subject.name}</a><span class="sep">/</span>{topic.level}</p>
          <h1>{topic.title}</h1>
          <p class="lede">{topic.summary}</p>
        </header>

        {kidSummary && (
          <aside class="kid-note" aria-label="Summary for young readers">
            <p><strong>For young explorers:</strong> {kidSummary}</p>
          </aside>
        )}
        <div class="topic-body">
          <h2>The idea</h2>
          <p>
            Biology's first great secret is that life is not a smooth substance — it is
            <em>compartmentalised</em>. Every living thing you have ever seen is built from
            microscopic rooms called <strong>cells</strong>, and every cell is a factory in a bag
            of water: it takes in raw materials, follows written instructions, generates its own
            power and, given time, builds a complete copy of itself. You are a consortium of
            roughly 30 trillion of them, cooperating so seamlessly that it looks like a single
            organism.
          </p>
          <p>
            The idea has a history. In 1665 Robert Hooke sliced cork under a crude microscope and
            saw a honeycomb of tiny empty boxes, which he named <em>cells</em> after the monks'
            sleeping rooms. In the 1670s Antonie van Leeuwenhoek pushed further and found living
            "animalcules" swarming in pond water. Two centuries later, in the 1830s and 40s,
            Schleiden, Schwann and Virchow turned observations into the <strong>cell theory</strong>:
            all living things are made of cells, the cell is the basic unit of life, and every
            cell comes from another cell. No exception has ever been found.
          </p>
          <p>
            A cell's essentials: the <strong>membrane</strong> decides what enters and leaves; the
            <strong>nucleus</strong> keeps the blueprints (DNA); <strong>mitochondria</strong>
            burn fuel into <Glossary term="ATP" def="Adenosine triphosphate: a small molecule that carries usable energy between reactions. Cells spend it the way a factory spends money." />; <strong>ribosomes</strong> read those
            blueprints and build proteins. Plant cells bolt on three extras — a rigid
            <strong>cell wall</strong>, green <strong>chloroplasts</strong>, and a water-filled
            <strong>vacuole</strong> for pressure. Click through the map below; every box is a
            department with a job.
          </p>
          <figure class="widget">
            <figcaption><span class="fig-no">fig. 1</span><span>the parts and their jobs — click any box</span></figcaption>
            <div class="widget-body">
              <div data-widget="diagram" data-config={JSON.stringify(cellCfg)}></div>
            </div>
          </figure>

          <h2>A tour of the departments</h2>
          <p>
            Both animal and plant cells share four essentials. The <strong>cell membrane</strong>
            is a double layer of fat molecules studded with protein doors and pumps: it is
            <em>partially permeable</em>, letting small molecules through by choice or by chance
            while excluding the rest — without it the cell would leak its contents into the world.
            The <strong>nucleus</strong> houses the DNA wound into chromosomes, and it runs the
            cell the way a head office runs a factory: nothing is built without an order from
            here. The <strong>cytoplasm</strong> is the watery jelly where most reactions happen,
            and the <strong>mitochondria</strong> are the power plant — sausage-shaped compartments
            where oxygen and glucose are burned down to carbon dioxide and water, charging ATP
            like a battery being recharged. A muscle cell is packed with them (it never stops
            spending), which is a first lesson in biology's ruling principle: <em>structure fits
            function</em>.
          </p>
          <p>
            <strong>Ribosomes</strong> are the smallest departments — specks, often thousands per
            cell — where amino acids are chained together in the order the DNA specifies, making
            the proteins: enzymes that speed reactions, collagen that holds skin together,
            haemoglobin that ferries oxygen. Plants add three rooms. The <strong>cell wall</strong>
            (cellulose, not living tissue but a scaffold) lets a plant stand upright without bones.
            <strong>Chloroplasts</strong> are green solar panels, dense with the pigment
            chlorophyll, that capture light and build sugar from air and water — the reason plants
            need no lunch. And the permanent <strong>vacuole</strong> is a water reservoir; when
            full it presses the cytoplasm against the wall, making the cell firm — the difference
            between crisp lettuce and wilted lettuce is literally vacuole pressure.
          </p>
          <p>
            Specialisation then multiplies the theme. A red blood cell throws away its nucleus to
            carry more haemoglobin and is dented into a shape with more surface for loading
            oxygen; a root hair cell grows a gigantic fuzz of membrane to soak up water; a sperm
            cell is a motor with a tail and a payload; a palisade cell in a leaf is a transparent
            box stuffed with chloroplasts, facing the sun like a window. Same blueprints, wildly
            different bodies — all decided by which genes are switched on.
          </p>
          <p><em>Common misconception:</em> plant cells do not lack a membrane just because they
          have a wall — the membrane is inside the wall and does all the selective filtering; the
          wall is a passive corset. Equally, animal cells are not "without vacuoles": they have
          small, temporary ones for digesting and storing, just not one giant permanent reservoir.</p>

          <h2>How small is small? Measuring specimens</h2>
          <p>
            Cell biology lives on a ladder of units, and keeping it straight is half the skill.
            From the metre: divide by 1,000 for a <strong>millimetre</strong> (mm, the width of a
            fingernail), by 1,000,000 for a <strong>micrometre</strong> (μm, a millionth of a
            metre), and by 1,000,000,000 for a <strong>nanometre</strong> (nm). Typical sizes: a
            human hair is about 70 μm across; an average animal cell 10–30 μm; a plant cell 30–100
            μm; a bacterium 1–5 μm; a virus around 100 nm — which is why microscopes that see
            bacteria cannot see viruses.
          </p>
          <p>
            A light microscope's useful magnification is capped not by zooming but by
            <strong>resolution</strong> — the smallest separation at which two objects still look
            like two. Visible light has a wavelength around 400–700 nm, so the best light
            microscope resolves about 200 nm: enough for cells, mitochondria and bacteria, but a
            blur at finer detail. Magnification itself is easy to compute:
            <code>magnification = image size ÷ actual size</code>, both in the same units. Worked
            example: a cell drawn 25 mm long in your diagram is actually 5 μm. Convert: 25 mm =
            25,000 μm, so the magnification is 25,000 ÷ 5 = ×5,000. In practice you measure the
            specimen with an <strong>eyepiece graticule</strong> — a tiny ruler etched into the
            lens — calibrated against a stage micrometer, since the graticule's divisions mean
            different lengths at different zoom levels.
          </p>

          <h2>Copying the whole factory: mitosis</h2>
          <p>
            Growth, healing and replacing worn-out skin all demand new cells with exactly the old
            cells' instructions — no mutations, no halves. <strong>Mitosis</strong> is the
            procedure. Before it begins (during interphase) the cell quietly copies every one of
            its chromosomes; then the copies are lined up, pulled apart with spindle fibres, and
            sealed into two new cells. Each daughter cell inherits a full, identical set. The
            elegance is in the choreography — get it wrong and cells die or, occasionally, start
            growing without brakes (cancer is precisely uncontrolled mitosis).
          </p>
          <figure class="widget">
            <figcaption><span class="fig-no">fig. 2</span><span>mitosis, one scrubable loop — from copy-out to pinch-off</span></figcaption>
            <div class="widget-body">
              <div data-widget="timeline" data-config={JSON.stringify(mitosisCfg)}></div>
            </div>
          </figure>
          <p>
            Notice what mitosis does <em>not</em> do: it never halves the chromosome set. For
            making gametes — sperm and eggs, which must fuse to restore the full count — cells
            use a different, messier process called meiosis, and that story belongs with
            inheritance (the DNA and heredity lesson later in this course).
          </p>

          <h2>How blueprints become machines</h2>
          <p>
            The connection between the nucleus and the ribosome is the cell's central supply
            chain, and it runs the same way in every living thing on Earth. The DNA never leaves
            the vault; instead, a working copy is made:
          </p>
          <figure class="widget">
            <figcaption><span class="fig-no">fig. 3</span><span>from DNA to working protein</span></figcaption>
            <div class="widget-body">
              <div data-widget="equationStep" data-config={JSON.stringify(synthesisCfg)}></div>
            </div>
          </figure>
          <p>
            The dispatch copy is <strong>messenger RNA</strong> — a disposable printout of one
            gene that can travel out through nuclear pores. Ribosomes read it three bases at a
            time, each triplet calling up one specific amino acid, and assemble the chain in
            minutes. Then chemistry takes over: the chain folds itself into a precise 3D shape,
            and <em>shape is function</em>. Fold one way and you have an enzyme pocket that
            grips a sugar; fold another and you have haemoglobin's cage for an oxygen atom; fold
            wrong and you get the useless tangles behind diseases like Alzheimer's. A human cell
            runs this supply chain for roughly 20,000 different genes simultaneously.
          </p>

          <h2>A worked measurement, end to end</h2>
  <p>
    Here is the measurement skill assembled the way practical work actually presents it. You
    view a plant cell at ×400. On your eyepiece graticule its length spans 12 divisions, and
    the graticule has been calibrated with a stage micrometer at this magnification: one
    division = 2.5 μm. The cell's real length is therefore 12 × 2.5 = 30 μm — the calibration
    has already divided out the ×400, which is exactly why calibration matters. Now you draw
    the cell 60 mm long in your notebook. The <em>drawing's</em> magnification is 60,000 ÷ 30
    = ×2,000 — three magnifications were in play (microscope, graticule calibration, drawing)
    and each answers a different question. Muddling them is precisely what examiners fish
    for; the habit that saves you is writing down <em>what each number is</em> before touching
    the calculator.
  </p>
  <p><em>Common misconception:</em> plant cells need mitochondria even though they have
  chloroplasts. Photosynthesis makes sugar; <em>respiration</em> — in mitochondria, in every
  plant cell day and night — converts it to usable ATP. A plant cell is both a kitchen and
  a diner; remove the mitochondria and the solar panels are useless.</p>

  <h2>From cells to systems: the levels of organisation</h2>
  <p>
    Cells are the first rung of a ladder the rest of biology climbs. Similar cells working
    together form a <strong>tissue</strong> (muscle tissue, xylem, epithelium); different
    tissues combine into an <strong>organ</strong> (a leaf is palisade, spongy mesophyll,
    epidermis and vascular tissue assembled for photosynthesis; a stomach is muscle, gland
    and lining tissue assembled for digestion); organs cooperate in <strong>systems</strong>
    (circulatory, digestive); and the systems together are the <strong>organism</strong>.
    Each level does something no level below can: a single heart-muscle cell cannot pump,
    and a single leaf cannot feed a tree. When the dna-heredity lesson talks about genes
    "building the organism", this ladder is the construction plan — one genome, expressing
    itself differently at every rung.
  </p>

  <h2>Going deeper</h2>
          <p>
            Why are cells so small? Not tradition — geometry. A cell lives by exchange through
            its surface, but its needs grow with its volume. Double a cell's side length and its
            surface area grows ×4 while its volume grows ×8, so its surface-area-to-volume ratio
            <em>halves</em>: a big cell starves in its middle because diffusion from the membrane
            cannot keep up. Every workaround in biology — folded membranes, flat red cells, root
            hairs, lungs' alveoli — is an attack on this ratio.
          </p>
          <p>
            There are also two great cell empires. Ours are <strong>eukaryotic</strong>: DNA
            housed in a nucleus, organs of membrane-bound compartments. <strong>Prokaryotes</strong>
            — bacteria — are smaller, have no nucleus (their circular DNA floats in the
            cytoplasm, often with extra gene rings called plasmids), and their ribosomes and cell
            walls are chemically different enough that many antibiotics exploit the gap. The
            deepest surprise of the last half-century is that the eukaryotic cell is a merger:
            mitochondria and chloroplasts were once free-living bacteria that another cell
            swallowed and kept — they still carry their own circular DNA, double membranes and
            bacteria-sized ribosomes. Lynn Margulis argued this <em>endosymbiosis</em> case for
            years against heavy scepticism; it is now textbook orthodoxy. Even the tools that
            revealed all this have a timeline: light microscopes (from the 1600s) could see cells;
            electron microscopes (from 1931) could see <em>inside</em> them, down to the
            nanometre scale of ribosomes and membrane layers. Every organelle in fig. 1 was
            invisible for most of human history — and the units ladder above is the price of
            admission to that world.
          </p>

          <p class="sources"><strong>Sources:</strong> Hooke, <em>Micrographia</em> (1665); Cambridge IGCSE Biology 0615 syllabus, sections 2.1–2.2; Alberts et al., <em>Molecular Biology of the Cell</em>; Margulis, "On the Origin of Mitosing Cells" (1967).</p>
        </div>

        <nav class="topic-next" aria-label="Lesson navigation">
          <div><span class="tn-label">previous lesson</span><a href={`${B}/${prev.slug}/`}>{prev.title}</a></div>
          <div style="text-align:right"><span class="tn-label">next lesson</span><a href={`${B}/${next.slug}/`}>{next.title}</a></div>
        </nav>
      </article>
    </div>
  </div>
</Layout>
