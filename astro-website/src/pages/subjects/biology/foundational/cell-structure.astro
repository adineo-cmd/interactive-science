---
import Layout from '../../../../layouts/Layout.astro';
import data from '../../../../data/topics.json';
import Glossary from '../../../../components/Glossary.astro';
import kidData from '../../../../data/kid-summaries.json';

const B = import.meta.env.BASE_URL.replace(/\/+$/, '') || '';
const { subjects, topics } = data;
const topic = topics.find((t) => t.slug === 'subjects/biology/foundational/cell-structure');
const kidSummary = kidData[topic.slug] ?? null;
const subject = subjects.find((s) => s.id === topic.subject);
const seq = topics.filter((t) => t.status !== 'planned');
const idx = seq.indexOf(topic);
const prev = seq[(idx - 1 + seq.length) % seq.length];
const next = seq[(idx + 1) % seq.length];

// The organelle map: one box per part, clickable, with the job each one does.
const cellCfg = {
  height: 300,
  nodes: [
    { id: 'nucleus', label: 'nucleus', sub: 'blueprints', num: '01', x: 26, y: 34, w: 158, h: 58 },
    { id: 'ribosomes', label: 'ribosomes', sub: 'protein builders', num: '02', x: 26, y: 206, w: 158, h: 58 },
    { id: 'membrane', label: 'membrane', sub: 'the gate', num: '03', x: 282, y: 120, w: 172, h: 62, center: true },
    { id: 'mitochondria', label: 'mitochondria', sub: 'power plant', num: '04', x: 540, y: 34, w: 158, h: 58 },
    { id: 'chloroplast', label: 'chloroplast', sub: 'plants only', num: '05', x: 540, y: 206, w: 158, h: 58 },
  ],
  edges: [
    { from: 'membrane', to: 'nucleus' },
    { from: 'membrane', to: 'chloroplast' },
    { from: 'nucleus', to: 'ribosomes' },
    { from: 'mitochondria', to: 'ribosomes', dashed: true },
  ],
  details: {
    membrane: {
      title: 'Cell membrane',
      text: 'A thin double layer of fat that decides what gets in and out. Small uncharged things wander through; everything else needs a door or a pump.',
    },
    nucleus: {
      title: 'Nucleus',
      text: 'Holds the DNA — the full set of instructions. It protects the blueprints and ships copies out when a protein is needed.',
    },
    ribosomes: {
      title: 'Ribosomes',
      text: 'The builders. They read the copies and string amino acids together in the order written.',
    },
    mitochondria: {
      title: 'Mitochondria',
      text: 'Take fuel and oxygen and turn them into ATP, the currency every other part spends. The dashed line is that supply.',
    },
    chloroplast: {
      title: 'Chloroplast',
      text: 'Plant cells only. Captures light and builds sugar out of air and water — the fuel arrives already made.',
    },
  },
  detailHint: 'Click a part to read what it does.',
  key: 'Dashed line: energy supply, not a physical connection.',
};

const mitosisCfg = {
  unit: 'step',
  events: [
    { year: 1, title: 'Interphase', text: 'Not resting: the cell grows, powers itself, and quietly copies every chromosome.' },
    { year: 2, title: 'Prophase', text: 'DNA coils into visible chromosomes. The nuclear envelope dissolves; spindle fibres assemble.' },
    { year: 3, title: 'Metaphase', text: 'Chromosomes line up along the cell\u2019s equator, each gripped by the spindle.' },
    { year: 4, title: 'Anaphase', text: 'The spindle pulls: sister chromatids separate and march to opposite poles.' },
    { year: 5, title: 'Telophase', text: 'A new nuclear envelope closes around each complete set at both ends.' },
    { year: 6, title: 'Cytokinesis', text: 'The membrane pinches through the middle. Two cells, each with the full instruction set.' },
  ],
};

const synthesisCfg = {
  steps: [
    { math: 'DNA unzips at the gene', note: 'Hydrogen bonds between base pairs break; the helix opens like a zip.' },
    { math: 'A → mRNA copy (transcription)', note: 'Complementary RNA bases are strung together — the message leaves the nucleus.' },
    { math: 'mRNA meets a ribosome', note: 'The ribosome clamps on and reads the message three bases at a time.' },
    { math: 'codon → amino acid (translation)', note: 'tRNAs bring matching amino acids; the chain grows in the order the DNA spelled out.' },
    { math: 'chain folds → working protein', note: 'Shape is function: the folded protein is an enzyme, a motor, or a brick.' },
  ],
};
---
<Layout title={`${topic.title} — ${subject.name} — Interactive Atlas`} description={topic.summary}>
  <div class="wrap">
    <div class="topic-grid">
      <aside class="topic-aside">
        <a class="back" href={`${B}/subjects/${subject.id}/`}>← all of {subject.name}</a>
        <dl>
          <dt>subject</dt><dd><span class="dot" style={`--dot:${subject.ink}; display:inline-block; margin-right:.4rem`}></span>{subject.name}</dd>
          <dt>level</dt><dd>{topic.level}</dd>
          <dt>time</dt><dd>{topic.minutes} min</dd>
          <dt>tags</dt><dd>{topic.tags.slice(0, 3).join(', ')}</dd>
        </dl>
      </aside>
      <article>
        <header class="topic-head">
          <p class="crumb"><a href={B + '/'}>atlas</a><span class="sep">/</span><a href={`${B}/subjects/${subject.id}/`}>{subject.name}</a><span class="sep">/</span>{topic.level}</p>
          <h1>{topic.title}</h1>
          <p class="lede">{topic.summary}</p>
        </header>

        {kidSummary && (
          <aside class="kid-note" aria-label="Summary for young readers">
            <p><strong>For young explorers:</strong> {kidSummary}</p>
          </aside>
        )}
        <div class="topic-body">

          <h2>Where you are, and what you will learn</h2>
          <p>
            This is the very first lesson in Biology. You do not need to know anything yet —
            no chemistry, no jargon, nothing. We start from zero and build up slowly, one idea
            at a time.
          </p>
          <p>By the end of this lesson you will be able to:</p>
          <ul>
            <li>say what a cell is, in one sentence;</li>
            <li>name the main parts of a cell and explain what each one does, in everyday words;</li>
            <li>use the size words biologists use — millimetre, micrometre, nanometre — without getting lost;</li>
            <li>describe how a cell copies itself, and how instructions in DNA become working machines;</li>
            <li>measure a specimen under a microscope and calculate magnification.</li>
          </ul>
          <p>
            Take your time. Every new word is explained the moment it appears. If a paragraph
            feels heavy, slow down — each paragraph here carries exactly one idea.
          </p>

          <h2>Start with your own hand</h2>
          <p>
            Hold out your hand and look at the skin. Think of how skin flakes off after a
            sunburn — dry, tiny sheets of it. Every one of those invisible flakes is made of
            millions of <strong>cells</strong>. A cell is the smallest piece of a living thing
            that is still alive.
          </p>
          <p>
            Here is the strange truth: you are not one thing. You are roughly 30 trillion tiny
            living units working so closely together that they feel like a single "you". Your
            blood, your muscles, your brain — all of it is built from these microscopic
            building blocks.
          </p>
          <p>
            People did not always know this. In 1665, Robert Hooke sliced a piece of cork (the
            bark of a tree) and looked through one of the first microscopes. He saw a honeycomb
            of tiny empty boxes. They reminded him of the small rooms monks sleep in, called
            "cells", so he borrowed the word. In the 1670s, Antonie van Leeuwenhoek looked at
            pond water and saw the boxes alive and swimming. Almost 200 years later, scientists
            agreed on three simple rules — now called <strong>cell theory</strong>: everything
            alive is made of cells; the cell is the basic unit of life; and every cell comes
            from another cell. In all the years since, no exception has ever been found.
          </p>
          <p>
            <strong>So far:</strong> living things are built from tiny living compartments
            called cells. The word "cell" comes from small rooms. Now let us open one up.
          </p>

          <h2>Inside one cell: the parts, in plain words</h2>
          <p>
            Imagine a soft, water-filled bag, smaller than a grain of dust, crowded with tiny
            machines. That is a cell. Let us meet the parts one at a time. Each part has a job
            you already understand from everyday life.
          </p>
          <p>
            The <strong>cell membrane</strong> is the bag itself — a skin only two molecules
            thick, dotted with tiny doors. It is selective: it decides what enters the cell and
            what must stay out. Without it, the cell would simply spill into its surroundings.
          </p>
          <p>
            The <strong>nucleus</strong> is the library. It stores the DNA — the full
            instruction manual for building and running the cell — and it protects those
            instructions the way a head office protects its originals. Nothing important gets
            built without an order from here.
          </p>
          <p>
            The <strong>mitochondria</strong> are the power stations. They take fuel (sugar)
            and oxygen and burn them gently, producing energy the cell can spend. The energy
            comes in small units called <Glossary term="ATP" def="Adenosine triphosphate: a small molecule that carries usable energy between reactions. Cells spend it the way a factory spends money." />. Think of ATP as the cell's money: mitochondria earn it, and every other part spends it.
          </p>
          <p>
            The <strong>ribosomes</strong> are the builders. They are tiny specks — often
            thousands of them — and they read the instructions from the library and build
            <strong>proteins</strong>. A protein is a working part: an enzyme that speeds up a
            reaction, a fibre that holds skin together, a carrier that ferries oxygen in your
            blood.
          </p>
          <p>
            Everything floats in the <strong>cytoplasm</strong> — a clear jelly that fills the
            bag and hosts most of the cell's chemistry.
          </p>
          <p>
            Plant cells have three extra parts. The <strong>cell wall</strong> is a rigid
            cardboard box around the bag; it lets a tree stand up without bones.
            <strong>Chloroplasts</strong> are green solar panels: they capture sunlight and
            build sugar out of air and water — which is why plants never need lunch. And the
            <strong>vacuole</strong> is a water balloon in the middle; when it is full it
            presses everything outward. That pressure is the difference between crisp lettuce
            and wilted lettuce.
          </p>
<figure class="widget">
            <figcaption><span class="fig-no">fig. 1</span><span>the parts and their jobs — click any box</span></figcaption>
            <div class="widget-body">
              <div data-widget="diagram" data-config={JSON.stringify(cellCfg)}></div>
            </div>
          </figure>
          <p>
            <strong>So far:</strong> a cell is a bag (membrane) with a library (nucleus), power
            stations (mitochondria) and builders (ribosomes), all floating in jelly
            (cytoplasm). Plants add a cardboard box, solar panels and a water balloon. Click
            through the map above until every part feels familiar.
          </p>
          <p><em>Common misconception:</em> plant cells do not lack a membrane just because they
          have a wall — the membrane is inside the wall and does all the selective filtering; the
          wall is a passive corset. Equally, animal cells are not "without vacuoles": they have
          small, temporary ones for digesting and storing, just not one giant permanent reservoir.</p>

          <h2>How small is a cell? Words for tiny things</h2>
          <p>
            Cells are far too small to see, so biologists need size words. The whole ladder
            repeats one pattern: divide by a thousand.
          </p>
          <ul>
            <li>Divide a metre by 1,000 → <strong>millimetre</strong> (mm) — about the width of your fingernail.</li>
            <li>Divide again by 1,000 → <strong>micrometre</strong> (μm) — a millionth of a metre.</li>
            <li>Divide again by 1,000 → <strong>nanometre</strong> (nm) — a billionth of a metre.</li>
          </ul>
          <p>
            Now the actual sizes. One of your hairs is about 70 μm across. A typical human cell
            is 10–30 μm. A bacterium is 1–5 μm. A virus is about 100 nm — ten times smaller than
            a bacterium. That last gap matters: a normal school microscope that shows bacteria
            clearly cannot see viruses at all.
          </p>
          <p>
            And there is a physical ceiling. A light microscope cannot separate two points
            closer than about 200 nm, because visible light travels in waves roughly that size.
            To see <em>inside</em> a cell — the ribosomes, the membrane layers — you need an
            <strong>electron microscope</strong>, which uses beams of electrons instead of light.
          </p>

          <h2>Making a copy: how one cell becomes two</h2>
          <p>
            Why would a cell copy itself? Because you did not start this size. You began as one
            single cell, and you grew by dividing, over and over. Healing a cut, replacing worn
            skin, growing taller — all of it is cells making careful copies of themselves.
          </p>
          <p>
            The copying procedure is called <strong>mitosis</strong>, and it works like backing
            up your most important files. First the cell quietly photocopies every one of its
            chromosomes (the DNA books). Then it lines the copies up in the middle, pulls the
            two sets apart with tiny fibres, and pinches the bag in two. The result: two cells,
            each with a complete, identical set of instructions.
          </p>
          <p>
            Watch the loop below. The stage names (interphase, prophase, metaphase, anaphase,
            telophase, cytokinesis) matter for exams — but the idea is simply: copy, line up,
            pull apart, pinch.
          </p>
<figure class="widget">
            <figcaption><span class="fig-no">fig. 2</span><span>mitosis, one scrubable loop — from copy-out to pinch-off</span></figcaption>
            <div class="widget-body">
              <div data-widget="timeline" data-config={JSON.stringify(mitosisCfg)}></div>
            </div>
          </figure>
          <p>
            One thing mitosis never does: halve the set. Sperm and egg cells are the exception
            — they must carry <em>half</em> a set, so that two of them can fuse into a full one.
            They are made by a different, messier process called meiosis, and it has its own
            lesson later in this biology course.
          </p>

          <h2>How instructions become working machines</h2>
          <p>
            The nucleus keeps DNA safe — but a book locked in a vault builds nothing. So the
            cell runs a supply chain. The vault makes a disposable photocopy of one page (one
            gene) and ships it out. A builder reads the copy and assembles the machine.
            Biologists call the photocopy <strong>messenger RNA</strong>, and the reading
            happens three letters at a time, each triplet selecting one <strong>amino
            acid</strong> — the standard building block of proteins.
          </p>
<figure class="widget">
            <figcaption><span class="fig-no">fig. 3</span><span>from DNA to working protein</span></figcaption>
            <div class="widget-body">
              <div data-widget="equationStep" data-config={JSON.stringify(synthesisCfg)}></div>
            </div>
          </figure>
          <p>
            The finished chain of amino acids then folds itself into a precise 3D shape — and
            the shape <em>is</em> the job. Folded one way, the protein is a pocket that grips a
            sugar. Folded another way, it is haemoglobin's cage for an oxygen atom. Folded
            wrongly, it is a useless tangle — the kind found in Alzheimer's disease. One human
            cell runs this supply chain for about 20,000 different genes at the same time.
          </p>
          <p><em>Common misconception:</em> "DNA leaves the nucleus to build proteins." DNA never
          leaves the vault — only disposable copies (messenger RNA) travel out through pores in
          the nuclear envelope. The blueprint stays; the photocopy travels.</p>

          <h2>Try it yourself: measuring a cell</h2>
          <p>
            Here is a classic exam skill, done slowly. You look at a plant cell at ×400
            magnification. Inside the eyepiece there is a tiny ruler called the
            <strong>eyepiece graticule</strong>. The cell spans 12 divisions of that ruler.
            Earlier, you calibrated the ruler at this zoom using a real ruler placed on the
            stage: one division = 2.5 μm. So what is the cell's real length?
          </p>
          <ul>
            <li>Step 1. Real length = divisions × size of one division = 12 × 2.5 = <strong>30 μm</strong>.</li>
            <li>Step 2. Notice that the ×400 has already been divided out by the calibration. That is the entire point of calibrating.</li>
            <li>Step 3. You draw the cell 60 mm long in your notebook. How magnified is the drawing? Convert both lengths to the same unit: 60 mm = 60,000 μm. Magnification = image size ÷ real size = 60,000 ÷ 30 = <strong>×2,000</strong>.</li>
          </ul>
          <p>
            Three magnifications were in play — the microscope's, the calibration's, and the
            drawing's — and each answers a different question. The habit that saves you in
            exams: write down what each number <em>is</em> before you calculate.
          </p>
          <p><em>Common misconception:</em> magnification and resolution are the same thing, so more zoom means more detail. Magnification only enlarges; resolution is the physical limit set by light's wavelength — about 200 nm for the best optical microscopes. Enlarge a light-microscope image a thousand times more and you get a bigger blur, not more structure — which is why the electron microscope, not a stronger zoom, was needed to see inside cells.</p>

          <h2>From cells to you</h2>
          <p>
            Cells are the bottom rung of a ladder the rest of biology climbs. Similar cells
            team up into a <strong>tissue</strong> (muscle tissue, for example). Different
            tissues combine into an <strong>organ</strong> — your stomach is muscle, glands and
            lining tissue assembled for digesting; a leaf is several tissues assembled for
            capturing sunlight. Organs cooperate in <strong>systems</strong> (digestive,
            circulatory), and the systems together are <strong>you</strong>. Each level can do
            things the level below cannot: one heart cell cannot pump, and one leaf cannot feed
            a tree.
          </p>

          <h2>Check yourself</h2>
          <p>Try these before moving on. The answers are right below.</p>
          <ol>
            <li>What does the cell membrane do, in one sentence?</li>
            <li>Why does a muscle cell contain far more mitochondria than a skin cell?</li>
            <li>A bacterium is 3 μm long. Can you see it with a light microscope? What about a 100 nm virus?</li>
          </ol>
          <p>
            <strong>Answers:</strong> (1) It is the selective skin of the cell — it decides what
            enters and what leaves. (2) Muscle cells never stop spending energy, and
            mitochondria are where the energy currency (ATP) is earned — structure fits
            function. (3) The bacterium, yes — 3 μm is far above the roughly 200 nm resolution
            limit of light microscopes. The virus, no — 100 nm is below that limit.
          </p>
          <p><em>Common misconception:</em> plant cells need mitochondria even though they have
          chloroplasts. Photosynthesis makes sugar; <em>respiration</em> — in mitochondria, in every
          plant cell day and night — converts it to usable ATP. A plant cell is both a kitchen and
          a diner; remove the mitochondria and the solar panels are useless.</p>

          <h2>Going deeper</h2>
          <p>
            Why are cells so small? Not tradition — geometry. A cell lives by exchange through
            its surface, but its needs grow with its volume. Double a cell's side length and its
            surface area grows ×4 while its volume grows ×8, so its surface-area-to-volume ratio
            <em>halves</em>: a big cell starves in its middle, because diffusion from the
            membrane cannot keep up. Almost every workaround in biology — folded membranes, flat
            red blood cells, root hairs, the air sacs in your lungs — is an attack on this
            single ratio.
          </p>
          <p>
            There are also two great cell empires. Ours are <strong>eukaryotic</strong>: DNA
            kept in a nucleus, with the work divided among membrane-bound compartments.
            <strong>Prokaryotes</strong> — bacteria — are smaller and simpler: no nucleus (their
            circular DNA floats in the cytoplasm, often with extra gene rings called plasmids),
            and their ribosomes and walls are chemically different enough that many antibiotics
            exploit that gap. The deepest surprise of the last century: the eukaryotic cell is a
            merger. Mitochondria and chloroplasts were once free-living bacteria that another
            cell swallowed and kept — they still carry their own circular DNA, double membranes
            and bacteria-sized ribosomes. Lynn Margulis argued this <em>endosymbiosis</em> case
            for years against heavy scepticism; it is now textbook orthodoxy. Even the tools
            have a timeline: light microscopes (from the 1600s) could see cells; electron
            microscopes (from 1931) could see inside them. Every part in fig. 1 was invisible
            for most of human history — the size ladder above is the price of admission to that
            world.
          </p>

          <p class="sources"><strong>Sources:</strong> Hooke, <em>Micrographia</em> (1665); Cambridge IGCSE Biology 0615 syllabus, sections 2.1–2.2; Alberts et al., <em>Molecular Biology of the Cell</em>; Margulis, "On the Origin of Mitosing Cells" (1967).</p>

        <nav class="topic-next" aria-label="Lesson navigation">
          <div><span class="tn-label">previous lesson</span><a href={`${B}/${prev.slug}/`}>{prev.title}</a></div>
          <div style="text-align:right"><span class="tn-label">next lesson</span><a href={`${B}/${next.slug}/`}>{next.title}</a></div>
        </nav>
      </article>
    </div>
  </div>
</Layout>
