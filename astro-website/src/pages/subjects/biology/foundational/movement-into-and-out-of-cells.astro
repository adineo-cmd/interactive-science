---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const fickCfg = {
  curves: [
    { expr: 'x/d', label: 'rate at distance d', color: '#1d4ed8' },
    { expr: 'x/(2*d)', label: 'rate at double the distance', color: '#b42318' },
  ],
  params: [
    { name: 'd', label: 'diffusion distance', min: 0.5, max: 3, step: 0.5, value: 1, unit: 'µm' },
  ],
  x: { min: 0, max: 10, label: 'concentration difference (arb. units)' },
  y: { min: 0, max: 12, label: 'rate of diffusion' },
  crossings: false,
  height: 340,
};

const labCfg = {
  params: [
    { name: 'A', label: 'membrane surface area', min: 1, max: 10, step: 1, value: 4, unit: 'arb. units' },
    { name: 'g', label: 'concentration gradient', min: 1, max: 10, step: 1, value: 5, unit: 'arb. units' },
    { name: 'd', label: 'diffusion distance', min: 0.5, max: 5, step: 0.5, value: 1, unit: 'arb. units' },
    { name: 'T', label: 'temperature', min: 273, max: 323, step: 5, value: 293, unit: 'K' },
  ],
  readouts: [
    { label: 'net rate (arb. units)', expr: 'A*g/d', unit: '' },
    { label: 'relative diffusion coefficient (D ∝ T)', expr: 'T/293', unit: '' },
    { label: 'relative time to cross (∝ d²)', expr: 'd*d', unit: '' },
  ],
};

const osmosisCfg = {
  steps: [
    { math: 'pure water: water potential Ψ = 0', note: 'Pure water is the reference — the highest water potential there is.' },
    { math: 'dissolve solute → Ψ goes negative', note: 'More solute means a more concentrated solution and a lower (more negative) water potential.' },
    { math: 'water moves: high Ψ → low Ψ', note: 'Osmosis is the net movement of water molecules from a dilute solution (higher water potential) to a concentrated one (lower water potential) through a partially permeable membrane.' },
    { math: 'plant cell in dilute solution → turgid', note: 'Water enters; the vacuole swells and the cytoplasm presses outward on the cell wall. That turgor pressure is what keeps soft plant tissue firm.' },
    { math: 'plant cell in concentrated solution → plasmolysis', note: 'Water leaves; the vacuole shrinks and the membrane pulls away from the wall. The flaccid, plasmolysed cell loses support — a wilting lettuce, not a crisp one.' },
  ],
};

const vecCfg = { type: 'vector', unit: 'µm', x: { min: 0, max: 10 }, y: { min: 0, max: 10 }, start: [5, 2] };

const mtTrafficBuckets = {
  "prompt": "The membrane's traffic splits by one question: is the cell paying for it? File each case:",
  "buckets": [
    "free (no ATP)",
    "paid (billed in ATP)"
  ],
  "items": [
    {
      "label": "diffusion — the molecules' own random motion does the work",
      "bucket": 0
    },
    {
      "label": "osmosis — water's free version",
      "bucket": 0
    },
    {
      "label": "perfume spreading through a room",
      "bucket": 0
    },
    {
      "label": "active transport — uphill, against the gradient",
      "bucket": 1
    },
    {
      "label": "protein carriers changing shape using ATP",
      "bucket": 1
    },
    {
      "label": "glucose hauled uphill in the gut",
      "bucket": 1
    }
  ],
  "why": "Diffusion and osmosis cost nothing; active transport runs uphill and is billed in ATP — the cell's small coins."
};

const mtFactorsMatch = {
  "prompt": "Four factors set the rate — pair each with how anatomy exploits it:",
  "pairs": [
    {
      "left": "concentration gradient",
      "right": "keep it steep — blood sweeps CO₂ off the lung side the moment it crosses"
    },
    {
      "left": "temperature",
      "right": "warmer molecules collide more — labs incubate cultures warm"
    },
    {
      "left": "surface area",
      "right": "fold it — 300 million alveoli pack ~70 m² into your chest"
    },
    {
      "left": "distance",
      "right": "minimise it — the villain of the piece"
    }
  ],
  "why": "Maximise area and gradient, minimise distance, keep the medium moving — every exchange organ is a variation on the same four-factor theme."
};

const mtEquilibJudge = {
  "statements": [
    {
      "s": "What stops at equilibrium is the net movement; individual molecules keep crossing both ways in equal numbers.",
      "truth": true,
      "why": "Equilibrium is dynamic — a balanced interchange, not a standstill."
    },
    {
      "s": "Real cells rarely reach equilibrium anyway, because they consume what arrives and replace what leaves.",
      "truth": true,
      "why": "Holding the gradient alive is the cell's whole trick."
    },
    {
      "s": "Once equilibrium is reached, individual molecules stop moving.",
      "truth": false,
      "why": "Only the NET movement stops — the crossings continue exactly as before, in equal numbers."
    },
    {
      "s": "Diffusion is the net movement from lower to higher concentration.",
      "truth": false,
      "why": "Down the gradient, always — uphill is active transport's paid job."
    }
  ]
};

const mtOsmosisCloze = {
  "text": "Osmosis is the net movement of %%0%% molecules from a %%1%% solution to a %%2%% one, through a %%3%% %%4%% membrane — and water always moves from higher water potential to lower.",
  "answers": [
    [
      "water"
    ],
    [
      "dilute"
    ],
    [
      "concentrated"
    ],
    [
      "partially"
    ],
    [
      "permeable"
    ]
  ],
  "hint": "The membrane holds the solute back — that withheld solute is what creates the water-potential difference."
};

const mtIsotonicPlace = {
  "prompt": "Potato strips soaked in sucrose solutions: the length-change line crosses zero where the tissue neither gains nor loses water. Pin that concentration (mol/dm³):",
  "labels": [
    "0",
    "0.25",
    "0.5",
    "0.75",
    "1.0"
  ],
  "scale": {
    "min": 0,
    "max": 1
  },
  "answer": 0.3,
  "tolerance": 0.1,
  "why": "About 0.3 mol/dm³ for potato — the plot is a calibration: any unknown solution can now be matched against the tissue.",
  "context": "Dialysis tubing works the same way: fill it with strong sugar solution, weigh it, and watch the mass climb as water enters."
};

const mtStakesCompare = {
  "prompt": "A dilute solution floods in — drag the divider between the two kingdoms:",
  "before": {
    "label": "animal cell (no wall)",
    "text": "A red blood cell swells until it bursts — haemolysis. Which is why intravenous drips are precisely 0.9% saline."
  },
  "after": {
    "label": "plant cell (wall)",
    "text": "The vacuole swells and the cytoplasm presses outward on the cellulose wall — turgid. A crisp lettuce is a hydraulic structure."
  },
  "why": "In concentrated solution the fates reverse — shrivelled for the wall-less, plasmolysed for the walled — and guard cells open stomata by the same pump-free trick."
};

const mtSteerSpot = {
  "prompt": "This cell-traffic answer contains one faulty line — click it:",
  "lines": [
    "Diffusion only runs downhill; active transport pumps uphill against the gradient.",
    "Protein carriers pick up their cargo, change shape using ATP, and release it on the far side.",
    "Poison the mitochondria and active transport stops within minutes, while diffusion carries on.",
    "A cell can steer individual diffusing molecules directly to where they are needed.",
    "Wherever a cell accumulates a substance against the gradient, expect mitochondria crowded around that membrane."
  ],
  "errorLine": 3,
  "correction": "A cell cannot steer individual molecules — it can only shape the conditions: maintaining gradients, installing channels and carriers, moving the membrane itself.",
  "why": "Diffusion is nobody's employee; the membrane's architecture is the cell's only lever — which is why so much of cell biology is really membrane engineering."
};

const mtPumpEstimate = {
  "prompt": "The sodium–potassium pump spends one ATP per cycle, exporting 3 Na⁺ and importing 2 K⁺. Roughly how many cycles does one pump run per second?",
  "unit": "cycles/s",
  "answer": 1000,
  "factor": 1.6,
  "why": "About 1,000 times per second per pump — tens of millions per neuron, consuming a third to a half of the brain's energy budget.",
  "context": "Resting potential — the 70 mV every neuron holds — is this pump's accumulated work: active transport as the idling engine of the nervous system."
};
---
<TopicPage slug="subjects/biology/foundational/movement-into-and-out-of-cells">

  <h2>Where you are, and what you will learn</h2>
  <p>
    This is a beginner lesson in Biology. It needs zero prior knowledge. Its
    starting point is something you can smell: open a bottle of perfume in
    one corner of a room, and in a minute the whole room knows about it.
    Nothing pushed the scent across. This lesson is about that kind of
    movement — and about what living cells do when movement has to be
    forced.
  </p>
  <p>By the end of this lesson you will be able to:</p>
  <ul>
    <li>define diffusion and predict which way particles will move;</li>
    <li>name the four factors that set the rate of diffusion, and show how exchange surfaces such as the lungs exploit them;</li>
    <li>define osmosis and water potential, and predict what happens to cells placed in strong or weak solutions;</li>
    <li>say when a cell must pay energy to move a substance, and what powers the process.</li>
  </ul>

  <h2>The door every cell lives behind</h2>
  <p>
    Every living cell is wrapped in a membrane only a few nanometres thick.
    Everything the cell needs — oxygen, glucose, ions, water — has to cross
    it, and everything the cell must be rid of (carbon dioxide, urea, excess
    salts) has to leave by the same door. The membrane is
    <strong>partially permeable</strong>: a double skin of fat molecules,
    oily in the middle, that lets small uncharged molecules slip through
    while blocking ions and large ones unless a protein helps.
  </p>
  <p>
    Three processes handle all of this traffic, and they differ by exactly
    one question: <strong>is the cell paying for it?</strong>
    <strong>Diffusion</strong> costs nothing — the random motion of the
    molecules themselves does the work. <strong>Osmosis</strong> is
    diffusion's water version, likewise free. <strong>Active
    transport</strong> runs uphill and is billed in ATP — the cell's energy
    currency, which you can think of as small coins the cell spends. Which
    process a cell uses where, and how every exchange surface in your body
    is built around their rules, is this lesson.
  </p>
  <Widget no="5" caption="file the traffic — free or paid?" widget="sort-buckets" config={mtTrafficBuckets} />
  <p>
    <strong>So far:</strong> the membrane is a selective door, and its
    traffic splits into free movement (diffusion, osmosis) and paid movement
    (active transport). Next: the free kind.
  </p>

  <h2>Diffusion: traffic that needs no engine</h2>
  <p>
    <strong>Diffusion</strong> is the net movement of particles from a
    region of their higher concentration to a region of their lower
    concentration — down a <strong>concentration gradient</strong>. No
    engine drives it. The energy is the <strong>kinetic energy</strong> of
    the molecules themselves — the energy of their own random jostling.
    Each molecule zigzags without purpose, but where there are more of them
    on one side, more random steps cross that way than back. Net flow, zero
    design: the same statistics that spread perfume through a room load
    oxygen into your blood and unload its CO<sub>2</sub>.
  </p>
  <p>
    Diffusion is random, but its outcome is still a displacement. Watch one
    molecule's <strong>net</strong> journey in the diagram below — thousands
    of random zigzags collapse into one arrow: the x-component crossed the
    membrane, the y-component drifted harmlessly along it. Net movement,
    not the individual path, is what diffusion delivers.
  </p>

  <Widget no="4" caption="a diffusing molecule's net displacement — x crosses the membrane, y drifts along it; drag the head" widget="diagramBuilder" config={vecCfg} />
  <p>
    <strong>What to notice:</strong> drag the arrow's head around and watch
    what its two components do — every random-looking zigzag you draw
    collapses into one net arrow. The x-component is what diffusion
    delivers: it carried the molecule across the membrane. The y-component
    drifted along the membrane and achieved nothing — which is exactly why
    net movement, not any individual path, is what diffusion counts.
  </p>

  <p>
    The syllabus singles out four factors that set the
    <strong>rate</strong>, and each is a design instruction.
    <strong>Concentration gradient:</strong> the bigger the difference
    between the two sides, the more crossings go one way — living systems
    keep gradients steep by consuming or carrying away what arrives (blood
    sweeps CO<sub>2</sub> off the lung side of the membrane the moment it
    crosses). <strong>Temperature:</strong> hotter molecules move faster
    and collide more often, so diffusion speeds up — which is why
    cold-blooded animals slow in the cold and why labs incubate cultures
    warm. <strong>Surface area:</strong> more membrane, more simultaneous
    crossings — hence the folds: about 300 million alveoli in two lungs,
    packing roughly 70 m² of surface into your chest, plus gut villi and
    microvilli, gill lamellae, root hairs.
  </p>
  <Widget no="6" caption="pair each factor with its design instruction" widget="match" config={mtFactorsMatch} />
  <p>
    <strong>Distance</strong> is the villain of the piece. The graph shows
    rate climbing with gradient but falling as distance grows — at every
    gradient, doubling the diffusion distance halves the rate:
  </p>

  <Widget no="1" caption="doubling the diffusion distance halves the rate, at every gradient" widget="plotter" config={fickCfg} />
  <p>
    <strong>What to notice:</strong> slide the diffusion distance and watch
    both curves rescale together, with the doubled-distance line always
    sitting at exactly half the single-distance line — at every value of the
    concentration difference. The two lines never cross: a steeper gradient
    raises the rate, but it never undoes distance's penalty. That is the
    whole reason exchange surfaces are built thin.
  </p>

  <p>
    Worse still, the <em>time</em> to cross grows with the
    <strong>square</strong> of the distance — random walks are inefficient
    travellers, so ten times further away is a hundred times slower. The
    sliders let you run the trade-offs together, and the readouts expose
    why distance rules biology:
  </p>

  <Widget no="2" caption="surface area × gradient ÷ distance — the anatomy of every exchange surface" widget="sliderLab" config={labCfg} />
  <p>
    <strong>What to notice:</strong> push surface area and gradient up and
    watch the net rate climb; push distance up and watch it fall. Then read
    the third readout carefully — the time to cross grows with the
    <em>square</em> of the distance, so a doubled distance is not twice as
    slow but four times as slow. Temperature raises the diffusion
    coefficient, but it cannot rescue a large distance.
  </p>

  <p>
    A simple body plan can live on diffusion alone — flatworms are flat
    precisely so no cell sits more than a fraction of a millimetre from the
    outside — but anything thicker needs transport systems and exchange
    surfaces. That is the single most important idea in the topic:
    <strong>diffusion of gases and solutes matters to every
    organism</strong>, and every organ built for exchange is a variation on
    the same four-factor theme — maximise area and gradient, minimise
    distance, keep the medium moving.
  </p>
  <p>
    A cube makes the surface-to-volume point brutally clear. A cell 10 µm
    on a side has surface 600 µm² and volume 1,000 µm³ — a ratio of 0.6.
    Double the side to 20 µm and the surface reaches 2,400 µm² (×4) but the
    volume reaches 8,000 µm³ (×8), halving the ratio to 0.3: twice the
    cell, half the membrane per unit of cytoplasm to feed. Scale to a
    millimetre and the ratio collapses to 0.006 — no diffusion could serve
    the interior. Cells therefore stay small, flatten, fold their
    membranes, or divide; each strategy is a way of buying surface with
    geometry, and every exchange organ in the body is built on the same
    purchase.
  </p>
  <p>
    <em>Common misconception:</em> "diffusion stops once equilibrium is reached." What stops
    is the <em>net</em> movement; individual molecules keep crossing both ways exactly as
    before, in equal numbers. Equilibrium is dynamic — a balanced interchange, not a
    standstill — and real cells never reach it anyway, because they consume what arrives and
    replace what leaves, holding the gradient alive.
  </p>
  <Widget no="7" caption="true or false — life at equilibrium" widget="judge" config={mtEquilibJudge} />

  <h2>Osmosis and water potential</h2>
  <p>
    Water is the solvent of life: digestion happens in solution, excretion
    carries waste dissolved in water, and blood and sap transport
    everything dissolved. Because water molecules are tiny, they slip
    through the membrane's partially permeable structure — while the
    solutes dissolved in them mostly cannot — and this water-specific
    diffusion is <strong>osmosis</strong>: the net movement of water
    molecules from a dilute solution to a concentrated one, through a
    partially permeable membrane.
  </p>
  <Widget no="8" caption="fill the blanks — osmosis, defined" widget="cloze" config={mtOsmosisCloze} />
  <p>
    Intuition can wobble here — it is odd at first that water flows
    <em>into</em> the sugary side — but the logic is pure statistics. Pure
    water is crowded with water molecules. Dissolve solute, and some of
    those slots are taken: fewer water molecules per unit volume sit on the
    concentrated side, so random crossings outnumber the returns. Water, in
    effect, dilutes the universe.
  </p>
  <p>
    <em>Common misconception:</em> "osmosis happens whenever water meets sugar." Without
    a partially permeable membrane there is no osmosis, just ordinary mixing — the solute
    diffuses too, and no selective pressure builds up. Osmosis is specifically water's
    net movement <em>through</em> a membrane that holds the solute back; that withheld
    solute is what creates the water-potential difference the water responds to.
  </p>
  <p>
    The quantitative handle is <strong>water potential</strong> (biologists
    write it with the Greek letter psi), a measure of how free the water is
    to move: pure water has the highest water potential there is, and
    dissolving anything in it lowers it. Water always osmoses from higher
    water potential to lower. The widget walks the idea through in five
    steps, ending where it shows most: wilting lettuce.
  </p>

  <Widget no="3" caption="water potential, from definition to wilting lettuce" widget="equationStep" config={osmosisCfg} />
  <p>
    <strong>What to notice:</strong> step through the five cards and track
    the water potential — pure water starts at zero, and every solute
    dissolved pushes it more negative. Watch the direction rule hold on the
    third card: water always moves from higher water potential to lower.
    Then match the last two cards to lunch — turgid is the crisp lettuce,
    plasmolysis is the wilted one.
  </p>

  <p>
    Osmosis can be measured with dialysis tubing (an artificial partially
    permeable membrane): fill it with strong sugar solution, weigh it, and
    watch the mass climb as water enters. Immerse potato strips in
    solutions of different concentrations instead, and length changes map
    the point where the tissue neither gains nor loses water — the strip is
    at <strong>isotonic</strong> balance with that solution.
  </p>
  <Widget no="9" caption="pin the isotonic point on the concentration scale" widget="place" config={mtIsotonicPlace} />
  <p>
    The stakes differ by kingdom. Animal cells have no wall: in pure water
    a red blood cell swells until it bursts (<em>haemolysis</em>); in
    strong salt solution it shrivels (<em>crenation</em>) — which is why
    intravenous drips are precisely 0.9% saline. Plant cells have a
    cellulose wall: in dilute solution they become <strong>turgid</strong>,
    and that turgor pressure is what keeps soft plant tissue firm — a crisp
    lettuce is a hydraulic structure. In concentrated solution water
    leaves, the membrane pulls from the wall (<strong>plasmolysis</strong>),
    and the tissue wilts. Guard cells open the stomata of a leaf by the
    same pump-free trick: they accumulate solutes, water follows, and the
    curved cells bow apart.
  </p>
  <Widget no="10" caption="dilute solution, two fates — drag between kingdoms" widget="compare" config={mtStakesCompare} />
  <p>
    <strong>So far:</strong> diffusion moves everything downhill for free,
    osmosis is the same for water, and the results — turgid lettuce,
    bursting red cells — depend on the membrane holding solutes back.
    Next: the movements neither process can manage.
  </p>

  <h2>Active transport: pumping uphill</h2>
  <p>
    Diffusion only runs downhill. But root hairs absorb mineral ions from
    soil that is <em>diluter</em> than the cell sap — the wrong way for
    diffusion — and your gut absorbs glucose even when the gut contents are
    weaker than the blood. For that, membranes use <strong>active
    transport</strong>: movement from lower to higher concentration,
    <strong>against</strong> the gradient, powered by energy from
    respiration. The machinery is specific: <strong>protein
    carriers</strong> in the membrane pick up the molecule or ion, change
    shape using ATP, and release it on the far side — each carrier a
    bespoke pump for its cargo, selective where diffusion is blind.
  </p>
  <p>
    The price of pumping uphill is paid in ATP, which makes active
    transport a direct tax on respiration. Poison the mitochondria (or
    simply chill or deoxygenate the tissue) and the pumps stop within
    minutes, while diffusion carries on regardless — it never needed the
    energy budget. That dependence is also how the process is demonstrated
    experimentally: slow a root's respiration and ion uptake falls with it,
    even though the concentration gradient has not changed. Wherever a cell
    accumulates a substance against the gradient — mineral ions in root
    hairs, glucose in the gut and kidney tubule, salt glands of seabirds —
    expect to find mitochondria crowded around those membranes, fuelling
    the carriers.
  </p>
  <p>
    <em>Common misconception:</em> "cells direct their own diffusion." A cell cannot
    steer individual molecules — it can only shape the conditions: maintaining gradients
    by consuming or releasing solutes, installing channels and carriers, moving the
    membrane itself. Diffusion is nobody's employee; the membrane's architecture is the
    cell's only lever, which is why so much of cell biology is really membrane
    engineering.
  </p>
  <Widget no="11" caption="find the faulty line — the membrane-engineering answer" widget="spot-error" config={mtSteerSpot} />

  <h2>Check yourself</h2>
  <p>Try these before moving on. The answers are right below.</p>
  <ol>
    <li>A drop of ink falls into a still glass of water. Describe what happens, and name the process.</li>
    <li>A plant cell is placed in concentrated salt water. What happens to it, and what is the process called?</li>
    <li>Root hairs take up ions from soil more dilute than their cell sap. Why can diffusion not do this, and what does the root spend?</li>
  </ol>
  <p>
    <strong>Answers:</strong> (1) The ink spreads through the water until
    it is evenly coloured — diffusion, driven by the random motion of the
    particles. (2) Water leaves the cell, the membrane pulls away from the
    wall, and the cell becomes flaccid — plasmolysis. (3) The ions would
    have to move against their concentration gradient, which diffusion
    cannot do; the root spends ATP from respiration to run carrier pumps —
    active transport.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>The membrane is partially permeable, and its traffic splits into free movement (diffusion, osmosis) and paid movement (active transport, billed in ATP).</li>
    <li>Diffusion moves particles down a concentration gradient with no engine — the molecules' own kinetic energy does the work.</li>
    <li>Four factors set the rate: concentration gradient, temperature, surface area and distance — exchange surfaces maximise the first three and minimise the last.</li>
    <li>Time to cross grows with the square of the distance, which is why cells stay small and thick bodies need transport systems.</li>
    <li>Osmosis is water's own diffusion through a partially permeable membrane, from higher water potential to lower.</li>
    <li>Dilute solutions make plant cells turgid and burst animal cells; concentrated solutions plasmolyse plant cells and shrivel animal ones.</li>
    <li>Active transport pumps against the gradient through protein carriers powered by respiration — stop the mitochondria and the pumps stop.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    These traffic rules are the operating manual for the rest of the course.
    Human body systems shows the exchange surfaces built on them — alveoli,
    capillaries, the gut — and photosynthesis and respiration are the
    reactions that keep the gradients steep and the ATP supply flowing. The
    cell structure lesson introduced the membrane as a door; this one taught
    its physics.
  </p>

  <h2>Going deeper</h2>
  <p>
    The quantitative frame is <strong>Fick's law</strong>: the rate of
    diffusion is proportional to (surface area × concentration difference)
    divided by membrane thickness — the slider lab above is the equation
    with skin on. It is worth converting to numbers. The alveolar–capillary
    membrane is about 0.5 µm thick; oxygen crosses it in about 0.25 s, and
    at rest your body diffuses about 250 mL of O<sub>2</sub> per minute
    through that interface — rising to about 4,000 mL per minute in an
    athlete, with membrane thickness unchanged: the gradient and flow do
    the work. The square-of-distance law explains the largest constraint in
    biology: diffusion is superb at micrometres, hopeless at centimetres (a
    nutrient would take hours to cross a centimetre of still tissue and
    years to cross a metre) — which is why no cell sits farther than about
    100 µm from a capillary, why jellyfish are thin and flat even at metre
    size, and why the evolution of thick bodies and the evolution of
    circulatory systems were the same event.
  </p>
  <p>
    The expert edges refine the categories. Membranes are not passive
    sieves: <strong>facilitated diffusion</strong> moves glucose and ions
    <em>down</em> their gradients through channel and carrier proteins —
    still free (the cell pays nothing), but protein-assisted and
    saturable, which is why the glucose carriers of the kidney can be
    overwhelmed in diabetes (glycosuria). <strong>Water channels
    (aquaporins)</strong> make osmosis thousands of times faster than plain
    lipid passage — the kidney reclaims about 180 L of filtrate a day
    through them, tuned minute to minute by the hormone ADH. And the
    heavier machinery spans the space between the categories: the
    sodium–glucose cotransporter in the gut spends sodium's downhill
    gradient (bought with the Na<sup>+</sup>/K<sup>+</sup>-ATPase's ATP) to
    haul glucose uphill — active transport, but powered indirectly. One
    membrane, and all three traffic systems share the same battery.
  </p>
  <p>
    Two measurements turn the categories into numbers. The osmotic
    practical, run properly: potato strips equal in initial length are
    soaked for a fixed 30–60 minutes in sucrose solutions from 0 to 1.0
    mol/dm<sup>3</sup>, and the <em>percentage change in length</em> is
    plotted against concentration — a descending line that crosses zero
    change at the concentration matching the tissue's own water potential
    (typically about 0.3 mol/dm<sup>3</sup> for potato). The plot is a
    calibration, not just a result: any unknown solution can now be matched
    against the tissue. And the active-transport benchmark is the
    <strong>sodium–potassium pump</strong>: one ATP spent per cycle exports
    3 Na<sup>+</sup> and imports 2 K<sup>+</sup> — an electrogenic cycle
    running about 1,000 times per second per pump, tens of millions of
    pumps per neuron, consuming a third to a half of the brain's entire
    energy budget just to keep the gradients standing that every nerve
    impulse then spends. Resting potential — the 70 mV every neuron holds —
    <em>is</em> this pump's accumulated work: active transport as the
    idling engine of the nervous system.
  </p>
