const hbWaterBuckets = {
  "prompt": "Osmoregulation — file each fact by which way ADH moves:",
  "buckets": [
    "ADH rises — hold water",
    "ADH falls — release water",
    "the ledger"
  ],
  "items": [
    {
      "label": "blood arrives too concentrated",
      "bucket": 0
    },
    {
      "label": "dark, scanty urine on a dehydrated day",
      "bucket": 0
