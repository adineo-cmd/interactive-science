};

const hbThermoCompare = {
  "prompt": "Thermoregulation — drag the divider across the hypothalamus's decisions:",
  "before": {
    "label": "too hot",
    "text": "Sweat when hot — evaporative cooling — and skin vessels flush to dump heat at the surface."
  },
  "after": {
    "label": "too cold",
    "text": "Shiver — muscle-generated heat — and skin vessels clamp, holding core temperature within about 1 °C of 37 °C."
  },
  "why": "The skin is homeostasis's largest organ — about two square metres showing the thermostat's decisions in real time, flushed, pale, sweaty or clammy."
};

const hbAbsorbBranch = {
  "root": "A meal is travelling down the nine-metre tube. Each stage of processing happens in a different organ — route it.",
  "nodes": {
    "start": {
      "text": "Which organ does acid-and-enzyme demolition and sterilisation?",
      "choices": [
        {
          "label": "The stomach",
          "next": "stomach",
          "feedback": "Demolition and sterilisation — its actual job."
        },
        {
