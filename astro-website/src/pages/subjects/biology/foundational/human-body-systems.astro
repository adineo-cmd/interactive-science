    "Right ventricle",
    "Lungs — load O₂, unload CO₂",
    "Left atrium",
    "Left ventricle",
    "The body — then back to the right atrium"
  ],
  "why": "It passes through the heart TWICE per lap, and the two halves pump into separate circuits — a low-pressure lung loop and a high-pressure body loop in series."
};

const hbHeartMatch = {
  "prompt": "The self-wiring pump — pair each part with its role:",
