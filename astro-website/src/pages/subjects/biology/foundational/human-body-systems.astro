    "Every donated unit is typed, cross-matched and traced from vein to vein."
  ],
  "errorLine": 3,
  "correction": "The wrong blood group is lethal, not safe — the recipient's antibodies DESTROY the transfused cells.",
  "why": "ABO and rhesus are inherited surface-sugar variants; the antibody screen is why transfusion medicine types every unit."
};

const hbColourJudge = {
  "statements": [
    {
      "s": "Oxygen-poor blood is dark red, never blue.",
      "truth": true,
      "why": "Deoxygenated blood keeps its red — darker, not a different colour."
    },
    {
      "s": "Veins look bluish through skin because of how light scatters in tissue and how the eye reads colour through the layers.",
      "truth": true,
      "why": "Optics, not physiology."
    },
    {
      "s": "Blood turns red only on contact with air.",
      "truth": false,
      "why": "The blue-vein diagram is a colouring convention — and no blood bank has ever drawn a blue bag."
    },
    {
      "s": "A red cell lives about 120 days, and the marrow replaces about 2 million per second.",
      "truth": true,
      "why": "The concave discs are consumables, constantly remade."
    }
