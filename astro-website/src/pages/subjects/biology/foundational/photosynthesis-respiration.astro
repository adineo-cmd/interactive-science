---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const lightCfg = {
  curves: [{ expr: 'rmax*x/(x + k)', label: 'photosynthesis rate', color: '#2e7d32', width: 2.4 }],
  params: [
    { name: 'rmax', label: 'max rate rₘₐₓ', min: 4, max: 20, step: 0.5, value: 10 },
    { name: 'k', label: 'half-saturation k', min: 20, max: 200, step: 5, value: 80 },
  ],
  x: { min: 0, max: 500, label: 'light intensity (µmol/m²·s)' },
  crossings: false,
  height: 340,
};

const eqCfg = {
  steps: [
    { math: '6CO₂ + 6H₂O + light → C₆H₁₂O₆ + 6O₂', note: 'Photosynthesis, in the chloroplast: carbon dioxide plus water, powered by sunlight, becomes sugar plus the oxygen we breathe.' },
    { math: 'C₆H₁₂O₆ + 6O₂ → 6CO₂ + 6H₂O + ~30 ATP', note: 'Respiration, in the mitochondria: the sugar is burned back to CO₂ and water, banking the energy as ATP.' },
    { math: 'the two equations are near-mirror images', note: 'One stores energy in chemical bonds; the other releases it. Nearly every food chain is this loop, running on sunlight.' },
    { math: 'ATP → ADP + Pᵢ + usable energy', note: 'ATP is the cell\'s rechargeable battery. Your body recycles roughly its own weight of ATP every day.' },
  ],
};

const phHistoryOrder = {
  "prompt": "How humanity worked out the loop — put the experiments in order:",
  "items": [
    "1640s: van Helmont grows a willow in 91 kg of dried soil for five years, watering it only",
    "The tree gains 74 kg while the soil loses almost nothing — mass does not come from soil",
    "1771: Priestley seals a mouse and a lit candle in a jar; a sprig of mint 'restores the air'",
    "Within a decade, Ingenhousz shows the restoration needs light",
    "The pieces assemble into an equation: light + water + carbon dioxide → sugar + oxygen"
  ],
  "why": "Simple experiments, one hint at a time — the first hint that a plant's mass does not come from the soil, though van Helmont guessed water and CO₂ was still unknown."
};

const phGreenhouseEstimate = {
  "prompt": "Outdoor air is about 0.04% carbon dioxide. Commercial greenhouse growers pump in extra to push photosynthesis past its light-limited plateau — about what concentration do they run?",
  "unit": "% CO₂",
  "answer": 0.1,
  "factor": 1.6,
  "why": "About 0.1% — two-and-a-half times outdoors — because when light is no longer the limit, carbon dioxide or temperature takes over as the bottleneck.",
  "context": "The aquatic-plant classic: count oxygen bubbles per minute as the lamp moves closer — the count doubles, then stops responding."
};

const phMirrorCompare = {
  "prompt": "The two equations of life — drag the divider between them:",
  "before": {
    "label": "photosynthesis",
    "text": "The uphill build: energy goes IN from light. CO₂ + water become sugar + oxygen — in chloroplasts."
  },
  "after": {
    "label": "respiration",
    "text": "The downhill burn: energy comes OUT as ATP. Glucose + oxygen become CO₂ + water — in mitochondria."
  },
  "why": "Near-mirror images, completely different machinery — no single factory could run both in one room, so ATP shuttles between them like money between accounts."
};

const phLeafMatch = {
  "prompt": "A factory arranged in layers — pair each part with its job:",
  "pairs": [
    {
      "left": "palisade mesophyll",
      "right": "upright packed cells crammed with chloroplasts, where the light is brightest"
    },
    {
      "left": "spongy mesophyll",
      "right": "loose, with air spaces so CO₂ diffuses to every photosynthesising cell"
    },
    {
      "left": "guard cells",
      "right": "swell with water to open the stoma, sag to close it"
    },
    {
      "left": "xylem",
      "right": "carries water up from the roots — raw material and turgor"
    },
    {
      "left": "phloem",
      "right": "ships the finished sucrose to shoots, fruit and storage"
    }
  ],
  "why": "Every layer answers the same three demands — light in, CO₂ in, water managed. A typical leaf carries 100+ stomata per square millimetre: a deliberate trade of water for carbon."
};

const phStagesCloze = {
  "text": "In the %%0%% stage, chlorophyll absorbs photons and the energy rips %%1%% molecules apart — the oxygen you breathe is this step's waste product. The captured energy is banked as ATP and NADPH. In the %%2%% stage (the %%3%% cycle), that banked energy fixes CO₂ until glucose emerges — it needs the first stage's products, but not the light itself.",
  "answers": [
    [
      "light-dependent"
    ],
    [
      "water"
    ],
    [
      "light-independent"
    ],
    [
      "Calvin"
    ]
  ],
  "hint": "One stage needs photons; the other needs the bank."
};

const phBrainEstimate = {
  "prompt": "Your brain is about 2% of your body weight. Roughly what share of your resting energy does it respire?",
  "unit": "%",
  "answer": 20,
  "factor": 1.6,
  "why": "Roughly 20% — and your body recycles roughly its own weight of ATP molecules every day, recharging and spending them in continuous cycles.",
  "context": "Photosynthesis is income, respiration is salary day, ATP is the currency every purchase is made in."
};

const phFermentBuckets = {
  "prompt": "One emergency chemistry, different products — file each by what it makes:",
  "buckets": [
    "lactic acid",
    "ethanol + CO₂",
    "methane"
  ],
  "items": [
    {
      "label": "sprinting human muscle",
      "bucket": 0
    },
    {
      "label": "bacteria turning milk into yogurt and cheese",
      "bucket": 0
    },
    {
      "label": "yeast in beer, wine and bread",
      "bucket": 1
    },
    {
      "label": "the CO₂ that puffs the dough",
      "bucket": 1
    },
    {
      "label": "deep, oxygen-free mud",
      "bucket": 2
    },
    {
      "label": "the cow rumen",
      "bucket": 2
    }
  ],
  "why": "Yeast reduces pyruvate to ethanol and CO₂; human muscle converts it to lactic acid — same emergency logic, different enzymes. No sprint brews beer in your legs."
};

const phControlSpot = {
  "prompt": "This photosynthesis-experiment answer contains one faulty line — click it:",
  "lines": [
    "Destarch the plant in the dark for 48 hours first — then the iodine is an honest meter.",
    "Cover part of a leaf with foil: only the uncovered half goes black — light is necessary.",
    "Seal a leaf in a jar with soda-lime, which ADDS carbon dioxide to the air: it stays amber, proving CO₂ is necessary.",
    "A variegated leaf goes black only where it was green — chlorophyll is necessary.",
    "Glucose is converted to insoluble starch for storage, which is what the iodine detects."
  ],
  "errorLine": 2,
  "correction": "Soda-lime SCRUBS CO₂ from the air — the leaf stays amber because the gas was removed, not added.",
  "why": "Three controls, three conclusions: foil removes light, soda-lime removes CO₂, variegation removes chlorophyll — each necessity shown by taking the factor away."
};
---
<TopicPage slug="subjects/biology/foundational/photosynthesis-respiration">

  <h2>Where you are, and what you will learn</h2>
  <p>
    This is a beginner lesson in Biology. It needs zero prior knowledge. Its
    starting point is your last meal: bread, rice, an apple — whatever it
    was, the energy inside it was once sunlight, caught by a plant. This
    lesson follows that energy: how it is captured, stored, and spent again.
  </p>
  <p>By the end of this lesson you will be able to:</p>
  <ul>
    <li>state the word and symbol equations for photosynthesis and aerobic respiration;</li>
    <li>explain limiting factors using the light-response curve;</li>
    <li>name the layers of a leaf and match each to its job;</li>
    <li>explain what happens in muscles and in yeast when oxygen runs out;</li>
    <li>design the classic experiments that prove what photosynthesis needs.</li>
  </ul>

  <h2>The loop that runs the planet</h2>
  <p>
    Every calorie you have ever burned was once sunlight. Plants — and
    algae, and some bacteria — run the only large-scale process on Earth
    that converts light into storable chemical energy:
    <strong>photosynthesis</strong>. It happens inside
    <strong>chloroplasts</strong>, the tiny green compartments packed into
    plant cells. Everything else, from fungi to philosophers, lives by
    <strong>respiring</strong> that stored energy inside
    <strong>mitochondria</strong>, the cell's power stations. The two
    processes are a loop with the Sun at the top: photosynthesis builds
    sugar out of thin air and water, respiration burns the sugar back to
    air and water, and the difference is paid for by sunlight.
  </p>
  <p>
    People worked this out by surprisingly simple experiments. In the
    1640s, Jan Baptista van Helmont grew a willow in 91 kg of dried soil
    for five years, watering it only. The tree gained 74 kg while the soil
    lost almost nothing — the first hint that a plant's mass does
    <em>not</em> come from the soil (he guessed water; the other partner,
    carbon dioxide, was still unknown). In 1771, Joseph Priestley sealed a
    mouse and a lit candle in a jar: the candle went out, the mouse would
    have died, but a sprig of mint "restored the air". Within a decade, Jan
    Ingenhousz showed the restoration needed <em>light</em>. The pieces
    assembled into an equation: light + water + carbon dioxide &rarr; sugar
    + oxygen.
  </p>
  <Widget no="3" caption="rebuild the evidence chain — willow to equation" widget="order" config={phHistoryOrder} />

  <h2>Limiting factors: the most useful graph in plant science</h2>
  <p>
    Make more of a thing and its rate climbs — up to a point. The curve
    below shows the rate of photosynthesis against light intensity, and it
    teaches the idea of <strong>limiting factors</strong>: whatever
    resource is scarcest sets the rate. In dim light, photons are the
    bottleneck, so the rate climbs steeply with every extra lumen. Then it
    flattens — light is no longer the limit; the supply of carbon dioxide,
    the speed of the enzymes, or the temperature is. Raising the plateau
    lifts the maximum; shifting the bend moves where light stops being the
    constraint.
  </p>

  <Widget no="1" caption="the light response — more light helps, until the machinery itself is the bottleneck" widget="plotter" config={lightCfg} />
  <p>
    <strong>What to notice:</strong> drag the two sliders under the graph. Lowering the
    half-saturation constant k pulls the bend of the curve to the left — the leaf reaches
    its plateau in dimmer light — while raising the maximum rate lifts only the plateau,
    leaving the steep low-light climb untouched. Hover along the curve and mark where it is
    climbing and where it has flattened: the climbing stretch is where light is the limiting
    factor, and the flat stretch is where carbon dioxide, temperature or enzyme speed has
    taken over as the bottleneck.
  </p>

  <p>
    Real leaves sit near this saturation point in full sun — which is why
    commercial greenhouse growers pump in extra CO<sub>2</sub> (about 0.1%,
    versus 0.04% outdoors) and why shade plants differ from sun plants
    mainly in where their curve bends. One classic experiment: an aquatic
    plant in a beaker, counting oxygen bubbles per minute, doubles its
    bubble count as the lamp moves closer — then stops responding no
    matter how bright it gets. The graph, done empirically.
  </p>
  <Widget no="4" caption="call the magnitude — the greenhouse's CO₂ top-up" widget="estimate" config={phGreenhouseEstimate} />

  <Widget no="2" caption="the two equations of life, step by step" widget="equationStep" config={eqCfg} />
  <p>
    <strong>What to notice:</strong> use the step button to reveal the four panels one at a
    time. Watch the arrows: the first equation banks energy (light goes in, sugar comes
    out), the second spends it (sugar goes in, ATP comes out), and they run in opposite
    directions. The third panel names the punchline — the two are near-mirror images — and
    the fourth zooms in on ATP, the rechargeable currency shuttling between chloroplast and
    mitochondrion.
  </p>

  <p>
    Read the two equations in the strip above together and notice they are
    near-mirror images — but with completely different machinery.
    Photosynthesis is an uphill build (energy goes <em>in</em>, from
    light); respiration is a downhill burn (energy comes <em>out</em>, as
    ATP — the cell's energy currency, its spendable coins). No single
    factory could run both in one room, so the cell splits them:
    photosynthesis in chloroplasts, respiration in mitochondria, ATP
    shuttling between like money moving between accounts.
  </p>
  <Widget no="5" caption="uphill build vs downhill burn — drag across the loop" widget="compare" config={phMirrorCompare} />
  <p>
    <strong>So far:</strong> plants bank sunlight as sugar; all living
    things spend that sugar; the two equations mirror each other. Next:
    the leaf — the factory where the banking happens.
  </p>

  <h2>Inside the leaf: structure fitted to the job</h2>
  <p>
    A leaf is a photochemical factory arranged in layers, and each layer is
    optimised for one constraint. The top wears a transparent, waxy
    <strong>cuticle</strong> to stop water escaping while letting light
    through. Beneath it sits the <strong>palisade mesophyll</strong>:
    upright, tightly packed cells crammed with chloroplasts, positioned
    where the light is brightest. Below that, the <strong>spongy
    mesophyll</strong> is loose, with air spaces so carbon dioxide can
    diffuse freely to every photosynthesising cell.
  </p>
  <p>
    The underside's <strong>lower epidermis</strong> is pierced by
    <strong>stomata</strong> — pores that are the leaf's lungs. Each stoma
    is flanked by two curved <strong>guard cells</strong> that swell with
    water to open the pore and sag to close it. Open, the leaf can breathe
    in CO<sub>2</sub>. Closed, it stops losing water in a drought. A
    typical leaf carries 100 or more stomata per square millimetre of
    underside — a deliberate trade of water for carbon.
  </p>
  <p>
    The veins, finally, are the logistics. <strong>Xylem</strong> vessels
    carry water up from the roots — the raw material for photosynthesis,
    and the thing keeping cells turgid. <strong>Phloem</strong> ships the
    finished sucrose away to growing shoots, ripening fruit and
    underground storage. Every layer answers the same three demands —
    light in, CO<sub>2</sub> in, water managed — and a structure like the
    palisade layer, or the stoma-guard pair, is the exam board's favourite
    proof that form follows function.
  </p>
  <Widget no="6" caption="pair each leaf layer with its job" widget="match" config={phLeafMatch} />

  <h2>How photosynthesis actually works</h2>
  <p>
    In words: <code>carbon dioxide + water &rarr; glucose + oxygen</code>,
    with light and chlorophyll doing the driving. In balanced symbols:
    6CO<sub>2</sub> + 6H<sub>2</sub>O &rarr; C<sub>6</sub>H<sub>12</sub>O<sub>6</sub>
    + 6O<sub>2</sub>. It runs in two stages. In the <strong>light-dependent
    stage</strong>, chlorophyll in the internal membranes absorbs photons
    and the energy rips water molecules apart — the oxygen you are
    breathing right now is this step's waste product. The captured energy
    is banked as ATP and a hydrogen-carrier called NADPH. In the
    <strong>light-independent stage</strong> (the Calvin cycle), that
    banked energy powers the fixing of CO<sub>2</sub> onto a five-carbon
    sugar, which is rebuilt and stripped of carbon atoms until glucose
    emerges. Crucially, the second stage needs the first stage's products,
    but not the light itself.
  </p>
  <Widget no="7" caption="fill the blanks — the two stages" widget="cloze" config={phStagesCloze} />
  <p><em>Common misconception:</em> the oxygen a plant releases comes from the carbon dioxide it takes in. Isotope-tracing experiments showed the evolved O<sub>2</sub> comes from splitting water in the light-dependent stage; the CO<sub>2</sub>'s oxygen atoms end up in the sugar and the water made. The atmosphere's oxygen is the exhaust of water-splitting, not of breathing CO<sub>2</sub> in and O<sub>2</sub> out.</p>
  <p>
    Temperature plays the role students least expect: photosynthesis is
    enzyme chemistry, so its rate rises with warmth to an optimum (around
    25–35 °C for most crops) and then <em>collapses</em> as the enzymes
    denature. Light, CO<sub>2</sub> and temperature — three dials, any one
    of which can be the limiting factor at any moment; the art of the
    greenhouse is knowing which dial is currently the binding one. One
    curiosity explains the colour of everything green: chlorophyll
    absorbs red and blue light hardest and reflects green, so the garden's
    colour is literally sunlight's leftovers.
  </p>
  <p><em>Common misconception:</em> plants do not respire "instead of" photosynthesising, and
  their mass does not come from the soil. Every living plant cell respires all day and all
  night; photosynthesis simply out-earns that spending in daylight. And a tree's bulk is built
  overwhelmingly from carbon pulled out of the air as CO<sub>2</sub> (plus water), not from dirt — van
  Helmont's willow proved the soil contributes almost nothing, even though he could not yet
  explain where the carbon came from.</p>

  <h2>Respiration: cashing in the sugar</h2>
  <p>
    Respiration is <em>not</em> breathing — breathing merely delivers
    oxygen. Respiration is the chemical process in every one of your cells
    that releases energy from food. In words:
    <code>glucose + oxygen &rarr; carbon dioxide + water + energy</code>.
    Because it needs oxygen it is called <strong>aerobic
    respiration</strong>, and because it runs at about 37 °C through
    thousands of gentle enzyme steps, it is combustion with the fire
    removed — the same overall reaction as burning sugar in a flame, but
    the energy is captured in small, spendable increments as ATP instead
    of being wasted as one burst of heat and light.
  </p>
  <p>
    What is the energy <em>for</em>? Building molecules (proteins, new
    membranes), muscle contraction, active transport pumping ions across
    membranes, nerve signalling, and cell division. Your brain, about 2% of
    your body weight, respires roughly 20% of your resting energy. ATP is
    the interface: think of photosynthesis as income, respiration as salary
    day, and ATP as the currency every single purchase is made in — your
    body recycles roughly its own weight of ATP molecules every day,
    recharging and spending them in continuous cycles.
  </p>
  <Widget no="8" caption="call the magnitude — the brain's energy bill" widget="estimate" config={phBrainEstimate} />
  <p>
    <strong>So far:</strong> the leaf banks sunlight as sugar, and every
    living cell cashes that sugar in through respiration, ATP being the
    currency both ends deal in. Next: what happens when the oxygen runs
    out.
  </p>

  <h2>Without oxygen: anaerobic respiration</h2>
  <p>
    Sprint for the bus and your muscles outrun your lungs: oxygen delivery
    cannot match demand. Muscle cells switch to <strong>anaerobic
    respiration</strong>: <code>glucose &rarr; lactic acid + energy</code>.
    It is an emergency measure for two reasons. It releases far less energy
    per glucose (about 2 ATP, versus roughly 30 aerobically). And the
    lactic acid accumulates, lowering pH and contributing to the ache in
    your thighs. Worse, the lactic acid must later be broken down
    <em>aerobically</em>, mostly in the liver — which is why you keep
    panting hard for minutes after stopping. That repayment is the
    <strong>oxygen debt</strong>: your elevated breathing after the race is
    not recovery theatre, it is the bill.
  </p>
  <p>
    Other organisms run the anaerobic route differently, and civilisation
    runs on the difference. Yeast performs <code>glucose &rarr; ethanol +
    carbon dioxide + energy</code> — fermentation — which gives beer and
    wine their alcohol and bread its rising (the CO<sub>2</sub> puffs the
    dough; the ethanol evaporates in baking). Bacteria fermenting milk
    sugar produce the lactic acid that turns milk into yogurt and cheese.
    Any deep, oxygen-free mud, cow rumen or landfill produces methane for
    the same reason. One chemistry, three industries.
  </p>
  <Widget no="9" caption="file the fermenters by their product" widget="sort-buckets" config={phFermentBuckets} />
  <p><em>Common misconception:</em> human muscles make alcohol when they run out of oxygen. The anaerobic route branches: yeast reduces pyruvate to ethanol and CO<sub>2</sub>, while human muscle converts it to lactic acid — the same emergency logic, different enzymes, different product. No sprint, however desperate, brews beer in your legs.</p>

  <h2>Seeing photosynthesis happen: the classic experiments</h2>
  <p>
    Photosynthesis is invisible, so biologists designed tests that make it
    legible. The classic is the <strong>starch test</strong>: boil a leaf
    in ethanol to strip its chlorophyll, rinse, then flood it with iodine —
    blue-black means starch stored, which is the leaf's banked
    photosynthesis (glucose is converted to insoluble starch for storage).
    Destarch a plant in the dark for 48 hours first, and the iodine becomes
    an honest meter: anything that turns black afterwards was
    <em>made</em> during the experiment.
  </p>
  <p>
    Now the controls, one question each. Cover part of a leaf with foil,
    and only the uncovered half goes black — light is necessary. Put a leaf
    in a sealed jar with soda-lime (which scrubs CO<sub>2</sub> from the
    air), and it stays amber — carbon dioxide is necessary. Take a
    variegated leaf (white patches, no chlorophyll), and it goes black only
    where it was green — chlorophyll is necessary. Three controls, three
    conclusions: this is the experimental logic the syllabus wants you to
    be able to design, not just recite. Counting oxygen bubbles from
    pondweed — the thought experiment behind the first graph — is the same
    idea measuring <em>rate</em> rather than presence.
  </p>
  <Widget no="10" caption="find the faulty line — the controls answer" widget="spot-error" config={phControlSpot} />

  <h2>Check yourself</h2>
  <p>Try these before moving on. The answers are right below.</p>
  <ol>
    <li>State the equation for aerobic respiration, in words.</li>
    <li>A pondweed stops making bubbles when the lamp is moved away, but adding more light does nothing. What is now the limiting factor, and what could you change to raise the rate?</li>
    <li>Why do you keep breathing hard minutes after you stop sprinting?</li>
  </ol>
  <p>
    <strong>Answers:</strong> (1) Glucose + oxygen &rarr; carbon dioxide +
    water + energy (released in the cells as ATP). (2) Something else is
    now limiting — most likely carbon dioxide or temperature; raise that
    dial (add CO<sub>2</sub> or warmth) and the rate rises. (3) Your
    muscles ran anaerobically and built up lactic acid, which must now be
    broken down using extra oxygen — the oxygen debt.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>Photosynthesis banks sunlight as sugar: carbon dioxide + water &rarr; glucose + oxygen, inside chloroplasts.</li>
    <li>Aerobic respiration spends that sugar: glucose + oxygen &rarr; carbon dioxide + water + ATP, inside mitochondria.</li>
    <li>The two equations are near-mirror images, and ATP is the currency that carries energy between them.</li>
    <li>Light, carbon dioxide and temperature are the three limiting factors — whichever is scarcest sets the rate.</li>
    <li>Leaf structure fits function: palisade cells catch light, air spaces spread CO<sub>2</sub>, guard cells trade water for carbon at the stomata.</li>
    <li>Without oxygen, cells fall back on anaerobic respiration — lactic acid in muscle, ethanol in yeast — at a fraction of the energy yield.</li>
    <li>The oxygen you breathe comes from splitting water in the light-dependent stage, not from the carbon dioxide taken in.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    The loop you have just followed runs through the rest of this Biology track: cell
    structure shows the chloroplasts and mitochondria doing the work, biological molecules
    traces what glucose is built into, and ecology scales the sugar-making loop up to whole
    ecosystems. Human body systems picks up the spending half — how your lungs and blood
    deliver the oxygen that muscle cells burn glucose with.
  </p>

  <h2>Going deeper</h2>
  <p>
    The two processes also tangle at dusk. As light fades, a plant's
    photosynthesis rate slides down toward its respiration rate; the
    <strong>compensation point</strong> is where the two are exactly equal
    — the leaf earns what it spends. Below it (night, deep shade), the
    plant is a net consumer of oxygen, which is why keeping plants in a
    sealed bedroom is undramatically harmless: one houseplant's night-time
    respiration is trivial beside yours. Scale the loop up, though, and it
    runs the planet: land plants and ocean plankton fix roughly 120 billion
    tonnes of carbon into sugar every year, and about 2.4 billion years ago
    their cyanobacterial ancestors pumped so much oxygen into the sky (the
    Great Oxidation Event) that they poisoned most anaerobic life — and
    rusted the oceans' iron into the banded iron formations we now mine.
    The oxygen in your next breath is, quite literally, photosynthesis
    waste with two billion years of provenance.
  </p>
  <p>
    There are refinements to the basic design, too. Photosynthesis's
    CO<sub>2</sub>-grabbing enzyme works inefficiently when it is hot and
    CO<sub>2</sub> is scarce, accidentally grabbing oxygen instead —
    <em>photorespiration</em>, a costly mistake. Maize, sugarcane and many
    grasses pre-concentrate CO<sub>2</sub> in special cells first (the C4
    pathway); desert cacti go further, opening their stomata only at night
    and storing the CO<sub>2</sub> as an acid until daylight (CAM
    photosynthesis). And at the frontier, researchers are re-engineering
    photosynthesis itself: synthetic biologists have rebuilt the Calvin
    cycle's bottleneck enzymes in the lab and trialled C4-style rice,
    hoping to push yields up in a warming, CO<sub>2</sub>-rich century. The
    two equations in the strip above look settled; the machinery inside
    them is still being tuned — by evolution, and now by us.
  </p>
  <p class="sources"><strong>Sources:</strong> Priestley (1771) and Ingenhousz (1779) experiments; OpenStax, <em>Biology 2e</em> (Photosynthesis; Cellular Respiration); Campbell, <em>Biology</em>; Cambridge IGCSE Biology 0615 syllabus, sections 6.1–6.2 and 12.1–12.3. Source text: OpenStax (https://openstax.org), CC BY 4.0 — adapted for Interactive Atlas.</p>
</TopicPage>
