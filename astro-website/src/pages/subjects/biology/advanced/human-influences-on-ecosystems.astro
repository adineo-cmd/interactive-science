  curves: [
    { expr: '9 - B*(exp(-0.04*x) - exp(-0.2*x))', label: 'dissolved oxygen downstream', color: '#1d4ed8', width: 2.4 },
    { expr: '5 + 0*x', label: '≈5 mg/L: many fish stressed', color: '#b42318', width: 1 },
  ],
  params: [
    { name: 'B', label: 'pollution load', min: 2, max: 14, step: 1, value: 10, unit: 'mg/L deficit' },
  ],
  x: { min: 0, max: 60, label: 'distance downstream from outfall (km)' },
  y: { min: 0, max: 10, label: 'dissolved oxygen (mg/L)' },
  crossings: false,
  height: 340,
};

const timelineCfg = {
  unit: 'year',
  events: [
    { year: 1962, title: 'Silent Spring', text: 'Rachel Carson\'s book documents the damage pesticides cause through food chains — often credited with launching the modern environmental movement.', tag: 'pollution' },
    { year: 1972, title: 'Stockholm Conference', text: 'The first UN conference on the human environment; the UN Environment Programme (UNEP) is founded the same year.', tag: 'pollution' },
    { year: 1973, title: 'CITES signed', text: 'The Convention on International Trade in Endangered Species regulates cross-border trade in wild animals and plants.', tag: 'biodiversity' },
    { year: 1985, title: 'Antarctic ozone hole reported', text: 'Farman, Gardiner and Shanklin publish measurements of severe springtime ozone depletion over Antarctica in Nature.', tag: 'pollution' },
    { year: 1987, title: 'Montreal Protocol', text: 'Nations agree to phase out CFCs — the pollutants behind ozone loss; eventually ratified by every UN member state.', tag: 'pollution' },
    { year: 1992, title: 'Rio Earth Summit', text: 'The Convention on Biological Diversity opens for signature at Rio; conservation gets its first global treaty framework.', tag: 'biodiversity' },
