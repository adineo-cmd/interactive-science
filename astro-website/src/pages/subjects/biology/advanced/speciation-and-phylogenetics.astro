---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const specCfg = {
  steps: [
    { math: '1 · Isolation begins', note: 'A population splits — a river rises, an island forms, a subset migrates. Gene flow between the halves stops.' },
    { math: '2 · Divergence accumulates', note: 'Mutations, selection and drift push the populations apart independently. Different environments pull hardest (Darwin\'s finches: beaks matching each island\'s seeds).' },
    { math: '3 · Reproductive isolation locks it in', note: 'Mating preferences, timing or genetics diverge until interbreeding fails or produces sterile offspring (mules). Two species now — by the standard biological definition.' },
    { math: '4 · Ring species show it live', note: 'Salamanders around California\'s Central Valley interbreed with neighbours all the way round — except where the ends meet. Speciation caught mid-process.' },
  ],
};

const clockCfg = {
  title: 'Worked example: dating a split with a molecular clock',
  steps: [
    { math: 'human vs chimp genomes: ~1.2% of sites differ', note: 'aligned orthologous sequence, excluding patchy regions.' },
    { math: 'total divergence d = 2·r·T', note: 'both lineages accumulate substitutions independently since the split — hence the factor 2.' },
    { math: 'calibrate with fossils: T ≈ 7 million years', note: 'fossil hominins (Sahelanthropus, ~7 Myr) set the anchor; the clock is only as good as its calibration.' },
    { math: 'r = d / 2T = 0.012 / (2 × 7 × 10⁶) ≈ 8.6 × 10⁻¹⁰ per site per year', note: 'the neutral substitution rate — the clock speed for this lineage.' },
    { math: 'predict: human–orangutan T ≈ 14 Myr → d ≈ 2.4%', note: 'observed: ~2.5–3%. Close — the residuals are real biology (rate variation, ancestral polymorphism), not clock failure.' },
  ],
};

const spMuleSpot = {
  "prompt": "This hybrid-sterility answer contains one faulty line — click it:",
  "lines": [
    "A horse has 64 chromosomes; a donkey has 62.",
    "Their offspring, the mule, carries 63.",
    "At meiosis, the odd number leaves chromosomes without matching partners.",
    "Meiosis fails, so the mule is sterile.",
    "Because the failure happens after fertilisation, this is a prezygotic barrier.",
    "Hybrid breakdown goes further: a fertile first generation, failing grandchildren."
  ],
  "errorLine": 4,
  "correction": "After fertilisation means POSTzygotic — prezygotic barriers act before fertilisation.",
  "why": "Postzygotic barriers waste hybrids after they form: inviability, sterility (the mule), breakdown. Prezygotic barriers — temporal, behavioural, mechanical, gametic — stop fertilisation from ever happening."
};

const spGeoMatch = {
  "prompt": "Four textbook cases, three routes — pair them:",
  "pairs": [
    {
      "left": "a canyon, a river or an archipelago cuts gene flow",
      "right": "allopatric speciation"
    },
    {
      "left": "Hawaii's thousand-plus Drosophila species from a few founders",
      "right": "allopatric speciation"
    },
    {
      "left": "apple maggot host races mating on their own fruit in the same orchard",
      "right": "sympatric speciation"
    },
    {
      "left": "a meiosis accident doubles the chromosome set; the tetraploid selfs",
      "right": "polyploidy — the plant shortcut"
    }
  ],
  "why": "Allopatric is the workhorse; sympatric needs assortative mating to beat gene flow; polyploidy skips the waiting entirely — bread wheat is hexaploid, 2n = 42 from three ancestral genomes."
};

const spCladeJudge = {
  "statements": [
    {
      "s": "A clade is an ancestor and all of its descendants.",
      "truth": true,
      "why": "The monophyletic group — the only grouping cladistics trusts."
    },
    {
      "s": "Shared ancestral traits, like backbones in mammals and fish, indicate common ancestry of those two groups.",
      "truth": false,
      "why": "Backbones predate both — ancestral traits indicate nothing about grouping; only shared derived traits (synapomorphies) mark a branching."
    },
    {
      "s": "'Reptiles' fail as a clade because they exclude birds.",
      "truth": true,
      "why": "Drop the descendants and you lose the monophyly — which is why 'birds are dinosaurs' is a cladistic statement."
    },
    {
      "s": "Long-branch attraction and incomplete lineage sorting are known artefacts that can mislead trees.",
      "truth": true,
      "why": "Trees are hypotheses — fast-evolving lineages misgroup, and gene trees can disagree with species trees."
    }
  ]
};

const spNeanderEstimate = {
  "prompt": "Ancient DNA shows our ancestors mixed with Neanderthals. Roughly what percentage of a non-African human genome is Neanderthal DNA?",
  "unit": "%",
  "answer": 2,
  "factor": 1.8,
  "why": "~2% — introgression caught across a species boundary, alongside Denisovan mixing in the same genomes.",
  "context": "Trees are real, reticulation is real — and the two are quantitatively separable."
};

const spChimpPredict = {
  "q": "Which statement does the phylogenetic tree actually support?",
  "choices": [
    "Humans evolved from chimpanzees",
    "Humans and chimpanzees share a common ancestor that lived roughly 6–7 million years ago",
    "Chimpanzees stopped evolving while humans kept progressing"
  ],
  "answer": 1,
  "why": "A living relative is a cousin, not a grandparent: both lineages have been evolving since the split, so chimpanzees carry six million years of their own history — the tree has no top rung."
};

const spFinchOrder = {
  "prompt": "1977, measured microevolution — put the season in order:",
  "items": [
    "The 1977 drought on Daphne Major kills ~85% of the medium ground finches",
    "The surviving seeds are hard — only large-billed birds can crack them",
    "The breeder's equation R = h²S sets up the prediction (h² ≈ 0.7)",
    "The next generation's mean bill comes out ~4% deeper, as the equation demanded",
    "Wet years reverse the selection and the mean swings back",
    "Forty years of measurement: bill size tracks seed hardness season by season"
  ],
  "why": "Speciation on a weather record: measured selection, heritability h² ≈ 0.7, and a radiation whose endpoint — thirteen species — is isolated mostly by song learned from the father."
};

const spFossilCompare = {
  "prompt": "Eldredge and Gould, 1972 — drag the divider across the fossil record:",
  "before": {
    "label": "stasis",
    "text": "Morphological stability over millions of years — the species holds its shape bed after bed."
  },
  "after": {
    "label": "punctuation",
    "text": "Geologically abrupt appearances of descendant species, mostly in small peripheral populations whose transitions the record rarely catches."
  },
  "why": "Four decades of data resolved the debate as a question of rates: both anagenesis and cladogenesis occur, the branching mode dominates, and the apparent gaps are partly the geometry of speciation — small, fast, local."
};

const spAppliedBranch = {
  "root": "A genome lands on your desk — a pathogen, a rare mammal, a shipment of timber, a medicinal plant. The tree is a working tool. Choose an application.",
  "nodes": {
    "start": {
      "text": "Which job do you send the tree to do?",
      "choices": [
        {
          "label": "Track an outbreak's origin and spread",
          "next": "epi",
          "feedback": "Sequenced samples fed a living tree (PANGO lineages) for every COVID variant of concern."
        },
        {
          "label": "Rank threatened species for conservation",
          "next": "edge",
          "feedback": "EDGE scores rank species by evolutionary distinctiveness."
        },
        {
          "label": "Prosecute a timber or ivory shipment",
          "next": "forensic",
          "feedback": "DNA signatures match the goods to source populations."
        },
        {
          "label": "Find the next antibiotic",
          "next": "med",
          "feedback": "Screen the relatives of species that already made one."
        }
      ]
    },
    "epi": {
      "text": "Origin and spread tracked within weeks — the same pipeline traced Ebola's re-ignitions and polio's export chains."
    },
    "edge": {
      "text": "Losing the aye-aye — its own branch for ~60 million years — costs more tree than losing another rodent; the logic sets zoo and seed-bank priorities."
    },
    "forensic": {
      "text": "Phylogeography into prosecutions — forensics from branch tips."
    },
    "med": {
      "text": "Phylogenetic autocorrelation of biochemistry — the search starts in the genus that already made an antibiotic."
    }
  },
  "why": "One reconstruction, four payoffs: epidemiology, conservation, forensics and medicine all borrow the same branching history."
};
---
<TopicPage slug="subjects/biology/advanced/speciation-and-phylogenetics">
  <h2>Where you are, and what you will learn</h2>
  <p>
    This is an advanced Biology lesson. It assumes the foundational lessons <em>DNA and
    Heredity</em>, <em>Evolution and Natural Selection</em> and <em>Classification: The Tree
    of Life</em>, plus the intermediate <em>Genetics: Inheritance Patterns</em> — you should
    already read allele frequencies, selection differentials and hierarchical classification.
    This page adds the two things those courses stopped short of: how one lineage becomes
    two, and how the whole branching history is reconstructed from sequence data.
  </p>
  <p>By the end you will be able to:</p>
  <ul>
    <li>define a species under the biological species concept, and say what the definition buys and where it fails;</li>
    <li>catalogue prezygotic and postzygotic isolating barriers, and explain reinforcement;</li>
    <li>contrast allopatric, sympatric and polyploid speciation, with the recorded cases for each;</li>
    <li>read a cladogram: synapomorphies, clades, and the known artefacts that mislead trees;</li>
    <li>run a molecular-clock argument — calibrate on fossils, predict a split date, interpret the residuals.</li>
  </ul>

  <h2>The idea</h2>
  <p>
    The selection lesson explained how populations change; speciation is the step beyond —
    <strong>one lineage becoming two</strong>, the branching event that fills the tree of
    life. The definition does the dividing: under the standard <em>biological species
    concept</em> (Mayr), a species is a group of actually or potentially interbreeding
    natural populations, reproductively isolated from other such groups. Notice what the
    definition buys: it makes species real biological units rather than human labels, and
    it makes speciation a definite process — the evolution of reproductive isolation. It
    also has honest limits (it says nothing about fossils or asexual lineages, which is
    why the Going-deeper section carries rival concepts). Phylogenetics is the
    reconstruction half of the subject: reading the tree — who split from whom, in what
    order, roughly when — from DNA sequences, morphology and fossils together. The two
    halves interlock: every speciation event is a node on the tree, and the tree is the
    branching record the species definition implies.
  </p>
  <p>
    The sequence to hold in mind (the widget walks it): isolation, divergence,
    reproductive isolation, lock-in. Each stage has its own mechanism and its own
    measurable signature, and organisms caught at every intermediate stage exist in
    nature — which is why speciation, once accused of being unobservable, is now among
    the best-documented processes in evolution.
  </p>

  <Widget no="1" caption="the four-step speciation sequence — and the ring species caught in the act" widget="equationStep" config={specCfg} />
  <p>
    <strong>What to notice:</strong> the four steps are a ratchet, and each one removes a way
    back. Step 1 is geography or circumstance cutting gene flow; step 2 is the two halves
    drifting and being pulled apart by different selection; step 3 is the point of no return —
    mating itself fails; and step 4 is the live demonstration, a ring of salamanders among
    which you can walk from one species to the other without ever leaving a continuous
    population.
  </p>
  <p>
    <strong>So far:</strong> speciation is a sequence with a definite endpoint — reproductive
    isolation — and organisms exist at every intermediate stage. The next section catalogues
    the barriers stage by stage, from mating seasons to sterile mules.
  </p>

  <h2>Reproductive isolation: the mechanisms, catalogue and all</h2>
  <p>
    Isolating mechanisms divide by <em>when</em> they block gene flow.
    <strong>Prezygotic</strong> barriers act before fertilisation: <em>temporal</em>
    (the apple maggot fly, which switched from hawthorn to introduced apples in the
    1800s, now mates on its host fruit's season — the two host races emerge weeks apart
    in the same orchards); <em>behavioural</em> (fireflies' species-specific flash
    patterns; birds' songs — song dialects alone can isolate island populations);
    <em>mechanical</em> (lock-and-key genitalia in insects); <em>gametic</em> (sperm and
    egg surface proteins incompatible — in broadcast-spawning corals and sea urchins,
    this is nearly the only barrier available, and it works).
    <strong>Postzygotic</strong> barriers act after: hybrid inviability (lethal
    development), hybrid sterility (the mule — horse 64 chromosomes, donkey 62, offspring
    63, meiosis fails), and hybrid breakdown (fertile first generation, failing
    grandchildren). Crucially, selection <em>strengthens</em> prezygotic barriers
    whenever hybrids are wasted effort — the pattern called <strong>reinforcement</strong>,
    observed in frog populations whose ranges overlap. Divergence usually begins
    incidentally; the isolating machinery is assembled from ordinary mutations — a
    shifted breeding season, an altered pheromone, one chromosome fusion (human
    chromosome 2 is two ape chromosomes fused, a postzygotic wall between us and every
    other ape).
  </p>
  <Widget no="3" caption="find the faulty line — the mule answer" widget="spot-error" config={spMuleSpot} />

  <h2>Geography of speciation: allopatric, sympatric, and the plant shortcut</h2>
  <p>
    <strong>Allopatric</strong> speciation — populations separated by geography — is the
    workhorse: a canyon, a river, an archipelago. Islands are speciation machines
    precisely because they isolate repeatedly; Hawaii's <em>Drosophila</em> (a thousand-
    plus species from a few founders) and Galápagos finches are the textbook cases, the
    finches' <strong>adaptive radiation</strong> traced bill-by-bill by the Grants over
    forty years of measured selection. The speed record belongs to Lake Victoria's
    cichlids: roughly 500 species, adapted to every feeding niche in the lake, from a
    common ancestor within the last ~15,000 years — rapid enough that speciation can be
    watched. <strong>Sympatric</strong> speciation — divergence within one range — needs
    assortative mating to overcome gene flow, and the host-switching apple maggots and
    certain fish pairs in the same lake qualify as the accepted examples. Plants add a
    shortcut no animal can take: <strong>polyploidy</strong>. A meiosis accident doubles
    the chromosome set, the new tetraploid cannot back-cross with its parent (triploid
    blocks), yet can found a population by selfing — speciation in <em>one generation</em>.
    Bread wheat is a double polyploid (hexaploid, 2n = 42 from three ancestral genomes),
    and by some estimates three-quarters of flowering plant species descend from
    polyploid events. It is why botanists use the word "webbed" for the plant tree of
    life.
  </p>
  <Widget no="4" caption="pair each case with its geography of speciation" widget="match" config={spGeoMatch} />
  <p>
    <em>Common misconception:</em> a species "decides" to evolve, or an individual
    evolves. Populations evolve; speciation is a population-level branching, not an
    individual transformation. Also commonly garbled: that the ring species widget means
    "salamanders become a circle" — the point is subtler. Along California's Central
    Valley, adjacent <em>Ensatina</em> populations interbreed around the ring, but the
    two ends, meeting in the south, behave as distinct species. Gene flow is continuous
    everywhere except between the endpoints — a gradient of divergence you can walk,
    with the species boundary emerging where the gene flow stops.
  </p>
  <p>
    <strong>So far:</strong> barriers build the wall, and geography decides how often the
    wall gets built — with polyploidy the plant shortcut that skips the waiting entirely.
    The next section reverses the direction of inquiry: given the species we observe, how do
    we reconstruct the branchings that produced them?
  </p>

  <h2>Phylogenetics: reconstructing the tree</h2>
  <p>
    The tree is inferred from <strong>characters</strong> — nowadays overwhelmingly DNA
    positions — using <strong>cladistics</strong>: group taxa by shared
    <em>derived</em> traits (synapomorphies), which alone indicate common ancestry;
    shared ancestral traits (mammals have backbones with fish) indicate nothing about
    grouping. Methods range from parsimony (prefer the tree needing fewest evolutionary
    changes) to maximum likelihood and Bayesian approaches, which model substitution
    probabilities explicitly. The vocabulary matters professionally: a
    <strong>clade</strong> (monophyletic group) is an ancestor and <em>all</em> its
    descendants — "birds are dinosaurs" is a cladistic statement, and "reptiles" fail as
    a clade because they exclude birds. Trees are hypotheses, and specific artefacts are
    known: <strong>long-branch attraction</strong> (fast-evolving lineages misgroup),
    <strong>incomplete lineage sorting</strong> (gene trees disagree with species trees
    because ancestral variation survived a split), and <strong>horizontal gene
    transfer</strong> (bacteria exchange genes sideways promiscuously — Darwin's last
    universal common ancestor is better drawn as a web than a trunk).
  </p>
  <Widget no="5" caption="true or false — reading the tree" widget="judge" config={spCladeJudge} />
  <p><em>Common misconception:</em> evolution is a ladder of progress — "primitive" species below, "advanced" ones above, humans on the top rung. The tree has no top: every living lineage has been evolving for exactly as long as every other, and a bacterium is not an earlier draft of an animal but a four-billion-year success on its own terms. Cladistics encodes the correction formally — groups are defined by shared ancestry, not rank — which is why "birds are dinosaurs" is a factual statement rather than an insult.</p>
  <p>
    Branch <em>lengths</em> come from the <strong>molecular clock</strong>: most
    mutations are neutral (Kimura), so substitutions accumulate at roughly the mutation
    rate — approximately steadily, with caveats the worked example makes concrete:
  </p>

  <Widget no="2" caption="the molecular clock, run forward and backward — calibrate on fossils, predict on the unknown, check the residuals" widget="equationStep" config={clockCfg} />
  <p>
    <strong>What to notice:</strong> the worked example is honest about its own machinery.
    The factor of 2 in step 2 exists because both lineages accumulate substitutions since the
    split — a detail exam answers routinely lose. Step 3 is the load-bearing move: the clock
    has no absolute speed until fossils anchor it, and step 5 shows the right way to treat
    error — the human–orangutan residual is interpreted as biology, not waved away as clock
    failure.
  </p>

  <p>
    Hybridisation blurs the picture at the edges without dissolving it: grizzly–polar
    bear hybrids (grolars) occur as Arctic ranges overlap; domestic dogs, coyotes and
    wolves interbreed; and ancient DNA shows our own ancestors mixed with Neanderthals
    (~2% of non-African genomes) and Denisovans. The modern synthesis: trees are real,
    reticulation is real, and the two are quantitatively separable.
  </p>
  <Widget no="6" caption="call the magnitude — the Neanderthal share" widget="estimate" config={spNeanderEstimate} />
  <p><em>Common misconception:</em> humans evolved "from chimpanzees" — or from any living ape. The tree says otherwise: humans and chimpanzees share a common ancestor (the clock above dates the split to roughly 6–7 million years), and both lineages have been evolving since. A living relative is a cousin, not a grandparent — which is why chimpanzees are not "stopped early" or primitive, but our branch's contemporaries with six million years of their own history.</p>
  <Widget no="7" caption="bet first — what does the tree actually say?" widget="predict" config={spChimpPredict} />

  <h2>Adaptive radiation up close: the finch arithmetic</h2>
  <p>
    The Galápagos finches turned radiation into a measured dataset. Bill depth is
    heritable (h² ≈ 0.7 — parents with deep bills have deep-billed offspring), so the
    breeder's equation R = h²S predicts each generation's shift from the selection
    differential S. The 1977 drought on Daphne Major killed about 85% of the medium
    ground finches, sparing large-billed birds that could crack the surviving hard
    seeds — and the next generation's mean bill came out roughly 4% deeper, just as the
    equation demanded. When wet years reversed the selection, the mean swung back.
    Forty years of such measurements showed bill size tracking seed hardness season by
    season — microevolution measured continuously — while the different islands,
    pulling different diets, drifted their populations onto separate trajectories. The
    radiation's endpoint: thirteen species, reproductively isolated mostly by
    <em>song</em> (learned from the father, so a mis-imprinted young male can found a
    new lineage — hybridisation and reinforcement documented as they happened in
    1983's immigrant finch "Big Bird"). Speciation is not a thought experiment; on
    Daphne Major it is a weather record.
  </p>
  <Widget no="8" caption="rebuild the drought season on Daphne Major" widget="order" config={spFinchOrder} />

  <h2>The fossil signature: stasis and punctuation</h2>
  <p>
    What does speciation look like in rocks? Eldredge and Gould's <strong>punctuated
    equilibrium</strong> (1972) read the record literally: species show long
    <em>stasis</em> — morphological stability over millions of years — punctuated by
    geologically abrupt appearances of descendant species, usually confined to small,
    peripheral populations whose transitions the fossil record rarely catches. The
    pattern is what the modern view predicts once you separate two processes: anagenesis
    (gradual change within a lineage) and cladogenesis (branching), where most
    morphological change concentrates in the branching events themselves. The 1970s
    debate framed it as gradualism versus jumps; four decades of data resolved it as a
    question of rates: <em>both</em> occur, the branching mode dominates, and the
    apparent "gaps" in the record are partly the geometry of speciation (small,
    fast, local) rather than missing evidence. Fine-scale sequences — forams, trilobites,
    bryozoans — now document transitions bed by bed, and planktonic microfossils
    (diatom lineages in ocean cores) have delivered branchings dated and described layer
    by layer. The independent corroboration is nested: every new genome lands in the
    tree where the older evidence said it must — the signature of a reconstruction that
    tracks real history rather than resemblance.
  </p>
  <Widget no="9" caption="stasis, then punctuation — drag across the record" widget="compare" config={spFossilCompare} />
  <p>
    <strong>So far:</strong> the record agrees with itself — the finches' measured selection,
    the clock's calibrated dates and the fossils' stasis-and-punctuation pattern describe one
    history from three independent directions. The final core section shows what that
    reconstruction is worth outside the seminar room.
  </p>

  <h2>Why it pays: phylogenetics as an applied science</h2>
  <p>
    The tree is a working tool. <strong>Epidemiology:</strong> every COVID variant of
    concern was a phylogenetic classification — samples sequenced worldwide fed a living
    tree (PANGO lineages) that tracked each variant's origin and spread within weeks;
    the same pipeline traced Ebola's re-ignitions and polio's export chains.
    <strong>Conservation:</strong> EDGE scores rank species by evolutionary
    distinctiveness — losing the aye-aye (its own branch for ~60 million years) costs
    more tree than losing another rodent; the same logic sets zoo and seed-bank
    priorities. <strong>Forensics:</strong> timber and ivory are matched to source
    populations by their DNA signatures, turning phylogeography into prosecutions.
    <strong>Medicine:</strong> relatives of known medicinal species are screened first
    (phylogenetic autocorrelation of biochemistry), which is why the search for new
    antibiotics starts in the genus that already made one.
  </p>
  <Widget no="10" caption="spend one tree four ways" widget="branch" config={spAppliedBranch} />

  <h2>Check yourself</h2>
  <p>Try these before moving on. Feedback follows each answer.</p>
  <ol>
    <li>Recall: give one prezygotic and one postzygotic isolating barrier, and say at what point in the reproductive process each acts.</li>
    <li>Application: a meiosis accident doubles a plant's chromosome set, producing a healthy tetraploid individual in a diploid population. Explain why it is instantly reproductively isolated, and what this implies about how fast plant speciation can be.</li>
    <li>Why do shared ancestral traits (mammals have backbones, so do fish) indicate nothing about which groups belong together on a tree?</li>
  </ol>
  <p>
    <strong>Feedback:</strong> (1) Prezygotic acts before fertilisation — for example
    behavioural isolation, fireflies' species-specific flash patterns, or the apple maggot
    flies' shifted mating seasons; postzygotic acts after — the mule, sterile because horse
    and donkey chromosome numbers leave meiosis failing at 63. (2) The tetraploid cannot
    back-cross with the diploid parent population because triplet chromosome sets make the
    triploid offspring sterile — yet it can self or mate with its own kind, founding a new
    population. Speciation in one generation: no geographic isolation required, which is why
    so much of the plant tree of life is webbed by polyploid events. (3) Ancestral traits are
    shared because they were inherited from ancestors far older than either group — backbones
    predate mammals and fish alike, so having one groups you with everything from sharks to
    snakes. Only shared <em>derived</em> traits mark a branching event that defines a clade,
    which is why cladistics groups by synapomorphies.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>Under the biological species concept, speciation is the evolution of reproductive isolation — a population-level branching, never an individual transformation.</li>
    <li>Prezygotic barriers act before fertilisation; postzygotic barriers waste hybrids after — and reinforcement strengthens the former when hybrids cost.</li>
    <li>Allopatric isolation is the workhorse; sympatric cases exist; polyploidy gives plants speciation in a single generation.</li>
    <li>Cladistics groups by shared derived traits; "birds are dinosaurs" is a cladistic statement, and "reptiles" fail as a clade.</li>
    <li>Molecular clocks are calibrated, not absolute: the factor of 2 counts both lineages, and residuals are biology to interpret.</li>
    <li>The fossil record shows stasis punctuated by branching; the geometry of speciation explains part of the apparent gaps.</li>
    <li>The tree is a working tool — variant tracking, EDGE conservation scores, timber forensics, drug screening.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    The advanced siblings continue the story: <em>Population Genetics</em> supplies the
    allele-frequency machinery this page assumed — and the coalescent statistics the section
    ahead of you introduces — while <em>Molecular Biology Techniques</em> shows the sequencing
    methods that turn organisms into the aligned data every tree here was built from.
  </p>

  <h2>Going deeper</h2>
  <p>
    <strong>The coalescent.</strong> Phylogenetics reads the tree of lineages forward in
    time; coalescent theory runs it backward — tracing the genealogies of gene copies
    present <em>today</em> to their most recent common ancestor. It explains at once why
    small populations show short, tangled internal branches, why human mitochondrial Eve
    (~150,000 years ago) and Y-chromosome Adam need not have met, and why gene trees
    within one species predate the species split (incomplete lineage sorting, again, now
    as arithmetic rather than embarrassment). Population-genetic inference — the
    population-genetics lesson's subject — is coalescent statistics applied to sequence
    data.
  </p>
  <p>
    <strong>The genetics of isolation.</strong> Speciation genes are being identified:
    <em>Dobzhansky–Muller incompatibilities</em> — alleles fine in each lineage but
    incompatible together — now have named examples (the <em>Nup160</em>/Nup96 nuclear
    pore genes in <em>Drosophila</em> hybrids; primate TRIM5α restriction factors), and
    hybrid-zone genomic studies map the barrier loci directly. Theoretical work
    (cobweb models of reinforcement, mutation-order vs ecological speciation) asks
    <em>which</em> force does the separating — and the empirical answer is "both, in
    different cases", which is why the taxonomy of speciation modes keeps being
    rewritten rather than settled.
  </p>
  <p>
    <strong>Species concepts and open problems.</strong> The biological concept fails
    for fossils (no mating to observe), asexuals (bacteria: define "interbreeding"?),
    and ring taxa — hence the phylogenetic concept (smallest diagnosable clade), the
    ecological concept (lineage occupying its own adaptive zone), and the general
    lineage concept (de Queiroz: species are segments of lineage; the other criteria are
    <em>evidence</em>, not definitions). Open problems with active research: predicting
    speciation rates from genomes; whether speciation with gene flow is as common as
    allopatric speciation (genomic evidence increasingly says yes, especially in the
    sea); timing the Cambrian explosion's branchings against molecular estimates; and
    the speciation–extinction balance that determines how fast the tree grows versus
    prunes — the number the conservation chapters keep borrowing without being able to
    measure directly.
  </p>

