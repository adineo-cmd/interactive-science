import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const techCfg = {
  steps: [
    { math: '1 · PCR: photocopying DNA', note: 'Polymerase chain reaction (1983) doubles a target DNA segment each cycle: 30 cycles = a billion copies from one. The thermal cycler\'s heating/cooling dance powers forensics, diagnosis and paleogenetics.' },
    { math: '2 · Gel electrophoresis: sorting by size', note: 'Pull DNA through a gel with electricity — short fragments travel faster. The resulting ladder of bands is how you check what you copied and compare who it came from.' },
    { math: '3 · Sequencing: reading the order', note: 'Sanger (1977) read one letter at a time; next-generation machines read millions of fragments in parallel. Human genome: 13 years and $2.7B in 2003 — hours and a few hundred dollars today.' },
    { math: '4 · CRISPR: editing, not just reading', note: 'A bacterial immune system repurposed (2012) into programmable scissors: guide RNA finds the sequence, Cas9 cuts it. Gene therapies are now approved (e.g. sickle-cell, 2023).' },
  ],
};
---
<TopicPage slug="subjects/biology/advanced/molecular-biology-techniques">
  <h2>The idea</h2>
  <p>
    Molecular biology's power comes from its <strong>toolkit</strong>: a set of techniques that
    copy, sort, read and edit DNA. Each answers a different question — is it there (PCR), how big
    (gel), what's the order (sequencing), and now, can we change it (CRISPR). Together they
    turned biology from an observational science into an engineering one.
  </p>

  <Widget no="1" caption="the four-step toolkit, from copying to editing" widget="equationStep" config={techCfg} />

  <h2>Where the toolkit shows up</h2>
  <ul>
    <li><strong>Forensics:</strong> PCR amplifies a few skin cells into a profile; DNA fingerprinting (Jeffreys, 1984) has convicted and exonerated — the Innocence Project has freed 375+ people on DNA evidence.</li>
    <li><strong>Medicine:</strong> PCR tests ran the COVID-19 pandemic; genome sequencing tracks variants in real time; CRISPR therapy Casgevy was approved for sickle-cell disease in 2023.</li>
    <li><strong>Ancient DNA:</strong> Neanderthal genomes sequenced from bones (Nobel 2022, Svante Pääbo) — showing interbreeding, and that most non-African humans carry ~2% Neanderthal DNA.</li>
    <li><strong>The ethics layer is part of the toolkit:</strong> germline editing (heritable) after the 2018 He Jiankui case is broadly banned — capability outran policy once, and the field responded with moratoria.</li>
  </ul>
  <p class="sources"><strong>Sources:</strong> Mullis (PCR, Nobel 1993); Jinek et al., Science (2012); Pääbo, Nobel lecture (2022); WHO registry of genome-editing therapies.</p>
</TopicPage>
