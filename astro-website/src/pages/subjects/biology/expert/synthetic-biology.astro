};

const synGovJudge = {
  "statements": [
    {
      "s": "US regulation sorts engineered organisms by product; EU regulation sorts by process.",
      "truth": true,
      "why": "USDA/EPA/FDA by product; the EU process-based — both designed for 1980s transgenics and recombinant drugs."
    },
    {
      "s": "Gene drives have natural precedent in wild populations.",
      "truth": false,
      "why": "Engineered to spread through wild populations with no natural precedent — they sit in a governance gap."
    },
    {
      "s": "Environmental release of a gene drive affects neighbours who never consented.",
      "truth": true,
      "why": "Which is why researchers themselves publish frameworks demanding consent and staged testing."
    },
