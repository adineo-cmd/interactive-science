  "buckets": [
    "on-target",
    "off-target or collateral"
  ],
  "items": [
    {
      "label": "the guide pairs at the designed 20-base target",
      "bucket": 0
    },
    {
      "label": "Cas cuts a sequence carrying a few mismatches elsewhere",
      "bucket": 1
    },
    {
      "label": "the cell's error-prone repair scrambles the intended site",
      "bucket": 1
    },
    {
      "label": "whole-genome sequencing of edited cells finds unbidden edits",
      "bucket": 1
    },
    {
      "label": "the designed cut lands at the intended locus",
      "bucket": 0
    },
    {
      "label": "a mosaic embryo — different cells carrying different outcomes",
      "bucket": 1
    }
  ],
