import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const immuneCfg = {
  steps: [
    { math: '1 · Barriers first', note: 'Skin, mucus, stomach acid, tears — the innate wall stops the overwhelming majority of invaders before any "immune response" begins.' },
    { math: '2 · Innate: fast and generic', note: 'Minutes to hours: inflammation, fever, scavenging cells. It recognises general danger patterns, not specific enemies — fast but blunt.' },
    { math: '3 · Adaptive: slow and specific', note: 'B cells make antibodies matching one exact shape; T cells kill infected cells. Each response takes a week — the reason you feel ill that long.' },
    { math: '4 · Memory: the whole point', note: 'Memory B/T cells persist for decades. Second encounter: response in hours, disease prevented. Vaccines train this memory without the disease — one of medicine\'s greatest life-savers (smallpox: eradicated 1980).' },
  ],
};
---
<TopicPage slug="subjects/biology/intermediate/the-immune-system">
  <h2>The idea</h2>
  <p>
    The immune system is <strong>defence in layers: a wall, a rapid-response squad, and a
    sniper school</strong>. Innate immunity responds in minutes to anything dangerous-looking;
    adaptive immunity spends a week building precision weapons against one specific invader —
    then keeps the blueprint for life. Every vaccine in history is a rehearsal of that third and
    fourth step.
  </p>

  <Widget no="1" caption="the four layers, from skin to memory cells" widget="equationStep" config={immuneCfg} />

  <h2>System mechanics worth knowing</h2>
  <ul>
    <li><strong>Clonal selection:</strong> you possess B cells for millions of possible shapes; the invader selects which clone multiplies. Random generation + selection — evolution within your lifetime.</li>
    <li><strong>Antibodies:</strong> Y-shaped tags that neutralise toxins and flag invaders for destruction. Pregnancy donates them across the placenta (newborns' borrowed immunity).</li>
    <li><strong>Autoimmunity:</strong> the sniper school misidentifying the home team — type 1 diabetes, rheumatoid arthritis. The system's power is also its risk.</li>
    <li><strong>HIV's trick:</strong> it destroys the T cells that coordinate the adaptive response — dismantling the generals, which is why untreated HIV/AIDS leaves patients vulnerable to everything.</li>
    <li><strong>Allergies:</strong> the innate–adaptive system over-reacting to harmless particles — an immune system calibrated for parasite-heavy ancestors firing at pollen.</li>
  </ul>
  <p class="sources"><strong>Sources:</strong> OpenStax, Biology 2e (Immune System); Janeway's Immunobiology; WHO smallpox eradication history.</p>
</TopicPage>
