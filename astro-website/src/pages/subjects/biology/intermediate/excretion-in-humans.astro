      "left": "renal artery",
      "right": "fed straight from the aorta — a quarter of cardiac output, ~1.2 L/min"
    },
    {
      "left": "renal vein",
      "right": "drains the cleaned blood back"
    }
  ],
  "why": "Fist-sized filters at 0.4% of body mass consume ~7% of resting ATP — one of the most energetically demanding operations in the body."
};

const exAmmoniaCompare = {
  "prompt": "The nitrogen-excretion trade-off — drag the divider:",
  "before": {
    "label": "ammonia",
    "text": "Small and extremely soluble — and extremely toxic: it would poison nerve cells at low concentrations and demands large volumes of water to flush."
  },
  "after": {
    "label": "urea",
    "text": "Far less toxic — it rides the blood at useful concentrations, and the kidneys choose how much water to spend excreting it."
  },
  "why": "The same logic shaped uric acid in birds and insects — safer still, but energetically dearer to make. Excretion and water balance can never be discussed separately."
};

const exNephronOrder = {
  "prompt": "Filter, then re-choose — put the nephron's work in order:",
  "items": [
    "Blood pressure in the glomerulus forces water, glucose, urea and ions into Bowman's capsule",
    "Blood cells, platelets and proteins stay behind — anything above ~68,000 mass cannot pass",
    "The proximal tubule hauls back all the glucose, some ions and most water by active transport",
    "The loop of Henle and collecting duct finish the water balance",
    "What remains — urea, excess water, excess ions — is urine"
  ],
  "why": "The nephron never decides at the filter, only at the reabsorber: about half the filtered urea is passively reabsorbed anyway, but the rest is left in the tubule deliberately."
};

const exADHCloze = {
  "text": "ADH is released by the %%0%% when blood becomes too concentrated, detected by %%1%% in the hypothalamus, and makes the %%2%% %%3%% more permeable to water. Alcohol %%4%% ADH release — which is why beer dehydrates while it appears to hydrate.",
  "answers": [
    [
      "pituitary"
    ],
    [
      "osmoreceptors"
    ],
    [
      "collecting"
    ],
    [
      "duct"
    ],
    [
      "suppresses"
    ]
  ],
  "hint": "The loop closes: any deviation in blood concentration automatically calls up its own correction."
};

const exUrineSpot = {
  "prompt": "This urine-analysis answer contains one faulty line — click it:",
  "lines": [
    "Normal urine is about 95% water and 2% urea, with no glucose, no protein and no blood cells.",
    "Glucose in urine means plasma exceeded the renal threshold of about 180 mg/dL.",
    "Protein in urine means the glomerular filter itself is leaking.",
    "Blood or pus cells point to infection, stones or injury elsewhere in the tract.",
    "Dark, scanty urine means the ADH loop has switched off entirely — you are overhydrated."
  ],
  "errorLine": 4,
  "correction": "Dark, scanty urine means the ADH loop is SQUEEZING HARD — you are dehydrated and the kidney is protecting you.",
  "why": "The dipstick is selective reabsorption read backwards: whatever shows up in the urine is whatever the nephron failed to keep."
};

const exFailureBranch = {
  "root": "The nephrons are failing — urea and ions climb, water balance collapses. Untreated, days to weeks. Choose the management.",
  "nodes": {
    "start": {
      "text": "Which option do you set up?",
      "choices": [
        {
          "label": "Haemodialysis machine",
          "next": "machine",
          "feedback": "Blood over a selectively permeable membrane against fresh dialysis fluid."
        },
        {
          "label": "Peritoneal dialysis",
          "next": "peri",
          "feedback": "The patient's own abdominal lining as the membrane."
        },
        {
          "label": "Transplant a donor kidney",
          "next": "transplant",
          "feedback": "The machine becomes unnecessary — at a price."
        }
      ]
    },
    "machine": {
      "text": "The dialysate is the therapeutic art: glucose at blood levels prevents sugar loss, ion levels set each ion's diffusion direction, and it is refreshed fast enough to keep urea's gradient steep. Three to four sessions a week, four hours each."
    },
    "peri": {
      "text": "Portable and able to run overnight — less efficient than a machine, but closer to the continuous, gentle correction a real kidney performs."
    },
    "transplant": {
      "text": "One kidney at 60–80% of a pair's filtration is enough — the safety margin was built for this — but the recipient takes immunosuppressants for life: the new kidney is genetically somebody else's."
    }
  },
