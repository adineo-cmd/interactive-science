};

const exPlumbingMatch = {
  "prompt": "The kidney's plumbing — pair each part with its role:",
  "pairs": [
    {
      "left": "cortex and medulla",
      "right": "the kidney's outer and inner regions"
    },
    {
      "left": "ureters",
      "right": "drain urine down to the bladder"
    },
    {
      "left": "urethra",
      "right": "the way out"
    },
