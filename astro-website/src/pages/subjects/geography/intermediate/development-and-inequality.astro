import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const prestonCfg = {
  points: [
    {
      points: [[1.7, 62], [6, 53.5], [9, 68], [16.5, 73.5], [21.5, 78.5], [43, 84.5]],
      color: '#0f766e',
      label: 'countries (2022)',
      mode: 'dots',
    },
  ],
  x: { min: 0, max: 50, label: 'GNI per person, PPP $1000s' },
  y: { min: 45, max: 90, label: 'life expectancy (years)' },
  crossings: false,
  height: 350,
};

const hdiCfg = {
  params: [
    { name: 'le', label: 'life expectancy', min: 20, max: 85, step: 0.5, value: 73, unit: 'yrs' },
    { name: 'mys', label: 'mean years of schooling', min: 0, max: 15, step: 0.1, value: 8.7 },
    { name: 'eys', label: 'expected years of schooling', min: 0, max: 20, step: 0.1, value: 13 },
    { name: 'gni', label: 'GNI per capita (PPP)', min: 200, max: 90000, step: 100, value: 21000, unit: 'US$' },
  ],
  readouts: [
    { label: 'health index', expr: '(le-20)/65' },
    { label: 'education index', expr: '(mys/15 + eys/18)/2' },
    { label: 'income index', expr: 'min(1, (ln(gni)-ln(100))/(ln(75000)-ln(100)))' },
    { label: 'HDI', expr: '(((le-20)/65) * ((mys/15 + eys/18)/2) * (min(1, (ln(gni)-ln(100))/(ln(75000)-ln(100)))))^(1/3)' },
  ],
};

const tradeCfg = {
  type: 'vector',
  unit: 'bn US$',
  x: { min: 0, max: 20 },
  y: { min: 0, max: 20 },
  start: [6, 9],
  height: 320,
};

const devLivingCompare = {
  "prompt": "The two ideas that usually travel together — drag the divider:",
  "before": {
    "label": "standard of living",
    "text": "What money buys: income, goods, housing. Easy to measure, easy to average — and easy to fake with a single large number."
  },
  "after": {
    "label": "quality of life",
    "text": "How good living actually is: health, education, security, a clean environment. Harder to count — and the 'not always' between this and income is where the whole discipline lives."
  },
  "why": "The gaps run between countries and inside them — and the inside-country gaps are often the larger political fact."
};

const devIndicatorBuckets = {
  "prompt": "Economic or social? File each development indicator:",
  "buckets": [
    "economic — measures the money",
    "social — measures the life"
  ],
  "items": [
    {
      "label": "GDP per capita",
      "bucket": 0
    },
    {
      "label": "GNI per capita (with remittances earned abroad)",
      "bucket": 0
    },
    {
      "label": "the LIC/MIC/HIC thresholds (~$1,100 and ~$4,500)",
      "bucket": 0
    },
    {
      "label": "literacy rate",
      "bucket": 1
    },
    {
      "label": "infant mortality",
      "bucket": 1
    },
    {
      "label": "doctors per thousand people",
      "bucket": 1
    },
    {
      "label": "access to safe water",
      "bucket": 1
    },
    {
      "label": "calorie intake",
      "bucket": 1
    }
  ],
