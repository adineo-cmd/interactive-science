import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const co2Cfg = {
  points: [
    {
      points: [[1958, 315.2], [1970, 325.7], [1980, 338.8], [1990, 354.4], [2000, 369.7], [2010, 389.9], [2020, 414.2], [2024, 424.6]],
      color: '#b42318',
      label: 'Mauna Loa annual mean CO₂',
      mode: 'both',
    },
  ],
  curves: [{ expr: '280', label: 'pre-industrial ~280 ppm', color: '#0f766e', width: 1.6 }],
  x: { min: 1950, max: 2026, label: 'year' },
  y: { min: 275, max: 440, label: 'CO₂ (ppm)' },
  crossings: false,
  height: 350,
};

const balanceCfg = {
  params: [
    { name: 'a', label: 'planetary albedo', min: 0.05, max: 0.45, step: 0.01, value: 0.3 },
    { name: 'g', label: 'greenhouse effect', min: 0, max: 80, step: 1, value: 33, unit: 'K' },
  ],
  readouts: [
    { label: 'effective temperature (no greenhouse)', expr: '((1361*(1-a))/(4*0.0000000567))^0.25', unit: 'K' },
    { label: 'surface temperature', expr: '((1361*(1-a))/(4*0.0000000567))^0.25 + g', unit: 'K' },
    { label: 'surface temperature', expr: '((1361*(1-a))/(4*0.0000000567))^0.25 + g - 273.15', unit: '°C' },
  ],
};

const cliTimeline = {
  unit: 'year',
  events: [
    { year: 1896, title: 'A chemist does the arithmetic', text: 'Svante Arrhenius calculates that doubling CO₂ would warm the world by roughly 5–6 °C — remarkably close to modern estimates.', tag: 'evidence' },
    { year: 1938, title: 'Callendar connects the dots', text: 'Steam engineer Guy Callendar shows global land temperatures rose about 0.3 °C in fifty years and blames fossil CO₂. Colleagues are polite and unconvinced.', tag: 'evidence' },
    { year: 1958, title: 'The curve begins', text: 'Charles David Keeling starts continuous CO₂ measurements at Mauna Loa: 315 ppm. The Keeling curve has never dipped since.', tag: 'evidence' },
    { year: 1988, title: 'The alarm goes institutional', text: 'James Hansen tells the US Senate "global warming has begun"; the UN founds the IPCC the same year.', tag: 'science' },
    { year: 1992, title: 'Rio Earth Summit', text: 'More than 150 countries sign the UNFCCC, promising to stabilise greenhouse gases — with no binding numbers yet.', tag: 'politics' },
    { year: 1997, title: 'Kyoto Protocol', text: 'Developed nations accept binding cuts averaging ~5% below 1990 levels for 2008–2012. In force from 2005.', tag: 'politics' },
    { year: 2015, title: 'Paris Agreement', text: '195 countries agree to hold warming well below 2 °C and pursue 1.5 °C, via national pledges that ratchet down every five years.', tag: 'politics' },
    { year: 2023, title: 'Warmest year yet', text: 'The WMO confirms 2023 at about 1.45 ± 0.12 °C above pre-industrial — the hottest year in the instrumental record at that point.', tag: 'evidence' },
    { year: 2024, title: 'Past 1.5 for a calendar year', text: '2024 averages ~1.55 °C above pre-industrial, the first full year beyond the Paris symbol level. One year is not the goal broken — but the trend line speaks.', tag: 'evidence' },
  ],
};

const ccWeatherCompare = {
  "prompt": "The distinction that organises the whole page — drag the divider:",
  "before": {
    "label": "weather",
    "text": "What happens today: Tuesday's frost, this week's storm. A single draw from the distribution — noise, and proof of nothing in either direction."
  },
  "after": {
    "label": "climate",
    "text": "The statistics of decades — the distribution itself. Only the statistics have changed: record highs now outnumber record lows roughly two to one in the US, and a wavier jet stream can even deliver colder-looking episodes."
  },
  "why": "Cold snaps disprove nothing and warm snaps prove nothing on their own — judge the statistics, not Tuesday's frost."
};

const ccEvidenceBuckets = {
  "prompt": "Which line of evidence carries each observation? File them:",
  "buckets": [
    "thermometers",
    "ice: cores, sea ice, oceans",
    "human documents"
  ],
  "items": [
    {
      "label": "2024: the warmest single year yet measured, near 1.55 °C above pre-industrial",
      "bucket": 0
    },
    {
      "label": "the decade to 2020 about 1.1 °C warmer than 1850–1900",
      "bucket": 0
    },
    {
      "label": "an 800,000-year record with CO₂ swinging between 172 and 300 ppm",
      "bucket": 1
    },
    {
      "label": "Arctic September sea ice shrinking 12–13% per decade since 1979",
      "bucket": 1
    },
    {
      "label": "oceans absorbing over 90% of the excess heat, warming top to bottom",
      "bucket": 1
    },
    {
      "label": "London's frost fairs on a frozen Thames, a regular event 1607–1814",
      "bucket": 2
    },
    {
      "label": "grape harvest dates and ship logs",
      "bucket": 2
    }
  ],
  "why": "Four independent lines converge — and today's 424 ppm stands far outside the ice-core envelope of 172–300 ppm, the whole 800,000-year range."
};

const ccFingerprintMatch = {
  "prompt": "Fingerprints only enhanced greenhouse warming leaves — pair each with its reading:",
  "pairs": [
    {
      "left": "the stratosphere cools while the surface warms",
      "right": "extra heat trapped below — a brighter sun would warm every layer instead"
    },
    {
      "left": "nights and winters warm faster than days and summers",
      "right": "exactly what blanket physics requires"
    },
    {
      "left": "the atmosphere's carbon-14 is diluting",
      "right": "fossil carbon is ancient and carries virtually none"
    }
  ],
  "why": "Each fingerprint separates the human cause from the natural suspects — the sun's alibi is written in the vertical profile of the atmosphere itself."
};

const ccSlopeEstimate = {
  "prompt": "The Keeling curve's growth averaged about 0.8 ppm per year in the 1960s. Roughly how many ppm per year did it reach in the 2010s?",
  "unit": "ppm per year",
  "answer": 2.4,
  "factor": 1.4,
  "why": "About 2.4 ppm per year — the slope steepens decade by decade, the signature of an accelerating cause, not a steady one.",
  "context": "The small annual zig-zag is the Northern Hemisphere's biosphere breathing: leaves take in CO₂ each boreal summer and release it each winter."
};

const ccRhythmOrder = {
  "prompt": "The natural drivers act on wildly different clocks — order them by timescale, longest first:",
  "items": [
    "Eccentricity of the orbit — ~100,000 years",
    "Axial tilt — ~41,000 years",
    "Precession of the equinoxes — ~23,000 years",
    "The sunspot cycle — 11 years",
    "Pinatubo's sulphur aerosols — a year or two before raining out"
  ],
  "why": "From millennia down to a couple of years — none of these clocks can produce a 50% rise in CO₂ sustained over 170 years, and since about 1950 the natural forcings sum to roughly zero."
};

const ccGreenhouseCloze = {
  "text": "The natural greenhouse effect keeps Earth about %%0%% K warmer than an airless world at our distance; livestock and flooded rice paddies emit methane, roughly %%1%% times stronger than CO₂ over 20 years; and the modern best estimate of warming per doubling of CO₂ is about %%2%% °C.",
  "answers": [
    [
      "33"
    ],
    [
      "80",
      "eighty"
    ],
    [
      "3",
      "three"
    ]
  ],
  "hint": "One is what the energy-balance model shows when the greenhouse slider hits zero; one is per kilogramme over 20 years; one is the century-refined best estimate."
};

const ccSeaPlace = {
  "prompt": "Global mean sea level has been climbing since 1900. How far has it risen so far?",
  "labels": [
    "0 cm",
    "20 cm",
    "40 cm",
    "60 cm",
    "80 cm",
    "100 cm"
  ],
  "scale": {
    "min": 0,
    "max": 100
  },
  "answer": 20,
  "tolerance": 4,
  "why": "About 20 cm since 1900, now accelerating at 3.7–4.5 mm a year — roughly half thermal expansion so far, with the melt share the one that accelerates."
};

const ccResponseBranch = {
  "root": "You advise a coastal city council: the sea is climbing ~4 mm a year and summers are getting lethal. The budget covers one serious push this year.",
  "nodes": {
    "start": {
      "text": "Two levers are on the table. Which do you fund first?",
      "choices": [
        {
          "label": "Cut the city's own emissions",
          "next": "mitigation",
          "feedback": "The long game — your tonnes help everywhere except, for decades, your own sea wall."
        },
        {
          "label": "Build for the water and heat already arriving",
          "next": "adaptation",
          "feedback": "Fast and local — but it cannot scale to unbounded warming."
        },
        {
          "label": "Fund neither fully — wait for the other to pay off first",
          "next": "sequenced",
          "feedback": "Sequencing is a choice too. Watch what it costs."
        }
      ]
    },
    "mitigation": {
      "text": "Solar electricity fell about 90% in cost across the 2010s and wind is now the cheapest new power in much of the world; forests and wetlands can be restored as sinks, carbon can be priced. But this lever is global and slow — free-riding tempts everyone, and the sea keeps rising for decades regardless.",
      "choices": [
        {
          "label": "Now add the local defences",
          "next": "adaptation",
          "feedback": "The practical follow-up — the two levers bind at different speeds."
        }
      ]
    },
    "adaptation": {
      "text": "Sea walls and 'room for the river' where defended land is worth defending, managed retreat where it is not; drought-tolerant crops and drip irrigation; heat-action plans — Ahmedabad's saved hundreds of lives a year within a decade. But no wall adapts to 4 °C: this lever is local and fast, and stops there.",
      "choices": [
        {
          "label": "Now work on the cause as well",
          "next": "mitigation",
          "feedback": "Back to the long game — adaptation cannot scale alone."
        }
      ]
    },
    "sequenced": {
      "text": "Waiting on one lever while pulling neither is how decades are lost: mitigation delayed is mitigation compounded, because infrastructure built today locks in emissions for a lifetime."
    }
  },
  "why": "Mitigation is global and slow; adaptation is local and fast — one without the other fails, which is why the syllabus asks you to evaluate them together, at every scale from diet to treaty."
};
---
<TopicPage slug="subjects/geography/intermediate/climate-change-causes-and-impacts">

  <h2>Where you are, and what you will learn</h2>
  <p>
    This intermediate Geography lesson builds on the foundational <em>Latitude and
    Climate</em> — whose global pattern of temperature and rainfall this lesson watches
    shift — and <em>Ecosystems and Biomes</em>, whose biomes are being displaced. You need
    the weather-versus-climate distinction; the lesson rebuilds it on the way in.
  </p>
  <p>By the end you will be able to:</p>
  <ul>
    <li>set out the four evidence lines for the warming, and the fingerprints that attribute it;</li>
    <li>separate natural drivers (orbit, sun, volcanoes) from the human enhancement of the greenhouse effect;</li>
    <li>trace impacts from global (sea level, corals) through regional (monsoons, glaciers) to local (heat waves, atolls);</li>
    <li>distinguish mitigation from adaptation, and evaluate each with a named example;</li>
    <li>read a carbon dioxide curve and a simple energy-balance model like a geographer.</li>
  </ul>

  <h2>The idea</h2>
  <p>
    Climate change is the rare geography topic where you must first establish that it is
    happening, then explain it, then judge what to do — the syllabus splits it exactly that
    way (causes, impacts, responses). The scientific story can be told in one sentence:
    <strong>the planet is gaining energy because we have thickened the atmosphere's heat
    blanket, and every consequence follows from that imbalance</strong>. This page works
    through the evidence, separates the natural and human causes (climate has, of course,
    always changed), tracks the impacts from the planetary to the village scale, and
    weighs the two families of response. Keep the distinction that organises everything:
    <em>weather</em> is what happens today; <em>climate</em> is the statistics of decades
    — and only the statistics have changed.
  </p>
  <Widget no="4" caption="drag the divider — noise versus distribution" widget="compare" config={ccWeatherCompare} />

  <h2>How we know it is happening</h2>
  <p>
    The evidence stacks four independent lines. <strong>Thermometers</strong>: the decade to
    2020 was about 1.1 °C warmer than 1850-1900 (IPCC AR6), and 2024 was the warmest single
    year yet measured, near 1.55 °C above pre-industrial. <strong>Ice cores</strong>: air
    bubbles trapped in Antarctic ice preserve an 800,000-year record in which CO₂ swings
    between roughly 172 ppm (ice ages) and 300 ppm (warm interglacials) — today's 424 ppm
    stands far outside that envelope. <strong>Ice and oceans</strong>: Arctic September sea
    ice has shrunk about 12-13 per cent per decade since 1979, glaciers retreat on every
    continent, and the oceans — which absorb over 90 per cent of the excess heat — have
    measurably warmed top to bottom. <strong>Documents</strong>: harvest dates, grape
    harvests, ship logs and London's frost fairs on a frozen Thames (a regular event
    1607-1814, impossible in today's river) record the Little Ice Age and show how climate
    history is written in human archives as well as sediments.
  </p>
  <Widget no="5" caption="file each observation under its evidence line" widget="sort-buckets" config={ccEvidenceBuckets} />
  <p>
    Attribution adds fingerprints that only enhanced greenhouse warming leaves. The
    <em>stratosphere is cooling while the surface warms</em> — exactly what extra heat
    trapped below predicts and what a brighter sun (which would warm every layer) forbids.
    Nights and winters warm faster than days and summers, as blanket physics requires.
    And the carbon itself is signed: fossil carbon is ancient, so it contains virtually no
    carbon-14 — the atmosphere's isotope mix is diluting in precisely that signature.
  </p>
  <Widget no="6" caption="pair each fingerprint with what it proves" widget="match" config={ccFingerprintMatch} />

  <Widget no="1" caption="the Keeling curve — Mauna Loa annual means (NOAA): 315 ppm in 1958 to 424.6 in 2024, about 50% above the pre-industrial 280" widget="plotter" config={co2Cfg} />
  <p>
    <strong>What to notice:</strong> first the level — the red line ends about 50 per cent
    above the dashed pre-industrial baseline. Then the slope: it steepens decade by decade,
    the signature of an accelerating cause. Finally the small annual zig-zag — match it to
    the biosphere's breathing described below.
  </p>

  <p>
    Read fig. 1 like a geographer: the level matters (about 50 per cent above
    pre-industrial), but so does the <em>slope</em> — growth averaged about 0.8 ppm per
    year in the 1960s and about 2.4 ppm per year in the 2010s. The cause is accelerating,
    not steady. The small annual zig-zag is the Northern Hemisphere's biosphere breathing
    — leaves take in CO₂ each boreal summer and release it each winter — proof that the
    rise tracks biology and land use as well as industry.
  </p>
  <Widget no="7" caption="call the slope — the accelerating cause" widget="estimate" config={ccSlopeEstimate} />

  <p>
    <strong>So far:</strong> the warming is established by four evidence lines and
    attributed by fingerprints only it leaves. Climate has always changed — so the next
    section sets the natural baseline first.
  </p>

  <h2>Natural causes: the baseline of change</h2>
  <p>
    Syllabus 5.1 is careful: climate has always changed, and three natural drivers do most
    of the natural changing. <strong>Milankovitch cycles</strong> — slow wobbles in Earth's
    orbit and spin (eccentricity of the orbit, ~100,000 years; axial tilt, ~41,000;
    precession of the equinoxes, ~23,000) — redistribute sunlight across seasons and
    latitude, pacing the ice ages of the last 2.6 million years; the small orbital trigger
    is amplified by feedbacks (ice growth raises albedo, colder oceans absorb more CO₂).
    <strong>Solar variability</strong>: sunspots follow an 11-year cycle that nudges total
    solar output by only about 0.1 per cent — the "Little Ice Age" coincided with the
    sun's quiet Maunder Minimum, but the effect is a fraction of a degree. <strong>Volcanic
    eruptions</strong> inject sulphur aerosols into the stratosphere: Pinatubo's 1991
    eruption dimmed sunlight enough to cool the globe by about 0.5 °C for a year or two
    before the aerosols rained out. Now the decisive comparison: none of these can produce
    a 50 per cent rise in CO₂ sustained over 170 years — orbital cycles act over tens of
    millennia, the sun's cycle cancels itself, and volcanoes <em>cool</em>. Since about
    1950, natural forcings sum to roughly zero; the warming is left with one suspect.
  </p>
  <Widget no="8" caption="order the natural rhythms, longest first" widget="order" config={ccRhythmOrder} />

  <p>
    <em>Common misconception:</em> climate has always changed naturally, so today's change
    must be natural too. Past change is what convicts the present: the natural drivers act
    over millennia (orbit), cancel out (sunspots) or cool (volcanoes) — none can produce a
    50 per cent rise in carbon dioxide over 170 years. Natural change explains the
    baseline, not the spike since 1950.
  </p>

  <h2>Human causes: the enhanced greenhouse effect</h2>
  <p>
    The mechanism is simple accounting of radiation. Sunlight arrives mostly as visible
    light, which the atmosphere largely transmits; the warmed surface re-radiates the
    energy as infrared, which greenhouse gas molecules absorb and re-emit in all
    directions — including back down. The natural greenhouse effect is not a villain: it
    keeps Earth's surface about 33 K warmer than an airless world at our distance. The
    <em>enhanced</em> effect is the added thickness of the blanket: burning fossil fuels
    (about 37 billion tonnes of CO₂ a year), clearing forests (which removes both a sink
    and, by burning, adds a source), and agriculture (livestock digestion and flooded rice
    paddies emit methane — per kilogramme roughly 80 times stronger than CO₂ over 20
    years, though it decays in about a decade; nitrous oxide from fertilisers completes
    the trio). The consequences compound through <strong>feedbacks</strong>: warmer air
    holds more water vapour (itself a greenhouse gas, roughly doubling the direct CO₂
    effect), melting ice darkens the surface and absorbs more sunlight (the ice-albedo
    feedback), and thawing permafrost releases stored carbon. Feedbacks are why a small
    push can shift a large system — and why the precise answer to "how much warming per
    doubling of CO₂?" has taken a century of work: the modern best estimate is about
    3 °C, likely range 2.5-4 °C.
  </p>
  <Widget no="9" caption="fill the blanks — the greenhouse ledger" widget="cloze" config={ccGreenhouseCloze} />

  <Widget no="2" caption="a one-line climate model: solar input, albedo, greenhouse strength. Zero the greenhouse and Earth is −18 °C; the real ~33 K greenhouse gives the observed ~14.5 °C" widget="sliderLab" config={balanceCfg} />
  <p>
    <strong>What to notice:</strong> with the greenhouse slider at zero, the surface readout
    falls to about minus 18 °C — a frozen Earth at our distance from the same sun. Slide
    the greenhouse toward its real value of about 33 K and watch the surface climb to the
    observed near 14.5 °C. Then lower the albedo slider: the readout responds as if the
    planet had darkened — a feedback, an amplifier, not an initial cause.
  </p>

  <p>
    Fig. 2 is genuine physics: absorbed sunlight (1361 W/m² dimmed by albedo) sets an
    effective temperature of about 255 K, and the greenhouse effect lifts the surface to
    about 288 K — matching the observed global mean within half a degree. Slide the
    albedo down (melt the ice, darken the planet) and watch the surface warm through a
    feedback, not a cause. This is the whole argument in miniature: the cause sets the
    energy imbalance, the feedbacks set the price.
  </p>

  <p>
    <strong>So far:</strong> the natural suspects have alibis, and the enhanced greenhouse
    effect accounts for the imbalance. Next: the imbalance followed downstream, from
    planetary to village scale.
  </p>

  <h2>Impacts at a range of geographic scales</h2>
  <p>
    <strong>Global:</strong> the warmest years on record are all recent (2023-2024 each
    broke the record); global mean sea level has risen about 20 cm since 1900 and is
    climbing around 3.7-4.5 mm per year — a rise mixing two mechanisms: water expands as
    it warms (roughly half so far), and ice sheets and glaciers supply the rest, with the
    ice contribution accelerating — which is why today's emissions commit coastlines for
    centuries. At 1.5 °C of warming, IPCC
    SR1.5 expects 70-90 per cent of coral reefs to be lost. <strong>Regional:</strong>
    the monsoon world sees heavier bursts and longer dry spells (a warmer atmosphere
    holds about 7 per cent more moisture per degree, so both downpours and droughts
    intensify); glacier-fed rivers from the Andes to the Himalaya first swell and then
    shrink; the Mediterranean and south-western Africa face megadrought risk; the Arctic
    warms two to four times faster than the global average (sea-ice loss is its own
    feedback). <strong>Local:</strong> the June 2021 heat dome reached 49.6 °C at Lytton,
    British Columbia — and the village burned the next day; Karachi's and Delhi's heat
    waves now fall hardest on informal neighbourhoods with no shade and no power;
    Pacific atolls (Tuvalu, Kiribati) face salinisation of their freshwater lenses long
    before they face waves. Food, health and movement follow: growing seasons shift
    poleward (some high-latitude farms gain; tropical maize and wheat yields suffer),
    heat deaths and disease ranges expand, and drought-plus-poverty drives migration —
    usually internal, always political.
  </p>
  <Widget no="10" caption="pin the rise — the ocean's slow thumb on the scale" widget="place" config={ccSeaPlace} />
  <p>
    <em>Common misconception:</em> cold snaps disprove warming. Weather is noise; climate
    is the distribution. A warmer atmosphere with more energy and moisture produces more
    extremes in <em>both</em> directions — including, in some regions, colder-looking
    episodes linked to a wavier jet stream. Judge the statistics (record highs now
    outnumber record lows roughly two to one in the US), not Tuesday's frost.
  </p>
  <p>
    <em>Common misconception:</em> sea-level rise is mainly ice melting into the sea. So far
    roughly half is thermal expansion — seawater takes up more room as it warms — with
    meltwater supplying the rest, and the melt share is the one that accelerates: expansion
    responds to warming already in the pipeline, while ice sheets commit coastlines for
    centuries.
  </p>

  <p>
    <strong>So far:</strong> the impacts scale from the planetary (sea level, corals) to
    the regional (monsoons, glaciers) to the local (Lytton, Karachi, Tuvalu). Next: the two
    families of response those impacts demand.
  </p>

  <h2>Responses: mitigation, adaptation — and doing both</h2>
  <p>
    Responses split in two. <strong>Mitigation</strong> attacks the cause: replace fossil
    energy (solar electricity costs fell about 90 per cent in the 2010s; wind is now the
    cheapest new power in much of the world), electrify transport and heating, efficiency
    in everything, protect and restore forests and wetlands as carbon sinks, price carbon
    so the atmosphere stops being a free sewer, and bind it internationally — the Kyoto
    Protocol (1997, binding cuts for developed nations only) taught the politics; the
    Paris Agreement (2015) converted 195 countries to pledges ratcheting down every five
    years. <strong>Adaptation</strong> manages the unavoidable: sea walls and
    "room for the river" (the Netherlands' choice where defended land is worth defending
    and managed retreat where it is not), drought-tolerant crops and drip irrigation,
    heat-action plans (Ahmedabad's saved hundreds of lives a year within a decade),
    early-warning systems.
  </p>
  <p>
    The named exemplar is <strong>Bangladesh</strong>: when Cyclone Bhola struck in 1970,
    an estimated 300,000-500,000 people died; when comparable Cyclone Amphan arrived in
    2020, Bangladesh evacuated some 2.4 million people into thousands of cyclone shelters
    and recorded around 26 deaths. Half a century of shelters, embankments, warnings and
    volunteer drills cut a mega-disaster to a statistic — adaptation working at
    civilization-saving scale. The evaluation the syllabus wants: mitigation is global
    and slow (every tonne helps everywhere, so free-riding tempts everyone), adaptation
    is local and fast (but cannot scale to unbounded warming — no wall adapts to 4 °C).
    One without the other fails, which is exactly why the syllabus asks you to evaluate
    them together. A final note on scale: responses also stack vertically — individual
    choices (diet, travel, heating), city policy (transit, building codes, tree canopy),
    national law (carbon prices, standards) and international finance (the annual
    climate summits) all bind at different speeds, and the exam's best answers name an
    example at each level.
  </p>
  <Widget no="11" caption="the council chamber — which lever do you pull?" widget="branch" config={ccResponseBranch} />

  <p>
    <em>Common misconception:</em> adaptation is the defeatist option — real climate policy
    is mitigation. The Bangladesh numbers argue otherwise: shelters and warnings cut a
    mega-disaster to a statistic in fifty years. The evaluation runs both ways —
    adaptation is fast but cannot scale to unbounded warming; mitigation is slow but
    attacks the cause — so both.
  </p>

  <Widget no="3" caption="from Arrhenius's pencil to Paris and past 1.5 °C — 130 years between the prediction and the politics" widget="timeline" config={cliTimeline} />
  <p>
    <strong>What to notice:</strong> drag the timeline and watch the tags — evidence
    (Arrhenius 1896, Keeling 1958, the warmest-year records) runs decades ahead of politics
    (Rio 1992, Kyoto 1997, Paris 2015). Note the 130-year gap between prediction and
    binding treaty — and that 2024 crossing 1.5 °C once is not the goal broken; Paris is
    about long-term averages.
  </p>

  <h2>Check yourself</h2>
  <p>Try these before moving on. Feedback follows each answer.</p>
  <ol>
    <li>Name the four lines of evidence that the climate is changing, and one attribution fingerprint.</li>
    <li>Why can none of the natural drivers explain the post-1950 warming?</li>
    <li>Distinguish mitigation from adaptation, giving one named example of each.</li>
  </ol>
  <p>
    <strong>Feedback:</strong> (1) Thermometers, ice cores, ice and oceans, and documents —
    plus a fingerprint, such as a cooling stratosphere above a warming surface (a brighter
    sun would warm every layer). (2) Milankovitch cycles act over millennia, the sunspot
    cycle cancels out, volcanoes cool — none can raise carbon dioxide 50 per cent in 170
    years; natural forcings sum to roughly zero since about 1950. (3) Mitigation attacks
    the cause — cheap solar replacing fossil energy; adaptation manages the unavoidable —
    Bangladesh's shelters and warnings, cutting deaths from hundreds of thousands to
    dozens.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>Weather is today; climate is the statistics of decades — and only the statistics have changed.</li>
    <li>Four evidence lines plus fingerprints (a cooling stratosphere, fossil carbon's isotope signature) attribute the warming to us.</li>
    <li>Natural drivers pace ice ages over millennia; since about 1950 they sum to roughly zero.</li>
    <li>The natural greenhouse effect keeps Earth habitable; the enhanced effect is added blanket thickness.</li>
    <li>Feedbacks (water vapour, ice-albedo, permafrost) amplify a small push — sensitivity is about 3 °C per doubling of CO2.</li>
    <li>Impacts scale from global sea level and corals to regional monsoons and glaciers to village heat.</li>
    <li>Mitigation is global and slow; adaptation is local and fast — one without the other fails.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    <em>Monsoons and Tropical Climates</em> examines the system flagged here as sharpening
    under warming; <em>Coasts and Oceans</em> develops the sea-level and ocean-heat story;
    and <em>Rivers, Floods and Deltas</em> follows the water consequences.
  </p>

  <h2>Going deeper</h2>
  <p>
    The expert layer is arithmetic and asymmetry. The <strong>carbon budget</strong>: every
    tonne of CO₂ adds to the same cumulative total, so the remaining allowance for 1.5 °C
    is a few hundred billion tonnes — at current emission rates, spent within a couple of
    decades; this is why net zero (sources balanced by sinks) is a deadline, not an
    aspiration, and why later cuts must be steeper. <strong>Tipping elements</strong>:
    parts of the system may reorganise faster than linear warming suggests — the Atlantic
    overturning circulation (AMOC), the West Antarctic ice sheet's marine cliffs, Amazon
    dieback under drought-and-fire, permafrost carbon — each with ranges of uncertainty
    wide enough to be honest about but narrow enough to worry about. <strong>Fairness</strong>:
    the UNFCCC's phrase "common but differentiated responsibilities" encodes the core
    asymmetry — today's ~1.3 °C of warming was mostly emitted by the roughly one-fifth of
    humanity in rich countries, while the sharpest early impacts fall on tropical, poorer
    populations who emitted least; loss-and-damage finance, technology transfer and the
    fossil-fuel exit of emerging economies are the same problem in three costumes. And the
    deepest open question is practical, not scientific: mitigation delayed is mitigation
    compounded, because infrastructure built today locks in emissions for decades. The
    science has been clear since Callendar's typewriter; the remaining research problem
    is human.
  </p>

