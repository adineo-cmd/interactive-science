import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const globCfg = {
  steps: [
    { math: '1 · The container revolution', note: 'Malcolm McLean\'s shipping container (1956) cut port handling costs ~95%. Trade costs collapsed; factories could locate anywhere. "Globalisation" is partly a box story.' },
    { math: '2 · Global value chains', note: 'A phone: silicon from Taiwan/Japan, rare earths from China, assembly in Vietnam/India, software in California. ~70% of trade now involves intermediate goods crossing borders multiple times. Tariffs tax your own imports too.' },
    { math: '3 · The winners and losers map unevenly', note: 'Globalisation lifted ~1 billion out of poverty (mostly Asia) and hollowed industrial towns in the West ("China shock" research). Aggregate gains, concentrated pain — the political fault line of the century.' },
    { math: '4 · Globalisation 3.0: rewiring, not retreating', note: 'After COVID and geopolitics, trade is reorganising: friend-shoring, chip export controls, supply-chain resilience over pure efficiency. Trade didn\'t end; its map is being redrawn by security policy.' },
  ],
};
---
<TopicPage slug="subjects/geography/advanced/economic-globalisation">
  <h2>The idea</h2>
  <p>
    Economic globalisation is <strong>the integration of production, trade, capital and labour
    across borders</strong> — built on container shipping, telecommunications and trade
    agreements. It is the most powerful poverty-reduction machine in history and the most
    efficient disruption machine — usually for the same regions in the same decade. Its current
    chapter is not retreat but reorganisation along political lines.
  </p>

  <Widget no="1" caption="the machinery, the map, and the rewiring" widget="equationStep" config={globCfg} />

  <h2>Core concepts in current events</h2>
  <ul>
    <li><strong>Comparative advantage meets national security:</strong> chips, batteries and pharmaceuticals are now "strategic" — efficiency ceding to resilience. Export controls on advanced semiconductors are industrial policy by another name.</li>
    <li><strong>Special economic zones:</strong> Shenzhen 1980: fishing town to 17-million metropolis. SEZs are globalisation's policy instrument — 5,400+ worldwide, with mixed records.</li>
    <li><strong>Financial globalisation travels faster:</strong> capital flows swing billions in seconds (1997 Asian crisis, 2008, 2022 rate shock). Trade is stable; finance is volatile — the two globalisations differ in speed and pain.</li>
    <li><strong>Uneven development persists:</strong> core–periphery patterns have updated (China now a core) but not vanished — commodity exporters still ride price cycles they don't set. The development ladder connects here.</li>
  </ul>
  <p class="sources"><strong>Sources:</strong> Levinson, The Box; World Bank WDR 2020 (global value chains); Rodrik, The Globalization Paradox; Autor et al., "China Shock" literature.</p>
</TopicPage>
