import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const rhythmCfg = {
  steps: [
    { math: '1 · Pulse: the heartbeat of music', note: 'Music organises time into equal pulses. Feel them tap along — the pulse is what you clap, dance or march to. Tempo (beats per minute) sets the energy: 60 BPM is calm, 140 is sprinting.' },
    { math: '2 · Metre: grouping the pulses', note: 'Pulses group into measures — 4/4 (pop, rock: ONE-two-three-four), 3/4 (waltz: ONE-two-three), 6/8 (lilting, two big beats each split in three). The time signature is the grouping rule.' },
    { math: '3 · Subdivision: fractions of the beat', note: 'Beats divide into halves (quarter notes → eighths → sixteenths) or thirds (triplets). Rhythm is arithmetic you can feel — and syncopation is simply emphasising the off-beat.' },
    { math: '4 · Polyrhythm: two arithmetics at once', note: 'West African drumming plays 3 against 4 (and 2-against-3 is in jazz, hip-hop and Beethoven). Two groups running simultaneously — the ear hears both, the pattern meets on the downbeat.' },
  ],
};
---
<TopicPage slug="subjects/music/intermediate/rhythm-and-time-signatures">
  <h2>The idea</h2>
  <p>
    Rhythm is music's time dimension — <strong>pulses grouped into patterns you can predict and
    be surprised by</strong>. It is the most universal musical element (every culture has
    rhythm; not every culture has harmony) and the most mathematical: metres, subdivisions and
    polyrhythms are fractions and ratios you experience in your body before you understand them
    on paper.
  </p>

  <Widget no="1" caption="from pulse to metre to polyrhythm — the arithmetic of groove" widget="equationStep" config={rhythmCfg} />

  <h2>What rhythm does to listeners</h2>
  <ul>
    <li><strong>Groove = prediction plus deviation:</strong> the brain locks onto the pulse, then delights when a drum lands where it didn't expect. Studies (Maria Witek) find groove peaks at medium syncopation — predictable enough to move, surprising enough to be interesting.</li>
    <li><strong>Tempo is emotion:</strong> ~70 BPM matches a resting heart (ballads); ~120 is dance-floor default (the body synchronises); 160+ reads as urgency. Composers choose tempo the way film directors choose shot length.</li>
    <li><strong>Cultures group differently:</strong> Western notation assumes equal beats; Indian tala cycles run 7 or 16; Balkan music dances to 7/8 and 11/8. Rhythm systems are cultural conventions built on the same pulse physics.</li>
  </ul>
  <p class="sources"><strong>Sources:</strong> Witek et al., PLOS ONE (2014) on groove; Arom, African Polyphony and Polyrhythm; standard music theory texts.</p>
</TopicPage>
