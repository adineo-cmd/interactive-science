---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const cognCfg = {
  steps: [
    { math: '1 · The ear predicts', note: 'Hearing is prediction: your brain constantly guesses the next note, chord and beat. Composers manipulate those predictions — satisfying them (resolution) or violating them (surprise) — and the guessing game IS the emotional ride (Huron, 2006).' },
    { math: '2 · Chills are measurable', note: '"Frisson" — the shiver a perfect chord change or dropped beat triggers — is a real physiological event: dopamine release in reward circuits (Salimpoor 2011, measured with PET). The peak lands where expectation breaks just right.' },
    { math: '3 · Earworms exploit memory', note: 'Simple, repetitive, slightly unusual loops get stuck (the Zeigarnik effect: unfinished things replay). Chorus-writing is applied memory psychology — whether the writer knows it or not.' },
    { math: '4 · Music moves the body', note: 'Rhythmic entrainment — motor circuits syncing to a beat — is near-automatic in humans, unique in its strength. Dance is not an add-on to music; the two co-evolved.' },
  ],
};

const mcExpectMatch = {
  "prompt": "The guessing game — pair each move with what it does to the forecast:",
  "pairs": [
    {
      "left": "the perfect cadence",
      "right": "satisfies the forecast"
    },
    {
      "left": "the deceptive cadence (V to vi)",
      "right": "violates it just enough to register as a smile"
    },
    {
      "left": "syncopation",
      "right": "plays the same game against the beat prediction"
    },
    {
      "left": "a dominant seventh's tritone and minor seventh",
      "right": "create strong expectations for a specific resolution"
    }
  ],
  "why": "Composers manipulate the guessing — delay, satisfy, violate — and that guessing game, not any property of the sound itself, is the emotional ride."
};

const mcChillPredict = {
  "q": "Salimpoor's PET study found dopamine release in two phases. When does the chill itself typically arrive?",
  "choices": [
    "At the peak moment",
    "Just before the moment it belongs to",
    "Long after the peak has passed"
  ],
  "answer": 1,
  "why": "The chill frequently arrives just before the moment it belongs to — the body responding to the prediction as much as the event. Expectation theory, made physiological."
};

const mcEarwormJudge = {
  "statements": [
    {
      "s": "Earworm tunes tend to a faster tempo.",
      "truth": true,
      "why": "Faster tempo is part of the research profile of involuntary musical imagery."
    },
    {
      "s": "Their melodic contours are foreign to the listener's culture.",
      "truth": false,
      "why": "The contours are common to the listener's whole listening culture — with one or two unusual interval leaps marking them as distinct."
    },
    {
      "s": "The Zeigarnik effect frames them: the mind keeps unfinished business active.",
      "truth": true,
      "why": "A song that loops is, to the predictive brain, a pattern that keeps demanding resolution."
    },
    {
      "s": "An earworm is a malfunction of the memory system.",
      "truth": false,
      "why": "It is the normal behaviour of a predictive, memory-hungry brain — nearly everyone reports it."
    }
  ]
};

const mcSnowballBranch = {
  "root": "2009: does Snowball the cockatoo really synchronise to music, or just dance on cue? You are running the test.",
  "nodes": {
    "start": {
      "text": "What is the decisive test?",
      "choices": [
        {
          "label": "Change the music's tempo and watch whether his movements track it",
          "next": "tempo",
          "feedback": "Exactly the 2009 design — genuine entrainment means adjusting to a beat that moves."
        },
        {
          "label": "Film him dancing and count the energy",
          "next": "energy",
          "feedback": "Motivation is not synchrony — the capacity question stays open."
        }
      ]
    },
    "tempo": {
      "text": "Snowball genuinely adjusts his movements to changing tempos — the capacity can appear outside humans, but only in vocal-learning species, and nowhere near the precision of a human toddler keeping a beat.",
      "choices": []
    },
    "energy": {
      "text": "Enthusiasm proves nothing about the beat: dancing on cue is not beat-keeping. The decisive design changes the tempo and watches for tracking.",
      "choices": []
    }
  },
  "why": "Beat and body co-evolved — the metrical hierarchy taught in the rhythm lessons is a description of what the motor system is doing while it listens."
};

const mcSocietiesEstimate = {
  "prompt": "The 2019 Harvard-led cross-cultural study behind the universality findings covered how many societies across the world?",
  "unit": "societies",
  "answer": 315,
  "factor": 1.5,
  "why": "315 societies — every culture has music, and its social contexts recur: lullabies, dance songs, healing, love. Listeners can identify a lullaby from an unfamiliar culture above chance.",
  "context": "Enculturation then tunes the prediction engine to a particular tonal system within years."
};

const mcDissonanceTrace = {
  "prompt": "Beating between close frequencies produces physical roughness. Which curve matches the dissonance judgement as frequency separation grows?",
  "curves": [
    {
      "expr": "exp(-2*x)",
      "label": "roughness peaks just above unison, then decays"
    },
    {
      "expr": "x/2",
      "label": "roughness grows without limit with separation"
    },
    {
      "expr": "abs(sin(2*x))",
      "label": "roughness oscillates forever with separation"
    }
  ],
  "correct": 0,
  "x": {
    "min": 0,
    "max": 2
  },
  "y": {
    "min": 0,
    "max": 1
  },
  "xlabel": "frequency separation",
  "ylabel": "dissonance (roughness)",
  "why": "Plomp and Levelt's curve: beating is worst just above unison and fades as separation grows — but the same mathematics fails across cultures, because what the ear resolves and what the mind objects to are different questions."
};

const mcPitchPlace = {
  "prompt": "Absolute pitch is far more likely with exposure to musical training beginning at what age (years)?",
  "labels": [
    "0",
    "5",
    "10",
    "15",
    "20"
  ],
  "scale": {
    "min": 0,
    "max": 20
  },
  "answer": 5,
  "tolerance": 2,
  "why": "Early childhood — while relative skills remain learnable for life. The prediction engine is plastic, and 'talent' is a poor first explanation."
};

const mcLanguageSpot = {
  "prompt": "A podcast script about music and language contains one faulty line — click it:",
  "lines": [
    "Both music and language process structured sound and build syntactic-like expectations.",
    "Melodic intonation therapy helps stroke patients recover speech by routing language through singing and rhythm.",
    "The circuits are identical, so any brain damage that destroys speech also destroys song.",
    "The precise mapping between the two systems is an active frontier."
  ],
  "errorLine": 2,
  "correction": "The circuits diverge: damage can destroy speech while sparing song, and vice versa — the overlap is real but the systems are not the same machine.",
  "why": "Shared machinery is not identical machinery — the divergence is exactly what makes melodic intonation therapy possible."
};
---
<TopicPage slug="subjects/music/expert/music-cognition">
  <h2>Where you are, and what you will learn</h2>
  <p>
    This is the expert capstone of the Music ladder, and it leans directly on the vocabulary
    you built in Harmony and Chords, Rhythm and Time Signatures and Form and Structure.
    Those lessons taught what a dominant seventh, a syncopation and a chorus <em>are</em>;
    this one asks why listeners' brains respond to them — and shows that every term in the
    theory lessons names a lever on expectation.
  </p>
  <p>By the end you will be able to:</p>
  <ul>
    <li>explain hearing as prediction, and re-read cadence and syncopation as moves in a forecasting game;</li>
    <li>describe the physiological evidence for musical chills, including the two dopamine phases;</li>
    <li>analyse why some tunes become earworms, using the memory profile the research found;</li>
    <li>separate what is acoustic, what is learned and what is trained in dissonance and pitch judgements;</li>
    <li>evaluate music-therapy claims mechanistically, matching intervention to symptom.</li>
  </ul>

  <h2>The idea</h2>
  <p>
    Music cognition asks why sound organised this way moves human brains that way — the
    junction of music theory, psychology and neuroscience. It is the listening side of
    every theory lesson above: consonance and dissonance, cadences, syncopation, hooks
    and riffs all behave as compositional vocabulary <em>because</em> listeners' brains
    process them in specific, measurable ways. The unit's single syllabus topic — why
    brains find some patterns irresistible — is genuinely one deep question rather than
    a list: the same predictive machinery explains why a dominant seventh pulls toward
    the tonic, why a chord change can produce a physical shiver, why a chorus loops in
    the mind for days, and why every known culture dances. This chapter builds that
    machinery piece by piece, from anticipation to reward to memory to movement. It
    also carries a practical moral for anyone writing, teaching or producing music:
    the levers are the listener's expectations, and every term in the theory lessons
    names one of them.
  </p>

  <Widget no="1" caption="the four findings that connect theory to feeling" widget="equationStep" config={cognCfg} />
  <p>
    <strong>What to notice:</strong> the four steps are one mechanism seen from four angles —
    prediction (the ear guessing), reward (the chill when the guess lands), memory (the loop
    that will not close) and movement (the body syncing to the beat). Notice how each step
    converts a term from the theory lessons — resolution, frisson, hook, groove — into a
    measurable event in the listener. That conversion is the whole subject.
  </p>
  <p>
    <strong>So far:</strong> the listening brain is a forecasting engine, and composers
    compose against its guesses. The next section builds that claim step by step, from
    anticipation to reward to memory to movement, and ends with what is learned versus what
    is physical.
  </p>

  <h2>Why brains find some patterns irresistible</h2>
  <p>
    <strong>Hearing is prediction.</strong> The core finding of the field (Meyer, 1956;
    developed with modern evidence by David Huron in <em>Sweet Anticipation</em>, 2006)
    is that the listening brain is a forecasting engine: on the basis of the key, the
    metre and everything heard so far, it continuously guesses the next note, chord and
    beat — and registers a small emotional event when the guess pays off or fails. This
    is the mechanism behind vocabulary the harmony lessons treat as given. A dominant
    seventh chord is "tense" because its tritone and minor seventh create strong
    expectations for a specific resolution; the perfect cadence satisfies the forecast,
    the deceptive cadence (V to vi) violates it just enough to register as a smile, and
    syncopation plays the same game against the beat prediction. Composers manipulate
    the guessing — delay, satisfy, violate — and that guessing game, not any property of
    the sound itself, is the emotional ride.
  </p>
  <Widget no="2" caption="pair each compositional move with the game it plays" widget="match" config={mcExpectMatch} />
  <p>
    <strong>The chills are measurable.</strong> "Frisson" — the shiver a perfect
    modulation or an unexpectedly dropped beat produces — is a physiological event, not
    a figure of speech. Salimpoor and colleagues (2011, <em>Nature Neuroscience</em>)
    used PET imaging with a dopamine tracer while listeners heard music chosen to give
    them chills, and found dopamine release in the brain's reward circuitry in two
    distinct phases: in the caudate during the <em>anticipation</em> of a peak moment,
    and in the nucleus accumbens at the peak itself. The chill frequently arrives just
    before the moment it belongs to — the body responding to the prediction as much as
    the event — which is expectation theory made physiological.
  </p>
  <Widget no="3" caption="bet before you read on — when the shiver lands" widget="predict" config={mcChillPredict} />
  <p>
    <strong>Earworms are memory's loop mode.</strong> Tunes that stick — involuntary
    musical imagery — tend to share a profile: faster tempo, melodic contours common to
    the listener's whole listening culture, with one or two unusual interval leaps that
    mark them as distinct. The classic psychological framing is the Zeigarnik effect,
    the mind's tendency to keep unfinished business active; a song that loops is, to the
    predictive brain, a pattern that keeps demanding resolution. Chorus-writing is
    therefore applied memory psychology whether or not the writer knows it: simple,
    repetitive, slightly irregular — the exact parameters that make a pattern both easy
    to store and hard to close.
  </p>
  <Widget no="4" caption="true or false — the earworm profile" widget="judge" config={mcEarwormJudge} />
  <p>
    <strong>Music moves the body.</strong> Rhythmic entrainment — motor circuits
    synchronising to a beat — is near-automatic in humans and strikingly rare
    elsewhere. The famous test case is Snowball the cockatoo (Patel and colleagues,
    2009), genuinely adjusting his movements to changing tempos — evidence the capacity
    can appear outside humans, but only in vocal-learning species, and nowhere near the
    precision of a human toddler keeping a beat. Dance is thus not an add-on to music;
    beat and body co-evolved, and the metrical hierarchy taught in the rhythm lessons
    is a description of what the motor system is doing while it listens.
  </p>
  <Widget no="5" caption="walk the experiment — does the bird entrain?" widget="branch" config={mcSnowballBranch} />
  <p>
    <strong>The universal and the learned.</strong> A 2019 Harvard-led study (Mehr and
    colleagues) of 315 societies across the world confirmed a reliable core: every
    culture has music, and music's social contexts recur — lullabies, dance songs,
    healing, love. Listeners can identify a lullaby from an unfamiliar culture above
    chance, and tonal centres appear everywhere. Yet the weighting is genuinely both
    nature and nurture: enculturation tunes the prediction engine to a particular
    tonal system within years, which is why the intervals that sound inevitable to you
    are conventions your brain has trained on. Even infants respond most warmly to the
    song styles their carers actually use with them — the loop between culture and
    prediction closes from the first months of life.
  </p>
  <Widget no="6" caption="call the magnitude — one study's reach" widget="estimate" config={mcSocietiesEstimate} />
  <p>
    <strong>Where the sound ends and the brain begins.</strong> Some of the machinery
    is acoustic: notes an octave or a fifth apart share overtones, and the beating
    between close frequencies produces a physical roughness that tracks dissonance
    judgments remarkably well — Plomp and Levelt mapped the curve in 1965. But the same
    mathematics that predicts Western dissonance judgments fails across cultures,
    because what the ear resolves and what the mind objects to are different questions.
    Overtone structure supplies the raw material; a listening culture, trained from
    infancy on its own scales and tunings, decides which combinations count as smooth.
    The irresistible patterns are co-productions: physics proposes, enculturation
    disposes.
  </p>
  <Widget no="7" caption="which curve matches the dissonance judgement?" widget="trace" config={mcDissonanceTrace} />
  <p>
    <strong>Training rewrites the instrument.</strong> The prediction engine is
    plastic: musicians' auditory and motor regions remodel measurably with years of
    practice, and some abilities have sensitive periods — absolute pitch, the ability
    to name a note cold, is far more likely in people exposed to musical training
    early in childhood, while relative skills remain learnable for life. This is why
    "talent" is a poor first explanation: the enculturation every listener receives
    passively already does most of the work, and deliberate practice builds on it.
    The skill gradient across listeners is real — trained listeners hear more
    <em>different</em> things in the same chord — but it is a gradient of training,
    memory and attention, not a separate kind of brain.
  </p>
  <Widget no="8" caption="place the sensitive period on the age scale" widget="place" config={mcPitchPlace} />
  <p>
    <strong>Music and language share machinery — but are not the same machine.</strong>
    Both process structured sound and both build syntactic-like expectations, and the
    overlap has clinical value: melodic intonation therapy helps stroke patients
    recover speech by routing language production through singing and rhythm. But the
    circuits diverge — damage can destroy speech while sparing song, and vice versa —
    and the precise mapping between the two systems is an active frontier.
  </p>
  <Widget no="9" caption="find the faulty line — the music-language claim" widget="spot-error" config={mcLanguageSpot} />
  <p>
    <strong>Therapy is real, and its mechanisms are partly known.</strong> Rhythmic
    auditory stimulation measurably improves gait in Parkinson's disease (external
    timing substituting for degraded internal timing); music reliably evokes
    autobiographical recall in dementia, where imaging shows musical memory drawing on
    regions relatively spared by early Alzheimer's; and music therapy reduces anxiety
    around medical procedures. What the trials increasingly show is specificity:
    timing-based interventions help timing-based symptoms, memory-based ones help
    recall — mechanism-matched therapy, not music as a general tonic. Each application
    runs on one of the mechanisms above —
    entrainment, memory, reward — which is why music cognition is one of the strongest
    bridges between the music ladder and the neuroscience one.
  </p>
  <p>
    <em>Common misconception:</em> "consonance is a physical fact — simple frequency
    ratios just sound good everywhere." A 2016 study of the Tsimane', an Amazonian
    society with little exposure to Western music, found no preference for consonant
    over dissonant chords. Ratios matter, but liking is learned; the consonance the
    theory lessons rely on is a cultural training of a biological prediction system.
  </p>
  <p>
    <em>Common misconception:</em> "the Mozart effect makes babies smarter." The 1993
    finding was a small, short-lived improvement in adults' spatial task performance
    after listening; the "classical music makes infants intelligent" version failed
    replication and was never claimed by the original authors — even as US states
    were shipping classical CDs to maternity wards.
  </p>
  <p>
    <em>Common misconception:</em> "music is right-brained, language left-brained."
    Music listening and performance recruit networks across both hemispheres —
    auditory prediction, motor timing, reward and memory — and trained musicians show
    enlarged, better-connected structures on both sides. The pop-neuroscience slogan
    survives only by ignoring what brains actually do when the music plays.
  </p>
  <p>
    <em>Common misconception:</em> "earworms mean something is wrong with you."
    Involuntary musical imagery is the normal behaviour of a predictive, memory-hungry
    brain: nearly everyone reports it, it clusters when the mind is under-stimulated
    or under-slept, and only the rare distressing, intrusive forms are clinical at
    all. The loop is a feature of the machinery this chapter describes, not a
    malfunction of it.
  </p>
  <p>
    <strong>So far:</strong> one predictive engine explains the whole inventory — why
    cadences resolve, why chills peak, why choruses loop, why bodies move — with
    enculturation tuning the engine to a tonal system and training tuning it further. The
    sections ahead push the same engine into harder territory: why music exists at all, and
    how the theory becomes formal and quantitative.
  </p>

  <h2>Check yourself</h2>
  <p>Try these before moving on. Feedback follows each answer.</p>
  <ol>
    <li>Salimpoor's PET study found dopamine release in two brain regions at two moments. Name each region and the moment it belongs to.</li>
    <li>A producer wants a dance track that maximises the urge to move. Using the lesson's account of groove, what should they do with the beat and with the notes?</li>
    <li>Why does rhythmic auditory stimulation help gait in Parkinson's disease while a general playlist does not help recall in dementia the way familiar songs do? Frame your answer as mechanism-matched therapy.</li>
  </ol>
  <p>
    <strong>Feedback:</strong> (1) Dopamine in the caudate during the <em>anticipation</em> of
    a peak moment, and in the nucleus accumbens at the peak itself — the body responding to
    the prediction before the event, which is expectation theory made physiological. (2) Keep
    the beat predictable while making the notes moderately syncopated: moderate syncopation
    maximises the urge to move because motor circuits can lock onto the pulse even as the
    notes surprise it — too much surprise and the beat itself is lost. (3) Timing-based
    interventions help timing-based symptoms: an external pulse carries a degraded internal
    clock for walking. Memory-based interventions help recall: musical memory draws on regions
    relatively spared by early Alzheimer's. A general playlist matches neither mechanism —
    the trials show specificity, not music as a general tonic.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>Hearing is prediction: the listening brain forecasts the next note, chord and beat, and emotion rides on the guess.</li>
    <li>Cadences, syncopation and modulations are moves in that forecasting game — satisfy, delay or violate.</li>
    <li>Musical chills are measurable: dopamine in the caudate during anticipation, in the nucleus accumbens at the peak.</li>
    <li>Earworms are a loop mode of memory — simple, repetitive, slightly irregular, never quite resolved.</li>
    <li>Entrainment makes the body a part of the music; beat and body co-evolved.</li>
    <li>Dissonance liking is enculturated: physics proposes the raw material, culture decides what counts as smooth.</li>
    <li>Music therapy works when the mechanism matches the symptom — entrainment for timing, spared memory regions for recall.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    Music Cognition is currently the expert summit of the Music ladder, so the next steps are
    the neighbours below it: Form and Structure and Instruments and Timbre supply the
    compositional vocabulary whose psychological levers this lesson explained, and Harmony
    and Chords is where the cadence games you can now re-read were first introduced.
  </p>

  <h2>Going deeper</h2>
  <p>
    <strong>Why does music exist at all?</strong> No survival function is obvious, and
    the candidates still compete. Darwin's own proposal was sexual display
    (song as the human peacock's tail); the social-bonding hypothesis points to
    synchronised singing and dancing producing group cohesion — oxytocin and pain
    thresholds rise after group singing — with lullabies as the parent–infant case;
    and the by-product view holds that music is pleasurable scaffolding on an auditory
    system built for other pattern work. Evidence accumulates unevenly on all three,
    which is what makes it one of the honest open debates in evolutionary psychology.
    Recent cross-cultural work sharpens the bonding view: song and dance co-occur with
    cooperative contexts across the 315-society corpus, and synchrony experiments show
    small causal boosts to trust and coordination — suggestive, not decisive.
  </p>
  <p>
    <strong>Formalising expectation.</strong> Huron's ITPRA framework splits the
    prediction response into pre-outcome and post-outcome phases — imagination,
    tension and prediction before the event; reaction, appraisal and reflection after —
    and computational models make it quantitative: systems such as Pearce's IDyOM
    learn the statistics of melodic corpora and predict next notes with measurable
    accuracy, and listeners' surprise (information-theoretic entropy reduced) tracks
    the model's errors. Predictive-coding neuroscience then closes the loop: the
    brain as hierarchy of predictions, music as a stimulus engineered to manage them.
    The formalisation explains a composer's craft — the strongest emotional events
    sit just where the model is confident and the composer breaks it.
  </p>
  <p>
    <strong>Timing networks.</strong> The motor findings run deeper than toe-tapping:
    beat perception recruits basal-ganglia and supplementary-motor circuits that
    overlap with those used for movement itself, and the strength of a person's
    auditory–motor link predicts how well they keep a beat. This convergence of
    listening and moving is the likely reason rhythm works as therapy: an external
    pulse can carry a degraded internal clock, whether the task is walking with
    Parkinson's or speaking after stroke. It also explains groove — moderate
    syncopation maximises the urge to move by keeping the beat predictable while the
    notes surprise.
  </p>
  <p>
    <strong>Frontier questions.</strong> How much of tonal cognition is universal
    versus enculturated is being measured with cross-cultural experiments rather than
    asserted; the music–language interface (shared syntax processing, divergent
    meaning) is being mapped with lesion and imaging studies; music therapy trials
    are moving from "does it help" to "which mechanism, for which patient"; and
    AI-generated music has become an unexpected instrument for the science itself —
    machine compositions that vary expectation and surprise parametrically let
    researchers test the prediction theory of emotion with experimental control no
    composer's back-catalogue allows. The topic that looked like one question — why
    brains find patterns irresistible — is turning out to be the entry point to how
    brains do anything at all.
  </p>

  <p class="sources"><strong>Sources:</strong> Huron, Sweet Anticipation (2006); Salimpoor et al., Nature Neuroscience (2011); Mehr et al., Behavioral and Brain Sciences (2019); Savage et al., "Universal features of music". Source text: OpenStax (https://openstax.org), CC BY 4.0 — adapted for Interactive Atlas.</p>
</TopicPage>

