      "choices": []
    }
  },
  "why": "Security has three legs: availability, access and stability. The design question is never just how much is grown — it is who can buy, at what price, through what shock."
};

const agWasteMatch = {
  "prompt": "Where the loss happens determines what fixes it. Match each to its lever:",
  "pairs": [
    {
      "left": "poorer countries — post-harvest loss",
      "right": "hermetic storage bags, rural roads, solar cold rooms"
    },
    {
      "left": "richer countries — consumer and retail waste",
      "right": "labelling reform, dynamic pricing, redistribution, norms"
    },
    {
      "left": "cosmetic standards and date-label confusion",
      "right": "retail standards and confusion around best-before dates"
    },
    {
      "left": "livestock products' land and water per calorie",
      "right": "diet composition — the EAT-Lancet shift toward plants"
    }
  ],
  "why": "In poorer regions the highest-return investments are unglamorous infrastructure; in richer ones they are labels, pricing and norms. The demand side holds the single biggest lever."
};

const agFootprintTrace = {
  "prompt": "Relative greenhouse-gas footprint per kilogram of food. Which curve shows the shape the lesson describes — where what you eat dwarfs where it came from?",
  "curves": [
    {
      "expr": "0.5 + 0.02*x",
      "color": "#94a3b8",
      "label": "a gentle rise — transport and distance dominate"
    },
