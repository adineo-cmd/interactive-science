const csaCfg = {
  steps: [
    { math: '1 · Agriculture is hit and cause', note: 'The sector absorbs climate damage (heat-stressed yields, water chaos, pest range shifts) while emitting ~a quarter of greenhouse gases — the climate lesson\'s numbers. Climate-smart agriculture = produce more, on a hotter planet, with fewer emissions.' },
    { math: '2 · Adaptation on the farm', note: 'Drought-tolerant varieties (DT maize spreading across Africa — the breeding lesson\'s delivery), water harvesting and drip (the water lesson), adjusted planting dates, agroforestry\'s microclimate, index-based livestock insurance (payout by rainfall index — no claims adjusters needed).' },
    { math: '3 · Mitigation from the soil up', note: 'Soil carbon sequestration (regenerative practices — the soil lesson, with carbon payments attached), enteric-methane feed additives, rice paddy water management (methane falls when paddies drain mid-season), and fertiliser precision (N₂O — the geochemical lesson\'s greenhouse nobody quotes).' },
    { math: '4 · The carbon-market question', note: 'Soil carbon credits: real mechanism, real measurement problems (additionality, permanence, verification — the offsets critique in the environmental-economics lesson). Buyers now pay for measured outcomes, not practices claimed — the discipline tightening in real time.' },
  ],
};

const agSoilClockEstimate = {
