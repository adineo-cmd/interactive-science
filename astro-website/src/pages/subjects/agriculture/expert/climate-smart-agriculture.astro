const agReboundPredict = {
  "q": "A region converts all its irrigation to drip, which is 90%+ efficient. What did the water saving do to aquifer depletion?",
  "choices": [
    "It reversed the decline, since less water was withdrawn per hectare",
    "It often accelerated depletion, because the saving funded more irrigated land and thirstier crops",
    "It had no measurable effect either way",
    "It eliminated the need for allocation rules entirely"
  ],
  "answer": 1,
  "why": "Efficiency gains often increase consumption — the rebound effect, measured repeatedly in efficient-irrigation programmes that accelerated depletion. Water saved per hectare is real; water saved by the basin depends on what the saving funds."
};

const agClimateOrganicSpot = {
  "prompt": "A student weighs organic farming's climate case. One line is wrong — find it.",
  "lines": [
    "The accounting is genuinely two-sided, so the label alone settles nothing.",
    "Organic fields cut on-farm emissions — no synthetic nitrogen, whose manufacture is energy-intensive — and build soil carbon.",
    "Typical organic yields run a fifth HIGHER, so feeding the same population needs less land.",
    "Land-use change (forests converted) emits far more than the fertiliser saved.",
    "Per unit of product some organic crops come out ahead and some behind."
  ],
  "errorLine": 2,
  "correction": "Typical organic yields run roughly a fifth LOWER, so feeding the same population needs MORE land — which is where the land-use change emissions come from.",
