  "prompt": "Drag the divider: the same slope, two ways of preparing the ground.",
  "before": {
    "label": "bare conventional ground",
    "text": "Structure broken by tillage, nothing on the surface. Every raindrop lands on aggregates, runoff gathers, and soil loss runs at conventional rates - while a warmer atmosphere holds about 7% more water per degree, so each storm arrives heavier than the last."
  },
  "after": {
    "label": "no-till with residue cover",
    "text": "Raindrops hit cover instead of aggregates, structure stays intact, infiltration is up and runoff down. Combined with contours, terraces and buffer strips - each a way of shortening the slope - soil loss commonly falls by an order of magnitude."
  },
  "why": "Every tonne kept is simultaneously a fertility saving (topsoil is where organic matter and nutrients concentrate) and a climate co-benefit: less carbon oxidised, less sediment and nutrient delivered to waterways."
};

const agRicePlace = {
  "prompt": "Alternate wetting and drying lets rice paddies drain mid-season. Place the typical methane reduction reported in field trials.",
  "labels": [
    "0%",
    "10%",
    "25%",
    "40%",
    "90%"
  ],
  "scale": {
    "min": 0,
    "max": 100
  },
  "answer": 40,
