import Widget from '../../../../components/Widget.astro';

const precCfg = {
  steps: [
    { math: '1 · Measure the variation', note: 'GPS-guided soil sampling, yield monitors (every combine ships with one now), satellite and drone imagery (NDVI — the remote-sensing lesson\'s agriculture wing): fields stop being averages and become zone maps.' },
    { math: '2 · Act at sub-metre resolution', note: 'Variable-rate applicators change seed, fertiliser and spray rates on the go from prescription maps; auto-steer tractors repeat passes to 2 cm — overlap eliminated (fuel, inputs, soil compaction), and the driver freed to monitor.' },
    { math: '3 · The economics is zone arithmetic', note: 'Every hectare has its own response curve (the fertiliser lesson\'s diminishing returns, spatially indexed): precision ag spends data money to stop over-feeding high ground and under-feeding low ground — savings of 10–20% on inputs are typical once maps are trusted.' },
    { math: '4 · The data stack', note: 'Farm management software fuses soil, yield, weather, imagery and machinery data into decisions (the data-science lesson\'s pipeline, agrarian edition); the open question is data ownership — who owns the yield map, farmer or platform, is agriculture\'s quiet antitrust fight.' },
  ],
};
---
<TopicPage slug="subjects/agriculture/advanced/precision-agriculture">
  <h2>The idea</h2>
  <p>
    Precision agriculture is <strong>the sensor-and-data revolution applied to fields</strong> —
    GPS, imagery and variable-rate machinery turning every farm into a mapped, measured system.
    The payoff: inputs go where they pay, and stop where they don\'t.
  </p>

  <Widget no="1" caption="measure, act at resolution, zone economics, the data stack" widget="equationStep" config={precCfg} />

  <h2>Current capability and frontier</h2>
  <ul>
    <li><strong>Guidance paid for itself first:</strong> auto-steer is the adoption leader — pure cost saving, no agronomy risk; RTK correction networks (the GPS lesson\'s cm-accuracy) now blanket major farming regions.</li>
    <li><strong>See-and-spray changes the herbicide game:</strong> cameras + machine vision identify weeds and spray only them — herbicide use down ~60–90% per pass in trials (the AI lesson\'s image recognition, weeding); the resistance lesson\'s pressure eased by precision.</li>
    <li><strong>Drones and satellites split the work:</strong> satellites give free revisit frequency (Sentinel — the geography lesson), drones give resolution on demand; the recipe uses both — satellites to find, drones to verify, boots to decide.</li>
    <li><strong>The adoption S-curve is uneven:</strong> large farms in rich regions lead (scale amortises the kit); smallholders are reached through co-ops, shared machinery services and phone-based advisories — the development lesson\'s last-mile question, precision edition.</li>
  </ul>
  <p class="sources"><strong>Sources:</strong> Zhang, Wang & Wang, "Precision agriculture" reviews; USDA precision-ag adoption surveys; the remote-sensing and data-science lessons.</p>
</TopicPage>
