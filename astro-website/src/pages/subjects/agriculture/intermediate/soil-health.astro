const agPhGateBranch = {
  "root": "A crop looks pale and hungry. A pH test comes back 5.1 — below the 6.0–7.0 window — with exchangeable aluminium rising. The nutrient bag is already in the shed. What comes first?",
  "nodes": {
    "start": {
      "text": "At pH 5.1 the nutrients may be present but locked away — and below 5.5 exchangeable aluminium turns soluble and poisons roots directly.",
      "choices": [
        {
          "label": "Apply the fertiliser now — the crop is clearly short of something",
          "next": "blind",
          "feedback": "Blind fertilising of an acid field is the lesson's most common small-farm waste."
        },
        {
          "label": "Lime the soil toward the 6.0–7.0 window, then re-test",
          "next": "lime",
          "feedback": "Liming acid soil precedes every fertiliser recommendation."
        }
      ]
    },
    "blind": {
      "text": "You paid for nutrients the pH gate will not let the roots reach, and the aluminium is still poisoning the root tips.",
      "choices": []
    },
