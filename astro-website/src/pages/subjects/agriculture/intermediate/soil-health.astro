  "factor": 2,
  "why": "Roughly a century per centimetre. Erosion on exposed farmland runs 10–100× faster — which is why losing topsoil is geological vandalism on a human timescale.",
  "context": "A centimetre a century: a hand's depth of topsoil is a millennium's work."
};

const agHorizonOrder = {
