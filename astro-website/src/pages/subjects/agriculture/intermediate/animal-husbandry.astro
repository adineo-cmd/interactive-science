    { math: '2 · Breeding programmes', note: 'Selective breeding transformed growth rates (broilers reach market weight in 6 weeks vs 12 in 1950 — welfare debates included); artificial insemination and genomic selection compressed generations. The genetics lesson\'s heritability arithmetic, industrialised.' },
    { math: '3 · Health = economics', note: 'Biosecurity (quarantine, disinfection) prevents what antibiotics used to cure; vaccination schedules; welfare indicators (lameness, behaviour) correlate with productivity — the welfare-science convergence is measurable, not sentimental.' },
    { math: '4 · The systems spectrum', note: 'Pasture (low input, low density), mixed crop-livestock (nutrient cycling — the pasture feeds the soil), intensive (controlled environment, highest efficiency per animal, highest capital). Each fits a different land, labour and capital situation (the economics lesson\'s factor endowments, farmed).' },
  ],
};

const agFcrOrder = {
  "prompt": "Feed conversion ratio is kilograms of feed per kilogram of live-weight gain. Order these from BEST converter to WORST:",
  "items": [
    "Chickens — about 1.7 kg feed per kg gain",
    "Pigs — about 3 kg feed per kg gain",
    "Beef cattle — about 6–10 kg feed per kg gain"
  ],
  "why": "The trophic lesson's ten-percent law compounded through another level. Ruminants' offsetting superpower is rumen fermentation: microbes digest cellulose, converting grass and crop residues that humans and pigs cannot eat."
};

const agWaterEstimate = {
  "prompt": "How many litres of water does a dairy cow drink in a day?",
  "unit": "litres per day",
  "answer": 80,
  "factor": 1.6,
  "why": "60–100 litres a day, so about 80 is the working figure. Water is the first nutrient and the most forgotten: intake limits milk before any other factor.",
  "context": "Roughly a bathtub's worth, every day, before a single kilogram of feed is counted."
};

