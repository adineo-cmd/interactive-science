  },
  "after": {
    "label": "newborn piglet",
    "text": "Needs 30–34 °C at birth. Far outside that range a piglet huddles and chills — which is why farrowing rooms run heat lamps over cold-snouted mothers, heating the small animal rather than the whole room."
  },
  "why": "Housing exists to control what weather does to productivity and health. Outside the thermal comfort zone, feed intake shifts to thermoregulation instead of production."
};

const agBiosecurityBuckets = {
  "prompt": "Livestock health is managed as a herd problem. File each measure:",
  "buckets": [
    "Keeps disease out",
    "Manages resistance",
    "Scores welfare"
  ],
  "items": [
    {
      "label": "boot dips, dedicated clothing, rodent and wild-bird control",
      "bucket": 0
    },
    {
      "label": "all-in/all-out batching with disinfection between groups",
      "bucket": 0
    },
