  "why": "Nearly every major livestock disease is a management-system disease first and an infection second: the vet treats the case, the husbandry treats the rate."
};

const agGrainPredict = {
  "q": "What is the honest nutritional comparison between grass-fed and grain-fed ruminant production?",
  "choices": [
    "Grain-fed is simply better-fed, so it is always the higher standard",
    "Grass is always superior, so grain feeding has no defensible role",
    "Not grass vs grain, but what could this land grow otherwise — a systems question",
    "The comparison is meaningless because both feeds have identical composition"
  ],
  "answer": 2,
  "why": "Cattle cannot thrive on grain alone — rumen acidosis is the feedlot vet's daily case. Much ruminant production is valuable precisely because it runs on land and by-products unsuited to crops, so the question is a systems one, not a feed label."
};

const agComfortTrace = {
