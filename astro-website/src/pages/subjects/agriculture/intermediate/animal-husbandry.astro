      "expr": "7*exp(-((x-32)*(x-32))/120)",
      "color": "#dc2626",
      "label": "a peak up at newborn-piglet temperatures"
    }
  ],
  "correct": 0,
  "x": {
    "min": 0,
    "max": 40
  },
  "y": {
    "min": 0,
    "max": 8
  },
  "xlabel": "air temperature (°C)",
  "ylabel": "relative performance",
