const agBreedingSpot = {
  "prompt": "A student summarises the breeding record. One line is wrong — find it.",
  "lines": [
    "Selective breeding is husbandry's slow machine, and it compounds.",
    "Broiler chickens reached about 2.5 kg in 12 weeks in the 1950s; the modern bird does it in under 6 weeks.",
    "Pure selection for maximum production proved the winning long-run strategy, so indices weight yield alone.",
    "Artificial insemination let one elite bull sire hundreds of thousands of daughters.",
    "Genomic selection genotypes calves at birth and predicts lifetime performance, halving the generation interval."
  ],
  "errorLine": 2,
  "correction": "Pure production selection bred animals that grew brilliantly and fell apart reproductively; modern indices weight longevity, health and foot traits alongside yield.",
  "why": "The industry ran that experiment and paid for it in the 1990s. Low-heritability traits like fertility and disease resistance respond slowly, so they need deliberate selection pressure in a balanced index."
};

const agMastitisMatch = {
  "prompt": "Mastitis is the costliest dairy disease. Match each control to what it actually targets:",
  "pairs": [
    {
      "left": "clean, dry teats and post-milking dips",
      "right": "contagious bacteria spreading cow-to-cow at milking"
    },
