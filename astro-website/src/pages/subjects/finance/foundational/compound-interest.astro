---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const growthCfg = {
  curves: [
    { expr: 'p*(1 + r)^x', label: 'compounded', color: '#064e3b', width: 2.4 },
    { expr: 'p*(1 + r*x)', label: 'simple interest', color: 'rgba(23,36,32,0.5)' },
  ],
  params: [
    { name: 'p', label: 'principal p', min: 1000, max: 100000, step: 500, value: 10000 },
    { name: 'r', label: 'annual rate r', min: 0, max: 0.15, step: 0.005, value: 0.08, unit: 'as decimal' },
  ],
  x: { min: 0, max: 40, label: 'years' },
  crossings: false,
  height: 360,
};

const ciTimePredict = {
  "q": "At 8%, £100 in hand becomes £108 in a year. What is a promise of £100 next year worth today?",
  "choices": [
    "£100 — a promise is a promise",
    "About £92.59 — 100 ÷ 1.08",
    "£108 — discounting is compounding"
  ],
  "answer": 1,
  "why": "The promise discounts back to less than £100 because the cash in hand can grow in the meantime — every loan, bond, mortgage and pension is an application of that one sentence."
};

const ciCurveCompare = {
  "prompt": "The same rate, two maths — drag the divider:",
  "before": {
    "label": "Simple interest",
    "text": "The same pounds every year on the original principal — a straight line forever, because the earnings are implicitly spent."
  },
  "after": {
    "label": "Compounded",
    "text": "Each year's base is bigger than the last — a curve that steepens without limit. And it cuts both ways: debts compound exactly as enthusiastically as savings."
  },
  "why": "Over 40 years at 8%, £10,000 grows to about £217,000 compounded but only £42,000 with simple interest — the reinvestment alone is worth five times the original deposit."
};

const ciEffectiveEstimate = {
  "prompt": "A bank quotes 12% nominal, paid monthly. What effective annual rate does the compounding deliver?",
  "unit": "% effective",
  "answer": 12.68,
  "factor": 1.15,
  "why": "(1.01)¹² ≈ 12.68% — the gap between quoted and effective grows with both the rate and the frequency, which is exactly where card issuers and payday lenders place their quotes."
};

const ciRuleOrder = {
  "prompt": "Rule of 72 — order the doubling times, fastest first:",
  "items": [
    "36% APR credit-card debt — 2 years",
    "12% — 6 years",
    "8% — 9 years",
    "3% — 24 years (barely outpacing inflation's own compounding)"
  ],
  "why": "Divide 72 by the annual percentage rate — and the rule runs the other way on debt: paying only the minimum can take decades and cost multiples of the original debt, because most of each minimum payment is new interest."
};

const ciDiscountSpot = {
  "prompt": "One line of this discounting memo is wrong — click it:",
  "lines": [
    "A promise of £1,000 in five years is worth about £783 today at a 5% discount rate.",
    "At 10% the same promise shrinks to £621.",
    "Stretch it to thirty years and the value shrinks toward zero (£231 at 5%, £57 at 10%).",
    "The longer the wait, the less the value responds to the rate.",
    "Rising rates lower the present value of everything already promised."
  ],
  "errorLine": 3,
  "correction": "The longer the wait, the MORE rate-sensitive the value — distant money swings hardest, which is why long-maturity bonds fall hardest when rates rise.",
  "why": "Discounting is compounding's mirror: each distant payment shrinks by the growth factor raised to its waiting time, so the rate bites hardest where the waiting is longest."
};

const ciSkewBuckets = {
  "prompt": "Skewed payoffs, probability-weighted — which businesses run on that structure?",
  "buckets": [
    "runs on skewed, probability-weighted payoffs",
    "does not"
  ],
  "items": [
    {
      "label": "venture capital — one +50% pays for the frequent small losses",
      "bucket": 0
    },
    {
      "label": "insurance — premiums in, occasional large payouts out",
      "bucket": 0
    },
    {
      "label": "lottery pricing — the same logic in both directions",
      "bucket": 0
    },
    {
      "label": "a government bond's coupon, paid on schedule",
      "bucket": 1
    },
    {
      "label": "a savings account's near-certain return",
      "bucket": 1
    }
  ],
  "why": "The occasional large gain paying for frequent small losses is the entire logic of those industries — and it is why an 8% expected return on shares exists precisely because the distribution includes bad years a government bond does not."
};

const ciBandPlace = {
  "prompt": "A market with a 10% mean and 16% standard deviation: where does the lower edge of its one-standard-deviation band sit on the annual-return scale?",
  "labels": [
    "−40%",
    "−24%",
    "−8%",
    "+8%",
    "+24%",
    "+40%"
  ],
  "scale": {
    "min": -40,
    "max": 40
  },
  "answer": -6,
  "tolerance": 1.5,
  "why": "One SD below the 10% mean is −6%: about a sixth of years land outside −6% to +26%, and the 95% range spans roughly −22% to +42% — risk is the width of the annual experience, not the sign of the average."
};

const ciAmortMatch = {
  "prompt": "The compound-interest curve pointed both ways — pair each line with its number:",
  "pairs": [
    {
      "left": "Month-one interest on a £200,000 mortgage at 6%",
      "right": "£1,000 — the balance × 0.5%"
    },
    {
      "left": "Month-one principal reduction",
      "right": "£289 of the £1,289 payment"
    },
    {
      "left": "Total paid over the 25 years",
      "right": "≈ £386,700 — nearly double the loan"
    },
    {
      "left": "£1,000 a year forever at 5%",
      "right": "£20,000 today — payment ÷ rate"
    }
  ],
  "why": "Early payments are mostly interest because the balance being compounded against you is largest — overpaying early removes years from the tail; the annuity runs the same mathematics in reverse, and the infinite stream still sums to a finite number."
};
---
<TopicPage slug="subjects/finance/foundational/compound-interest">

  <h2>Where you are, and what you will learn</h2>
  <p>
    This is an early lesson in Finance. You need nothing from earlier lessons — only
    arithmetic (multiply, divide, powers) and patience with one idea at a time. Everything
    else is built here, step by step.
  </p>
  <p>By the end you will be able to:</p>
  <ul>
    <li>state the time value of money — why money today is worth more than money later — and use it as the master sentence behind loans, bonds, mortgages and pensions;</li>
    <li>compute future and present values with FV = P × (1 + r)ⁿ and PV = FV ÷ (1 + r)ⁿ, including what compounding frequency changes;</li>
    <li>use the rule of 72 to estimate doubling times, in savings and in credit-card debt;</li>
    <li>compute an expected return, read a return distribution with mean and standard deviation, and explain volatility drag;</li>
    <li>explain what risk-adjusted return, correlation and diversification actually measure — and what they do not protect against;</li>
    <li>read an amortisation schedule and see why early mortgage payments are mostly interest.</li>
  </ul>
  <p>
    One habit: whenever a rate appears — interest, growth, inflation, fees — ask "compounded
    over what, at what frequency?". Every rate compounds, and this lesson is about what
    that single fact does over time.
  </p>

  <h2>The first law of finance: money has a clock</h2>
  <p>
    Finance is the craft of moving value through time, and its first law is that
    <strong>money today is worth more than money later</strong> — because money today can
    be put to work and earn money. £100 in hand can become £108 in a year at 8%, so a
    promise of £100 next year is worth something less than £100 now. Every loan, bond,
    mortgage, pension and company valuation is an application of that one sentence.
  </p>
  <Widget no="2" caption="bet before you read on — the promise discounted" widget="predict" config={ciTimePredict} />
  <p>
    <strong>Compound interest</strong> is what happens when the earnings themselves start
    earning: growth on growth, year after year. Simple interest pays the same pounds every
    year on the original principal — the interest is, implicitly, spent. Compounding
    reinvests it, so each year's base is bigger than the last. It is the most important
    mechanism in personal finance, and it cuts both ways: it compounds debts exactly as
    enthusiastically as savings.
  </p>
  <Widget no="3" caption="drag the divider — the line vs the curve" widget="compare" config={ciCurveCompare} />

  <Widget no="1" caption="the same rate, two maths — the gap between the curves is compounding, and it widens forever" widget="plotter" config={growthCfg} />

  <p>
    <strong>What to notice:</strong> slide the rate r. At 8%, compounded money roughly
    <strong>doubles every 9 years</strong> — the curve steepens noticeably by year 30.
    Simple interest stays a straight line forever. The gap between the two curves is not a
    rounding difference: over 40 years at 8%, £10,000 grows to about £217,000 compounded
    but only £42,000 with simple interest — the reinvestment alone is worth five times the
    original deposit. Now slide r down toward 3% and watch both curves flatten: the gap
    still widens, but the compounded curve itself has lost most of its climb — the rate is
    an exponent, and small changes in it dominate everything else.
  </p>
  <p>
    <strong>So far:</strong> one law (money today beats money later) and one mechanism
    (interest on interest). Next, the exact arithmetic — forward, backward, and at any
    compounding frequency.
  </p>

  <h2>The arithmetic: one formula, forward and backward</h2>
  <p>
    The forward formula is <code>FV = P × (1 + r)ⁿ</code>: principal times the growth
    factor raised to the number of periods. Work it concretely: £10,000 at 8% for 3 years
    is 10,000 × 1.08³ = 10,000 × 1.2597 ≈ £12,597 — year by year, £10,800, then £11,664,
    then £12,597.17, the last figure carrying the tell-tale extra pence of
    growth-on-growth. The general form with compounding frequency p (payments per year) is
    FV = P × (1 + r/p)ⁿˣᵖ — the rate is divided by p and the exponent multiplied by p,
    which is why frequency matters at all.
  </p>
  <p>
    Compounding frequency matters more than intuition suggests: a nominal 12% paid monthly
    is 1% per month, which compounds to (1.01)¹² ≈ 12.68% per year. Banks and card issuers
    quoting "APR" versus "effective annual rate" are separating exactly this effect, and
    the difference is why a mortgage's small print is worth reading.
  </p>
  <Widget no="4" caption="call the effective rate — the small print" widget="estimate" config={ciEffectiveEstimate} />
  <p><em>Common misconception:</em> a quoted annual rate and an effective annual rate are
  the same thing — "12% is 12%". They differ whenever interest compounds more than once a
  year: 12% nominal paid monthly delivers 12.68% effective, because each month's interest
  itself earns interest for the remaining months. The gap grows with both the rate and the
  frequency, which is exactly where card issuers and payday lenders place their quotes.</p>
  <p>
    The <strong>rule of 72</strong> is the working shortcut: divide 72 by the annual
    percentage rate to get the doubling time. 72 ÷ 8 = 9 years; 72 ÷ 12 = 6 years; 72 ÷ 3
    = 24 years (which is why "risk-free" savings at 3% barely outpace inflation's own
    compounding — more on that below). The same rule runs the other way: a credit card
    balance at 36% APR doubles what you owe in two years. The "minimum payment" trap is
    exponential arithmetic pointed at you — paying only the minimum on a £3,000 card
    balance at typical rates can take decades and cost multiples of the original debt,
    because most of each minimum payment is new interest.
  </p>
  <Widget no="5" caption="line up the doubling times, fastest to slowest" widget="order" config={ciRuleOrder} />
  <p>
    Run the formula backward and you get <strong>present value</strong> — the single
    most-used number in professional finance: <code>PV = FV ÷ (1 + r)ⁿ</code>. Discounting
    is compounding's mirror, and it converts all of a project's or bond's future cash flows
    into today's terms, where they can be added and compared — the <strong>net present
    value</strong> (NPV) rule says take investments whose discounted inflows exceed the
    discounted cost.
  </p>
  <p>
    A worked example shows how violently distant cash flows shrink. A promise of £1,000 in
    five years is worth about £783 today at a 5% discount rate — but only £621 at 10%.
    Stretch the promise to thirty years and the same £1,000 is worth £231 at 5% and a mere
    £57 at 10%. Two lessons follow at once: distant money shrinks toward zero, and the
    longer the wait, the more sensitive the value is to the rate. Rising interest rates
    lower the present value of everything already promised — which is why bond prices fall
    when rates rise, and why long-maturity bonds swing hardest.
  </p>
  <Widget no="6" caption="find the faulty line — the discounting memo" widget="spot-error" config={ciDiscountSpot} />
  <p>
    <strong>So far:</strong> one formula, two directions — compounding builds future values
    up, discounting pulls future promises back to today. Everything priced in finance is
    one or the other. What remains is the honest complication: the rate itself is not a
    fact.
  </p>

  <h2>Probability: the rate is not a fact</h2>
  <p>
    Everything above assumed r is known. It never is. Next year's return on a savings
    account is nearly certain (this is what "risk-free" means); next year's return on
    shares is a distribution. <strong>Probability theory</strong> is how finance handles
    this, and the central object is the <strong>expected value</strong>: weight each
    possible outcome by its probability and sum.
  </p>
  <p>
    Worked example: an investment returns +50% with probability 0.4 and −20% with
    probability 0.6. Its expected return is 0.4 × 50% + 0.6 × (−20%) = 20% − 12% = +8%.
    Notice what this says: the most <em>likely single outcome</em> (−20%, 60% of the time)
    is bad, yet the investment can still be rational because the occasional +50% pays for
    the frequent small losses. That structure — skewed payoffs, probability-weighted — is
    the entire logic of venture capital, insurance and lottery pricing, in both directions.
    Expected value also explains why expected returns must beat the risk-free rate before
    risk is worth taking: an 8% expected return on shares exists precisely because the
    distribution includes bad years that a government bond does not.
  </p>
  <Widget no="7" caption="file the payoff structures" widget="sort-buckets" config={ciSkewBuckets} />

  <h2>Descriptive statistics: mean, variance, and the volatility drag</h2>
  <p>
    <strong>Descriptive statistics</strong> then compress the distribution into two
    numbers. The <strong>mean</strong> of historical annual returns says what the asset
    paid on average; the <strong>standard deviation</strong> — the typical distance of
    yearly returns from that mean — says how much it swung. A real-scale illustration:
    broad equity markets have historically returned around 7–10% per year on average
    (depending on country and period) with a standard deviation near 15–20%, while
    short-term government bonds return less with deviations of a few percent.
  </p>
  <p>
    The SD is readable through the bell curve: roughly 68% of years fall within one SD of
    the mean, 95% within two — so a 10%-mean, 16%-SD market has about one year in six
    outside −6% to +26%, and a 95% range from about −22% to +42%. That is what "risk"
    means quantitatively: the width of the annual experience, not the sign of the average.
  </p>
  <Widget no="8" caption="pin the band — risk as width" widget="place" config={ciBandPlace} />
  <p>
    Statistics then delivers the lesson's sharpest surprise: <strong>the arithmetic mean
    overstates compounding</strong>. An asset that gains +20% then loses −20% has an
    arithmetic mean of 0% — but £100 becomes £120 and then £96: a <em>loss</em> of 4%, a
    geometric (compounded) average of about −2% per year. Volatility itself destroys
    compound growth — <strong>volatility drag</strong>, worth roughly σ² ÷ 2 per year (a
    20% SD costs about 2% of compounded return against the naive mean). This is a
    mathematical fact, not a market quirk, and it is the deep reason diversification is not
    timidity: smoothing the swings genuinely raises long-run compounded wealth for the same
    average return. It is also why funds advertising "average return" rather than
    compounded (CAGR) figures are, technically, telling you something flattering and nearly
    useless.
  </p>
  <p><em>Common misconception:</em> after a 50% loss, a 50% gain gets you back to even.
  Percentages compound off different bases: £100 halved is £50, and a 50% gain on £50 is
  £75 — the recovery needs +100%. The same asymmetry that makes volatility drag real is
  why avoiding the deep loss matters more than chasing the spectacular gain, and why
  "average return" advertising is the arithmetic mean selling its flattering version.</p>

  <h2>Risk quantification: measuring and taming the swings</h2>
  <p>
    <strong>Risk quantification</strong> is the discipline of turning those distributions
    into decisions. The workhorse comparisons: <strong>risk-adjusted return</strong> (the
    Sharpe ratio — excess return over the risk-free rate divided by standard deviation;
    two portfolios with the same return but different SDs are not equivalent, and the ratio
    says which one paid better per unit of bumpy ride), <strong>correlation</strong>
    (assets that fall at different times, held together, cancel part of each other's
    variance — the only free lunch in the field), and <strong>diversification</strong>
    formalised: combining imperfectly correlated assets reduces portfolio SD below any
    single asset's, without necessarily reducing expected return.
  </p>
  <p>
    Tail measures supplement the bell curve, because market returns are famously
    <em>not</em> normally distributed — crashes are more frequent and fatter-tailed than
    the Gaussian predicts (October 1987's −22.6% day in the US was a ~20-sigma event under
    a normal model): hence Value-at-Risk, stress tests, and the humility the 2008 crisis
    taught about models.
  </p>
  <p>
    Finally, the inflation overlay: a 3% nominal return against 3% inflation compounds to
    zero <em>real</em> growth — "real return" ≈ (1 + nominal) ÷ (1 + inflation) − 1 — so
    the rate that matters for long-horizon wealth is always the one net of both inflation
    and fees. A 2% fee on a 6% gross return compounds at 4%, and over 40 years quietly
    removes roughly half the final wealth. Fees, like volatility, are a rate — and every
    rate compounds.
  </p>
  <p><em>Common misconception:</em> a diversified portfolio cannot lose money —
  diversification "eliminates" risk. It cancels variance only while correlations hold, and
  in the worst moments they stop holding: in crashes, assets that normally fall at
  different times tend to fall together, exactly when the cancelling is wanted most.
  Diversification is a reduction of ordinary-weather risk that still needs tail measures
  for the storm — a discipline, not insurance.</p>

  <h2>Compounding in the wild: loans and annuities</h2>
  <p>
    The same formula runs the borrowing side, and a worked amortisation makes it concrete.
    A £200,000 mortgage at 6% annual (0.5% monthly) over 25 years has a monthly payment M
    solving M × [1 − (1.005)⁻³⁰⁰] ÷ 0.005 = 200,000, giving M ≈ £1,289. The revealing part
    is the schedule: in month one, interest is 200,000 × 0.005 = £1,000 — so £1,000 of the
    £1,289 payment is interest and only £289 reduces the debt. Early payments are mostly
    interest because the balance (the base being compounded against you) is largest; by
    year 20 the split has roughly reversed.
  </p>
  <p>
    Total paid over 25 years is about £386,700 — nearly double the loan — which is the
    compound-interest curve pointed the other way, and the reason overpaying early is so
    powerful: an extra £100/month in year one removes years and tens of thousands from the
    tail, because it attacks the balance while the compounding against you is steepest. An
    <strong>annuity</strong> is the same mathematics in reverse — a pot converted to level
    payments until exhaustion (the pension-decumulation problem) — and a
    <strong>perpetuity</strong> is its limit: a payment that never ends is worth simply
    payment ÷ rate (£1,000/year at 5% = £20,000 today), the cleanest single sentence in
    valuation.
  </p>
  <Widget no="9" caption="pair each line with its number" widget="match" config={ciAmortMatch} />
  <p><em>Common misconception:</em> a payment that never ends must be worth an infinite
  amount of money today. Discounting says otherwise: each distant payment shrinks by the
  growth factor raised to its waiting time, and the shrinking wins — the infinite stream
  sums to a finite number, payment divided by the rate. A promise of £1,000 a year forever
  is £20,000 at 5%, not infinity, which is why "perpetuity" is a valuation line item
  rather than a miracle.</p>

  <h2>Check yourself</h2>
  <p>Try these before moving on. Feedback follows each answer.</p>
  <ol>
    <li>In one sentence: why is £100 next year worth less than £100 today?</li>
    <li>At 9% annual return, roughly how long does money take to double — and how long does a 36% APR credit-card balance take to double what you owe?</li>
    <li>An investment returns +30% with probability 0.5 and −10% with probability 0.5. What is the expected return, and what is the most likely single outcome?</li>
    <li>An asset gains +25% one year and −25% the next. What is the arithmetic mean, what is the compounded result on £100, and what does the difference tell you?</li>
  </ol>
  <p>
    <strong>Feedback:</strong> (1) Because £100 today can be invested at the going rate and
    grow to more than £100 by next year — its "compounded forward" value exceeds the
    promise, so the promise discounts back to less than £100. (2) 72 ÷ 9 = 8 years for the
    savings; 72 ÷ 36 = 2 years for the card. Same arithmetic, opposite directions. (3)
    0.5 × 30% + 0.5 × (−10%) = +10% expected; the most likely single outcome is a coin
    flip — neither dominates, which is exactly why probability-weighting is needed. (4)
    Arithmetic mean 0%; £100 becomes £125 then £93.75 — a −6.25% compounded result. The
    gap is volatility drag: the mean flatters, the compounding tells the truth. (And the
    recovery needs +33.3%, not +25% — percentages compound off different bases.)
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>Money today is worth more than money later — the sentence behind every loan, bond, mortgage and valuation.</li>
    <li>FV = P × (1 + r)ⁿ compounds forward; PV = FV ÷ (1 + r)ⁿ discounts backward; frequency enters as (1 + r/p)ⁿˣᵖ, so quoted and effective rates differ.</li>
    <li>Rule of 72: doubling time ≈ 72 ÷ rate — in savings, and equally in credit-card debt.</li>
    <li>Distant cash flows shrink toward zero under discounting, and the longer the wait, the more rate-sensitive the value — hence bond prices fall when rates rise.</li>
    <li>Expected value weights outcomes by probability; mean and standard deviation compress a return distribution into level and width.</li>
    <li>Volatility drag (about σ² ÷ 2 per year) means the arithmetic mean overstates compounding — volatility itself is a cost.</li>
    <li>Sharpe ratio, correlation and diversification quantify and partially tame risk — but correlations fail in crashes, so tail measures exist.</li>
    <li>Real return is net of inflation and fees; every rate compounds, including the ones charged against you.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    The next lesson, Time value of money and NPV, turns this lesson's formulas into
    professional tooling: annuity and perpetuity factors in full, uneven cash-flow streams,
    and the NPV decision rule that company finance runs on. The statistics introduced here
    return with force in the portfolio-management units, where variance stops being a
    description and becomes something to engineer with.
  </p>

  <h2>Going deeper</h2>
  <p>
    Four refinements complete the professional picture. <strong>Continuous
    compounding</strong>: as payments are made ever more frequently, (1 + r/n)ⁿ approaches
    eʳ — Euler's constant entering money the moment compounding is continuous, which is how
    option-pricing mathematics prefers to write growth. <strong>Sequence risk</strong>: two
    investors with the same <em>average</em> return can end differently if the bad years
    arrive early versus late while they are withdrawing money — the retirement-drawing
    problem that makes "you'll average 8%" cold comfort, and the reason glide paths de-risk
    portfolios as withdrawals begin.
  </p>
  <p>
    <strong>The discount rate is a belief</strong>: valuing anything hinges on the r you
    choose, and r embodies risk appetite, opportunity cost and inflation expectations —
    which is why a central bank raising rates by two points can move asset values by
    trillions without a single cash flow changing: only the discounting changed.
    <strong>Time diversification, stated carefully</strong>: volatility does not shrink
    with horizon in the way intuition hopes (the 30-year SD of compounded
    <em>outcomes</em> is larger in pounds), but the <em>probability</em> of a positive real
    return does rise with horizon under historical distributions — time genuinely is the
    investor's main edge, which is why starting early dominates picking well: a decade of
    extra compounding at 8% multiplies the final figure by 2.16 before any cleverness
    begins.
  </p>
  <p>
    Internalise the widget's two curves and you hold the subject's whole geometry: simple
    interest is a line, compounding is a curve, discounting is the same curve read
    backward, and risk is the width of the band the curve can honestly be drawn within.
  </p>

  <p class="sources"><strong>Sources:</strong> Bogle, The Little Book of Common Sense Investing; Bodie, Kane &amp; Marcus, Investments; Dimson, Marsh &amp; Staunton, Triumph of the Optimists (long-run return data); Ibbotson SBBI yearbooks (US equity risk and volatility). Source text: OpenStax (https://openstax.org), CC BY 4.0 — adapted for Interactive Atlas.</p>

</TopicPage>
