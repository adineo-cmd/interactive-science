import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const behavfinCfg = {
  steps: [
    { math: '1 · The efficient-market baseline', note: 'Prices reflect available information; you can\'t systematically beat the market (Fama, Nobel 2013). Decades of evidence support this — for professional and amateur alike, after costs.' },
    { math: '2 · The anomalies that won\'t die', note: 'Momentum, overreaction/reversal, bubbles persisting longer than rational models allow. Shiller (Nobel 2013) showed markets overshoot — volatility exceeds what news justifies.' },
    { math: '3 · The behavioural mechanisms', note: 'Overconfidence (traders trade too much and lose), loss aversion (selling winners, riding losers — the disposition effect), herding, narrative-seeking. Tversky & Kahneman\'s heuristics imported into markets.' },
    { math: '4 · Limits of arbitrage', note: 'Why don\'t smart money traders correct every mispricing? Because "markets can stay irrational longer than you can stay solvent" — capital constraints, career risk and noise-trader risk cap the correction. Shleifer & Vishny (1997) formalised it.' },
  ],
};
---
<TopicPage slug="subjects/finance/expert/behavioural-finance">
  <h2>The idea</h2>
  <p>
    Behavioural finance asks <strong>what happens to markets when the traders are human</strong> —
    and finds both sides of the argument hold. Markets are remarkably efficient at absorbing
    information, yet demonstrably prone to bubbles, panics and persistent anomalies. The synthesis: efficiency is the long-run gravity, psychology is the weather.
  </p>

  <Widget no="1" caption="efficiency, anomalies, mechanisms, and why arbitrage can't fix everything" widget="equationStep" config={behavfinCfg} />

  <h2>The episodes that shaped the field</h2>
  <ul>
    <li><strong>Tulip mania (1637) and the South Sea Bubble (1720):</strong> the historical proof that bubbles predate modern finance — and that "this time is different" is the oldest sentence in markets (Reinhart & Rogoff: 800 years of it).</li>
    <li><strong>The dot-com peak (2000):</strong> companies with no earnings valued in billions on "eyeballs". Greenspan's "irrational exuberance" (1996) called it three years early — the timing problem that makes bubbles unshortable.</li>
    <li><strong>GameStop (2021):</strong> social-media herding vs institutional shorts — a natural experiment in collective action, leverage and market plumbing, live-streamed.</li>
    <li><strong>The practitioner's takeaway:</strong> build portfolios that survive being wrong about everything (diversify, low fees, long horizon) — behavioural finance is mostly a warning addressed to its own readers.</li>
  </ul>
  <p class="sources"><strong>Sources:</strong> Shiller, Irrational Exuberance; Thaler (Nobel 2017); Shleifer & Vishny, JF (1997); Reinhart & Rogoff (2011).</p>
</TopicPage>
