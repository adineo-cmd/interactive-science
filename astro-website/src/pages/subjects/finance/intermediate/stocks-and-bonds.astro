const sbCfg = {
  steps: [
    { math: '1 · A stock: part-owner', note: 'Owning a share = owning a slice of the company: its profits (dividends), its growth (price appreciation), its risks (bankruptcy wipes you out last). Unlimited upside, last-in-line downside.' },
    { math: '2 · A bond: a loan contract', note: 'Lend money; receive fixed coupons plus principal at maturity. Lower return than stocks (historically ~half), much lower volatility — and priority in bankruptcy. Government bonds are the "risk-free" benchmark everything else is measured against.' },
    { math: '3 · Prices move on rates and expectations', note: 'Bond prices fall when interest rates rise (your old coupons look worse); stock prices move on expected profits AND the discount rate applied to them. Rates are gravity for both.' },
    { math: '4 · Indices: the market in one number', note: 'The S&P 500, FTSE 100, Nifty 50 track baskets of stocks. Most professional stock-pickers fail to beat them over time — the fact that defines the index-fund argument.' },
  ],
