import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const budgetCfg = {
  steps: [
    { math: '1 · Know your cashflow', note: 'Track one month of everything. The gap between income and spending is the only number that matters — positive compounds, negative borrows (the compound-interest lesson, working against you).' },
    { math: '2 · Emergency fund first', note: '3–6 months of expenses in accessible savings — the buffer that turns disasters into inconveniences and stops the debt spiral before it starts.' },
    { math: '3 · Attack debt by interest rate', note: 'Highest rate first (mathematically optimal): a 36% credit card beats any investment. For morale, the "snowball" (smallest debt first) also works — behaviour beats arithmetic when behaviour is the problem.' },
    { math: '4 · Automate the split', note: 'Pay savings and investments automatically on payday ("pay yourself first"). Willpower is unreliable; defaults are reliable — the behavioural-economics lesson applied to your own salary.' },
  ],
};
---
<TopicPage slug="subjects/finance/intermediate/budgeting-and-personal-finance">
  <h2>The idea</h2>
  <p>
    Personal finance is four moves repeated for decades: <strong>spend less than you earn, keep a
    buffer, kill expensive debt, automate the rest</strong>. None of it is complicated — all of
    it is behaviour. The mathematics (compounding, the rule of 72) lives in the compound-interest
    lesson; this one is the operating system that makes the maths work.
  </p>

  <Widget no="1" caption="the four moves, in the order that matters" widget="equationStep" config={budgetCfg} />

  <h2>The framework, applied</h2>
  <ul>
    <li><strong>The 50/30/20 rough cut:</strong> ~50% needs, 30% wants, 20% savings/debt-paydown. A starting default, not a law — the point is a conscious split.</li>
    <li><strong>Insure catastrophes, not inconveniences:</strong> health, disability, liability, (life, if others depend on you). Skip extended warranties — insure what would bankrupt you, not what would annoy you.</li>
    <li><strong>Invest after the buffer:</strong> low-cost, diversified, long-horizon (the diversification and compound-interest lessons supply the why). Fees and panic are the two wealth-killers.</li>
    <li><strong>Beware lifestyle creep:</strong> every raise partially absorbed into spending keeps the savings rate flat. Setting the savings percentage <em>before</em> the raise lands defeats the creep.</li>
  </ul>
  <p class="sources"><strong>Sources:</strong> Bogle, The Little Book of Common Sense Investing; Thaler & Benartzi, "Save More Tomorrow" (2004); consumer-finance guidance (CFPB).</p>
</TopicPage>
