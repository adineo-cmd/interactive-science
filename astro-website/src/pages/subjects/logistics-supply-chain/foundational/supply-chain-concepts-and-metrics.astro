---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const chainCfg = {
  steps: [
    { math: '1 · Three flows, one chain', note: 'Product flows downstream, money flows upstream, information flows both ways. Manage the flows, not the boxes.' },
    { math: '2 · It ends at the customer', note: 'The chain\'s only purpose is serving final demand. Everything upstream — sourcing, making, moving — exists downstream.' },
    { math: '3 · The bullwhip effect', note: 'Small wobbles in retail demand amplify upstream: each tier over-orders against uncertainty. Visibility and information sharing are the antidotes.' },
    { math: '4 · The trade-off triangle', note: 'Service level, inventory and cost: pick performance on two, pay on the third. Every supply chain decision lives inside this triangle.' },
    { math: '5 · SCOR names the work', note: 'Plan, Source, Make, Deliver, Return, Enable — the ASCM/SCOR framework\'s process vocabulary, and the source of the standard metrics.' },
  ],
};

const bullwhipCfg = {
  points: [
    { points: [[1, 10], [2, 14], [3, 21], [4, 32], [5, 48]], color: '#dc2626', label: 'demand variability amplifies upstream', mode: 'line' },
  ],
  x: { min: 0.5, max: 5.5, label: 'chain stage: 1 retailer → 5 raw material' },
  y: { min: 0, max: 60, label: 'order variability (relative)' },
  crossings: false,
  height: 330,
