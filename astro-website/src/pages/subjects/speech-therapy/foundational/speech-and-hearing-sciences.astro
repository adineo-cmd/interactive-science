import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const formantsCfg = {
  curves: [
    { expr: 'exp(-8*(x-300)^2/100000)', label: 'F1 (~300 Hz) — vowel height', color: '#0d9488', width: 2.0 },
    { expr: '0.8*exp(-8*(x-1200)^2/1000000)', label: 'F2 (~1200 Hz) — front/back', color: '#b45309', width: 2.0 },
    { expr: '0.6*exp(-8*(x-2600)^2/4000000)', label: 'F3 (~2600 Hz) — r-colour etc.', color: '#7c3aed', width: 2.0 },
  ],
  x: { min: 0, max: 5000, label: 'frequency (Hz)' },
  y: { min: 0, max: 1.1, label: 'energy (a.u.)' },
  crossings: false,
  height: 330,
};

const speechCfg = {
  steps: [
    { math: '1 · Power: the lungs', note: 'Speech begins as exhaled air under controlled pressure — the power source every sound rides on.' },
    { math: '2 · Vibration: the larynx', note: 'The vocal folds buzz at pitch — voicing. Voiceless sounds (s, f) skip this stage and are pure turbulence.' },
    { math: '3 · Shaping: the vocal tract', note: 'The throat, tongue, palate and lips shape the buzz into speech. Where the tract narrows decides which sound comes out.' },
    { math: '4 · Formants: the resonances', note: 'The tract resonates at formant frequencies — F1 tracks vowel height, F2 tongue position. Vowels are two numbers, acoustically.' },
    { math: '5 · Reception: the ear', note: 'The outer ear collects, the middle ear amplifies, the cochlea converts frequency to nerve code — the audiogram maps that chain.' },
  ],
};
---
<TopicPage slug="subjects/speech-therapy/foundational/speech-and-hearing-sciences">
  <h2>The idea</h2>
  <p>
    Speech-language pathology rests on two sciences: how humans produce speech (anatomy in motion —
    lungs, larynx, tongue, lips) and how humans perceive it (the ear and auditory system). Every
    disorder a therapist treats is, at some level, a failure in one of those two chains — which is
    why the sciences come first in the curriculum.
  </p>

  <Widget no="1" caption="from breath to meaning: the speech chain" widget="equationStep" config={speechCfg} />

  <h2>Vowels are two numbers</h2>
  <p>
    The vocal tract acts as a resonating tube, amplifying certain frequencies — formants. The first
    two carry most of vowel identity: F1 falls as the tongue lowers (the jaw opens), F2 falls as
    the tongue moves back. Say "ee" then "oo" slowly and you can feel F2 plummet. This acoustic
    logic is what speech analysis software displays, and what therapy teaches clients to hear.
  </p>

  <Widget no="2" caption="the formant peaks that define a vowel" widget="plotter" config={formantsCfg} />

  <h2>The audiogram: hearing's map</h2>
  <p>
    Hearing is tested by frequency and loudness, plotted as the audiogram: low frequencies (left)
    to high (right), loudness running downward. Typical age-related loss descends first on the
    high-frequency side — which is why hearing loss first steals consonants like /s/ and /f/,
    making speech sound muffled rather than quiet. The audiogram is the therapist's map of what the
    ear can and cannot deliver to the brain.
  </p>

  <h2>Why the sciences matter clinically</h2>
  <p>
    Diagnosis in speech therapy is chain analysis: find the broken link. Breath support failure
    points to respiratory work; voicing failure to the larynx; unintelligible vowels to motor
    planning; a flat audiogram to amplification before therapy can even start. The sciences are
    not background — they are the diagnostic instrument.
  </p>

  <p class="sources"><strong>Sources:</strong> ASHA/CAA accreditation standards; Ferrand, <em>Speech Science: An Introduction</em>; Zemlin, <em>Speech and Hearing Science</em>.</p>
</TopicPage>
