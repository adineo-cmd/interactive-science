const opsCfg = {
  steps: [
    { math: '1 · Throughput, inventory, flow', note: 'Operations manages the rate work moves through a system. The constraint (bottleneck) sets the pace of everything — Goldratt\'s Theory of Constraints: find it, exploit it, elevate it, repeat.' },
    { math: '2 · Inventory: the buffer with a bill', note: 'Stock absorbs uncertainty between supply and demand — at a cost (storage, capital, spoilage). Too little loses sales; too much buries cash. The reorder-point maths (newsvendor, EOQ) prices the trade-off.' },
    { math: '3 · The bullwhip effect', note: 'Small wobbles in consumer demand amplify up the supply chain — each layer over-orders against uncertainty. Cause of most "mystery" shortages and gluts; cured by information sharing (POS data flowing upstream).' },
    { math: '4 · Quality is cheaper than inspection', note: 'Build it right instead of checking it after (Deming, Toyota Production System). Defects found late cost multiples of defects prevented; kaizen (continuous improvement) compounds like interest.' },
  ],
