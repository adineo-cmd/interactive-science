const custCfg = {
  steps: [
    { math: '1 · Segmentation: not everyone is your customer', note: 'Divide the market by needs, not demographics alone. A "segment" is a group that would buy for the SAME reason — segments are discovered in why-questions, not age brackets.' },
    { math: '2 · Targeting and positioning', note: 'Choose which segment to serve, then claim a specific place in its mind: "the fastest", "the cheapest", "the kindest". Positioning is what the customer believes, not what the slogan says.' },
    { math: '3 · Product–market fit', note: 'Marc Andreessen\'s phrase: the point where the market pulls the product out of you. The honest signal: customers would be very disappointed if the product disappeared (Sean Ellis\'s 40% test).' },
    { math: '4 · Jobs to be done', note: 'Customers "hire" products for jobs (Clayton Christensen): the milkshake sells because it makes a boring commute survivable. Understanding the job reveals competitors the category never shows you.' },
  ],
