import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const scaleCfg = {
  steps: [
    { math: '1 · Communication paths grow as n(n−1)/2', note: 'Doubling headcount more than doubles coordination load. At 10 people, everyone knows everything; at 100, that is impossible. Structure replaces hallway — deliberately or badly.' },
    { math: '2 · Structure follows strategy (Chandler)', note: 'Organise around what the strategy needs: function (efficiency at one thing), division (accountability per market), matrix (both, at coordination cost). Each redesign is a bet about what matters now.' },
    { math: '3 · Processes replace heroics', note: 'What founders did by intuition must become documented process: hiring rubrics, incident playbooks, decision rights (who decides what, consult whom — RAPID/DACI). Process is how quality survives headcount.' },
    { math: '4 · Culture scales through rituals', note: 'Culture degrades by default as new people arrive. Rituals (demos, post-mortems, written decisions) transmit it; promotion patterns cement it. Who gets promoted IS the culture announcement.' },
  ],
