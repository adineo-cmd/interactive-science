---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const breakevenCfg = {
  curves: [
    { expr: 'p*x', label: 'revenue = price × units', color: '#c2410c', width: 2.2 },
    { expr: 'f + v*x', label: 'total cost = fixed + variable × units', color: '#374151' },
  ],
  params: [
    { name: 'p', label: 'price p', min: 5, max: 100, step: 1, value: 40 },
    { name: 'v', label: 'variable cost per unit v', min: 1, max: 80, step: 1, value: 25 },
    { name: 'f', label: 'fixed costs f', min: 0, max: 6000, step: 50, value: 2400 },
  ],
  x: { min: 0, max: 500, label: 'units sold' },
  crossings: true,
  height: 360,
};

const ueCostBuckets = {
  "prompt": "Fixed costs are the price of existing; variable costs scale with each unit. File them:",
  "buckets": [
    "fixed costs",
    "variable costs"
  ],
  "items": [
    {
      "label": "the stall's rent",
      "bucket": 0
    },
    {
      "label": "insurance",
      "bucket": 0
    },
    {
      "label": "the loan payment on the tea urn",
      "bucket": 0
    },
    {
      "label": "tea leaves",
      "bucket": 1
    },
    {
      "label": "the cup",
      "bucket": 1
    },
    {
      "label": "milk",
      "bucket": 1
    }
  ],
  "why": "The split matters because the two lines behave differently: one ignores volume, the other rides on it — and the gap between them is where profit lives."
};

const ueBreakevenCloze = {
  "text": "Each cup contributes £4 − £2.50 = %%0%% toward the fixed costs. With rent of %%1%% a month, break-even is 240 ÷ 1.50 = %%2%% cups — the sales you must make before the business earns anything at all.",
  "answers": [
    [
      "£1.50",
      "1.50"
    ],
    [
      "£240",
      "240"
    ],
    [
      "160"
    ]
  ],
  "hint": "Contribution first, then divide the rent by it."
};

const ueSafetyEstimate = {
  "prompt": "Selling 240 units against a 160-unit break-even — how big is the margin of safety, as a percentage of sales?",
  "unit": "%",
  "answer": 33,
  "factor": 1.25,
  "why": "About 33 per cent: an 80-unit cushion. A 15 per cent dip in demand survives it; a 40 per cent dip does not.",
  "context": "Every cup after number 160 drops £1.50 of profit straight to the bottom."
};

const ueExperimentBranch = {
  "root": "The big stall: price £40, variable cost £25, fixed costs £2,400 — break-even 160 units. Move one line and watch the consequence.",
  "nodes": {
    "start": {
      "text": "The bank wants a lower break-even. Which line do you move?",
      "choices": [
        {
          "label": "Raise the price",
          "next": "price",
          "feedback": "The crossing slides left — fewer sales needed. But will customers stay?"
        },
        {
          "label": "Cut the variable cost per unit",
          "next": "variable",
          "feedback": "The gap between the lines widens — every unit after break-even earns that gap as profit."
        },
        {
          "label": "Double the fixed costs to grow faster",
          "next": "fixed",
          "feedback": "The whole cost line rises: break-even moves right, and the business lives or dies on volume."
        }
      ]
    },
    "price": {
      "text": "Higher margin per unit — the classic high-fixed-cost dilemma: fewer sales needed, more lost if demand sags."
    },
    "variable": {
      "text": "Cheaper tea leaves, in effect — contribution up with no new risk of demand."
    },
    "fixed": {
      "text": "This is why airlines, chip factories and cinema chains live or die on volume."
    }
  },
  "why": "Profit is not a line on the chart — it is the vertical gap between the two lines, and every experiment moves one of them."
};

const ueMethodMatch = {
  "prompt": "Three methods of production — pair each with what it buys:",
  "pairs": [
    {
      "left": "job production (a wedding cake)",
      "right": "maximal customisation, high cost per unit, no economies of scale"
    },
    {
      "left": "batch production (a bakery's rye then sourdough)",
      "right": "some variety and some scale — but every switch costs setup time"
    },
    {
      "left": "flow production (bottled drinks, cars)",
      "right": "lowest unit cost, but inflexible, and a line stoppage is expensive"
    }
  ],
  "why": "Services run the same spectrum: a bespoke consultancy is job production; a coffee chain is flow production with milk."
};

const ueLeanSpot = {
  "prompt": "One line of this lean-production summary is wrong. Find it.",
  "lines": [
    "Lean production's target is every form of waste — the Japanese word is muda",
    "Just-in-time holds days of parts, not months, freeing cash and warehouse space",
    "The cost is vulnerability to supply shocks, as the pandemic showed",
    "Kaizen means big redesigns proposed by outside consultants twice a year",
    "Error-proofing means defects never restart a process"
  ],
  "errorLine": 3,
  "correction": "Kaizen means continuous small improvements proposed by the people doing the work.",
  "why": "Lean's insight is accounting disguised as philosophy: inventory is money sitting still, and time is a cost line."
};

const ueUtilisationPlace = {
  "prompt": "A factory pays full fixed costs while earning revenue on only part of its capacity — it runs at what utilisation in the example? Place the marker:",
  "labels": [
    "0%",
    "25%",
    "50%",
    "75%",
    "100%"
  ],
  "scale": {
    "min": 0,
    "max": 100
  },
  "answer": 60,
  "tolerance": 5,
  "why": "60 per cent: high utilisation is how the fixed-cost line gets spread — which is why airlines discount last-minute seats rather than fly them empty."
};

const ueFixedJudge = {
  "statements": [
    {
      "s": "Rent does not care whether you sell 10 cups or 1,000 this month.",
      "truth": true,
      "why": "Fixed versus variable describes how a cost behaves when volume changes — nothing more."
    },
    {
      "s": "Fixed costs are fixed forever — the landlord can never raise them.",
      "truth": false,
      "why": "The landlord can raise the rent next year; 'fixed' means fixed with respect to output."
    },
    {
      "s": "A big restaurant chain's locations each repeat the same small-scale costs, so being huge brings no scale economies automatically.",
      "truth": true,
      "why": "Ask which cost line moved, not how big the firm is."
    },
    {
      "s": "A small firm can enjoy purchasing economies by joining a buying cooperative.",
      "truth": true,
      "why": "Scale economies come from spreading fixed costs and buying inputs cheaper — both visible without size."
    }
  ]
};
---
<TopicPage slug="subjects/business/foundational/unit-economics">
  <h2>Where you are, and what you will learn</h2>
  <p>
    This is the beginner lesson of Business. You need no economics and no maths
    beyond multiplication and division — every term is defined in plain words the
    moment it appears, and every calculation is worked step by step.
  </p>
  <p>By the end of this lesson you will be able to:</p>
  <ul>
    <li>separate a business's costs into fixed and variable, and say why the split matters;</li>
    <li>calculate a break-even point and a margin of safety;</li>
    <li>name the main methods of production and the trade-off each one buys;</li>
    <li>explain economies and diseconomies of scale, and operating leverage;</li>
    <li>connect quality and location decisions to the same two cost lines.</li>
  </ul>
  <p>Take your time; each paragraph carries exactly one idea.</p>

  <h2>Start with a tea stall</h2>
  <p>
    You sell one cup of tea for £4. The tea, the cup and the milk cost you £2.50.
    One question decides whether your stall survives: does that one cup bring in
    more money than it costs to make? Asked about a single
    <strong>unit</strong> — one cup, one subscription, one ride — it is the
    question called <strong>unit economics</strong>, and it is the heartbeat of
    every business from a tea stall to a trillion-dollar platform. The craft of
    turning inputs (materials, people, machines, ideas) into outputs (goods and
    services) at a cost the market will pay is called
    <strong>operations management</strong>, and its core vocabulary is cost.
  </p>
  <p>
    Now the vocabulary. <strong>Revenue</strong> is the money customers pay you. A
    <strong>fixed cost</strong> is owed no matter how much you sell: the stall's
    rent, your insurance, the loan payment on the tea urn. Fixed costs are the
    price of existing. A <strong>variable cost</strong> scales with each unit: the
    tea leaves, the cup, the milk.
  </p>
  <Widget no="9" caption="file the stall's costs — fixed or variable" widget="sort-buckets" config={ueCostBuckets} />
  <p>
    Each cup contributes £4 − £2.50 = £1.50 toward the fixed costs. That £1.50 is
    called the <em>contribution margin</em>. Say the rent is £240 a month. How many
    cups until the contributions have paid it all? 240 ÷ 1.50 = <strong>160
    cups</strong>. That number is the <strong>break-even point</strong>: the sales
    you must make before the business earns anything at all. Every cup after number
    160 drops £1.50 of profit straight to the bottom.
  </p>
  <Widget no="8" caption="fill the blanks — the break-even arithmetic" widget="cloze" config={ueBreakevenCloze} />

  <Widget no="1" caption="the circled crossing is survival — drag price, costs and see exactly how many units it takes" widget="plotter" config={breakevenCfg} />
  <p>
    <strong>What to notice:</strong> profit is not a line on this chart — it is the
    vertical gap between the two lines. Left of the crossing the gap is negative:
    the fixed costs are not yet paid. Right of it, every unit drops the gap
    straight to the bottom line, and the crossing itself is the break-even point.
  </p>

  <p>
    The widget's defaults are the same stall, ten times larger: price £40, variable
    cost £25, fixed costs £2,400. Each unit contributes £40 − £25 =
    <strong>£15</strong>, so break-even is 2,400 ÷ 15 = <strong>160 units</strong> —
    the crossing point of the two lines. Try the experiments. Raise the price and
    the crossing point slides left — fewer sales needed, but will customers stay?
    Cut the variable cost and the gap between the lines widens — every unit after
    break-even earns that gap as profit. Double the fixed costs and the whole cost
    line rises: this is why "high-fixed-cost" businesses (airlines, chip factories,
    cinema chains) live or die on volume.
  </p>
  <Widget no="7" caption="run the experiments — move a line, take the consequence" widget="branch" config={ueExperimentBranch} />
  <p>
    One more number matters in practice: the <strong>margin of safety</strong> —
    how far current sales sit above break-even. Selling 240 units against a
    160-unit break-even is a 33 per cent cushion. A 15 per cent dip in demand
    survives it. A 40 per cent dip does not.
  </p>
  <Widget no="6" caption="call the cushion — margin of safety" widget="estimate" config={ueSafetyEstimate} />
  <p>
    <strong>So far:</strong> every business lives on one calculation — does one
    unit pay for itself? Contribution margin pays the fixed costs; the crossing of
    the two lines is break-even; the margin of safety is your cushion. Next: how
    production is organised.
  </p>

  <h2>Production: goods and services, and how they're made</h2>
  <p>
    Operations first chooses a <strong>method of production</strong>, and the
    choice shapes everything downstream. <strong>Job production</strong> makes
    one-offs — a wedding cake, a bespoke suit, a bridge. Maximal customisation,
    high cost per unit, skilled labour, no economies of scale.
  </p>
  <p>
    <strong>Batch production</strong> makes groups. A bakery bakes 200 rye loaves,
    then switches to sourdough. You get some variety and some scale, but every
    switch costs setup time. <strong>Flow production</strong> — also called mass
    production — runs identical units down a continuous line: bottled drinks,
    cars. Lowest unit cost, but inflexible, and any line stoppage is expensive.
    Services run the same spectrum: a bespoke consultancy is job production; a
    coffee chain is flow production with milk.
  </p>
  <Widget no="5" caption="pair each production method with its trade-off" widget="match" config={ueMethodMatch} />
  <p>
    The second choice is <strong>labour-intensive versus capital-intensive</strong>
    — hand-tailoring versus an automated bottling line. The two differ in fixed
    and variable mix exactly as the widget's lines do. Capital intensity raises
    fixed costs and lowers variable cost per unit: break-even moves right, and
    profits become explosive at high volume, fragile at low volume.
  </p>
  <p>
    The third is <strong>productivity</strong>: output per unit of input. Raising
    productivity without raising quality is the operational holy grail, and the
    modern answer is <strong>lean production</strong> — the Toyota-inspired system
    that attacks every form of waste (the Japanese word is <em>muda</em>). Its
    tools: <em>just-in-time</em> inventory — hold days of parts, not months,
    freeing cash and warehouse space, at the cost of vulnerability to supply
    shocks, as the pandemic showed; <strong>kaizen</strong> — continuous small
    improvements proposed by the people doing the work; and error-proofing, so
    defects never restart a process. Lean's insight is accounting disguised as
    philosophy: inventory is money sitting still, and time is a cost line.
  </p>
  <Widget no="4" caption="one line of the lean summary is wrong" widget="spot-error" config={ueLeanSpot} />
  <p>
    <strong>So far:</strong> one-off, batch or flow; people or machines; lean to
    cut waste. Every one of these choices moves the two cost lines. Next: what
    happens when a business grows.
  </p>

  <h2>Scale: why bigger is usually cheaper — until it isn't</h2>
  <p>
    <strong>Economies of scale</strong> are the fall in cost per unit as output
    rises, and they are specific enough to list. <em>Purchasing</em>: a chain buys
    flour at wholesale prices a stall cannot touch. <em>Technical</em>: a large
    machine spreads its fixed cost over more units — the widget's high-fixed-cost
    logic. <em>Marketing</em>: a national advertising campaign costs the same and
    sells a hundred times more. <em>Financial</em>: large firms borrow at lower
    rates. <em>Managerial</em>: a specialist accountant, unaffordable for a small
    firm, pays for herself at scale.
  </p>
  <p>
    <strong>Diseconomies of scale</strong> are just as real. Coordination costs
    grow with size. Communication slows through layers. Workers feel anonymous.
    The firm becomes slow precisely when the market is fast — cost per unit can
    <em>rise</em> past some size.
  </p>
  <p>
    The practical measure tying scale to break-even is <strong>capacity
    utilisation</strong>: actual output as a percentage of maximum output. A
    factory running at 60 per cent pays full fixed costs while earning revenue on
    60 per cent of capacity. High utilisation is how the fixed-cost line gets
    spread. This is why airlines discount last-minute seats: a seat flown empty
    earns nothing, but sold cheap it contributes something. Hotels, shipping and
    chip plants watch utilisation obsessively for the same reason.
  </p>
  <Widget no="3" caption="drop the marker on the factory's utilisation" widget="place" config={ueUtilisationPlace} />
  <p><em>Common misconception:</em> economies of scale do not come from "being big" vaguely — they
  come from spreading fixed costs and buying inputs cheaper, both of which are visible in the two cost
  lines of the widget. A business can be huge and still have no scale economies (a big restaurant
  chain's locations each repeat the same small-scale costs), and a small firm can enjoy purchasing
  economies by joining a buying cooperative. Ask which line moved, not how big the firm is.</p>
  <p><em>Common misconception:</em> "fixed" costs are fixed forever. They are fixed
  only with respect to output: rent does not care whether you sell 10 cups or
  1,000 this month, but the landlord can still raise it next year. Fixed versus
  variable describes how a cost behaves when volume changes — nothing more.</p>
  <Widget no="2" caption="true or false — the word 'fixed' on trial" widget="judge" config={ueFixedJudge} />
  <p>
    <strong>So far:</strong> scale spreads fixed costs and buys inputs cheaper —
    up to a point; capacity utilisation decides how well the fixed line is being
    spread. Next: how violently profit responds to sales.
  </p>

  <h2>Operating leverage: the widget's hidden risk dial</h2>
  <p>
    The cost structure also determines how violently profit responds to sales — a
    property called <strong>operating leverage</strong>. Work it with the widget's
    defaults. At 240 units, profit is 240 × 15 − 2,400 = £1,200. Lift sales 25 per
    cent, to 300 units: profit becomes 300 × 15 − 2,400 = £2,100 — a 75 per cent
    jump. The same 25 per cent move downward, to 180 units, takes profit from
    £1,200 to £300 — a 75 per cent collapse.
  </p>
  <p>
    High fixed costs <em>amplify</em> everything, in both directions. The identical
    sales swing that barely dents a low-fixed-cost stall whipsaws the
    capital-intensive factory. This is the number behind "live or die on volume":
    airlines scrape by at 75 per cent load factors and print money at 95 per cent,
    in exactly this ratio. It also explains strategy: high-leverage firms cut
    prices to defend volume during downturns (any price above variable cost still
    contributes), while low-leverage firms protect margin instead. When you read
    the widget, you are reading not just where profit begins but how much
    turbulence the model can absorb.
  </p>
  <p><em>Common misconception:</em> profit and cash are the same thing, so a
  profitable business cannot run out of money. Profit is an accounting result
  spread over time; cash follows dates. Sell on 60-day credit and you book the
  profit today but see the money in two months — while salaries, rent and
  suppliers do not wait. That gap is why profitable firms still fail.</p>

  <h2>Quality: the cheapest cost reduction</h2>
  <p>
    <strong>Quality</strong> means conformance to specification — the product does
    what it is supposed to do, reliably. The naive view is that quality costs
    money. The operational view is the reverse.
  </p>
  <p>
    The <em>cost of poor quality</em> is a bill with four parts.
    <em>Prevention</em>: training, good design, error-proofing.
    <em>Appraisal</em>: inspection and testing. <em>Internal failure</em>: scrap,
    rework, downtime — failures caught inside the factory. <em>External
    failure</em>: returns, warranty claims, refunds — and the unquantifiable one,
    reputation. External failure is the catastrophic tier because it multiplies: a
    defect caught at the bench costs parts; the same defect in a customer's hands
    costs recall, litigation and trust.
  </p>
  <p>
    This arithmetic drives the shift from <strong>quality control</strong> —
    inspect the finished output and catch defects, though some always escape — to
    <strong>quality assurance</strong>: design the process so defects cannot be
    made. And then to <strong>total quality management</strong> (TQM): quality as
    everyone's job, every process measured and continuously improved, the customer
    — internal or external — as the final judge of every handoff.
  </p>
  <p>
    The measurable payoff loops straight back into unit economics. Less scrap
    lowers variable cost per unit. Fewer warranty claims lower the fixed service
    burden. A reliability reputation raises the price the market will bear. It is
    the same break-even diagram, moved on both axes.
  </p>
  <p><em>Common misconception:</em> quality is a luxury that costs extra.
  Prevention is the cheapest line on the quality bill: money spent on training
  and good design diverts failures away from the catastrophic external tier,
  where each defect costs far more than the prevention ever did. Skimping on
  quality is not saving; it is postponing a larger payment.</p>
  <p>
    <strong>So far:</strong> quality failures are a four-part bill, and preventing
    them is cheaper than catching them — the same cost lines again. One decision
    remains: where to set them.
  </p>

  <h2>Location: the decision that fixes the cost lines</h2>
  <p>
    <strong>Location decisions</strong> are operations in concrete: they set the
    cost and revenue lines for a decade. The classic checklist asks about
    proximity to <em>materials</em> (weight-losing industries such as steel and
    sugar sit near the raw input — think of ore hauled to the coast for centuries),
    to <em>energy</em> (why aluminium smelters chase cheap electricity), to
    <em>labour</em> (skills and wage levels — the force behind manufacturing's
    20th-century migrations), and to <em>the market</em> (weight-gaining and
    perishable products — soft drinks, bread — are made near the customer). Then
    infrastructure, planning permission, taxes and grants.
  </p>
  <p>
    Modern overlays change the weighting. E-commerce makes a distribution
    centre's position relative to courier hubs more important than a shopfront's
    footfall. Cloud services relocate "offices" into data-centre geography chosen
    for power and response time. Remote work lets service firms hire labour
    without moving it.
  </p>
  <p>
    And relocation is asymmetric. Moving a factory to cut labour cost 20 per cent
    can quietly raise logistics cost 15 per cent, lose embedded supplier
    relationships, and disrupt the workforce that held the tacit knowledge. Firms
    that count only the wage line in the location decision routinely rediscover
    the others at their own expense.
  </p>

  <h2>Check yourself</h2>
  <p>Try these before moving on. The answers are right below.</p>
  <ol>
    <li>A stall sells soup at £5 a bowl. Ingredients cost £2 a bowl; rent is £600 a month. What is the break-even point?</li>
    <li>Why does a 25 per cent sales dip hurt a capital-intensive factory far more than a hand workshop?</li>
    <li>A hotel sells tonight's empty room cheap to a last-minute guest. Why does that still make sense?</li>
  </ol>
  <p>
    <strong>Answers:</strong> (1) Each bowl contributes £5 − £2 = £3, so 600 ÷ 3 =
    200 bowls a month. (2) Operating leverage: its high fixed costs amplify the
    swing, so profit falls by a far larger percentage than sales. (3) An unsold
    room's revenue is lost forever — services are perishable — so any price above
    the small variable cost of cleaning it contributes toward fixed costs that are
    sunk regardless.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>Unit economics asks one question about one unit: does it bring in more money than it costs to make?</li>
    <li>Fixed costs are owed no matter what you sell; variable costs scale with each unit; price minus variable cost is the contribution margin.</li>
    <li>Break-even = fixed costs ÷ contribution margin; the margin of safety is how far current sales sit above it.</li>
    <li>Job, batch and flow production trade customisation against unit cost; labour- versus capital-intensive choice sets the fixed-variable mix.</li>
    <li>Economies of scale come from spreading fixed costs and buying inputs cheaper — and they can reverse into diseconomies past some size.</li>
    <li>Operating leverage amplifies profit swings in both directions; lean production, quality and location all move the same two cost lines.</li>
    <li>Cash outranks profit: a profitable firm can still die of bad timing.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    The two cost lines follow you everywhere from here. Later lessons in business
    take them into pricing, accounts and strategy, and the startup reinterpretation
    you have just met — lifetime value against acquisition cost — is the same
    break-even arithmetic wearing different clothes. The model's edges (constant
    price, one product, cash outranking profit) are exactly where the next layers
    of theory begin.
  </p>

  <h2>Going deeper</h2>
  <p>
    The break-even model earns its keep only if you know its edges. It assumes a
    <em>constant</em> price and constant variable cost per unit. Real firms face
    learning curves — unit variable cost falls as cumulative output grows — and
    price discrimination: the airline seat sold at ten prices. So the straight
    lines bend. Multi-product firms cannot even define "the" unit cleanly, which
    is why practice computes break-even per product line on
    <strong>contribution</strong> and sums.
  </p>
  <p>
    The startup reinterpretation is <strong>customer lifetime value (LTV) versus
    customer acquisition cost (CAC)</strong>. The "unit" is a customer. The
    "variable cost" includes what it costs to acquire them. The business is
    viable only if LTV exceeds CAC with margin to spare. "Growth at a loss" is
    rational <em>only</em> if today's subsidised price builds tomorrow's positive
    unit economics — the discipline behind blitzscaling, and the epitaph on most
    startup post-mortems when it wasn't true.
  </p>
  <p>
    Finally, cash still outranks profit. A profitable firm dies of bad timing when
    salaries fall due before customers pay — that gap is called
    <strong>working capital</strong>. This is why the break-even chart sits next
    to a cash-flow forecast on every competent founder's desk. Operations, in the
    end, is the discipline of making the widget's two lines behave: revenue up,
    variable cost down, fixed cost amortised — and quality, lean production,
    scale and location are just the four levers, labelled.
  </p>
  <p class="sources"><strong>Sources:</strong> Horngren's Cost Accounting (Datar & Rajan); Ohno, Toyota Production System (1988); Osterwalder & Pigneur, Business Model Generation; standard IGCSE/A-level business operations syllabus treatments. Source text: OpenStax (https://openstax.org), CC BY 4.0 — adapted for Interactive Atlas.</p>
</TopicPage>
