import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const stratCfg = {
  steps: [
    { math: '1 · Porter\'s five forces', note: 'Industry profitability is structured by: rivalry, new entrants, substitutes, supplier power, buyer power. Attractive industries have weak forces — strategy starts by reading the structure, not the competitors.' },
    { math: '2 · Competitive advantage = doing it differently', note: 'Operational effectiveness (running the same race faster) is not strategy. Strategy is choosing a DIFFERENT race: a distinct activity mix competitors can\'t copy without abandoning their own position (Porter, "What Is Strategy?", 1996).' },
    { math: '3 · Moats: durable advantage', note: 'Network effects, switching costs, brand, cost advantages, patents/regulation. Buffett\'s "moat" framing: how long can the advantage survive attack? Durable moats, not current profits, justify premium valuations.' },
    { math: '4 · Trade-offs are the strategy', note: 'Real strategy says NO: Southwest doesn\'t offer meals or assigned seats — and can\'t be copied by full-service airlines without becoming Southwest. Choice makes strategy hard to imitate.' },
  ],
};
---
<TopicPage slug="subjects/business/advanced/strategy-competitive-advantage">
  <h2>The idea</h2>
  <p>
    Strategy is <strong>choosing where to compete and how to win durably</strong> — which is
    mostly the discipline of saying no. Michael Porter's framework: read the industry's forces,
    choose a distinct position, build trade-offs that make imitation self-defeating. The moats
    (network effects, switching costs, brand) are what remain after competitors have tried.
  </p>

  <Widget no="1" caption="five forces, distinct positions, moats, and the power of saying no" widget="equationStep" config={stratCfg} />

  <h2>Strategy in the wild</h2>
  <ul>
    <li><strong>Cost leadership vs differentiation:</strong> stuck-in-the-middle is the classic failure — cheapest AND premium usually means neither. Pick the customer you serve and the one you fire.</li>
    <li><strong>Disruption theory (Christensen):</strong> incumbents fail at the LOW end first — cheaper, "worse" products improve until they eat the market (steel minimills, PCs, streaming). Listening only to best customers blinds firms to the attack.</li>
    <li><strong>Blue oceans:</strong> uncontested market space (Cirque du Soleil: circus minus animals, plus theatre) — value innovation rather than head-to-head competition. Rare, but the moves are analysable.</li>
    <li><strong>Strategy documents vs strategy:</strong> the real strategy is revealed by resource allocation — budgets, hiring and roadmap are the true strategy statement.</li>
  </ul>
  <p class="sources"><strong>Sources:</strong> Porter, Competitive Strategy (1980) and "What Is Strategy?" (1996); Christensen, The Innovator's Dilemma (1997); Greenwald & Kahn, Competition Demystified.</p>
</TopicPage>
