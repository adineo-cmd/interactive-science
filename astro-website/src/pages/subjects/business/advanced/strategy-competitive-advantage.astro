import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const stratCfg = {
  steps: [
    { math: '1 · Porter\'s five forces', note: 'Industry profitability is structured by: rivalry, new entrants, substitutes, supplier power, buyer power. Attractive industries have weak forces — strategy starts by reading the structure, not the competitors.' },
    { math: '2 · Competitive advantage = doing it differently', note: 'Operational effectiveness (running the same race faster) is not strategy. Strategy is choosing a DIFFERENT race: a distinct activity mix competitors can\'t copy without abandoning their own position (Porter, "What Is Strategy?", 1996).' },
    { math: '3 · Moats: durable advantage', note: 'Network effects, switching costs, brand, cost advantages, patents/regulation. Buffett\'s "moat" framing: how long can the advantage survive attack? Durable moats, not current profits, justify premium valuations.' },
    { math: '4 · Trade-offs are the strategy', note: 'Real strategy says NO: Southwest doesn\'t offer meals or assigned seats — and can\'t be copied by full-service airlines without becoming Southwest. Choice makes strategy hard to imitate.' },
  ],
};

const stratQuiz = {
  questions: [
    {
      q: "Two firms sell identical products in identical volumes. Firm A faces powerful buyers and low switching costs; firm B's customers would need to retrain staff to switch. Which statement follows?",
      choices: [
        "Both firms earn the same margins, since products are identical",
        "Firm B can sustain higher margins — buyer power, not product quality, caps price",
        "Firm A earns more, because it must be more efficient",
        "Margins depend only on market share",
      ],
      answer: 1,
      why: "Buyer power and switching costs are structural, and structure beats effort. Identical products can support very different profitability depending on who holds the bargaining power.",
    },
    {
      q: "You poll 400 randomly chosen customers and 60% prefer feature X. What margin of error should you quote at 95% confidence?",
      choices: ["About ±5%", "About ±1%", "About ±10%", "None — 400 is a big sample"],
      answer: 0,
      why: "At 95% confidence the margin is roughly 1/√n = 1/√400 = 5%, so the honest range is 55–65%. Quadrupling the sample only halves the error — precision is expensive.",
    },
    {
      q: "A full-service airline adds a budget sub-brand copying a low-cost carrier's no-frills model. Why does the classic Porter analysis expect trouble?",
      choices: [
        "Budget brands always fail",
        "The copy dilutes the parent's differentiation while lacking its dedicated cost structure — stuck in the middle",
        "Customers refuse to fly two airlines",
        "Regulators block sub-brands",
      ],
      answer: 1,
      why: "The parent's activities (meals, hub connections, premium cabins) were chosen as a coherent system. Bolting on a no-frills system without committing to it delivers the costs of neither model — the classic stuck-in-the-middle trap.",
    },
  ],
};

