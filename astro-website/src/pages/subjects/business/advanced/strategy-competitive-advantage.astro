  },
  "after": {
    "label": "soft-drink concentrate",
    "text": "Two dominant brands whose rivalry settled into non-price competition; customers loyal for life; franchised bottlers with little bargaining power. Spectacular returns, for decades."
  },
  "why": "The gap is not about effort, intelligence or management quality — structure tells you in advance, which is Buffett's joke about shooting down the Wright brothers at Kitty Hawk."
};

const scSampleEstimate = {
  "prompt": "A random sample of 1,000 respondents — roughly what margin of error should you quote at 95% confidence?",
  "unit": "percentage points",
  "answer": 3.2,
  "factor": 1.3,
  "why": "The 1/√n rule: 1,000 gives about ±3.2, 400 gives ±5 — and quadrupling the sample merely halves the error, which is why the strategist decides which questions deserve the money.",
  "context": "A manager demanding ±1% certainty is ordering a 10,000-person study — the alternative is 12 sharp customer interviews."
};

const scPositionBranch = {
  "root": "You compete across a broad market. Porter says there are only two coherent ways to beat the industry average — choose, then live with the mix it implies.",
  "nodes": {
    "start": {
      "text": "The board asks for the position. What do you choose?",
      "choices": [
        {
          "label": "Cost leadership — acceptably good at structurally lower cost",
          "next": "cost",
          "feedback": "Your 4Ps follow: high-volume no-frills distribution, promotion built on price and availability, a deliberately narrow range."
        },
        {
          "label": "Differentiation — a product buyers pay a premium for",
          "next": "diff",
          "feedback": "Your 4Ps follow: brand, channels and service that a cost leader would call waste."
        },
        {
          "label": "Focus — one of the two, on a narrow underserved segment",
          "next": "focus",
          "feedback": "Valid third option — but you still owe the segment a coherent mix of one of the two kinds."
        }
      ]
    },
    "cost": {
      "text": "A rival proposes premium packaging for one product line. Response?",
      "choices": [
        {
          "label": "Refuse — it dilutes the cost system",
          "next": "coherent",
          "feedback": "That refusal is the strategy: every P either reinforces the position or quietly betrays it."
        },
        {
          "label": "Try it — the brand could use the lift",
          "next": "middle",
          "feedback": "Premium pricing without premium differentiation is the first step to stuck-in-the-middle."
        }
      ]
    },
    "diff": {
      "text": "A rival undercuts you 20% on a me-too product. Response?",
      "choices": [
