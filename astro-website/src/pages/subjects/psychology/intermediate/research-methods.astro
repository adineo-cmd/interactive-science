const methodCfg = {
  steps: [
    { math: '1 · Question → hypothesis', note: 'A hypothesis must be falsifiable — state what result would prove it wrong (Karl Popper\'s demand, 1934). "Unfalsifiable" means unscientific.' },
    { math: '2 · Operationalise the variables', note: 'Turn ideas into measurable things: "stress" becomes cortisol level or a validated questionnaire. Vague measures produce vague science.' },
    { math: '3 · Control group + random assignment', note: 'The comparison group receives no treatment; randomness distributes every other difference — motivation, sleep, luck — evenly between groups.' },
    { math: '4 · Blinding', note: 'Participants and, where possible, experimenters must not know who got the treatment. Expectation alone can produce real measured effects (the placebo problem).' },
    { math: '5 · Pre-register, then replicate', note: 'Announce the analysis before seeing data; then run it again on new people. A finding that only one lab can produce is a rumour.' },
  ],
};

