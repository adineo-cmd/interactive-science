const aeLeverMatch = {
  "prompt": "L = ½ρV²S·C_L: every letter is a design lever. Match the lever to the aircraft that pulls it:",
  "pairs": [
    {
      "left": "long wings of large area",
      "right": "gliders — slow flight buys lift with area"
    },
    {
      "left": "the speed-squared term",
      "right": "fighters — fast flight does the work, small wings suffice"
    },
    {
      "left": "more speed at altitude",
      "right": "airliners at cruise — heavier by far, buying lift in thinner air"
    },
