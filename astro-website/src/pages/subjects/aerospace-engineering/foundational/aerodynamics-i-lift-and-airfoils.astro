    { name: 'v', label: 'airspeed', min: 30, max: 250, step: 5, value: 80, unit: 'm/s' },
    { name: 'cl', label: 'lift coefficient', min: 0.2, max: 1.6, step: 0.05, value: 0.8, unit: '' },
    { name: 'S', label: 'wing area', min: 10, max: 130, step: 2, value: 30, unit: 'm²' },
  ],
  readouts: [
    { label: 'lift = ½ρV²·S·CL', expr: '0.5*rho*v^2*S*cl', unit: 'N' },
    { label: 'mass this supports', expr: '0.5*rho*v^2*S*cl/9.81', unit: 'kg' },
  ],
