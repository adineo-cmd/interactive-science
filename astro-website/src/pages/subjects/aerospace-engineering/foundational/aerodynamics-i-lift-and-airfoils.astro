const aeDensityEstimate = {
  "prompt": "Airliners cruise near 11,000 metres, where density is about 0.4 kg per cubic metre. Roughly what per cent of sea-level density (1.225 kg/m³) is that?",
  "unit": "%",
  "answer": 33,
  "factor": 1.3,
  "why": "0.4 ÷ 1.225 ≈ 33% — thin air is cheap air: drag falls with the same ½ρV² that lift does, so the aircraft simply flies faster.",
  "context": "But not too slowly, or the C_L it needs would cross the stall ceiling — hence coffin corner."
};

const aeLedgerJudge = {
  "statements": [
    {
      "s": "Bernoulli and Newton tell rival stories about lift — one must be wrong.",
      "truth": false,
      "why": "They are the same physics counted twice: a pressure difference integrated over the wing, and air deflected downward."
    },
    {
      "s": "Wingtip vortices spiralling behind a landing airliner are the lift's downward momentum made visible.",
      "truth": true,
      "why": "An aircraft flying level throws air downward continuously — on a humid day you can watch it."
    },
    {
      "s": "Air must arrive in step above and below the wing.",
      "truth": false,
      "why": "Nothing enforces the rendezvous; the upper particle arrives far earlier."
    },
    {
