const liftStepsCfg = {
  steps: [
    { math: '1 · A wing turns the flow', note: 'An airfoil is shaped and angled so the oncoming air leaves deflected downward. By Newton\'s third law, the air pushes the wing up.' },
    { math: '2 · Pressure does the accounting', note: 'Flow accelerates over the curved upper surface; by Bernoulli\'s principle its pressure drops. The suction above contributes most of the lift.' },
    { math: '3 · Circulation, formally', note: 'Mathematically, lift equals air density × speed × circulation (the Kutta–Joukowski theorem) — the rotating flow the wing imposes on the air.' },
    { math: '4 · Angle of attack tunes it', note: 'Lift grows roughly linearly with angle of attack — until the critical angle, when the flow separates and the wing stalls.' },
    { math: '5 · L = ½ρV²S·CL', note: 'Everything compresses into one equation: dynamic pressure × wing area × lift coefficient. Cruise is solved by balancing it against weight.' },
  ],
};

const aeHandPredict = {
