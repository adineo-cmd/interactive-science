---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const outlierCfg = {
  params: [
    { name: 'outlier', label: 'fifth value (the outlier)', min: 8, max: 1000, step: 1, value: 10, unit: 'k' },
  ],
  readouts: [
    { label: 'mean of {2, 4, 6, 8, x}', expr: '(2 + 4 + 6 + 8 + outlier)/5' },
    { label: 'median (frozen at 6)', expr: '6' },
    { label: 'mean − median gap', expr: 'abs((2 + 4 + 6 + 8 + outlier)/5 - 6)' },
  ],
};

const ddNoticePlace = {
  "prompt": "The set {2, 4, 6, 8, x} with x dragged up to 1,000: place the marker where the mean now sits.",
  "labels": [
    "0",
    "250",
    "500",
    "750",
    "1000"
  ],
  "scale": {
    "min": 0,
    "max": 1000
  },
  "answer": 204,
  "tolerance": 20,
  "why": "The mean is dragged a fifth of the way toward the extreme: (2 + 4 + 6 + 8 + 1000) ÷ 5 = 204 — while the median never leaves 6. That asymmetry is the argument for median income."
};

const ddMiniSpot = {
  "prompt": "One line of this outlier anatomy is wrong — click it:",
  "lines": [
    "The set {2, 4, 6, 8, 10} has mean 6 and median 6 — perfect agreement.",
    "Drag the fifth value to 1,000: the mean becomes (2 + 4 + 6 + 8 + 1,000) ÷ 5 = 204.",
    "The median rises with it, to about 204 as well.",
    "An extreme value moves the mean by its excess over the others, divided by the count.",
    "The median only moves if the extreme value crosses the middle."
  ],
  "errorLine": 2,
  "correction": "The median stays frozen at 6 — nothing crossed the middle; only the mean chases the outlier, dragging four calm values up with it.",
  "why": "Rank is the median's whole diet: no crossing, no movement — which is why news reports that quietly swap mean for median are editing the story."
};

const ddGroupEst = {
  "prompt": "Waiting times arrive pre-bucketed: 0–10 min (14 customers), 10–20 (22), 20–30 (12), 30–40 (2). Call the estimated mean, in minutes.",
  "unit": "min",
  "answer": 15.4,
  "factor": 1.3,
  "why": "Midpoints: (5×14 + 15×22 + 25×12 + 35×2) ÷ 50 = 770 ÷ 50 = 15.4 minutes.",
  "context": "The modal class 10–20 already hints the mean sits in the teens — the estimate is honest only if values really cluster near midpoints."
};

const ddFreqOrder = {
  "prompt": "Ungrouped frequency table: sizes 6, 7, 8, 9 with frequencies 3, 9, 7, 1 — order the computations:",
  "items": [
    "Mode: the value with the highest frequency — 7, appearing 9 times",
    "Weighted mean: (6×3 + 7×9 + 8×7 + 9×1) ÷ 20 = 140 ÷ 20 = 7.0",
    "Median position: (n + 1) ÷ 2 = 20 + 1 over 2 = the 10.5th ordered item",
    "Median: between the 9th item (a 7) and the 10th (an 8), so median = 7"
  ],
  "why": "Mode by counting, mean by weighting, median by position — one table, three different questions."
};

const ddInterpCloze = {
  "text": "Grouped median by interpolation: median = L + ((n/2 − %%0%%) ÷ %%1%%) × %%2%% — here 10 + ((25 − 14) ÷ 22) × 10 ≈ 15.0 minutes.",
  "answers": [
    [
      "CF",
      "cumulative frequency before it",
      "cumulative frequency"
    ],
    [
      "f",
      "its frequency",
      "frequency"
    ],
    [
      "c",
      "its width",
      "class width",
      "width"
    ]
  ],
  "hint": "L is the class's lower boundary; the other three symbols are defined in the sentence just before the formula."
};

const ddMidJudge = {
  "statements": [
    {
      "s": "Grouped-data formulas produce estimates, and an exam answer should say so.",
      "truth": true,
      "why": "Bucketed data has lost the raw values; midpoint and interpolation are the best recovery of it, not a recovery of all of it."
    },
    {
      "s": "A bucket whose members bunch near its lower boundary makes the midpoint mean estimate too high.",
      "truth": true,
      "why": "The estimate is honest only if values really cluster near midpoints — bunching at an edge biases it."
    },
    {
      "s": "Grouping recovers all of the information the raw data contained.",
      "truth": false,
      "why": "It always costs information; the formulas are the best recovery, not a complete one."
    }
  ]
};

const ddPairSort = {
  "prompt": "Which centre-and-spread pairing does each dataset deserve?",
  "buckets": [
    "mean + SD",
    "median + IQR",
    "the mode"
  ],
  "items": [
    {
      "label": "clean, roughly symmetric data with no extreme values",
      "bucket": 0
    },
    {
      "label": "incomes — a few enormous fortunes stretch the tail",
      "bucket": 1
    },
    {
      "label": "the shirt size the shop must stock",
      "bucket": 2
    },
    {
      "label": "commute times with two peaks, from two different towns",
      "bucket": 2
    },
    {
      "label": "house prices — a few mansions among many flats",
      "bucket": 1
    },
    {
      "label": "bell-shaped exam marks feeding the 68–95–99.7 rule",
      "bucket": 0
    }
  ],
  "why": "Two diagnostics settle it: compare the mean to the median (a big gap signals skew or outliers) and look at the tail's direction."
};

const ddMisleadBranch = {
  "root": "Two summaries of the same institution land on your desk. Walk the defence.",
  "nodes": {
    "start": {
      "text": "A bar chart makes a 1% difference look like a landslide. First move?",
      "choices": [
        {
          "label": "Check where the y-axis starts",
          "next": "axis",
          "feedback": "A bar chart starting at 90 instead of 0 is the classic landslide-maker."
        },
        {
          "label": "Check how the groups were aggregated",
          "next": "agg",
          "feedback": "Aggregation is the other place summaries go quiet."
        }
      ]
    },
    "axis": {
      "text": "The bars start at 90, not 0.",
      "choices": [
        {
          "label": "Redraw from 0 before believing anything",
          "next": "fixed",
          "feedback": "The 1% difference collapses back to 1%."
        },
        {
          "label": "Bars are decorative — read the numbers",
          "next": "duped",
          "feedback": "The picture is the claim here: the truncation manufactures the gap."
        }
      ]
    },
    "agg": {
      "text": "The overall number reverses inside every subgroup.",
      "choices": [
        {
          "label": "Trust the disaggregated story — this is Simpson's paradox",
          "next": "fixed",
          "feedback": "Berkeley 1973: women applied disproportionately to the most competitive programmes, and the disaggregated answer was the truth."
        },
        {
          "label": "Average the subgroups back together",
          "next": "duped",
          "feedback": "That reproduces the reversal — the aggregate is the artifact."
        }
      ]
    },
    "fixed": {
      "text": "Defused. One question covers both traps: what did the summary discard to look that way?"
    },
    "duped": {
      "text": "Duped — a truncated axis manufactures a landslide, and a bad aggregation manufactures a reversal. Ask what was discarded."
    }
  },
  "why": "The aggregate answer and the disaggregated answer can be opposite — and only one of them is the truth."
};
---
<TopicPage slug="subjects/statistics/foundational/describing-data">

  <h2>Where you are, and what you will learn</h2>
  <p>
    This is an early lesson in Statistics, and it assumes only everyday arithmetic — adding,
    dividing, square-rooting — and a willingness to ask what a number actually measures. You
    need nothing from earlier lessons; each measure is computed on small sets first, then
    estimated from grouped data, then placed in a decision about when to use it, one step at
    a time.
  </p>
  <p>By the end you will be able to:</p>
  <ul>
    <li>compute the mean, median and mode on small datasets and say what each one ignores;</li>
    <li>estimate the mean, median and quartiles of grouped frequency data, and explain why the answers are estimates;</li>
    <li>compute and interpret the range, interquartile range and standard deviation, including the 68–95–99.7 rule for bell-shaped data;</li>
    <li>choose and defend a centre-and-spread pairing for skewed, symmetric and categorical data;</li>
    <li>recognise the classic ways summaries mislead — outliers, skew, Simpson's paradox and truncated axes.</li>
  </ul>

  <h2>The idea</h2>
  <p>
    A dataset of a million numbers is unreadable; statistics compresses it into a few honest summaries.
    A <strong>centre</strong> (mean, median or mode), a <strong>spread</strong> (range, interquartile
    range, standard deviation), and a <strong>shape</strong> (the histogram). Three numbers can stand
    in for a million — but only if you choose the right three, because each summary answers a slightly
    different question, and they disagree most exactly when it matters. Choosing well is not bookkeeping;
    it is the difference between describing the data and misdescribing it. This lesson builds the whole
    toolkit: how each measure is computed on small sets, how each is <em>estimated</em> when data arrive
    pre-bucketed into groups, and — the exam skill that transfers to real life — when to use which, with
    reasons you can defend.
  </p>

  <Widget no="1" caption="four calm values and one loud stranger — drag the outlier and watch which summary flinches" widget="sliderLab" config={outlierCfg} />
  <p>
    <strong>What to notice:</strong> drag the fifth value slowly upward and watch the mean
    readout rise while the median stays frozen at 6 — the mean is dragged, the median is not.
    Around 10 the two summaries agree exactly; by 1,000 the mean has climbed to about 204
    while the median has not moved. That asymmetry is the whole argument for reporting median
    income rather than mean income.
  </p>
  <Widget no="2" caption="one loud stranger — land the dragged mean on the track" widget="place" config={ddNoticePlace} />

  <p>
    The widget above contains the lesson in miniature. The set &#123;2, 4, 6, 8, 10&#125; has mean 6 and median 6 —
    perfect agreement. Drag the fifth value toward 1,000 and the mean chases it (dragging four other
    perfectly reasonable values up to 204 with it), while the median sits frozen at 6. One extreme value
    moves the mean by an amount equal to that value's <em>excess</em> over the others, divided by five; it
    cannot move the median at all unless it crosses the middle. That single asymmetry is why "average
    income" (mean, inflated by a few enormous fortunes) and "median income" (the middle person) tell
    different stories about the same country — and why news reports that swap them quietly are editing
    the story.
  </p>
  <Widget no="3" caption="one claim about the chase is wrong — click it" widget="spot-error" config={ddMiniSpot} />

  <p>
    <strong>So far:</strong> a centre, a spread and a shape compress a million numbers into a
    few honest summaries — and the widget showed the summaries disagreeing most exactly when
    it matters, with one extreme value in the data. Next we build each measure in turn,
    starting with the three candidates for the centre.
  </p>

  <h2>Three measures of centre</h2>
  <p>
    The <strong>mean</strong> is the sum divided by the count. For the five data values 2, 4, 6, 8, 10,
    the mean is 30 ÷ 5 = 6. It has two wonderful properties: it uses <em>every</em> value (no information
    discarded), and it balances the data like a seesaw — the total distance of points below the mean
    equals the total distance above it, so the mean is the unique balance point. Its weakness is the
    same fact: every value votes, so every value can be dragged.
  </p>
  <p>
    The <strong>median</strong> is the middle value when the data are ordered. With an odd count, take
    the middle one (&#123;1, 3, <strong>9</strong>, 15, 22&#125; → 9). With an even count, average the two middle
    ones (&#123;1, 3, 9, 15&#125; → (3 + 9) ÷ 2 = 6). The median only cares about <em>rank</em>, which is exactly
    why it is immune to outliers and the default for incomes, house prices and waiting times. Its cost:
    it ignores how far values sit from the middle — a dataset of 5s and one 5,000,000 looks the same to
    the median as one of 5s and one 6, when they are wildly different realities.
  </p>
  <p>
    The <strong>mode</strong> is the most frequent value. It is the only centre that works on categories:
    "the modal blood type is O" or "the modal colour sold is black" are meaningful, while a "mean blood
    type" is nonsense. For data given as an <strong>ungrouped frequency distribution</strong> — a table of
    values with counts, say shoe sizes 6, 7, 8, 9 with frequencies 3, 9, 7, 1 — the mode is simply the
    value with the highest frequency (7, appearing 9 times). The mean of such a table is computed by
    weighting each value by its frequency: (6×3 + 7×9 + 8×7 + 9×1) ÷ 20 = 140 ÷ 20 = 7.0. The median is
    the value of the (n + 1) ÷ 2 = 10.5th ordered item — between the 9th (a 7) and 10th (an 8), so
    median = 7. A dataset can have one mode, two modes (<strong>bimodal</strong> — often a signal of two
    mixed populations, like two peaks in a histogram of commute times from two different towns), or none
    where ties occur.
  </p>
  <Widget no="4" caption="a table of shoe sizes — rebuild the three answers in order" widget="order" config={ddFreqOrder} />

  <h2>Grouped data: estimating from buckets</h2>
  <p>
    Real datasets often arrive <strong>grouped</strong>: not individual values but a frequency table of
    classes, e.g. waiting times 0–10 min (14 customers), 10–20 (22), 20–30 (12), 30–40 (2), n = 50. The
    individual values are gone, so we estimate. The <strong>modal class</strong> is the class with the
    highest frequency — here 10–20. The estimated mean assumes every value in a class sits at its
    <strong>midpoint</strong>: (5×14 + 15×22 + 25×12 + 35×2) ÷ 50 = (70 + 330 + 300 + 70) ÷ 50 = 770 ÷ 50
    = 15.4 minutes. The estimate is honest only if values really cluster near midpoints; heavy
    concentration at a class edge biases it.
  </p>
  <Widget no="5" caption="call the grouped mean before the midpoints do" widget="estimate" config={ddGroupEst} />
  <p>
    The median (and quartiles and percentiles) of grouped data are found by <strong>interpolation</strong>
    within the class that contains the position you need. The formula: take the position n/2 = 25, run
    down cumulative frequencies (14, then 36) to find the median class 10–20, then median = L +
    ((n/2 − CF) ÷ f) × c, where L is the class's lower boundary, CF the cumulative frequency before it,
    f its frequency, c its width: 10 + ((25 − 14) ÷ 22) × 10 ≈ 15.0 minutes. The logic is simple and worth
    internalising rather than memorising: within that class of 22 people, we walk (25 − 14) = 11 people
    in from the left edge, so we travel 11/22 of the class width. The same recipe with n/4 or n×p gives
    any quartile or percentile. These are estimates — the price of bucketed data — and every exam answer
    should say "estimated".
  </p>
  <Widget no="6" caption="fill the interpolation formula" widget="cloze" config={ddInterpCloze} />
  <p><em>Common misconception:</em> the midpoint estimate assumes values are spread evenly within each
  class. If the 10–20 bucket is really everyone sitting at 11 minutes plus a few at 19, the true mean is
  below the estimate. Grouping always costs information; the formulas are the best recovery of it, not a
  recovery of all of it.</p>
  <Widget no="7" caption="true or false — the price of buckets" widget="judge" config={ddMidJudge} />

  <p>
    <strong>So far:</strong> the three centres each answer a different question — the mean
    uses every value, the median uses only rank, the mode handles categories — and grouped
    data turn exact computation into honest estimation by midpoints and interpolation. A
    centre alone is a headline without a story, so next we measure how spread out the data
    are around it.
  </p>

  <h2>Spread: range, IQR, standard deviation</h2>
  <p>
    A centre without a spread is a headline without a story. Two classes can share a mean of 70 while one
    contains every student between 68 and 72 and the other spans 40 to 99. The <strong>range</strong>
    (maximum − minimum) is the crudest measure: for &#123;2, 4, 6, 8, 10&#125; it is 8. It is fast but defined by
    exactly the two most extreme points in the dataset — the two most likely to be errors.
  </p>
  <p>
    The <strong>interquartile range</strong> is the range of the middle 50%. The lower quartile Q1 sits a
    quarter of the way up the ordered data, the upper quartile Q3 three quarters up; IQR = Q3 − Q1. For
    &#123;2, 4, 6, 8, 10&#125;: Q1 = 3, Q3 = 9, IQR = 6. (Convention matters — Cambridge takes Q1 at the
    (n + 1)/4th value and Q3 at the 3(n + 1)/4th for small sets; interpolation handles grouped data as
    above.) The IQR ignores the top and bottom quarters entirely, so it is <strong>resistant to
    outliers</strong> and pairs naturally with the median. It also powers the standard outlier rule: a
    value more than 1.5 × IQR beyond Q1 or Q3 earns investigation as a suspected outlier — a rule of
    thumb, not a verdict.
  </p>
  <p>
    The <strong>standard deviation</strong> asks a sharper question: on average, how far do values sit
    from the mean? Its computation reveals the concept: find each deviation (x − mean), square it (so
    negatives cannot cancel positives), average the squares, then square-root to undo the distortion.
    For &#123;2, 4, 6, 8, 10&#125; with mean 6: deviations are −4, −2, 0, 2, 4; squares are 16, 4, 0, 4, 16,
    totalling 40; the <strong>variance</strong> is 40 ÷ 5 = 8 (for a population; a sample divides by
    n − 1, giving 10, to correct a slight under-estimate); the standard deviation is √8 ≈ 2.83. The SD
    uses every value and is the backbone of inference — but because it squares deviations, it is
    <strong>hugely sensitive to outliers</strong>: a single 100 in that dataset would blow the SD up by
    a factor of many while barely moving the median or IQR. For bell-shaped data, the
    <strong>68–95–99.7 rule</strong> makes the SD interpretable: about 68% of values fall within one SD
    of the mean, 95% within two, 99.7% within three — so "mean 170, SD 7" instantly means "about 95% of
    people between 156 and 184".
  </p>
  <p><em>Common misconception:</em> the 68-95-99.7 rule works on any dataset — that every
  distribution puts 95% of its values within two SDs of the mean. The rule is a property of
  bell-shaped data; a heavily skewed or bimodal dataset (incomes, waiting times) can have
  wildly different proportions, and applying the rule to them manufactures confident
  nonsense. Check the histogram's shape first; the rule is a reward for symmetry, not a
  universal law.</p>

  <p>
    <strong>So far:</strong> range, interquartile range and standard deviation complete the
    toolkit, and the 68–95–99.7 rule makes the standard deviation interpretable — but only
    for bell-shaped data, as the misconception above warned. What remains is the exam skill
    and the life skill: choosing the right pairing of centre and spread, and defending the
    choice.
  </p>

  <h2>Choosing, and defending the choice</h2>
  <p>
    Every measure is right somewhere and wrong somewhere, and exam marks live in the justification.
    <strong>Mean + SD</strong> for clean, roughly symmetric data with no extreme values: they use all the
    information and feed the normal-distribution machinery. <strong>Median + IQR</strong> for skewed data
    or data with outliers: incomes and house prices are right-skewed (a few very large values stretch the
    tail), so the median income and IQR describe the typical household far better than the mean. The
    <strong>mode</strong> for categorical data (modal shirt size is the one the shop must stock) and for
    bimodal data where a single "centre" would describe no one. Two quick diagnostics tell you which
    world you are in: compare the mean to the median (a big gap signals skew or outliers), and look at
    the histogram's tail. If the mean exceeds the median, the data are right-skewed and the median is
    the honest centre.
  </p>
  <Widget no="8" caption="pair the dataset with its honest summary" widget="sort-buckets" config={ddPairSort} />
  <p>
    Misleading summaries are also a communication problem. <strong>Simpson's paradox</strong>: aggregated
    numbers can reverse the story in every subgroup — the University of California, Berkeley (1973)
    appeared biased against women overall while most individual departments actually favoured them,
    because women applied disproportionately to the most competitive programmes; the aggregate answer
    and the disaggregated answer were opposite, and the disaggregated one was the truth.
    <strong>Misleading axes</strong>: a bar chart starting at 90 instead of 0 can make a 1% difference
    look like a landslide. The defence in both cases is the same: ask what the summary is quietly
    throwing away.
  </p>
  <Widget no="9" caption="you are the reader — walk the two traps" widget="branch" config={ddMisleadBranch} />
  <p><em>Common misconception:</em> if the mean is bigger than the median, the data are
  left-skewed. The direction runs the other way: a big mean is the long tail of <em>high</em>
  values dragging the average upward — a right skew. House prices and incomes (a few
  mansions among many flats) are the standard examples: mean well above median, tail to the
  right. A useful check is to say which direction the outliers sit, then name the skew
  after them, not before.</p>

  <h2>Check yourself</h2>
  <p>Try these before moving on. Feedback follows each answer.</p>
  <ol>
    <li>For the ordered dataset 1, 3, 9, 15, what is the median, and why?</li>
    <li>A waiting-time distribution is heavily right-skewed. Which centre-and-spread pairing should you report, and why?</li>
    <li>A bell-shaped dataset has mean 170 and standard deviation 7. Roughly what range covers 95% of the values?</li>
  </ol>
  <p>
    <strong>Feedback:</strong> (1) 6 — with an even count you average the two middle ordered
    values: (3 + 9) ÷ 2 = 6. (2) Median and IQR: the long right tail drags the mean upward and
    inflates the standard deviation, while the median and IQR, which ignore the extremes,
    describe the typical case honestly. (3) About two standard deviations either side of the
    mean: 156 to 184 — the 95% band of the 68–95–99.7 rule.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>A centre, a spread and a shape compress a million numbers into a few summaries — and each summary answers a slightly different question.</li>
    <li>The mean uses every value and balances the data; the median uses only rank and is immune to outliers; the mode is the only centre for categories.</li>
    <li>One extreme value moves the mean by its excess over the others divided by the count; it cannot move the median unless it crosses the middle.</li>
    <li>Grouped-data means assume values sit at class midpoints, and grouped medians come from interpolation — both are estimates, and every answer should say so.</li>
    <li>The IQR ignores the top and bottom quarters and pairs naturally with the median; the standard deviation uses every value and pairs with the mean.</li>
    <li>The 68–95–99.7 rule is a reward for bell-shaped symmetry, not a universal law — check the histogram's shape first.</li>
    <li>A mean well above the median signals right skew — the tail of high values drags the average — and the defence against misleading summaries is asking what was quietly thrown away.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    With centres, spreads and shapes in hand, later lessons in this programme put the toolkit
    to work: visualising data honestly, then moving from describing data to reasoning under
    uncertainty, where probability supplies the logic and the standard deviation becomes the
    unit in which confidence is measured.
  </p>

  <h2>Going deeper</h2>
  <p>
    The mean–median relationship has an exact geometric meaning: the mean minimises the <em>sum of
    squared</em> deviations from any chosen point, while the median minimises the <em>sum of absolute</em>
    deviations — they are the optimal answers to different loss functions, which is why they respond to
    outliers differently (squared error punishes a huge deviation quadratically). The same logic scales
    up: variance is the expected squared deviation, and the reason statistics prefers squares over
    absolute values is largely that squares are analytically friendly — differentiable, additive across
    independent variables, and the seed of every confidence interval and significance test you will ever
    meet. Quartiles generalise to <strong>percentiles</strong> (the p-th value has p% of data below it —
    the 90th percentile of exam scores is the standard way to say "better than almost everyone"), and
    percentiles are what standardised testing reports because they are meaningful under <em>any</em>
    distribution, symmetric or not. One step further: a trimmed mean (delete the top and bottom 5%,
    then average) deliberately blends the mean's use of data with the median's resistance — sports
    judging uses exactly this compromise. The deep point is that "describing data" is really
    <em>modelling</em> it: every summary is a claim about which features of the data deserve to survive
    compression, and the statistician's judgement is about what gets lost.
  </p>
  <p class="sources"><strong>Sources:</strong> Bickel, Hammel & O'Connell, Science (1975) on Berkeley admissions; OpenStax, Introductory Statistics; Cambridge International AS & A Level Mathematics probability & statistics syllabus (measures of central tendency and dispersion). Source text: OpenStax (https://openstax.org), CC BY 4.0 — adapted for Interactive Atlas.</p>
</TopicPage>
