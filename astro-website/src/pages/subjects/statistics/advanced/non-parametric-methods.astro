---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const npCfg = {
  steps: [
    { math: 'When the normal assumption fails', note: 'Small samples, skewed data (incomes, waiting times), ordinal ratings (1–5 stars), or wild outliers — the classic t-test leans on assumptions these violate.' },
    { math: 'Mann–Whitney U: compare two groups', note: 'Rank all values together, compare the rank sums. It asks "do these groups differ in typical rank?" — nearly as powerful as the t-test when data is normal, far more robust when it is not.' },
    { math: 'Wilcoxon / signed-rank: paired data', note: 'Before-and-after designs: rank the changes, test whether the positive changes outweigh the negative ones.' },
    { math: 'Kruskal–Wallis: three or more groups', note: 'The rank-based cousin of one-way ANOVA — same question, fewer assumptions.' },
    { math: 'Spearman\'s ρ: rank correlation', note: 'Correlate the RANKS instead of the values. Captures "monotone but not straight-line" relationships and shrugs at outliers.' },
  ],
};

const npQuartileOrder = {
  "prompt": "Nine values — 2, 4, 4, 5, 6, 7, 8, 9, 15. Build the five-figure summary in order:",
  "items": [
    "Sort the values — the sorted positions are the order statistics",
    "Median (Q2): the 5th value — 6",
    "Q1: median of the four below — (4+4)/2 = 4; Q3: median of the four above — (8+9)/2 = 8.5",
    "IQR = 8.5 − 4 = 4.5 — the spread of the middle half"
  ],
  "why": "For grouped frequency tables the same quantities become interpolation estimates inside the containing class — the honest cost of grouped data."
};

const npDispSort = {
  "prompt": "Outlier sensitivity decides the summary — file each case:",
  "buckets": [
    "median and IQR",
    "mean and SD",
    "range"
  ],
  "items": [
    {
      "label": "skewed incomes, and a billionaire joins the sample",
      "bucket": 0
    },
    {
      "label": "clean, symmetric data where every point carries real information",
      "bucket": 1
    },
    {
      "label": "1–5-star customer ratings — ordinal",
      "bucket": 0
    },
    {
      "label": "instant, uses only two points, grows with sample size for pure sampling reasons",
      "bucket": 2
    },
    {
      "label": "reaction times from a well-run laboratory experiment",
      "bucket": 1
    }
  ],
  "why": "A rank is a position — no value, however extreme, can be more extreme than 'largest'; the order statistics cap every observation's influence."
};

const npSignSpot = {
  "prompt": "One line of this sign-test write-up is wrong — click it:",
  "lines": [
    "Paired data: keep only the direction of each change, + or −.",
    "Eight patients, seven improved and one did not.",
    "Under a fair-coin null: P(at least 7 of 8) = (C(8,7) + C(8,8))/2⁸ = 9/256.",
    "Doubled for a two-tailed test: p ≈ 0.070 — conventionally significant at the 5% level.",
    "The sign test throws away magnitudes entirely — its virtue is surviving ordinal scales."
  ],
  "errorLine": 3,
  "correction": "p ≈ 0.070 is suggestive but not conventionally significant — 0.070 is greater than 0.05.",
  "why": "The sign test's price is throwing magnitudes away; its payout is working where magnitudes are meaningless — 'better/worse' judgments, ratings."
};

const npTieCloze = {
  "text": "When two values are equal they share the average of the ranks they span: two observations tied for 5th and 6th each take rank %%0%%. Heavy clusters of ties shrink the variance of U — and a 1-to-5 rating with thirty responses produces only %%1%% distinct values.",
  "answers": [
    "5.5",
    [
      "five",
      "5"
    ]
  ],
  "hint": "Average the ranks they span; and count the possible ratings."
};

const npFamilyMatch = {
  "prompt": "Match each rank method to the job it does:",
  "pairs": [
    {
      "left": "Wilcoxon signed-rank",
      "right": "paired data — ranks the absolute differences; assumes they are roughly symmetric"
    },
    {
      "left": "Kruskal–Wallis",
      "right": "three or more independent groups — rank everything together, compare average ranks"
    },
    {
      "left": "Spearman's ρ",
      "right": "correlates the ranks: ρ = 1 − 6Σd²/(n(n²−1)) for small samples without ties"
    },
    {
      "left": "two judges, d² sum 3, n = 5",
      "right": "ρ = 1 − 18/120 = 0.85 — the same 0.85 whether scores were 90 vs 91 or 90 vs 990"
    }
  ],
  "why": "Only order enters the calculation — which is why rescaling the judges' scores leaves ρ untouched."
};

const npEffEst = {
  "prompt": "Under exact normality, Mann–Whitney's asymptotic relative efficiency against the t-test is about what value?",
  "unit": "efficiency",
  "answer": 0.955,
  "factor": 1.1,
  "why": "About 0.955 — a 4.5% sample-size penalty. Under heavy-tailed or contaminated data its efficiency exceeds the t-test's, unboundedly so for extreme tails.",
  "context": "The price of insurance is small and the payout is large exactly when you need it."
};

const npChoiceBranch = {
  "root": "A pilot returns 18 ratings on a 1–5 scale, with a couple of extreme values. Choose the analysis.",
  "nodes": {
    "start": {
      "text": "Ordinal scale, small n, visible outliers. Which instrument?",
      "choices": [
        {
          "label": "The t-test — the central limit theorem will save us",
          "next": "clt",
          "feedback": "The CLT drags the sampling distribution of the mean toward normality — but rescues tests of means slowly for heavy tails, and never rescues a single skew quantile."
        },
        {
          "label": "Mann–Whitney U on the ranks",
          "next": "ranks",
          "feedback": "Rank methods cap every observation's influence — the right instrument for ordinal, outlier-prone data."
        },
        {
          "label": "A permutation test — shuffle the labels thousands of times",
          "next": "perm",
          "feedback": "No distributional assumption, exact in principle — Fisher imagined it in the 1930s; cheap computing delivered it."
        }
      ]
    },
    "clt": {
      "text": "Forgiving with large samples, wobbling here — and the choice should have been made before the data.",
      "choices": []
    },
    "ranks": {
      "text": "A little power traded for a lot of robustness — an excellent trade with small, skewed data.",
      "choices": []
    },
    "perm": {
      "text": "Recompute the difference each shuffle and see where the real difference lands in the shuffle distribution.",
      "choices": []
    }
  },
  "why": "Report both when in doubt: agreement is reassuring; disagreement is diagnostic — the conclusion hinges on a handful of extreme observations, and the write-up should say so."
};

const npCornerJudge = {
  "statements": [
    {
      "s": "Friedman handles several treatments measured on the same subjects — the taster as their own control.",
      "truth": true,
      "why": "Rank the treatments within each subject, then ask whether the average ranks differ — the partner for taste panels and usability studies."
    },
    {
      "s": "Kruskal–Wallis is the tool for repeated measures on the same subjects.",
      "truth": false,
      "why": "Kruskal–Wallis handles several independent groups; Friedman is the repeated-measures corner."
    },
    {
      "s": "The runs test asks whether a sequence is random — too few runs means clustering.",
      "truth": true,
      "why": "Too few runs = streaks; too many = alternation — the tool for the 'hot hand' argument and for checking residuals."
    },
    {
      "s": "Too many runs in a binary series is the signature of streaks.",
      "truth": false,
      "why": "Too many runs means alternation; streaks produce too few."
    }
  ]
};
---
<TopicPage slug="subjects/statistics/advanced/non-parametric-methods">
  <h2>Where you are, and what you will learn</h2>
  <p>
    The intermediate lessons built the classical test kit — <strong>Hypothesis Testing</strong>
    gave you p-values and error types, <strong>Correlation &amp; Regression</strong> gave you
    Pearson's line and r — and both lean on assumptions about how data is distributed. This
    lesson is the toolkit for the days those assumptions fail. It stands directly on
    <strong>Describing Data</strong>, whose medians, quartiles and interquartile ranges turn
    out to be rank-based statistics already, and on <strong>Probability Foundations</strong>,
    whose binomial arithmetic powers the sign test.
  </p>
  <p>By the end you will be able to:</p>
  <ul>
    <li>read medians, quartiles and percentiles off sorted data, and estimate them for grouped frequency tables by interpolation;</li>
    <li>justify a choice among range, IQR and standard deviation by outlier sensitivity, with numbers to back it;</li>
    <li>run the sign test, Mann–Whitney U, Wilcoxon signed-rank, Kruskal–Wallis and Spearman's ρ on small data sets by hand;</li>
    <li>explain what non-parametric tests assume and do not assume, and why picking the test before seeing p-values is a discipline and not a preference;</li>
    <li>connect the rank tests to the permutation idea that modern computing made universal.</li>
  </ul>

  <h2>The idea</h2>
  <p>
    Classical tests assume distributions — usually the bell curve. <strong>Non-parametric
    methods drop that assumption</strong> by working on ranks instead of raw values: replace the
    data with their order positions and test those. You trade a little power for a lot of
    robustness — an excellent trade with small, skewed or weirdly distributed data, which is most
    real data most days. The dispersion measures you already know are the gateway: quartiles and
    the interquartile range are themselves rank-based statistics, and seeing exactly why they
    shrug off outliers while the standard deviation does not is the intuition the whole
    non-parametric toolbox is built on.
  </p>

  <Widget no="1" caption="the rank-based toolbox — one method per classic situation" widget="equationStep" config={npCfg} />
  <p>
    <strong>What to notice:</strong> each card pairs a situation where the classical test
    wobbles — small samples, skew, ordinal ratings, outliers — with the rank-based instrument
    built for it. The move is the same every time: replace values with order positions, then
    test those. As you step through, ask which distributional assumption the classical
    alternative would have needed, and notice that the first card is not a test at all but a
    diagnosis — the skill of recognising when the toolbox is the one you need.
  </p>

  <h2>Order statistics: quartiles and percentiles of small data sets</h2>
  <p>
    Sort n values; the sorted positions are the <strong>order statistics</strong>, and the
    median, quartiles and percentiles are read off them. For the nine values 2, 4, 4, 5, 6, 7,
    8, 9, 15: the median (Q2) is the 5th value, 6; Q1 is the median of the four below it —
    (4+4)/2 = 4; Q3 is the median of the four above — (8+9)/2 = 8.5. The
    <strong>interquartile range</strong> IQR = 8.5 − 4 = 4.5, the spread of the middle half of
    the data. The percentile idea generalises it: the k-th percentile is the value below which
    k% of the data lies, located (in the small-set convention) at position (k/100)(n+1) with
    interpolation between neighbours. For <strong>grouped data</strong> — a frequency table
    with class intervals — quartiles and percentiles are estimated by interpolation within the
    containing class: Q<sub>1</sub> = L + ((n/4 − F)/f) × h, where L is the class's lower
    boundary, F the cumulative frequency before it, f its frequency, h its width. Example:
    classes 10–20 (f = 5), 20–30 (f = 12), 30–40 (f = 8), 40–50 (f = 5), n = 30. Q1's position
    is n/4 = 7.5, inside 20–30 (cumulative before it is 5): Q1 = 20 + ((7.5 − 5)/12) × 10 ≈
    22.1. The median lands at 20 + ((15 − 5)/12) × 10 ≈ 28.3, Q3 at 30 + ((22.5 − 17)/8) × 10
    ≈ 36.9. These are estimates — the true values inside each class are unknowable from the
    table — which is the honest cost of grouped data.
  </p>
  <Widget no="2" caption="the quartiles, computed in order" widget="order" config={npQuartileOrder} />
  <p>
    <strong>So far:</strong> the sorted positions of a data set already carry the median, the
    quartiles and any percentile you ask for — grouped tables just force you to interpolate
    inside a class and admit the estimate. Next: put the three dispersion measures side by
    side and watch what one corrupted value does to each.
  </p>

  <h2>Range, IQR, standard deviation: choosing the measure</h2>
  <p>
    The three dispersion measures answer the same question with different trade-offs, and the
    syllabus's "justify your choice in context" is really an outlier-sensitivity question.
    <strong>Range</strong> (max − min) is instant and uses only two points — which makes it
    catastrophically sensitive: one extreme value rewrites it entirely, and it grows with
    sample size for pure sampling reasons. <strong>IQR</strong> ignores the outer quarters by
    design; it is the rank-based spread. <strong>Standard deviation</strong> uses every value
    and has the best statistical properties <em>when the data is roughly symmetric and
    light-tailed</em> — it is the natural partner of the mean and of the normal model. Watch
    the trade in one dataset. Nine values, 2, 4, 4, 5, 6, 7, 8, 9, 15: SD ≈ 3.8, IQR = 4.5.
    Corrupt one value — 15 becomes 150 (a data-entry error, a billionaire joining the income
    sample) — and SD explodes to ≈ 50.7, thirteen times larger, while IQR stays exactly 4.5
    (Q1 = 4, Q3 = 8.5, unchanged) and the median stays 6. The mean moved from ≈ 6.7 to ≈ 17.3;
    the median did not move at all. This is the deep reason ranks matter: a rank is a
    <em>position</em>, and no value, however extreme, can be more extreme than "largest" — the
    order statistics cap every observation's influence. Rule of thumb: skewed data or visible
    outliers → median and IQR; symmetric, well-behaved data where every point carries real
    information → mean and SD; and always say which you chose and why.
  </p>
  <Widget no="3" caption="which summary earns which data?" widget="sort-buckets" config={npDispSort} />
  <p>
    <strong>So far:</strong> ranks cap every observation's influence at "largest" — one
    corrupted value thirteen-times inflated the standard deviation while the median and IQR
    did not move. Next: that same protective idea stops being a summary choice and becomes a
    whole family of tests.
  </p>

  <h2>The test family, one worked example at a time</h2>
  <p>
    <strong>The sign test</strong> is the simplest non-parametric test: for paired data, keep
    only the direction of each change (+ or −) and ask whether the split is lopsided. Eight
    patients, seven improved and one did not: under a fair-coin null, P(at least 7 of 8) =
    (C(8,7) + C(8,8))/2⁸ = 9/256, doubled for a two-tailed test ≈ <strong>0.070</strong> —
    suggestive, but not conventionally significant. The sign test throws away magnitudes
    entirely; its virtue is surviving situations where magnitudes are meaningless (ordinal
    ratings, "better/worse" judgments).
  </p>
  <Widget no="4" caption="one line of this sign test is wrong — click it" widget="spot-error" config={npSignSpot} />
  <p>
    <strong>Mann–Whitney U</strong> compares two independent groups by pooling and ranking all
    values together, then comparing rank sums. Worked example — treatment group A: 10, 11, 12,
    13, 14, 15, 16; control group B: 1, 2, 3, 4, 5, 6, 50 (one wild value, as real controls
    produce). Ranks: A takes ranks 7–13 (sum 70); B takes 1–6 plus rank 14 for the 50 (sum
    35). With n = m = 7: U<sub>A</sub> = nm + n(n+1)/2 − R<sub>A</sub> = 49 + 28 − 70 = 7, and
    U<sub>B</sub> = 49 + 28 − 35 = 42; the test statistic is the smaller, U = 7. Tables give a
    two-tailed 5% critical value of 8 for 7 and 7; since 7 is below it, the groups differ in
    typical rank, significant at 5%. Now the punchline: the <em>t-test on the same data</em>
    gives t ≈ 0.43, p ≈ 0.68 — demolished by the single 50, which inflates the pooled standard
    deviation to 12.6. The rank test saw a nearly clean separation (one group almost entirely
    above the other); the parametric test saw noise, because one observation monopolised its
    variance estimate. This is not a trick dataset — it is what one contaminated control does
    to a small trial.
  </p>
  <p>
    The small print is <strong>ties</strong>: when two values are equal, they share the
    average of the ranks they span (two observations tied for 5th and 6th each take rank
    5.5), and heavy clusters of ties shrink the variance of U, which the software's tie
    correction absorbs but the hand tables ignore. Ties are why rank tests quietly lose power
    on coarse scales — a 1-to-5 rating with thirty responses produces only five distinct
    values, so order information is scarce no matter how the ranks are arranged — and why the
    sign test, which needs nothing but direction, is still a respectable instrument on exactly
    those scales.
  </p>
  <Widget no="5" caption="fill in the tie's shared rank" widget="cloze" config={npTieCloze} />
  <p>
    <strong>Wilcoxon signed-rank</strong> upgrades the sign test for paired data by ranking the
    <em>absolute</em> differences and summing the ranks of the positive and negative changes —
    it uses direction and size-of-change information, at the cost of assuming the differences
    are roughly symmetric. <strong>Kruskal–Wallis</strong> extends Mann–Whitney to three or
    more groups: rank everything together, compare the average ranks across groups; a large
    statistic says at least one group tends to sit higher, and pairwise Mann–Whitneys (with
    correction) locate where. <strong>Spearman's ρ</strong> correlates ranks: rank both
    variables, then apply the Pearson formula to the ranks (for small samples without ties,
    ρ = 1 − 6Σd²/(n(n²−1)) where d is the rank difference). Two judges ranking five entries
    with swaps at positions 2/1 and 4/3: d² sum = 3, so ρ = 1 − 18/120 = <strong>0.85</strong>
    — strong agreement, and the same 0.85 whether the scores were 90 vs 91 or 90 vs 990,
    because only order entered the calculation.
  </p>
  <Widget no="6" caption="the family — pair each test with its brief" widget="match" config={npFamilyMatch} />
  <p>
    <em>Common misconception:</em> "non-parametric tests are weaker, so always prefer the
    t-test." Under exact normality the Mann–Whitney's asymptotic relative efficiency against
    the t-test is about 0.955 — a 4.5% sample-size penalty. Under heavy-tailed or contaminated
    data its efficiency <em>exceeds</em> the t-test's, unboundedly so for extreme tails. The
    price of insurance is small and the payout is large exactly when you need it.
  </p>
  <Widget no="7" caption="price the insurance policy" widget="estimate" config={npEffEst} />

  <h2>Choosing honestly</h2>
  <p>
    The decision procedure is about the data, not fashion. <strong>Parametric wins when its
    assumptions hold</strong> — and with large samples the t-test is remarkably forgiving, the
    central limit theorem dragging the sampling distribution of the mean toward normality
    (though the CLT rescues the test of means, not the test of a single skew quantile, and it
    rescues it more slowly for heavy tails). <strong>Non-parametric wins with</strong> small n,
    heavy tails, ordinal scales, or when the result must survive outliers — "average customer
    rating" on 1–5-star data is ordinal, and rank methods are the right instrument.
    <strong>Permutation tests</strong> are the modern third way: shuffle group labels thousands
    of times, recompute the difference each time, and see where the real difference lands in
    the shuffle distribution — no distributional assumption at all, exact in principle; Fisher
    imagined it in the 1930s and cheap computing delivered it. <strong>Report both when in
    doubt:</strong> agreement between parametric and non-parametric analyses is reassuring;
    disagreement is diagnostic — it means the conclusion hinges on a handful of extreme
    observations, and the write-up should say so.
  </p>
  <Widget no="8" caption="choose the analysis before the p-values exist" widget="branch" config={npChoiceBranch} />
  <p>
    <em>Common misconception:</em> "non-parametric tests are assumption-free." They drop the
    <em>distributional</em> assumption, not the discipline: they still require independent
    observations, the Wilcoxon signed-rank additionally assumes the paired differences are
    roughly symmetric, and no test rescues data collected from a biased sample. Fewer
    assumptions is not no assumptions — the honest report names which ones remain and why
    they hold here.
  </p>
  <p>
    <em>Common misconception:</em> "run the t-test and the Mann–Whitney and report whichever
    is significant." Choosing the test after seeing the results is itself a multiple
    comparison: with five independent tests at the 5% level, the chance of at least one
    false positive is not 5% but about 23%. The data type — ordinal or scale, symmetric or
    skewed, outlier-prone or clean — decides the test <em>before</em> the p-values exist,
    which is why the decision procedure above is a flowchart and not a menu.
  </p>

  <h2>Two more members of the family</h2>
  <p>
    <strong>The Friedman test</strong> completes the repeated-measures corner: where
    Kruskal–Wallis handles several independent groups, Friedman handles several treatments
    measured on the <em>same</em> subjects — rank the treatments within each subject (1 to k),
    then ask whether the average ranks differ across treatments. It is the natural partner for
    taste panels (taster as their own control), usability studies (same users, three
    interfaces) and any within-subjects design with ordinal outcomes; its parametric cousin is
    repeated-measures ANOVA, and its post-hoc pairwise comparisons are signed-rank tests with
    multiplicity correction. <strong>The runs test</strong> (Wald–Wolfowitz) addresses the
    question the comparison tests ignore: is the <em>sequence</em> random? Count the runs of
    consecutive same-category outcomes in a binary series — too few runs means clustering
    (streaks), too many means alternation — which is the tool for the "hot hand" argument and
    for checking whether residuals from a model look like white noise.
  </p>
  <Widget no="9" caption="true or false — the family's corners" widget="judge" config={npCornerJudge} />

  <h2>Check yourself</h2>
  <p>Try these before moving on. Feedback follows each answer.</p>
  <ol>
    <li>In the nine-value set 2, 4, 4, 5, 6, 7, 8, 9, 15, replace the 15 with 150. State the median and IQR of the corrupted set, and say qualitatively what happens to the mean and the standard deviation.</li>
    <li>Two judges rank five entries and Spearman's ρ comes out at 0.85. If both judges had scored on a 0–990 scale instead of a 0–90 scale, with the same ordering, what would ρ be, and why?</li>
    <li>A colleague runs a t-test and a Mann–Whitney U on the same data and reports whichever is significant. Why is this a statistical error rather than thoroughness?</li>
  </ol>
  <p>
    <strong>Feedback:</strong> (1) The median stays 6 and the IQR stays 4.5, because Q1 and
    Q3 are order positions and the corrupted value is still just "the largest" — while the
    mean jumps from about 6.7 to about 17.3 and the SD explodes roughly thirteen-fold, since
    both use the raw magnitude of every point. (2) Still 0.85: Spearman correlates the
    <em>ranks</em>, and rescaling both judges' scores leaves every ordering untouched — only
    order entered the calculation. (3) Choosing the test after seeing the results is itself a
    multiple comparison: with five independent tests at the 5% level the chance of at least
    one false positive is about 23%, not 5%. The data's type and shape decide the test before
    the p-values exist; agreement between the two tests is reassuring, disagreement is
    diagnostic and belongs in the write-up.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>Non-parametric methods replace values with ranks: a rank caps any observation's influence at "largest".</li>
    <li>Median, quartiles and IQR are already rank-based statistics; grouped-data quartiles are interpolation estimates and are honest about it.</li>
    <li>Outlier sensitivity decides the summary: skewed or contaminated data takes median and IQR; clean symmetric data earns mean and SD.</li>
    <li>The family maps one-to-one onto classical situations: sign test, Mann–Whitney U, Wilcoxon signed-rank, Kruskal–Wallis, Friedman, Spearman's ρ.</li>
    <li>The insurance is cheap — about a 4.5% efficiency penalty under exact normality — and pays off unboundedly under heavy tails.</li>
    <li>Fewer assumptions is not no assumptions: independence, symmetric paired differences for Wilcoxon, and an honest sample all still apply.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    <strong>Experimental Design</strong> attacks the problem no test can repair — data
    collected from the wrong mechanism — which is why this page's decision procedure starts
    from how the data was gathered. <strong>Time Series Analysis</strong> handles the other
    structure ranks were not built for, ordered observations correlated with their own past;
    the runs test you just met is the first tool for asking whether such a series behaves
    randomly. And <strong>Bayesian Statistics</strong> holds the whole reject-or-not logic
    every test on this page shares up against a different way of reasoning from data.
  </p>

  <h2>Going deeper</h2>
  <p>
    <strong>Where the null distributions come from.</strong> Rank tests are exact small-sample
    tests because ranks have enumerable null distributions: under the null, every assignment of
    ranks to groups is equally likely, so the probability of any U value can be counted
    exactly — the published tables are those counts. With larger samples, U is approximately
    normal (mean nm/2, variance nm(n+m+1)/12, with a ties correction dividing by 1 − Σt³−t/((n+m)(n+m−1))
    where t counts tied ranks), which is what software computes. The same "enumerate the
    reassignments" logic is exactly the permutation test — the rank tests are permutation
    tests on a particular statistic (ranks), chosen for hand-computability; with laptops, any
    statistic can take that role. <strong>Beyond tests:</strong> non-parametric <em>estimation</em>
    is the larger modern field — kernel density estimation (smooth histograms), the empirical
    distribution function and its confidence bands, quantile regression (modelling the median
    or any quantile as a function of covariates — robust where OLS is not), and the bootstrap
    (resample your own data to get standard errors for almost anything), which is
    non-parametric inference's biggest practical victory. <strong>Open questions:</strong>
    non-parametric methods for dependent data (ranks in time series and networks are far less
    settled), rank-based approaches to missingness, and the practical statistics of very
    heavy-tailed quantities — wealth, city sizes, file-download times — where even medians and
    ranks strain and the honest summary may be several quantiles at once. What will not
    change: when one bad data point can ruin a small study, ranks are the measurement that
    cannot be ruined by magnitude.
  </p>

  <p class="sources"><strong>Sources:</strong> Mann and Whitney (1947); Wilcoxon (1945); Kruskal and Wallis (1952); Wasserman, All of Statistics; Efron and Tibshirani, An Introduction to the Bootstrap. Source text: OpenStax (https://openstax.org), CC BY 4.0 — adapted for Interactive Atlas.</p>
</TopicPage>
