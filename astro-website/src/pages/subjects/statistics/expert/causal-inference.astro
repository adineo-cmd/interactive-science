---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const causalCfg = {
  steps: [
    { math: 'Correlation ≠ causation — but why exactly?', note: 'Three innocent explanations: reverse causation, confounding (a hidden common cause), and selection. Only one of the two variables may actually drive the other — and raw data cannot tell you which.' },
    { math: 'Randomisation cuts the knot', note: 'In an experiment, chance assigns the cause — so hidden confounders balance out. This is why RCTs are gold: the causal answer is designed into the assignment.' },
    { math: 'No experiment? Think in graphs', note: 'Pearl\'s causal diagrams (DAGs) draw causes as arrows. They tell you which variables to control for — and, crucially, which NOT to: controlling a mediator or a collider manufactures fake effects.' },
    { math: 'Natural experiments', note: 'Sometimes the world randomises for you: lottery numbers, draft numbers, birth dates near school cut-offs. Exploiting these "as-if random" events (Angrist & Imbens, Nobel 2021) recovers causal effects from observational data.' },
  ],
};

const ciVarMatch = {
  "prompt": "Match each role or regression to what it asserts:",
  "pairs": [
    {
      "left": "independent variable",
      "right": "the suspected driver — plotted on the horizontal axis"
    },
    {
      "left": "dependent variable",
      "right": "the response — plotted on the vertical axis"
    },
    {
      "left": "regressing revision hours on exam score",
      "right": "'given five hours of practice, what score should we expect?'"
    },
    {
      "left": "the reverse regression",
      "right": "'given a score of 70, how much practice is typical?' — a genuinely different quantity, not a rounding of the first"
    }
  ],
  "why": "The least-squares line of y on x is not the algebraic inverse of the line of x on y — each answers a different conditional question."
};

const ciDirCompare = {
  "prompt": "The same 200 points, two claims — drag the divider:",
  "before": {
    "label": "what the scatter records",
    "text": "correlation of 0.9 in either direction — association, identical whichever arrow you draw"
  },
  "after": {
    "label": "what supplies the direction",
    "text": "time ordering, experiment design or a defensible causal argument — x causing y, y causing x, or a third variable causing both"
  },
  "why": "Strength of association is not a direction-finder; the diagram only records the association."
};

const ciCurveTrace = {
  "prompt": "The relationship is deterministic but r is essentially 0 — which curve is it?",
  "curves": [
    {
      "expr": "x^2",
      "color": "#1d4ed8",
      "label": "a symmetric curve — no linear pattern at all"
    },
    {
      "expr": "0.8*x",
      "color": "#0f766e",
      "label": "a strong positive line"
    },
    {
      "expr": "-0.8*x",
      "color": "#b42318",
      "label": "a strong negative line"
    }
  ],
  "correct": 0,
  "x": {
    "min": -3,
    "max": 3
  },
  "y": {
    "min": -3,
    "max": 9
  },
  "xlabel": "x",
  "ylabel": "y",
  "why": "r = 0 does not certify independence — it certifies only the absence of a linear pattern; curvature, clusters, gaps and outliers are invisible to a single number."
};

const ciSemiOrder = {
  "prompt": "Fit the line by semi-averages — order the steps:",
  "items": [
    "Order the points by x, then split into lower and upper halves",
    "Compute the mean of x and the mean of y in each half — (2.5, 20) and (6.5, 45) in the worked set",
    "Draw the unique straight line through those two mean points",
    "Read the slope: (45 − 20) ÷ (6.5 − 2.5) = 6.25 wpm per hour"
  ],
  "why": "A one-pass prototype of least squares — and robust to a single wild point in a way naive eyeballing is not."
};

const ciLineSpot = {
  "prompt": "One line of this fitted-line anatomy is wrong — click it:",
  "lines": [
    "Slope b = r × (sy ÷ sx): 0.80 × (10 ÷ 5) = 1.6 points per hour.",
    "Intercept a = mean of y − b × mean of x: 70 − 1.6 × 12 = 50.8.",
    "Predicted score at 15 hours: 50.8 + 1.6 × 15 = 74.8.",
    "The slope is a claim about each individual student — 1.6 points for this student.",
    "R² = 0.64: hours account for 64% of the variance, leaving 36% — precisely where confounding enters."
  ],
  "errorLine": 3,
  "correction": "The slope is a claim about average effect within the observed range — 1.6 points per hour on average, never 1.6 for this student.",
  "why": "The line explains variation, not persons — the slope is an anatomy of averages."
};

const ciIntJudge = {
  "statements": [
    {
      "s": "The intercept always means something.",
      "truth": false,
      "why": "It is the prediction at x = 0 — which may be outside the data (nobody revised for 0 hours here and sat the exam) or meaningless (zero height)."
    },
    {
      "s": "Here the intercept 50.8 is the predicted score with zero revision.",
      "truth": true,
      "why": "That is what it computes — but zero revision hours is an x value the data never contains."
    },
    {
      "s": "Interpret the intercept only where the data actually lives.",
      "truth": true,
      "why": "Report it, but read it only inside the observed range."
    }
  ]
};

const ciShoeEst = {
  "prompt": "Shoe size against age fits ages 3 to 10 beautifully. Extrapolated to age 25, it predicts what size?",
  "unit": "size",
  "answer": 17,
  "factor": 1.2,
  "why": "Size 17 — the true relationship levels off where the data ends. Extrapolation fails categorically, not gradually.",
  "context": "An extrapolation of 10% past the range is an estimate; 50% past it is a hope; past a known turning point it is wrong by construction."
};

const ciDagSort = {
  "prompt": "Pearl's rules are unforgiving — file each variable:",
  "buckets": [
    "control for it",
    "never control for it"
  ],
  "items": [
    {
      "label": "a confounder — a common cause of treatment and outcome",
      "bucket": 0
    },
    {
      "label": "a mediator — part of the effect you would erase",
      "bucket": 1
    },
    {
      "label": "a collider — a variable caused by two others",
      "bucket": 1
    },
    {
      "label": "the smoking-versus-birth-weight style error",
      "bucket": 1
    },
    {
      "label": "'adjust for everything in the database'",
      "bucket": 1
    }
  ],
  "why": "Conditioning on a collider manufactures association from nothing — among movie stars, beauty and talent appear negatively correlated because stardom requires at least one of the two."
};
---
<TopicPage slug="subjects/statistics/expert/causal-inference">
  <h2>Where you are, and what you will learn</h2>
  <p>
    This is the interpretive summit of the Statistics track. It assumes the intermediate
    lesson Correlation and Regression (scatter diagrams, r, lines fitted by eye and by rule)
    and Hypothesis Testing (what a p-value does and does not certify), plus the advanced
    lessons Experimental Design (randomisation as a design tool) and Bayesian Statistics
    (how assumptions enter an analysis). Those supply the machinery; this lesson asks what
    the machinery is allowed to claim.
  </p>
  <p>By the end you will be able to:</p>
  <ul>
    <li>name the three innocent explanations of an association — reverse causation, confounding, selection — and spot each in a case;</li>
    <li>explain why randomisation manufactures causally defensible comparisons;</li>
    <li>read a causal diagram's verdict: which variables to control for, and which control manufactures fake effects;</li>
    <li>state what a fitted line can carry (average effect within range, variance explained) and what it never can (direction, mechanism, extrapolation);</li>
    <li>recognise a natural experiment, and the scope limits of the causal claim it licenses.</li>
  </ul>

  <h2>The idea</h2>
  <p>
    Every science wants the same thing: not "these two things move together" but "this one
    moves <em>because of</em> that one". This chapter climbs that ladder in six steps. It
    begins where the bivariate-distributions unit begins — two variables, one scatter
    diagram, one fitted line — and ends where causal inference proper takes over: the
    machinery (potential outcomes, causal diagrams, natural experiments) that lets a
    researcher defend a causal claim from messy observational data. The unit's tools are
    not warm-ups for that machinery; they are its surface. The regression line is the most
    aggressively over-interpreted object in applied science, and the discipline's modern
    history — from statistics' long refusal to say "cause" at all, to Rubin's potential
    outcomes, Pearl's do-calculus and the 2021 Nobel prize — is the story of learning
    exactly which claims a fitted line can carry, and which it never can.
  </p>

  <Widget no="1" caption="the four ideas that turn association into (defensible) causation" widget="equationStep" config={causalCfg} />
  <p>
    <strong>What to notice:</strong> the four cards are ordered by how much design work each
    saves. Card one names the three innocent explanations raw data cannot rule out; card two
    shows what randomisation buys — hidden confounders balance because chance, not the
    researcher, assigns the cause. Card three is the observational fallback: the diagrams
    tell you which variables to control for and, crucially, which not — controlling a
    mediator or a collider manufactures the very fake effects you feared. Card four is the
    last resort that is often the best resort: find the corner of the world that randomised
    itself.
  </p>

  <h2>Independent and dependent variables: naming the direction</h2>
  <p>
    A bivariate analysis begins with an act of theory disguised as bookkeeping: choosing
    which variable is <strong>independent</strong> (the suspected driver, plotted on the
    horizontal axis) and which is <strong>dependent</strong> (the response, plotted on the
    vertical axis). Nothing in the data forces the choice. The same 200 points plotted
    either way describe the observations equally well, but they assert opposite stories —
    "practice raises scores" versus "high scores cause practice". The asymmetry is real even
    in pure arithmetic: the least-squares line of y on x is not the algebraic inverse of the
    line of x on y, because each answers a different conditional question. Regressing
    revision hours (x) on exam score (y) answers "given five hours of practice, what score
    should we expect?"; the reverse regression answers "given a score of 70, how much
    practice is typical?" — a genuinely different quantity, not a rounding of the first.
  </p>
  <Widget no="2" caption="naming the direction — pair each role with its clause" widget="match" config={ciVarMatch} />
  <p>
    <em>Common misconception:</em> "the direction of causation can be read off the scatter
    if the relationship is strong." It cannot. Time ordering, experiment design or a
    defensible causal argument supplies the direction; the diagram only records the
    association. Correlation of 0.9 in either direction is consistent with x causing y, y
    causing x, or a third variable causing both.
  </p>
  <Widget no="3" caption="what the plot records vs what supplies the arrow — drag the divider" widget="compare" config={ciDirCompare} />
  <p>
    <strong>So far:</strong> plotting the variables is an act of theory — nothing in the data
    forces the direction, and the two regressions answer genuinely different questions. Next:
    the single number everyone reaches for, and exactly how much it can carry.
  </p>

  <h2>Direction and strength: what the correlation coefficient measures</h2>
  <p>
    Pearson's correlation coefficient r condenses a scatter to a single number between
    −1 and +1: its sign gives the direction of the <em>linear</em> association, its
    magnitude the tightness of the cloud around a straight line. Values near ±1 mean the
    points hug a line; values near 0 mean no straight-line pattern. Galton's 1886 height
    data — the study that gave "regression" its name — put parent and child height at
    roughly r = 0.5: real, but loose enough that tall parents' children average shorter
    than the parents, and short parents' children taller. That is the deeper content of r:
    in standardised units the slope of the best-fit line <em>is</em> r, so r = 0.5 already
    means the line predicts only half the deviation to be carried through. And r = 0 does
    not certify independence — it certifies only the absence of a <em>linear</em> pattern.
    Data on y = x² collected symmetrically around zero give r essentially 0 while the
    relationship is perfectly deterministic.
  </p>
  <Widget no="4" caption="r ≈ 0, yet perfectly deterministic — which curve?" widget="trace" config={ciCurveTrace} />
  <p>
    <em>Common misconception:</em> "a correlation near ±1 is nearly a causal proof." Size
    of r measures association, not mechanism. Ice-cream sales and drowning deaths
    correlate strongly across months because summer drives both; the coefficient is
    indifferent to whether the connection is causal, confounded or coincidental.
  </p>
  <p>
    <strong>So far:</strong> the coefficient condenses a cloud to one number and records
    association — nothing more. Before trusting even that number, the next section shows why
    the scatter diagram is the first causal instrument, and what four identical summaries
    can hide.
  </p>

  <h2>Scatter diagrams: the first causal instrument</h2>
  <p>
    Before any coefficient, plot the data — and treat the plot as an instrument, not a
    formality. Curvature, clusters, gaps and outliers are all visible in a scatter and all
    invisible to a single number. The canonical demonstration is Anscombe's quartet (1973):
    four small data sets constructed so that every summary agrees — each has 11 points,
    mean of x = 9.0, mean of y = 7.5, r = 0.816, and the identical fitted line
    y = 3.00 + 0.50x. Plotted, they are four different worlds: one a clean linear cloud,
    one a perfect curve flattened into a line, one with a single outlier dragging the slope,
    one with one leverage point pinning the whole fit. Any of the four yields the same
    correlation, the same line and the same R²; only the scatter diagram tells you which
    story you are in. This is why serious applied work plots first, computes second — and
    why "the plot looks roughly linear" is a checkable assumption, not a decoration.
  </p>
  <p>
    <strong>So far:</strong> Anscombe's quartet proved that summaries can agree while the
    data tell four different stories — so the plot comes first. Now the fitting rules
    themselves: what a line is, and how the discipline chooses it.
  </p>

  <h2>Fitting a line by eye and by semi-averages</h2>
  <p>
    The unit's first fitting method is honest about what a line is: a summary, chosen by
    rule. The <strong>semi-averages</strong> method: order the points by x, split them into
    a lower half and an upper half, compute the mean of x and the mean of y in each half,
    and draw the unique straight line through those two mean points. Worked example —
    typing practice (hours, x) against speed (words per minute, y) for eight learners:
    (1, 12), (2, 18), (3, 24), (4, 26), (5, 38), (6, 40), (7, 49), (8, 53). Lower half:
    mean x = 2.5, mean y = 20. Upper half: mean x = 6.5, mean y = 45. Slope =
    (45 − 20) ÷ (6.5 − 2.5) = 6.25 wpm per hour; the line is y = 20 + 6.25(x − 2.5), i.e.
    y ≈ 4.4 + 6.25x. It predicts 35.6 wpm at x = 5 against an observed 38 — the line
    averages away individual noise, which is exactly its job. Splitting at the median x
    (rather than by count) is a common variant; either way the method is a one-pass
    prototype of least squares, and robust to a single wild point in a way naive
    eyeballing is not.
  </p>
  <Widget no="5" caption="the semi-averages method, in order" widget="order" config={ciSemiOrder} />

  <h2>The equation of the best-fit line</h2>
  <p>
    The least-squares line minimises the sum of squared vertical distances from points to
    line, and its coefficients have a compact anatomy: slope b = r × (s<sub>y</sub> ÷
    s<sub>x</sub>), intercept a = mean of y − b × mean of x. Worked example: revision hours
    against test scores with r = 0.80, s<sub>x</sub> = 5 hours, s<sub>y</sub> = 10 points,
    mean of x = 12, mean of y = 70. Then b = 0.80 × (10 ÷ 5) = 1.6 points per hour, and
    a = 70 − 1.6 × 12 = 50.8: the predicted score with zero revision. Predicted score at
    15 hours: 50.8 + 1.6 × 15 = 74.8. Two disciplines follow. First, the slope is a claim
    about <em>average</em> effect within the observed range — 1.6 points per hour, not 1.6
    for this student. Second, the line explains variation, not persons: an R² of 0.64 (r²
    for our data) says hours account for 64% of the variance in scores, leaving 36% for
    everything else — ability, sleep, luck — which is precisely where confounding enters.
  </p>
  <Widget no="6" caption="one line of this fitted-line anatomy is wrong — click it" widget="spot-error" config={ciLineSpot} />
  <p>
    <em>Common misconception:</em> "the intercept always means something." It is the
    prediction at x = 0, which may be outside the data (nobody revised for 0 hours here
    and sat the exam) or meaningless (zero height). Report it, but interpret it only where
    the data actually lives.
  </p>
  <Widget no="7" caption="true or false — the intercept's meaning" widget="judge" config={ciIntJudge} />
  <p>
    <strong>So far:</strong> the fitted line is an anatomy of averages — slope as average
    effect within range, R² as variance explained, and the unexplained remainder precisely
    where confounding lives. Next: what the line silently assumes, and why extrapolation
    breaks all of it at once.
  </p>

  <h2>Assumptions and the limits of extrapolation</h2>
  <p>
    Every fitted line silently asserts: the relationship is <em>linear</em> over the
    observed range; the deviations around the line behave roughly like independent random
    noise (no time-bunching, no funnel-shaped spread); and the points sampled are
    exchangeable with the ones you will predict for. Extrapolation beyond the observed
    range breaks all three at once, and the failure is not gradual — it is categorical.
    Shoe size against age fits beautifully from ages 3 to 10; extended to age 25 it
    predicts size 17 shoes, because the true relationship levels off where the data ends.
    Real cases follow the same shape: linear fits to a growing population project absurd
    totals within decades; a line fitted to a firm's early growth says nothing about its
    mature size. The rule of thumb is proportionate: an extrapolation of 10% past the
    range is an estimate; 50% past it is a hope; past a known turning point it is wrong by
    construction. The confidence a plot earned inside its range is exactly the confidence
    it cannot export beyond it.
  </p>
  <Widget no="8" caption="export the fit past its range — what shoe size?" widget="estimate" config={ciShoeEst} />
  <p>
    <em>Common misconception:</em> "a strong correlation makes extrapolation safer." The
    strength of r describes the scatter <em>inside</em> the observed range and says nothing
    whatsoever about the functional form outside it. Some of history's most confident
    failed forecasts — population bombs, resource exhaustion curves — were high-R² linear
    extrapolations of locally curved processes.
  </p>

  <h2>Check yourself</h2>
  <p>Try these before moving on. Feedback follows each answer.</p>
  <ol>
    <li>Recall: ice-cream sales and drowning deaths rise together across months. Name the innocent explanation the lesson gives, and the hidden common cause.</li>
    <li>Application: in Anscombe's quartet every summary agrees across four data sets — 11 points, mean of x = 9.0, mean of y = 7.5, r = 0.816, the identical fitted line. What does that prove about summaries, and what does each scatter reveal?</li>
    <li>Why-reasoning: why does controlling for a collider manufacture fake associations, per Pearl's movie-star example?</li>
  </ol>
  <p>
    <strong>Feedback:</strong> (1) Confounding — a hidden common cause: summer drives both
    ice-cream sales and swimming, and with it drownings; the coefficient is indifferent to
    whether the connection is causal, confounded or coincidental. (2) That agreement proves
    summaries are an incomplete description: four different worlds — a clean linear cloud, a
    perfect curve flattened into a line, an outlier dragging the slope, one leverage point
    pinning the whole fit — yield identical statistics, and only the scatter reveals which
    story you are in; hence the rule: plot first, compute second. (3) A collider is caused by
    two others, and conditioning on it induces association between its causes — among movie
    stars, beauty and talent appear negatively correlated because stardom requires at least
    one of the two, so restricting to stars manufactures a link that does not exist in the
    population.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>An association has three innocent explanations: reverse causation, confounding, selection.</li>
    <li>Randomisation is gold because chance assigns the cause — confounders balance by design.</li>
    <li>Causal diagrams give mechanical verdicts: control confounders, never mediators or colliders.</li>
    <li>The regression slope is an average effect within the observed range — nothing more.</li>
    <li>Identical summaries can hide four different worlds; plot first, compute second.</li>
    <li>Extrapolation fails categorically, not gradually — confidence earned inside the range cannot be exported.</li>
    <li>When experiments are impossible, borrow the world's own randomisation — and state the claim's scope.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    Two sibling expert lessons continue the track. Multivariate Statistics takes the fitting
    idea to many variables at once — the situation you are in the moment there is more than
    one candidate control — and Statistical Computing examines where the data come from:
    populations, samples and the bias mechanisms no adjustment can repair. If the diagrams
    gripped you most, the advanced lesson Experimental Design is worth a re-read.
  </p>

  <h2>Going deeper</h2>
  <p>
    <strong>Potential outcomes.</strong> Rubin's framework makes the causal claim
    embarrassingly concrete: each unit has two outcomes, the one that occurs if treated
    and the one that occurs if not, and the causal effect is their difference. We observe
    exactly one — the other is the <em>counterfactual</em>. All of applied causal
    inference is estimation of an unobservable, which is why randomisation is gold: in a
    randomised trial, chance assigns treatment, the two groups are exchangeable in
    expectation, and the mean difference estimates the mean causal effect with no model
    for confounders at all.
  </p>
  <p>
    <strong>Drawing the arrows.</strong> Pearl's directed acyclic graphs encode assumed
    causal structure and compute, mechanically, which variables to condition on. The
    rules are unforgiving: control for a <em>confounder</em> (a common cause), do not
    control for a <em>mediator</em> (part of the effect you would erase — the
    smoking-versus-birth-weight style error), and never control for a
    <em>collider</em> (a variable caused by two others), which manufactures association
    from nothing — Pearl's own example: among movie stars, beauty and talent appear
    negatively correlated, because stardom requires at least one of the two. "Adjust for
    everything in the database" is therefore not caution; it is a way to bias a result.
  </p>
  <Widget no="9" caption="the diagrams' verdict — control, or never control?" widget="sort-buckets" config={ciDagSort} />
  <p>
    <strong>Design over statistics.</strong> When experiments are impossible, the
    credibility revolution seeks situations where the world randomised for us. Card and
    Krueger's 1994 comparison of fast-food employment across the New Jersey–Pennsylvania
    border around New Jersey's 1992 minimum-wage rise, and Angrist's use of the Vietnam
    draft lottery as an instrument for military service (white veterans lost roughly 15%
    of earnings per year of service, an effect invisible in raw comparisons), both
    exported the logic of the experiment to observational data. Each design carries a
    scope, too: Card and Krueger identify the short-run effect on fast-food employment
    near one border in 1992, not the effect of every minimum-wage rise everywhere — a
    humility the popular summaries usually lose. The 2021 Nobel to Angrist
    and Imbens formalised what such designs recover — and their limits.
  </p>
  <p>
    <strong>Open frontiers.</strong> The two formal cultures — Pearl's graphs and Rubin's
    potential outcomes — still argue about vocabulary while converging in practice.
    Sensitivity analysis (how strong would an unmeasured confounder have to be to erase
    the finding?) is moving from optional to expected. And machine learning is being
    rebuilt around causal targets: methods that estimate heterogeneous effects rather
    than one average slope, treating the fitted line of this unit as the crudest member
    of a growing family.
  </p>

  <p class="sources"><strong>Sources:</strong> Pearl, Causality (2009) and The Book of Why (2018); Imbens & Rubin, Causal Inference (2015); Nobel Prize 2021 citations. Source text: OpenStax (https://openstax.org), CC BY 4.0 — adapted for Interactive Atlas.</p>
</TopicPage>

