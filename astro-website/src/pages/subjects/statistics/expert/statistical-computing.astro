---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const scCfg = {
  steps: [
    { math: '1 · Computation changed the questions', note: 'Bootstrap resampling, permutation tests and simulation let you answer questions by brute force that no closed-form formula exists for. Fisher imagined shuffling labels in 1935; a laptop does it a million times over lunch.' },
    { math: '2 · The bootstrap', note: 'Resample your own data with replacement thousands of times; the spread of the results is the uncertainty. No normality assumption, no formulas — Efron (1979) built one of statistics\' great ideas out of a repeat loop.' },
    { math: '3 · Simulation as understanding', note: 'Fake data with known truth, run your method, check it recovers the truth. Every serious analysis deserves a simulation study — and Monte Carlo methods (Metropolis, 1953) power modern Bayesian computing.' },
    { math: '4 · Reproducible pipelines', note: 'Scripts (R, Python) that run end-to-end — data in, results out — are the standard of proof. Knitr/Jupyter notebooks, version control and environments make your analysis a re-runnable object, not a memory.' },
  ],
};

const scDescMatch = {
  "prompt": "Every classical mechanism gained a computational descendant — pair them:",
  "pairs": [
    {
      "left": "the random number table",
      "right": "the pseudorandom generator that replaced it"
    },
    {
      "left": "the worry about sampling bias",
      "right": "the simulation study — data with known truth, bias measured directly"
    },
    {
      "left": "the survey question, open or closed",
      "right": "a typed column in a dataframe, with all the precision and fragility that implies"
    },
    {
      "left": "a claim resting on a sampling or measurement choice",
      "right": "simulate the choice first, and only then trust it"
    }
  ],
  "why": "Read the classical data-collection unit through the lens of code: the mechanics stayed, the machinery changed."
};

const scCardsSpot = {
  "prompt": "One summary of the four cards is wrong — click it:",
  "lines": [
    "Fisher imagined shuffling labels in 1935; a laptop runs the same idea a million times over lunch.",
    "The bootstrap is that brute force aimed at your own sample — resample it, and the spread of the results is the uncertainty.",
    "A simulation study feeds a method fake data with known truth and checks whether it recovers that truth.",
    "Fixed seeds make an analysis harder to reproduce, so serious scripts avoid them."
  ],
  "errorLine": 3,
  "correction": "A fixed seed does the opposite: same seed → same sample → same result, turning the analysis into a re-runnable object.",
  "why": "Scripts, environments and seeds are the infrastructure that lets anyone re-run your analysis — card four is a feature, not an obstacle."
};

const scSeEst = {
  "prompt": "A pollster samples n = 100 voters and reports a percentage near 50. Roughly what is the standard error, in percentage points?",
  "unit": "points",
  "answer": 5,
  "factor": 1.5,
  "why": "√(0.5 × 0.5 ÷ 100) = 0.05 — five points either way, which is why a poll at 55% versus another at 63% is routine fluctuation, not news.",
  "context": "The width is fixed by n before anyone is sampled — and the cloud of a thousand sample means comes out approximately normal."
};

const scSizeJudge = {
  "statements": [
    {
      "s": "A bigger sample shrinks random error.",
      "truth": true,
      "why": "Averages of many draws wobble less — that is the part of the error that n buys down."
    },
    {
      "s": "A bigger sample shrinks systematic error the same way.",
      "truth": false,
      "why": "Bias rides on the selection mechanism, which n never touches."
    },
    {
      "s": "A census is automatically better than any sample.",
      "truth": false,
      "why": "Nonresponse and hard-to-reach groups leave most real censuses behaving like enormous, expensive, slightly broken samples."
    },
    {
      "s": "Given a large poll with a skewed selection and a small poll with a representative selection, trust the large one.",
      "truth": false,
      "why": "Representativeness, not size, is what a sample owes you."
    }
  ]
};

const scSampSort = {
  "prompt": "Four selection schemes — which ones keep the randomness honest?",
  "buckets": [
    "a genuine probability sample",
    "selection compromised or non-random"
  ],
  "items": [
    {
      "label": "every member gets an equal chance — the default all theory assumes",
      "bucket": 0
    },
    {
      "label": "every kth unit after a random start (850 pupils, k ≈ 8 or 9)",
      "bucket": 0
    },
    {
      "label": "randomly within strata — inpatients around 6.2, outpatients 7.9, proportional allocation",
      "bucket": 0
    },
    {
      "label": "20 men over 60, whatever the interviewer's convenience provides",
      "bucket": 1
    },
    {
      "label": "every 7th house on a street whose list carries a weekly rhythm",
      "bucket": 1
    }
  ],
  "why": "The random start is what keeps systematic sampling a probability method; quota looks representative, but the choosing hand belongs to the interviewer."
};

const scDetBranch = {
  "root": "You are the computational bias detector. Walk the audit of a poll.",
  "nodes": {
    "start": {
      "text": "The sample's age and regional mix disagrees with the census benchmark. What now?",
      "choices": [
        {
          "label": "Compare against the known totals, then reweight",
          "next": "audited",
          "feedback": "Comparison against known totals plus reweighting — both trivial in code."
        },
        {
          "label": "Trust it — the poll is enormous",
          "next": "sizeTrap",
          "feedback": "Size reduces random error, not systematic error; a million respondents from a skewed frame stay skewed."
        }
      ]
    },
    "audited": {
      "text": "The weights balance the mix. What question remains before you report?",
      "choices": [
        {
          "label": "Was the sampling frame itself right?",
          "next": "frame",
          "feedback": "Both detectors are useless if the frame was wrong — no weight restores a household the frame never listed."
        },
        {
          "label": "Publish, with the audit trail",
          "next": "publish",
          "feedback": "Log every exclusion and report how many records each cleaning rule removed."
        }
      ]
    },
    "frame": {
      "text": "Dead end — a wrong frame cannot be reweighted into truth. Write the cleaning rules before seeing outcomes, and the audit trail separates data curation from data corruption."
    },
    "sizeTrap": {
      "text": "Dead end — systematic error survives any n. The selection mechanism owns this bias, not the sample size."
    },
    "publish": {
      "text": "Reported: benchmark comparison, reweighting, logged exclusions. The analysis is a re-runnable object, not a memory."
    }
  },
  "why": "The computational detectors are cheap; the sampling frame they run on is the bottleneck."
};

const scGenOrder = {
  "prompt": "Random sampling, mechanised — order the lineage:",
  "items": [
    "Number every member (pupils 001–850), read three-digit groups off a random number table, accept 001–850, skip 000 and 851–999 and repeats",
    "Von Neumann's middle-square (1946): square the seed, keep the middle digits — fast, but it collapses to zero",
    "Linear congruential generators do better",
    "The Mersenne Twister — today's default in R and Python, period 2^19937 − 1",
    "Run the same script with the same seed: same sample, same bootstrap — the analysis becomes a re-runnable object"
  ],
  "why": "The recipe never changed — only the table became an algorithm, and its determinism became reproducibility."
};

const scSeedPredict = {
  "q": "You run the same sampling script twice with the same seed. What comes out the second time?",
  "choices": [
    "Two different samples — that is what random means",
    "The identical sample, draw for draw",
    "The same summary statistics, but different individual draws",
    "An error — seeds cannot be reused"
  ],
  "answer": 1,
  "why": "Pseudorandom generators produce deterministic streams seeded with a number: same seed, same sample, every time. For sampling from a finite population that is fine — and it is exactly why a fixed seed belongs in every serious script."
};
---
<TopicPage slug="subjects/statistics/expert/statistical-computing">
  <h2>Where you are, and what you will learn</h2>
  <p>
    This is where the Statistics track meets its machinery. It assumes Describing Data
    (foundational — the data types this lesson turns into code contracts), Sampling and
    Survey Design (intermediate — populations, sampling frames and the bias taxonomy you
    will learn to simulate), Confidence Intervals (intermediate — the uncertainty this
    lesson bootstraps) and Experimental Design (advanced). Every classical idea here has a
    computational descendant.
  </p>
  <Widget no="2" caption="the descendants — pair each classical tool with its computational heir" widget="match" config={scDescMatch} />
  <p>By the end you will be able to:</p>
  <ul>
    <li>simulate sampling variation directly — a population with known truth, a thousand samples, the visible cloud of means;</li>
    <li>explain why a fixed seed makes an analysis a re-runnable object rather than a memory;</li>
    <li>run the computational bias detectors: benchmarks against known totals, reweighting, cleaning rules written before outcomes;</li>
    <li>map qualitative, discrete and continuous data onto software types, and say which statistics each makes legal;</li>
    <li>state what the bootstrap, the permutation test and the simulation study each deliver.</li>
  </ul>

  <h2>The idea</h2>
  <p>
    Statistical computing is where the discipline now lives — but the computational turn
    did not start with machine learning; it started with the humblest act in statistics:
    choosing a sample. Every topic in the data-collection unit has a computational
    descendant. The random number table became the pseudorandom generator. The worry about
    sampling bias became the simulation study, where you can measure bias directly by
    generating data with known truth. The survey question, open or closed, became a data
    type in a dataframe, with all the precision and all the fragility that implies. This
    chapter reads the classical unit through that lens: the mechanics of getting data
    right, and the code that now carries them. The payoff is a habit of mind — if a claim
    depends on a sampling or measurement choice, you can usually test that choice by
    simulating it before you trust it.
  </p>

  <Widget no="1" caption="the computational turn — four ideas that reshaped statistics" widget="equationStep" config={scCfg} />
  <p>
    <strong>What to notice:</strong> the four cards run from idea to infrastructure. Card
    one: the computational turn means brute force answers questions no closed-form formula
    exists for — Fisher imagined shuffling labels in 1935, a laptop does it a million times
    over lunch. Card two, the bootstrap, is that brute force aimed at your own sample. Card
    three is the epistemics: fake data with known truth tests whether a method recovers
    what it claims to. Card four is what makes the whole thing checkable — scripts,
    environments and fixed seeds that turn an analysis into a re-runnable object.
  </p>
  <Widget no="3" caption="one card summary is wrong — click it" widget="spot-error" config={scCardsSpot} />

  <h2>Populations, samples, censuses and the representative ideal</h2>
  <p>
    The <strong>population</strong> is every unit you wish to speak about; a
    <strong>sample</strong> is the part you observe; a <strong>census</strong> is the
    attempt to observe all of them. Census is not automatically better: it is slower,
    costlier, and in practice incomplete — nonresponse and hard-to-reach groups mean most
    real censuses behave like enormous, expensive, slightly broken samples. What matters
    is the <strong>representative</strong> property: the sample's composition mirrors the
    population's, so that sample statistics estimate population parameters. Computation
    makes the concept tangible: simulate a population of a million values with a known
    mean, draw a thousand samples of 100, and plot the thousand sample means. The spread
    of that cloud is sampling variation, made visible — and its width is predictable: a
    proportion near 0.5 sampled with n = 100 has a standard error of
    √(0.5 × 0.5 ÷ 100) = 0.05, so a poll at 55% versus another at 63% is routine
    fluctuation, not news. The simulation also shows the shape: however odd the
    population, the cloud of a thousand sample means comes out approximately
    normal — the insight the formula compresses. No formula-memorising required; the
    laptop shows you.
  </p>
  <Widget no="4" caption="call the standard error before the formula does" widget="estimate" config={scSeEst} />
  <p>
    <em>Common misconception:</em> "a bigger sample fixes bad sampling." Size reduces
    <em>random</em> error, not <em>systematic</em> error. A million respondents recruited
    from one social platform converge precisely on the biased view of that platform's
    users; the bias is a property of the selection mechanism, and no n erases it.
  </p>
  <Widget no="5" caption="true or false — what sample size can and cannot buy" widget="judge" config={scSizeJudge} />
  <p>
    <strong>So far:</strong> representativeness, not size, is what a sample owes you — and
    the simulation made sampling variation visible without a formula in sight. Next: the
    four classical selection schemes, each with a different relationship to that ideal.
  </p>

  <h2>Sampling methods: simple random, systematic, stratified and quota</h2>
  <p>
    <strong>Simple random sampling</strong> gives every member an equal chance — the
    default that all theory assumes. <strong>Systematic sampling</strong> takes every
    k<sup>th</sup> unit after a random start — with 850 pupils and a sample of 100,
    k ≈ 8 or 9 — and the random start is what keeps it a probability method rather than a
    habit; it is cheap and spreads evenly, but it silently assumes the list has no periodic
    structure — every 7th house on a street of weekly-rubbish-day patterns can sample one
    day of the week forever. <strong>Stratified sampling</strong> divides the population
    into meaningful strata (hospital inpatients versus outpatients; year groups in a
    school) and samples randomly within each, which reduces variance: if inpatients rate
    satisfaction around 6.2 and outpatients 7.9, a stratified sample with proportional
    allocation estimates each group well and the overall mean more precisely than a blind
    simple random sample of the same size. <strong>Quota sampling</strong> fills
    pre-set categories (20 men over 60, say) by whatever interviewer convenience
    provides — the categories match the population but the selection inside each is
    non-random, and that is where bias enters through the interviewer's choosing hand.
  </p>
  <Widget no="6" caption="four schemes on trial — file each by its selection" widget="sort-buckets" config={scSampSort} />

  <h2>Bias in sampling: the mechanisms and the detectors</h2>
  <p>
    Bias has a short taxonomy worth memorising, because each entry has a classic
    disaster. <strong>Selection bias</strong>: the 1948 US presidential election, where
    Gallup's quota method — otherwise respectable — had respondents chosen by
    interviewers and polling stopped weeks early; the Chicago Tribune famously went to
    press with "Dewey Defeats Truman" against Truman's actual win. <strong>Survivorship
    bias</strong>: in the Second World War, Abraham Wald analysed returning bombers'
    bullet holes and recommended armouring the places <em>without</em> holes — the
    engine area — because planes hit there did not come back to be counted.
    <strong>Nonresponse and voluntary response</strong>: online polls attract the
    motivated; low response rates convert a survey into a poll of the willing.
    <strong>Undercoverage</strong>: phone surveys that miss mobile-only households.
    Computation adds a third layer the classical unit never faced: <em>processing</em>
    bias. Missing values are not neutral absences — dropping every record with a gap
    quietly deletes the hardest-to-reach respondents exactly when the survey most needs
    them; unit errors (heights recorded in centimetres read as inches) propagate through
    every statistic downstream; and cleaning rules written after seeing the results can
    manufacture the finding they claim merely to reveal. The professional discipline is
    to write the cleaning code before looking at outcomes, log every exclusion, and
    report how many records each rule removed — a short audit trail separating data
    curation from data corruption.
    The computational detector is comparison against known totals (does the sample's age
    or regional mix match census benchmarks?) and reweighting — both trivial in code,
    both useless if the sampling frame itself was wrong.
  </p>
  <Widget no="7" caption="you are the detector — walk the audit" widget="branch" config={scDetBranch} />

  <h2>Random number tables and their algorithmic heirs</h2>
  <p>
    The classical mechanism: number every member of the population (pupils 001–850, say),
    open the random number table anywhere, read three-digit groups left to right, accept
    001–850, skip 000 and 851–999 and repeats, and stop when you have the 12 names you
    need. The computer's version is the same recipe with the table replaced by an
    algorithm — and the replacement is worth understanding, because it is the foundation
    of reproducibility. Von Neumann's middle-square method (1946) squared a seed and kept
    the middle digits — fast, but it collapsed to zero; later linear congruential
    generators were better; today's default in R and Python, the Mersenne Twister, has
    period 2<sup>19937</sup> − 1. The crucial fact: these are <em>pseudorandom</em>
    — deterministic streams seeded with a number. Run the same script with the same seed
    and you get the same sample, the same bootstrap, the same result. That is a feature,
    not a cheat: a seed turns an analysis from a one-off into a re-runnable object.
  </p>
  <Widget no="8" caption="from table to Twister — rebuild the lineage" widget="order" config={scGenOrder} />
  <p>
    <em>Common misconception:</em> "computers generate truly random numbers." They
    generate deterministic sequences that pass randomness tests. For sampling from a
    finite population this is fine — the statistical properties are what matter — but the
    determinism is exactly why a fixed seed belongs in every serious script.
  </p>
  <Widget no="9" caption="bet on the second run" widget="predict" config={scSeedPredict} />
  <p>
    <strong>So far:</strong> the table became the pseudorandom generator, and its
    determinism became reproducibility — the same seed, the same sample, every time. Next:
    what happens after the sample is drawn — the questions themselves, and their
    computational afterlife as data types.
  </p>

  <h2>Open and closed questions in surveys</h2>
  <p>
    A <strong>closed question</strong> offers fixed options: fast to answer, cheap to
    tabulate, but it decides in advance what opinions can exist, and option order,
    scale labels ("excellent to poor" versus "poor to excellent") and the simple presence
    of a middle option all measurably shift answers. An <strong>open question</strong>
    ("What would improve the school canteen?") captures the unexpected but demands
    expensive human or machine coding before it becomes data — and coding is itself a
    measurement choice. Wording is the sharpest instrument: in a classic result
    replicated by Schuman and Presser, only about half of respondents said the United
    States should "forbid" speeches against democracy, but roughly three-quarters said
    such speeches should be "allowed" — one opinion, opposite wording, opposite answer. Computationally, the
    closed question is a categorical variable from the moment of design; the open question
    is unstructured text that must be classified before any software can count it. Design
    the questionnaire and the schema together; they are the same object.
  </p>
  <p>
    One low-tech defence survives every generation of tooling: the pilot. Testing the
    questionnaire on a handful of respondents — ideally while watching them answer —
    remains the cheapest bias detector ever invented, because it catches the confusing
    option, the loaded adjective and the missing category before the data exists rather
    than after. No software has replaced it; the computer can only count what the
    question managed to ask.
  </p>

  <h2>Classifying data: qualitative, quantitative, discrete, continuous</h2>
  <p>
    The classification is not taxonomy for its own sake — it determines which statistics
    and which code paths are legal. <strong>Qualitative</strong> (categorical) data:
    blood group, nationality, favourite genre. <strong>Quantitative</strong> data:
    numerical, and either <strong>discrete</strong> (countable: household size, goals per
    match) or <strong>continuous</strong> (measurable on a scale: height, reaction time).
    Averaging postcodes is a category error the computer will happily commit — it will
    compute a mean of anything you hand it. In software the mapping is concrete:
    categories belong in factor or categorical types (so models treat them as levels, not
    numbers), counts in integers, measurements in floats — and floats have an exactness
    boundary: IEEE 754 double precision carries roughly 15–16 significant digits, and
    0.1 + 0.2 does not equal 0.3 exactly. Add Wickham's tidy-data principle (one row per
    observation, one column per variable, one table per observation type) and the
    classification becomes an interface contract: get it right and every later step —
    plotting, modelling, aggregating — composes cleanly.
  </p>
  <p>
    <em>Common misconception:</em> "numbers are numbers, so data type is a storage
    detail." The type encodes meaning: treating a 1–5 opinion scale as continuous
    implies a spacing between categories that the respondent never endorsed, and that
    assumption quietly propagates into every mean, every regression coefficient, every
    dashboard.
  </p>
  <p>
    <strong>So far:</strong> the classification became an interface contract — factor,
    integer, float — and type errors now propagate at machine speed. What remains is the
    computational toolkit that checks everything else: the bootstrap, the permutation test
    and the simulation study.
  </p>

  <h2>Check yourself</h2>
  <p>Try these before moving on. Feedback follows each answer.</p>
  <ol>
    <li>Recall: a poll recruits a million respondents from one social platform. Why does the enormous n not fix its bias?</li>
    <li>Application: Abraham Wald recommended armouring the returning bombers' places without bullet holes. Name the bias mechanism, and say in one sentence why his logic worked.</li>
    <li>Why-reasoning: Schuman and Presser's forbid-versus-allow wording experiment produced opposite majorities from one opinion. What does that prove about closed questions and the data they generate?</li>
  </ol>
  <p>
    <strong>Feedback:</strong> (1) Size reduces random error, not systematic error — the
    bias is a property of the selection mechanism, and a million respondents from one
    platform converge precisely on that platform's users' views; no n erases it. (2)
    Survivorship bias — the planes hit in the engine area did not come back to be counted,
    so the holes on returning aircraft mark the places a bomber can survive. (3) That the
    wording — the fixed options and their labels — is itself the measurement: one opinion
    produced opposite answers under "forbid" and "allow", so the categorical variable a
    closed question generates encodes design choices from the moment of schema creation —
    which is why the questionnaire and the schema are one object, and the pilot remains the
    cheapest bias detector ever invented.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>Representativeness, not size, is what a sample owes you — systematic error survives any n.</li>
    <li>Each classical sampling idea has a computational descendant: tables became generators, bias became simulation.</li>
    <li>Pseudorandom determinism is a feature: a fixed seed makes an analysis re-runnable.</li>
    <li>Bias has a short taxonomy — selection, survivorship, nonresponse, undercoverage — plus processing bias in code.</li>
    <li>Wording and option design are measurement choices, made before any data exists.</li>
    <li>Data types are contracts: factor, integer, float — and floats have an exactness boundary.</li>
    <li>The bootstrap, permutation tests and simulation studies answer questions by brute force that formulas never touched.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    The track's other expert lessons pick up what this one built: Multivariate Statistics
    runs models over the tidy datasets you can now guarantee, and Causal Inference asks
    what claims those models can defend — including which variables to control for and
    which adjustments manufacture fake effects. If the MCMC mention hooked you, the
    advanced lesson Bayesian Statistics is its home.
  </p>

  <h2>Going deeper</h2>
  <p>
    <strong>The bootstrap.</strong> Efron's 1979 insight turns sampling theory on itself:
    treat your own sample as the population, resample it with replacement thousands of
    times, and the spread of the recomputed statistic estimates the uncertainty.
    Worked sketch: 20 patients, mean recovery 8.2 days, standard deviation 3.1 — the
    classical standard error is 3.1 ÷ √20 ≈ 0.69; the bootstrap rediscovers that number
    (and produces the whole distribution, not just the normal approximation) by brute
    repetition. It answers questions no closed-form formula exists for — medians,
    ratios, rankings — with nothing but a loop.
  </p>
  <p>
    <strong>Permutation tests and MCMC.</strong> Fisher imagined the permutation test in
    1935 (shuffle treatment labels, recompute the difference, see how extreme the real
    one is) — a thought experiment until computers made it routine. Monte Carlo methods
    from the 1950s (Metropolis and colleagues, 1953; refined by Hastings, 1970) power
    modern Bayesian computing: probabilistic programming systems such as Stan and PyMC
    take a model written in a few lines and sample its posterior automatically. The
    professional standard is the <em>simulation study</em>: fake data with known truth,
    run your method, verify it recovers the truth — the unit test of statistics.
  </p>
  <p>
    <strong>Reproducible pipelines.</strong> The analysis is the artefact: scripts that
    run end-to-end from raw data to report, pinned package environments, version control,
    fixed seeds, and literate tools (R Markdown, Jupyter) that interleave reasoning and
    execution. Journals increasingly require data and code alongside the paper, because
    the reproducibility crises of the 2010s showed that unpublished pipelines cannot be
    checked — and uncheckable claims decay. Numerical craft is part of this: sum logs
    rather than multiply tiny probabilities, expect catastrophic cancellation in naive
    variance formulas, and never compare floats for exact equality.
  </p>
  <p>
    <strong>Open frontiers.</strong> Formal verification of statistical code, differential
    privacy in census release (noise added deliberately, accuracy provable), and
    sampling the unsampleable — the estimate for hard-to-reach populations that
    probability sampling cannot reach — are where data collection and computing are
    actively colliding. The unit's old questions (who is in, who is missed) have become
    the field's new ones.
  </p>

  <p class="sources"><strong>Sources:</strong> Efron (1979); Metropolis et al. (1953); Wickham & Grolemund, R for Data Science; Efron & Hastie, Computer Age Statistical Inference. Source text: OpenStax (https://openstax.org), CC BY 4.0 — adapted for Interactive Atlas.</p>
</TopicPage>

