const weatherCfg = {
  steps: [
    { math: '1 · Weathering: rock taken apart', note: 'Physical: frost wedging (water expands ~9% freezing), thermal cycling, roots. Chemical: water + CO₂ dissolves minerals (karst limestone landscapes — caves, sinkholes). Biological weathering is both at once.' },
    { math: '2 · Erosion: the transport fleet', note: 'Water (the geography lesson\'s rivers), wind (dunes, loess), ice (glaciers plucking and polishing), gravity (landslides). The agent determines the landform signature.' },
    { math: '3 · Deposition: sediment kept', note: 'Fast flows drop big particles, slow flows drop fine — so downstream sorting produces gravel → sand → silt → clay → dissolved load. Sedimentary layers are the river\'s filing system (the rock-cycle lesson).' },
    { math: '4 · Landforms read as process', note: 'V-shaped valley = stream cutting; U-shaped = glacier; alluvial fan = mountain stream braking onto flats; delta = river meeting still water; karst = dissolution. The shape names the process that made it.' },
  ],
