import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const safetyCfg = {
  steps: [
    { math: '1 · From single failure to safe failure', note: 'The design question is never "can it fail?" — everything can. It is "what happens WHEN it fails?" Fail-safe (defaults to safety: a railway signal at red on power loss), fail-soft (degrades gracefully), redundancy (backups with independence).' },
    { math: '2 · Redundancy and common-cause traps', note: 'Two engines beat one — unless one maintenance error grounds both (common-cause failure). Diversity of redundancy (different software, different suppliers, different failure modes) is the discipline; the 737 MAX case is the common-mode lesson written in lives.' },
    { math: '3 · The safety toolkit', note: 'FMEA (systematically list failure modes, rank by severity×likelihood×detectability), fault-tree analysis (work backwards from the top event), HAZOP (process plants), and probabilistic risk assessment (numbers for the residual risk).' },
    { math: '4 · Human factors is system design', note: 'Most accidents blame "human error"; the systems view (Reason\'s Swiss cheese) asks why the error was possible and uncaught. Aviation\'s safety culture (no-blame reporting — ASRS) turned flying into the safest transport; medicine is running the same playbook (the clinical lesson\'s checklists).' },
  ],
};
---
<TopicPage slug="subjects/engineering/expert/reliability-and-safety-engineering">
  <h2>The idea</h2>
  <p>
    Safety engineering is <strong>designing for the certainty that things fail</strong> — and for
    the certainty that people err. It is engineering\'s moral core: the physics lesson\'s safety
    factors, grown into a discipline of redundancy, analysis and culture.
  </p>

  <Widget no="1" caption="fail-safe thinking, redundancy, the toolkit, human factors" widget="equationStep" config={safetyCfg} />

  <h2>Case studies the discipline is built on</h2>
  <ul>
    <li><strong>Challenger (1986):</strong> O-rings at low temperature — engineers warned, schedule pressure overrode, the warning was tragically correct. The Rogers Commission and Feynman\'s ice-water demonstration made organisational culture a recognised engineering variable.</li>
    <li><strong>Chernobyl vs Fukushima:</strong> different failure stories (design + culture vs design + tsunami) with one shared lesson: safety systems must survive the initiating event that demands them (the reactor lesson\'s defence-in-depth).</li>
    <li><strong>Hyatt Regency (1981):</strong> a walkway connection detail change doubled the load on a bolt — 114 dead. The case that made connection design and change-control (the software lesson\'s review discipline) permanent exam material.</li>
    <li><strong>The safety paradox of success:</strong> systems with no accidents breed complacency (normalisation of deviance — Vaughan\'s Challenger analysis). Leading indicators (near-miss reports, drift measurements) exist precisely because lagging indicators eventually stop arriving.</li>
  </ul>
  <p class="sources"><strong>Sources:</strong> Leveson, Engineering a Safer World; Reason, Human Error; Vaughan, The Challenger Launch Decision; the NASA/FAA accident-investigation literature.</p>
</TopicPage>
