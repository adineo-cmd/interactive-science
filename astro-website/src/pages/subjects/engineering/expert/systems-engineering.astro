import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const sysengCfg = {
  steps: [
    { math: '1 · Systems engineering is the discipline of wholes', note: 'Components optimised separately produce systems that fail together. SE owns the interfaces, the requirements and the integration — the stuff that lives between the disciplines (an aeroplane is 4 million parts and a million conversations).' },
    { math: '2 · Requirements: the contract with reality', note: 'Elicit, write unambiguously, verify. The V-model: requirements → design → build, mirrored by verification → integration → validation. Most project failures are requirement failures discovered late (the software lesson\'s spec discipline, industrialised).' },
    { math: '3 · Interfaces and configuration control', note: 'Every interface (mechanical, electrical, data, human) is a chance for two teams to assume different things. Configuration management freezes the "as-designed" truth; change control prices every modification honestly — the unsung hero of projects that land.' },
    { math: '4 · Trade studies and the systems view', note: 'Every design decision is a trade (mass vs range, cost vs reliability — the Ashby lesson at system scale). The systems engineer models the trades, because no single discipline sees the whole curve — and "optimise the system, not the component" is the discipline\'s first commandment.' },
  ],
}
---
<TopicPage slug="subjects/engineering/expert/systems-engineering">
  <h2>The idea</h2>
  <p>
    Systems engineering is <strong>the engineering of complexity itself</strong> — the
    requirements, interfaces and integration that let thousands of specialists build one thing
    that works. Born from Apollo (the systems had outgrown any single mind), it now runs
    everything from aircraft to chip fabs to hospital design.
  </p>

  <Widget no="1" caption="wholes, requirements, interfaces, trade studies" widget="equationStep" config={sysengCfg} />

  <h2>Where the discipline proved itself</h2>
  <ul>
    <li><strong>Apollo (1961–72):</strong> 400,000 people, 20,000 contractors — SE\'s founding demonstration that rigorous interface and configuration discipline can deliver a system nobody fully understood at the start (the history lesson\'s organisational miracle, methodised).</li>
    <li><strong>Model-based SE (the current shift):</strong> requirements become executable models; consistency checks run continuously — the same formalisation the software lesson brought to code, applied to requirements and interfaces.</li>
    <li><strong>The systems-thinking crossover:</strong> Meadows\' systems theory (stocks, flows, feedback — the biology lesson\'s loops) supplies the intuition; SE supplies the paperwork discipline; the combination is the modern practice.</li>
    <li><strong>Where it goes next:</strong> climate infrastructure, megaprojects, and AI-agent systems (the alignment lesson\'s "who verifies the whole?") — complexity outpacing the discipline is the standing challenge, which is precisely why it exists.</li>
  </ul>
  <p class="sources"><strong>Sources:</strong> NASA Systems Engineering Handbook; INCOSE SE Handbook; Meadows, Thinking in Systems; Johnson, "The Secret of Apollo" (2002).</p>
</TopicPage>
