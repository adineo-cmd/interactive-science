const csFailSafeJudge = {
  "statements": [
    {
      "s": "Fail-safe means the system is safe from failure.",
      "truth": false,
      "why": "It means the system fails into a safe state — the distinction is audit-ready."
    },
    {
      "s": "A guard-open wire that releases the brake is fail-safe design.",
      "truth": true,
      "why": "A broken wire lands the machine in the safe state — the wire breaking does the stopping."
