---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const hookeCfg = {
  curves: [
    { expr: 'k*x', label: 'load carried by the part', color: '#52525b', width: 2.2 },
    { expr: '1500', label: 'yield limit (fails above this)', color: '#b42318', width: 1.4 },
  ],
  params: [
    { name: 'k', label: 'stiffness k', min: 5, max: 100, step: 1, value: 40, unit: 'N/mm' },
  ],
  x: { min: 0, max: 60, label: 'extension (mm)' },
  y: { min: 0, max: 2400, label: 'load (N)' },
  crossings: true,
  height: 350,
};

const ssHalvesMatch = {
  "prompt": "Two questions organise the whole lesson — pair each half with its question:",
  "pairs": [
    {
      "left": "statics",
      "right": "what forces must each part carry? — equilibrium, rigid bodies"
    },
    {
      "left": "strength of materials",
      "right": "can the part survive carrying them? — stress, strain, bending, buckling, failure"
    },
    {
      "left": "the simplification between them",
      "right": "statics treats every body as perfectly rigid; strength allows real deformations"
    }
  ],
  "why": "Neither half is optional — a perfect force analysis of an inadequate beam still falls down, and an over-designed beam of unknown forces is guesswork with a budget."
};

const ssFactorPlace = {
  "prompt": "Engineers multiply expected loads by a safety factor. About where do the factors for the live loads of bridges sit?",
  "labels": [
    "1",
    "2",
    "3",
    "4",
    "5",
    "6"
  ],
  "scale": {
    "min": 1,
    "max": 6
  },
  "answer": 1.75,
  "tolerance": 0.4,
  "why": "Roughly 1.5–2 on the live loads of bridges, about 1.5 for aircraft structure — much higher for cranes and anything lifting people; the failure zone sits outside anything the world delivers."
};

const ssVectorPredict = {
  "q": "Two 50 N pulls act at right angles to each other. The resultant is about…",
  "choices": [
    "100 N",
    "About 71 N",
    "50 N",
    "25 N"
  ],
  "answer": 1,
  "why": "The diagonal of the right-angle pair is what the parallelogram rule gives — same-direction pulls would double it; perpendicular ones give √(50² + 50²) ≈ 71 N."
};

const ssMomentMatch = {
  "prompt": "Moments and their kin — pair the quantity with its picture:",
  "pairs": [
    {
      "left": "moment, M = F × d",
      "right": "force times the perpendicular distance to the pivot"
    },
    {
      "left": "a couple",
      "right": "two equal, opposite forces on parallel lines — pure rotation, zero net push"
    },
    {
      "left": "a distributed load",
      "right": "snow on a roof, water on a dam — resultant acting at the centroid"
    }
  ],
  "why": "Which is why the screwdriver turns the screw without shoving it across the table — pure rotation from a couple, no net push."
};

const ssUnitsSpot = {
  "prompt": "A student converts a car's mass to weight. One line is wrong — click it:",
  "lines": [
    "A car has a mass of 1,500 kg",
    "Weight = mass × g = 1,500 × 9.81",
    "≈ 15,000 N — call it 15 kN",
    "Sanity check: 1,500 N — acceptable",
    "The habit: estimate first — a tonne-scale mass weighs kilonewtons"
  ],
  "errorLine": 3,
  "correction": "1,500 N is a hundredth of the truth — a 1,500 kg car weighs about 15,000 N; when the magnitude disagrees with your estimate, stop and find the slip.",
  "why": "Kilograms measure matter, newtons measure force — the multiplication by g is a conversion you must do explicitly, every time."
};

const ssFbdOrder = {
  "prompt": "The free-body diagram's drilled steps — put them in order:",
  "items": [
    "Confirm the body is not accelerating — static equilibrium",
    "Isolate one body and cut it free from the world",
    "Draw every force: applied loads, weight, support reactions",
    "Demand balance: ΣF = 0 and ΣM = 0"
  ],
  "why": "A roller pushes perpendicular to its surface; a pin pushes in two directions; a fixed support also resists turning — and when you need one unknown out of the way, take moments about a pivot where its own moment is zero."
};

const ssBeamCloze = {
  "text": "A 6 m simply supported beam carries a 600 N load 2 m from the left support. Moments about the left support: the right reaction times %%0%% m balances 600 N acting at %%1%% m, so it is %%2%% N; vertical balance gives the left reaction %%3%% N — the load did not split evenly.",
  "answers": [
    [
      "6"
    ],
    [
      "2"
    ],
    [
      "200"
    ],
    [
      "400"
    ]
  ],
  "hint": "Take moments where one unknown's own moment is zero, then let ΣF = 0 hand you the rest."
};

const ssStressBuckets = {
  "prompt": "σ = F/A comes in two flavours — file each case:",
  "buckets": [
    "normal stress — perpendicular to the cut",
    "shear stress — parallel to the cut"
  ],
  "items": [
    {
      "label": "tension through a thick rod — harmless",
      "bucket": 0
    },
    {
      "label": "what scissors apply",
      "bucket": 1
    },
    {
      "label": "what bolts in a joint resist",
      "bucket": 1
    },
    {
      "label": "compression in a column",
      "bucket": 0
    },
    {
      "label": "the same force through a wire — brutal",
      "bucket": 0
    }
  ],
  "why": "Stress is the load spread over every square millimetre of the cut — and in the elastic region stress and strain are proportional, σ = E·ε: everything is a spring."
};
---
<TopicPage slug="subjects/engineering/foundational/statics-structures">

  <h2>Where you are, and what you will learn</h2>
  <p>
    This is the foundational lesson of Engineering, and it answers the discipline's oldest
    question: why do structures stand — and why do they fall? You need no earlier lessons.
    The physics used here is force, which will be explained from scratch, and the
    mathematics never goes beyond multiply, divide and one square root. Everything else is
    built step by step.
  </p>
  <p>By the end you will be able to:</p>
  <ul>
    <li>treat forces as vectors — adding them, finding resultants, and computing the turning effect (moment) of a force;</li>
    <li>draw a free-body diagram and use the two equilibrium conditions to find unknown support forces;</li>
    <li>explain why kilograms and newtons are different quantities, and convert between the metric and US unit systems without error;</li>
    <li>work out the tension and compression in truss members, and compute stress, strain and stretch from a load;</li>
    <li>read a shear force and bending moment diagram, and say why an I-beam has its shape;</li>
    <li>name the ways parts fail — yielding, buckling, fatigue, creep, brittle fracture — and explain what the factor of safety buys.</li>
  </ul>
  <p>
    One habit runs through the page, and it is the engineer's first reflex: before
    calculating anything, estimate the answer. Is this a tonne problem or a gram problem?
    A quick estimate catches more design errors than any software.
  </p>

  <h2>The two questions every structure must answer</h2>
  <p>
    Sit on an ordinary chair for a moment and think about what it is doing. Your weight —
    a force pulling you toward the Earth — enters the chair at the seat, travels through
    the frame, and leaves through the four legs into the floor. Nothing moves, nothing
    breaks. That is the whole job description of a structure, from a chair to a suspension
    bridge: a machine for <strong>guiding forces into the ground</strong> without any part
    exceeding what it can carry. (The uniform table from the physics classroom makes the
    bookkeeping easy: four identical legs share the load equally, one quarter each — but
    move the load off centre and the shares change, which is where the real subject
    begins.)
  </p>
  <p>
    Answering that job description takes two questions, and they organise this whole
    lesson. First: <em>what forces must each part carry?</em> That is <strong>statics</strong> —
    the study of things that must not move, built on equilibrium. Second: <em>can the part
    survive carrying them?</em> That is <strong>strength of materials</strong> — stress,
    strain, bending, buckling, failure. The two halves use one deliberate simplification
    between them: statics treats every body as perfectly rigid, while strength of
    materials allows the deformations that real bodies suffer. Neither half is optional —
    a perfect force analysis of an inadequate beam still falls down, and an over-designed
    beam of unknown forces is guesswork with a budget.
  </p>
  <Widget no="2" caption="pair each half of the subject with its question" widget="match" config={ssHalvesMatch} />
  <p>
    <strong>What to notice:</strong> Pair each half with its question and keep the hinge card: statics asks what forces each part
    must carry, strength of materials asks whether the part survives carrying them, and the
    simplification between them is rigidity versus real deformation. Notice the widget's
    warning — a perfect force analysis of an inadequate beam still falls down — neither half
    is optional.
  </p>
  <p>
    Before the machinery, one picture worth keeping for the whole page. Hooke's law (1676)
    says a part stretches in proportion to the load you put on it — the straight grey line
    below. But every material has a limit, drawn here in red. The widget shows the entire
    discipline in miniature: engineering is the art of keeping the working point far to the
    left of the crossing.
  </p>

  <Widget no="1" caption="a part under load — Hooke's law against its yield limit; the crossing is where it fails" widget="plotter" config={hookeCfg} />
  <p>
    <strong>What to notice:</strong> slide the stiffness k and watch where the grey load
    line meets the red yield limit — that intersection is the extension at which the part
    fails. A stiffer part (larger k) reaches the same limit at a smaller stretch. Real
    engineers never let the working point get near the crossing: they multiply the loads
    they expect by a <strong>safety factor</strong> (roughly 1.5–2 on the live loads of
    bridges, about 1.5 for aircraft structure, much higher for cranes and anything lifting
    people), so the failure zone sits outside anything the real world delivers. Every
    calculation below exists to place a point safely to the left of that red line.
  </p>
  <Widget no="3" caption="pin the bridge live-load factor on the scale" widget="place" config={ssFactorPlace} />
  <p>
    <strong>What to notice:</strong> Place the bridge's live-load factor before revealing: it sits near 1.75 — roughly 1.5 to 2 —
    against about 1.5 for aircraft structure and much higher factors for cranes and anything
    lifting people. Notice what the scale encodes: the factor is sized to the uncertainty,
    so the failure zone lands outside anything the world actually delivers.
  </p>

  <h2>Forces are arrows: the vector toolkit</h2>
  <p>
    A force has a size, a direction and a point of application — it is a
    <strong>vector</strong>, drawn as an arrow whose length is the size. The vector
    language is where all statics starts, because forces combine like arrows, not like
    numbers: two 50 N pulls in the same direction give 100 N, but at right angles they
    give about 71 N in a diagonal direction. Any set of forces on a body can be boiled
    down to a single equivalent — the <strong>resultant</strong> — plus a turning effect.
    Force systems come in the standard varieties you will meet in problems:
    <em>concurrent</em> (all their lines of action pass through one point), <em>parallel</em>
    (like the table legs), and <em>distributed</em> (a load spread over an area — snow on
    a roof, water on a dam — handled by its resultant acting at the centroid, the
    geometric centre of the area).
  </p>
  <Widget no="4" caption="bet the resultant before the geometry" widget="predict" config={ssVectorPredict} />
  <p>
    <strong>What to notice:</strong> Lock in a bet before the geometry: two 50 N pulls at right angles give about 71 N, the
    diagonal the parallelogram rule produces — not 100 N. Notice what the four options
    encode: same-direction pulls would double the force, perpendicular ones scale it by the
    square root of two, and the wrong answers live exactly in that gap.
  </p>
  <p>
    Rotation needs its own quantity, because a force can turn a body as well as push it.
    The <strong>moment</strong> of a force is <code>M = F × d</code>: force times the
    perpendicular distance to the pivot. That is why a door handle sits far from the
    hinges — same push, longer arm, more turn. And a <strong>couple</strong> — two equal,
    opposite forces on parallel lines, like your two hands turning a jar lid — produces
    pure rotation with zero net push, which is why the screwdriver turns the screw without
    shoving it across the table.
  </p>
  <Widget no="5" caption="pair each rotation idea with its picture" widget="match" config={ssMomentMatch} />
  <p>
    <strong>What to notice:</strong> Pair each rotation idea with its picture: the moment is force times perpendicular distance
    to the pivot, a couple is two equal, opposite forces on parallel lines that turn without
    any net push, and a distributed load acts at its centroid. Notice the widget's everyday
    proof — the screwdriver turns the screw without shoving it across the table.
  </p>
  <p>
    <strong>So far:</strong> a structure is a load path to the ground; statics finds the
    forces along that path using arrows that add, and moments that turn. Next comes the
    trap that breaks more student calculations than any physics error: the units.
  </p>

  <h2>Weight, mass and the units trap</h2>
  <p>
    Mass and weight are different quantities, and confusing them is how bridges fail on
    paper. <strong>Mass</strong> (kilograms, kg) is the amount of matter;
    <strong>weight</strong> is the gravitational force on that mass, measured in newtons
    (N). A mass of 1 kg weighs about 9.81 N on Earth — the multiplication by g is a
    conversion you must do explicitly, every time. The US engineering menagerie makes the
    distinction famous: the pound-mass (lbm) and pound-force (lbf) share a name but not a
    dimension, joined only by the conversion constant g<sub>c</sub>; alongside them live
    the slug (the mass that a 1 lbf force accelerates modestly), the dyne (the old
    centimetre-gram-second force unit) and the ton. The syllabus's weight-and-mass topic
    exists precisely because errors here are silent: the numbers look plausible, the units
    are wrong, and the structure on paper is nonsense. The defence is the habit from the
    top of the page — estimate first. A car of 1,500 kg should weigh around 15,000 N; if
    your calculation gives 150 N or 15 million, stop and find the slip.
  </p>
  <Widget no="6" caption="one line of the conversion slipped — find it" widget="spot-error" config={ssUnitsSpot} />
  <p>
    <strong>What to notice:</strong> Find the slipped line: the sanity check that blesses 1,500 N for a 1,500 kg car — a
    hundredth of the truth, since the car weighs about 15,000 N. Notice the habit the true
    lines model: a tonne-scale mass weighs kilonewtons, so a ten-second estimate flags the
    slip long before the algebra could.
  </p>

  <h2>Free-body diagrams and equilibrium</h2>
  <p>
    The <strong>free-body diagram (FBD)</strong> is statics' core ritual, and it is four
    steps drilled into every engineer: confirm the body is not accelerating (that is the
    condition called <strong>static equilibrium</strong>); isolate one body and cut it free
    from the world; draw <em>every</em> force acting on it — applied loads, its weight, and
    the <strong>support reactions</strong> (a roller pushes perpendicular to its surface; a
    pin pushes in two directions; a fixed support also resists turning); then demand
    balance. Balance is Newton's first law written as equations: <code>ΣF = 0</code> (the
    forces cancel) and <code>ΣM = 0</code> (the moments cancel). Two or three equations per
    body, solved for the unknowns — and when you need one unknown force out of the way,
    take moments about a pivot chosen so its own moment is zero.
  </p>
  <Widget no="7" caption="stack the four-step ritual" widget="order" config={ssFbdOrder} />
  <p>
    <strong>What to notice:</strong> Stack the ritual's four steps and respect their order: confirm the body is not accelerating,
    isolate it and cut it free from the world, draw every force — applied loads, weight,
    support reactions — then demand ΣF = 0 and ΣM = 0. Notice the widget's craft tip: when
    one unknown is in the way, take moments about a pivot where its own moment is zero.
  </p>
  <p>
    A familiar example first, with two hands instead of steel. A pole vaulter carries a
    uniform 5 kg pole horizontally, hands 0.900 m apart, with the pole's centre of gravity
    0.600 m from the left hand. The pole weighs 5.00 × 9.80 = 49.0 N. Take moments about
    the left hand: the right hand's force times 0.900 m must balance the weight's 49.0 N
    acting at 0.600 m, so the right hand pushes up with (0.600 × 49.0) ÷ 0.900 ≈ 32.7 N —
    and vertical balance gives the left hand only 49.0 − 32.7 = 16.3 N. The hand closer to
    the centre carries more, exactly as two people carrying a sofa discover: the one nearer
    the middle takes the heavier end. (Slide the grip toward the far end of the pole and
    something strange happens — the outer hand must push <em>down</em> to keep the pole
    level. Moments, not muscles, decide.)
  </p>
  <p>
    Now the standard academic example. A 6 m simply supported beam carries a 600 N load
    2 m from the left support. Take moments about the left support: the right reaction
    times 6 m balances 600 N acting at 2 m, so it is 200 N; vertical balance gives the
    left reaction 400 N. Notice the load did <em>not</em> split evenly — it sits closer to
    one end, and the reactions know it. When a structure has more unknowns than equilibrium
    equations (a beam fixed at both ends, for instance), it is <strong>statically
    indeterminate</strong>: the extra equations must come from the structure's stiffness —
    how much each support stretches — which is exactly where statics hands off to strength
    of materials.
  </p>
  <Widget no="8" caption="fill the two-reaction solve" widget="cloze" config={ssBeamCloze} />
  <p>
    <strong>What to notice:</strong> Fill the solve from the hint's strategy — take moments where one unknown's own moment is
    zero: the right reaction times 6 m balances the 600 N load sitting 2 m out, and vertical
    balance hands over the rest. Notice why moments come first: choosing that pivot turns
    two unknowns into one, and only then does ΣF = 0 finish the job.
  </p>
  <p>
    <em>Common misconception:</em> "two people carrying a load share it equally." It feels
    fair, and it is wrong whenever the load sits unevenly between them — the person closer
    to the load's centre of gravity carries measurably more (in the pole example above,
    two-thirds versus one-third). Equal shares only happen when the load is centred. The
    general rule is moments, not fairness: balance is decided by force times distance, and
    the shorter lever arm always carries the bigger force.
  </p>
  <p>
    <strong>So far:</strong> So far: the free-body ritual — isolate, draw every force, demand ΣF = 0 and ΣM = 0 — turns a
    beam's reactions into arithmetic, and the load's position rather than fairness decides
    who carries more: moments, not muscles.
  </p>

  <h2>Inside the members: trusses, stress and strain</h2>
  <p>
    Equilibrium finds the external forces; cutting a member open reveals its
    <strong>internal forces</strong>. The clean case is the <strong>truss</strong> — the
    triangular lattice of bridges, cranes and roofs. Because its loads meet only at the
    joints, each member carries pure <strong>tension</strong> (being pulled) or pure
    <strong>compression</strong> (being squeezed), with no bending — and the method of
    joints applies the FBD ritual to each pin, walking the forces member by member. The
    triangle is doing structural work: it is rigid where a rectangle can shear into a
    parallelogram, which is why triangles are the shape of load-bearing design.
  </p>
  <p>
    How hard a member is being pulled is measured by <strong>stress</strong> — the
    intensity of the internal force: <code>σ = F / A</code>, force divided by
    cross-sectional area, in pascals. Think of it as the load spread over every square
    millimetre of the cut, which is why the same force is harmless through a thick rod and
    brutal through a wire. Stress comes in two flavours: normal stress (perpendicular to
    the cut — tension or compression) and <strong>shear stress</strong> (parallel to the
    cut — what scissors apply, and what bolts in a joint resist). The member's response is
    <strong>strain</strong>, ε = ΔL ÷ L: the fractional stretch. In the elastic region the
    two are proportional — σ = E·ε, where E is Young's modulus, a stiffness property of the
    material. That proportionality is Hooke's law in its rigorous form, and it is the grey
    line in the widget above: everything is a spring. Worked example: a steel tie 1 m long
    with a 100 mm² cross-section carrying 10,000 N stretches by δ = F·L ÷ (E·A) =
    10,000 × 1 ÷ (200 × 10⁹ × 100 × 10⁻⁶) = 0.5 mm — invisible in a bridge, decisive in a
    precision machine, but always there. And when several loads act at once,
    <strong>superposition</strong> says their effects simply add in a linear elastic
    member: a column that is compressed <em>and</em> bent carries the stresses of each,
    summed — and the worst sum, not the worst single load, picks the failure.
  </p>
  <Widget no="9" caption="normal or shear? file the loading" widget="sort-buckets" config={ssStressBuckets} />
  <p>
    <strong>What to notice:</strong> File each case by the cut's geometry: tension through a thick rod, compression in a column
    and the same force through a wire are normal stress — perpendicular to the cut — while
    what scissors apply and what joint bolts resist are shear, parallel to it. Notice the
    wire card's lesson: stress is the load spread over every square millimetre, so area, not
    force alone, decides the harm.
  </p>

  <h2>Beams, bending and the two diagrams</h2>
  <p>
    The beam is civilisation's workhorse member, and its analysis is the second great
    ritual. Cut the beam at station after station, and at each cut ask two questions: what
    sideways force does the right half exert on the left (the <strong>shear force</strong>),
    and what turning effect (the <strong>bending moment</strong>)? Plot both along the
    length and you have the two diagrams that beam designers live in. Their rules connect
    them — the shear diagram's slope is the load, the moment diagram's slope is the shear
    — and the beam fails where the moment peaks. For the 6 m beam above, the peak moment
    is 400 N × 2 m = 800 N·m at the load point.
  </p>
  <p>
    Bending stress follows <code>σ = M·y ÷ I</code>: the moment M, the distance y from the
    beam's neutral axis (the layer that neither stretches nor squeezes), and I — the
    <strong>second moment of area</strong>, which measures how the material is distributed
    around that axis. I is the whole reason the I-beam has its shape: the flanges carry
    most of the material <em>far</em> from the neutral axis, where bending stress has room
    to work, so an I-section resists bending many times better than the same amount of
    steel rolled into a solid square. The parallel axis theorem and the radius of gyration
    quantify exactly this game of pushing material outward. Bending pairs with its
    companions: transverse <strong>shear</strong> (the web of the I-beam's job),
    <strong>torsion</strong> — twisting, τ = T·c ÷ J in a circular shaft, the analogue of
    bending that drives drive-shaft design — and <strong>deflection</strong>, where a
    beam's sag grows with load and with the fourth power of length and shrinks with E and
    I, which is why depth beats material when a beam sags. Columns fail differently
    altogether: <strong>Euler buckling</strong> says a slender column can collapse sideways
    at <code>P = π²·E·I ÷ L²</code> — a stiffness-and-geometry failure, long before the
    material itself crushes, and the reason doubling a column's length quarters its
    capacity.
  </p>
  <p>
    <em>Common misconception:</em> "if the stresses are safe, the structure is fine."
    Stress calculations miss an entire family of failures that are about geometry, not
    strength. A slender column buckles sideways while its material is nowhere near its
    limit; a long, shallow floor can sag so far that plaster cracks and occupants feel the
    floor is failing even though no stress limit is exceeded; a slender bridge deck can be
    driven unstable by wind. The sagging bookshelf that nobody dares sit on twice was
    "safe" by stress — and unusable by serviceability. Real design checks stiffness and
    stability alongside strength, every time.
  </p>

  <h2>Friction, and the honest catalogue of failure</h2>
  <p>
    <strong>Static friction</strong> is the third pillar of statics: contact surfaces
    resist sliding up to a limit of μN — the coefficient μ times the normal force — then
    let go. Friction is why ladders stand (the wall is nearly frictionless; the floor's
    friction holds the whole business up), why wedges, nails and brakes work, and why soil
    slopes fail: a bank steeper than its friction angle slides. On the strength side, the
    failure catalogue deserves respect, because parts rarely fail politely.
    <strong>Principal stresses and Mohr's circle</strong> transform an arbitrary stress
    state into the maximum tension, compression and shear that any plane in the material
    feels; <strong>yield criteria</strong> turn that state into a verdict — Tresca (yield
    when the maximum shear reaches the value found in a simple tension test) or von Mises
    (yield when a combined distortion-energy measure crosses the material's limit; the
    standard for ductile metals). Beyond yielding come the slow and the sudden killers:
    <strong>fatigue</strong> — cracks growing under repeated loads far below the yield
    limit, the reason aircraft parts have inspection hours; <strong>creep</strong> — slow
    deformation under steady load at high temperature, which turbine blades live their
    whole lives by; <strong>brittle fracture</strong> — sudden crack propagation in cold
    or notch-sensitive materials, the failure that snapped Second World War Liberty ships
    in Arctic water; and <strong>stress concentrations</strong> — a sharp corner or hole
    multiplying local stress by several times, which is why aircraft fuselage windows are
    oval and every load-bearing design rounds its corners. The <strong>factor of
    safety</strong> wraps the whole catalogue: working stress equals the material limit
    divided by the factor, with the factor sized to the uncertainty — known loads and
    certified steel get about 1.5; unknown soils, repeated dynamic loads or
    human-suspension applications get 5 and up.
  </p>
  <p>
    <em>Common misconception:</em> "strong and stiff mean the same thing." They are
    different properties that different problems need. <strong>Strength</strong> is the
    load a part survives — its yield limit, the red line in the widget.
    <strong>Stiffness</strong> is how little it deflects under load — the slope of the
    grey line, governed by E and by geometry. Rubber is flexible yet strong in tension;
    glass is stiff yet fragile. A design can fail by being too floppy while every stress
    is safe, and the fix is geometry — depth, I — not a stronger alloy. Choosing which
    property your problem actually needs is half of engineering judgement.
  </p>

  <h2>Check yourself</h2>
  <p>Try these before moving on. Feedback follows each answer.</p>
  <ol>
    <li>A 4-legged table carries a 400 N load dead centre. What force does each leg carry — and what changes if the load moves toward one corner?</li>
    <li>Why does a door handle sit on the edge opposite the hinges? Answer with the moment equation.</li>
    <li>A 1 kg bag of sugar and a 1 N apple: which is the bigger quantity, and what does each measure?</li>
    <li>Two people carry a 300 N ladder, gripping 1 m and 3 m from its centre of gravity. Who carries more, and roughly how much?</li>
    <li>A slender steel column and a short fat column are made of the same steel. Which is more likely to fail by crushing, and which by buckling — and why does the answer matter for design?</li>
  </ol>
  <p>
    <strong>Feedback:</strong> (1) 100 N each, by symmetry. Move the load off centre and
    the nearby legs pick up more, the far legs less — the legs' forces are found from
    moments, not divided by four on faith. (2) M = F × d: the handle's greater distance
    from the hinge buys more turning moment per newton of push, so a light push opens the
    door. (3) The sugar has the bigger weight: 1 kg weighs about 9.81 N, so a 1 N apple
    has a mass of roughly 100 grams. Kilograms measure matter; newtons measure force. (4)
    The nearer carrier: moments about the load's centre give 300 × 3 ÷ (1 + 3) = 225 N on
    the close grip and 75 N on the far one. Equal sharing happens only with equal lever
    arms. (5) The short fat column fails by crushing (material strength); the slender one
    by Euler buckling (stiffness and geometry) at a load that can be far lower. Designing
    the slender column "stronger" changes nothing — the fix is geometry: shorter, deeper,
    or braced.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>A structure is a load path to the ground; statics finds the forces on that path (rigid bodies), strength of materials checks the parts survive them (deformable bodies).</li>
    <li>Forces are vectors; any system reduces to a resultant plus moments; a couple turns without pushing; distributed loads act at their centroid.</li>
    <li>Moment M = F × d is the turning effect of a force — the lever arm decides who carries what, and the hand closer to the load's centre always carries more.</li>
    <li>Mass (kg) and weight (N) are different: 1 kg weighs about 9.81 N; unit conversions (lbm, lbf, g<sub>c</sub>, slug) are where calculations silently fail — so estimate first.</li>
    <li>The free-body diagram plus ΣF = 0 and ΣM = 0 solves support reactions; more unknowns than equations means statically indeterminate, and stiffness supplies the missing equations.</li>
    <li>Trusses carry pure tension and compression because triangles are rigid; stress σ = F/A and strain ε = ΔL/L are proportional (σ = E·ε) in the elastic region — everything is a spring.</li>
    <li>Beams are designed from shear and moment diagrams; bending stress σ = M·y/I rewards pushing material away from the neutral axis, which is why the I-beam has its shape.</li>
    <li>Slender columns fail by Euler buckling (π²·E·I/L²), not crushing; friction holds ladders and slopes up to μN.</li>
    <li>Failure has a catalogue — yield, fatigue, creep, brittle fracture, stress concentrations — and the factor of safety prices the uncertainty; strong and stiff are different properties.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    This page is the vocabulary; the next lesson, <em>Forces, beams and bridges</em>, is
    the conversation — real structures analysed end to end, from the reactions at the
    abutments to the bending diagram that sizes the girders. Later subjects reuse today's
    rituals everywhere: dynamics adds motion to the same vectors, mechanical design
    applies the failure catalogue to shafts and fasteners, and civil engineering scales
    the load path to whole buildings.
  </p>

  <h2>Going deeper</h2>
  <p>
    <strong>Tacoma Narrows (1940)</strong> — "Galloping Gertie" — collapsed four months
    after opening, and the folklore says resonance. The engineering finding was
    <strong>aeroelastic flutter</strong>: wind feeding energy into a coupled
    torsional-vertical oscillation until the deck tore itself apart. The lesson that
    survives in every modern wind code is structural: stiffness and damping are
    wind-resistance, and slender flexibility is not elegance but exposure — the
    stiffness-versus-strength distinction of this page, written in a bridge.
  </p>
  <p>
    <strong>Codes embody accumulated failure.</strong> Every clause in a design code is a
    fossil of a specific disaster — Petroski's thesis in <em>To Engineer Is Human</em> —
    and modern practice has shifted from the single deterministic safety factor toward
    <strong>limit state design</strong>: partial factors applied to loads and materials
    separately, sized by probability, so that "safe" means "failure unlikely enough over
    the structure's life". And the quiet frontier of statics is computation: the
    <strong>finite element method</strong> divides any shape into thousands of small
    elements, applies exactly the equilibrium-and-Hooke's-law mathematics above, and
    returns colour maps of stress — but a colour map is only as honest as its boundary
    conditions, which is why the free-body diagram, the Fermi estimate and the habit of
    asking "what carries this load to the ground?" remain the irreplaceable core.
    Structures stand when every load has a complete, calculated path to the earth;
    everything in this lesson is the machinery for checking that path, one arrow at a
    time.
  </p>

