const locardCfg = {
  steps: [
    { math: '1 · Every contact leaves a trace', note: "Locard's exchange principle: when two surfaces touch, each takes something from the other. A burglar takes fibres and leaves fingerprints — always." },
    { math: '2 · Traces are transferred', note: 'The crowbar picks up paint from the window frame; the window frame keeps metal smears from the crowbar. Two-way transfer, both useful.' },
    { math: '3 · Traces persist', note: 'Glass fragments survive in a cuff lining for weeks. Persistence varies by material — but most traces outlast the criminal\'s cleaning.' },
    { math: '4 · Traces are found', note: 'Scene examiners work systematically: secure, document, search, collect. You can only analyse what someone thought to collect.' },
    { math: '5 · Traces are compared', note: 'Class characteristics narrow the field (a 1.5 cm flat steel bar); individual characteristics can point to one source (matching striation marks).' },
    { math: '6 · Traces become testimony', note: 'The chain of custody — who handled what, when — is what turns a lab result into courtroom evidence.' },
  ],
};

const historyCfg = {
  unit: 'year',
