      "label": "the rafters under the apex load",
      "bucket": 1
    },
    {
      "label": "the horizontal tie at the apex",
      "bucket": 0
    },
    {
      "label": "the cable stays of a suspension span",
      "bucket": 0
    },
    {
      "label": "columns under a building's weight",
      "bucket": 1
    },
    {
      "label": "the vertical hangers of a suspension bridge",
      "bucket": 0
    },
    {
      "label": "the ring of a masonry arch",
      "bucket": 1
    }
  ],
  "why": "A pin joint can pull or push but never bend — that is what turns a tangle of steel into pure arithmetic."
};

const ceJointsOrder = {
  "prompt": "One apex, two rafters at 30°, a horizontal tie, a 10 kN load — put the working in order:",
  "items": [
    "Isolate the apex joint — two unknown bar forces, two useful statements",
    "Vertical equilibrium: two rafters × sin 30° must carry 10 kN — each rafter pushes with 10 kN",
    "The rafters are in compression — they will need buckling checks",
    "Horizontal equilibrium: the tie pulls with 10 × cos 30° ≈ 8.7 kN",
    "The tie is in tension — strength only, no buckling check"
  ],
  "why": "Each pin is a small body in equilibrium — three members, one apex, three sentences of algebra."
};

const ceJoistEst = {
  "prompt": "A 100 mm × 200 mm timber joist stands on edge (I = b·h³/12 about the horizontal axis). Roughly what is its second moment of area?",
  "unit": "×10⁶ mm⁴",
  "answer": 66.7,
  "factor": 1.5,
  "why": "About 66.7 × 10⁶ mm⁴ — laid flat it collapses to 16.7 × 10⁶, four times less stiffness from the same plank, same weight.",
  "context": "Depth enters cubed: growing 200 mm to 400 mm multiplies I by 2³ = 8 — the whole secret of the I-beam."
};

const ceDiagramMatch = {
  "prompt": "Read the diagram like a designer — pair each feature with its use:",
  "pairs": [
    {
      "left": "the peak at mid-span",
      "right": "the maximum demand the worst section must carry"
    },
    {
      "left": "the zeros at the supports",
      "right": "where connections can be lighter"
    },
    {
      "left": "spreading the same load uniformly",
      "right": "peak drops from P·L/4 to w·L²/8 — half the value"
    },
