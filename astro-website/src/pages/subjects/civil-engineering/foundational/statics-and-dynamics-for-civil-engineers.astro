      "s": "The moment of a force is the force times the perpendicular distance from the pivot to the force's line.",
      "truth": true,
      "why": "M = r·F — the see-saw rule and the door hinge are the same arithmetic."
    }
  ]
};

const ceTrussSort = {
  "prompt": "File each member by what it does:",
  "buckets": [
    "tension — it pulls",
    "compression — it pushes"
  ],
  "items": [
