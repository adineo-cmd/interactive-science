    { math: '3 · Statically determinate or not', note: 'If the three equations find every reaction, the structure is determinate. If not, you need material properties — that is indeterminate analysis.' },
    { math: '4 · Internal forces appear', note: 'Cut the structure and equilibrium still holds: each cut exposes axial force, shear and bending moment that the section must carry.' },
    { math: '5 · Dynamics when things move', note: 'Add inertia (F = ma) and moving loads become dynamic: impact factors, resonance, and the reason soldiers break step on bridges.' },
  ],
};

const ceDetermBranch = {
  "root": "You are handed a structure and its supports. How do you know whether statics alone can finish the job?",
  "nodes": {
