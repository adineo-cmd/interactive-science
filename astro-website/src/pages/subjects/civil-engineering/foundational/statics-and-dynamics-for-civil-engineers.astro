      "text": "Statically determinate: statics finds every reaction. Cut the members and equilibrium still holds, exposing axial force, shear and bending moment.",
      "choices": []
    },
    "indeterminate": {
      "text": "Indeterminate — a continuous beam over several supports, a rigid frame. What closes the surplus?",
      "choices": [
        {
          "label": "Deformations: members must deflect together",
          "next": "compat",
          "feedback": "Compatibility plus stiffness — and stiffer members attract more load, which is why differential settlement matters more than novices expect."
        }
      ]
    },
    "compat": {
      "text": "Material stiffness and compatibility of deformation close the surplus — the gateway from second-year mechanics to real design.",
      "choices": []
    }
  },
  "why": "Three per body is the hard budget in two dimensions: match it and statics finishes; exceed it and stiffness must join."
};

const ceMomentJudge = {
  "statements": [
