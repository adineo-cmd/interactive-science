        {
          "label": "Three unknowns, three statements in 2-D",
          "next": "determinate",
          "feedback": "The budget matches — solve ΣFx = 0, ΣFy = 0, ΣM = 0 and every reaction falls out."
        },
        {
          "label": "More unknowns than statements",
          "next": "indeterminate",
          "feedback": "Equilibrium alone cannot close it — material stiffness must be invited in."
        }
      ]
    },
