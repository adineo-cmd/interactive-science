const contractCfg = {
  steps: [
    { math: '1 · Offer + acceptance = agreement', note: 'A definite offer, accepted exactly (the "mirror image rule"). Counter-offers kill the original; a shop price is an invitation, not an offer.' },
    { math: '2 · Consideration: each side gives value', note: 'Both parties must give something (money, goods, a promise not to sue). A gift lacks consideration — and so is unenforceable, however heartfelt.' },
    { math: '3 · Intention + capacity + legality', note: 'Serious intent (social promises don\'t count), legal capacity (minors, incapacity), and lawful purpose. Agreements to break the law are void from birth.' },
    { math: '4 · Breach and remedies', note: 'Damages (money putting you where performance would have), specific performance (court orders the actual act — for unique goods), or rescission (undo it). Expectation damages are the default.' },
  ],
};
