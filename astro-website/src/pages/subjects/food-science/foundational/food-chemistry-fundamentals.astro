---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const awCfg = {
  curves: [
    { expr: 'exp(-6*(x-0.9)^2) + 0.04', label: 'spoilage rate', color: '#dc2626', width: 2.4 },
    { expr: '0.55*exp(-14*(x-0.99)^2)', label: 'lipid oxidation', color: '#b45309', width: 2.0 },
  ],
  x: { min: 0, max: 1, label: 'water activity (a-w)' },
  y: { min: 0, max: 1.2, label: 'relative rate (a.u.)' },
  crossings: false,
  height: 340,
};

const awStepsCfg = {
  steps: [
    { math: '1 · Water content ≠ water activity', note: 'A food can be wet and stable (jam, ~30% water) or dry and perishable (fresh meat, ~70%... no — meat is wet AND perishable). The key measure is not how much water, but how available it is.' },
    { math: '2 · Water activity defined', note: 'a-w = the food\'s equilibrium humidity, from 0 (bone dry) to 1.0 (pure water). It measures how tightly the matrix holds its water.' },
    { math: '3 · Microbes have thresholds', note: 'Most bacteria need a-w above ~0.91; yeasts tolerate to ~0.88; moulds to ~0.80. Below those lines, they simply cannot grow.' },
    { math: '4 · Preservation is a-w control', note: 'Salt, sugar and drying all work the same way: they bind water and drop the a-w. Jam, jerky and honey are the same idea at different sweetness.' },
    { math: '5 · But chemistry has its own curve', note: 'Lipid oxidation peaks near the dry end — the reason crackers go stale-rancid even while microbially safe. Every target a-w is a compromise.' },
  ],
};

const fcShelfCompare = {
  "prompt": "The pantry shelf, read two ways — drag the divider:",
  "before": {
    "label": "The everyday reading",
    "text": "Food sits inert until a cook turns the heat on; 'preservative' means a synthetic additive with an E-number; texture is plain physics."
  },
  "after": {
    "label": "The chemical reading",
    "text": "Enzymes keep working after harvest, sugars react with proteins, oxygen creeps into fats — and salt, sugar, smoke, acid, cold and drying are the original preservative toolkit."
  },
  "why": "Shelf life, texture and taste all follow from how the matrix's molecules interact — bread crumb, custard gel and chocolate snap are three states of matter that macromolecules make."
};

const fcHoneyPlace = {
  "prompt": "Honey keeps for millennia. Where does its water activity sit on the 0-to-1.0 scale?",
  "labels": [
    "0",
    "0.25",
    "0.5",
    "0.75",
    "1.0"
  ],
  "scale": {
    "min": 0,
    "max": 1
  },
  "answer": 0.55,
  "tolerance": 0.05,
  "why": "a-w ≈ 0.5–0.6 — the extreme end of the pantry: so little available water that nothing can grow in it, ever."
};

const fcHooksSpot = {
  "prompt": "One line of this pantry note is wrong — click it:",
  "lines": [
    "Water molecules are polar; sugar molecules bristle with −OH groups that hydrogen-bond to them.",
    "Load a food with sugar or salt and you hold its water with countless chemical grips.",
    "Fresh meat (~70% water) spoils in days because its water is nearly free (a-w ≈ 0.99).",
    "Jam at ~30% water keeps for years because the sugar locks most of it (a-w ≈ 0.75–0.85).",
    "Two foods with the same water content always behave the same — quantity is what matters."
  ],
  "errorLine": 4,
  "correction": "Same water content, completely different behaviour — availability (a-w), not quantity, is the master variable.",
  "why": "Water bound to sugars, salts and protein surfaces is present but unavailable — unable to dissolve nutrients, swell proteins or cross a membrane."
};

const fcThresholdMatch = {
  "prompt": "The a-w thresholds — pair each organism with its line:",
  "pairs": [
    {
      "left": "most spoilage bacteria",
      "right": "need a-w above ~0.91"
    },
    {
      "left": "yeasts",
      "right": "tolerate down to ~0.88"
    },
    {
      "left": "moulds",
      "right": "down to ~0.80"
    },
    {
      "left": "toxin-forming Staphylococcus aureus",
      "right": "stops under ~0.86"
    }
  ],
  "why": "Lowering a-w preserves without sterilising — jam, jerky, honey, salted cod, Christmas pudding and parmesan are one idea at different sweetnesses and saltinesses, and the thresholds are why water activity sits in food-safety regulations worldwide."
};

const fcTextureSort = {
  "prompt": "Three macromolecules, one kitchen — file each behaviour:",
  "buckets": [
    "starch",
    "protein",
    "lipid"
  ],
  "items": [
    {
      "label": "granules swelling when their crystals melt above 60–70 °C",
      "bucket": 0
    },
    {
      "label": "staling by re-associating into ordered, water-shedding crystallites",
      "bucket": 0
    },
    {
      "label": "the boiled egg setting into a continuous mesh",
      "bucket": 1
    },
    {
      "label": "kneaded wheat networks trapping fermentation gas",
      "bucket": 1
    },
    {
      "label": "form V delivering the glossy snap",
      "bucket": 2
    },
    {
      "label": "oil droplets held apart by egg-protein membranes",
      "bucket": 2
    }
  ],
  "why": "Cocoa butter's form V is the only polymorph with the proper snap — the wrong one gives the grey, crumbly bloom of a badly stored bar; tempering is polymorph control."
};

const fcMaillardCloze = {
  "text": "The Maillard reaction begins when a reducing %%0%%'s carbonyl group attacks an %%1%% group (from an amino acid or protein side chain) and cascades into hundreds of products: %%2%% (roasted, nutty), furans (caramel-like), and sulfur compounds (meaty, coffee-like).",
  "answers": [
    [
      "sugar"
    ],
    [
      "amino"
    ],
    [
      "pyrazines",
      "pyrazine"
    ]
  ],
  "hint": "It runs fastest at intermediate moisture, needs heat, and browns as it flavours — one reaction producing the colour, the crust and the aroma of a sear."
};

const fcSearEstimate = {
  "prompt": "A steak browns in seconds when its outside hits 150 °C — and never at 100 °C in a boil. Above roughly what temperature does the browning chemistry switch on?",
  "unit": "°C",
  "answer": 140,
  "factor": 1.15,
  "why": "Above roughly 140 °C amino acids and sugars combine into hundreds of new flavour and aroma compounds — one reaction producing the colour, the crust and the aroma of a sear; a boiled steak never gets there."
};

const fcHurdleBranch = {
  "root": "A cured sausage must lose salt without losing stability. Your call.",
  "nodes": {
    "start": {
      "text": "What replaces the lost barrier?",
      "choices": [
        {
          "label": "Stack other sub-lethal barriers — acid, drying, spice antimicrobials",
          "next": "end",
          "feedback": "Chorizo is the textbook example: fermentation acid + salt + drying + spice antimicrobials, hurdles no microbe clears all at once."
        },
        {
          "label": "Leave the recipe as it is — one factor is enough",
          "next": "end",
          "feedback": "Real products rarely rely on a single preservation factor; cut one hurdle and you must add another."
        }
      ]
    },
    "end": {
      "text": "Low pH plus low a-w plus preservative plus refrigeration — that is the stack.",
      "choices": []
    }
  },
  "why": "Water activity and glass transition are the two axes of the modern stability map — Labuza's classic curves were their first sketch."
};
---
<TopicPage slug="subjects/food-science/foundational/food-chemistry-fundamentals">

  <h2>Where you are, and what you will learn</h2>
  <p>
    This is the opening lesson of Food Science. You need nothing from earlier lessons —
    only a kitchen and curiosity about why food behaves as it does. Everything else is
    built here, step by step.
  </p>
  <p>By the end you will be able to:</p>
  <ul>
    <li>explain why every food is a chemical system, and why "fresh" means chemistry at its most active;</li>
    <li>define water activity (a<sub>w</sub>), distinguish it from water content, and use it to predict which microbes can grow in which foods;</li>
    <li>explain how salt, sugar and drying preserve food by one shared mechanism — and why crackers still go rancid anyway;</li>
    <li>describe the macronutrients as materials: starch gelatinisation and retrogradation, protein denaturation and gels, fat crystallisation and tempering;</li>
    <li>explain the Maillard reaction and caramelisation, and use them to cook deliberately rather than accidentally.</li>
  </ul>
  <p>
    One habit: whenever food does something — stales, sets, browns, spoils — ask which
    molecules moved, and what made them move. Food chemistry is the discipline of
    controlling reactions we usually experience only as their results.
  </p>

  <h2>"Fresh" means chemistry at full speed</h2>
  <p>
    Food science begins with a chemical re-framing: a meal is a matrix of water,
    carbohydrates, proteins and lipids — and its shelf life, texture and taste all follow
    from how those molecules interact. Cut an apple and watch it brown: enzymes are still
    working after harvest, reactions are running between sugars and proteins, and oxygen
    is quietly attacking fats. Fresh food is not food without chemistry — it is chemistry
    in its most active phase.
  </p>
  <Widget no="3" caption="drag the divider — the shelf, two readings" widget="compare" config={fcShelfCompare} />
  <p>
    The reframing overturns two everyday intuitions. First, "preservatives" are not
    necessarily synthetic additives: salt, sugar, smoke, acid, cold and drying are the
    original preservative toolkit, and every one of them works by a mechanism this lesson
    will name. Second, "texture", which most people think of as physics, is polymer
    science: bread crumb, custard gel and chocolate snap are three states of matter that
    macromolecules make.
  </p>
  <p>
    Start with the master variable that organises the whole pantry: water. Not how much
    water food contains — how <em>available</em> that water is. The widget walks the idea
    in five steps; read it now, then we take each step properly.
  </p>

  <Widget no="1" caption="water activity, step by step" widget="equationStep" config={awStepsCfg} />

  <p>
    <strong>What to notice:</strong> the sequence of the five steps is the argument. Step 1
    breaks the everyday assumption (water content is not what matters); step 2 supplies
    the measure that does; step 3 turns it into a prediction tool with hard thresholds;
    step 4 shows that three ancient preservation tricks are one idea; step 5 adds the
    complication that makes the field interesting — the dry end has its own failure mode.
    Keep step 3's thresholds in mind; the numbers below will reuse them.
  </p>

  <h2>Water activity: the master variable</h2>
  <p>
    The definition deserves one more pass, because it is counterintuitive.
    <strong>Water activity</strong> (a<sub>w</sub>) is the food's equilibrium relative
    humidity, expressed as a fraction from 0 (bone dry) to 1.0 (pure water): put the food
    in a sealed box and a<sub>w</sub> is the humidity the air settles at. It measures how
    tightly the food's matrix holds its water — water bound to sugars, salts and protein
    surfaces is present but "unavailable", unable to dissolve nutrients, swell proteins or
    cross a microbial membrane.
  </p>
  <p>
    Why do sugars and salts bind water so tightly? Chemistry at the molecular level: water
    molecules are polar, and sugar molecules bristle with −OH groups that hydrogen-bond to
    them. Load a food with sugar or salt and you are hanging onto its water with thousands
    of molecular hooks. That is why two foods with the same water content can behave
    completely differently: fresh meat (~70% water) spoils in days because its water is
    nearly free (a<sub>w</sub> ≈ 0.99), while jam at ~30% water keeps for years because
    the sugar locks most of it (a<sub>w</sub> ≈ 0.75–0.85). Honey (a<sub>w</sub> ≈
    0.5–0.6) is the extreme: archaeologically edible, microbially sterile.
  </p>
  <Widget no="4" caption="find the faulty line — binding water" widget="spot-error" config={fcHooksSpot} />
  <Widget no="5" caption="pin honey on the a-w scale" widget="place" config={fcHoneyPlace} />
  <p>
    The microbial thresholds in the widget are the practical payoff. Most spoilage
    bacteria need a<sub>w</sub> above about <strong>0.91</strong>; yeasts tolerate down to
    ~0.88; moulds down to ~0.80; the famous extremophile xerophilic moulds go a little
    lower still. Below a microbe's threshold it does not die — it simply cannot grow,
    which is why lowering a<sub>w</sub> preserves without sterilising. Salt, sugar and
    drying all work the same way: they bind water and drop the a<sub>w</sub>. Jam, jerky,
    honey, salted cod, Christmas pudding and parmesan are one idea — a<sub>w</sub> control
    — at different sweetnesses and saltinesses. Safety thresholds follow the same logic
    (the toxin-forming <em>Staphylococcus aureus</em> stops below ~0.86), which is why
    water activity sits in food-safety regulations worldwide.
  </p>
  <Widget no="6" caption="pair each organism with its floor" widget="match" config={fcThresholdMatch} />
  <p>
    But chemistry has its own curve. <strong>Lipid oxidation</strong> — the attack of
    oxygen on unsaturated fats, producing the stale, cardboard rancidity of old crisps and
    nuts — accelerates at the <em>dry</em> end, where surface fats sit exposed with little
    water to shield them. Microbial spoilage rises as water becomes available, peaking near
    a-w of 0.9 and collapsing below the microbial thresholds. The two curves cross, and
    every preserved food lives in the gap between them: dry enough to stop microbes, not
    so dry (or stored so long) that oxidation wins. Add the third shelf-life reaction —
    <em>enzymatic browning</em>, which needs water to run — and "shelf life" becomes a
    multi-front war with one main weapon: knowing each reaction's a<sub>w</sub> turf.
  </p>

  <Widget no="2" caption="why jam keeps but crackers go rancid" widget="plotter" config={awCfg} />

  <p>
    <strong>What to notice:</strong> the red spoilage curve lives at the wet end and dies
    below roughly 0.8 — that valley is every dried and sugared food on the shelf. The
    amber oxidation curve does the opposite, rising as the food dries out. The safe zone
    is the trough between them, and it is a <em>compromise</em>, not a victory: move left
    to escape microbes and you slide toward rancidity; move right for juiciness and
    microbes return. Jar-by-jar, recipe-by-recipe, food design is the art of parking a
    product in that trough.
  </p>
  <p><em>Common misconception:</em> "no water means no spoilage" and "sugar is just for
  sweetness". Dry foods still oxidise (curve two) and staling involves water
  <em>movement</em>, not just quantity; and in most preserved foods sugar's primary job is
  colligative — binding water — with sweetness a side effect. A jam recipe is a
  water-activity prescription that happens to taste good.</p>
  <p>
    <strong>So far:</strong> water availability governs which reactions can run — microbial
    growth at the wet end, oxidation at the dry end, and a compromise trough between. Now
    the molecules that make texture.
  </p>

  <h2>The macronutrients as materials</h2>
  <p>
    Carbohydrates, proteins and lipids are not just nutrition here — they are structural
    materials. Starch granules gelatinise and retrograde (why bread stales), proteins
    unfold and knit into networks (why egg sets and yoghurt gels), and fats crystallise
    into polymorphs (why chocolate snaps or blooms). Texture is applied polymer science.
  </p>
  <Widget no="7" caption="file each behaviour under its macromolecule" widget="sort-buckets" config={fcTextureSort} />
  <p>
    Take each mechanism in turn. <strong>Starch</strong> is packed in granules as
    semi-crystalline lumps; heated in water above about 60–70 °C the crystals melt, water
    floods in, and the granules swell to many times their volume —
    <em>gelatinisation</em>, the difference between flour in sauce and a sauce. On cooling
    and ageing, the dissolved starch chains re-associate into ordered, water-shedding
    crystallites — <em>retrogradation</em> — which is the physical chemistry of staling:
    bread does not go stale by drying (reheating retrograded bread re-melts the
    crystallites and "refreshes" it), it goes stale by recrystallising.
  </p>
  <p>
    <strong>Proteins</strong> are chains folded into precise shapes (the molecular detail
    belongs to biochemistry; here we need the behaviour). Heat, acid or beating unfolds
    them (<em>denaturation</em>), exposing sticky regions that bond to their neighbours —
    and when the neighbours form a continuous mesh, that is a gel: the set of a boiled
    egg, the body of yoghurt, the collapse-proof network of a soufflé. <strong>Gluten</strong>
    is the same physics with kneading instead of heat: wheat proteins crosslink into an
    elastic network that traps the gas of fermentation — bread's entire architecture.
  </p>
  <p>
    <strong>Lipids</strong> solidify into crystals, and their triglycerides pack in
    several distinct crystalline forms — <em>polymorphs</em> — with different melting
    points and shapes. Cocoa butter is the famous case, where only one polymorph (form V)
    gives the glossy snap of proper chocolate, and the wrong one gives the grey, crumbly
    <em>bloom</em> of a badly stored bar (tempering is polymorph control). Fats also
    <em>emulsify</em> and carry texture — mayonnaise is oil droplets held apart by
    egg-protein membranes — and their melting profile over body temperature is why butter,
    unlike most vegetable oils, "melts" on the tongue.
  </p>
  <p><em>Common misconception:</em> "fat is just calories, so removing it changes nothing
  but the number on the label." Fat is also the solvent that carries many aroma compounds
  and the texture-builder that makes food feel rich in the mouth — strip it out and the
  flavour chemistry literally has nothing to ride on. Low-fat reformulations fail on
  chemistry, not willpower.</p>

  <h2>Flavour is chemistry too</h2>
  <p>
    Taste is receptor chemistry (sweet, salty, sour, bitter, umami), but much of what we
    call flavour arrives retronasally from volatile molecules — and many of the best ones
    are reaction products. The Maillard reaction between reducing sugars and amino acids
    builds hundreds of aroma compounds; it is why toast, roast coffee and seared steak
    share a family resemblance. Control the chemistry, control the craving.
  </p>
  <p>
    The mechanism is worth knowing because it explains the craft. The <strong>Maillard
    reaction</strong> begins when a reducing sugar's carbonyl group attacks an amino group
    (from an amino acid or protein side chain), and cascades through rearrangements and
    fragmentations into hundreds of final products: pyrazines (roasted, nutty), furans
    (caramel-like), sulfur compounds (meaty, coffee-like — small amounts, enormous
    impact). It runs fastest at intermediate moisture, needs heat, and browns as it
    flavours — one reaction, simultaneously producing the colour, the crust and the aroma
    of a sear. <strong>Caramelisation</strong> is its cousin without amino acids: sugar
    alone heated past its melting point decomposes into buttery, bitter, nutty volatiles.
  </p>
  <Widget no="8" caption="fill the Maillard cascade" widget="cloze" config={fcMaillardCloze} />
  <p>
    Temperature and pH are the cooks' control knobs — a steak at 150 °C surface
    temperature Maillards in seconds; a boiled (100 °C) steak never browns, which is the
    whole reason for drying the surface and using a screaming-hot pan. Umami rounds out
    the receptor half of the story: glutamate plus the nucleotides inosinate and guanylate
    act <em>synergistically</em> — kombu (glutamate) plus bonito (inosinate) is the
    classical pairing, and the combination tastes far stronger than the sum, which is why
    stock-making is a chemistry of pairing. Bitterness, sweetness and salt interact at the
    receptor too — a pinch of salt in caramel or chocolate suppresses bitterness and
    amplifies sweetness, a perceptual mechanism food designers use as deliberately as any
    ingredient.
  </p>
  <Widget no="9" caption="call the switch-on temperature" widget="estimate" config={fcSearEstimate} />
  <p><em>Common misconception:</em> "browned food is burnt food." The browning that makes
  bread crust, seared meat and roasted coffee delicious is the Maillard reaction — amino
  acids and sugars combining above roughly 140 °C into hundreds of new flavour and aroma
  compounds. Burning is a different, later process: carbonisation, which only makes bitter
  char. Between pale and black lies a whole branch of chemistry.</p>

  <h2>Check yourself</h2>
  <p>Try these before moving on. Feedback follows each answer.</p>
  <ol>
    <li>Fresh meat is about 70% water; jam about 30%. Explain, in water-activity terms, why the jam keeps for years and the meat does not.</li>
    <li>Why does reheating stale bread in an oven "refresh" it — and what does that prove staling actually is?</li>
    <li>A cracker is microbially safe but tastes of cardboard after months in the packet. Which reaction won, and why did the cracker's dryness not prevent it?</li>
    <li>Your pan-seared chicken comes out pale and steamed, not golden. Diagnose it with the Maillard reaction's requirements.</li>
  </ol>
  <p>
    <strong>Feedback:</strong> (1) Availability, not quantity: meat's water is nearly free
    (a<sub>w</sub> ≈ 0.99, above the bacterial floor of ~0.91) while sugar locks jam's
    water down to roughly 0.75–0.85 — below most microbes' thresholds they simply cannot
    grow. (2) Retrogradation: the starch chains recrystallised into ordered,
    water-shedding crystallites; reheating re-melts them. Staling is recrystallisation,
    not drying. (3) Lipid oxidation — it accelerates at the dry end, where exposed surface
    fats have little water to shield them. Dryness stops microbes; it feeds oxidation.
    (4) The surface was wet and/or the pan too cool: boiling water on the surface and a
    100 °C-pegged temperature cannot drive the Maillard reaction, which needs heat (above
    roughly 140 °C) and a dry-ish surface. Dry the food, hot pan, no crowding.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>Food is a chemical system; "fresh" means chemistry at its most active, not chemistry-free.</li>
    <li>Water activity (a<sub>w</sub>) — equilibrium humidity, 0 to 1.0 — predicts what can grow and what can react; water content does not.</li>
    <li>Microbial thresholds: most bacteria above ~0.91, yeasts ~0.88, moulds ~0.80; below a threshold a microbe cannot grow — preservation without sterilising.</li>
    <li>Salt, sugar and drying are one mechanism (binding water); oxidation rises at the dry end, so every a<sub>w</sub> target is a compromise.</li>
    <li>Texture is polymer science: starch gelatinisation/retrogradation, protein denaturation/gels and gluten, fat polymorphs and tempering.</li>
    <li>The Maillard reaction (sugars + amino acids, needs heat and intermediate moisture) and caramelisation build most cooked flavour; umami works synergistically.</li>
    <li>Preservatives are ancient before they are synthetic: acid, cold, salt, sugar, smoke and drying all act through named mechanisms.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    The reactions you have met are mostly inconveniences; the next lesson, Food
    microbiology and fermentation, shows the same microbial world recruited on purpose —
    yoghurt, bread, beer, cheese and the acid and alcohol hurdles fermentation adds. The
    water-activity map built here becomes the backbone of the food-safety and preservation
    lessons, where thresholds turn into regulations.
  </p>

  <h2>Going deeper</h2>
  <p>
    Three frameworks carry food chemistry into professional territory. First, the
    <strong>glass transition</strong>: below a temperature-and-moisture-dependent point,
    the amorphous parts of a food (starch, sugar matrices) become glassy — brittle,
    diffusion-almost-stopped, maximally stable; most "shelf-stable" dry foods are
    engineered to stay below their glass transition, and every softening, caking or
    stickiness failure is the material crossing above it (the powder that turned into a
    brick in the bag). Water activity and glass transition are the two axes of the modern
    stability map, and Labuza's classic curves were their first sketch. Second,
    <strong>hurdle technology</strong>: real products rarely rely on one preservation
    factor but stack sub-lethal "hurdles" — low pH plus low a<sub>w</sub> plus
    preservative plus refrigeration — so that no microbe can clear all of them at once;
    chorizo (fermentation acid + salt + drying + spice antimicrobials) is the textbook
    example, and the design principle generalises to any reformulation challenge (cut the
    salt, add another hurdle).
  </p>
  <Widget no="10" caption="reformulate the sausage — stack the hurdles" widget="branch" config={fcHurdleBranch} />
  <p>
    Third, the <strong>frontier of flavour chemistry</strong>:
    gas-chromatography–mass-spectrometry plus human sniffing (GC–O) can now identify the
    dozen or so "odorants that matter" in a food out of hundreds present — tomato
    volatiles are largely supplied by C6 aldehydes cleaved from membrane lipids in seconds
    after cutting, which is why a chilled tomato tastes dull: the enzyme's membrane
    fluidity dropped and the aroma factory stalled. Refrigeration, ripening chemistry and
    flavour design meet in one measurement — the field's habit of converting a cooking
    intuition (serve tomatoes at room temperature) into a molecular mechanism is exactly
    what this unit's fundamentals are for.
  </p>
  <p>
    One worked product development shows the fundamentals integrating, because that is how
    the discipline is actually used. Task: design a shelf-stable, soft-baked fruit bar.
    <em>Water activity first</em>: the target is below ~0.85 (mould floor) but above the
    point where the texture turns leathery and the sugars begin to glass; the recipe
    balances fruit purée's free water against added sugar (binds water, lowers
    a<sub>w</sub>) and pectin (binds water into a gel network that holds the water it
    can). <em>Macronutrient engineering:</em> the purée's pectin sets the gel (a
    polysaccharide network), any added milk-protein powder adds chew and nutrition but
    also Maillard reactivity with the fruit's reducing sugars during baking — so baking
    temperature and time are chosen as much for colour control as for moisture loss.
    <em>Lipid considerations:</em> nuts add fat, which adds rancidity risk — the dry-ish,
    oxygen-exposed bar sits on the wrong side of the oxidation curve, so vitamin E (an
    antioxidant) or nitrogen-flushed packaging earns its place. <em>Flavour
    chemistry:</em> the bake is a controlled Maillard event — enough for toasty depth, not
    so much that the fruity esters are overpowered; a squeeze of acid keeps pH low, which
    both favours pectin gelation and adds a preservative hurdle. Notice the pattern: every
    design decision is one of this lesson's mechanisms with a number attached —
    a<sub>w</sub> target, gelation chemistry, a polyphenol or antioxidant choice, a
    Maillard window. That is food chemistry's working definition: the fundamentals are not
    background reading; they are the parameter list.
  </p>

  <p class="sources"><strong>Sources:</strong> IFT undergraduate education standards; Belitz, Grosch &amp; Schieberle, <em>Food Chemistry</em>; Labuza's classic work on water activity and shelf life; McGee, <em>On Food and Cooking</em>. Source text: OpenStax (https://openstax.org), CC BY 4.0 — adapted for Interactive Atlas.</p>

</TopicPage>
