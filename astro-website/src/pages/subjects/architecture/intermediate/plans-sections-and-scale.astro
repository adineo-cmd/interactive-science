const planCfg = {
  steps: [
    { math: '1 · The drawing set is a database', note: 'Plans (horizontal cuts ~1.2 m up — through the walls, showing rooms), sections (vertical cuts), elevations (facades), details (the joints). Orthographic projection: everything true size and position in its plane — the literal definition of architectural truth.' },
    { math: '2 · Scale and the discipline it teaches', note: '1:100 for plans, 1:50 for sections, 1:5 to 1:1 for details. A wall drawn in 3 seconds at 1:200 is a 20-minute decision at 1:5 — scale is a zoom level into consequences.' },
    { math: '3 · Reading a plan like a choreography', note: 'Follow the entrance: sequence of spaces (arrival → compression → release — the suspense of a lobby), circulation (the unavoidable paths), adjacencies (kitchen to dining), light sources. The plan is a social script in plan view.' },
    { math: '4 · Dimensions, tolerances, and buildability', note: 'Drawings speak to builders: dimension strings that close, materials called out, tolerances real-world (site concrete ±10 mm, not ±1). BIM (Building Information Modelling) now builds the project as a coordinated 3-D database first — clash detection catches pipes through beams before they exist.' },
  ],
};

const planQuizCfg = {
  questions: [
    {
      q: 'Why is a floor plan conventionally cut about 1.2 metres above the floor?',
      choices: [
        'That is standing eye height',
        'The cut passes through walls, doors and windows but below ceilings and door heads — exactly the information a plan exists to show',
        'Paper was smaller in the 19th century',
        'It avoids drawing furniture',
      ],
      answer: 1,
      why: 'The imaginary horizontal cut is positioned to intersect everything worth seeing in plan (wall thicknesses, openings, fixtures) and nothing that would clutter it (upper wall, ceiling, structure above). Move the cut and the drawing changes meaning — the convention is the reader\'s contract.',
    },
    {
      q: 'At 1:100, a 900 mm door leaf is drawn how long?',
      choices: [
        '90 mm',
        '9 mm',
        '900 mm',
        '10 mm',
      ],
      answer: 1,
      why: 'Divide by the scale denominator: 900 mm ÷ 100 = 9 mm. The mechanical trick is trivial; the professional habit it supports is not — checking every drawn distance against what a body, a trolley or a wheelchair needs is how drawings get truthful.',
    },
    {
      q: 'A dimension string is "closed" when:',
      choices: [
        'Every dimension is a round number',
        'The segment dimensions sum exactly to the overall dimension — no rounding residue',
        'It runs only along one wall',
        'It is drawn twice',
      ],
      answer: 1,
      why: 'A string that does not close (say segments of 2100 + 1800 + 1500 against an overall of 5390) forces the crew to improvise 10 mm somewhere — usually at the worst place. Closing the string pushes the discrepancy into a designed joint, where it belongs.',
    },
    {
      q: 'Poché (cut walls filled solid black or heavy hatch) works because:',
      choices: [
        'It looks expensive',
        'It instantly separates cut material from space, so the eye reads structure against void without effort — a graphic convention doing analytical work',
        'Printers required it',
        'It hides mistakes',
      ],
      answer: 1,
      why: 'In an orthographic plan, "cut solid" is the strongest visual statement available; filling it makes walls read as figure and rooms as ground at a glance. Conventions like this are why a 500-year-old plan by Palladio is readable today — they are a language, and languages survive.',
    },
  ],
};

