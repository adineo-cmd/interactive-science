const psClashPredict = {
  "q": "BIM's clash detection runs overnight on the model. What does it actually catch?",
  "choices": [
    "Every duct intersecting every beam and every pipe with every soffit — on Tuesday instead of on site, with a hammer and a change order",
    "Spelling errors in the specification",
    "Structural overloading of the foundations"
