};

const psStringSpot = {
  "prompt": "One line of this dimensioning answer is wrong — click it:",
  "lines": [
    "A dimension string runs: 2100 + 1800 + 1500 against an overall of 5390.",
    "The segments sum to 5400, leaving a 10 mm rounding residue.",
    "Adjust one segment so the sum closes exactly at 5390.",
    "Or leave the string open — the crew will absorb the 10 mm at the most visible corner."
  ],
  "errorLine": 3,
  "correction": "Close the string — push any discrepancy into a designed joint, where it belongs.",
  "why": "A string that does not close forces the crew to improvise the residue somewhere, usually at the worst place. Closing it makes the tolerance a designed act."
