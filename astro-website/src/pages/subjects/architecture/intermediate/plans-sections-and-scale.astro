import Widget from '../../../../components/Widget.astro';

const planCfg = {
  steps: [
    { math: '1 · The drawing set is a database', note: 'Plans (horizontal cuts ~1.2 m up — through the walls, showing rooms), sections (vertical cuts), elevations (facades), details (the joints). Orthographic projection: everything true size and position in its plane — the literal definition of architectural truth.' },
    { math: '2 · Scale and the discipline it teaches', note: '1:100 for plans, 1:50 for sections, 1:5 to 1:1 for details. A wall drawn in 3 seconds at 1:200 is a 20-minute decision at 1:5 — scale is a zoom level into consequences.' },
    { math: '3 · Reading a plan like a choreography', note: 'Follow the entrance: sequence of spaces (arrival → compression → release — the suspense of a lobby), circulation (the unavoidable paths), adjacencies (kitchen to dining), light sources. The plan is a social script in plan view.' },
    { math: '4 · Dimensions, tolerances, and buildability', note: 'Drawings speak to builders: dimension strings that close, materials called out, tolerances real-world (site concrete ±10 mm, not ±1). BIM (Building Information Modelling) now builds the project as a coordinated 3-D database first — clash detection catches pipes through beams before they exist.' },
  ],
};
---
<TopicPage slug="subjects/architecture/intermediate/plans-sections-and-scale">
  <h2>The idea</h2>
  <p>
    Architectural drawing is <strong>a precision language for unbuilt things</strong> —
    orthographic cuts that tell the truth about size and position, at scales chosen to match the
    decisions each drawing carries. Reading drawings is literacy; making them readable is the
    craft.
  </p>

  <Widget no="1" caption="the set, the scales, the choreography, the dimensions" widget="equationStep" config={planCfg} />

  <h2>What the drawings encode</h2>
  <ul>
    <li><strong>The poché trick:</strong> cut walls solid black in plans — your eye instantly separates solid from void, structure from space. Graphic conventions are analytical tools, not decoration.</li>
    <li><strong>Sections expose the vertical argument:</strong> double-height voids, stair choreography, light from above — the sectional idea often IS the architectural idea (churches and auditoria are section-first designs).</li>
    <li><strong>BIM changed the practice:</strong> one model generates plans, sections, schedules and quantities; every object carries data (cost, thermal, fire rating). The drawing became a queryable database (the data lesson\'s tidy principles, applied to buildings).</li>
    <li><strong>Hand drawing survives where it wins:</strong> the sketch diagram — massing, circulation arrow, section concept — still designs faster than any software; the tools split the work: machines coordinate, humans conceive.</li>
  </ul>
  <p class="sources"><strong>Sources:</strong> Ching, Building Construction Illustrated; RIBA drawing conventions; Salmon, Drawing for Architects.</p>
</TopicPage>
