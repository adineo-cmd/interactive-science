  "scale": {
    "min": 0,
    "max": 90
  },
  "answer": 27,
  "tolerance": 3,
  "why": "90 − 40 − 23.4 ≈ 27° — the 46° swing is a free seasonal switch: an overhang of d ≈ 0.58·h blocks the summer sun while covering only ~0.21·h of the winter window.",
  "context": "One square metre of south glazing under 500 W/m² winter sun at SHGC 0.6 delivers ~300 W of free heat — and the same square metre in July is an air-conditioning bill."
};

const edGlassPredict = {
  "q": "An all-glass facade ends its first summer with the blinds permanently down. What did the design get wrong?",
  "choices": [
    "It treated daylight as glass area instead of useful daylight at the desk without glare",
