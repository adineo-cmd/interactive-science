import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const envDesignCfg = {
  steps: [
    { math: '1 · The sun is the first client', note: 'Orientation: south-facing glass gains winter sun (in the northern hemisphere), west glass gains afternoon heat nobody wants. Solar geometry (the latitude lesson\'s 23.4° tilt) sets shading angles — design the overhang so summer sun is blocked and winter sun admitted. Geometry does the work.' },
    { math: '2 · Daylight: quality and quantity', note: 'Daylight factor (the ratio of indoor to outdoor light): 2% is dim, 5% is pleasant, side windows light ~6–8 m deep, courtyards and light shelves push further. Health evidence (sleep, mood, learning) made daylight a measurable design requirement, not a taste.' },
    { math: '3 · Air: the oldest HVAC', note: 'Cross-ventilation (inlet and outlet), stack effect (hot air rises — chimney-driven ventilation), night purging of thermal mass. Vernacular architecture worldwide ran on these physics for millennia; the passive-design lesson modernises them.' },
    { math: '4 · Heat: in, through, stored', note: 'Insulation slows conduction (R-values), thermal mass (concrete, stone, water) damps swings, and glazing is both window and hole in the envelope (U-values) — the energy lesson\'s building physics, in one wall section.' },
  ],
};

const envQuizCfg = {
  questions: [
    { q: 'A south-facing overhang should be sized so that…', choices: ['it blocks all sun all year', 'high summer sun (≈ 60–70° altitude) is blocked while low winter sun (≈ 20°) enters', 'it matches the neighbour\'s', 'it shades only the floor'], answer: 1, why: 'Overhang depth d relates to window height h by d/h = 1/tan(sun altitude). At 60°, d ≈ 0.6h blocks summer; at 20° the same overhang is nearly transparent — geometry gives free seasonal switching.' },
    { q: 'A wall with U = 2.0 W/m²K is upgraded to U = 0.2. On a 20 K temperature difference, heat loss per m² falls…', choices: ['from 40 W/m² to 4 W/m² — tenfold', 'from 2 W/m² to 0.2 W/m²', 'not at all — U is about light', 'from 200 to 20 W/m²'], answer: 0, why: 'Heat flow = U × ΔT: 2.0 × 20 = 40 W/m² becomes 0.2 × 20 = 4 W/m². That single multiplication is the arithmetic behind every insulation code tightening of the last fifty years.' },
    { q: 'Night purging works because…', choices: ['nights are quieter', 'cool night air flushes heat stored in thermal mass during the day, recharging it for the next day', 'humidity drops to zero', 'windows expand'], answer: 1, why: 'Mass without night ventilation just stays hot. Ventilating through the night discharges the stored heat so concrete or brick can absorb the next day\'s gains — mass plus air, never mass alone.' },
    { q: 'CO₂ concentration above ~1,000 ppm in a classroom usually means…', choices: ['the building is on fire', 'ventilation per person is too low — thinking performance measurably declines as CO₂ accumulates', 'the CO₂ sensor is broken', 'too many plants'], answer: 1, why: 'Occupants exhale ~0.005 L/s of CO₂ each; concentration is a live proxy for fresh-air supply per person. Above 1,000 ppm, decision-making studies show measurable declines — air quality is a cognitive design parameter.' },
  ],
};

const edSunPlace = {
  "prompt": "At 40° latitude the June noon sun sits at ~73°. Place the December noon sun on the scale (degrees):",
