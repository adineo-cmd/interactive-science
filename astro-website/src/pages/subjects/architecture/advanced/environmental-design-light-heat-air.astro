};

const edStackOrder = {
  "prompt": "From buoyancy to flow — put the stack engine in order:",
  "items": [
    "Warm indoor air is buoyant",
    "It vents through high-level atrium outlets",
    "Replacement air is drawn through low-level inlets",
    "The driving pressure runs about 0.5 Pa per metre of height at a 12 K difference",
    "A five-metre atrium therefore offers about 2.5 Pa — small, but moving real air"
  ],
  "why": "That pressure doubles if either the height or the temperature difference doubles — which is why tall, section-first buildings ventilate themselves and single-storey slabs struggle without wind or fans."
};

const edTightJudge = {
  "statements": [
    {
      "s": "Airtightness and ventilation are opposites — seal for efficiency and accept stale air.",
      "truth": false,
      "why": "Tight and ventilated beats leaky and accidental on every axis: the best-sealed buildings pair airtightness with deliberate supply."
    },
    {
      "s": "Uncontrolled infiltration through a leaky fabric wastes more heat than controlled ventilation ever needs.",
      "truth": true,
      "why": "The ledger says so — which is why fabric-first comes before any equipment."
    },
    {
      "s": "Heat-recovery units keep most of the exhaust air's warmth before it leaves.",
      "truth": true,
      "why": "Standard practice in cold climates: supply controlled, keep the warmth."
    },
