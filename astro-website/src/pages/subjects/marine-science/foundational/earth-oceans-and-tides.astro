  height: 340,
};

const tidesCfg = {
  steps: [
    { math: '1 · The Moon pulls on the Earth', note: 'Gravity weakens with distance, so the Moon pulls hardest on the near side of Earth and least on the far side.' },
    { math: '2 · Two bulges, not one', note: 'The near-side ocean is pulled toward the Moon; the far side is effectively left behind. Result: two bulges, one facing the Moon, one opposite.' },
    { math: '3 · Earth rotates underneath', note: 'As the planet spins once per day, most coasts pass through both bulges — giving two high tides and two low tides daily.' },
    { math: '4 · The Sun joins in', note: 'The Sun raises smaller bulges. At new and full moon the solar and lunar bulges align (spring tides); at quarter moon they fight (neap tides).' },
    { math: '5 · Real coasts complicate it', note: 'Basin shapes and resonance make real tides lopsided — some places have one tide a day, some almost none, and a few have 15-metre ranges.' },
  ],
