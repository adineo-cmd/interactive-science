---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const recycleCfg = {
  curves: [
    { expr: '100/(1 + 4*x)', label: 'reactant leaving unreacted', color: '#b45309', width: 2.4 },
  ],
  x: { min: 0, max: 5, label: 'number of passes through the reactor' },
  y: { min: 0, max: 105, label: '% of feed still unconverted' },
  crossings: false,
  height: 330,
};

const balancesCfg = {
  steps: [
    { math: '1 · Draw the box', note: 'Pick a boundary around the process — one unit or the whole plant. Everything outside is the environment.' },
    { math: '2 · Mass in − mass out = accumulation', note: 'The conservation law, written for the box. Steady state means accumulation is zero: whatever flows in flows out.' },
    { math: '3 · Account for reactions', note: 'For reacting systems, balance atoms, not molecules: 4 Fe + 3 O₂ → 2 Fe₂O₃ conserves each element even as compounds vanish.' },
    { math: '4 · Energy gets the same treatment', note: 'Energy in − energy out = accumulation, with enthalpy carrying the chemistry. A reactor that consumes heat must be fed it.' },
    { math: '5 · Recycle changes the arithmetic', note: 'Recycling unreacted feed raises overall conversion without a better reactor — but purge streams are needed to keep inerts from accumulating.' },
  ],
};

const mebBoxMatch = {
  "prompt": "Choose the system boundary — pair each box with what it teaches you:",
  "pairs": [
    {
      "left": "box around a single pump",
      "right": "what the pump does"
    },
    {
      "left": "box around a reactor plus its recycle loop",
      "right": "what the loop achieves"
    },
    {
      "left": "box around the whole plant",
      "right": "what you are paying for at the fence line"
    }
  ],
  "why": "The physics never changes — only the box. Learning where to draw it, and what to neglect once it is drawn, is the first genuine skill of the subject."
};

const mebSteadyCloze = {
  "text": "A process is at %%0%% when nothing changes with time: gauges read constant values, tank levels sit still, temperatures hold. Then accumulation is %%1%%, and the equation collapses to %%2%% equals %%3%% — like a shop whose daily takings exactly match its daily sales.",
  "answers": [
    [
      "steady state"
    ],
    [
      "zero"
    ],
    [
      "input"
    ],
    [
      "output"
    ]
  ],
  "hint": "The bathtub level sits still — what does that make the accumulation, and the two flows?"
};

const mebEvapEstimate = {
  "prompt": "An evaporator concentrates juice from 10 per cent to 50 per cent solids, feed 1,000 kg per hour. Roughly what leaves as concentrated product?",
  "unit": "kg per hour",
  "answer": 200,
  "factor": 1.3,
  "why": "200 kg per hour of product — the solids balance reads 0.10 × 1,000 = 0.50 × P, and the total balance then hands over 800 kg per hour of vapour.",
  "context": "That vapour rate sizes the condenser and tells you the steam bill."
};

const mebSteadyJudge = {
  "statements": [
    {
      "s": "A candle burning steadily is at steady state.",
      "truth": true,
      "why": "Temperatures and flame shape are constant — but it is very far from chemical equilibrium."
    },
    {
      "s": "Steady state and chemical equilibrium are the same thing.",
      "truth": false,
      "why": "Steady state is about flows balancing over time; equilibrium is about no net driving force left."
    },
    {
      "s": "Plants are engineered to run at states deliberately far from equilibrium.",
      "truth": true,
      "why": "That is precisely where reactions and separations actually happen."
    },
    {
      "s": "At equilibrium a reaction has no net driving force left.",
      "truth": true,
      "why": "Which is exactly why an equilibrium plant would produce nothing new."
    }
  ]
};

const mebElementBuckets = {
  "prompt": "In a reacting system, what is conserved and what changes identity? File each:",
  "buckets": [
    "elements (conserved)",
    "compounds (change identity)"
  ],
  "items": [
    {
      "label": "carbon atoms",
      "bucket": 0
    },
    {
      "label": "hydrogen atoms",
      "bucket": 0
    },
    {
      "label": "oxygen atoms",
      "bucket": 0
    },
    {
      "label": "methane",
      "bucket": 1
    },
    {
      "label": "carbon dioxide",
      "bucket": 1
    },
    {
      "label": "water",
      "bucket": 1
    }
  ],
  "why": "Atoms are never created or destroyed in an ordinary reaction — they only change partners; the compounds they form come and go."
};

const mebOxygenEstimate = {
  "prompt": "Burning 100 mol per hour of methane needs 200 mol per hour of oxygen. With 20 per cent excess for safety, how much oxygen is supplied?",
  "unit": "mol per hour",
  "answer": 240,
  "factor": 1.2,
  "why": "240 mol per hour of oxygen — arriving inside about 1,143 mol per hour of air, carrying 903 mol per hour of nitrogen that takes no part in the reaction.",
  "context": "The leftover 40 mol per hour is what the stack analyser reads as roughly 3.8 per cent oxygen."
};

const mebStackPlace = {
  "prompt": "The dry flue gas from the complete burn reads near what oxygen percentage? Place the marker:",
  "labels": [
    "0%",
    "7%",
    "14%",
    "21%"
  ],
  "scale": {
    "min": 0,
    "max": 21
  },
  "answer": 3.8,
  "tolerance": 0.8,
  "why": "Near 3.8 per cent — 40 mol of leftover oxygen in about 1,043 mol of flue gas; operators read it to tell whether the burner is running rich, lean, or leaking air."
};

const mebLoopOrder = {
  "prompt": "The ammonia loop, from feed to purge — put it in order:",
  "items": [
    "Nitrogen and hydrogen enter the converter",
    "Per-pass conversion is a modest 15 per cent",
    "Ammonia is condensed out as product",
    "Unreacted gas loops back to the converter",
    "A purge bleeds out the inert argon at exactly the rate it enters"
  ],
  "why": "Per-pass conversion stays modest — which keeps the reaction controllable and the catalyst happy — while overall conversion of the fresh feed exceeds 97 per cent."
};
---
<TopicPage slug="subjects/chemical-engineering/foundational/material-and-energy-balances">
  <h2>Where you are, and what you will learn</h2>
  <p>
    This is the beginner lesson of Chemical Engineering. You need no chemistry
    beyond arithmetic — every technical term is defined in plain words the moment
    it appears, and every calculation is worked step by step.
  </p>
  <p>By the end of this lesson you will be able to:</p>
  <ul>
    <li>draw a system boundary, and explain why choosing the box is the first skill;</li>
    <li>solve a steady-state mass balance, including the component-balance trick;</li>
    <li>handle reactions by balancing elements, and define conversion and yield;</li>
    <li>explain what recycle and purge do, and why every recycle loop needs a purge;</li>
    <li>write an energy balance and estimate a flame temperature with it.</li>
  </ul>
  <p>Take your time; each paragraph carries exactly one idea.</p>

  <h2>Start with a bathtub</h2>
  <p>
    Turn on the tap and pull out the plug. If the tap delivers exactly as much as
    the drain carries away, the water level sits still. That stillness is not
    inactivity — water is rushing through the whole time. It is
    <strong>balance</strong>: inflow equals outflow. Every chemical plant is a web
    of bathtubs kept deliberately in this state, and the tool for designing them
    is bookkeeping.
  </p>
  <p>
    A chemical plant is, at bottom, an accounting problem. Raw material worth
    money flows in at one end. Product worth more money flows out somewhere else.
    Everything between — reactors, distillation columns, heat exchangers, pumps —
    either transforms or moves that material. The foundational fact of the subject
    is one every accountant already believes: nothing appears from nowhere, and
    nothing vanishes without a trace. Mass and energy are
    <strong>conserved</strong> — their total never changes — so the counts at the
    door must reconcile.
  </p>
  <p>
    The mental move that makes it work is choosing the <strong>system
    boundary</strong>: the imaginary box you draw around whichever piece of the
    plant you want to study. Draw it around a single pump and you learn what the
    pump does. Draw it around a reactor plus its recycle loop and you learn what
    the loop achieves. Draw it around the whole plant and you learn what you are
    paying for at the fence line. The physics never changes — only the box.
    Learning where to draw it, and what to neglect once it is drawn, is the first
    genuine skill of the subject.
  </p>
  <Widget no="10" caption="pair each box with what drawing it teaches" widget="match" config={mebBoxMatch} />
  <p>
    This is also why the discipline is described as "chemistry with consequences
    at scale". A bench chemist can throw away the 60 per cent that did not convert
    in the flask; a plant producing a thousand tonnes a day cannot. The engineer
    must know, before anything is built, how much feed to buy, how big to make
    each vessel, how much steam and cooling water to supply, and where every side
    stream goes. Nearly all of that starts as bookkeeping: mass balances first,
    energy balances second, equipment sizing once the numbers close.
  </p>

  <Widget no="1" caption="the balance equation, from box to recycle" widget="equationStep" config={balancesCfg} />
  <p>
    <strong>What to notice:</strong> the five steps are one skill repeated — draw
    the box, write the conservation law for it, and choose what to count. At steady
    state accumulation is zero; reactions are handled by counting atoms instead of
    molecules; energy gets the same treatment as mass; and recycle raises overall
    conversion only if a purge keeps inerts from accumulating.
  </p>

  <p>
    <strong>So far:</strong> a plant is a set of boxes where what flows in must
    flow out, because mass and energy are conserved; the skill is choosing where
    to draw the box. Now the master equation.
  </p>

  <h2>Steady-state balances</h2>
  <p>The master equation is written in one line for any conserved quantity:</p>
  <p>input − output = accumulation.</p>
  <p>
    <em>Accumulation</em> is how fast the amount inside the box is growing or
    shrinking — the bathtub level rising or falling. A process is at
    <strong>steady state</strong> when nothing changes with time: gauges read
    constant values, tank levels sit still, temperatures hold. Then accumulation
    is zero, and the equation collapses to "input equals output" — like a shop
    whose daily takings exactly match its daily sales. Most design calculations
    assume steady state, because a plant spends its working life there. Startup,
    shutdown and upsets are the exceptions that transient (changing-with-time)
    balances handle.
  </p>
  <Widget no="9" caption="fill the blanks — the master equation at work" widget="cloze" config={mebSteadyCloze} />
  <p>
    A worked example shows how little machinery is needed. An
    <strong>evaporator</strong> — a device that boils water out of a liquid —
    concentrates fruit juice from 10 per cent solids to 50 per cent solids. Feed
    arrives at 1,000 kg per hour. Draw the box around the evaporator: juice and
    water vapour cross it, nothing reacts. The total mass balance says product
    plus vapour equals 1,000 kg per hour. But one equation with two unknowns
    cannot be solved yet — that is the signal to write a <em>component
    balance</em>: a balance on one thing inside a stream instead of the whole
    stream.
  </p>
  <Widget no="8" caption="call the product rate — the evaporator" widget="estimate" config={mebEvapEstimate} />
  <p>
    Solids do not evaporate, so the solids balance reads: 0.10 × 1,000 = 0.50 × P.
    That gives P = 200 kg per hour of concentrated juice. The total balance then
    hands over the vapour rate: V = 800 kg per hour of water boiled off. That
    vapour rate, in turn, sizes the condenser and tells you the steam bill. Two
    lines of arithmetic, and a piece of the plant is already designed.
  </p>
  <p>
    <em>Common misconception:</em> steady state does not mean equilibrium. A candle burning
    steadily is at steady state — temperatures and flame shape are constant — but it is very far
    from chemical equilibrium. Steady state is a statement about flows balancing over time;
    equilibrium is a statement about a reaction or transfer being complete, with no net driving
    force left. Plants are engineered to run at steady states that are deliberately far from
    equilibrium, precisely because that is where reactions and separations actually happen.
  </p>
  <Widget no="7" caption="true or false — steady state versus equilibrium" widget="judge" config={mebSteadyJudge} />
  <p>
    <strong>So far:</strong> at steady state, input equals output; when one
    equation is not enough, write a balance for a component that takes only one
    path. Next: what happens when molecules change identity.
  </p>

  <h2>Reactive systems and extent of reaction</h2>
  <p>
    Reactions scramble the bookkeeping because molecules change identity. Methane
    burns to carbon dioxide and water, and no molecule of methane survives to be
    counted "out". The fix is to balance <em>elements</em>, not compounds: carbon
    atoms, hydrogen atoms and oxygen atoms each obey their own conservation law.
    Atoms are never created or destroyed in an ordinary reaction — they only
    change partners.
  </p>
  <Widget no="6" caption="file the bookkeeping — element or compound" widget="sort-buckets" config={mebElementBuckets} />
  <p>
    The tidy way to organise this is the <strong>extent of reaction</strong>: one
    number describing how far the reaction has run. For each species, the change
    equals its <strong>stoichiometric coefficient</strong> — the number written in
    front of it in the balanced equation — times that one common unknown. For
    CH<sub>4</sub> + 2 O<sub>2</sub> → CO<sub>2</sub> + 2 H<sub>2</sub>O, every
    mole of methane consumed takes two moles of oxygen with it and produces one
    mole of carbon dioxide and two of water. (A <em>mole</em> is the chemist's
    counting word, like "a dozen" — about 6 × 10<sup>23</sup> molecules.)
  </p>
  <p>
    Take the workhorse of the process industries: burning methane with 20 per cent
    excess air. Feed 100 mol per hour of methane. The balanced equation demands
    200 mol per hour of oxygen; with 20 per cent extra for safety, supply 240.
    That oxygen arrives inside air, which is 21 per cent oxygen, so the air flow
    is about 1,143 mol per hour — carrying about 903 mol per hour of nitrogen,
    which takes no part in the reaction.
  </p>
  <Widget no="5" caption="call the oxygen feed" widget="estimate" config={mebOxygenEstimate} />
  <p>
    If the methane burns completely, the extent is 100 mol per hour. The flue gas
    — the exhaust, counted dry — contains 100 mol per hour of carbon dioxide, the
    leftover 40 mol per hour of oxygen, and all 903 of nitrogen: about 1,043 mol
    per hour total, with oxygen near 40 ÷ 1,043 ≈ 3.8 per cent. That single number
    is what a plant's oxygen analyser reads in the stack, and operators use it to
    tell whether the burner is running rich, lean, or leaking air.
  </p>
  <Widget no="4" caption="drop the marker on the stack reading" widget="place" config={mebStackPlace} />
  <p>
    Two companion definitions matter. <em>Conversion</em> is the fraction of a
    reactant that is consumed. <em>Yield</em> and <em>selectivity</em> enter when
    side reactions compete: the same reactor can convert all its feed while
    producing mostly the wrong product, and no amount of mass-balance cleverness
    fixes that — only chemistry and catalyst choice can. The balances tell you
    what must be true. Only experiment tells you what is achievable.
  </p>
  <p>
    <em>Common misconception:</em> reactions do not destroy mass. It feels natural to say
    "the methane disappeared," but weigh a sealed furnace burning methane with its oxygen supply
    and the total mass is unchanged — the carbon and hydrogen have simply moved into new
    molecules. A mass balance written only for one compound will not close in a reactive system;
    written for each element, it closes exactly, always.
  </p>

  <h2>Recycle and purge</h2>
  <p>
    Real reactions rarely reach completion in a single pass — a reactor might
    convert only 40 per cent of what enters. Throwing away the unconverted 60 per
    cent would be ruinous, so engineers send it around again. A
    <strong>recycle stream</strong> returns unreacted feed to the reactor inlet,
    giving every molecule as many chances as it needs. The crucial insight:
    recycle improves <em>overall</em> conversion, not the reactor itself. The
    vessel is unchanged, but at steady state it processes (1 + R) times the fresh
    feed, where R is the recycle ratio — recycle divided by fresh feed. The
    average molecule gets 1 + R trips through before it either reacts or escapes.
  </p>

  <Widget no="2" caption="unconverted feed falls with each pass" widget="plotter" config={recycleCfg} />
  <p>
    <strong>What to notice:</strong> the curve falls steeply over the first pass or
    two and then flattens — each extra pass converts less of what remains, so
    overall conversion climbs toward complete conversion without the reactor itself
    ever improving.
  </p>

  <p>
    The arithmetic is a steady-state balance on the recycle loop. The ammonia
    synthesis loop is the classic case: nitrogen and hydrogen convert to ammonia
    at perhaps 15 per cent per pass, the ammonia is condensed out as product, and
    the unreacted gas loops back to the converter. Per-pass conversion stays
    modest — which keeps the reaction controllable and the catalyst happy — while
    overall conversion of the fresh feed exceeds 97 per cent.
  </p>
  <Widget no="3" caption="walk the recycle loop, in order" widget="order" config={mebLoopOrder} />
  <p>
    But recycle has a catch that bit many early plants: whatever enters the loop
    and does not leave as product, or react away, will <em>accumulate</em>. Inert
    argon rides in with the air used to make ammonia synthesis gas, and argon
    neither condenses nor reacts. Without an exit, the loop's argon fraction
    would creep upward forever, diluting the reactants and strangling the
    reaction rate. The remedy is a <strong>purge</strong>: a small bleed stream
    that removes inerts at exactly the rate they enter. Setting the purge rate is
    itself a balance — purge enough to hold inerts down, but every kilogram
    purged carries valuable reactants with it. Industrial loops live permanently
    on this knife edge, and adjusting purge is one of the standard levers of
    plant operation.
  </p>
  <p>
    <em>Common misconception:</em> recycle is not free lunch. It raises overall conversion, but
    it also enlarges every piece of equipment in the loop (more flow to pump, cool and separate),
    adds compression or pumping cost, and — without a purge — guarantees runaway accumulation of
    anything inert. The design question is never "should we recycle?" but "how much recycle is
    worth what it costs?"
  </p>
  <p>
    <strong>So far:</strong> recycle gives molecules more chances, raising
    overall conversion without a better reactor; a purge bleeds out whatever
    would otherwise accumulate. One ledger remains: energy.
  </p>

  <h2>Energy is the other ledger</h2>
  <p>
    Every mass balance travels with an energy balance, because moving and
    transforming matter costs and releases energy in predictable, auditable
    amounts. The same master equation applies: energy in − energy out =
    accumulation, with steady state collapsing it to "energy in equals energy
    out". The tricky part is that energy enters in disguise — as heat, as the
    push required to move fluid through pipes, and above all as
    <strong>enthalpy</strong>, the accounting quantity that bundles a stream's
    internal energy with that flow work. Enthalpy tables are to the chemical
    engineer what a price list is to an accountant: the reference book that
    converts "how much stuff" into "how much energy".
  </p>
  <p>
    Reactions book their energy under enthalpy too. Burning one mole of methane
    releases about 890 kJ of heat. Ask where that heat goes in an
    <strong>adiabatic</strong> burner — a box with no heat loss — and you can
    estimate the flame temperature with the tools already on the table. Using the
    flue gas from the worked example above, roughly 1,243 mol of hot products
    carry a total heat capacity near 41 kJ per kelvin; 890 ÷ 41 gives a
    temperature rise of order 2,100 kelvin above ambient. The measured adiabatic
    flame temperature of methane in air lands near 2,200 K — the simple balance
    captures the physics within a few per cent.
  </p>
  <p>
    The same arithmetic, run backwards, sizes the cooling water that keeps an
    exothermic reactor — one that releases heat — from running away. Heat
    generation is fixed by the reaction rate; the coolant must carry it out at
    exactly that rate, or the temperature rises, and with it the reaction rate: a
    runaway. Energy balances also reveal opportunities that pure mass thinking
    misses. A distillation column's overhead vapour must be condensed, and a feed
    stream must be preheated; put them in one box and the vapour can preheat the
    feed, halving the steam bill. This <strong>heat integration</strong> —
    matching every heat source in the plant with a heat sink that wants it — is
    applied energy accounting, and on large plants it saves megawatts.
  </p>

  <h2>Check yourself</h2>
  <p>Try these before moving on. The answers are right below.</p>
  <ol>
    <li>In the evaporator example, why did one total balance fail to solve the problem, and what fixed it?</li>
    <li>Why is a recycle loop useless without a purge when the feed carries an inert gas?</li>
    <li>Burning methane releases 890 kJ per mole. Why does the flame stop rising at about 2,200 K?</li>
  </ol>
  <p>
    <strong>Answers:</strong> (1) One equation had two unknowns; a component
    balance on the solids — which take only one path, the product — supplied the
    missing equation. (2) The inert cannot leave as product and does not react,
    so it accumulates until it dilutes the reactants and strangles the reaction;
    the purge gives it an exit. (3) The heat has nowhere to go except into the
    products, so their temperature climbs until the extra heat carried away
    exactly matches the heat released — the adiabatic balance point.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>Mass and energy are conserved, so every box drawn on a plant must reconcile: input − output = accumulation.</li>
    <li>At steady state accumulation is zero — input equals output — and most design calculation assumes the plant runs there.</li>
    <li>When one equation is not enough, write a component balance on whatever takes only one path.</li>
    <li>Reactions never destroy mass: balance elements, not compounds, and organise the counting with the extent of reaction.</li>
    <li>Recycle raises overall conversion without a better reactor — but every recycle loop needs a purge to bleed out whatever would accumulate.</li>
    <li>Energy balances ride along with mass balances: enthalpy tables convert "how much stuff" into "how much energy".</li>
    <li>Steady state is not equilibrium: plants run far from equilibrium on purpose, because that is where reactions and separations happen.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    The balance discipline scales directly from one evaporator to a whole plant:
    the next lessons put the accounting to work on the equipment that fills a
    flowsheet — reactors, separators and heat exchangers, all previewed above — with
    the box simply drawn around more of the plant. Ahead, too, are the refinements
    met in Going deeper: degrees-of-freedom counting, equilibrium and multiple
    extents, and the simulators that solve hundreds of coupled balances at once.
  </p>

  <h2>Going deeper</h2>
  <p>
    The first step from toy problems to real ones is the
    <strong>degrees-of-freedom</strong> count. Before solving anything, the
    engineer tallies unknowns against independent equations. The difference tells
    you whether the problem is exactly solvable, underspecified (it needs a
    measurement or a design decision), or overspecified (a contradiction — the
    flowsheet cannot work as drawn). Seasoned engineers do this count
    reflexively, and when a simulation refuses to converge it is usually a
    degrees-of-freedom error in disguise: the physics is fine, the specification
    is not.
  </p>
  <p>
    With multiple simultaneous reactions, one extent is not enough — each
    independent reaction gets its own extent, and the element balances fix their
    relative values. The method extends cleanly to equilibrium: at equilibrium
    the extents satisfy the thermodynamic relation linking the equilibrium
    constant to Gibbs energy, which is how reactor simulators predict exactly how
    far a reaction will go at a given temperature and pressure. Unsteady balances
    — accumulation allowed to be nonzero — govern startup, shutdown, tank
    draining and safety analysis, and they are the mathematical basis of process
    control, where controllers exist precisely to drive a transient system back
    toward a chosen steady state.
  </p>
  <p>
    At plant scale, hundreds of coupled nonlinear balances are solved
    simultaneously by flowsheet simulators such as Aspen Plus and HYSYS, each
    unit operation contributing its own mass, energy and equilibrium relations.
    The art of the engineer remains what it was at the back of the envelope:
    choosing the box, deciding what to neglect, and knowing when an answer that
    closes is nonetheless wrong. Debated questions live at the margins — how much
    uncertainty in enthalpy data propagates through a design, how to close
    balances when plant instruments disagree, and how to formulate balances for
    processes (carbon capture, battery recycling) where the "feed" itself is an
    unsteady, variable commodity.
  </p>

  <p class="sources"><strong>Sources:</strong> NCEES FE Chemical exam specifications; Felder &amp; Rousseau, <em>Elementary Principles of Chemical Processes</em>. Source text: OpenStax (https://openstax.org), CC BY 4.0 — adapted for Interactive Atlas.</p>
</TopicPage>
