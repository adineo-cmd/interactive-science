const econanthCfg = {
  steps: [
    { math: '1 · The gift is not free', note: 'Mauss (1925): gifts create obligation — giving, receiving, reciprocating is a total social system (potlatch, kula ring). "Pure" gifts are the exception; most giving weaves ties that bind.' },
    { math: '2 · Economies embedded in society', note: 'Polanyi (1944): markets are recent and constructed — historically, economies were embedded in kinship, religion and reciprocity. The "self-regulating market" of the economics lesson is one design among many, not human nature.' },
    { math: '3 · Money and objects have biographies', note: 'Appadurai / Kopytoff: things move through regimes of value (a relic, a commodity, a gift — same object). Money itself is culturally loaded: some currencies can\'t buy certain things (blood, votes, sacred items).' },
    { math: '4 · Power studied from the ground', note: 'Political anthropology: how order exists WITHOUT states (segmentary lineages, age-sets — Evans-Pritchard\'s "ordered anarchy"); Scott\'s everyday resistance (foot-dragging, evasion — "weapons of the weak"); and how people experience states, not just how states describe themselves.' },
  ],
};

const eapQuiz = {
  questions: [
