const ethnCfg = {
  steps: [
    { math: '1 · Participant observation', note: 'Live among the people you study, join what you can, watch everything — Malinowski\'s method (Trobriand Islands, 1914–18): learn the language, get the insider\'s view, record the ordinary.' },
    { math: '2 · The fieldwork contract', note: 'Long immersion (typically a year-plus to see a full cycle of activities), the fieldnotes discipline (write daily, everything), and the key informants who teach you — the craft\'s unhurried core.' },
    { math: '3 · Emic, etic, and reflexivity', note: 'Capture the insider view (emic), describe in comparative terms (etic), and own your position: your presence changes the field; your lens shapes what you see. Reflexivity (the 1980s turn) made bias visible instead of hidden.' },
    { math: '4 · Ethics: from Subjects to collaborators', note: 'Informed consent, anonymity, reciprocity — and the field\'s reckoning with its colonial origins (the Yanomami controversy as case study). Modern codes treat communities as partners with review rights, not laboratories.' },
  ],
};

