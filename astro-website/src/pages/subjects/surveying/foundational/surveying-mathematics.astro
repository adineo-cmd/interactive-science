---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const traverseCfg = {
  params: [
    { name: 'dist', label: 'leg length', min: 20, max: 200, step: 5, value: 100, unit: 'm' },
    { name: 'angerr', label: 'angle error per leg', min: 2, max: 30, step: 1, value: 10, unit: '″' },
    { name: 'legs', label: 'legs in traverse', min: 2, max: 12, step: 1, value: 6, unit: '' },
  ],
  readouts: [
    { label: 'angular misclosure (angerr × √legs)', expr: 'angerr*sqrt(legs)', unit: '″' },
    { label: 'position error at closure', expr: 'dist*angerr*sqrt(legs)/206265*legs', unit: 'm' },
  ],
};

const errorCfg = {
  steps: [
    { math: '1 · No measurement is exact', note: 'Every observation carries random error. Surveying is the science of knowing how much, and of which direction it averages out.' },
    { math: '2 · Systematic vs random', note: 'Systematic errors follow a rule (a tape too long, a collimation tilt) and can be corrected; random errors only average and must be managed statistically.' },
    { math: '3 · Blunders are a third category', note: 'Mistargeting, transcription slips — prevented by procedure (double-centring, closed traverses), not by statistics.' },
    { math: '4 · Errors propagate', note: 'Independent random errors add in quadrature: σ_result² = Σσᵢ². Angles over a long traverse wander with the square root of leg count, not the count.' },
    { math: '5 · Closures prove the work', note: 'A traverse that returns to its start reveals its own error — the closure is the surveyor\'s receipt, and it must balance before anyone adjusts.' },
  ],
};

const svTanEst = {
  "prompt": "A target 50 m away is observed at +30° elevation. How far does it stand above the instrument's line of sight, in metres?",
  "unit": "m",
  "answer": 28.87,
  "factor": 1.2,
  "why": "50 × tan(30°) ≈ 28.87 m — heights ride on vertical angles, corrected afterwards for instrument height and, over long sights, Earth curvature.",
  "context": "North-south is the cosine direction, east-west the sine — and elevation is the tangent's turn."
};

const svClassMatch = {
  "prompt": "Match each method to what it measures and fixes:",
  "pairs": [
    {
      "left": "triangulation",
      "right": "angles in triangles — one measured baseline, then the law of sines fixes every side"
    },
    {
      "left": "trilateration",
      "right": "measured distances — the mirror-image method, via the law of cosines"
    },
    {
      "left": "intersection",
      "right": "fixes an unreachable point from angles only"
    },
    {
      "left": "resection",
      "right": "standing at an unknown point, sighting three known ones — finding yourself"
    }
  ],
  "why": "Depth perception is triangulation on a two-eye baseline, and astronomers pushed the same method to the stars — a good angle measurement goes a very long way."
};

const svAngleCloze = {
  "text": "Bookkeeping discipline: bearings converted consistently, coordinates carried forward leg by leg, and the interior angles of a closed traverse must total (n − %%0%%) × %%1%%° — a failure there means something worse than arithmetic happened.",
  "answers": [
    [
      "2",
      "two"
    ],
    [
      "180"
    ]
  ],
  "hint": "A triangle closes with 180°; every extra side adds another 180°."
};

const svMiscEst = {
  "prompt": "Six traverse legs, each angle carrying 10 seconds of random error: the expected angular misclosure at closure is about how many seconds?",
  "unit": "seconds",
  "answer": 24.5,
  "factor": 1.2,
  "why": "10 × √6 ≈ 24.5″ — not 60 — because independent random errors partially cancel: roughly half the leg errors came back negative.",
  "context": "Shorten the legs at fixed leg count and the position error worsens: each angle error becomes position error proportional to leg length — long, well-conditioned legs beat many short ones."
};

const svRepTrace = {
  "prompt": "n repetitions of an angle reduce the random component by √n. Which curve is the random error against n?",
  "curves": [
    {
      "expr": "1/sqrt(x)",
      "color": "#1d4ed8",
      "label": "falling with the square root — quadrature"
    },
    {
      "expr": "1/x",
      "color": "#0f766e",
      "label": "falling in direct proportion to n"
    },
    {
      "expr": "0.85",
      "color": "#b42318",
      "label": "not falling at all — averaging is useless"
    }
  ],
  "correct": 0,
  "x": {
    "min": 1,
    "max": 64
  },
  "y": {
    "min": 0,
    "max": 1
  },
  "xlabel": "number of repetitions",
  "ylabel": "random error (relative)",
  "why": "Independent errors add in quadrature: σ_R² = σ_a² + σ_b², so totals grow with the square root of the contributors — and turning angles face-left and face-right also cancels systematic collimation, procedure and statistics cooperating in one habit."
};

const svPrecJudge = {
  "statements": [
    {
      "s": "Precision is repeatability; accuracy is closeness to truth.",
      "truth": true,
      "why": "They are different virtues — and a survey can have either without the other."
    },
    {
      "s": "A systematically short tape produces correct distances if you measure often enough.",
      "truth": false,
      "why": "The systematic error has the same sign every time — repeat it a thousand times and it never averages out."
    },
    {
      "s": "More decimal places mean a better survey.",
      "truth": false,
      "why": "The professional standard is a stated uncertainty that is defensible — the surveyor certifies how wrong the answer might be."
    }
  ]
};

const svCloseCompare = {
  "prompt": "The traverse returns to its start and the numbers disagree. Drag the divider:",
  "before": {
    "label": "a failing misclosure",
    "text": "stop and hunt the mistake — adjusting around a failed closure certifies an error instead of finding it"
  },
  "after": {
    "label": "a passing misclosure",
    "text": "distribute it honestly: angular spread equally among the angles, linear in proportion to leg length — the compass rule"
  },
  "why": "The closure is compared against the specification (a boundary traverse might be held to 1 part in 10,000) before anything is finalised — the surveyor's receipt."
};

const svGeoSpot = {
  "prompt": "One line of this geodesy brief is wrong — click it:",
  "lines": [
    "The Earth is modelled as an oblate ellipsoid — equatorial radius about 6,378 km, flattened by about 1 part in 298.",
    "Meridians converge, so grid azimuths must be corrected to true north.",
    "A conformal projection preserves distances everywhere, so UTM distances need no scale factor.",
    "Ellipsoidal heights come free from GNSS; engineering and law use orthometric heights relative to the geoid.",
    "The conversion is H = h − N, and the geoid undulates against the ellipsoid by tens of metres."
  ],
  "errorLine": 2,
  "correction": "A conformal projection preserves angles locally but imposes a small scale factor on distances — grid and ground differ by parts per hundred thousand, and professional work applies combined scale-and-height factors.",
  "why": "Flat-Earth arithmetic is not wrong — it is a local approximation, and the professional skill is knowing exactly where its validity ends."
};
---
<TopicPage slug="subjects/surveying/foundational/surveying-mathematics">

  <h2>Where you are, and what you will learn</h2>
  <p>
    This is an early lesson in Surveying. You need comfortable school trigonometry — sines,
    cosines, tangents and Pythagoras — and nothing else; every surveying-specific idea is
    built here. The subject is geometry with legal consequences: the positions it produces
    become property boundaries, construction references and maps, and people make expensive
    decisions on the answers.
  </p>
  <p>By the end you will be able to:</p>
  <ul>
    <li>turn a bearing and a distance into coordinate offsets with trigonometry, and say what every symbol in the calculation means;</li>
    <li>describe the classical methods — traversing, triangulation, trilateration, resection — and when each is the right tool;</li>
    <li>sort every surveying error into its correct category — blunder, systematic, random — and know which defence each one takes;</li>
    <li>predict how random errors combine (in quadrature) and why traverse misclosure grows with the square root of leg count;</li>
    <li>explain what a closure is, why a survey must check itself, and how the misclosure gets distributed honestly;</li>
    <li>name the three ways a round Earth corrects flat-Earth arithmetic: meridian convergence, projection scale factors, and the two kinds of height.</li>
  </ul>
  <p>
    One habit: every number in this subject is quoted with a defensible uncertainty. The
    computing is school trigonometry; the <em>knowing how wrong the answer might be</em> is
    the profession.
  </p>

  <h2>The problem that starts surveying: where exactly is "exactly"?</h2>
  <p>
    A crew must place a building corner exactly 43.267 m from a road monument at a bearing
    of 132°40′. Everything in that sentence is a surveyor's problem. The monument itself
    carries the accumulated error of the network that established it. The bearing is an
    angle measured against a reference direction that — as geodesy will show — depends on
    which "north" you mean. The distance will need correcting for slope, temperature and
    the map projection's scale factor. And the final coordinates will be quoted to the
    millimetre <em>with a stated uncertainty</em>. Three bodies of mathematics —
    trigonometry, error theory, geodesy — are what turn that sentence into a computation
    instead of a hope.
  </p>
  <p>
    Surveying's real discipline is the management of error. Every angle and every distance,
    no matter how good the instrument, is slightly wrong. The surveyor's craft is to measure
    <em>how</em> wrong the network is, arrange the geometry so errors average out rather
    than accumulate, prove the work with closures, and distribute the residuals honestly.
    The machinery below walks through that stack in order.
  </p>

  <Widget no="1" caption="errors: systematic, random, blunders — and propagation" widget="equationStep" config={errorCfg} />
  <p>
    <strong>What to notice:</strong> the five steps are the whole philosophy in miniature.
    Step 1 is the honest admission; steps 2 and 3 are the taxonomy — each kind of error has
    a <em>different</em> cure (correction for systematic, statistics for random, procedure
    for blunders); step 4 is the mathematics of accumulation; and step 5 is the receipt.
    Keep this card in mind through the rest of the lesson — every later section is one of
    these steps in detail.
  </p>

  <h2>Geometry and trigonometry: turning angles into positions</h2>
  <p>
    The surveyor's basic output is <strong>coordinates</strong> — eastings and northings
    (and elevations) for each point — and the engine that produces them is trigonometry.
    Two measurements dominate: <strong>distances</strong> (once by steel tape, now almost
    always by electronic distance measurement, EDM, which times light pulses to a prism to
    the millimetre) and <strong>angles</strong> (horizontal and vertical, measured by a
    total station). From an instrument station of known coordinates, one bearing and one
    distance fix the next point.
  </p>
  <p>
    Watch the arithmetic once, slowly. With azimuth 132°40′ (measured clockwise from north)
    and horizontal distance 43.267 m, the offsets are ΔN = 43.267 × cos(132°40′) ≈ −29.32 m
    and ΔE = 43.267 × sin(132°40′) ≈ +31.81 m. The cosines and sines of the bearing
    <em>are</em> the geometry: north-south is the cosine direction, east-west the sine.
    Repeating this leg after leg is a <strong>traverse</strong>, the backbone method of
    boundary and construction surveying. Heights ride along through vertical angles: a
    target 50 m away observed at +30° elevation stands 50 × tan(30°) ≈ 28.87 m above the
    instrument's line of sight — corrected afterwards for the instrument's own height and,
    over long sights, for Earth curvature (which is where geodesy starts intruding).
  </p>
  <Widget no="3" caption="call the height before the tangent does" widget="estimate" config={svTanEst} />
  <p>
    The classical repertoire extends the same trigonometry. <strong>Triangulation</strong>
    builds networks from measured angles in triangles: measure one baseline, then the law
    of sines fixes every side. The idea is older than instruments — your own depth
    perception is triangulation, your two eyes forming a short baseline — and it is how a
    crew measures a tree across a river without crossing: observe the direction to the tree
    from both ends of a measured baseline, and the triangle solves itself. (Astronomers
    widened the same method to the stars, which tells you how far a good angle measurement
    can be pushed.) <strong>Trilateration</strong> is the mirror-image method, building
    networks from measured distances with the law of cosines. <strong>Intersection</strong>
    fixes an unreachable point from angles only, and <strong>resection</strong> — standing
    at an unknown point and sighting three known ones — is the classic field trick for
    finding <em>yourself</em>.
  </p>
  <Widget no="4" caption="the classical repertoire — pair each method with its engine" widget="match" config={svClassMatch} />
  <p>
    Right-triangle checks never disappear from the toolkit. The 3-4-5 triangle (or any
    multiple) squares a corner without a theodolite. Grade percentages are trigonometry in
    disguise — a 5 per cent grade rises 5 m per 100 m, an angle of atan(0.05) ≈ 2.86°.
    Circular curve geometry ties chord lengths and arc lengths to radius (arc = radius ×
    central angle in radians). And the professional discipline is bookkeeping: bearings
    converted consistently between azimuths and quadrants, coordinates carried forward leg
    by leg, and angle sums checked against their theoretical totals — the interior angles
    of a closed traverse must total (n − 2) × 180°. That check is so routine that its
    failure is itself a diagnostic: something worse than arithmetic has happened.
  </p>
  <Widget no="5" caption="fill the angle-sum check" widget="cloze" config={svAngleCloze} />
  <p>
    <strong>So far:</strong> trigonometry converts angles and distances into coordinates.
    But every input is slightly wrong — so the real question is how wrong the output is.
  </p>

  <h2>Error and uncertainty: the surveyor's real mathematics</h2>
  <p>
    No measurement is exact, and surveying's contribution is the honest taxonomy. A
    <strong>blunder</strong> is a plain mistake: mistargeting a prism, transcribing a 4 as
    a 7, booking an angle against the wrong station. Statistics cannot fix blunders;
    procedure prevents them — double-centring observations, closing loops, independent
    checks, and the golden habit of computing <em>in the field</em> so a slip is caught
    while the crew is still standing there. A <strong>systematic error</strong> follows a
    rule and can be corrected: a steel tape calibrated 5 mm long adds 5 mm per measurement;
    a collimation tilt biases every zenith angle identically; EDMs demand atmospheric
    corrections; a level's line of sight demands equal-length sights. The systematic
    category is where instrument knowledge lives, and correcting it is a physics problem.
    <strong>Random error</strong> is what remains after both: small, equally likely in
    either direction, following the normal distribution — and it is managed statistically,
    never eliminated.
  </p>

  <Widget no="2" caption="traverse misclosure vs leg count, length and precision" widget="sliderLab" config={traverseCfg} />
  <p>
    <strong>What to notice:</strong> set the angle error to 10 seconds and walk the leg
    count up from 2 to 12. Six legs close with an expected angular misclosure of
    10 × √6 ≈ 24.5 seconds — not 60 — because independent random errors partially cancel:
    roughly half the leg errors came back negative. That square-root law is the most useful
    single fact in the field. Then shorten the legs at fixed leg count and watch the
    <em>position</em> error at closure worsen: each angle error turns into position error
    proportional to leg length, which is why long, well-conditioned legs beat many short
    ones.
  </p>
  <Widget no="6" caption="call the misclosure before the quadrature does" widget="estimate" config={svMiscEst} />
  <p>
    The rule behind the widget is that independent random errors add <strong>in
    quadrature</strong>. If result R = a + b with independent errors σ<sub>a</sub> and
    σ<sub>b</sub>, then σ<sub>R</sub>² = σ<sub>a</sub>² + σ<sub>b</sub>² — so the total
    grows with the <em>square root</em> of the number of contributors, not the count.
    Averaging repeated measurements buys precision the same way: n repetitions reduce the
    random component by √n. This is why instrument specifications quote angles to a
    standard such as DIN 18723, and why crews turn angles both face-left and face-right —
    which also cancels systematic collimation, procedure and statistics cooperating in a
    single habit.
  </p>
  <Widget no="7" caption="what does averaging buy? — which curve is real?" widget="trace" config={svRepTrace} />
  <p><em>Common misconception:</em> that precision and accuracy are the same, or that more
  decimal places mean a better survey. Precision is repeatability; accuracy is closeness to
  truth — a systematically short tape produces beautifully precise, confidently wrong
  distances. The professional standard is neither decimal decoration nor uncorrected
  repetition, but a stated uncertainty that is defensible: the surveyor certifies how wrong
  the answer might be, and the closure evidence is the receipt.</p>
  <Widget no="8" caption="true or false — precision, accuracy, decimals" widget="judge" config={svPrecJudge} />
  <p><em>Common misconception:</em> "a careful crew averages the errors away." Averaging
  — and quadrature, and face-left/face-right — only tames <em>random</em> error, which is
  equally likely in either direction. A systematic error has the same sign every time, so
  averaging two thousand observations of a short tape yields a very precise, very wrong
  length. The order of operations is fixed: correct the systematic errors by calibration
  and procedure <em>first</em>, then let statistics handle what remains.</p>

  <h2>Closures and adjustment: the surveyor's receipt</h2>
  <p>
    Because error is inevitable, honest surveys are designed to <strong>check
    themselves</strong>. A traverse closes on its starting point (or a second known point),
    a level loop returns to its start height, and the observed-versus-known difference —
    the <strong>misclosure</strong> — reveals the accumulated error before anything is
    finalised. The closure is compared against the specification (a boundary traverse might
    be held to a linear misclosure of 1 part in 10,000 or better; a precise levelling loop
    to millimetres per kilometre). A failure means find the blunder, not adjust around it.
  </p>
  <Widget no="9" caption="the closure verdict — two ways to respond, drag the divider" widget="compare" config={svCloseCompare} />
  <p>
    Passing, the misclosure is <strong>distributed</strong>. Classically, angular misclosure
    is spread equally among the angles (each angle is statistically identical), and linear
    misclosure is distributed among the coordinate differences in proportion to leg length —
    the <em>compass rule</em>. The professional gold standard is <strong>least-squares
    adjustment</strong>, which weights every observation by its estimated uncertainty and
    finds the unique set of corrections that minimises their weighted squares — yielding not
    just adjusted coordinates but rigorous error ellipses around every point. The closure
    logic scales from a two-hour field exercise to national coordinate frameworks: every
    rigorous position in the world is the adjusted outcome of networks designed to catch
    their own mistakes.
  </p>

  <h2>Geodesy basics: when the Earth stops being flat</h2>
  <p>
    Over short lines, flat-Earth arithmetic is fine; over hundreds of metres and more, the
    planet's shape enters the equations. The Earth is modelled as an <strong>oblate
    ellipsoid</strong> (equatorial radius about 6,378 km, flattened by about 1 part in 298 —
    the parameters of WGS84/GRS80 are the modern standard), and surveying mathematics
    inherits three consequences. First, <strong>meridians converge</strong>: lines of true
    north are not parallel, so a bearing measured against true north and one measured
    against the map grid differ by a convergence angle that grows east-west from the
    projection's central meridian — and grid azimuths must be corrected to true. Second,
    <strong>map projections trade distortion</strong>: a conformal projection (UTM zones,
    national state-plane systems) preserves angles locally but imposes a small scale factor
    on distances, so grid distance and ground distance differ by parts per hundred thousand
    and professional work applies combined scale-and-height factors when converting between
    ground, ellipsoid and grid. Third, <strong>heights are two different quantities</strong>:
    ellipsoidal heights come free from GNSS, measured against the mathematical ellipsoid,
    but engineering and law use orthometric heights relative to mean sea level — an
    equipotential surface called the <strong>geoid</strong>, which undulates by tens of
    metres against the ellipsoid. The conversion H = h − N (orthometric = ellipsoidal minus
    geoid separation) is a daily operation, which is why geoid models are maintained as
    carefully as the coordinate datums themselves.
  </p>
  <Widget no="10" caption="one line of the geodesy brief is wrong — click it" widget="spot-error" config={svGeoSpot} />
  <p><em>Common misconception:</em> "the Earth is so big that curvature cannot matter at
  surveying distances." It is true that a garden survey ignores the planet. But curvature
  enters sooner than intuition expects: over a 1 km sight the Earth's surface falls away by
  centimetres that a level can detect, and over the tens of kilometres of a control network
  meridian convergence and scale factors reach the millimetre tolerances that deeds and
  steel demand. Flat-Earth arithmetic is not wrong — it is a <em>local approximation</em>,
  and the professional skill is knowing exactly where its validity ends.</p>

  <h2>Check yourself</h2>
  <p>Try these before moving on. Feedback follows each answer.</p>
  <ol>
    <li>From a station at bearing 90° (due east) and distance 100 m, what are the coordinate offsets ΔN and ΔE?</li>
    <li>A prism pole is mistargeted on one leg of a twelve-leg traverse. Which category of error is this, and what is the cure?</li>
    <li>Why does a traverse of 12 legs close with an angular misclosure closer to 35 seconds than 120 seconds, if each leg's angle carries about 10 seconds of random error?</li>
    <li>A GNSS receiver reports an ellipsoidal height of 42.000 m, and the geoid separation N at that location is −34.5 m. What is the orthometric height a builder would use?</li>
  </ol>
  <p>
    <strong>Feedback:</strong> (1) ΔN = 100 × cos(90°) = 0; ΔE = 100 × sin(90°) = 100 m —
    due east is all sine, no cosine, a useful limiting case for remembering which is which.
    (2) A blunder. Statistics cannot fix it and averaging cannot hide it; the cures are
    procedural — independent checks, closing the traverse, field computations — and the
    closure would expose it. (3) Quadrature: 10 × √12 ≈ 34.6 seconds. Independent random
    errors partially cancel, so the total grows with the square root of the count, not the
    count. (4) H = h − N = 42.000 − (−34.5) = 76.5 m. Watch the double negative — geoid
    separations can be negative, which is exactly why the conversion is a formula rather
    than an intuition.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>Trigonometry is the engine: bearing × distance gives coordinate offsets; vertical angles give heights; triangles built from one baseline give whole networks.</li>
    <li>Three kinds of error, three cures: blunders are prevented by procedure, systematic errors corrected by calibration, random errors managed by statistics.</li>
    <li>Independent random errors add in quadrature — totals grow with √n, and n repetitions improve precision by √n.</li>
    <li>Averaging never fixes a systematic error; correct the rule-following errors first, then let statistics work.</li>
    <li>A survey must check itself: closures expose the misclosure, and only a passing misclosure is distributed (compass rule, or least squares with error ellipses).</li>
    <li>Geodesy supplies three flat-Earth corrections: meridian convergence, projection scale factors, and the geoid conversion H = h − N.</li>
    <li>The professional output is not a number but a number with a defensible uncertainty.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    The three pillars here — trigonometry, error theory, geodesy — each grow into their own
    later lesson. Distance measurement and total-station work extend the trigonometry into
    instrument practice; adjustment computations develop least squares and error ellipses
    properly; GNSS and control surveying turn the geodesy into satellite positioning and
    datum work. The closure habit you met here — design the work so it proves itself — is
    the thread that runs through all of them.
  </p>

  <h2>Going deeper</h2>
  <p>
    A short worked passage shows least-squares adjustment earning its reputation over the
    compass rule. Suppose a small loop levels between four benchmarks, with observed height
    differences carrying unequal weights — a 2 km leg of careful levelling (standard
    deviation, say, 4 mm) and a 0.5 km leg through difficult ground (5 mm). The naive fix
    distributes the loop's 9 mm misclosure in proportion to distance; the least-squares fix
    distributes it in proportion to <em>variance</em>, so the statistically weaker
    observation absorbs more correction — and the same computation yields, as a by-product,
    the covariance matrix of the adjusted heights: an <strong>error ellipse</strong> (in
    plan networks, literally an ellipse) around every point, with axes stating how many
    millimetres the position might plausibly err in any direction. The ellipse is the
    profession's unit of honesty: boundary corners are certified to it, construction
    tolerances are set against it, and network design — adding which observations would
    shrink which ellipses — is optimisation on top of it. Surveying's deepest claim is
    exactly this: not that its numbers are perfect, but that its uncertainty is
    <em>engineered and stated</em>.
  </p>
  <p>
    GNSS quietly rewrote the geodesy lesson for practice. A rover receiving satellite
    signals computes on the global ellipsoid directly, and real-time kinematic (RTK)
    techniques deliver centimetre-level positions in seconds — but the positions are only
    as good as the datum they are expressed in (WGS84 as broadcast, national realisations
    like NAD83 or ETRS89 for legal work), and heights still demand the geoid model. The
    modern surveyor therefore computes on a curved reference ellipsoid with the flat-Earth
    version as a consciously chosen local approximation. Deeper still lie the field's open
    edges: rigorous least-squares network design, atmospheric error modelling for GNSS
    (ionosphere, troposphere, multipath), time-dependent datums as plate tectonics drifts
    continents centimetres per year — because in a profession whose outputs become deeds
    and steel, the mathematics of "how wrong might this be?" is not an appendix to the
    answer. It is the answer.
  </p>

  <p class="sources"><strong>Sources:</strong> NCEES FS exam specifications; Ghilani &amp; Wolf, <em>Elementary Surveying</em>; Buckner, <em>Surveying Computations</em>. Source text: OpenStax (https://openstax.org), CC BY 4.0 — adapted for Interactive Atlas.</p>
</TopicPage>
