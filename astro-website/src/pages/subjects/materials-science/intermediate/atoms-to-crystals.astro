import Widget from '../../../../components/Widget.astro';

const atomsCfg = {
  steps: [
    { math: '1 · Bonding decides everything', note: 'Metallic (electron sea — conductive, ductile), ionic (transfer, brittle, hard), covalent (shared, strong, directional — diamond), van der Waals (weak — gecko feet, graphite layers sliding). The property tables of the materials lesson all trace back to these four bonds.' },
    { math: '2 · Lattices: the 14 ways to stack', note: 'Crystals repeat in unit cells — 14 Bravais lattices covering every symmetry in nature. Most metals choose the efficient ones (FCC, HCP — ~74% packing); the choice foretells ductility (FCC has slip planes) or brittleness.' },
    { math: '3 · Imperfections make materials useful', note: 'Perfect crystals would be weak in strange ways — real strength, conductivity and hardness come from defects: vacancies (diffusion), dislocations (metal ductility — a line defect that lets planes slip one row at a time), grain boundaries (barriers that strengthen — smaller grains, more strength: the Hall–Petch relation).' },
    { math: '4 · Crystalline vs amorphous vs polycrystalline', note: 'Single crystal (turbine blades — no boundaries to creep), polycrystalline (most engineering metals — grains held by boundaries), amorphous (glass — frozen liquid, no order: transparent because nothing scatters light uniformly, brittle because no slip planes).' },
  ],
};
---
<TopicPage slug="subjects/materials-science/intermediate/atoms-to-crystals">
  <h2>The idea</h2>
  <p>
    "Structure determines properties" — and structure starts at the atom: <strong>bonding type
    sets the ceiling, crystal packing sets the mechanics, and defects — counterintuitively —
    deliver the behaviour engineers actually use</strong>. Perfect crystals are a laboratory
    curiosity; useful materials are organised imperfection.
  </p>

  <Widget no="1" caption="bonds, lattices, the defect gift, order levels" widget="equationStep" config={atomsCfg} />

  <h2>The defect logic, applied</h2>
  <ul>
    <li><strong>Dislocations explain the metal mystery:</strong> why copper bends and ceramic shatters — dislocations move in metals (planes slip cheaply, one row at a time), cannot in ionic/covalent crystals (wrong charge or direction blocks the step). Alloying and work-hardening pin dislocations: that is literally why bronze beat copper and hammered metal hardens.</li>
    <li><strong>Doping is defect engineering (the coming lesson):</strong> one phosphorus atom per million silicon atoms changes conductivity by orders of magnitude — the semiconductor industry is the deliberate-manufacture of point defects.</li>
    <li><strong>Single-crystal turbine blades:</strong> grown as one grain (directional solidification) — creep at jet-engine temperatures happens at boundaries, so the boundary was eliminated. Materials engineering as sculpture: choose your defects.</li>
    <li><strong>Diffusion powers processing:</strong> vacancies let atoms wander — carburising steel, sintering ceramics, doping chips: all are temperature-scheduled diffusion (the Arrhenius kinetics lesson, running the factory).</li>
  </ul>
  <p class="sources"><strong>Sources:</strong> Callister & Rethwisch; Ashby; the chemistry ladder\'s bonding lesson and the physics ladder\'s solid-state lesson.</p>
</TopicPage>
