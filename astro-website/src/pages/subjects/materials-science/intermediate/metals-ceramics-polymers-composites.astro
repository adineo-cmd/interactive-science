const familiesCfg = {
  steps: [
    { math: '1 · Metals: the ductile workhorse', note: 'Electron sea → conductive, ductile, tough (bends before breaking — the dislocation lesson). Strengthenable four ways (alloy, work, grain-size, precipitation). Recyclable near-infinitely (the circular-economy lesson\'s star). The default structural material since the Bronze Age.' },
    { math: '2 · Ceramics: hard, hot, brittle', note: 'Ionic/covalent bonds → highest hardness and melting points, chemically inert, electrically insulating — but no dislocation motion, so no plasticity: strong in compression, catastrophic in tension. Champions of extreme environments (engine blades with coatings, tiles on the Shuttle).' },
    { math: '3 · Polymers: chains with personalities', note: 'Long molecules (the chemistry lesson) → lightweight, formable, insulating; properties set by chain length, branching, cross-linking and temperature (glass transition: the same plastic is rigid at room temperature and rubbery above Tg — the winter-cracked dashboard).' },
    { math: '4 · Composites: engineered synergy', note: 'Strong fibres (glass, carbon) in a tough matrix (polymer, metal, ceramic) — each covers the other\'s weakness. Anisotropic by design (strength where you point the fibres — the load-path lesson, written in fibre orientation). Wood and bone are natural composites; the A350 is 53% composite by weight.' },
  ],
};
