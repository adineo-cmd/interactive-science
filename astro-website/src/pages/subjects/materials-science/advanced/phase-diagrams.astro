const pdCementiteEstimate = {
  "prompt": "A 0.76% C alloy cools through the eutectoid: ferrite holds 0.022% C, cementite holds 6.7% C. Roughly what fraction of the final pearlite is cementite?",
  "unit": "% cementite",
  "answer": 11,
  "factor": 2,
  "why": "f(cementite) = (0.76 − 0.022)/(6.7 − 0.022) ≈ 0.11 — about 11% hard carbide in a soft iron matrix. That proportion, and its fineness of dispersion, is most of what the words \"steel grade\" mean.",
  "context": "Mass check from the worked example: 0.6 × 70 + 0.4 × 20 = 50 — the seesaw always balances."
};

const pdEutecticPlace = {
