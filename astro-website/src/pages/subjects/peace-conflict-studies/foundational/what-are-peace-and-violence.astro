const galtungCfg = {
  steps: [
    { math: '1 · Negative peace', note: 'The absence of direct violence — shooting stops. Necessary, insufficient: ceasefires freeze conflicts as often as they end them.' },
    { math: '2 · Positive peace', note: 'The presence of justice and functioning institutions — the conditions under which violence is unlikely, not merely absent.' },
    { math: '3 · Direct violence', note: 'Identifiable actor, identifiable harm: war, assault, murder. The most visible form — and the least common in scale.' },
    { math: '4 · Structural violence', note: 'Harm built into arrangements: preventable disease from no clinics, starvation amid plenty. No shooter needed; a life shortened anyway (Galtung, 1969).' },
    { math: '5 · Cultural violence', note: 'The stories and symbols that make structural violence look normal or deserved — the legitimating layer of the pyramid.' },
  ],
};
