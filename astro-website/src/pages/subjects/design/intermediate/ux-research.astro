const uxrCfg = {
  steps: [
    { math: '1 · Ask the question that answers a decision', note: 'The data lesson\'s rule first: research serves a pending decision (pricing page redesign? onboarding?), not curiosity alone. Method follows question — never the reverse.' },
    { math: '2 · Interviews: behaviour, not opinions', note: '"Tell me about the last time you…" — past behaviour is data, predictions are noise (the innovation-lesson wisdom). The 5-why ladder digs from feature requests to underlying needs; the customer-development lesson\'s questioning discipline.' },
    { math: '3 · Usability testing: five users, real tasks', note: 'Nielsen\'s finding: ~5 participants find ~85% of severe issues — small, fast, iterative beats large and slow. Give tasks (not instructions), stay silent, watch the struggle: where users hesitate IS the finding (the A/B lesson\'s qualitative sibling).' },
    { math: '4 · Triangulate honestly', note: 'What people SAY (interviews), what they DO (analytics, session recordings), what they CHOOSE (A/B tests) — the three sources disagree regularly, and each disagreement is a finding (the statistics lesson\'s convergent evidence discipline).' },
  ],
};

const uxrQuizCfg = {
  questions: [
    {
      q: 'A user says: "You should add an export button." The professional move is:',
      choices: [
        'Add the button — customers know best',
        'Ask "tell me about the last time you needed to get data out" — dig from the feature request to the underlying situation and need, which may suggest a different (better) design',
        'Add three buttons',
        'Ignore all user feedback',
      ],
      answer: 1,
      why: 'Users are experts on their problems and unreliable as designers (the Mom Test\'s core rule). The request is a pointer to a need — the job beneath it may be solved by something they would never think to ask for. Collect problems; design solutions.',
    },
    {
      q: 'Why does ~5 participants find most usability problems, when surveys need hundreds?',
      choices: [
        'Usability problems are rare',
        'Problem discovery is about repetition of SHARED failures, not opinion sampling: the first user reveals ~31%, each new user adds diminishing returns — so a few users surface the common issues, and the right move is iterating five at a time, not testing fifty once',
        'Participants share answers',
        'Statistics do not apply to design',
      ],
      answer: 1,
      why: 'The Nielsen–Landauer model: each user independently reveals about a third of the fixable problems, so discovery saturates fast — five users catch the bulk of what matters (with real-world variance; a later iteration catches what design changes exposed). Small, fast, repeated beats large, slow, once.',
    },
    {
      q: 'In a usability session, the facilitator\'s hardest discipline is:',
      choices: [
        'Explaining the design so the task is fair',
        'Silence — give tasks, not instructions, and let the user struggle, because hesitation and self-correction are the findings; help converts a test into a demo',
        'Talking constantly to put them at ease',
        'Testing only happy paths',
      ],
      answer: 1,
      why: 'The moment the facilitator helps, you learn whether YOUR explanation works, not whether the DESIGN does. The data is in the hesitation, the wrong menu, the backtracked click — which is why sessions are recorded, and why facilitators train to shut up professionally.',
    },
    {
      q: 'Interviews say a feature is loved; analytics show nobody uses it. The triangulation reading is:',
      choices: [
        'Interviews were lies — discard them',
        'A finding in itself: attitudes and behaviour have diverged (social politeness, memory bias, or the feature is loved but not needed) — investigate WHY the gap exists rather than trusting either source alone',
        'Analytics must be broken',
        'Average the two answers',
      ],
      answer: 1,
      why: 'What people say, do and choose are three different measurements of three partly different things. Disagreement between sources is not noise to average away — it is usually the most informative data point in the study, pointing at exactly the assumption worth testing next.',
    },
  ],
};

