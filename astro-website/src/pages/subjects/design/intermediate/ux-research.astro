const uxrCfg = {
  steps: [
    { math: '1 · Ask the question that answers a decision', note: 'The data lesson\'s rule first: research serves a pending decision (pricing page redesign? onboarding?), not curiosity alone. Method follows question — never the reverse.' },
    { math: '2 · Interviews: behaviour, not opinions', note: '"Tell me about the last time you…" — past behaviour is data, predictions are noise (the innovation-lesson wisdom). The 5-why ladder digs from feature requests to underlying needs; the customer-development lesson\'s questioning discipline.' },
    { math: '3 · Usability testing: five users, real tasks', note: 'Nielsen\'s finding: ~5 participants find ~85% of severe issues — small, fast, iterative beats large and slow. Give tasks (not instructions), stay silent, watch the struggle: where users hesitate IS the finding (the A/B lesson\'s qualitative sibling).' },
    { math: '4 · Triangulate honestly', note: 'What people SAY (interviews), what they DO (analytics, session recordings), what they CHOOSE (A/B tests) — the three sources disagree regularly, and each disagreement is a finding (the statistics lesson\'s convergent evidence discipline).' },
  ],
};
