import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const ixdCfg = {
  steps: [
    { math: '1 · States are the design', note: 'Default, hover, focus, active, loading, empty, error, disabled — a component is fully designed only when every state is. The design lesson\'s "never let a click land in silence" generalises: every input the user can give has a designed answer.' },
    { math: '2 · Affordances and signifiers', note: 'Norman: affordances are possible actions; signifiers make them visible (the flat-design era hid buttons — signifiers regressed). Every interactive element should look like what it is before anyone touches it.' },
    { math: '3 · Flows, not screens', note: 'Users experience sequences (the wireframe lesson\'s journeys): decisions branch, errors loop back, success states close. Flow design is the screen-by-screen choreography — flowcharts ARE the interaction design (the form lesson\'s structure, interactive).' },
    { math: '4 · Motion with meaning', note: 'Animation explains change (where did that panel come from?), shows relationships (shared-element transitions), confirms action (buttons that respond) — 200–300 ms, purposeful; motion as decoration is the design lesson\'s clutter principle with a timeline.' },
  ],
};
---
<TopicPage slug="subjects/design/advanced/interaction-design">
  <h2>The idea</h2>
  <p>
    Interaction design is <strong>design across time</strong> — states, flows, feedback and
    motion: the grammar of response. The visual lessons decide how it looks; this lesson decides
    how it behaves.
  </p>

  <Widget no="1" caption="states, signifiers, flows, meaningful motion" widget="equationStep" config={ixdCfg} />

  <h2>Interaction principles in practice</h2>
  <ul>
    <li><strong>Direct manipulation wins:</strong> drag instead of coordinate-entry, pinch to zoom — the closer the interface to the action, the less it must be learned (touch\'s triumph was gestural directness — the Fitts lesson\'s world, concretised).</li>
    <li><strong>Undo beats confirmation:</strong> confirm dialogs interrupt everyone to catch rare mistakes; undo lets action stay fast and recovery cheap (Gmail\'s 30-second undo is the canonical resolution — the safety lesson\'s fail-soft, at UI scale).</li>
    <li><strong>Progressive disclosure:</strong> advanced options hidden until needed (the wizards-vs-experts trade) — complexity is a cost users pay on demand, not upfront.</li>
    <li><strong>Latency is the invisible design:</strong> 100 ms feels instant, 1 s breaks flow, 10 s loses the user (Nielsen\'s thresholds) — performance is an interaction property, owned jointly with engineering (the systems lesson\'s budgeting).</li>
  </ul>
  <p class="sources"><strong>Sources:</strong> Norman, The Design of Everyday Things; Nielsen\'s 10 heuristics; the design and Fitts lessons.</p>
</TopicPage>
