---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const behavCfg = {
  steps: [
    { math: '1 · Anchoring', note: 'Random number shown before an estimate drags the estimate toward it — even judges rolling dice (Tversky & Kahneman). First numbers set the range of the argument.' },
    { math: '2 · Loss aversion', note: 'Losses hurt about 2× as much as equivalent gains feel good. Explains the endowment effect, insurance buying, sunk-cost stubbornness, and why "don\'t lose your discount" outperforms "gain one".' },
    { math: '3 · Present bias', note: 'We discount the future steeply — saving, exercising and studying lose to immediate rewards. Hyperbolic discounting models it; commitment devices (locked savings accounts) fight it.' },
    { math: '4 · Nudges: the applied payoff', note: 'Thaler & Sunstein\'s "choice architecture": auto-enrolment raised UK pension participation from ~40% to ~85%+ — default settings are policy. The Nobel 2017 crowned the program.' },
  ],
};

const beBiasSort = {
  "prompt": "Which bias drives each behaviour?",
  "buckets": [
    "anchoring",
    "loss aversion",
    "present bias"
  ],
  "items": [
    {
      "label": "a judge's sentence is harsher after rolling a high number",
      "bucket": 0
    },
    {
      "label": "'was £60, now £39' makes the deal feel like a win",
      "bucket": 0
    },
    {
      "label": "a shopper won't sell a mug for £5 but won't buy one for £5",
      "bucket": 1
    },
    {
      "label": "the same person buys insurance and a lottery ticket",
      "bucket": 1
    },
    {
      "label": "a saver takes £100 today over £110 tomorrow",
      "bucket": 2
    },
    {
      "label": "a student vows to save, then spends the money on a night out",
      "bucket": 2
    }
  ],
  "why": "All three are directional and predictable: first numbers drag estimates, losses loom larger than gains, and the present is discounted steeply."
};

const bePainEst = {
  "prompt": "In Prelec and Simester's MIT auction, credit-card users bid up to roughly twice as much as cash payers for the same basketball tickets. By what percentage did their bids run higher?",
  "unit": "%",
  "answer": 100,
  "factor": 1.5,
  "why": "Twice as much is 100% higher. Plastic decouples purchase from payment, dulling the pain of paying.",
  "context": "the tickets were identical; only the payment method changed"
};

const beFourfoldBranch = {
  "root": "A certain loss of £800, or an 85% chance of losing £1,000. Then the same choice in gains. Trace what prospect theory predicts.",
  "nodes": {
    "start": {
      "text": "Which do most people choose for the loss?",
      "choices": [
        {
          "label": "Gamble on the 85% chance of losing £1,000",
          "next": "loss",
          "feedback": "Yes — over likely losses, people become risk-seeking."
        },
        {
          "label": "Take the certain £800 loss",
          "next": "sure",
          "feedback": "That is what a risk-averse expected-utility maximiser would do; most people gamble here."
        }
      ]
    },
    "loss": {
      "text": "Now flip the sign: a sure £800 gain, or an 85% chance of £1,000?",
      "choices": [
        {
          "label": "Take the sure £800",
          "next": "gain",
          "feedback": "Yes — over likely gains, the same person turns cautious."
        },
        {
          "label": "Gamble for £1,000",
          "next": "gamble",
          "feedback": "Most take the sure gain; the risk-seeking is reserved for losses."
        }
      ]
    },
    "gain": {
      "text": "One curve predicts both: risk-averse over likely gains, risk-seeking over likely losses. That fourfold pattern is why the same person buys insurance and lottery tickets."
    },
    "sure": {
      "text": "Standard risk aversion would take the certain loss, but the evidence says most people gamble to avoid it.",
      "choices": [
        {
          "label": "Follow the loss choice",
          "next": "loss",
          "feedback": "Risk-seeking over likely losses."
        }
      ]
    },
    "gamble": {
      "text": "Most people take the sure gain in the gain frame; the pattern flips with the sign.",
      "choices": [
        {
          "label": "See the pattern",
          "next": "gain",
          "feedback": "One curve, two signs."
        }
      ]
    }
  },
  "why": "Loss aversion is defined relative to a reference point; the fourfold pattern flips risk attitude with the sign and likelihood, which plain risk aversion cannot predict."
};

const bePresentCloze = {
  "text": "People take £100 today over £110 tomorrow, yet happily wait a year for the extra £10 — a pattern called %%0%% discounting. It makes preferences time-%%1%%, so the morning's planner and tonight's %%2%% disagree. Commitment devices and defaults bind the doer to the planner's intention.",
  "answers": [
    [
      "hyperbolic"
    ],
    [
      "inconsistent"
    ],
    [
      "doer"
    ]
  ],
  "hint": "Patience depends on distance from the present; the planner makes the plan, the doer spends the money."
};

const beUltimatumSpot = {
  "prompt": "Find the line where the ultimatum-game reasoning goes wrong:",
  "lines": [
    "A proposer splits £10 and offers the responder £2.",
    "The responder rejects the offer, so both players get nothing.",
    "Because rejection destroys value, it proves the responder is simply irrational.",
    "Across experiments, offers below about 30% are routinely rejected.",
    "That costly punishment is a stable social preference, predictable enough to model."
  ],
  "errorLine": 2,
  "correction": "Rejection is costly but predictable: responders punish unfair splits, and that preference is stable enough to model.",
  "why": "Behavioural economics widened what maximisation is over; it did not abolish rationality."
};

const bePlanningPlace = {
  "prompt": "Flyvbjerg's sample found rail projects overran budgets by around what percentage on average? Place it.",
  "labels": [
    "0%",
    "25%",
    "50%",
    "75%",
    "100%"
  ],
  "scale": {
    "min": 0,
    "max": 100
  },
  "answer": 45,
  "tolerance": 3,
  "why": "Rail averaged about 45% over budget and roads about 20%. Reference-class forecasting uses that outside record instead of the project's special story."
};

const beSunkOrder = {
  "prompt": "A near-empty flight is about to leave. Put the marginal argument for selling a standby seat in order:",
  "items": [
    "The flight is already going, so its fixed costs are sunk",
    "The marginal cost of one more passenger is about £20 in fuel, catering and fees",
    "A standby fare of £40 adds £20 of contribution",
    "Average cost per seat (£400) is irrelevant to this decision",
    "Automating the sale down to the marginal margin captures the gain"
  ],
  "why": "Only forward-looking costs and benefits matter; anchoring on average cost refuses a sale that adds £20."
};

const bePriceMatch = {
  "prompt": "Pair each pricing tactic with its mechanism:",
  "pairs": [
    {
      "left": "charm price",
      "right": "£39 outsells £34 because the left digit dominates"
    },
    {
      "left": "reference price",
      "right": "'was £60, now £39' makes the deal feel like a gain"
    },
    {
      "left": "decoy effect",
      "right": "a dominated print-only option pushes buyers to print-plus-web"
    },
    {
      "left": "fairness constraint",
      "right": "snowstorm shovel price rises are judged unfair, and customers retaliate"
    }
  ],
  "why": "Each works on the reference point, the comparison set or the norm — which is why regulators police fake 'was' prices."
};

const beMarketsCompare = {
  "prompt": "Where competition cures bias, and where it amplifies it — drag the divider:",
  "before": {
    "label": "product markets",
    "text": "fast feedback and personal consequences: a supermarket that systematically misprices bread loses customers, so biases are disciplined"
  },
  "after": {
    "label": "asset markets",
    "text": "delayed, social feedback: traders told the fundamental value still bubble and crash, so biases are amplified"
  },
  "why": "The same brains behave differently by environment; that asymmetry is why policy attention has shifted toward financial stability."
};

const beReplicationJudge = {
  "statements": [
    {
      "s": "Many early social-priming findings failed to replicate, and the field responded with pre-registration and larger samples.",
      "truth": true,
      "why": "The Open Science Collaboration reproduced under half of 100 psychology studies, forcing a methodological reset."
    },
    {
      "s": "The sturdiest behavioural results — loss aversion, present bias, default effects — did not survive replication scrutiny.",
      "truth": false,
      "why": "They did survive, which is precisely why they anchor this lesson."
    },
    {
      "s": "Expertise debiases specific, practised decisions rather than the decision-maker in general.",
      "truth": true,
      "why": "List's card traders learned their market; the same people still show biases on unfamiliar choices."
    },
    {
      "s": "A striking single experiment should be trusted until someone bothers to replicate it.",
      "truth": false,
      "why": "The replication reckoning says the opposite: ask whether it has replicated, at scale, out of the lab."
    }
  ]
};
---
<TopicPage slug="subjects/economics/advanced/behavioural-economics">
  <h2>Where you are, and what you will learn</h2>
  <p>
    This lesson closes the economics sequence by putting its central character on trial: the
    consistent maximiser you met in Supply and Demand and Money and Inflation. The
    intermediate lessons — GDP &amp; National Accounts, Unemployment &amp; Labour Markets,
    Market Failure &amp; Externalities and Monetary Policy &amp; Central Banks — built models
    on the assumption that decisions are internally consistent. Here that assumption meets
    the evidence: the same households, workers and firms reappear with their actual psychology
    attached.
  </p>
  <p>By the end you will be able to:</p>
  <ul>
    <li>explain why predictable, directional errors can be modelled and corrected where random ones cannot;</li>
    <li>apply anchoring, loss aversion, present bias and mental accounting to saving, spending and wage decisions;</li>
    <li>use marginal reasoning to defeat sunk-cost escalation, and reference-class forecasting to tame planning fallacy;</li>
    <li>analyse how charm prices, reference prices, decoys and fairness limits shape revenue;</li>
    <li>judge when market experience debias decisions and when it amplifies them into bubbles.</li>
  </ul>

  <h2>The idea</h2>
  <p>
    Classical economics runs on <em>homo economicus</em>: a consistent maximiser with stable
    preferences, perfect foresight and unlimited arithmetic. Behavioural economics tests that
    model against real humans — with laboratory experiments, field data and payroll records —
    and finds that people are not randomly wrong but <strong>predictably irrational</strong>:
    the errors have direction, and direction means they can be modelled, predicted and
    corrected by design. Daniel Kahneman and Amos Tversky's prospect theory (1979, Nobel 2002)
    supplied the founding engine; Richard Thaler (Nobel 2017) spent forty years finding where
    it shows up in cash registers, retirement plans and negotiating tables. The point of this
    lesson is that the unit's decision-makers — banks, households, workers, firms and markets —
    are all run by brains with the same systematic quirks, so the quirks show up in the
    aggregates: in savings rates, in wage stickiness, in the prices you see.
  </p>

  <Widget no="1" caption="the four heuristics every economist now checks for" widget="equationStep" config={behavCfg} />
  <p>
    <strong>What to notice:</strong> the panel lists the four results in the order this lesson
    deploys them. Read step 2 against the theatre-ticket and commitment-account examples that
    follow: loss aversion is a claim about how outcomes are <em>framed</em> — relative to a
    reference point, not to final wealth — and that framing is what makes it more than a
    taste for safety. Treat step 4 as the payoff question of the whole lesson: if defaults are
    policy, then whoever writes the default is doing economics whether or not they admit it.
  </p>
  <p>
    <strong>So far:</strong> the rational maximiser is a model, not a person — and the
    deviations from it have structure. Next we follow that structure into the three arenas
    the intermediate lessons tracked with standard models: households, workers and firms.
  </p>
  <Widget no="2" caption="which bias drives each behaviour?" widget="sort-buckets" config={beBiasSort} />

  <h2>Money and banking: mental accounting and the pain of paying</h2>
  <p>
    Classical theory says money is fungible — a pound is a pound wherever it sits. Real
    households keep it in labelled mental buckets. Thaler's classic scenario: you bought a
    10-pound theatre ticket and lose it on the way. Do you buy another? Most say no. But if you
    <em>lose a 10-pound note</em> on the same walk, most buy the ticket anyway — although the
    balance sheet is identical in both cases. The ticket loss was booked to the "entertainment"
    account, which now feels exhausted; the cash loss was booked to "general funds". Similar
    arithmetic runs through banking: tax refunds get spent more freely than salary (windfall
    accounts), small gains get gambled away more readily than earned income (the house-money
    effect), and separately there is the <strong>pain of paying</strong> — in Prelec and
    Simester's MIT auction, the same basketball tickets drew up to roughly double the bids from
    credit-card users than from those paying cash, because plastic decouples purchase from
    payment. Banks and shops know all of this: "save the change" round-up products, separate
    savings pots with names, and one-click payments are all choice architecture built on
    mental accounting. Even wages obey nominal framing — workers evaluate pay by the number on
    the payslip rather than its purchasing power, which is why inflation feels like the
    least-painful way for an economy to cut real wages.
  </p>
  <Widget no="3" caption="call the price of plastic" widget="estimate" config={bePainEst} />
  <p>
    <em>Common misconception:</em> "loss aversion just means people are risk-averse." It does
    not — and the difference is diagnostic. Loss aversion says losses hurt roughly twice as
    much as equal gains please. Over <em>gains</em> people are indeed cautious, but over
    <em>losses</em> they become risk-<em>seeking</em>: offered a certain loss of 800 or an 85
    per cent chance of losing 1,000, most gamble — the same coin that buys insurance also buys
    lottery tickets. Prospect theory's fourfold pattern (risk-averse over likely gains and
    unlikely losses, risk-seeking over unlikely gains and likely losses) predicts both
    behaviours from one curve; plain risk aversion predicts neither.
  </p>
  <Widget no="4" caption="one curve, two signs — trace the fourfold pattern" widget="branch" config={beFourfoldBranch} />

  <h2>Households: present bias and the planner–doer war</h2>
  <p>
    The standard model discounts the future at one constant exponential rate, which implies
    your preferences are time-consistent: the plan you make today is the plan you will follow.
    Humans are not like this. Offer 100 today or 110 tomorrow and most take the 100 (an implied
    discount rate of thousands of per cent per year); offer 100 in 365 days or 110 in 366 and
    the same people calmly wait for the 110. Patience is a function of distance from the
    present — <strong>hyperbolic discounting</strong> — and it explains the planner–doer war
    inside every household: tonight's doer eats the biscuit the morning's planner swore off,
    swipes the card the budget forbade, and defers the pension contribution. The policy
    discovery is that commitment devices work because they bind the doer to the planner: in
    Ashraf, Karlan and Yin's Philippine SEED accounts (2006), customers who chose an account
    they could not touch until a goal or date saw savings rise by 81 percentage points after
    twelve months. And the biggest behavioural policy of the century is simply a default:
    Britain's pension auto-enrolment (2012) flipped the choice from "opt in" to "opt out" and
    lifted private-sector participation from around 40 per cent to about 85 per cent — no
    subsidy, no compulsion, just re-pointing the path of least resistance.
  </p>
  <Widget no="5" caption="fill the blanks — the planner and the doer" widget="cloze" config={bePresentCloze} />
  <p>
    <strong>So far:</strong> households misfile money into labelled buckets and mis-discount
    time, and commitment devices and defaults can re-point both errors. That raises the
    standard model's sharpest prediction — wages should fall until unemployment clears — which
    the next section tests against how labour markets actually behave.
  </p>

  <h2>Workers: fairness, effort and the gift exchange</h2>
  <p>
    Labour markets refuse to clear the way the textbook says because they run on fairness. The
    <strong>ultimatum game</strong> is the cleanest evidence: one player proposes a split of a
    real cash sum; the other accepts (both paid) or rejects (both get zero). Pure
    self-interest predicts offers of one penny accepted always; in practice offers cluster near
    40–50 per cent and offers below about 30 per cent are routinely rejected — people pay real
    money to punish unfairness. In employment this becomes Akerlof's <strong>gift
    exchange</strong> (1982): firms pay above the market wage and workers reciprocate with
    effort above the contractual minimum, a loop confirmed in Fehr's laboratory labour markets.
    It also explains one of macroeconomics' stubborn facts — <strong>downward nominal wage
    rigidity</strong>. Truman Bewley's interviews (1999) found managers avoid pay cuts even in
    recessions because the morale damage to the workers who <em>remain</em> costs more than the
    savings, so firms lay people off instead: wages rarely fall, employment does. The
    implication runs straight through the unit — unemployment is partly a fairness phenomenon,
    not just a supply-demand imbalance.
  </p>
  <Widget no="6" caption="find the ultimatum-game slip" widget="spot-error" config={beUltimatumSpot} />
  <p>
    <em>Common misconception:</em> "ultimatum-game rejections prove people are irrational." The
    responder who refuses a stingy split is being inefficient in that one game — but social
    preferences are stable, costly and predictable, which makes them legitimate preference
    orderings, not errors. Refusing an unfair division is an investment in reputation and in
    the norm itself; in repeated real labour markets the "irrational" punishers are the ones
    who keep wage and effort standards up for everyone. Behavioural economics did not abolish
    rationality — it widened what the maximisation is <em>over</em>.
  </p>

  <h2>Firms: overconfidence and the planning fallacy</h2>
  <p>
    Firm-level decisions are made by managers with the same neural equipment, and the dominant
    bias is overconfidence. The <strong>planning fallacy</strong> — best-case scheduling,
    reference amnesia — is the most documented overrun in economics: Sydney Opera House was
    budgeted at A$7 million with four years to build; it opened in 1973 at A$102 million, ten
    years late. Flyvbjerg's sample of hundreds of transport projects found rail overrunning
    budgets by around 45 per cent on average, roads by around 20. The debiasing tool is
    <strong>reference-class forecasting</strong>: ignore your project's special story and ask
    what happened to the last hundred like it. Overconfidence also shapes entry and investment:
    most new firms fail, yet entrepreneurs surveyed report their personal odds as far above
    average — the same optimism that powers firm creation misprices its risk, which is why
    lenders and investors, not entrepreneurs, provide much of the market's realism.
  </p>
  <Widget no="7" caption="mark the average rail overrun" widget="place" config={bePlanningPlace} />
  <p>
    <strong>So far:</strong> overconfidence inflates plans, and the cure is to replace the
    project's special story with the outside record of comparable ones. The same
    forward-looking discipline — count only what still depends on your choice — is exactly
    what the next section's production decisions demand.
  </p>

  <h2>Firms and production: sunk costs on the factory floor</h2>
  <p>
    Production decisions have their own signature bias: <strong>sunk-cost escalation</strong>.
    Rational accounting says only forward-looking costs and benefits matter; real managers keep
    feeding projects they should kill because stopping would "waste" what is already spent —
    the error that kept the Anglo-French Concorde flying decades past the point where its
    economics were known to be hopeless (economists call it the Concorde fallacy for a reason).
    The corrective is marginal thinking, and the classic teaching example is the airline's
    near-empty flight: average cost per seat may be 400 pounds, but once the plane is flying the
    marginal cost of one more passenger is the 20 pounds of fuel, catering and fees — so
    selling a late standby seat at 40 is not "losing 360 a seat", it is gaining 20. Managers
    who anchor on average costs refuse those sales; airlines that automate them (dynamic
    pricing down to the marginal margin) profit from the difference. Behavioural economics
    here is not a rebellion against the standard model — it is the standard model's marginal
    logic, defended against the biases that stop managers applying it.
  </p>
  <Widget no="8" caption="sell the standby seat — marginal logic in order" widget="order" config={beSunkOrder} />

  <h2>Costs, revenue and objectives: the psychology of price</h2>
  <p>
    On the revenue side, price itself is a psychological object, not just a signal. Prices
    ending in 9 outsell round numbers: in Anderson and Simester's field experiments with a mail
    order catalogue, a dress priced at 39 dollars sold about a third more units than the same
    dress at 34 — the left-digit effect and the "charm price" heuristic overwhelm the standard
    demand curve locally. <strong>Reference prices</strong> do the rest: "was 60, now 39" works
    because the buyer evaluates the deal against an anchor rather than the good's worth — which
    is why regulators police fake "was" prices. The <strong>decoy effect</strong> is the most
    surgical demonstration: in the famous magazine subscription experiment, adding a
    print-only option priced the same as print-plus-web (an option nobody wants, present to be
    dominated) shifted choices to print-plus-web from 32 per cent to 84 per cent. And
    <strong>fairness</strong> constrains revenue in ways pure demand curves cannot: in Kahneman,
    Knetsch and Thaler's survey (1986), a hardware store raising the price of snow shovels
    after a snowstorm was judged unfair by 82 per cent of respondents — the same "price gouging"
    reaction that forced Uber to cap surge pricing after public outcries. Firms maximising
    revenue over decades must price inside the fairness envelope, because customers can
    retaliate in ways that never appear in a static demand estimate.
  </p>
  <Widget no="9" caption="pair each pricing tactic with its mechanism" widget="match" config={bePriceMatch} />
  <p>
    <strong>So far:</strong> prices are psychological objects — anchored, charmed and policed
    by fairness — rather than naked points on a demand curve. That leaves the systemic
    question: when all these biased buyers and sellers meet in a market, does competition
    wash the biases out or concentrate them?
  </p>

  <h2>Types of markets: when markets cure bias — and when they amplify it</h2>
  <p>
    Markets are behavioural environments, and their verdict is nuanced. On the curative side:
    John List's field experiments in sports-card trading found experienced traders' biases
    shrinking toward textbook behaviour — repetition, feedback and skin in the game debias, at
    least for the repeated, high-stakes decisions professionals specialise in. On the
    amplifying side, Vernon Smith's laboratory asset markets (1988) are the canonical result:
    traders buy an asset whose fundamental value they are <em>told</em>, watch it bubble far
    above that value, and crash — bubble after bubble, session after session, with
    professional-calibre participants. Herding, information cascades and extrapolative
    expectations survive every seminar on efficiency; the 1990s dot-com and 2000s housing
    episodes looked uncomfortably like the lab. The synthesis for the unit: competition
    disciplines biases in <em>product</em> markets where feedback is fast and consequences
    personal (no supermarket survives systematically mispricing bread), and amplifies them in
    <em>asset</em> markets where feedback is delayed and social. That asymmetry is why the
    field's policy attention has shifted from consumer protection to financial stability.
  </p>
  <Widget no="10" caption="where competition cures bias, and where it amplifies it" widget="compare" config={beMarketsCompare} />
  <p>
    <em>Common misconception:</em> "professionals are immune — biases are for amateurs." List's
    evidence shows experience and feedback debias <em>specific, practiced</em> decisions, not
    decision-makers in general: the same traders who price cards expertly still show narrow
    bracketing on unfamiliar choices, and anchoring survives in labs full of judges, doctors
    and auditors. Expertise is domain-specific; a bias you never get feedback on — a rare
    event, a sunk cost, a default — survives the corner office.
  </p>

  <h2>Check yourself</h2>
  <p>Try these before moving on. Feedback follows each answer.</p>
  <ol>
    <li>State what loss aversion claims, and explain why it is not the same thing as risk aversion.</li>
    <li>A project is three years late and 60 per cent over budget, and a manager argues that cancelling would waste the money already spent. Give the marginal argument for cancelling, and name the debiasing tool that should have produced the original estimate.</li>
    <li>Why did switching pensions from opt in to opt out raise participation so dramatically, when no subsidy was introduced and nobody was compelled?</li>
  </ol>
  <p>
    <strong>Feedback:</strong> (1) Losses hurt roughly twice as much as equal gains please,
    and the claim is defined relative to a reference point rather than final wealth — which is
    why the same person buys insurance and lottery tickets: cautious over likely gains,
    gamble-seeking over likely losses. Risk aversion is one stable attitude to risk; loss
    aversion is a pattern that flips sign with framing. (2) The money already spent is a sunk
    cost no future decision can recover, so only forward-looking costs and benefits should
    count — cancelling now costs less than finishing ever will. The estimate should have come
    from reference-class forecasting: ask what happened to the last hundred comparable
    projects instead of listening to what makes this one special. (3) The default moved the
    path of least resistance. Under present bias the doer never gets around to opting in, and
    the planner's good intention never becomes an action; auto-enrolment binds the intention
    in advance, lifting participation from around 40 to about 85 per cent — choice architecture
    working on psychology, not on pocketbooks.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>People are predictably irrational: biases have direction, so they can be modelled, predicted and corrected by design.</li>
    <li>Loss aversion — losses hurt about twice as much as gains please — explains insurance and lotteries from one curve.</li>
    <li>Mental accounting breaks the fungibility of money, and the pain of paying makes the payment method itself a price.</li>
    <li>Present bias makes preferences time-inconsistent; commitment devices and defaults re-bind the planner to the doer.</li>
    <li>Sunk costs are history: marginal logic and reference-class forecasting are the debiasing tools for firms.</li>
    <li>Prices live inside a fairness envelope — anchors, charm prices and decoys move demand, and perceived gouging invites retaliation.</li>
    <li>Competition disciplines bias where feedback is fast and personal, and amplifies it in asset markets where feedback is slow and social.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    Game Theory formalises the strategic side of the fairness results you saw in the ultimatum
    game, and Development Economics takes commitment devices and default design to the savings
    problems of low-income households. International Trade &amp; Comparative Advantage then
    supplies the standard-model benchmark that behavioural economics keeps testing.
  </p>

  <h2>Going deeper</h2>
  <p>
    <strong>Prospect theory, formally.</strong> The 1979 value function is defined over gains
    and losses relative to a reference point — not final wealth — with a loss coefficient
    usually estimated near 2.25, concavity over gains, convexity over losses, and probability
    weighting that overweights small probabilities (why both insurance and lottery tickets
    sell). It resolved the Allais paradoxes that had embarrassed expected utility for decades,
    and it is the direct ancestor of Thaler's behavioural life-cycle, mental accounting and
    endowment-effect results.
  </p>
  <p>
    <strong>The replication reckoning.</strong> Behavioural science has had its own credibility
    crisis, and a serious student should know it. Many early social-priming results failed
    direct replication (Doyen's 2012 study could not reproduce the "elderly walking slower"
    effect); the Open Science Collaboration's 2015 re-run of 100 psychology studies reproduced
    under half. The field responded with pre-registration, larger samples and adversarial
    collaborations — and its sturdiest results (loss aversion, present bias, default effects,
    fairness punishments) survived, which is precisely why they anchor this lesson. When
    reading any single striking experiment, ask: has it replicated, at scale, out of lab?
  </p>
  <Widget no="11" caption="true or false — the replication reckoning" widget="judge" config={beReplicationJudge} />
  <p>
    <strong>The frontier.</strong> Governments now run dedicated behavioural teams — Britain's
    Behavioural Insights Team (2010) was followed by well over a hundred units worldwide — and
    the research agenda has moved from "do nudges work?" to calibration and ethics: defaults
    that work in Denmark underperform elsewhere; personalised defaults raise both effectiveness
    and privacy questions; and Thaler's own "sludge audit" asks organisations to count the
    friction <em>they</em> impose. The deep critique — Gigerenzer's — argues heuristics are
    ecologically rational, fast-and-frugal tools tuned to real environments, so the science
    should match tools to environments rather than repair "errors". Between prospect theory's
    curve and Gigerenzer's toolbox lies the live question of the next decade: what happens to
    choice architecture when the chooser is an algorithm trained on behavioural data?
  </p>

