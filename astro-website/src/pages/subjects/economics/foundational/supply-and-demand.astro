---
import Layout from '../../../../layouts/Layout.astro';
import data from '../../../../data/topics.json';
import Quiz from '../../../../components/Quiz.astro';
import Glossary from '../../../../components/Glossary.astro';
import kidData from '../../../../data/kid-summaries.json';

const B = import.meta.env.BASE_URL.replace(/\/+$/, '') || '';
const { subjects, topics } = data;
const topic = topics.find((t) => t.slug === 'subjects/economics/foundational/supply-and-demand');
const kidSummary = kidData[topic.slug] ?? null;
const subject = subjects.find((s) => s.id === topic.subject);
const seq = topics.filter((t) => t.status !== 'planned');
const idx = seq.indexOf(topic);
const prev = seq[(idx - 1 + seq.length) % seq.length];
const next = seq[(idx + 1) % seq.length];

const marketCfg = {
  curves: [
    { expr: 'a - b*p', label: 'demand', color: '#b42318' },
    { expr: 'c*p - d', label: 'supply', color: '#0f766e' },
  ],
  params: [
    { name: 'a', label: 'demand level a', min: 20, max: 140, step: 1, value: 100 },
    { name: 'b', label: 'price sensitivity b', min: 0.5, max: 4, step: 0.1, value: 2 },
    { name: 'c', label: 'supply response c', min: 0.5, max: 4, step: 0.1, value: 2 },
    { name: 'd', label: 'supply cost d', min: 0, max: 80, step: 1, value: 20 },
  ],
  x: { min: 0, max: 70, label: 'price' },
  y: { min: 0, max: 120, label: 'quantity' },
  crossings: true,
  height: 370,
};

// The same market as a table-turned-chart: both schedules read off at
// a = 100, b = 2, c = 2, d = 20. They meet at price 30, quantity 40.
const scheduleCfg = {
  kind: 'line',
  height: 300,
  xLabels: ['10', '20', '30', '40', '50'],
  xLabel: 'price',
  y: { min: 0, max: 80, label: 'quantity' },
  series: [
    { label: 'buyers want', color: '#b42318', values: [80, 60, 40, 20, 0] },
    { label: 'sellers offer', color: '#0f766e', values: [0, 20, 40, 60, 80] },
  ],
};

const checkCfg = {
  questions: [
    {
      q: 'At a price of 30, buyers want 40 and sellers offer 40. What happens?',
      choices: [
        'Nothing pushes the price either way — the market clears',
        'A shortage appears and the price rises',
        'A surplus appears and the price falls',
        'The curves shift to a new position',
      ],
      answer: 0,
      why: 'Equal quantity wanted and offered is the definition of equilibrium.',
    },
    {
      q: 'Demand rises (a goes up) while supply stays put. What moves?',
      choices: [
        'Both the equilibrium price and quantity rise',
        'Price rises but quantity falls',
        'Price falls but quantity rises',
        'Neither changes',
      ],
      answer: 0,
      why: 'The demand line shifts right, so the crossing moves right and up.',
    },
    {
      q: 'Which change makes buyers more sensitive to price?',
      choices: [
        'Raising b, the demand slope',
        'Raising a, the demand level',
        'Lowering d, the supply cost',
        'Raising c, the supply response',
      ],
      answer: 0,
      why: 'b sets how steeply quantity falls as price climbs — that is sensitivity.',
    },
  ],
};
---
<Layout title={`${topic.title} — ${subject.name} — Interactive Atlas`} description={topic.summary}>
  <div class="wrap">
    <div class="topic-grid">
      <aside class="topic-aside">
        <a class="back" href={`${B}/subjects/${subject.id}/`}>← all of {subject.name}</a>
        <dl>
          <dt>subject</dt><dd><span class="dot" style={`--dot:${subject.ink}; display:inline-block; margin-right:.4rem`}></span>{subject.name}</dd>
          <dt>level</dt><dd>{topic.level}</dd>
          <dt>time</dt><dd>{topic.minutes} min</dd>
          <dt>tags</dt><dd>{topic.tags.slice(0, 3).join(', ')}</dd>
        </dl>
      </aside>
      <article>
        <header class="topic-head">
          <p class="crumb"><a href={B + '/'}>atlas</a><span class="sep">/</span><a href={`${B}/subjects/${subject.id}/`}>{subject.name}</a><span class="sep">/</span>{topic.level}</p>
          <h1>{topic.title}</h1>
          <p class="lede">{topic.summary}</p>
        </header>

        {kidSummary && (
          <aside class="kid-note" aria-label="Summary for young readers">
            <p><strong>For young explorers:</strong> {kidSummary}</p>
          </aside>
        )}
        <div class="topic-body">
          <h2>The idea</h2>
          <p>
            Walk into any market — a fruit stall, a stock exchange, a ride-hailing app — and you
            are watching a machine with no manager set a price that nobody chose. Economics'
            first great discovery is that prices <em>emerge</em>. Two behaviours, one graph:
            <strong>buyers</strong> purchase less as price rises (the <strong>demand</strong>
            curve slopes down); <strong>sellers</strong> offer more as price rises (the
            <strong>supply</strong> curve slopes up). Where the two cross, the
            <Glossary term="market clears" def="The price where the quantity buyers want exactly equals the quantity sellers offer, so nothing is left over and nothing is missing." />
            — quantity demanded equals quantity supplied, and the price has no reason to move.
            That crossing is the <strong>market equilibrium</strong>, and it is circled on the
            plot below: drag any slider and watch the crossing relocate. Note the discipline
            behind the whole diagram: we vary <em>one thing at a time</em>, holding everything
            else constant — economists abbreviate that as <em>ceteris paribus</em>, "other
            things equal".
          </p>

          <figure class="widget">
            <figcaption><span class="fig-no">fig. 1</span><span>the circled crossing is the market equilibrium — drag any parameter</span></figcaption>
            <div class="widget-body">
              <div data-widget="plotter" data-config={JSON.stringify(marketCfg)}></div>
            </div>
          </figure>

          <p>
            The same market can be written as a table — a <em>demand schedule</em> and a
            <em>supply schedule</em> — and economics students should be able to move fluently
            between numbers and curves. In fig. 2, at a price of 20 buyers want 60 units but
            sellers offer only 20: a <strong>shortage</strong> of 40, and frustrated buyers bid
            the price up. At a price of 50 sellers offer 80 while buyers want only 20: a
            <strong>surplus</strong> of 60, and unsold stock forces sellers to cut. Only at
            price 30 do the columns match — 40 equals 40 — and the market rests.
          </p>

          <figure class="widget">
            <figcaption><span class="fig-no">fig. 2</span><span>the same market as numbers — hover a price to compare both sides</span></figcaption>
            <div class="widget-body">
              <div data-widget="chart" data-config={JSON.stringify(scheduleCfg)}></div>
            </div>
          </figure>

          <h2>Demand: why the curve slopes down, and when it moves</h2>
          <p>
            The <strong>law of demand</strong> — higher price, lower quantity demanded — has three
            reinforcing reasons. The <em>substitution effect</em>: as coffee's price climbs, tea
            looks better. The <em>income effect</em>: at a higher price the same budget buys
            less, so some buyers simply drop out. And <em>diminishing marginal utility</em>: your
            second pizza is worth less to you than the first, so you only buy it at a lower
            effective price. None of this requires selfishness — it is arithmetic applied to
            anything scarce.
          </p>
          <p>
            The exam's favourite trap lives here: <strong>movement along the curve versus shift
            of the curve</strong>. A change in <em>price</em> moves you <em>along</em> a fixed
            demand curve. A change in <em>anything else</em> — incomes, tastes, the price of
            substitutes or complements, population, expected future prices — <em>shifts the
            whole curve</em>. When incomes rise, demand for most goods (normal goods) shifts
            right; demand for <em>inferior</em> goods — instant noodles, bus travel when trains
            exist — shifts <em>left</em>, because buyers upgrade. A price rise for a substitute
            (Pepsi) shifts demand right; for a complement (printer ink), left. If you can say
            <em>which</em> variable moved and <em>which way</em> the curve went, you have the
            hardest half of the topic.
          </p>

          <h2>Supply: the mirror image with a different engine</h2>
          <p>
            Sellers offer more at higher prices because producing more tends to cost more per
            extra unit — the second field is rockier, the best workers already hired, the
            machines already running flat out (<em>rising marginal cost</em>). Only a higher
            price makes the extra units worth producing, so the supply curve slopes up.
            Supply <em>shifters</em> mirror demand's: costs of inputs (wages, energy, raw
            materials), technology (a better machine shifts supply right and down), taxes and
            subsidies, the number of firms in the market, and — for anything agricultural —
            the weather. A frost in Brazil doesn't move you along a coffee-supply curve; it
            moves the curve itself.
          </p>

          <h2>Price determination: the auction nobody runs</h2>
          <p>
            Put the curves together and equilibrium does the coordinating. Adam Smith's 1776
            image — the butcher and the baker serve your dinner not from kindness but from
            self-interest, and the price weaves their separate plans together — became known as
            the <strong>invisible hand</strong>. The price is simultaneously a <em>signal</em>
            (scarcity here, abundance there), an <em>incentive</em> (profits invite new
            suppliers in, losses wave them out), and a <em>rationing device</em> (the good goes
            to those willing to pay, not to the fast or the connected). Run the experiments on
            fig. 1 and each classical result falls out: a fashion trend (demand shifts right)
            raises both price and quantity — scarcity pays; a better machine (supply shifts
            right) <em>lowers</em> price while quantity rises; a crop failure (supply shifts
            left) sends price jumping while quantity barely moves — the classic shortage, and
            the daily news from any commodity market.
          </p>
          <p>
            When <em>both</em> curves shift, the outcomes must be argued case by case — the
            skill the syllabus calls "price changes". Demand up and supply up both raise
            quantity, but the price could go either way depending on which shift is bigger;
            demand up with supply down (an oil embargo during a cold winter) sends price up
            with quantity ambiguous. Economists resolve the ambiguity exactly the way the
            sliders resolve it: by asking which shift moved further.
          </p>
          <p><em>Common misconception:</em> "demand increased" does not mean "people bought
          more". If quantity bought rose because the price fell, that is a movement along the
          demand curve and demand itself hasn't changed. Demand has increased only when buyers
          would buy more <em>at every price</em> — a shift. Drawing the two cases is the
          fastest cure for the confusion.</p>

          <h2>Elasticity: how violently the quantity answers</h2>
          <p>
            Two markets can react to the same price rise with completely different rage.
            <strong>Price elasticity of demand</strong> (PED) measures it:
            <code>PED = %Δquantity demanded ÷ %Δprice</code>. If demand is <em>elastic</em>
            (|PED| &gt; 1), buyers flee easily — restaurant meals, brand-name goods with close
            substitutes. If <em>inelastic</em> (|PED| &lt; 1), they grumble and pay — petrol
            for commuters, tobacco for addicts, insulin for diabetics. The determinants are
            learnable: substitutes available (the big one), necessity versus luxury, share of
            income spent, and time (short-run petrol demand is famously inelastic around
            −0.25 because nobody re-engineers their commute overnight; long-run it stretches
            toward −0.6 as people buy smaller cars). Elasticity has teeth because it decides
            <em>revenue</em>: raise prices when demand is inelastic and revenue rises; do it
            when demand is elastic and revenue falls. This is why a bumper harvest can
            <em>impoverish</em> farmers — food demand is inelastic, so the glut collapses the
            price faster than volume rises — and why governments tax cigarettes with such
            confidence that the revenue (though the smoking falls) will keep coming.
          </p>

          <h2>Supply elasticity and the volatility of farms</h2>
          <p>
            <strong>Price elasticity of supply</strong> (PES) asks the same question of sellers: can
            quantity respond quickly? <code>PES = %Δquantity supplied ÷ %Δprice</code>. Spare
            capacity, storable stock and — above all — time raise it: the longer production
            requires, the more inelastic supply is. Manufacturing can respond in weeks; agriculture
            in seasons or years (you cannot unplant a field, and coffee trees take three to five
            years to bear), which is why farm prices swing violently from season to season even
            when demand barely moves — the textbook volatile markets, and the reason stabilisation
            schemes, buffer stocks and futures markets exist. Manufacturing supply is elastic
            (PES &gt; 1); fresh fish landed today is almost perfectly inelastic until tomorrow's
            boats return.
          </p>

          <h2>The market system, and where it fails</h2>
          <p>
            The <strong>market economic system</strong> is the claim that this price mechanism,
            run everywhere, allocates society's resources better than any planner could —
            because it uses the knowledge of millions of buyers and sellers that no central
            office could collect (Friedrich Hayek's 1945 argument, which helped settle the
            great "calculation debate" of the twentieth century). Its record is real: market
            economies innovate faster and deliver more variety than planned ones did. But the
            system fails in specific, nameable ways — <strong>market failure</strong>. It
            ignores <em>externalities</em> (the factory's smoke lands on neighbours who never
            bargained); it under-provides <em>public goods</em> (street lighting, national
            defence — non-excludable, so nobody privately pays); it stumbles on information
            gaps (used-car sellers know more than buyers); and it can concentrate
            <strong>monopoly power</strong>, which re-prices away from the competitive crossing.
            Hence the <strong>mixed economic system</strong> that every real country runs:
            markets for most things, with government taxing negative externalities,
            subsidising positive ones (education, vaccines), regulating, and directly
            providing what markets won't. The syllabus's deeper arc — and the next lesson's
            subject — is where to draw that line, and what it costs to move it.
          </p>

          <h2>A worked elasticity calculation</h2>
  <p>
    The formula is easiest with honest numbers. A café raises its coffee price from £3.00
    to £3.30 (+10%) and sales fall from 100 cups a day to 85 (−15%).
    <code>PED = −15% ÷ +10% = −1.5</code> — elastic: customers found the chain across the
    street. Revenue check: 100 × £3.00 = £300 before; 85 × £3.30 = £280.50 after — the rise
    lost money, exactly what |PED| &gt; 1 predicts. If instead only five cups had
    disappeared (−5%), PED would be −0.5 — inelastic — and revenue would have risen to
    £313.50. Same formula, opposite decisions; the number, not the manager's nerve, decides.
    The standard elasticity menu runs from perfectly inelastic (vertical demand — insulin at
    any price) through inelastic (petrol short-run ≈ −0.25), unit elastic (−1), to elastic
    (restaurant meals ≈ −2.3 in many studies) and the theoretical perfectly elastic
    (horizontal — one wheat farm's output in a giant market). Income elasticity (YED) and
    cross elasticity (how demand for tea responds to coffee's price) complete the family,
    and all of them are the same skill: percentage change over percentage change, then a
    decision.
  </p>

  <h2>Going deeper</h2>
          <p>
            The diagram's full name is Alfred Marshall's "scissors" (1890): supply and demand
            are the two blades, and asking whether price is "really" set by cost or by utility
            is like asking whether the upper or lower blade cuts. Marshall also drew the
            welfare analysis hiding in the picture: every buyer willing to pay more than the
            equilibrium price enjoys a gap — <em>consumer surplus</em> — and every seller
            producing below it pockets <em>producer surplus</em>; the two triangles are the
            total value the market creates, and competition maximises their sum. That triangle
            arithmetic is the entire foundation of cost–benefit analysis, competition law and
            every deadweight-loss diagram you will ever meet.
          </p>
          <p>
            The model's edges are instructive too. <strong>Price controls</strong> freeze the
            crossing: a rent ceiling below equilibrium creates a persistent shortage (queues,
            quality decay, black keys-money), a minimum price above equilibrium creates
            surplus (butter mountains, EU wine lakes) — both are supply-and-demand diagrams
            arguing policy. <strong>Agriculture's cobweb</strong> shows markets oscillating:
            high prices this season cause overplanting, next season's glut crashes prices,
            and the cycle repeats — a reason commodity markets stay volatile despite everyone
            understanding the theory. And behavioural economics adds the twist that real
            buyers anchor on reference prices: a pint that was £4 last week "feels" dearer
            than the same pint next to a £6 competitor. The two curves remain the model of
            the discipline — flexible enough to carry taxes, subsidies, controls, expectations
            and shocks — but every later course teaches you where its straight lines stop
            matching the world.
          </p>

          <p class="sources"><strong>Sources:</strong> Smith, <em>The Wealth of Nations</em> (1776); Marshall, <em>Principles of Economics</em> (1890); Hayek, "The Use of Knowledge in Society" (1945); OpenStax, <em>Principles of Economics</em>; Cambridge IGCSE Economics 0455 syllabus, sections 2.1–2.10.</p>

          <Quiz questions={checkCfg.questions} />
        </div>

        <nav class="topic-next" aria-label="Lesson navigation">
          <div><span class="tn-label">previous lesson</span><a href={`${B}/${prev.slug}/`}>{prev.title}</a></div>
          <div style="text-align:right"><span class="tn-label">next lesson</span><a href={`${B}/${next.slug}/`}>{next.title}</a></div>
        </nav>
      </article>
    </div>
  </div>
</Layout>
