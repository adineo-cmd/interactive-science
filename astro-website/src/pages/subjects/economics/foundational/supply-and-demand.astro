---
import Layout from '../../../../layouts/Layout.astro';
import data from '../../../../data/topics.json';
import Quiz from '../../../../components/Quiz.astro';
import Glossary from '../../../../components/Glossary.astro';

const B = import.meta.env.BASE_URL.replace(/\/+$/, '') || '';
const { subjects, topics } = data;
const topic = topics.find((t) => t.slug === 'subjects/economics/foundational/supply-and-demand');
const subject = subjects.find((s) => s.id === topic.subject);
const seq = topics.filter((t) => t.status !== 'planned');
const idx = seq.indexOf(topic);
const prev = seq[(idx - 1 + seq.length) % seq.length];
const next = seq[(idx + 1) % seq.length];

const marketCfg = {
  curves: [
    { expr: 'a - b*p', label: 'demand', color: '#b42318' },
    { expr: 'c*p - d', label: 'supply', color: '#0f766e' },
  ],
  params: [
    { name: 'a', label: 'demand level a', min: 20, max: 140, step: 1, value: 100 },
    { name: 'b', label: 'price sensitivity b', min: 0.5, max: 4, step: 0.1, value: 2 },
    { name: 'c', label: 'supply response c', min: 0.5, max: 4, step: 0.1, value: 2 },
    { name: 'd', label: 'supply cost d', min: 0, max: 80, step: 1, value: 20 },
  ],
  x: { min: 0, max: 70, label: 'price' },
  y: { min: 0, max: 120, label: 'quantity' },
  crossings: true,
  height: 370,
};

// The same market as a table-turned-chart: both schedules read off at
// a = 100, b = 2, c = 2, d = 20. They meet at price 30, quantity 40.
const scheduleCfg = {
  kind: 'line',
  height: 300,
  xLabels: ['10', '20', '30', '40', '50'],
  xLabel: 'price',
  y: { min: 0, max: 80, label: 'quantity' },
  series: [
    { label: 'buyers want', color: '#b42318', values: [80, 60, 40, 20, 0] },
    { label: 'sellers offer', color: '#0f766e', values: [0, 20, 40, 60, 80] },
  ],
};

const checkCfg = {
  questions: [
    {
      q: 'At a price of 30, buyers want 40 and sellers offer 40. What happens?',
      choices: [
        'Nothing pushes the price either way — the market clears',
        'A shortage appears and the price rises',
        'A surplus appears and the price falls',
        'The curves shift to a new position',
      ],
      answer: 0,
      why: 'Equal quantity wanted and offered is the definition of equilibrium.',
    },
    {
      q: 'Demand rises (a goes up) while supply stays put. What moves?',
      choices: [
        'Both the equilibrium price and quantity rise',
        'Price rises but quantity falls',
        'Price falls but quantity rises',
        'Neither changes',
      ],
      answer: 0,
      why: 'The demand line shifts right, so the crossing moves right and up.',
    },
    {
      q: 'Which change makes buyers more sensitive to price?',
      choices: [
        'Raising b, the demand slope',
        'Raising a, the demand level',
        'Lowering d, the supply cost',
        'Raising c, the supply response',
      ],
      answer: 0,
      why: 'b sets how steeply quantity falls as price climbs — that is sensitivity.',
    },
  ],
};
---
<Layout title={`${topic.title} — ${subject.name} — Interactive Atlas`} description={topic.summary}>
  <div class="wrap">
    <div class="topic-grid">
      <aside class="topic-aside">
        <a class="back" href={`${B}/subjects/${subject.id}/`}>← all of {subject.name}</a>
        <dl>
          <dt>subject</dt><dd><span class="dot" style={`--dot:${subject.ink}; display:inline-block; margin-right:.4rem`}></span>{subject.name}</dd>
          <dt>level</dt><dd>{topic.level}</dd>
          <dt>time</dt><dd>{topic.minutes} min</dd>
          <dt>tags</dt><dd>{topic.tags.slice(0, 3).join(', ')}</dd>
        </dl>
      </aside>
      <article>
        <header class="topic-head">
          <p class="crumb"><a href={B + '/'}>atlas</a><span class="sep">/</span><a href={`${B}/subjects/${subject.id}/`}>{subject.name}</a><span class="sep">/</span>{topic.level}</p>
          <h1>{topic.title}</h1>
          <p class="lede">{topic.summary}</p>
        </header>

        <div class="topic-body">
          <h2>The idea</h2>
          <p>
            Two behaviours, one graph. <strong>Buyers</strong> purchase less as price rises
            (demand slopes down); <strong>sellers</strong> offer more as price rises (supply
            slopes up). Nobody sets the outcome — the
            <Glossary term="market clears" def="The price where the quantity buyers want exactly equals the quantity sellers offer, so nothing is left over and nothing is missing." />
            exactly where the two curves cross. That crossing is marked on the plot below.
          </p>

          <figure class="widget">
            <figcaption><span class="fig-no">fig. 1</span><span>the circled crossing is the market equilibrium — drag any parameter</span></figcaption>
            <div class="widget-body">
              <div data-widget="plotter" data-config={JSON.stringify(marketCfg)}></div>
            </div>
          </figure>

          <figure class="widget">
            <figcaption><span class="fig-no">fig. 2</span><span>the same market as numbers — hover a price to compare both sides, click a legend entry to hide it</span></figcaption>
            <div class="widget-body">
              <div data-widget="chart" data-config={JSON.stringify(scheduleCfg)}></div>
            </div>
          </figure>

          <h2>Experiments to run</h2>
          <ul>
            <li><strong>A fashion trend hits.</strong> Raise demand <code>a</code>. Both price and quantity rise — scarcity pays.</li>
            <li><strong>A better machine arrives.</strong> Lower cost <code>d</code> (supply shifts out). Price falls, quantity rises.</li>
            <li><strong>Shoppers get picky.</strong> Raise sensitivity <code>b</code>: demand flattens harder, and taxes or shocks bite sellers more.</li>
            <li><strong>A crop fails.</strong> Lower supply response <code>c</code>. Price jumps while quantity barely moves — the classic shortage.</li>
          </ul>

          <p>
            Every one of those results is just <em>where two straight lines cross</em> — which is
            why a first economics course is secretly a geometry course. The arguments come later;
            first, the pictures.
          </p>

          <Quiz questions={checkCfg.questions} />
        </div>

        <nav class="topic-next" aria-label="Lesson navigation">
          <div><span class="tn-label">previous lesson</span><a href={`${B}/${prev.slug}/`}>{prev.title}</a></div>
          <div style="text-align:right"><span class="tn-label">next lesson</span><a href={`${B}/${next.slug}/`}>{next.title}</a></div>
        </nav>
      </article>
    </div>
  </div>
</Layout>
