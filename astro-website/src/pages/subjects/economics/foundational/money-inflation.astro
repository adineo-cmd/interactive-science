---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const powCfg = {
  curves: [{ expr: '100/(1 + i)^x', label: 'purchasing power of 100', color: '#b45309', width: 2.4 }],
  params: [
    { name: 'i', label: 'annual inflation i', min: 0, max: 0.5, step: 0.01, value: 0.03, unit: 'as decimal' },
  ],
  x: { min: 0, max: 60, label: 'years' },
  y: { min: 0, max: 105 },
  crossings: false,
  height: 350,
};

const cpiCfg = {
  kind: 'bar',
  xLabels: ['1965', '1975', '1980', '1990', '2000', '2010', '2015', '2020', '2022', '2024'],
  series: [{ label: 'US CPI inflation (annual %)', values: [1.6, 9.1, 13.5, 5.4, 3.4, 1.6, 0.1, 1.2, 8.0, 2.9] }],
  unit: '%',
  digits: 1,
  height: 300,
};

const miBarterEst = {
  "prompt": "With 1,000 different goods, barter needs a separate price for every pair. Roughly how many pairwise prices is that?",
  "unit": "prices",
  "answer": 499500,
  "factor": 1.1,
  "why": "n(n−1)/2 = 1000 × 999 / 2 ≈ 500,000. Money replaces that whole matrix with one unit of account — the scale at which barter fails.",
  "context": "with 3 goods it is only 3 pairs; the count grows with the square"
};

const miJobsMatch = {
  "prompt": "Pair each job of money with what it makes possible:",
  "pairs": [
    {
      "left": "medium of exchange",
      "right": "the shoemaker accepts your money without wanting your chicken"
    },
    {
      "left": "unit of account",
      "right": "every price is quoted in one yardstick, so thousands can be compared"
    },
    {
      "left": "store of value",
      "right": "savings keep their meaning between this month and next year"
    }
  ],
  "why": "The three jobs are separate: exchange dissolves the double coincidence, the unit of account compresses the price list, and the store of value carries purchasing power through time."
};

const miPropertySort = {
  "prompt": "Which property of good money does each candidate fail?",
  "buckets": [
    "not scarce",
    "not durable",
    "not portable"
  ],
  "items": [
    {
      "label": "pebbles on a beach — anyone can gather more",
      "bucket": 0
    },
    {
      "label": "unlimited sand — supply is effectively infinite",
      "bucket": 0
    },
    {
      "label": "fresh fish — spoils by the next day",
      "bucket": 1
    },
    {
      "label": "ice sculptures — melt in the market",
      "bucket": 1
    },
    {
      "label": "boulders — too heavy to carry",
      "bucket": 2
    },
    {
      "label": "a grand piano — not exactly pocket-sized",
      "bucket": 2
    }
  ],
  "why": "Money must be scarce, durable, portable and divisible; each candidate fails one test. A painting can be scarce and durable yet still fail divisibility."
};

const miLoanOrder = {
  "prompt": "How a bank loan creates money — put the steps in order:",
  "items": [
    "A bank approves your mortgage and credits your account",
    "The deposit is new money — no saver's pounds were moved",
    "You spend it, and the seller's bank receives the deposit",
    "You repay the loan over the years",
    "As the loan is repaid, that money is destroyed"
  ],
  "why": "Most money is bank-created credit: loans create deposits, and repayment extinguishes them."
};

const miMoneyCloze = {
  "text": "M1 is currency plus %%0%% deposits — money you can spend immediately. M2 adds %%1%% accounts and certificates of deposit. Most money is created by bank %%2%%, not by printing notes.",
  "answers": [
    [
      "demand",
      "checking"
    ],
    [
      "savings"
    ],
    [
      "lending",
      "loans"
    ]
  ],
  "hint": "M1 is the spend-now measure; M2 widens it to less liquid savings."
};

const miRealSpot = {
  "prompt": "Find the line where the real-versus-nominal reasoning goes wrong:",
  "lines": [
    "Your pay rises 5% while prices rise 7%.",
    "Nominal pay is up, so your real pay has risen too.",
    "Real rate ≈ nominal rate − inflation = 5% − 7% = −2%.",
    "Your real pay has fallen by about 2%.",
    "Borrowers with fixed-rate loans gain in this situation."
  ],
  "errorLine": 1,
  "correction": "Nominal pay rose, but real pay fell: 5% − 7% ≈ −2%.",
  "why": "Inflation redistributes from savers to borrowers: borrowers repay in cheaper money, while fixed-income savers lose."
};

const miRulePlace = {
  "prompt": "At 5% inflation, roughly how many years until prices double? Place it on the axis.",
  "labels": [
    "0",
    "7",
    "14",
    "21",
    "28"
  ],
  "scale": {
    "min": 0,
    "max": 28
  },
  "answer": 14,
  "tolerance": 1,
  "why": "70 ÷ 5 = 14 years. At 3% it is about 23 years; at 10%, 7 years."
};

const miOilBranch = {
  "root": "Crude oil roughly quadruples in a few months. Trace the diagnosis.",
  "nodes": {
    "start": {
      "text": "Energy feeds into almost everything. Which inflation does this shock start?",
      "choices": [
        {
          "label": "Cost-push — input prices rise and firms pass them on",
          "next": "cost",
          "feedback": "Yes — an input shock raises costs across the economy."
        },
        {
          "label": "Demand-pull — too much spending chasing too few goods",
          "next": "demand",
          "feedback": "Spending did not surge; the cost of an essential input did."
        },
        {
          "label": "Deflation — prices are falling",
          "next": "defl",
          "feedback": "This shock pushes prices up, not down."
        }
      ]
    },
    "cost": {
      "text": "Cost-push. The central bank now faces a dilemma: higher rates cool demand but cannot produce more oil. What is the main risk?",
      "choices": [
        {
          "label": "A wage–price spiral if expectations unanchor",
          "next": "spiral",
          "feedback": "Yes — expected inflation can make the shock persistent."
        },
        {
          "label": "Inflation vanishes immediately",
          "next": "instant",
          "feedback": "Cost shocks fade slowly, and expectations can keep them alive."
        }
      ]
    },
    "spiral": {
      "text": "If workers and firms expect 10% and set wages and prices at 10%, a temporary shock becomes persistent. Credibility is the shield."
    },
    "demand": {
      "text": "That is the wrong diagnosis: spending did not surge; the cost of an essential input did. Raising demand further would worsen it.",
      "choices": [
        {
          "label": "Reconsider the diagnosis",
          "next": "cost",
          "feedback": "Start from the input price."
        }
      ]
    },
    "defl": {
      "text": "Deflation is falling prices — the opposite of an oil shock.",
      "choices": [
        {
          "label": "Reconsider the diagnosis",
          "next": "cost",
          "feedback": "Which way does a cost shock push prices?"
        }
      ]
    },
    "instant": {
      "text": "Cost shocks fade slowly, and expectations can keep them alive.",
      "choices": [
        {
          "label": "Follow the risk",
          "next": "spiral",
          "feedback": "Track what happens if expectations unanchor."
        }
      ]
    }
  },
  "why": "An oil shock is cost-push; the policy danger is that a one-off price jump becomes a wage–price spiral once expectations unanchor."
};

const miPolicyJudge = {
  "statements": [
    {
      "s": "A central bank raises its interest rate; mortgage and investment spending cool, and inflation pressure eases after a lag.",
      "truth": true,
      "why": "Higher rates raise borrowing costs, which cools demand — but the transmission runs through decisions that take months to renegotiate."
    },
    {
      "s": "The main effect on inflation appears within days of a rate change.",
      "truth": false,
      "why": "The standard lag is a year or more, which is why central banks must forecast rather than react to the latest headline."
    },
    {
      "s": "Central bank independence helps because governments may be tempted to stimulate before elections.",
      "truth": true,
      "why": "The political business cycle is the temptation; independence protects credibility."
    }
  ]
};

const miDiseaseCompare = {
  "prompt": "Two failures of price stability — drag the divider:",
  "before": {
    "label": "hyperinflation",
    "text": "prices double every few days; money stops being a store of value, and people flee to barter or foreign currency"
  },
  "after": {
    "label": "deflation",
    "text": "prices fall, so buyers wait; debts grow heavier in real terms and spending stalls"
  },
  "why": "Both are failures of price stability in opposite directions; the 2% target is a buffer against deflation, which is harder to escape."
};
---
<TopicPage slug="subjects/economics/foundational/money-inflation">

  <h2>Where you are, and what you will learn</h2>
  <p>
    This is an early lesson in Economics. You need nothing from earlier lessons — only
    percentages and the experience of ever having bought something. Everything else is
    built here, step by step.
  </p>
  <p>By the end you will be able to:</p>
  <ul>
    <li>explain the three jobs of money — medium of exchange, unit of account, store of value — and what makes a thing good at them;</li>
    <li>describe who actually creates money (banks, not just printing presses) and what a central bank does;</li>
    <li>explain how inflation is measured, and the difference between nominal and real values;</li>
    <li>name the causes of inflation — demand-pull, cost-push, wage–price spirals, money growth, expectations — and recognise each in a news story;</li>
    <li>compute a halving time with the rule of 70, and say why central banks target 2% rather than zero.</li>
  </ul>
  <p>
    One habit: whenever a price appears, ask whether it is a <em>real</em> value wearing a
    <em>nominal</em> costume. Nearly every money confusion in daily life is a failure to
    make that one distinction.
  </p>

  <h2>Market day without money</h2>
  <p>
    Imagine a market where money has not been invented. You raise chickens and want shoes.
    You must find a shoemaker who wants exactly your chicken, at the same time you want
    shoes, in portions you can both agree on. Economists call this the
    <strong>double coincidence of wants</strong>, and barter makes it mandatory for every
    single trade. With three goods you need three prices; with a thousand goods you need
    nearly half a million pairwise prices. Barter does not just fail at the margin — it
    fails at scale.
  </p>
  <Widget no="1" caption="call the size of the barter problem" widget="estimate" config={miBarterEst} />
  <p>
    Money is the technology that dissolves the problem, and it does three jobs at once. A
    <strong>medium of exchange</strong>: everyone accepts it, so any seller trades with any
    buyer and the shoemaker takes your money without wanting your chicken. A
    <strong>unit of account</strong>: one yardstick in which all prices are quoted, so
    thousands of prices can be compared in your head. A <strong>store of value</strong>:
    savings that keep their meaning between this month and next year. Inflation is the
    third job going wrong — money quietly losing weight each year, so the same note buys
    less. This lesson is about how money does its jobs, who manufactures it, and what
    happens when its value starts to slip.
  </p>
  <Widget no="2" caption="pair each job of money with its example" widget="match" config={miJobsMatch} />
  <p>
    History supplies the job interview. Whatever carried trust served as money: salt and
    cowrie shells, then coins whose metal <em>was</em> the value, then paper notes
    <em>backed</em> by gold, and finally today's <strong>fiat money</strong> — paper and
    digits with no intrinsic worth, valuable because the state accepts them for taxes and
    everyone else follows. The job interview has consistent hiring criteria: money must be
    <strong>scarce</strong> (pebbles fail — anyone can dig up more), <strong>durable</strong>
    (it survives handling), <strong>portable</strong> (boulders fail) and
    <strong>divisible</strong> (it works for transactions of every size). Notice the shape
    of the list: money is whatever a community trusts, and the practical properties are
    what keep that trust cheap to maintain.
  </p>
  <Widget no="3" caption="which property does each candidate fail?" widget="sort-buckets" config={miPropertySort} />

  <h2>Who makes money, and how much of it there is</h2>
  <p>
    The "printing press" is stranger than it sounds: most money is created by commercial
    banks, not mints. Every time a bank makes a loan, it deposits money that did not exist
    before — your new mortgage credits your account with freshly created digits — and that
    money is destroyed when the loan is repaid. The gold backing of paper ended for good in
    1971, when the US suspended dollar–gold convertibility; since then all major money is a
    claim on trust, which is exactly why inflation control became a central bank's core
    job. The central bank (the Federal Reserve, the Bank of England, the ECB) sits above
    the commercial banks: it issues <em>base money</em>, sets the interest rate banks lend
    to each other at, and acts as <strong>lender of last resort</strong> in panics — the
    institutional response to the lesson that bank runs are self-fulfilling prophecies.
  </p>
  <Widget no="4" caption="how a bank loan creates money" widget="order" config={miLoanOrder} />
  <p>
    Economists measure the result in two headlines. <strong>M1</strong> is the money you
    can spend immediately: currency plus demand deposits (checking accounts). <strong>M2</strong>
    adds everything one step less liquid — savings accounts, money-market accounts,
    certificates of deposit. The sums are enormous (US M2 was around 13.6 trillion dollars
    in 2017 and far larger now), and almost all of it is bank-created digits rather than
    printed notes.
  </p>
  <Widget no="5" caption="fill the blanks — M1 and M2" widget="cloze" config={miMoneyCloze} />
  <p><em>Common misconception:</em> "my credit card is money." It is not — a credit card
  is a form of borrowing. When you tap it, the card company pays the seller with real money
  and you owe the company; the card defers payment, it does not replace it. The same test
  exposes other pretenders: travellers' cheques and gift cards move real money around
  rather than being money themselves. If the thing settles a debt the moment it is handed
  over, it is money; if it only starts a loan, it is not.</p>
  <p><em>Common misconception:</em> paper money is still "backed by gold" sitting in a
  vault somewhere. Since 1971 no major currency is: the note in your pocket is a claim on
  trust — the state's willingness to accept it for taxes — not a warehouse receipt for
  metal. This is precisely why inflation is a policy variable rather than a geology
  problem.</p>

  <p>
    <strong>So far:</strong> money is trusted machinery — three jobs, four practical
    properties — and most of it is created by bank lending under a central bank's watch.
    Now we can measure what happens to its value over time.
  </p>
  <h2>Inflation: measuring a moving floor</h2>
  <p>
    <strong>Inflation</strong> is a sustained rise in the <em>general</em> price level —
    not one price, and not one jump. It is measured by statistical offices that survey
    household spending, build a weighted "basket" of hundreds of goods, and track its
    total cost as the <strong>Consumer Price Index</strong> (CPI); the inflation rate is
    the index's annual percentage change. Your personal inflation depends on your own
    basket — a renter's and a homeowner's numbers differ — but the official index is the
    floor the whole economy stands on.
  </p>
  <p>
    The distinction that organises everything else is <strong>nominal versus real</strong>.
    Nominal values are counted in plain currency; real values are counted in what the
    currency buys. A 5% pay rise during 7% inflation is a real pay <em>cut</em>; a savings
    account paying 4% during 6% inflation loses about 2% of its real value every year
    (real rate ≈ nominal rate − inflation). Inflation therefore redistributes by surprise:
    borrowers win, because they repay in cheaper money; fixed-income savers and pensioners
    lose; wage earners lose whenever wages lag prices — which is why union contracts, tax
    brackets and even bus fares get "indexed" to the index itself.
  </p>
  <Widget no="6" caption="find the real-versus-nominal slip" widget="spot-error" config={miRealSpot} />

  <Widget no="7" caption="the slow tax — 3% inflation halves money's worth in about 23 years; drag i upward and watch it collapse" widget="plotter" config={powCfg} />
  <p>
    <strong>What to notice:</strong> at the default 3%, the curve looks gentle — and
    reaches half its height around year 23. Now drag the inflation rate to 10%: the
    halving arrives around year 7. At 50%, the money is worth a seventh of its start in
    under two years. Compounding is indifferent to whether it is building your savings or
    dissolving them — the same exponential, sign not even flipped.
  </p>
  <p>
    <strong>The rule of 70</strong> converts any growth rate into a halving (or doubling)
    time by one division: 70 ÷ 3 ≈ 23 years, 70 ÷ 10 = 7 years, 70 ÷ 50 ≈ 17
    <em>months</em>. It works because 70 ≈ 100 × ln 2 — the algebra of any compounding
    process — so the same trick estimates how fast prices double, how fast a population
    grows, and how fast an investment doubles at 7% interest (70 ÷ 7 = 10 years). One
    tool, any compounder.
  </p>
  <Widget no="8" caption="mark the doubling time at 5%" widget="place" config={miRulePlace} />
  <p><em>Common misconception:</em> "inflation is falling, so prices are falling." Falling
  inflation (<em>disinflation</em>) means prices rise more slowly; falling prices
  (<strong>deflation</strong>) is a different and more dangerous disease — the very trap
  the 2% target exists to avoid. Check the level, not just the rate: 3% inflation after a
  9% one still leaves the index at a record high. Confusing the two is how "price growth
  calmed down" gets misread as "things got cheaper".</p>

  <h2>Why prices rise</h2>
  <p>
    <strong>Demand-pull inflation</strong> is too much spending chasing too few goods — an
    economy pushed beyond its capacity, whether by war finance, stimulus cheques meeting
    snarled supply chains (2021), or a credit boom. <strong>Cost-push inflation</strong>
    is inputs getting dearer: the 1973 oil embargo saw crude roughly quadruple in months,
    and because energy feeds into nearly everything, the price level followed. A
    <strong>wage–price spiral</strong> can entrench either: workers demand raises to catch
    rising prices, firms raise prices to cover rising wages, and each validates the other.
    <strong>Money growth</strong> is the deep mechanism: the quantity theory (MV = PY —
    money stock times velocity equals prices times output) says that if money grows much
    faster than real output, the adjustment must come through prices. Milton Friedman's
    summary — "inflation is always and everywhere a monetary phenomenon" — is the
    proposition the hyperinflations below test to destruction. And
    <strong>expectations</strong> tie it together: once people <em>expect</em> 10%
    inflation, wages and prices pre-emptively rise by 10%, making it true. This is why
    central banks guard their credibility so jealously — an anchor on expectations does
    half the disinflation work in advance.
  </p>
  <Widget no="9" caption="diagnose the oil shock" widget="branch" config={miOilBranch} />

  <Widget no="10" caption="US inflation by year — the Great Inflation, the Volcker cure, the Great Moderation, and the 2022 spike" widget="chart" config={cpiCfg} />
  <p>
    <strong>What to notice:</strong> three episodes and one quiet stretch. The
    <strong>Great Inflation</strong> of the 1970s climbs to 13.5% (1980) after oil shocks
    and loose policy. The cure is the spike's own mirror: Fed chair Paul Volcker pushed
    interest rates toward 20%, deliberately causing a sharp recession in 1981–82 — the
    price of credibility restored. The decades after are so calm economists call them the
    <strong>Great Moderation</strong> (2015: 0.1%). Then the 2021–22 spike — at first it
    looked like classic demand-pull (pandemic stimulus) amplified by cost-push (energy
    after Russia's invasion of Ukraine, and shipping chaos), and how much of it would
    <em>persist</em> was the live question of the decade.
  </p>

  <h2>The central bank's lever: monetary policy</h2>
  <p>
    <strong>Monetary policy</strong> is the central bank steering demand by moving its
    interest rate. Raise the rate and the transmission runs: borrowing becomes dearer →
    mortgages, car loans and business investment shrink → spending cools → demand-pull
    pressure on prices eases → inflation falls, at the cost of slower growth and higher
    unemployment. The arithmetic is felt personally: a 300,000-dollar mortgage goes from
    about 15,000 dollars a year in interest at 3% (interest-only) to about 18,000 at 6% —
    across a whole economy, that difference is demand withdrawn. Cut the rate and every
    arrow reverses. Two design lessons hardened over the last fifty years: central banks
    work best <strong>independent</strong> of election calendars (governments face a
    temptation to stimulate before votes and disinflate after — the "political business
    cycle"), and policy has limits — at the "zero lower bound" rates cannot fall much
    further (hence the unconventional <em>quantitative easing</em>: buying bonds to push
    down longer-term rates), and a cost-push shock cannot be cured by demand squeezes
    without extra pain.
  </p>
  <Widget no="11" caption="true or false — the monetary lever" widget="judge" config={miPolicyJudge} />
  <p><em>Common misconception:</em> a rate rise works immediately — the central bank hikes
  and inflation drops by Friday. Transmission runs through mortgage, investment and
  hiring decisions that take months to renegotiate, which is why the standard lag runs a
  year or more, and why central banks must forecast the economy they are steering rather
  than react to the one on the news. The lever is long — deliberately, so that policy
  does not chase every month's number.</p>

  <h2>When it goes catastrophically wrong</h2>
  <p>
    <strong>Hyperinflation</strong> — conventionally, prices rising over 50% per
    <em>month</em> (Cagan's 1956 threshold) — is the rule of 70 with the accelerator
    jammed, and the mechanism is nearly always the same: a government spending far more
    than it taxes (usually after war, or after a collapse in oil revenue) covers the gap
    by printing, prices respond, spending buys less so more printing is needed, and the
    loop feeds on itself. Weimar Germany, 1923: prices doubled roughly every 3–4 days,
    the dollar traded at 4.2 <em>trillion</em> marks, and workers were paid twice daily to
    shop before lunch. Hungary, July 1946: doubling about every 15 hours — the fastest
    ever recorded. Zimbabwe, November 2008: prices rising about 80 billion percent in a
    month, with a 100-trillion-dollar note that bought little. Venezuela's version began
    in 2016 with deficits printed shut: inflation reached about a million percent by 2018,
    and the escape was partial <strong>dollarisation</strong> — by 2019 over half of
    transactions reportedly used US dollars, and banks issued dollar-denominated debit
    cards. The pattern's end state is money ceasing to be money: barter, foreign
    currency and cigarette-currency take over, and stabilisation requires a new currency
    plus — the real cure — a credible end to deficit financing. Not every high-inflation
    economy is that far gone: several fast-growing countries live with 10–30% for years
    by indexing wages, contracts and interest rates to inflation — costly and clumsy, but
    survivable, as long as nobody lets expectations unanchor.
  </p>
  <Widget no="12" caption="hyperinflation versus deflation — drag the divider" widget="compare" config={miDiseaseCompare} />
  <p>
    The opposite trap, <strong>deflation</strong>, looks virtuous and is not: falling
    prices reward waiting (why buy today?), spending stalls, and debts grow
    <em>heavier</em> in real terms while incomes shrink — a spiral Japan spent the 1990s
    and 2000s unable to fully escape. Between the two diseases, central banks have
    learned that a steady, boring, credible 2% is not timidity; it is the point. Why 2%
    and not zero? A small buffer makes deflation less likely; modest inflation greases
    wage adjustments, since cutting a named wage is psychologically harder than failing
    to raise it; and price indices slightly overstate true inflation (they miss quality
    improvements), so a measured 2% is close to a real 1%. The target is a design
    choice, not a law of nature.
  </p>

  <h2>A worked ledger: the shrinking dollar</h2>
  <p>
    Run the numbers and they stop being abstract. US consumer prices rose roughly
    eight-fold between 1970 and 2024, so the dollar in a 1970 Christmas card bought what
    about eight dollars buy today — a movie ticket at 1.55 dollars then is 15-plus now;
    the federal minimum wage went from 1.60 dollars an hour to 7.25, and the honest
    comparison is that its <em>real</em> value fell. The rule of 70 cross-checks: at 3%
    inflation prices double every ~23 years, so two doublings and a bit over 54 years
    gives ×4–5 — but average US inflation in that period ran closer to 4% (doubling every
    ~18 years), giving three doublings ≈ ×8, which matches the index. Now the personal
    finance version: a savings account paying 5% during 4% inflation grows your money at
    roughly 1% real — the bank's headline number is mostly inflation passing through.
    This is why wage negotiations, pension indexation and long contracts are all,
    underneath, arguments about this one percentage point.
  </p>
  <p>
    One caution about the thermometer itself, because the measurement is a design choice
    with consequences. Basket weights come from spending surveys and are rebased regularly
    (housing costs are the eternal argument: some indices include them, headline CPI does
    not); quality change is adjusted away — a phone that costs the same but does twice as
    much counts as a price <em>fall</em> under <em>hedonic adjustment</em> — and
    substitution is partly built in, since shoppers flee to cheaper stores when prices
    rise. Each choice is defensible and each is contested, because the index is not just
    a statistic: it indexes pensions, rents, tax brackets and inflation-linked government
    bonds, letting savers hold inflation-proof assets and letting economists read the
    market's inflation forecast directly off the price gap between indexed and ordinary
    bonds. Measuring money's worth is itself a small act of monetary policy.
  </p>

  <h2>Check yourself</h2>
  <p>Try these before moving on. Feedback follows each answer.</p>
  <ol>
    <li>Which of money's three jobs breaks first during hyperinflation — and what do people use instead?</li>
    <li>Your savings account pays 6% and inflation is 4%. What is your real return, and who else in the economy is quietly celebrating?</li>
    <li>A news headline says "inflation fell from 9% to 3%". Have prices fallen? What word would be wrong to use here?</li>
    <li>At 7% inflation, roughly how long until prices double? And what does the same division tell you about an investment earning 7%?</li>
  </ol>
  <p>
    <strong>Feedback:</strong> (1) The store-of-value job fails first — money cannot hold
    worth between this week and next, so people flee to barter, foreign currency or
    commodities; once money stops being a store of value it stops being accepted at all.
    (2) Real return ≈ 6 − 4 = 2% — and borrowers are celebrating, because they repay in
    cheaper money. (3) No — disinflation means prices are rising more slowly, and the
    price <em>level</em> is at a record high; the wrong word is "deflation", which means
    prices actually falling. (4) 70 ÷ 7 = 10 years for prices to double; the same rule
    says an investment compounding at 7% doubles in 10 years — one arithmetic, two very
    different feelings.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>Money is a technology with three jobs — medium of exchange, unit of account, store of value — and good money is scarce, durable, portable and divisible.</li>
    <li>Most money is created by commercial banks when they lend; since 1971 it is fiat, backed by trust and taxes, not gold.</li>
    <li>Inflation is a sustained rise in the general price level, measured by the CPI basket; nominal values hide real ones.</li>
    <li>Real rate ≈ nominal rate − inflation; inflation redistributes from savers to borrowers unless contracts are indexed.</li>
    <li>The rule of 70 turns any growth rate into a doubling/halving time — 70 ÷ rate ≈ years.</li>
    <li>Causes: demand-pull, cost-push, wage–price spirals, excess money growth (MV = PY), and self-fulfilling expectations.</li>
    <li>Disinflation is slowing inflation; deflation is falling prices — the more dangerous disease, which the 2% target exists to avoid.</li>
    <li>Monetary policy works through a long transmission lag; independence from election calendars protects its credibility.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    Money and banking get their own engine room in the lessons on monetary policy and
    central banks, which take the interest-rate lever of this lesson and show the full
    transmission machinery. The other side of government policy — fiscal policy and public
    debt — explains where hyperinflations come from, since runaway deficits financed by
    printing are their raw material. And the macroeconomics course assembles both levers
    into models of the whole economy, where the inflation–unemployment trade-offs of this
    lesson become equations.
  </p>

  <h2>Going deeper</h2>
  <p>
    Two ideas carry the subject into the macro course. The <strong>Phillips curve</strong>
    (1958) observed that low unemployment came with higher wage inflation — for two
    decades read as a menu (choose your mix of inflation and joblessness) until the 1970s
    delivered <em>stagflation</em> — high inflation <em>and</em> high unemployment
    together — breaking the simple trade-off and forcing expectations into the model:
    only <em>surprise</em> inflation buys jobs, and surprises cannot last. And the
    <strong>anchor</strong> has since become measurable: bond markets publish inflation
    expectations directly (the gap between ordinary and inflation-indexed government bond
    yields), so a central bank's credibility is quoted daily, in basis points.
  </p>
  <p>
    Beyond the syllabus, the frontier questions are live: why inflation stayed low for
    thirty years (globalisation? demographics? central bank skill — the "missing
    inflation" puzzle), whether the 2022 episode was transitory (the word's most costly
    adjective), and whether crypto-assets with fixed supply would make good fiat
    replacements — which runs headlong into the observation that a little measured
    flexibility, not monetary hard-coding, is what the post-1971 system has been
    engineered to buy.
  </p>

