import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const dsgeCfg = {
  steps: [
    { math: '1 · Microfoundations', note: 'Build the economy UP from households and firms optimising over time — consumption, labour, investment decisions — rather than from aggregate relationships measured in old data (Lucas critique, 1976: policy changes those relationships).' },
    { math: '2 · Shocks drive the cycle', note: 'Technology shocks, demand shocks, monetary surprises — random disturbances hit the optimising agents, and the model generates recessions and booms as their echoes.' },
    { math: '3 · Nominal rigidities make policy matter', note: 'Sticky prices and wages (Calvo pricing) let money affect the real economy in the short run — the New Keynesian ingredient that justifies monetary policy.' },
    { math: '4 · Estimation and use', note: 'Parameters fitted to data by Bayesian methods; central banks run DSGE/VAR ensembles for forecasts and counterfactuals ("what if rates rose 2 points?"). Every major central bank maintains one.' },
  ],
};

const dsgeAcronymCloze = {
  "text": "DSGE stands for %%0%% (agents choose over time with expectations), %%1%% (random shocks push them around) and general equilibrium (all markets clear at once). Built from optimising agents, it is the language modern macro uses for %%2%% analysis.",
  "answers": [
    [
      "dynamic"
    ],
    [
      "stochastic"
    ],
    [
      "counterfactual",
      "policy"
    ]
  ],
  "hint": "Time, randomness and simultaneous markets — each word buys something."
};

const dsgeBuildOrder = {
  "prompt": "Put the DSGE construction sequence in order:",
  "items": [
    "Build optimising households and firms",
    "Throw random shocks at them",
    "Add sticky prices so money has short-run power",
    "Fit the whole machine to data",
    "Hand it to central banks for policy counterfactuals"
  ],
  "why": "Each section of the lesson lives inside one of these four steps; the sequence is construction, not a menu."
};

const dsgeLucasMatch = {
  "prompt": "Pair each Lucas-critique idea with its claim:",
  "pairs": [
    {
      "left": "Lucas critique",
      "right": "estimated relationships break when policy changes the decision rules"
    },
    {
      "left": "microfoundations",
      "right": "model the agents, not the aggregates, so policy enters as a rule"
    },
    {
      "left": "time inconsistency",
      "right": "a government optimising afresh each period promises one thing and does another"
    },
    {
      "left": "rules versus discretion",
      "right": "a credible rule can beat fresh optimisation, even for a well-intentioned policymaker"
    }
  ],
  "why": "The critique forced macro to build from optimising agents; time inconsistency is its policy corollary."
};

const dsgeLucasSpot = {
  "prompt": "Find the line where the Lucas-critique reasoning goes too far:",
  "lines": [
    "The Lucas critique says estimated relationships reflect behaviour under the old policy regime.",
    "Therefore every estimated relationship is useless for any purpose.",
    "It bites specifically when a policy change alters the decision rules generating the data.",
    "For short-horizon forecasting within an unchanged regime, estimated relationships remain useful.",
    "The critique disciplines structural claims, not all empirics."
  ],
  "errorLine": 1,
  "correction": "The critique bites when policy changes the decision rules, not on every estimate.",
  "why": "It disciplines structural claims; short-horizon forecasting within a regime still works."
};

const dsgeMultiplierCompare = {
  "prompt": "One stimulus, two monetary states — drag the divider:",
  "before": {
    "label": "normal monetary response",
    "text": "a 1% of GDP spending boost raises output by roughly 0.9–1.5%"
  },
  "after": {
    "label": "zero lower bound",
    "text": "with rates pinned and no offsetting tightening, the same stimulus does several times more work"
  },
  "why": "The multiplier is a property of the whole system — monetary reaction, borrowing constraints, tax distortions — not a number a government can assume."
};

const dsgeTaylorPlace = {
  "prompt": "Using the Taylor rule, with inflation at 4%, a 2% target and output 1% above trend, what policy rate is prescribed? Place it.",
  "labels": [
    "0%",
    "2.5%",
    "5%",
    "7.5%",
    "10%"
  ],
  "scale": {
    "min": 0,
    "max": 10
  },
  "answer": 7.5,
  "tolerance": 0.2,
  "why": "2 + 4 + 0.5×(4−2) + 0.5×1 = 7.5%. The rule is the benchmark; deviations are explainable judgement."
};

const dsgeObjectSort = {
  "prompt": "Which object is each item in the model?",
  "buckets": [
    "shock",
    "parameter",
    "endogenous state"
  ],
  "items": [
    {
      "label": "a total factor productivity disturbance",
      "bucket": 0
    },
    {
      "label": "the Calvo reset probability θ",
      "bucket": 1
    },
    {
      "label": "the unemployment rate",
      "bucket": 2
    },
    {
      "label": "the labour supply elasticity",
      "bucket": 1
    },
    {
      "label": "a risk-premium shock",
      "bucket": 0
    },
    {
      "label": "the output gap",
      "bucket": 2
    }
  ],
  "why": "Shocks drive the cycle, parameters govern steady-state behaviour, and states are what the model solves for."
};

const dsgeDurationEst = {
  "prompt": "Micro-evidence finds many prices changing only every 6–12 months. What is the midpoint of that range, in months?",
  "unit": "months",
  "answer": 9,
  "factor": 1.2,
  "why": "9 months is the midpoint. Calvo pricing with θ = 0.75 implies an average duration of 1/(1−0.75) = 4 quarters, squarely in the empirical range.",
  "context": "sticky prices are why a nominal rate move moves the real rate"
};

const dsgeShimerBranch = {
  "root": "The standard search-and-matching model generates only about a tenth of the observed volatility in unemployment. Trace the repair.",
  "nodes": {
    "start": {
      "text": "What is the model missing?",
      "choices": [
        {
          "label": "Wage rigidity and outside options that make hiring respond more strongly",
          "next": "wage",
          "feedback": "Yes — the standard wage bargain absorbs too much of the shock."
        },
        {
          "label": "Nothing — the data must be wrong",
          "next": "data",
          "feedback": "The volatility is measured robustly; the model is the problem."
        },
        {
          "label": "More shocks, of any kind",
          "next": "shocks",
          "feedback": "Adding shocks without changing the labour-market structure does not fix the puzzle."
        }
      ]
    },
    "wage": {
      "text": "Wage rigidity and outside options are the standard repairs; HANK goes further, giving households different wealth and liquid-asset positions."
    },
    "data": {
      "text": "The puzzle is a robust feature of the data, not a measurement error.",
      "choices": [
        {
          "label": "So fix what?",
          "next": "wage",
          "feedback": "The wage bargain."
        }
      ]
    },
    "shocks": {
      "text": "The issue is the transmission mechanism, not the number of shocks.",
      "choices": [
        {
          "label": "What fixes it?",
          "next": "wage",
          "feedback": "Wage rigidity and outside options."
        }
      ]
    }
  },
  "why": "The labour market is far more cyclical than the benchmark allows; fixing the wage bargain — or modelling heterogeneity — remains live work."
};

const dsgeCrisisJudge = {
  "statements": [
    {
      "s": "The standard DSGE models before 2008 had no meaningful banking sector, household debt or house prices.",
      "truth": true,
      "why": "The crisis hit precisely where the models were blind."
    },
    {
      "s": "The 2008 crisis hit precisely where the models were blind.",
      "truth": true,
      "why": "Queen Elizabeth's question at the LSE made the point publicly."
    },
    {
      "s": "Post-2008 work has produced one consensus model that all central banks now use.",
      "truth": false,
      "why": "Financial-friction DSGE, HANK and hybrid systems coexist; there is no single consensus model."
    },
    {
      "s": "Central banks run DSGE/VAR ensembles because no single model earns full trust.",
      "truth": true,
      "why": "The ensemble is the field's mature answer to model uncertainty."
    }
  ]
};
---
<TopicPage slug="subjects/economics/expert/macroeconomic-models-dsge">
  <h2>Where you are, and what you will learn</h2>
  <p>
    This is the modelling summit of the economics ladder, and it assumes the terrain you have
    already crossed. <em>GDP and National Accounts</em> defined the aggregates a model must
    reproduce; <em>Fiscal Policy and Public Debt</em> and <em>Monetary Policy and Central
    Banks</em> gave you the two policy levers whose transmission we now build from first
    principles; and <em>Unemployment and Labour Markets</em> supplied the labour-market facts
    the model has to earn. The sibling expert lesson <em>Econometrics</em> taught you how
    relationships are estimated — this lesson asks what happens when policy changes the rules
    that generated those estimates.
  </p>
  <p>By the end you will be able to:</p>
  <ul>
    <li>expand the acronym — dynamic, stochastic, general equilibrium — and say what each word buys the modeler;</li>
    <li>state the Lucas critique and explain how microfoundations answer it;</li>
    <li>trace a monetary policy move through the Euler equation and Calvo stickiness to the output gap;</li>
    <li>explain why multipliers are state-dependent and why HANK models made distribution a first-order macro object;</li>
    <li>judge what DSGE ensembles can promise after the 2008 reckoning — and what they cannot.</li>
  </ul>

  <h2>The idea</h2>
  <p>
    DSGE — <strong>Dynamic</strong> (the economy moves through time with expectations of
    the future), <strong>Stochastic</strong> (random shocks push it around),
    <strong>General Equilibrium</strong> (all markets clear simultaneously) — is the
    formal language modern macroeconomics thinks in. The models are built
    <em>upwards</em>: households choosing consumption and labour over time, firms
    choosing prices and investment, a government and central bank choosing policy — then
    random disturbances hit the optimisers and the model generates booms and recessions
    as their echoes. This chapter reads the unit's macro agenda through that engine: how
    a DSGE model represents intervention, fiscal policy, monetary policy, supply-side
    forces, growth, unemployment and inflation, and what each representation buys and
    costs. The field emerged from the rational-expectations revolution of the 1970s,
    runs inside every major central bank, and — after 2008 exposed real blindnesses —
    has learned an appropriate humility about what a simulated economy can promise.
  </p>
  <Widget no="1" caption="fill the blanks — expand the acronym" widget="cloze" config={dsgeAcronymCloze} />

  <Widget no="2" caption="the DSGE skeleton, from microfoundations to central-bank use" widget="equationStep" config={dsgeCfg} />
  <p>
    <strong>What to notice:</strong> the four steps are the model's construction sequence, not a
    menu. Step 1 builds optimising households and firms; step 2 throws random shocks at them;
    step 3 adds sticky prices so that money has short-run power; step 4 fits the whole machine
    to data and hands it to central banks. Reveal the steps in order and check the logic against
    each section below — every section that follows lives inside one of these four steps.
  </p>
  <Widget no="3" caption="build the DSGE machine, in order" widget="order" config={dsgeBuildOrder} />

  <p><strong>So far:</strong> DSGE is the formal language modern macroeconomics thinks in —
  optimising agents, random shocks, all markets clearing at once. The first stop is the
  critique that forced the language into existence.</p>

  <h2>The Lucas critique: intervention as a change of regime</h2>
  <p>
    The founding problem (Lucas, 1976): relationships estimated from historical data — a
    consumption function, a Phillips curve — reflect behaviour <em>under the old policy
    regime</em>. Change the regime and optimising agents re-plan, so the old estimated
    equations break. DSGE is the answer: model the agents, not the aggregates, and
    policy enters as a change in the rules the agents optimise against. The companion
    insight (Kydland and Prescott, 1977, Nobel 2004) is time inconsistency — a
    government that optimises afresh each period will promise one thing and do another,
    so <strong>rules</strong> can beat <strong>discretion</strong> even for a
    well-intentioned policymaker. In practice the model is used as a laboratory:
    perturb one rule, simulate forward, and read the counterfactual. The classic
    exercise — raise the policy rate two points and trace the response — returns, in
    estimated models, an output path that dips with a hump over about a year and an
    inflation decline that arrives roughly two years out: the model's rendition of
    Friedman's long and variable lags.
  </p>
  <Widget no="4" caption="pair each Lucas-critique idea with its claim" widget="match" config={dsgeLucasMatch} />
  <p>
    <em>Common misconception:</em> "the Lucas critique means every estimated
    relationship is useless." It bites specifically when a policy change alters the
    <em>decision rules</em> generating the data; for short-horizon forecasting within an
    unchanged regime, estimated relationships remain the best tools available. The
    critique disciplines structural claims, not all empirics.
  </p>
  <Widget no="5" caption="find the overreach" widget="spot-error" config={dsgeLucasSpot} />
  <p><strong>So far:</strong> estimated relationships break when a policy change alters the
  decision rules behind them, so the model must represent the agents, not the aggregates. The
  first policy to test in the laboratory is the fiscal one — where the agents' reaction is the
  whole story.</p>

  <h2>Fiscal policy inside the model</h2>
  <p>
    The fiscal block carries a spending process, a tax structure and a debt dynamics
    equation; the interesting economics is how households react. The benchmark is
    <strong>Ricardian equivalence</strong> (Barro, 1974): far-sighted households treat
    today's deficit as tomorrow's taxes and save the stimulus, making the timing of
    taxes irrelevant. The benchmark fails in the data for a measurable reason: a large
    share of households cannot borrow against future income and simply spend windfalls.
    That is why simulated multipliers are state-dependent: with monetary policy
    responding normally, a 1% of GDP spending boost raises output by roughly
    0.9–1.5% in standard models; with rates pinned near zero and no offsetting
    tightening, the same stimulus is predicted to do several times more work. None of
    this is academic: the zero-lower-bound episodes after 2008 and 2020 were exactly
    the states where the model's multiplier arithmetic mattered most. The lesson the
    model teaches is the one naive analysis misses: the multiplier is a
    property of the whole system — monetary reaction, borrowing constraints, the tax
    distortions that finance the spending — not a number a government can assume.
  </p>
  <Widget no="6" caption="one stimulus, two monetary states" widget="compare" config={dsgeMultiplierCompare} />

  <h2>Monetary policy: the Euler equation and the Calvo curve</h2>
  <p>
    Two equations carry the monetary story. The households' Euler equation sets
    consumption today against consumption tomorrow: when the real interest rate rises
    above its natural level, spending later beats spending now, and today's output gap
    turns negative — this is the transmission channel, and with flexible prices it is
    all there is. The second is the New Keynesian Phillips curve,
    π<sub>t</sub> = β E<sub>t</sub>π<sub>t+1</sub> + κ x<sub>t</sub>: inflation depends
    on expected inflation and the output gap, which is only coherent because prices are
    sticky. Stickiness is formalised in Calvo pricing (1983): each period a firm may
    reset its price with probability 1 − θ regardless of how long ago it last did.
    With θ = 0.75 — a parameter estimated squarely in the empirical range — the average
    price stays fixed for 1 ÷ (1 − 0.75) = 4 quarters, which is exactly why a
    nominal rate move moves the <em>real</em> rate for a while. Policy is then a rule,
    conventionally the Taylor form: with inflation at 4% and output 1% above trend, the
    benchmark prescribes 2 + 4 + 0.5 × (4 − 2) + 0.5 × 1 = 7.5%.
  </p>
  <Widget no="7" caption="mark the prescribed policy rate" widget="place" config={dsgeTaylorPlace} />
  <p>
    <em>Common misconception:</em> "the central bank controls the money supply
    directly." In the models that mirror modern practice, the policy instrument is an
    interest-rate rule; the money supply adjusts endogenously to whatever reserves the
    banking system demands at that rate. Money is the residual, not the lever — one of
    the quiet revolutions macro modelling settled before most textbooks noticed.
  </p>

  <h2>Supply-side policy: shocks, wedges and labour supply</h2>
  <p>
    In the model, supply-side conditions appear as two kinds of object: <strong>shock
    processes</strong> — total factor productivity shocks and investment-specific
    technical change, the disturbance terms that drive the cycle — and
    <strong>parameters</strong>, chiefly the tax wedges and elasticities that govern
    steady-state behaviour. A labour income tax of 40% means a worker keeps 60 pence of
    the marginal pound; how much hours respond is governed by an estimated labour
    supply elasticity — with an elasticity of 0.5, a reform that raises net wages 10%
    lifts steady-state hours by about 5%. This is where DSGE's honesty is most
    uncomfortable: the welfare and revenue effects of supply-side policy are wildly
    sensitive to elasticities that are hard to measure, so the model does not settle
    supply-side debates so much as force them to state their assumptions — a parameter
    you can argue with instead of a curve you must trust.
  </p>
  <Widget no="8" caption="shock, parameter or state?" widget="sort-buckets" config={dsgeObjectSort} />

  <h2>Economic growth: cycles around a trend</h2>
  <p>
    The real-business-cycle tradition (Kydland and Prescott, 1982) treats the model's
    job as explaining fluctuations <em>around</em> a growth path, and the division of
    labour matters: growth theory (Solow's tradition) explains the trend, DSGE explains
    the deviations, and the trend's behaviour contaminates the cycle analysis — a
    deterministic trend detrended one way gives different "recessions" than a
    stochastic trend treated another. Growth accounting supplies the trend's raw
    material, and its history is a structural story the models must absorb: US total
    factor productivity grew at roughly 2% per year from 1948 to 1973, then under
    about 0.5% per year from 1973 to 1990 — a regime change, not a shock, that halves
    every long-run projection built on the old number. Balanced-growth restrictions
    (the Kaldor facts: stable capital shares, constant rates over long spans) then
    discipline which model specifications are even admissible.
  </p>
  <p><strong>So far:</strong> the model splits the economy into a trend that growth theory owns
  and cycles that shocks explain — and a regime change in productivity quietly rewrites every
  long-run projection. Next, the part of the economy the basic model handles worst: the labour
  market.</p>

  <h2>Employment and unemployment: hours, search and HANK</h2>
  <p>
    The basic model has households choosing hours — an intensive margin — so
    <em>unemployment</em> needs frictions added deliberately. The standard extension is
    search-and-matching (Diamond, Mortensen, Pissarides, Nobel 2010): vacancies meet
    workers through a matching function, wages are bargained, and unemployment is an
    endogenous state. The model then faces a famous failure, the Shimer puzzle (2005):
    driven by the shocks it has, the standard specification generates only on the order
    of a tenth of the volatility observed in actual unemployment — the labour market is
    far more cyclical than the benchmark allows, and fixing this (wage rigidity,
    outside options) remains live work. The deeper response is heterogeneity: HANK
    models (Kaplan, Moll and Violante, 2018) give households different wealth and
    liquid-assets positions — roughly a third of US households hold little liquid
    wealth, including many with substantial net worth in housing and pensions — and
    that changes who spends a stimulus: aggregate effects depend on the
    <em>distribution</em> of gains, not the average. Distribution moved from
    afterthought to first-order object in macro, and with it the models' answers to
    fiscal and monetary questions changed quantitatively, not just rhetorically.
  </p>
  <Widget no="9" caption="repair the labour-market model" widget="branch" config={dsgeShimerBranch} />
  <p>
    <em>Common misconception:</em> "rational expectations means agents know the model,
    the future and everything else." It means agents use available information without
    <em>systematic</em> error: forecasts can be wrong, but not wrong in a repeatable,
    exploitable direction. The assumption is about the absence of foolable patterns,
    not about omniscience.
  </p>

  <h2>Inflation: sticky prices made formal</h2>
  <p>
    The Calvo mechanism gives inflation dynamics a microfoundation, and the
    micro-evidence largely cooperates: studies of individual price records find many
    prices changing only every 6–12 months, with the changes that do occur fairly
    large. From the mechanism come the policy concepts: inflation
    <em>persistence</em> (how much past inflation carries into the future once
    expectations are accounted for), the sacrifice ratio (output forgone per point of
    disinflation — the Volcker disinflation of the early 1980s cut US inflation from
    about 13.5% to about 3% at the cost of 10.8% peak unemployment), and
    <strong>anchoring</strong>: when the central bank's target is credible, the
    forward-looking term in the Phillips curve stabilises inflation even when shocks
    hit, which is the formal version of why central banks talk so much. The 2008
    blind spot was in the other direction — the standard model treated price stability
    as roughly the whole story of financial calm, and the crisis arrived through
    balance sheets the equations did not contain.
  </p>
  <Widget no="10" caption="call the average price duration" widget="estimate" config={dsgeDurationEst} />

  <h2>Check yourself</h2>
  <p>Try these before moving on. Feedback follows each answer.</p>
  <ol>
    <li>What does each word of "Dynamic, Stochastic, General Equilibrium" assert about the model?</li>
    <li>With Calvo pricing at θ = 0.75, how long does the average price stay fixed, and why does that make a nominal rate move matter for the real economy?</li>
    <li>Why does Ricardian equivalence fail in the data, and what does its failure do to the multiplier arithmetic?</li>
  </ol>
  <p>
    <strong>Feedback:</strong> (1) Dynamic: agents choose over time with expectations of the
    future; Stochastic: random shocks push the optimisers around and cycles are their echoes;
    General Equilibrium: all markets clear simultaneously, so every policy question is a
    whole-system question. (2) 1 divided by (1 − 0.75) = 4 quarters; because many prices
    cannot reset, a nominal rate move shifts the <em>real</em> rate for a while, moving the
    output gap through the Euler-equation channel — without stickiness, money would affect only
    prices. (3) A large share of households cannot borrow against future income and simply spend
    windfalls instead of saving them, so the timing of taxes is not irrelevant; that is exactly
    why simulated multipliers are state-dependent — several times larger with rates pinned near
    zero than under normal monetary offset.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>DSGE builds the economy upward from optimising agents; random shocks and sticky prices turn the machine into a theory of booms and recessions.</li>
    <li>The Lucas critique disciplines structural claims: estimated relationships break when policy changes the rules that generated them.</li>
    <li>Rules can beat discretion even for well-intentioned policymakers — time inconsistency (Kydland and Prescott, 1977).</li>
    <li>The multiplier is a property of the whole system — monetary reaction, borrowing constraints, tax distortions — not a number a government can assume.</li>
    <li>Monetary policy works through the Euler equation and Calvo stickiness; the instrument is an interest-rate rule, and money is the residual.</li>
    <li>HANK models made the distribution of wealth first-order: who spends a stimulus depends on who receives it.</li>
    <li>After 2008, no single model earns full trust — central banks run DSGE/VAR ensembles, and the ensemble is the honest answer.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    The sibling expert lessons finish the expert tier. <em>Econometrics</em> is the estimation
    half of this story — how the parameters, shocks and impulse responses here earn their
    numbers — and <em>Financial Economics</em> deepens exactly where the standard model was
    blind in 2008: banks, household balance sheets and the claims they issue.
  </p>

  <h2>Going deeper</h2>
  <p>
    <strong>Estimation.</strong> Smets and Wouters (2007) is the benchmark: a
    medium-scale model with seven structural shocks (productivity, investment-specific,
    risk-premium, government-spending, monetary-policy, price-markup and wage-markup),
    estimated on US data by Bayesian methods. The estimation culture matters: priors
    discipline the parameter space, the likelihood disciplines the priors, and the
    model's fit is compared with unstructured VARs — where it is genuinely competitive
    at forecasting, which is why central banks run both in ensembles rather than
    choosing one. Reading the outputs is a craft of its own: impulse responses trace a
    single shock's echo through the system with confidence bands; variance
    decompositions report how much of each variable's fluctuation each shock explains;
    and likelihood comparisons against a plain benchmark VAR keep the structural story
    honest about what the data can actually distinguish.
  </p>
  <p>
    <strong>The 2008 reckoning.</strong> The standard models had no meaningful banking
    sector, no household debt and no house prices — the crisis hit precisely where the
    models were blind, a fact Queen Elizabeth II put to economists at the LSE in
    November 2008 ("why did nobody notice?"). The response is still unfolding:
    financial-friction DSGE (Gertler and Kiyotaki's interbank models), HANK's
    heterogeneous agents, and hybrid empirical systems at central banks where
    structural models set counterfactuals and data-driven models set forecasts.
  </p>
  <Widget no="11" caption="true or false — what the models missed" widget="judge" config={dsgeCrisisJudge} />
  <p>
    <strong>Open debates.</strong> Is the representative agent a fatal simplification
    or a useful first order? Can agent-based simulations — no equilibrium imposed,
    heterogeneous learning agents — complement or replace DSGE? How should models
    handle regimes the data has never shown (the zero lower bound forced exactly this
    question after 2008, and models had to be rebuilt to answer it)? And as machine
    learning enters forecasting rooms, the division of labour stabilises where it
    started: computation proposes, structure disposes. A DSGE model is a disciplined
    story about mechanisms — the field's mature position is that no single model earns
    full trust, and the ensemble is the honest answer.
  </p>

  <p class="sources"><strong>Sources:</strong> Kydland & Prescott (Nobel 2004); Smets & Wouters (2007, the benchmark model); HANK: Kaplan, Moll & Violante (2018). Source text: OpenStax (https://openstax.org), CC BY 4.0 — adapted for Interactive Atlas.</p>
</TopicPage>

