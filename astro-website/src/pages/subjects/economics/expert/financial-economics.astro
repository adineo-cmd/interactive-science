---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const finecCfg = {
  steps: [
    { math: '1 · Risk vs return, quantified', note: 'Higher expected return demands accepting higher variance — the risk–return trade-off is the first equation of finance. Diversification lets you shed risk you don\'t need to hold (Markowitz, 1952, Nobel 1990).' },
    { math: '2 · CAPM: pricing risk', note: 'An asset\'s expected return = risk-free rate + beta × market premium. Beta measures sensitivity to the whole market — only MARKET risk is paid for; diversifiable risk earns nothing extra.' },
    { math: '3 · Efficient markets — in three strengths', note: 'Weak: prices reflect past prices. Semi-strong: all public information. Strong: all information, period. Evidence supports semi-strong-ish — enough to make beating the market rare, not impossible.' },
    { math: '4 · The anomalies and the response', note: 'Momentum, value premium, small-cap effect — documented patterns the original models miss. The field responded with multi-factor models (Fama–French, 1993) and behavioural finance (the economics lesson next door).' },
  ],
};

const feRiskSort = {
  "prompt": "Which risk can diversification shed?",
  "buckets": [
    "diversifiable (idiosyncratic)",
    "systematic (market)"
  ],
  "items": [
    {
      "label": "a single factory fire",
      "bucket": 0
    },
    {
      "label": "a recession",
      "bucket": 1
    },
    {
      "label": "a rival's product launch",
      "bucket": 0
    },
    {
      "label": "inflation",
      "bucket": 1
    },
    {
      "label": "a CEO scandal",
      "bucket": 0
    },
    {
      "label": "interest-rate changes",
      "bucket": 1
    }
  ],
  "why": "Diversification removes only idiosyncratic risk; the systematic component survives any number of holdings — which is why CAPM pays a premium for market risk alone."
};

const feMoneyCloze = {
  "text": "Commercial banks create money when they %%0%% — the loan and the deposit arrive together. Maturity transformation makes bank runs a %%1%% equilibrium, and deposit insurance %%2%% the bad equilibrium by changing the payoffs.",
  "answers": [
    [
      "lend"
    ],
    [
      "rational"
    ],
    [
      "deletes",
      "eliminates",
      "removes"
    ]
  ],
  "hint": "Loans create deposits; if everyone expects a run, running first is optimal."
};

const feReservesCompare = {
  "prompt": "Reserves and deposits — drag the divider:",
  "before": {
    "label": "reserves",
    "text": "settlement balances between banks, held at the central bank"
  },
  "after": {
    "label": "deposits",
    "text": "claims created when a bank lends; the loan and the deposit arrive together"
  },
  "why": "Lending creates deposits first; the textbook money-multiplier chain of fixed re-lending is not how balance sheets work."
};

const fePortfolioPlace = {
  "prompt": "Two assets each have 20% volatility, correlation 0.3, held 50/50. Place the portfolio volatility.",
  "labels": [
    "10%",
    "15%",
    "20%",
    "25%",
    "30%"
  ],
  "scale": {
    "min": 10,
    "max": 30
  },
  "answer": 16.1,
  "tolerance": 0.5,
  "why": "Variance = 0.25×0.04 + 0.25×0.04 + 2×0.25×0.3×0.04 = 0.026, so volatility ≈ 16.1% — four points below either asset alone, with no expected-return sacrifice."
};

const feHumanMatch = {
  "prompt": "Pair each human-capital idea with its meaning:",
  "pairs": [
    {
      "left": "Mincer return",
      "right": "each extra year of schooling is associated with roughly 10% higher earnings"
    },
    {
      "left": "compensating differential",
      "right": "hazardous or disagreeable work pays more, ceteris paribus"
    },
    {
      "left": "human-capital beta",
      "right": "your earnings move with your employer, industry and city"
    },
    {
      "left": "DB to DC shift",
      "right": "market and longevity risk moved from firms to households"
    }
  ],
  "why": "Human capital is an asset: it earns a return, carries risk, and is already maximally long your employer."
};

const feWaccEst = {
  "prompt": "A firm is 60% equity at 9% and 40% debt at 5% pre-tax, with a 25% tax rate. What is its WACC?",
  "unit": "%",
  "answer": 6.9,
  "factor": 1.05,
  "why": "0.6×9 + 0.4×5×(1−0.25) = 5.4 + 1.5 = 6.9%. That is the hurdle rate every investment must beat.",
  "context": "the tax shield is why the debt term is after-tax"
};

const feInvestBranch = {
  "root": "A machine costs £100,000 and generates £8,000 a year in perpetuity — an 8% gross return. The firm's WACC is 6.9%. Trace the investment decision.",
  "nodes": {
    "start": {
      "text": "Should the firm buy the machine?",
      "choices": [
        {
          "label": "Yes — the 8% return clears the 6.9% hurdle",
          "next": "buy",
          "feedback": "Yes — it adds 1.1 points of value over the cost of capital."
        },
        {
          "label": "No — the payback is over twelve years",
          "next": "payback",
          "feedback": "Payback ignores the cost of capital and the cash flows after the payback date."
        },
        {
          "label": "Only if the firm has spare cash",
          "next": "cash",
          "feedback": "Financing frictions matter in practice, but the project itself clears the hurdle."
        }
      ]
    },
    "buy": {
      "text": "Buy it: 8% > 6.9%. A 6% machine would fail the same test, even if its payback looked similar."
    },
    "payback": {
      "text": "Payback is an accounting rule, not a value test; the project clears the risk-adjusted cost of capital.",
      "choices": [
        {
          "label": "So buy it?",
          "next": "buy",
          "feedback": "Yes — the hurdle is the test."
        }
      ]
    },
    "cash": {
      "text": "Cash-poor firms may invest less even at identical opportunities — a financing friction, not a verdict on the project.",
      "choices": [
        {
          "label": "What does the project say?",
          "next": "buy",
          "feedback": "It clears the hurdle."
        }
      ]
    }
  },
  "why": "Investment stops where the marginal product of capital falls to its cost; irreversibility and financing frictions are the real-world refinements."
};

const feProfitOrder = {
  "prompt": "Put the economic-profit calculation in order:",
  "items": [
    "Start with accounting profit — say £12 million on £100 million of capital",
    "Subtract the opportunity cost of the capital employed: 8% × £100m = £8 million",
    "Economic profit is £12m − £8m = £4 million",
    "A sister division earning £12m on £200m of capital destroys £4 million",
    "Growth can therefore be value-destroying even at full accounting profitability"
  ],
  "why": "Economic profit charges for the capital employed; that is why the WACC, not the quoted loan rate, is the relevant marginal cost."
};

const feLiquiditySpot = {
  "prompt": "Find the line where the market-microstructure reasoning goes wrong:",
  "lines": [
    "Exchanges run limit order books where market makers quote bids and asks.",
    "The bid-ask spread is the price of immediacy, and depth is the price of size.",
    "Because liquidity is supplied by competitive firms, it is always available when needed.",
    "On 6 May 2010 the US equity market fell about 9% in minutes as liquidity withdrew.",
    "Market design — circuit breakers, tick sizes, latency rules — is a live research agenda."
  ],
  "errorLine": 2,
  "correction": "Liquidity can vanish exactly when it is needed — that is the flash crash's lesson.",
  "why": "The market is an engineered institution whose rules decide whether it aggregates information or amplifies panic."
};

const feFactorJudge = {
  "statements": [
    {
      "s": "CAPM predicted that only market beta earns a premium, but small and value stocks earned too much.",
      "truth": true,
      "why": "The anomaly forced the Fama–French size and value factors into the model."
    },
    {
      "s": "Most of the hundreds of factors in the factor zoo survived out-of-sample replication.",
      "truth": false,
      "why": "Many failed out of sample — asset pricing had its own replication crisis."
    },
    {
      "s": "The efficient-markets hypothesis can be tested only jointly with a model of expected returns.",
      "truth": true,
      "why": "That joint hypothesis problem is why Fama and Shiller could share a Nobel while disagreeing."
    },
    {
      "s": "Efficient markets means prices are always right.",
      "truth": false,
      "why": "Informational efficiency is about speed and competition, not correctness; prices can sit far from fundamentals for years."
    }
  ]
};
---
<TopicPage slug="subjects/economics/expert/financial-economics">
  <h2>Where you are, and what you will learn</h2>
  <p>
    This is the expert tier of the economics ladder, and it assumes the machinery below it.
    <em>GDP and National Accounts</em> gave you the accounting that defines output and saving;
    <em>Monetary Policy and Central Banks</em> showed how interest rates are set and why banks
    matter; <em>Unemployment and Labour Markets</em> introduced the workers whose human capital
    this lesson prices; and the advanced lesson <em>Behavioural Economics</em> supplies the
    evidence that real decision-makers depart from the ideal ones. Financial economics is the
    second pass that prices the claims all of those agents issue and hold.
  </p>
  <p>By the end you will be able to:</p>
  <ul>
    <li>explain money creation by commercial lending, and why maturity transformation makes bank runs a rational equilibrium;</li>
    <li>quantify the risk–return trade-off with Markowitz diversification and Tobin's two-fund separation;</li>
    <li>use CAPM to say which risk earns a premium, and compute a weighted average cost of capital;</li>
    <li>connect production theory's diminishing returns to a firm's investment hurdle;</li>
    <li>read market microstructure, the efficient-markets hypothesis and its anomalies as one argument about information.</li>
  </ul>

  <h2>The idea</h2>
  <p>
    Financial economics prices <strong>claims on uncertain future money</strong> —
    stocks, bonds, options, pensions — and asks what return each should earn to be
    worth holding. Its three foundations are risk aversion, arbitrage (identical
    payoffs must have identical prices) and the market portfolio. Read against this
    unit's syllabus, the subject is a second pass through the microeconomic
    decision-makers: banks create the money the system prices in, households are the
    savers whose portfolios demand risk premia, workers own human capital that is
    itself a financial asset, firms are the issuers who raise capital and invest it,
    and markets for claims have a plumbing — microstructure — of their own. It is the
    most mathematical branch of economics and the one where theory meets trillions of
    dollars daily, with measurable consequences for every pension on Earth.
  </p>
  <Widget no="1" caption="which risk can diversification shed?" widget="sort-buckets" config={feRiskSort} />

  <Widget no="2" caption="the pricing framework — from diversification to factors" widget="equationStep" config={finecCfg} />
  <p>
    <strong>What to notice:</strong> the four steps restate the chapter's spine. Step 1 gives
    the first equation of finance — higher expected return must be bought with higher variance,
    and diversification sheds the risk you need not hold. Step 2 prices the risk that survives
    diversification with beta. Step 3 asks how fast information is impounded into prices, and
    step 4 shows the anomalies that forced the models to grow extra factors. Reveal one step at
    a time: each is a section below in miniature.
  </p>

  <p><strong>So far:</strong> financial economics prices claims on uncertain future money,
  standing on risk aversion, arbitrage and the market portfolio. Before pricing anything, we
  start where the claims are created: the banking system.</p>

  <h2>Money and banking: where claims are created</h2>
  <p>
    The modern mechanism, stated plainly by the Bank of England (2014): commercial
    banks create money when they lend — the loan and the deposit it credits arrive
    together; the bank is not passing on someone else's deposits. This makes the
    banking system a claims-creating machine, and simultaneously its most fragile
    component: maturity transformation (short-term deposits funding long-term loans)
    exposes every bank to a run. Diamond and Dybvig (1983, Nobel 2022) showed the run
    is a rational equilibrium: if you expect others to withdraw, withdrawing first is
    optimal, so solvent banks fail. The policy canon follows: deposit insurance kills
    the run equilibrium, and Bagehot's 1873 dictum — the lender of last resort lends
    freely, at a penalty rate, against good collateral — handles the panics insurance
    cannot. The 2023 failure of Silicon Valley Bank was the theory on fast-forward:
    uninsured digital depositors attempted to pull over 40 billion dollars in a single
    day. The failure was not solvency arithmetic but speed: the run equilibrium now
    moves at the pace of a smartphone.
  </p>
  <Widget no="3" caption="fill the blanks — where money comes from" widget="cloze" config={feMoneyCloze} />
  <p>
    <em>Common misconception:</em> "banks lend out the reserves depositors place with
    them." Reserves are settlement balances between banks; lending creates deposits
    first. Reserve requirements and capital rules discipline lending, but the
    textbook money-multiplier chain of fixed re-lending is not how balance sheets
    actually work.
  </p>
  <Widget no="4" caption="reserves versus deposits — drag the divider" widget="compare" config={feReservesCompare} />
  <p><strong>So far:</strong> banks create the money the system prices in, and their maturity
  transformation makes them both indispensable and run-prone — with deposit insurance and a
  penalty-rate lender of last resort as the repairs. Next: the households whose savings must
  be allocated across those claims.</p>

  <h2>Households: saving, spending and portfolio choice</h2>
  <p>
    Consumption theory gives households their motive (smooth spending across life —
    Modigliani's life-cycle hypothesis; Friedman's 1957 permanent income), portfolio
    theory gives the mechanics. Markowitz (1952, Nobel 1990) quantified the first
    equation of finance: risk falls when assets are combined, provided their returns
    are not perfectly correlated. Worked example: two assets each with volatility 20%,
    correlation 0.3, held 50/50. Portfolio variance is
    0.25 × 0.04 + 0.25 × 0.04 + 2 × 0.25 × 0.3 × 0.04 = 0.026, so portfolio volatility
    is √0.026 ≈ 16.1% — four points below either asset alone, achieved with no
    expected-return sacrifice. Tobin's two-fund separation then says every investor's
    optimum is some mix of the risk-free asset and the market portfolio — the 60/40
    portfolio is this theorem wearing clothes. Behavioural evidence complicates the
    ideal: households under-diversify, trade too much, and are wildly inertial —
    Madrian and Shea (2001) found automatic enrolment lifted 401(k) participation
    among new hires from under half to about 86% without changing any economic
    incentive, proving default friction matters as much as theory — and that
    portfolios are chosen, but mostly not chosen.
  </p>
  <Widget no="5" caption="mark the portfolio volatility" widget="place" config={fePortfolioPlace} />

  <h2>Workers: human capital and compensating differentials</h2>
  <p>
    A worker's largest asset never appears on a balance sheet: the present value of
    future earnings, or human capital. It behaves like a financial asset in several
    senses. Its return is estimable — the Mincer tradition finds each additional year
    of schooling associated with roughly 10% higher earnings (estimates cluster
    between about 7 and 12%), one of the most replicated results in economics. Its
    risk is real — skills can depreciate like technology-obsolete equipment, and
    Adam Smith (1776) already explained the compensating differential that prices
    that risk: disagreeable or hazardous work pays more, ceteris paribus, or nobody
    does it. And pension design is exactly an asset-allocation question in disguise:
    the shift from defined-benefit to defined-contribution schemes moved market and
    longevity risk from firm balance sheets onto household ones — which is why a
    chapter on financial economics is, practically, part of every worker's contract.
    Human capital also has a beta: its value rises and falls with the fortunes of your
    employer, industry and city — which is why the financial advice a worker needs
    differs from textbook portfolio advice. You are already maximally long the firm
    that pays you; buying its shares doubles down on the same risk rather than
    diversifying it.
  </p>
  <Widget no="6" caption="pair each human-capital idea with its meaning" widget="match" config={feHumanMatch} />
  <p><strong>So far:</strong> households allocate their savings and workers carry a human
  capital whose beta is their employer's fortune — already maximally long one firm. Now meet
  the other side of every one of those claims: the firms that raise capital and must earn its
  cost.</p>

  <h2>Firms: financing and the cost of capital</h2>
  <p>
    Modigliani and Miller (1958) start with a theorem of beautiful irrelevance: in
    frictionless markets, firm value depends only on its cash flows, not on how they
    are divided between debt and equity — leverage just slices the same risk into
    more and less senior claims. The theorem matters because it specifies precisely
    which frictions make capital structure matter: corporate taxes (debt shields
    profit), bankruptcy costs, and information asymmetry, which drives the pecking
    order (Myers and Majluf, 1984) — firms finance from retained earnings first, debt
    second, equity last, because issuing equity signals bad news. The practical
    output is the weighted average cost of capital. Worked example: a firm financed
    60% equity at a 9% required return and 40% debt at 5% pre-tax, with a 25% tax
    rate: WACC = 0.6 × 9 + 0.4 × 5 × (1 − 0.25) = 5.4 + 1.5 = 6.9%. That number is
    the firm's hurdle rate — the discount factor every investment must beat.
  </p>
  <Widget no="7" caption="call the WACC" widget="estimate" config={feWaccEst} />

  <h2>Firms and production: capital, output and the investment decision</h2>
  <p>
    Production theory supplies the demand side for capital: output follows a
    production function such as Q = A · K<sup>α</sup>L<sup>1−α</sup>, with capital's
    share α ≈ 0.3 in most economies. Diminishing returns mean each extra machine
    adds less output than the last, so investment stops where the marginal product
    of capital falls to its cost. Worked example: a machine costs 100,000 and
    generates 8,000 a year in perpetuity — a gross return of 8%; against the 6.9%
    cost of capital above, it clears the hurdle by 1.1 points and should be bought;
    a 6% machine should not. Real-world investment adds two refinements the simple
    rule misses: capital is largely irreversible (a specialised factory cannot be
    un-bought), so uncertainty delays investment — the real-options insight — and
    financing frictions mean cash-poor firms invest less than cash-rich ones even
    at identical opportunities, which is why the financing chapter and this one are
    the same story from two sides.
  </p>
  <Widget no="8" caption="buy the machine? trace the hurdle" widget="branch" config={feInvestBranch} />

  <h2>Costs, revenue and objectives: profit maximisation meets the agency problem</h2>
  <p>
    The unit's MR = MC rule survives intact in finance, with one translation: the
    relevant marginal cost of capital is not the interest rate quoted on the loan but
    the risk-adjusted WACC, and the relevant profit is <em>economic</em> profit —
    accounting profit minus the opportunity cost of the capital employed. Worked
    example: a division reports 12 million of profit on 100 million of capital when
    investors require 8% — its economic profit is 12 − 8 = 4 million; a sister
    division reporting the same accounting profit on 200 million of capital is
    destroying 4 million. Measured this way, growth can be value-destroying even at
    full profitability. The deeper problem is who decides: Berle and Means (1932)
    documented the separation of ownership from control, and Jensen and Meckling
    (1976) named the resulting <strong>agency costs</strong> — managers optimising
    their own empire, tenure and perks rather than shareholder value — which is why
    executive compensation, boards and takeover markets are all attempts to align
    the firm's objective with its owners'.
  </p>
  <Widget no="9" caption="economic profit, in order" widget="order" config={feProfitOrder} />

  <h2>Types of markets: from market structures to microstructure</h2>
  <p>
    The product-market spectrum (perfect competition to monopoly) reappears in
    finance, but the urgent version is the <em>organisation of trading itself</em>.
    Exchanges run limit order books where market makers quote bids and asks; the
    bid-ask spread is the price of immediacy, and depth — how much can trade before
    the price moves — is the price of size. Microstructure stopped being a corner of
    the field on 6 May 2010, when the US equity market fell about 9% (nearly 1,000
    Dow points) in minutes and recovered within roughly half an hour: high-frequency
    liquidity withdrew exactly when it was needed, and prices for some stocks
    printed absurdly low. The episode made market design a live research agenda —
    circuit breakers, tick sizes, latency rules — with the general lesson that
    "the market" is not a natural object: it is an engineered institution whose
    rules determine whether it aggregates information or amplifies panic. The questions
    the flash crash raised — who supplies liquidity, when does it vanish, what does
    recovery cost — were old questions in new clothes; the market's rules had simply
    never been stress-tested at machine speed.
  </p>
  <Widget no="10" caption="find the liquidity slip" widget="spot-error" config={feLiquiditySpot} />
  <p>
    <em>Common misconception:</em> "diversification removes risk, so a wide portfolio
    is safe." Diversification removes only <em>idiosyncratic</em> risk. The
    systematic component — exposure to the whole market — survives any number of
    holdings, which is exactly why CAPM pays a premium for market risk and nothing
    for the risk you could have shed.
  </p>

  <h2>Check yourself</h2>
  <p>Try these before moving on. Feedback follows each answer.</p>
  <ol>
    <li>In one sentence each: what does CAPM say an asset's expected return is made of, and which kind of risk earns nothing extra?</li>
    <li>Two assets each have volatility 20% with correlation 0.3, held 50/50. Roughly what portfolio volatility results, and why is it below 20%?</li>
    <li>You work for a firm and could hold its shares in your pension. Why does that double down on one risk rather than diversify it?</li>
  </ol>
  <p>
    <strong>Feedback:</strong> (1) Expected return = the risk-free rate plus beta times the
    market premium; beta prices only sensitivity to the whole market, so diversifiable
    idiosyncratic risk earns nothing extra — you could have shed it for free. (2) About 16.1%:
    combining assets whose returns are not perfectly correlated makes part of the variance
    cancel — 0.25 × 0.04 + 0.25 × 0.04 + 2 × 0.25 × 0.3 × 0.04 = 0.026, whose square root is
    16.1% — a risk reduction with no expected-return sacrifice. (3) Your human capital is
    already long your employer, industry and city; holding its shares adds a second position in
    the same risk instead of spreading across assets whose fortunes move differently.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>Financial economics prices claims on uncertain future money, on three foundations: risk aversion, arbitrage and the market portfolio.</li>
    <li>Commercial banks create money when they lend; maturity transformation makes runs a rational equilibrium, countered by deposit insurance and a penalty-rate lender of last resort.</li>
    <li>Markowitz diversification cuts volatility when correlations are imperfect; Tobin splits every optimum into the risk-free asset plus the market portfolio.</li>
    <li>Human capital is a worker's largest asset, earns roughly 10% per additional schooling year, and carries its employer's beta.</li>
    <li>Modigliani–Miller specifies which frictions make capital structure matter, and the WACC is the hurdle rate every investment must beat.</li>
    <li>CAPM pays only for market risk; the size, value and momentum anomalies forced multi-factor models and behavioural finance.</li>
    <li>Markets are engineered institutions: microstructure rules decide whether prices aggregate information or amplify panic.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    Two sibling expert lessons continue the thread. <em>Econometrics</em> supplies the
    identification discipline used to test pricing claims — including the high-frequency
    event-window method this chapter leaned on — and <em>Macroeconomic Models: DSGE</em> embeds
    the same households, firms and banks in general-equilibrium models used for policy
    counterfactuals. The advanced lesson <em>Behavioural Economics</em> expands the evidence
    behind the departures from theory noted here.
  </p>

  <h2>Going deeper</h2>
  <p>
    <strong>Beyond CAPM: the factor years.</strong> CAPM's prediction — only market
    beta earns a premium — failed systematically: small firms and cheap ("value")
    stocks earned too much. Fama and French (1993) added size and value factors;
    Jegadeesh and Titman (1993) documented momentum; and the ensuing decades
    produced a "factor zoo" of hundreds of claimed premia, many of which failed to
    replicate out of sample — asset pricing's own replication crisis, with honest
    multiple-testing corrections now standard.
  </p>
  <Widget no="11" caption="true or false — factors and efficiency" widget="judge" config={feFactorJudge} />
  <p>
    <strong>Efficiency and its joint hypothesis.</strong> The efficient-markets
    hypothesis is testable only jointly with a model of expected returns — a subtlety
    Fama (Nobel 2013) insists on and Shiller (sharing the 2013 prize) exploits:
    prices overreact on horizons of years, and the cyclically adjusted price-earnings
    ratio stood near 44 at the 2000 peak before the dot-com collapse. The mature
    position is semi-strong-ish efficiency: beating the market is rare, but prices
    are not always right, and bubbles (2000, 2008) are amplified by leverage and
    narrative as much as by information.
  </p>
  <p>
    <em>Common misconception:</em> "efficient markets means prices are right."
    Informational efficiency is a claim about speed and competition — available
    information is impounded quickly — not about correctness. Shiller's
    excess-volatility evidence and the 2000 and 2008 episodes show prices can sit far
    from fundamental value for years while markets remain hard to beat; that tension
    is the joint hypothesis problem in action, not a paradox.
  </p>
  <p>
    <strong>Derivatives: the price of a promise.</strong> Black and Scholes (1973,
    Nobel 1997) turned option valuation into a no-arbitrage partial differential
    equation and launched a trillion-dollar market. Its lognormal, constant-volatility
    assumptions were falsified by the 1987 crash, after which implied volatility
    varies by strike — the "smile" — and the industry moved to models that let
    volatility itself be risky. Open debates now run from pricing climate transition
    risk in equity markets, to fragmentation across venues and jurisdictions, to
    whether crypto assets price like currencies, commodities or lottery tickets —
    the field's habit of testing theory against trillions of dollars daily
    continues.
  </p>

  <p class="sources"><strong>Sources:</strong> Markowitz (1952); Sharpe, CAPM (1964); Black & Scholes (1973); Fama & French (1993); Shiller (Nobel 2013). Source text: OpenStax (https://openstax.org), CC BY 4.0 — adapted for Interactive Atlas.</p>
</TopicPage>

