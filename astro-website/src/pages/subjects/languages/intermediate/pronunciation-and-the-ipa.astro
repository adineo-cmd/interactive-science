import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const pronCfg = {
  steps: [
    { math: '1 · Train the ear first', note: 'Adults filter foreign sounds through their native categories (Japanese r/l merge; English speakers can\'t hear Mandarin tones initially). Minimal-pair training (ship/sheep) re-opens the distinctions — the perception must precede production.' },
    { math: '2 · Learn the mouth positions', note: 'The IPA (the linguistics lesson) tells you WHERE the sound is made. The Spanish rolled r: tongue tip relaxed against the alveolar ridge, air over it — a motor skill, trained like one, in short daily sets.' },
    { math: '3 · Shadowing: copy the native rhythm', note: 'Play native audio and speak over it simultaneously, matching rhythm and intonation (Arguelles\' technique). Rhythm and melody (prosody) are heard as "accent" even more than individual sounds.' },
    { math: '4 · Record and compare', note: 'Your mouth\'s proprioception lies; recordings don\'t. Record yourself saying a sentence, compare to the native clip, adjust one variable, repeat. The feedback loop is the whole method.' },
  ],
};
---
<TopicPage slug="subjects/languages/intermediate/pronunciation-and-the-ipa">
  <h2>The idea</h2>
  <p>
    Pronunciation is a <strong>motor skill plus a listening skill</strong> — and it should be
    trained from day one, because fossilised bad habits are the hardest to fix. The tools: the
    IPA (to know exactly what the target is), minimal-pair listening (to hear it), shadowing
    (to produce it), and recordings (to check it).
  </p>

  <Widget no="1" caption="ear training, mouth positions, shadowing, recording feedback" widget="equationStep" config={pronCfg} />

  <h2>The phonology behind accents</h2>
  <ul>
    <li><strong>Your first language filters your hearing:</strong> the phonology lesson's categories — sounds not distinct in your native language literally sound the same to you until retrained. This is why Japanese speakers struggle with English r/l and English speakers with Japanese vowel length.</li>
    <li><strong>Prosody carries the accent:</strong> stress timing, sentence melody, intonation contours. Learners who copy the music improve faster than those drilling phonemes alone.</li>
    <li><strong>Accent ≠ fluency, and it's okay:</strong> intelligibility is the goal (Munro & Derwing's research); a mild accent with clear speech beats vague native-like mumbling. Perfection is optional; being understood is not.</li>
    <li><strong>Phonetic anchors help:</strong> map the new sound to a familiar sound plus a gesture ("say sh but voiced" for French j) — articulatory instructions beat imitation alone for stubborn contrasts.</li>
  </ul>
  <p class="sources"><strong>Sources:</strong> the IPA (the linguistics lesson); Arguelles on shadowing; Munro & Derwing, Studies in Second Language Acquisition (1995).</p>
</TopicPage>
