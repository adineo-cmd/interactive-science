import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const freqCfg = {
  steps: [
    { math: '1 · Frequency lists exist — use them', note: 'Languages have word-frequency rankings: the top 1,000 words cover ~70–85% of everyday speech (varies by language). Learning them first is the fastest route to comprehensible input — you can\'t understand text containing 40% unknown words.' },
    { math: '2 · Coverage curves flatten', note: '1,000 words ≈ 70–80% coverage; 2,000 ≈ 85%; 5,000 ≈ 92–95%; 10,000+ for comfortable reading of novels. Each doubling buys less — which is why early vocabulary is high-yield and why the plateau frustrates learners.' },
    { math: '3 · Spaced repetition makes it stick', note: 'Flashcards scheduled by forgetting curve (Anki, SuperMemo — the memory lesson\'s Ebbinghaus maths applied). 20 minutes daily beats 3 hours weekly — spacing beats massing, one of psychology\'s most replicated findings.' },
    { math: '4 · Learn words in sentences', note: 'Collocations matter: "make a decision" not "do a decision". Learning words in context builds the grammar for free and avoids translationese. Frequency + collocation + context = vocabulary that works.' },
  ],
};
---
<TopicPage slug="subjects/languages/intermediate/your-first-1000-words">
  <h2>The idea</h2>
  <p>
    The first 1,000 words of any language are <strong>the highest-yield learning investment in
    the entire project</strong> — covering most of ordinary speech and unlocking comprehensible
    input. This lesson is the vocabulary strategy: frequency lists, spaced repetition, and
    collocations, arranged so the plateau arrives later than it otherwise would.
  </p>

  <Widget no="1" caption="frequency, spacing, collocations — the vocabulary engine" widget="equationStep" config={freqCfg} />

  <h2>Practical tactics</h2>
  <ul>
    <li><strong>Front-load high-frequency verbs and function words</strong> (be, have, go, want, this, that, and) — they carry the sentence skeleton; content words attach to them.</li>
    <li><strong>Learn gender/plurality WITH the noun</strong> (la mesa, el libro) — retroactively learning gender for 1,000 nouns is agony; learning it at first meeting is free.</li>
    <li><strong>Use bilingual flashcards sparingly:</strong> images and example sentences beat translations for retention; translations are the scaffold, not the building.</li>
    <li><strong>Measure coverage, not word count:</strong> grab a native text, count unknown words per 100. Below ~10 unknowns per 100, you can learn from context — which changes everything about your practice.</li>
  </ul>
  <p class="sources"><strong>Sources:</strong> Nation, Learning Vocabulary in Another Language; Davies & Gardner, A Frequency Dictionary of (many languages); Anki/SRS research literature.</p>
</TopicPage>
