};

const wswBitsEstimate = {
  "prompt": "Pelli's invariance: throughput at the page is roughly constant across every writing system. How many bits per second does a reader deliver?",
  "unit": "bits/second",
  "answer": 45,
  "factor": 1.35,
  "why": "About 40–50 bits per second regardless of script: alphabets trade more symbols for shorter words; logographies trade fewer, denser units — the brain converges on the same bandwidth, so no design is superior.",
  "context": "Depth still shows elsewhere: transparent orthographies are learned faster, and dyslexia manifests as phonological assembly failure in English but more visual-orthographic trouble in Chinese."
};

const wswEvolutionOrder = {
  "prompt": "Every learner's script recapitulates the deep story — order the stages:",
  "items": [
    "Clay accounting tokens for sheep, grain and jars (Schmandt-Besserat)",
    "Tokens stiffen into pictographs — the sheep token drawn on the tablet",
    "The rebus principle: draw the reed (gi), spell the syllable gi in any word",
    "Cuneiform stylises the pictures; oracle-bone script follows the same path",
    "Semitic scribes keep only consonants; Greek borrowers add vowels — the final compression"
  ],
  "why": "The rebus unlocks syllables from pictures and makes full language writable; the Greek vowel move is the one genuine conceptual leap — phonemes are never pronounced alone, so symbolising them took a second-order insight, made once and inherited by Latin, Cyrillic, Armenian and dozens more."
};

