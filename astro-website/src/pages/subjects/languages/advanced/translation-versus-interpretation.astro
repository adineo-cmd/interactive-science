const transCfg = {
  steps: [
    { math: '1 · Translation: time to craft', note: 'Written translation with unlimited time: research, revise, polish. The craft decisions: fidelity to meaning vs naturalness, preserving register, handling untranslatable culture (honorifics, puns, dialect).' },
    { math: '2 · Interpretation: real-time rendering', note: 'Consecutive (speaker pauses, you render) and simultaneous (live, through a headset, 2-second lag). Different skill entirely: speed, memory, stress tolerance. Interpreters work in 20–30-minute shifts — the cognitive load is extreme.' },
