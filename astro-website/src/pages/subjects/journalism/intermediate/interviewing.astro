import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const intCfg = {
  steps: [
    { math: '1 · Prepare like it\'s an exam', note: 'Read everything public first (past coverage, filings, speeches — the investigation lesson\'s document trail); write questions in advance, then plan to abandon them: the interview is a conversation with a map, not a survey.' },
    { math: '2 · Open questions, then silence', note: '"Tell me about…", "How did that feel?", "What happened next?" — open questions invite narrative; the follow-up is where craft lives ("You said X — what did you mean?"). Silence is the interviewer\'s most powerful tool: people fill it (the research lesson\'s no-leading discipline, spoken).' },
    { math: '3 · The hard questions, earned', note: 'Adversarial questioning (accountability interviews) works after rapport and evidence: present the document, ask for the response on the record. The science lesson\'s "seek comment" is a fairness duty AND a source-opening technique — the subject\'s answer often IS the story.' },
    { math: '4 · On the record, on background', note: 'Ground rules negotiated BEFORE the answer: on record (name, quote), on background (information, unnamed role), deep background (usable, unattributed), off record (not usable — mostly a mistake to grant). Attribution levels are the ethics lesson\'s transparency, operationalised.' },
  ],
};
---
<TopicPage slug="subjects/journalism/intermediate/interviewing">
  <h2>The idea</h2>
  <p>
    The interview is journalism\'s <strong>primary research instrument</strong> — the UX lesson\'s
    behavioural questioning plus the research-methods lesson\'s discipline, aimed at people with
    reasons to manage you. Preparation earns access; listening earns the story.
  </p>

  <Widget no="1" caption="preparation, open questions, earned hard questions, ground rules" widget="equationStep" config={intCfg} />

  <h2>Craft notes from the professionals</h2>
  <ul>
    <li><strong>Tape and verify:</strong> record (with consent) — memory paraphrases into misquotes; the verification lesson\'s check-the-tape is self-protection (every disputed quote resolves to the recording).</li>
    <li><strong>The devastating follow-up is one word:</strong> "Why?" — asked twice, reaches motive; asked with silence, reaches honesty (the research lesson\'s five-whys, at human speed).</li>
    <li><strong>Trauma-aware interviewing:</strong> interviewing survivors is a skill with its own ethics (take breaks, no re-traumatising detail for colour, informed consent about what publication means) — the documentary lesson\'s ethics, conversational edition.</li>
    <li><strong>PR intermediaries are part of the terrain:</strong> press officers gatekeep (access journalism\'s tension — the sociology lesson\'s networks, press-office edition); the accountability answer is documents and multiple sources, never just the flattered spokesperson.</li>
  </ul>
  <p class="sources"><strong>Sources:</strong> the UX research and psychology methods lessons; the Dart Center\'s trauma-interviewing guidance; SPJ ethics on sources.</p>
</TopicPage>
