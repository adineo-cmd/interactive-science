const levelsCfg = {
  steps: [
    { math: '1 · Clean', note: 'Washing removes visible dirt and most microbes — the first step, never the last.' },
    { math: '2 · Disinfect', note: 'EPA-registered disinfectants kill most pathogens on hard, non-porous tools: clippers, nippers, shears. Contact time matters — spray-and-wipe is not disinfecting.' },
    { math: '3 · Sterilise', note: 'Autoclaves kill everything including spores — required for anything that pierces skin. Most salon tools are disinfected; piercing tools must be single-use or sterilised.' },
    { math: '4 · Single-use means single-use', note: 'Porous items — files, buffers, wooden sticks — cannot be disinfected. One client, one set, into the bin.' },
