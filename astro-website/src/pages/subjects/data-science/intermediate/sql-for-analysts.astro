const sqlCfg = {
  steps: [
    { math: '1 · Joins: stitching tables', note: 'INNER JOIN keeps only matches; LEFT JOIN keeps all left rows (with NULLs where missing). Choosing join type = choosing what population your analysis covers — the most common silent mistake in SQL.' },
    { math: '2 · GROUP BY: the aggregation lens', note: 'Collapse rows into groups and compute per-group totals, averages, counts. Revenue per month, users per country — most business questions are GROUP BY questions.' },
    { math: '3 · Window functions: aggregates without collapsing', note: 'ROW_NUMBER, RANK, running totals, period-over-period change — computed ACROSS rows while keeping them. "Top 3 per region" and "vs previous month" both live here.' },
    { math: '4 · CTEs: readable pipelines', note: 'WITH steps AS (…) chains queries like pipeline stages. Analysis SQL is read by humans and machines — structure it like code, because it is code.' },
  ],
};
