const chartsCfg = {
  steps: [
    { math: '1 · Pick the encoding by question', note: 'Comparison → bars. Trend over time → line. Relationship → scatter. Part-of-whole → stacked bar (pie charts fail beyond ~3 slices — humans compare angles badly).' },
    { math: '2 · Zero-base your bars', note: 'Bar length encodes value; a bar chart truncated at 90% turns a 2% change into a visual cliff. Line charts may truncate (position, not length, encodes) — but must say so.' },
    { math: '3 · Order and colour are information', note: 'Sort bars by value, not alphabetically. Use one accent colour for the thing you\'re discussing; grey everything else. Rainbow palettes create fake boundaries (Cairo\'s "chartjunk" rule).' },
    { math: '4 · Title states the finding', note: '"Sales by region" makes the reader work. "Region C drives the decline" states the takeaway — a chart title is a conclusion, not a caption. Then show the uncertainty if there is any.' },
  ],
};

const chartsQuizCfg = {
  questions: [
    { q: 'Cleveland & McGill\'s perception research says the most accurately judged encoding is…', choices: ['colour saturation', 'position along a common scale', 'area', 'angle'], answer: 1, why: 'Position is judged best, then length; area, saturation and hue degrade rapidly. Put your most important variable on an axis — which is the argument for dots and lines over pies and bubbles.' },
    { q: 'A bar chart whose y-axis starts at 90 instead of 0 is misleading because…', choices: ['it hides the labels', 'bar length encodes value, so truncation breaks the encoding', 'bars are always wrong', 'the gridlines vanish'], answer: 1, why: 'Length is the value channel for bars: truncate the baseline and a 2% difference renders as a cliff. Line charts encode by position and may truncate — but must declare it.' },
    { q: 'The "lie factor" of a graphic (Tufte) is…', choices: ['a joke', 'size of effect shown in the graphic divided by size of effect in the data', 'the number of colours', 'the axis maximum'], answer: 1, why: 'Tufte quantified honesty: a government fuel-economy chart whose drawn effect was nearly ten times the real one scored a lie factor of 9.4 — deception measurable without intent being proven.' },
    { q: 'Why annotate charts (launches, policy dates, the outlier\'s name)?', choices: ['decoration', 'the annotation carries the explanation the reader would otherwise invent', 'software requires it', 'it fills white space'], answer: 1, why: 'Readers build stories from spikes whether or not you supply them. Marking the cause on the chart replaces their guess with your documented one — and exposes it to challenge.' },
  ],
};
