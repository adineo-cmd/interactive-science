const edaCfg = {
  steps: [
    { math: '1 · Start with distributions', note: 'Histogram or density per variable: shape, centre, spread, outliers. Every model assumption (normality, skew, heavy tails) is first checked here — not in a statistics lecture, but in the plots.' },
    { math: '2 · Then relationships', note: 'Scatter plots, correlation matrices, group comparisons. Look for curvature (a straight-line fit would miss it), clusters, and variable pairs that move identically (redundancy).' },
    { math: '3 · Then segments and time', note: 'Slice by category, plot against time. Aggregate patterns hide segment patterns (Simpson\'s paradox) — the aggregate can be the average of several opposite stories.' },
    { math: '4 · Write down what surprised you', note: 'EDA\'s deliverable is a list of hypotheses and data-quality findings — not a model. Tukey\'s rule: the greatest gains come from looking at the data before theorising about it.' },
  ],
