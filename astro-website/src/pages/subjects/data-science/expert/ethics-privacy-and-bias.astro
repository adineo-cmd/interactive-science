---
import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const ethicsCfg = {
  steps: [
    { math: '1 · Bias in, bias out', note: 'Models learn from historical data — including historical discrimination. COMPAS recidivism scores, hiring filters, credit limits: all have amplified past bias at scale. Fairness must be measured per group, not averaged.' },
    { math: '2 · Fairness definitions conflict', note: 'Demographic parity (equal pass rates) and equalised odds (equal error rates) are mathematically incompatible when base rates differ. Choosing a fairness metric is a POLICY decision, not a technical one.' },
    { math: '3 · Privacy beyond names', note: 'Re-identification is shockingly easy from "anonymised" data (Netflix prize, AOL search release). Differential privacy adds calibrated noise so individual records can\'t be reverse-engineered — now used by Apple, Google and the US Census.' },
    { math: '4 · Consent and power', note: 'Users click "accept" on 4,000-word policies they cannot negotiate. Meaningful consent requires understandable choices — GDPR\'s rights (access, deletion, portability) are the current legal baseline.' },
  ],
};

const ethFixMatch = {
  "prompt": "Each panel pairs a failure with a fix that carries a visible cost — pair them:",
  "pairs": [
    {
      "left": "historical discrimination in the labels",
      "right": "measurement per group, not averaged"
    },
    {
      "left": "fairness definitions that conflict",
      "right": "a documented policy choice, not a technical default"
    },
    {
      "left": "re-identification from 'anonymised' data",
      "right": "calibrated noise with an explicit budget"
    },
    {
      "left": "consent nobody can negotiate",
      "right": "design effort for consent that means something"
    }
  ],
  "why": "Each fix carries a visible cost — accuracy traded for protection, design effort traded for meaning — and tracking where the cost lands is the professional habit."
};

const ethAuditJudge = {
  "statement": "The ethical audit of a model can safely wait until after deployment, since any harms can be corrected later by retraining.",
  "answer": false,
  "why": "The asymmetry runs one way: a thousand users can be harmed in the minute a model is live, and none of them can see the model that did it — the audit runs before deployment."
};

const ethCompasEst = {
  "prompt": "COMPAS flagged Black defendants who did not reoffend high-risk about 45% of the time, versus about 23% for white non-reoffenders. Roughly how many times higher is the Black rate?",
  "unit": "×",
  "answer": 2,
  "factor": 1.3,
  "why": "Nearly twice — and the vendor's rebuttal was also true: the score was calibrated, a 7 meaning the same recidivism probability for both groups. Both things held simultaneously.",
  "context": "ProPublica's 2016 analysis of roughly 7,000 Broward County defendants"
};

const ethAmazonCloze = {
  "text": "Amazon's experimental recruiting engine was trained on ten years of predominantly %%0%% hires, learned to downgrade CVs containing the word %%1%%, was never deployed — and its %%2%% of harm was the point: a biased human reviewer tires; a biased model reviews millions.",
  "answers": [
    [
      "male"
    ],
    [
      "women's",
      "women"
    ],
    [
      "speed",
      "scale"
    ]
  ],
  "hint": "Who did the hiring, what word got downgraded, and what made the harm fast."
};

const ethProxyBranch = {
  "root": "You delete race and gender from the model's inputs. Is it now unable to discriminate?",
  "nodes": {
    "start": {
      "text": "What is the honest answer?",
      "choices": [
        {
          "label": "Yes — the inputs no longer mention them",
          "next": "proxies",
          "feedback": "Proxies reconstruct what you delete: postcode predicts race in segregated cities, shopping patterns predict pregnancy (Target's famous case), name predicts gender."
        },
        {
          "label": "No — measure error rates per group and audit the proxy set",
          "next": "measure",
          "feedback": "Deletion is not a fix; measurement is — treat the model's decisions, not its inputs, as the object of scrutiny."
        },
        {
          "label": "Depends on how accurate the model is",
          "next": "acc",
          "feedback": "Accuracy says nothing about whom it is accurate for — the decisions, not the inputs, are the object of scrutiny."
        }
      ]
    },
    "proxies": {
      "text": "The model can discriminate perfectly well through features it never saw named."
    },
    "measure": {
      "text": "Evaluate error rates per group, audit the proxy set, and scrutinise decisions — that is the field's requirement."
    },
    "acc": {
      "text": "A highly accurate model can be precisely and unevenly wrong."
    }
  },
  "why": "Deletion is not a fix; measurement is — the misconception mistakes the inputs for the object of scrutiny."
};

const ethMetricMatch = {
  "prompt": "Pair each fairness criterion with the quantity it holds equal:",
  "pairs": [
    {
      "left": "demographic parity",
      "right": "the same fraction of each group is selected"
    },
    {
      "left": "equalised odds",
      "right": "the same false-positive and false-negative rates in each group"
    },
    {
      "left": "calibration",
      "right": "a score of 7 means the same risk for everyone"
    }
  ],
  "why": "Kleinberg–Mullainathan–Raghavan (2016) and Chouldechova (2017) proved calibration and equalised odds are mathematically incompatible when base rates differ — you cannot have both."
};

const ethPolicyCompare = {
  "prompt": "Two systems choosing a fairness metric — drag the divider:",
  "before": {
    "label": "bail-setting",
    "text": "prefer equal false-positive rates — liberty wrongly denied is the error that matters"
  },
  "after": {
    "label": "marketing",
    "text": "might accept parity of selection — the errors are cheaper and the base rates differ"
  },
  "why": "Choosing a fairness metric is a policy decision about which errors matter, made with stakeholders and documented — what the field forbids is not any particular choice, it is the unexamined choice."
};

const ethSweeneyEst = {
  "prompt": "Sweeney showed roughly what share of the US population is unique on just three fields — ZIP code, date of birth, sex?",
  "unit": "%",
  "answer": 87,
  "factor": 1.15,
  "why": "About 87% — which is how she re-identified the Governor of Massachusetts's medical record from a 'de-identified' state employee dataset.",
  "context": "combinations of innocuous fields that are jointly unique are quasi-identifiers"
};

const ethBudgetOrder = {
  "prompt": "Rebuild differential privacy's mechanism — what comes first:",
  "items": [
    "Pick the budget — smaller epsilon means more noise and stronger protection",
    "Add calibrated noise so any one person's inclusion is statistically almost invisible",
    "Compose many queries, spending the budget down",
    "Re-derive the accuracy–protection trade for each use case"
  ],
  "why": "Privacy becomes an explicit, budgetable resource rather than a hope — with units, budgets and proofs, deployed by Apple, Google and the 2020 US Census."
};

const ethNoiseSpot = {
  "prompt": "One of these claims about differential privacy is backwards — click it:",
  "lines": [
    "Noise makes the data bounded, not useless.",
    "Aggregate questions retain excellent accuracy under the budget.",
    "Individual-level questions lose meaning — usually exactly the right trade.",
    "The census stopped redistricting because the noise made it impossible."
  ],
  "errorLine": 3,
  "correction": "The census still redistricts; hospitals still publish; Apple still ships keyboards.",
  "why": "What dies is the fantasy of free, perfect, person-level data — the aggregates survive with measurable, budgeted noise."
};
---
<TopicPage slug="subjects/data-science/expert/ethics-privacy-and-bias">
  <h2>Where you are, and what you will learn</h2>
  <p>
    This lesson is the responsibility layer over everything the course has built.
    <em>Exploratory data analysis</em> and <em>Cleaning messy data</em> (intermediate) taught you
    to interrogate and repair datasets; <em>Machine learning basics</em> (advanced) showed you
    models that learn patterns from historical labels — the mechanism this lesson shows
    inheriting historical discrimination; and <em>AB testing</em> (advanced) made you fluent in
    per-group error rates, the arithmetic the fairness theorems live inside. Here those tools
    are turned on the systems themselves: who is harmed, how the harm is measured, and what the
    field's working fixes cost.
  </p>
  <p>By the end you will be able to:</p>
  <ul>
    <li>explain the bias-in, bias-out mechanism precisely, using COMPAS and Amazon's recruiting engine as worked cases;</li>
    <li>state the calibration-versus-equalised-odds incompatibility and argue why choosing a fairness metric is a policy decision;</li>
    <li>show why quasi-identifiers defeat naive anonymisation, citing the re-identification cases;</li>
    <li>describe differential privacy's budget model and its three production deployments;</li>
    <li>separate legal compliance from the professional question of fair use.</li>
  </ul>

  <h2>The idea</h2>
  <p>
    Data ethics is <strong>the study of harm data systems cause — and the design choices that
    prevent it</strong>. Bias, privacy erosion, opacity and consent gaps are not edge cases;
    they are default behaviours of inattentive systems. The professional skill is seeing the
    harms early enough that fixing them is a design change, not a scandal response. The reason
    this sits inside data science itself — not in a compliance annex — is structural: a model is
    a decision factory. Every threshold it sets, every applicant it ranks, every risk score it
    emits is a decision about a person, made at a scale and speed no human review can audit. The
    discipline's task is to make those decisions as examined as the code that produces them.
  </p>
  <Widget no="11" caption="pair each failure with its working fix" widget="match" config={ethFixMatch} />
  <p>
    The expert framing is neither "algorithms are biased, ban them" nor "maths is neutral". A
    neutral algorithm applied to an unequal world reproduces the inequality with better
    bookkeeping, and the fix is never just technical: fairness definitions encode policy
    choices, privacy budgets trade individual protection against collective knowledge, and
    consent design is a power question wearing a UX costume. This chapter works through the
    mechanisms with the cases that taught the field its caution.
  </p>

  <Widget no="1" caption="the four problem areas and their working fixes" widget="equationStep" config={ethicsCfg} />
  <p>
    <strong>What to notice:</strong> each panel pairs a failure with its working fix, and each
    fix carries a visible cost. Panel 1's fix is measurement per group, which sets up panel 2's
    theorem: the groups' metrics cannot all be equalised at once, so a metric must be chosen —
    and choosing is policy. Panel 3 trades accuracy for protection through a noise budget you
    can actually spend; panel 4 trades design effort for consent that means something. Step
    through and track where the cost of each fix lands.
  </p>

  <h2>What data science is for — the responsibility layer</h2>
  <p>
    The introductory framing of this course (Data 8's opening chapter) defines data science as
    the full cycle — question, data, exploration, inference, communication — <em>plus</em> a
    standing obligation to study the impact of conclusions on the people the data describes.
    That obligation is not decoration; it is the difference between statistics as mathematics and
    statistics as practice. Every stage of the cycle embeds ethical decisions: which question
    gets asked (and which gets funded), which population is sampled (and who is invisible in the
    frame), which outcome is predicted (arrests, which reflect policing, rather than crime),
    which metric counts as success (clicks, which reward outrage). The professional habit this
    chapter builds is running that audit <em>before</em> deployment, because the asymmetry of
    data systems runs one way: a thousand users can be harmed in the minute a model is live, and
    none of them can see the model that did it. With great inferential power comes
    accountability to the described — the field's translation of an older principle.
  </p>
  <Widget no="10" caption="true or false — the audit's timing" widget="judge" config={ethAuditJudge} />
  <p>
    <strong>So far:</strong> every stage of the data science cycle embeds an ethical decision,
    and the audit must run before deployment because the harm runs at machine speed. The next
    section works the most common failure concretely: what exactly happens when a model learns
    from labels written by an unfair world.
  </p>

  <h2>Bias in, bias out: how models inherit discrimination</h2>
  <p>
    The mechanism is worth stating precisely, because it is boring and therefore everywhere.
    Supervised models learn patterns from historical labels; if the labels encode historical
    decisions, the model learns the decisions, including the discriminatory ones — and then
    applies them with machine consistency. <strong>COMPAS</strong>, the recidivism risk score
    used in US courts, is the canonical case. ProPublica (2016) analysed roughly 7,000 Broward
    County, Florida defendants and found Black defendants who did <em>not</em> reoffend were
    flagged high-risk at nearly twice the rate of white defendants who did not reoffend — a
    false-positive rate of about 45% versus 23%. The vendor's rebuttal was also true: the score
    was <em>calibrated</em>, meaning a 7 meant the same recidivism probability for both groups.
    Both things held simultaneously, because the underlying arrest rates differed — the maths
    let everyone be right, which is the deepest lesson of the case. Amazon's experimental
    recruiting engine (reported 2018) is the same mechanism in a different organ: trained on ten
    years of predominantly male hires, it learned to downgrade CVs containing the word
    "women's" — it was never deployed, and its speed of harm was the point: a biased human
    reviewer tires; a biased model reviews millions.
  </p>
  <Widget no="9" caption="call the disparity's size" widget="estimate" config={ethCompasEst} />
  <Widget no="8" caption="fill the blanks — the engine that taught itself bias" widget="cloze" config={ethAmazonCloze} />
  <p>
    <em>Common misconception:</em> "just remove race and gender from the inputs and the model
    can't discriminate." Proxies reconstruct what you delete: postcode predicts race in
    segregated cities, shopping patterns predict pregnancy (Target's famous case), name predicts
    gender. Deletion is not a fix; measurement is — evaluate error rates per group, audit the
    proxy set, and treat the model's decisions, not its inputs, as the object of scrutiny.
  </p>
  <Widget no="7" caption="the deletion fallacy" widget="branch" config={ethProxyBranch} />

  <h2>Fairness definitions conflict — and that is a theorem</h2>
  <p>
    The reason fairness is hard is not vagueness; it is arithmetic. The main candidate criteria
    are: <strong>demographic parity</strong> (the same fraction of each group is selected),
    <strong>equalised odds</strong> (the same false-positive and false-negative rates in each
    group), and <strong>calibration</strong> (a score of 7 means the same risk for everyone).
    Kleinberg, Mullainathan and Raghavan (2016) and Chouldechova (2017) independently proved that
    when base rates differ between groups, calibration and equalised odds are
    <em>mathematically incompatible</em> — you cannot have both, except in degenerate cases. So
    COMPAS's vendor and ProPublica were each holding one horn of a proved dilemma. The
    consequence reshapes practice: choosing a fairness metric is a <strong>policy decision about
    which errors matter</strong>, to be made with stakeholders and documented, not a technical
    default to be coded at 2 a.m. A bail-setting system might reasonably prefer equal
    false-positive rates (liberty wrongly denied); a marketing system might accept parity of
    selection. What the field forbids is not any particular choice — it is the
    <em>unexamined</em> choice.
  </p>
  <Widget no="6" caption="pair each fairness criterion with what it equalises" widget="match" config={ethMetricMatch} />
  <Widget no="5" caption="two systems, two metrics — drag the divider" widget="compare" config={ethPolicyCompare} />
  <p>
    <strong>So far:</strong> bias is measurable per group, and the theorem says no metric
    satisfies everyone at once — so the metric must be documented, not defaulted. With the model
    side examined, the next sections turn to the data side: what "anonymised" actually buys, and
    what mathematics can honestly promise instead.
  </p>

  <h2>Privacy beyond names: re-identification is the default</h2>
  <p>
    "Anonymised" has failed so many times that the burden of proof has flipped. The mechanism of
    failure is <strong>quasi-identifiers</strong>: combinations of innocuous fields that are
    jointly unique. Latanya Sweeney showed that about 87% of the US population is unique on just
    three fields — ZIP code, date of birth, sex — and demonstrated it by re-identifying the
    medical record of the Governor of Massachusetts from a "de-identified" state employee
    dataset. <strong>AOL, 2006:</strong> the company released 20 million search queries from
    650,000 users with IDs but no names; within days, journalists re-identified user 4417749 —
    a 62-year-old woman from Lilburn, Georgia — from her own queries about her health and her
    neighbours. <strong>Netflix, 2007:</strong> the Prize dataset of 500,000 users' film ratings
    was defeated by Narayanan and Shmatikov, who matched users against public IMDb reviews with
    startling accuracy. The lesson generalises: high-dimensional data (search history, ratings,
    location pings) is a fingerprint, and joining two datasets defeats most naive masking.
    k-anonymity (every record identical to at least k − 1 others on the identifying fields) was
    the classic defence and is demonstrably insufficient — homogeneity attacks (everyone in the
    bucket shares the sensitive value) and background knowledge break it.
  </p>
  <Widget no="4" caption="call the three-field fingerprint" widget="estimate" config={ethSweeneyEst} />

  <h2>Differential privacy: the mathematics of plausible denial</h2>
  <p>
    The field's strongest answer, due to Cynthia Dwork and colleagues (2006), changes the goal:
    instead of trying to scrub identifiers, add <strong>calibrated noise</strong> so that the
    published result is statistically almost identical whether or not any one person's data is
    included. The guarantee is parameterised by a privacy budget epsilon: smaller epsilon means
    more noise and stronger protection, and composing many queries spends the budget down —
    which turns privacy into an explicit, budgetable resource rather than a hope. The mechanism
    has survived contact with reality at three historic scales: Apple uses local differential
    privacy for iOS usage statistics; Google for browser telemetry; and the 2020 US Census
    applied it to the decennial redistricting data, accepting measurable noise to protect
    330 million people from reconstruction attacks (researchers had already shown the 2010
    release's tabulations were re-identifiable from public records). The design conversation is
    always the same trade — how much accuracy a use case can give up for how much protection —
    but it is now a conversation with units, budgets and proofs.
  </p>
  <Widget no="3" caption="rebuild the privacy-budget loop" widget="order" config={ethBudgetOrder} />
  <p>
    <em>Common misconception:</em> "adding noise makes the data useless." It makes the data
    <em>bounded</em>: aggregate questions retain excellent accuracy while individual-level
    questions lose meaning — which is usually exactly the right trade. The census still
    redistricts; hospitals still publish; Apple still ships keyboards. What dies is the fantasy
    of free, perfect, person-level data.
  </p>
  <Widget no="2" caption="find the backwards claim — the noise trade" widget="spot-error" config={ethNoiseSpot} />

  <h2>Consent, power and the legal floor</h2>
  <p>
    Consent, in practice, is asymmetric: users click "accept" on policies measured in thousands
    of words that they cannot negotiate and would not read at any length — EU studies have found
    only a small minority of users actually read terms, and eye-tracking work shows average
    reading time per policy would take hundreds of hours a year. So regulation has moved the
    baseline from notice to <strong>rights</strong>. The GDPR (in force 2018) established lawful
    bases for processing, data minimisation, purpose limitation, and enforceable rights of
    access, correction, deletion and portability, with fines up to 20 million euros or 4% of
    global turnover — a number that moved ethics from aspiration to line item. California's
    CCPA/CPRA and similar statutes extended the pattern. The expert distinction: compliance is
    the floor, not the ethics. A consent flow can be lawful and still a dark pattern; a data
    use can be permitted and still corrosive. The professional question — would the person
    described by this data consider this use fair if they could see it? — is not in any statute,
    and it catches what the statutes miss.
  </p>

  <p><em>Common misconception:</em> "bias mitigation is a patch you ship once." The world
  under the model keeps moving: populations shift, adversarial users adapt, upstream
  collection practices change silently — a model audited fair at launch can drift unfair
  within a year with no code change at all. That is why the mature practice treats audits
  like financial controls: scheduled, versioned, owned, and re-run.
  </p>

  <h2>Check yourself</h2>
  <p>Try these before moving on. Feedback follows each answer.</p>
  <ol>
    <li>ProPublica and COMPAS's vendor disagreed about the same score. State both claims precisely and explain how both were simultaneously true.</li>
    <li>A dataset is released with names stripped and postcodes generalised to the first three digits. Give one concrete route by which a person could still be re-identified.</li>
    <li>Why is deleting race and gender from a model's inputs not a fix, and what practice does the field require instead?</li>
  </ol>
  <p>
    <strong>Feedback:</strong> (1) ProPublica measured equalised odds: Black defendants who did
    not reoffend were flagged high-risk at roughly twice the white false-positive rate (about
    45% versus 23%). The vendor measured calibration: a score of 7 meant the same recidivism
    probability for both groups. Kleinberg–Mullainathan–Raghavan (2016) and Chouldechova (2017)
    proved that when base rates differ, calibration and equalised odds cannot both hold — so
    each side held one horn of a proved dilemma, and the disagreement was arithmetic, not
    dishonesty. (2) Sweeney's result: about 87% of the US population is unique on just ZIP code,
    date of birth and sex; a joined public-records file (a voter list, a newspaper story naming
    the Governor of Massachusetts) matches the "anonymous" record to a person. High-dimensional
    data is a fingerprint. (3) Proxies reconstruct what you delete — postcode predicts race in
    segregated cities, shopping patterns predict pregnancy. The required practice is
    measurement: evaluate error rates per group, audit the proxy set, and treat the model's
    decisions as the object of scrutiny, not its inputs.
  </p>

  <h2>Key takeaways</h2>
  <ul>
    <li>A model is a decision factory: every score is a decision about a person, at a scale no human review can audit.</li>
    <li>Bias in, bias out: models inherit the discrimination in historical labels and apply it with machine consistency.</li>
    <li>Calibration and equalised odds are mathematically incompatible when base rates differ — choosing a fairness metric is policy.</li>
    <li>Quasi-identifiers defeat naive anonymisation; k-anonymity falls to homogeneity and background-knowledge attacks.</li>
    <li>Differential privacy spends a budget of calibrated noise: smaller epsilon, stronger protection, measurably less accuracy.</li>
    <li>GDPR moved the baseline from notice to enforceable rights — and compliance is the floor, not the ethics.</li>
    <li>Fairness audits drift like models do: scheduled, versioned, owned, and re-run.</li>
  </ul>

  <h2>Where this goes next</h2>
  <p>
    The sibling expert lesson <em>Data engineering and pipelines</em> is the technical
    infrastructure this lesson audits: the tests, contracts and lineage that make a fairness
    audit re-runnable and the data's provenance provable. Ethics and engineering are the two
    halves of the same production discipline.
  </p>

  <h2>Going deeper</h2>
  <p>
    <strong>The impossibility results, formally.</strong> The fairness-conflict theorem has a
    clean sketch: with differing base rates, equal false-positive and false-negative rates force
    the same <em>precision</em> only if positive predictive value is also equalised — but
    precision then differs unless selection rates track base rates, which breaks parity. Each
    proposed resolution (equalising different triples, conditional fairness given legitimate
    factors, counterfactual fairness defined over causal models) re-chooses which quantity to
    hold fixed; the research frontier is causal formulations — asking what the decision
    <em>would have been</em> had the protected attribute differed — which reframes fairness as a
    question about the world's causal structure, not the confusion matrix.
  </p>
  <p>
    <strong>Attacks on models themselves.</strong> Privacy risk now extends into trained
    systems: membership-inference attacks determine whether a specific person's record was in the
    training set; model-inversion and reconstruction attacks recover training data from large
    language models (researchers have extracted verbatim personal text from published models);
    memorisation scales with duplication. Defences (differential privacy in training, federated
    learning, machine unlearning) each trade accuracy and engineering cost, and evaluating the
    trade honestly is a current research discipline rather than a solved checklist.
  </p>
  <p>
    <strong>Governance as the frontier.</strong> The maturing practice is organisational, not
    algorithmic: model cards and datasheets that document intended use and evaluated subgroups;
    algorithmic impact assessments modelled on environmental ones; red-teaming and external
    audits as a profession (with standards emerging from NIST's AI Risk Management Framework and
    the EU AI Act's conformity regime). The open debate is accountability structure — who is
    liable when a scaled decision harms, and whether audit access can be mandated without
    compromising the very privacy the systems promise to protect. Every case in this chapter
    began as someone's unexamined default; the governance layer exists to make sure the next
    ones begin as someone's documented decision.
  </p>

  <p class="sources"><strong>Sources:</strong> Angwin et al., ProPublica (2016); Narayanan & Shmatikov (2008) on de-anonymisation; Dwork & Roth, "The Algorithmic Foundations of Differential Privacy"; EU GDPR text. Source text: OpenStax (https://openstax.org), CC BY 4.0 — adapted for Interactive Atlas.</p>
</TopicPage>
