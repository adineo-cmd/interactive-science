import TopicPage from '../../../../components/TopicPage.astro';
import Widget from '../../../../components/Widget.astro';

const ethicsCfg = {
  steps: [
    { math: '1 · Bias in, bias out', note: 'Models learn from historical data — including historical discrimination. COMPAS recidivism scores, hiring filters, credit limits: all have amplified past bias at scale. Fairness must be measured per group, not averaged.' },
    { math: '2 · Fairness definitions conflict', note: 'Demographic parity (equal pass rates) and equalised odds (equal error rates) are mathematically incompatible when base rates differ. Choosing a fairness metric is a POLICY decision, not a technical one.' },
    { math: '3 · Privacy beyond names', note: 'Re-identification is shockingly easy from "anonymised" data (Netflix prize, AOL search release). Differential privacy adds calibrated noise so individual records can\'t be reverse-engineered — now used by Apple, Google and the US Census.' },
    { math: '4 · Consent and power', note: 'Users click "accept" on 4,000-word policies they cannot negotiate. Meaningful consent requires understandable choices — GDPR\'s rights (access, deletion, portability) are the current legal baseline.' },
  ],
};
---
<TopicPage slug="subjects/data-science/expert/ethics-privacy-and-bias">
  <h2>The idea</h2>
  <p>
    Data ethics is <strong>the study of harm data systems cause — and the design choices that
    prevent it</strong>. Bias, privacy erosion, opacity and consent gaps are not edge cases;
    they are default behaviours of inattentive systems. The professional skill is seeing the
    harms early enough that fixing them is a design change, not a scandal response.
  </p>

  <Widget no="1" caption="the four problem areas and their working fixes" widget="equationStep" config={ethicsCfg} />

  <h2>Case studies that shaped the rules</h2>
  <ul>
    <li><strong>COMPAS (2016):</strong> ProPublica found the recidivism algorithm flagged Black defendants as high-risk at nearly twice the false-positive rate of white defendants. The vendor disputed the metric — the dispute itself taught the field that fairness definitions must be chosen explicitly.</li>
    <li><strong>AOL search release (2006):</strong> 650,000 users' "anonymised" queries released for research; journalists re-identified users within days (search no. 4417749 was a 62-year-old woman from Georgia). The founding case for re-identification risk.</li>
    <li><strong>Average-face hiring filters:</strong> Amazon's experimental resume scorer (2018) penalised CVs containing the word "women's" — trained on a decade of male-dominated hires. Killed internally; lesson institutionalised.</li>
    <li><strong>GDPR (2018) changed the defaults:</strong> lawful basis for processing, minimisation, right to explanation, and fines up to 4% of global revenue. Compliance is now a design constraint, not paperwork.</li>
  </ul>
  <p class="sources"><strong>Sources:</strong> Angwin et al., ProPublica (2016); Narayanan & Shmatikov (2008) on de-anonymisation; Dwork & Roth, "The Algorithmic Foundations of Differential Privacy"; EU GDPR text.</p>
</TopicPage>
