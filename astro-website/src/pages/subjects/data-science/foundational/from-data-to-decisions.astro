      "text": "The collection drags on; every hypothesis stays alive because none was sharpened.",
      "choices": [
        {
          "label": "Name the decision, then narrow the question",
          "next": "snow",
          "feedback": "A well-formed question names its decision, its deadline and its acceptable error."
        }
      ]
    },
    "vague": {
      "text": "Vague questions make data decorative — the dashboard fills, the decision does not."
    },
    "snow": {
      "text": "A sharp question, a decisive map, a pump handle removed — the outbreak ends."
    }
  },
