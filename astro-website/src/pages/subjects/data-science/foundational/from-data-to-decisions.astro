};

const dsCleanSpot = {
  "prompt": "One entry in this cleaning log breaks the rules — click it:",
  "lines": [
    "Duplicates from the billing-system migration removed.",
    "Viewing hours during the two-week outage recoded as missing, not zero.",
    "Eleven accounts with negative tenure dropped; pipeline bug reported.",
    "A few awkward rows quietly deleted so the retention chart reads cleaner."
  ],
  "errorLine": 3,
  "correction": "Never clean silently — document every transformation, and never clean toward the answer you expect.",
  "why": "Each undocumented edit is a small lie that propagates into every downstream number; a model trained on wrongly joined data is confidently wrong forever."
};

const dsEdaCompare = {
  "prompt": "Two ways to meet a new dataset — drag the divider:",
  "before": {
    "label": "model first",
    "text": "fit a model, then check it against the data — the classroom habit"
  },
  "after": {
    "label": "plot first",
    "text": "look until the data tells you which model would be honest — Tukey's inversion"
  },
  "why": "Anscombe's quartet: four datasets with identical averages, spreads and fitted lines — and wildly different pictures. Plotting is inspection, not presentation."
};

const dsOverfitPredict = {
  "q": "Your model scores 99% on the data it trained on and 60% on data it has never seen. What is the diagnosis?",
  "choices": [
    "Overfitting — it memorised the noise in its training data",
    "Underfitting — the model is too simple",
    "The test set must be wrong",
    "Add more parameters to close the gap"
  ],
