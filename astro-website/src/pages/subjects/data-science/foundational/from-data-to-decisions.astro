};

const dsBiasCloze = {
  "text": "If customer records only include people who finished signup, every conclusion silently describes %%0%%, not potential customers; if a survey only reaches landlines, it describes %%1%%. Selection bias's signature: the data never %%2%% what it is missing.",
  "answers": [
    [
      "finishers",
      "people who finished signup",
      "signers-up"
    ],
    [
      "1995",
      "the nineties",
      "1995's population"
