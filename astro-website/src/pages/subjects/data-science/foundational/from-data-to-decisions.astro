};

const dsSnowBranch = {
  "root": "London, 1854. Your working question: 'What causes cholera?' — too broad for any dataset to answer.",
  "nodes": {
    "start": {
      "text": "The question must become something evidence could decide.",
      "choices": [
        {
          "label": "Narrow it until a map of deaths could answer it",
          "next": "snow",
          "feedback": "Snow's actual move: 'do deaths cluster around a particular water source?' — narrow enough that the Broad Street pump map could settle it."
        },
        {
          "label": "Collect every possible dataset first, decide later",
          "next": "hoard",
          "feedback": "Data collected before the question is decided collects everything and answers nothing."
        },
        {
          "label": "Ask the data to speak for itself",
          "next": "vague",
          "feedback": "It answers whatever you ask — and it answers vague questions vaguely."
        }
