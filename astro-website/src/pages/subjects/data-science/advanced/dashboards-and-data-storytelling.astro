const dashCfg = {
  steps: [
    { math: '1 · Start from the decision', note: '"What will someone DO differently based on this screen?" If no answer exists, it is decoration. Dashboards exist to change decisions — everything else is wallpaper.' },
    { math: '2 · The 5-second rule', note: 'A viewer should grasp the state of things in five seconds: headline states the takeaway, one chart proves it, detail sits below the fold. Pyramid principle (Barbara Minto): conclusion first, support after.' },
    { math: '3 · Context, not just numbers', note: 'Every metric needs a comparison — vs last week, vs target, vs segment. A "1,247" floating alone is trivia. "1,247 vs 1,100 target, down 3% WoW" is information.' },
    { math: '4 · Design for the 3 a.m. check', note: 'No zooming, no hovering requirements, no 14 decimals. Mobile-readable, colour-blind safe, load instant. The best dashboard is the one people actually open.' },
  ],
