const statCfg = {
  steps: [
    { math: '1 · Every estimate has a distribution', note: 'Sample means wobble — the standard error quantifies it. Quoting "conversion = 3.2%" without its interval is quoting noise with confidence.' },
    { math: '2 · Sampling beats formulas sometimes', note: 'The bootstrap resamples your data to derive uncertainty for ANY statistic — medians, 90th percentiles, "share of users with 3+ sessions" — where no closed-form formula exists.' },
    { math: '3 · Know the three workhorses', note: 'Regression (relationships), hypothesis testing (comparisons), Bayesian updating (belief revision). The statistics ladder covers each in full; data science uses them daily.' },
    { math: '4 · Effect size before significance', note: 'p < 0.05 with a tiny effect on a huge sample is usually trivial. Report the size and interval — statistically significant is not the same as matters.' },
  ],
};

const statQuizCfg = {
  questions: [
    { q: 'A conversion rate of 3.2% measured on 400 users has a 95% interval of roughly…', choices: ['3.0% to 3.4%', '1.5% to 4.9%', '2.2% to 4.2%', '0% to 100%'], answer: 1, why: 'SE = √(0.032 × 0.968 / 400) ≈ 0.0088, so the interval is 3.2% ± 1.96 × 0.88% ≈ (1.5%, 4.9%). Small samples make intervals embarrassingly wide — that is the point.' },
    { q: 'The mean of a dataset is the value that minimises…', choices: ['the sum of absolute deviations', 'the sum of squared deviations', 'the range', 'the number of data points above it'], answer: 1, why: 'Squaring gives the mean its special status: it is the least-squares centre, which links it to regression, to the standard deviation, and to why outliers drag it.' },
    { q: 'A p-value of 0.03 means…', choices: ['there is a 3% chance the null hypothesis is true', 'the effect is 3% large', 'if the null hypothesis were true, data this extreme would appear about 3% of the time', 'the result is 97% certain to replicate'], answer: 2, why: 'p-values are conditional on the null being true — they measure how surprising the data would be, not the probability of any hypothesis. Confusing the two is the most common statistical error in industry.' },
    { q: 'The bootstrap estimates uncertainty by…', choices: ['collecting more samples from the population', 'resampling the observed data with replacement and recomputing the statistic', 'assuming a normal distribution always', 'removing outliers'], answer: 1, why: 'The sample stands in for the population; thousands of resamples trace out the sampling distribution of any statistic — median, percentile, whatever — with no formula required.' },
  ],
};
