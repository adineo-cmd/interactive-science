const critCfg = {
  steps: [
    { math: '1 · Description before judgement', note: 'Feldman\'s method: describe (what is there — factual), analyse (how the parts relate — the composition lesson\'s vocabulary), interpret (what it says/does), judge (how well) — IN THAT ORDER. Judgement first is just taste announcing itself.' },
    { math: '2 · The critique\'s contract', note: 'Work-first (the work speaks, not the artist\'s intent — the intentional fallacy lesson), specific (not "I like it" but "the value structure buries the focal point"), and owned ("I see" not "you should"). The teacher\'s real job is modelling this grammar.' },
    { math: '3 · Receiving critique is a separate skill', note: 'Take notes, don\'t defend (explaining why a choice is right is arguing with free data); afterwards, decide which 20% of notes to act on — the editor-author split (the software lesson\'s code review discipline, studio edition).' },
    { math: '4 · Discourse: the waters you swim in', note: 'Galleries, criticism, art fairs, Instagram — the institutional frame (the theory lesson\'s institutional definition, the economics lesson\'s markets) decides what gets seen, priced and remembered. Reading serious criticism (Schama, Sontag, Saltz) is vocabulary acquisition for your own practice.' },
  ],
};
