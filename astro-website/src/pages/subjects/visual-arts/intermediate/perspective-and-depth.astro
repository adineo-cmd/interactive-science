const perspCfg = {
  steps: [
    { math: '1 · The four depth cues', note: 'Overlap (in front wins), size (near = bigger), atmospheric (far = lighter, bluer — the colour lesson), and position (higher on the page = farther, in Western convention). All four worked before geometry arrived — every child\'s drawing and medieval painting uses them.' },
    { math: '2 · Brunelleschi\'s mirror trick (1420s)', note: 'Linear perspective: parallel lines converge to a vanishing point on the horizon — a mathematical system turning the picture plane into a window. Florence\'s demonstration (a painted panel viewed through a mirror facing the baptistry) convinced the city; the Renaissance\'s visual revolution started (the art-history lesson\'s hinge).' },
    { math: '3 · One-point, two-point, three-point', note: 'One vanishing point (a hallway), two (a building corner — the standard), three (looking up or down — the drama). The horizon line is ALWAYS the viewer\'s eye level — the one rule that untangles every construction.' },
