const lsvCfg = {
  steps: [
    { math: '1 · Line is the itinerary', note: 'Line leads the eye — contour (the edge of things), gesture (a drawing\'s skeleton in 30 seconds), hatching (lines as shading). The quality of a line (confident, searching, agitated) is information the viewer reads instantly.' },
    { math: '2 · Shape: positive and negative', note: 'Things you draw (positive) AND the spaces between them (negative) — beginners draw the object, artists draw both. Checking negative space catches proportion errors the subject-shaped eye cannot see.' },
    { math: '3 · Value does the work', note: 'The value lesson\'s rule: squint and check the pattern. A 5-step value scale (light, light-mid, mid, dark-mid, dark) is enough for a readable image; the value STRUCTURE (where lights and darks cluster) is the composition\'s engine.' },
    { math: '4 · Edges control attention', note: 'Hard edges shout, soft edges whisper, lost edges vanish — controlling edge quality is how a painter directs the eye without arrows. Vermeer\'s soft-focus backgrounds are edge management, not blur.' },
  ],
};
