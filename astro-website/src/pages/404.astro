---
import Layout from '../layouts/Layout.astro';
const B = import.meta.env.BASE_URL.replace(/\/+$/, '') || '';
---
<Layout title="Page not found — Interactive Atlas">
  <div class="wrap">
    <div class="error-page">
      <p class="code">404</p>
      <h1>This page isn't on the map</h1>
      <p style="color:var(--ink-2)">The link may be old, or the lesson may not exist yet.</p>
      <p style="margin-top:1.4rem">
        <a class="btn" href={B + '/'}>Back to the index</a>
        <a class="btn btn-ghost" href={`${B}/search/`} style="margin-left:.6rem">Search lessons</a>
      </p>
    </div>
  </div>
</Layout>
