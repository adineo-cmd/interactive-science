---
import Layout from '../layouts/Layout.astro';
import data from '../data/topics.json';
const B = import.meta.env.BASE_URL.replace(/\/+$/, '') || '';
---
<Layout title="Search — Interactive Atlas" description="Full-text search across every published lesson. Runs entirely in your browser.">
  <div class="wrap">
    <div class="prose" style="max-width:760px">
      <p class="crumb"><a href={B + '/'}>atlas</a><span class="sep">/</span>search</p>
      <h1>Search the atlas</h1>
      <p style="color:var(--ink-2)">
        {data.topics.length} lessons across {data.subjects.length} subjects. The index is a small
        SQLite file your browser loads once and queries locally — nothing is sent anywhere.
      </p>
    </div>
    <div class="search-box">
      <input id="q" type="text" placeholder="try: velocity, atom, civilisation, equilibrium, orbit…" autocomplete="off" autofocus />
      <p class="search-note">press <kbd>/</kbd> to focus from anywhere · results link straight to lessons</p>
    </div>
    <div id="results" class="index" style="margin-bottom:4rem"></div>
  </div>
</Layout>

<script src="https://cdn.jsdelivr.net/npm/sql.js@1.8.0/dist/sql-wasm.js" is:inline></script>
<script src="https://cdn.jsdelivr.net/npm/sql.js@1.8.0/dist/sql-wasm.js" is:inline></script>
<script type="module" is:inline>
  const BASE = (document.documentElement.dataset.base || '').replace(/\/+$/, '');
  const { runSearchAndRender } = await import(BASE + '/lib/search.js');
  const input = document.getElementById('q');
  const out = document.getElementById('results');
  let timer = null;
  input.addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(async () => {
      try {
        await runSearchAndRender(input.value, out);
      } catch (e) {
        out.innerHTML = '<p style="color:var(--ink-2)">Search index failed to load. It is built during deployment — try again shortly.</p>';
      }
    }, 200);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== input) { e.preventDefault(); input.focus(); }
  });
</script>
